<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="680" d:DesignHeight="520"
             xmlns:controls="using:Paperbunkr.App.Controls"
             x:Class="Paperbunkr.App.Views.CalibreImportDialogView"
             x:DataType="vm:CalibreImportDialogViewModel">

    <!-- Import from Calibre (docs/superpowers/specs/2026-10-27-books-slice4a-calibre-import-design.md section 5). -->
    <controls:DialogCard Title="Import from Calibre" Subtitle="Brings your Calibre books and their details in. Calibre is only read, never changed." Size="Large">
        <StackPanel Spacing="16">

            <StackPanel Spacing="4">
                <TextBlock Classes="fieldLabel" Text="CALIBRE LIBRARY FOLDER" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0" Text="{Binding LibraryFolder}" Watermark="The folder that holds metadata.db"
                             AutomationProperties.AutomationId="CalibreImportFolder" />
                    <Button Grid.Column="1" Classes="secondary" Content="Browse…" Command="{Binding BrowseCommand}"
                            AutomationProperties.AutomationId="CalibreImportBrowse" />
                </Grid>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Classes="fieldLabel" Text="READ STATUS COLUMN" />
                <controls:SuggestBox IsStrict="True" Text="{Binding SelectedStatusColumn}" Suggestions="{Binding StatusColumns}" />
                <TextBlock Classes="pbTextMeta" TextWrapping="Wrap" Foreground="{DynamicResource PbTextMutedBrush}"
                           Text="Optional: a yes/no or text column in Calibre that says a book has been read. Those books arrive as Finished." />
            </StackPanel>

            <CheckBox Content="Also refresh books imported before (never changes a field you edited)" IsChecked="{Binding RefreshExisting}" />

            <TextBlock Classes="pbTextMeta" Text="{Binding Message}" IsVisible="{Binding HasMessage}" TextWrapping="Wrap"
                       Foreground="{DynamicResource PbTextMutedBrush}" />

            <ProgressBar Minimum="0" Maximum="1" Value="{Binding ProgressFraction}" IsVisible="{Binding IsImporting}" />

            <StackPanel Spacing="8" IsVisible="{Binding HasResult}">
                <TextBlock Classes="fieldLabel" Text="RESULT" />
                <TextBlock Classes="pbTextBody" Text="{Binding ResultSummary}" TextWrapping="Wrap" AutomationProperties.AutomationId="CalibreImportSummary" />
                <StackPanel Spacing="8" IsVisible="{Binding HasReview}">
                    <TextBlock Classes="fieldLabel" Text="LOOKS LIKE BOOKS YOU ALREADY HAVE" />
                    <ItemsControl ItemsSource="{Binding Review}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CalibreReviewRow">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,0,0,8">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Classes="pbTextBody" Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                        <TextBlock Classes="pbTextMeta" Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{DynamicResource PbTextMutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Classes="secondary" Content="Link" IsVisible="{Binding !IsResolved}"
                                                Command="{Binding $parent[UserControl].((vm:CalibreImportDialogViewModel)DataContext).LinkCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Classes="ghost" Content="Skip" IsVisible="{Binding !IsResolved}"
                                                Command="{Binding $parent[UserControl].((vm:CalibreImportDialogViewModel)DataContext).SkipCommand}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock Classes="pbTextMeta" Text="{Binding Resolution}" IsVisible="{Binding IsResolved}"
                                                   Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

        </StackPanel>
        <controls:DialogCard.Footer>
            <StackPanel>
                <Button Classes="ghost" Content="Close" Command="{Binding CloseCommand}" />
                <Button Classes="primary" Content="Import" Command="{Binding ImportCommand}" IsEnabled="{Binding CanImport}"
                        AutomationProperties.AutomationId="CalibreImportStart" />
            </StackPanel>
        </controls:DialogCard.Footer>
    </controls:DialogCard>
</UserControl>
