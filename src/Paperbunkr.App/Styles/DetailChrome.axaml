<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Shared detail-screen chrome (docs/superpowers/specs/2026-08-28-detail-screens-streaming-
        redesign-design.md). The tab-strip styles below were previously duplicated verbatim in
        DetailTabs.axaml and MangaDetailScreen.axaml; lifted here so all three detail screens share
        one definition. Also carries the DetailBand metadata-group label / "+N more" styles and the
        cinematic hero action-button styles.
    -->

    <!-- ============ Tab strip ============ -->
    <Style Selector="TextBlock.tabCount">
        <Setter Property="FontFamily" Value="Consolas,monospace" />
        <Setter Property="FontSize" Value="{DynamicResource PbFontSizeOverline}" />
        <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
        <Setter Property="Background" Value="{DynamicResource PbChromeBrush}" />
        <Setter Property="Padding" Value="6,1" />
    </Style>

    <!-- ============ Hero action buttons ============ -->
    <Style Selector="Button.detailAction">
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusSm}" />
        <Setter Property="FontSize" Value="{DynamicResource PbFontSizeControl}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- ============ Back link ============ -->
    <Style Selector="Button.backLink">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource PbFontSizeControl}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- ============ DetailBand metadata groups ============ -->
    <Style Selector="TextBlock.detailGroupLabel">
        <Setter Property="FontSize" Value="{DynamicResource PbFontSizeOverline}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
        <Setter Property="LetterSpacing" Value="0.6" />
    </Style>
    <Style Selector="Button.detailGroupMore">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="{DynamicResource PbFontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PbAccentTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- Flat clickable credit-name (Writer/Artist in the band, all roles in the Details tab). -->
    <Style Selector="Button.creditName">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,0,6,0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.creditName:pointerover TextBlock">
        <Setter Property="TextDecorations" Value="Underline" />
    </Style>

    <!-- ============ Card wrapper (docs/superpowers/specs/2026-09-13-detail-screens-redesign-
         design.md §3/§4/§6) - shared by DetailTabs.axaml's Details/Related tabs and
         MangaDetailScreen.axaml's Chapters-tab volume groups, same "lift shared chrome here"
         rationale as the tab-strip styles above. ============ -->

    <!-- ============ Details tab inner sub-tab strip (Info/Linking) ============ -->
</Styles>
