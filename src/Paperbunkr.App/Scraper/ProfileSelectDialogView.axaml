<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Paperbunkr.App.Scraper"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="300"
             x:Class="Paperbunkr.App.Scraper.ProfileSelectDialogView"
             x:DataType="vm:ProfileSelectDialogViewModel">

    <UserControl.Styles>
        <Style Selector="Button.primary">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbBadgeTextBrush}" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
    </UserControl.Styles>

    <!-- No card chrome here - the host's NativePluginModalHost Border (MainWindow.axaml) owns it. -->
    <StackPanel Spacing="14" Width="420">
        <TextBlock Text="Which profiles should this run use?" FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource PbTextBrush}" TextWrapping="Wrap" />

        <ItemsControl ItemsSource="{Binding Profiles}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="6" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ProfileSelectRowViewModel">
                    <CheckBox IsChecked="{Binding IsSelected}">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource PbTextFaintBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{DynamicResource PbTextMutedBrush}" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Cancel" Command="{Binding CancelCommand}" />
            <Button Content="Run" Classes="primary" Command="{Binding RunCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
