<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:models="using:Paperbunkr.App.Models"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="Paperbunkr.App.Views.LibraryScreen"
             x:DataType="vm:LibraryScreenViewModel">

    <UserControl.Styles>
        <Style Selector="Button.toolbarPill">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource PbChromeBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.toolbarPill.open">
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource PbAccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbAccentTextBrush}" />
        </Style>
        <Style Selector="Button.toolbarPill Border.icon">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Background" Value="{DynamicResource PbTextMutedBrush}" />
        </Style>
        <Style Selector="Button.toolbarPill.open Border.icon">
            <Setter Property="Background" Value="{DynamicResource PbAccentTextBrush}" />
        </Style>

        <Style Selector="Border.dropdown">
            <Setter Property="Background" Value="{DynamicResource PbChromeBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="BoxShadow" Value="0 8 24 -12 #99000000" />
        </Style>
        <Style Selector="TextBlock.dropdownRow">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
            <Setter Property="Margin" Value="0,3" />
        </Style>

        <Style Selector="Button.card">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Border.cover">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="BoxShadow" Value="0 8 24 -12 #80000000" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <!-- Display dropdown's 7 mode-select rows -->
        <Style Selector="Button.modeOption">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.modeOption.active">
            <Setter Property="Background" Value="{DynamicResource PbAccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbAccentTextBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- Group section header (docs/superpowers/specs/2026-08-09-library-toolbar-design.md Phase C) -->
        <Style Selector="TextBlock.groupHeader">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <!-- Continue Reading overlay button (docs/superpowers/specs/2026-08-09-library-toolbar-design.md Phase D) -->
        <Style Selector="Button.continueReading">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Background" Value="#B814161B" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="3,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.continueReading Border.icon">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Background" Value="White" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <DataTemplate x:Key="CompactGridItemTemplate" x:DataType="models:SeriesCardSample">
            <Button Classes="card" Margin="0,0,14,14"
                    Width="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).CompactCardWidth}"
                    Command="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).SelectCardCommand}"
                    CommandParameter="{Binding}" KeyDown="OnCardKeyDown">
                <Border Classes="cover" Background="{Binding CoverBrush}"
                        Height="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).CompactCardHeight}">
                    <Grid>
                        <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                        <Border IsVisible="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ShowUnreadBadge}">
                            <Border IsVisible="{Binding HasUnread}" Background="#B814161B" CornerRadius="999" Padding="5,1"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5">
                                <TextBlock Text="{Binding UnreadCount}" FontFamily="Consolas,monospace" FontSize="9"
                                           FontWeight="Bold" Foreground="White" />
                            </Border>
                        </Border>
                        <Border IsVisible="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ShowPublisherBadge}">
                            <Border IsVisible="{Binding HasPublisher}" Background="#B814161B" CornerRadius="999" Padding="5,1"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5">
                                <TextBlock Text="{Binding Publisher}" FontSize="8" FontWeight="Bold" Foreground="White"
                                           MaxWidth="60" TextTrimming="CharacterEllipsis" />
                            </Border>
                        </Border>
                        <Border IsVisible="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ShowLanguageBadge}">
                            <Border IsVisible="{Binding HasLanguage}" Background="#B814161B" CornerRadius="999" Padding="5,1"
                                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="5">
                                <Panel>
                                    <TextBlock Text="{Binding LanguageIso}" FontSize="8" FontWeight="Bold" Foreground="White"
                                               IsVisible="{Binding !$parent[UserControl].((vm:LibraryScreenViewModel)DataContext).UseLanguageIcon}" />
                                    <Border Classes="icon" Width="8" Height="8" Background="White"
                                            IsVisible="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).UseLanguageIcon}">
                                        <Border.OpacityMask><ImageBrush Source="/Assets/Icons/Globe.png" Stretch="Uniform" /></Border.OpacityMask>
                                    </Border>
                                </Panel>
                            </Border>
                        </Border>
                        <Border IsVisible="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ShowContinueReadingButton}">
                            <Button Classes="continueReading" Width="24" Height="24" IsVisible="{Binding HasContinueReading}"
                                    Command="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ContinueReadingCommand}"
                                    CommandParameter="{Binding}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Classes="icon">
                                    <Border.OpacityMask><ImageBrush Source="/Assets/Icons/Play.png" Stretch="Uniform" /></Border.OpacityMask>
                                </Border>
                            </Button>
                        </Border>
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2"
                                   FontSize="11" FontWeight="Black" Foreground="#FFFFF8EC" VerticalAlignment="Bottom"
                                   Margin="7,0,7,7" LineHeight="12" />
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="ComfortableGridItemTemplate" x:DataType="models:SeriesCardSample">
            <Button Classes="card" Margin="0,0,20,20"
                    Width="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ComfortableCardWidth}"
                    Command="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).SelectCardCommand}"
                    CommandParameter="{Binding}" KeyDown="OnCardKeyDown">
                <StackPanel>
                    <Border Classes="cover" Background="{Binding CoverBrush}"
                            Height="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ComfortableCardHeight}">
                        <Grid>
                            <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                            <Border IsVisible="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ShowUnreadBadge}">
                                <Border IsVisible="{Binding HasUnread}" Background="#B814161B"
                                        CornerRadius="999" Padding="6,2" HorizontalAlignment="Right"
                                        VerticalAlignment="Top" Margin="7">
                                    <TextBlock Text="{Binding UnreadCount}" FontFamily="Consolas,monospace"
                                               FontSize="10" FontWeight="Bold" Foreground="White" />
                                </Border>
                            </Border>
                            <Border IsVisible="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ShowPublisherBadge}">
                                <Border IsVisible="{Binding HasPublisher}" Background="#B814161B" CornerRadius="999" Padding="6,2"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7">
                                    <TextBlock Text="{Binding Publisher}" FontSize="9" FontWeight="Bold" Foreground="White"
                                               MaxWidth="70" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </Border>
                            <Border IsVisible="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ShowLanguageBadge}">
                                <Border IsVisible="{Binding HasLanguage}" Background="#B814161B" CornerRadius="999" Padding="6,2"
                                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="7,7,7,34">
                                    <Panel>
                                        <TextBlock Text="{Binding LanguageIso}" FontSize="9" FontWeight="Bold" Foreground="White"
                                                   IsVisible="{Binding !$parent[UserControl].((vm:LibraryScreenViewModel)DataContext).UseLanguageIcon}" />
                                        <Border Classes="icon" Width="9" Height="9" Background="White"
                                                IsVisible="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).UseLanguageIcon}">
                                            <Border.OpacityMask><ImageBrush Source="/Assets/Icons/Globe.png" Stretch="Uniform" /></Border.OpacityMask>
                                        </Border>
                                    </Panel>
                                </Border>
                            </Border>
                            <Border IsVisible="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ShowContinueReadingButton}">
                                <Button Classes="continueReading" IsVisible="{Binding HasContinueReading}"
                                        Command="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ContinueReadingCommand}"
                                        CommandParameter="{Binding}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Classes="icon">
                                        <Border.OpacityMask><ImageBrush Source="/Assets/Icons/Play.png" Stretch="Uniform" /></Border.OpacityMask>
                                    </Border>
                                </Button>
                            </Border>
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="14" FontWeight="Black"
                                       Foreground="#FFFFF8EC" VerticalAlignment="Bottom"
                                       Margin="10,0,10,12" LineHeight="16" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource PbTextBrush}" TextTrimming="CharacterEllipsis"
                               Margin="0,8,0,0" />
                    <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="{DynamicResource PbTextFaintBrush}"
                               Margin="0,1,0,0" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="CoverOnlyGridItemTemplate" x:DataType="models:SeriesCardSample">
            <Button Classes="card" Margin="0,0,20,20"
                    Width="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).CoverOnlyCardWidth}"
                    Command="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).SelectCardCommand}"
                    CommandParameter="{Binding}" KeyDown="OnCardKeyDown">
                <Border Classes="cover" Background="{Binding CoverBrush}"
                        Height="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).CoverOnlyCardHeight}">
                    <Grid>
                        <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                        <Border IsVisible="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ShowUnreadBadge}">
                            <Border IsVisible="{Binding HasUnread}" Background="#B814161B"
                                    CornerRadius="999" Padding="6,2" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Margin="7">
                                <TextBlock Text="{Binding UnreadCount}" FontFamily="Consolas,monospace"
                                           FontSize="10" FontWeight="Bold" Foreground="White" />
                            </Border>
                        </Border>
                        <Border IsVisible="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ShowPublisherBadge}">
                            <Border IsVisible="{Binding HasPublisher}" Background="#B814161B" CornerRadius="999" Padding="6,2"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7">
                                <TextBlock Text="{Binding Publisher}" FontSize="9" FontWeight="Bold" Foreground="White"
                                           MaxWidth="70" TextTrimming="CharacterEllipsis" />
                            </Border>
                        </Border>
                        <Border IsVisible="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ShowLanguageBadge}">
                            <Border IsVisible="{Binding HasLanguage}" Background="#B814161B" CornerRadius="999" Padding="6,2"
                                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="7,7,7,34">
                                <Panel>
                                    <TextBlock Text="{Binding LanguageIso}" FontSize="9" FontWeight="Bold" Foreground="White"
                                               IsVisible="{Binding !$parent[UserControl].((vm:LibraryScreenViewModel)DataContext).UseLanguageIcon}" />
                                    <Border Classes="icon" Width="9" Height="9" Background="White"
                                            IsVisible="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).UseLanguageIcon}">
                                        <Border.OpacityMask><ImageBrush Source="/Assets/Icons/Globe.png" Stretch="Uniform" /></Border.OpacityMask>
                                    </Border>
                                </Panel>
                            </Border>
                        </Border>
                        <Border IsVisible="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ShowContinueReadingButton}">
                            <Button Classes="continueReading" IsVisible="{Binding HasContinueReading}"
                                    Command="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ContinueReadingCommand}"
                                    CommandParameter="{Binding}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Classes="icon">
                                    <Border.OpacityMask><ImageBrush Source="/Assets/Icons/Play.png" Stretch="Uniform" /></Border.OpacityMask>
                                </Border>
                            </Button>
                        </Border>
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="14" FontWeight="Black"
                                   Foreground="#FFFFF8EC" VerticalAlignment="Bottom"
                                   Margin="10,0,10,12" LineHeight="16" />
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="PanoramaGridItemTemplate" x:DataType="models:SeriesCardSample">
            <Button Classes="card" Margin="0,0,20,20" Width="{Binding PanoramaWidth}"
                    Command="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).SelectCardCommand}"
                    CommandParameter="{Binding}" KeyDown="OnCardKeyDown">
                <StackPanel>
                    <Border Classes="cover" Background="{Binding CoverBrush}"
                            Height="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).PanoramaCardHeight}">
                        <Grid>
                            <!-- Uniform (not UniformToFill) - the box is already sized to this cover's own
                                 aspect ratio, so nothing gets cropped; only extreme clamped outliers letterbox. -->
                            <Image Source="{Binding CoverImage}" Stretch="Uniform" />
                            <Border IsVisible="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ShowUnreadBadge}">
                                <Border IsVisible="{Binding HasUnread}" Background="#B814161B"
                                        CornerRadius="999" Padding="6,2" HorizontalAlignment="Right"
                                        VerticalAlignment="Top" Margin="7">
                                    <TextBlock Text="{Binding UnreadCount}" FontFamily="Consolas,monospace"
                                               FontSize="10" FontWeight="Bold" Foreground="White" />
                                </Border>
                            </Border>
                            <Border IsVisible="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ShowPublisherBadge}">
                                <Border IsVisible="{Binding HasPublisher}" Background="#B814161B" CornerRadius="999" Padding="6,2"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7">
                                    <TextBlock Text="{Binding Publisher}" FontSize="9" FontWeight="Bold" Foreground="White"
                                               MaxWidth="70" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </Border>
                            <Border IsVisible="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ShowLanguageBadge}">
                                <Border IsVisible="{Binding HasLanguage}" Background="#B814161B" CornerRadius="999" Padding="6,2"
                                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="7">
                                    <Panel>
                                        <TextBlock Text="{Binding LanguageIso}" FontSize="9" FontWeight="Bold" Foreground="White"
                                                   IsVisible="{Binding !$parent[UserControl].((vm:LibraryScreenViewModel)DataContext).UseLanguageIcon}" />
                                        <Border Classes="icon" Width="9" Height="9" Background="White"
                                                IsVisible="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).UseLanguageIcon}">
                                            <Border.OpacityMask><ImageBrush Source="/Assets/Icons/Globe.png" Stretch="Uniform" /></Border.OpacityMask>
                                        </Border>
                                    </Panel>
                                </Border>
                            </Border>
                            <Border IsVisible="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ShowContinueReadingButton}">
                                <Button Classes="continueReading" IsVisible="{Binding HasContinueReading}"
                                        Command="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ContinueReadingCommand}"
                                        CommandParameter="{Binding}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Classes="icon">
                                        <Border.OpacityMask><ImageBrush Source="/Assets/Icons/Play.png" Stretch="Uniform" /></Border.OpacityMask>
                                    </Border>
                                </Button>
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource PbTextBrush}" TextTrimming="CharacterEllipsis"
                               Margin="0,8,0,0" />
                    <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="{DynamicResource PbTextFaintBrush}"
                               Margin="0,1,0,0" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="ListItemTemplate" x:DataType="models:SeriesCardSample">
            <Button Classes="card" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                    Command="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).SelectCardCommand}"
                    CommandParameter="{Binding}">
                <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                    <Grid ColumnDefinitions="44,*,Auto">
                        <Border Grid.Column="0" CornerRadius="4" Width="44" Height="63"
                                Background="{Binding CoverBrush}" ClipToBounds="True">
                            <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PbTextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="{DynamicResource PbTextFaintBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Grid.Column="2" IsVisible="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ShowUnreadBadge}">
                            <Border IsVisible="{Binding HasUnread}" Background="{DynamicResource PbAccentSoftBrush}"
                                    CornerRadius="999" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UnreadCount}" FontFamily="Consolas,monospace" FontSize="11"
                                           FontWeight="Bold" Foreground="{DynamicResource PbAccentTextBrush}" />
                            </Border>
                        </Border>
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="DetailsItemTemplate" x:DataType="models:SeriesCardSample">
            <Button Classes="card" HorizontalAlignment="Stretch" Margin="0,0,0,4"
                    Command="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).SelectCardCommand}"
                    CommandParameter="{Binding}">
                <Grid ColumnDefinitions="52,*,110,70,70,140" Margin="0,6">
                    <Border Grid.Column="0" Width="36" Height="50" CornerRadius="3" Background="{Binding CoverBrush}" ClipToBounds="True">
                        <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource PbTextBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding ContentTypeLabel}" FontSize="12"
                               Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding IssueCount}" FontFamily="Consolas,monospace" FontSize="12"
                               Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{Binding UnreadCount}" FontFamily="Consolas,monospace" FontSize="12"
                               Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="5" Text="{Binding Publisher}" FontSize="12" Foreground="{DynamicResource PbTextFaintBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="TilesItemTemplate" x:DataType="models:SeriesCardSample">
            <Button Classes="card" Margin="0,0,14,10"
                    Width="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).TilesCardWidth}"
                    Command="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).SelectCardCommand}"
                    CommandParameter="{Binding}">
                <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0" CornerRadius="4"
                                Width="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).TilesThumbWidth}"
                                Height="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).TilesThumbHeight}"
                                Background="{Binding CoverBrush}" ClipToBounds="True">
                            <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PbTextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Sub}" FontSize="10.5" Foreground="{DynamicResource PbTextFaintBrush}"
                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- ============ Toolbar (pills variant) ============ -->
        <Border Grid.Row="0" Padding="24,14" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,0,0,1">
          <Panel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Width="260" Text="{Binding SearchQuery}" Watermark="Search all series…" FontSize="12.5" />

                <Button x:Name="FilterButton" Classes="toolbarPill" Classes.open="{Binding IsFilterOpen}"
                        Command="{Binding ToggleFilterCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Border Classes="icon"><Border.OpacityMask><ImageBrush Source="/Assets/Icons/Filter.png" Stretch="Uniform" /></Border.OpacityMask></Border>
                        <TextBlock Text="Filter ▾" />
                    </StackPanel>
                </Button>
                <Button x:Name="SortButton" Classes="toolbarPill" Classes.open="{Binding IsSortOpen}"
                        Command="{Binding ToggleSortCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Border Classes="icon"><Border.OpacityMask><ImageBrush Source="/Assets/Icons/Sort_Ascending.png" Stretch="Uniform" /></Border.OpacityMask></Border>
                        <TextBlock Text="{Binding SortLabel, StringFormat='Sort: {0} ▾'}" />
                    </StackPanel>
                </Button>
                <Button x:Name="GroupButton" Classes="toolbarPill" Classes.open="{Binding IsGroupOpen}"
                        Command="{Binding ToggleGroupCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Border Classes="icon"><Border.OpacityMask><ImageBrush Source="/Assets/Icons/Layers.png" Stretch="Uniform" /></Border.OpacityMask></Border>
                        <TextBlock Text="{Binding GroupField, StringFormat='Group: {0} ▾'}" />
                    </StackPanel>
                </Button>
                <Button x:Name="DisplayButton" Classes="toolbarPill" Classes.open="{Binding IsDisplayOpen}"
                        Command="{Binding ToggleDisplayCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Border Classes="icon"><Border.OpacityMask><ImageBrush Source="/Assets/Icons/Window.png" Stretch="Uniform" /></Border.OpacityMask></Border>
                        <TextBlock Text="{Binding DisplayModeLabel, StringFormat='Display: {0} ▾'}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Popup PlacementTarget="{Binding #FilterButton}" Placement="BottomEdgeAlignedLeft" VerticalOffset="6"
                   IsOpen="{Binding IsFilterOpen}" IsLightDismissEnabled="True">
                <Border Classes="dropdown" Width="210">
                    <StackPanel Spacing="4">
                        <CheckBox Content="Unread only" FontSize="12.5" IsChecked="{Binding FilterUnreadOnly}" />
                        <CheckBox Content="Missing issues" FontSize="12.5" IsChecked="{Binding FilterMissingIssues}" />
                        <CheckBox Content="Tracked series" FontSize="12.5" IsChecked="{Binding FilterTrackedOnly}" />
                    </StackPanel>
                </Border>
            </Popup>

            <Popup PlacementTarget="{Binding #SortButton}" Placement="BottomEdgeAlignedLeft" VerticalOffset="6"
                   IsOpen="{Binding IsSortOpen}" IsLightDismissEnabled="True">
                <Border Classes="dropdown" Width="190">
                    <StackPanel Spacing="1">
                        <Button Classes="modeOption" Classes.active="{Binding SortField, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static models:LibrarySortField.Name}}"
                                Content="Name" Command="{Binding SetSortFieldCommand}" CommandParameter="{x:Static models:LibrarySortField.Name}" />
                        <Button Classes="modeOption" Classes.active="{Binding SortField, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static models:LibrarySortField.DateAdded}}"
                                Content="Date Added" Command="{Binding SetSortFieldCommand}" CommandParameter="{x:Static models:LibrarySortField.DateAdded}" />
                        <Button Classes="modeOption" Classes.active="{Binding SortField, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static models:LibrarySortField.LastRead}}"
                                Content="Last Read" Command="{Binding SetSortFieldCommand}" CommandParameter="{x:Static models:LibrarySortField.LastRead}" />
                        <Button Classes="modeOption" Classes.active="{Binding SortField, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static models:LibrarySortField.Size}}"
                                Content="Size" Command="{Binding SetSortFieldCommand}" CommandParameter="{x:Static models:LibrarySortField.Size}" />
                        <Button Classes="modeOption" Classes.active="{Binding SortField, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static models:LibrarySortField.IssueCount}}"
                                Content="Issue Count" Command="{Binding SetSortFieldCommand}" CommandParameter="{x:Static models:LibrarySortField.IssueCount}" />
                        <Button Classes="modeOption" Classes.active="{Binding SortField, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static models:LibrarySortField.UnreadCount}}"
                                Content="Unread Count" Command="{Binding SetSortFieldCommand}" CommandParameter="{x:Static models:LibrarySortField.UnreadCount}" />
                        <Button Classes="modeOption" Classes.active="{Binding SortField, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static models:LibrarySortField.Publisher}}"
                                Content="Publisher" Command="{Binding SetSortFieldCommand}" CommandParameter="{x:Static models:LibrarySortField.Publisher}" />

                        <Border Height="1" Background="{DynamicResource PbBorderBrush}" Margin="0,10" />

                        <Button Classes="modeOption" Content="{Binding SortDirection, StringFormat='Direction: {0}'}"
                                Command="{Binding ToggleSortDirectionCommand}" />
                    </StackPanel>
                </Border>
            </Popup>

            <Popup PlacementTarget="{Binding #GroupButton}" Placement="BottomEdgeAlignedLeft" VerticalOffset="6"
                   IsOpen="{Binding IsGroupOpen}" IsLightDismissEnabled="True">
                <Border Classes="dropdown" Width="190">
                    <StackPanel Spacing="1">
                        <Button Classes="modeOption" Classes.active="{Binding GroupField, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static models:LibraryGroupField.None}}"
                                Content="None" Command="{Binding SetGroupFieldCommand}" CommandParameter="{x:Static models:LibraryGroupField.None}" />
                        <Button Classes="modeOption" Classes.active="{Binding GroupField, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static models:LibraryGroupField.ContentType}}"
                                Content="Content Type" Command="{Binding SetGroupFieldCommand}" CommandParameter="{x:Static models:LibraryGroupField.ContentType}" />
                        <Button Classes="modeOption" Classes.active="{Binding GroupField, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static models:LibraryGroupField.Publisher}}"
                                Content="Publisher" Command="{Binding SetGroupFieldCommand}" CommandParameter="{x:Static models:LibraryGroupField.Publisher}" />
                        <Button Classes="modeOption" Classes.active="{Binding GroupField, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static models:LibraryGroupField.Alphabetical}}"
                                Content="Alphabetical" Command="{Binding SetGroupFieldCommand}" CommandParameter="{x:Static models:LibraryGroupField.Alphabetical}" />
                    </StackPanel>
                </Border>
            </Popup>

            <Popup PlacementTarget="{Binding #DisplayButton}" Placement="BottomEdgeAlignedRight" VerticalOffset="6"
                   IsOpen="{Binding IsDisplayOpen}" IsLightDismissEnabled="True">
                <Border Classes="dropdown" Width="220">
                    <StackPanel Spacing="1">
                        <TextBlock Classes="dropdownRow" Text="Display mode" Foreground="{DynamicResource PbTextBrush}" Margin="0,0,0,4" />
                        <Button Classes="modeOption" Classes.active="{Binding IsCompactGrid}" Content="Compact grid"
                                Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static models:LibraryViewMode.CompactGrid}" />
                        <Button Classes="modeOption" Classes.active="{Binding IsComfortableGrid}" Content="Comfortable grid"
                                Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static models:LibraryViewMode.ComfortableGrid}" />
                        <Button Classes="modeOption" Classes.active="{Binding IsCoverOnlyGrid}" Content="Cover-only grid"
                                Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static models:LibraryViewMode.CoverOnlyGrid}" />
                        <Button Classes="modeOption" Classes.active="{Binding IsPanoramaGrid}" Content="Panorama comfortable grid"
                                Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static models:LibraryViewMode.PanoramaGrid}" />
                        <Button Classes="modeOption" Classes.active="{Binding IsListView}" Content="List"
                                Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static models:LibraryViewMode.List}" />
                        <Button Classes="modeOption" Classes.active="{Binding IsDetailsView}" Content="Details"
                                Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static models:LibraryViewMode.Details}" />
                        <Button Classes="modeOption" Classes.active="{Binding IsTilesView}" Content="Tiles"
                                Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static models:LibraryViewMode.Tiles}" />

                        <Border Height="1" Background="{DynamicResource PbBorderBrush}" Margin="0,10" />

                        <TextBlock Classes="dropdownRow" Text="Grid density" Foreground="{DynamicResource PbTextBrush}" Margin="0,0,0,4" />
                        <Slider Minimum="0.6" Maximum="1.6" Value="{Binding GridDensity}" />

                        <Border Height="1" Background="{DynamicResource PbBorderBrush}" Margin="0,10" />

                        <TextBlock Classes="dropdownRow" Text="Overlay" Foreground="{DynamicResource PbTextBrush}" Margin="0,0,0,4" />
                        <CheckBox Content="Unread badge" FontSize="12.5" IsChecked="{Binding ShowUnreadBadge}" />
                        <CheckBox Content="Publisher badge" FontSize="12.5" IsChecked="{Binding ShowPublisherBadge}" />
                        <CheckBox Content="Language badge" FontSize="12.5" IsChecked="{Binding ShowLanguageBadge}" />
                        <CheckBox Content="Use language icon" FontSize="12.5" IsChecked="{Binding UseLanguageIcon}" />
                        <CheckBox Content="Continue reading button" FontSize="12.5" IsChecked="{Binding ShowContinueReadingButton}" />
                    </StackPanel>
                </Border>
            </Popup>
          </Panel>
        </Border>

        <!-- ============ Compact grid ============ -->
        <ScrollViewer x:Name="CompactScrollViewer" Grid.Row="1" IsVisible="{Binding IsCompactGrid}">
            <Grid>
                <ItemsControl IsVisible="{Binding !IsGrouped}" ItemsSource="{Binding Covers}"
                              ItemTemplate="{StaticResource CompactGridItemTemplate}" Margin="24,22,24,40">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <ItemsControl IsVisible="{Binding IsGrouped}" ItemsSource="{Binding Groups}" Margin="24,22,24,40">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:SeriesCardGroup">
                            <StackPanel Margin="0,0,0,18">
                                <TextBlock Text="{Binding Header}" Classes="groupHeader" />
                                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource CompactGridItemTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>

        <!-- ============ Comfortable grid ============ -->
        <ScrollViewer x:Name="ComfortableScrollViewer" Grid.Row="1" IsVisible="{Binding IsComfortableGrid}">
            <Grid>
                <ItemsControl IsVisible="{Binding !IsGrouped}" ItemsSource="{Binding Covers}"
                              ItemTemplate="{StaticResource ComfortableGridItemTemplate}" Margin="24,22,24,40">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <ItemsControl IsVisible="{Binding IsGrouped}" ItemsSource="{Binding Groups}" Margin="24,22,24,40">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:SeriesCardGroup">
                            <StackPanel Margin="0,0,0,18">
                                <TextBlock Text="{Binding Header}" Classes="groupHeader" />
                                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ComfortableGridItemTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>

        <!-- ============ Cover-only grid ============ -->
        <ScrollViewer x:Name="CoverOnlyScrollViewer" Grid.Row="1" IsVisible="{Binding IsCoverOnlyGrid}">
            <Grid>
                <ItemsControl IsVisible="{Binding !IsGrouped}" ItemsSource="{Binding Covers}"
                              ItemTemplate="{StaticResource CoverOnlyGridItemTemplate}" Margin="24,22,24,40">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <ItemsControl IsVisible="{Binding IsGrouped}" ItemsSource="{Binding Groups}" Margin="24,22,24,40">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:SeriesCardGroup">
                            <StackPanel Margin="0,0,0,18">
                                <TextBlock Text="{Binding Header}" Classes="groupHeader" />
                                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource CoverOnlyGridItemTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>

        <!-- ============ Panorama comfortable grid ============ -->
        <ScrollViewer x:Name="PanoramaScrollViewer" Grid.Row="1" IsVisible="{Binding IsPanoramaGrid}">
            <Grid>
                <ItemsControl IsVisible="{Binding !IsGrouped}" ItemsSource="{Binding Covers}"
                              ItemTemplate="{StaticResource PanoramaGridItemTemplate}" Margin="24,22,24,40">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <ItemsControl IsVisible="{Binding IsGrouped}" ItemsSource="{Binding Groups}" Margin="24,22,24,40">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:SeriesCardGroup">
                            <StackPanel Margin="0,0,0,18">
                                <TextBlock Text="{Binding Header}" Classes="groupHeader" />
                                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource PanoramaGridItemTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>

        <!-- ============ List ============ -->
        <ScrollViewer x:Name="ListScrollViewer" Grid.Row="1" IsVisible="{Binding IsListView}">
            <Grid>
                <ItemsControl IsVisible="{Binding !IsGrouped}" ItemsSource="{Binding Covers}"
                              ItemTemplate="{StaticResource ListItemTemplate}" Margin="24,18,24,40" />
                <ItemsControl IsVisible="{Binding IsGrouped}" ItemsSource="{Binding Groups}" Margin="24,18,24,40">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:SeriesCardGroup">
                            <StackPanel Margin="0,0,0,18">
                                <TextBlock Text="{Binding Header}" Classes="groupHeader" />
                                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ListItemTemplate}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>

        <!-- ============ Details ============ -->
        <DockPanel Grid.Row="1" IsVisible="{Binding IsDetailsView}" Margin="24,18,24,0">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="52,*,110,70,70,140" Margin="0,0,16,8">
                <TextBlock Grid.Column="1" Text="Name" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PbTextFaintBrush}" Margin="10,0,0,0" />
                <TextBlock Grid.Column="2" Text="Content Type" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PbTextFaintBrush}" />
                <TextBlock Grid.Column="3" Text="Issues" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PbTextFaintBrush}" />
                <TextBlock Grid.Column="4" Text="Unread" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PbTextFaintBrush}" />
                <TextBlock Grid.Column="5" Text="Publisher" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PbTextFaintBrush}" />
            </Grid>
            <ScrollViewer x:Name="DetailsScrollViewer">
                <Grid>
                    <ItemsControl IsVisible="{Binding !IsGrouped}" ItemsSource="{Binding Covers}"
                                  ItemTemplate="{StaticResource DetailsItemTemplate}" Margin="0,0,0,40" />
                    <ItemsControl IsVisible="{Binding IsGrouped}" ItemsSource="{Binding Groups}" Margin="0,0,0,40">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:SeriesCardGroup">
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="{Binding Header}" Classes="groupHeader" />
                                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource DetailsItemTemplate}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </DockPanel>

        <!-- ============ Tiles ============ -->
        <ScrollViewer x:Name="TilesScrollViewer" Grid.Row="1" IsVisible="{Binding IsTilesView}">
            <Grid>
                <ItemsControl IsVisible="{Binding !IsGrouped}" ItemsSource="{Binding Covers}"
                              ItemTemplate="{StaticResource TilesItemTemplate}" Margin="24,18,24,40">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <ItemsControl IsVisible="{Binding IsGrouped}" ItemsSource="{Binding Groups}" Margin="24,18,24,40">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:SeriesCardGroup">
                            <StackPanel Margin="0,0,0,18">
                                <TextBlock Text="{Binding Header}" Classes="groupHeader" />
                                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource TilesItemTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>

        <!-- ============ A-Z jump indexer ============ -->
        <!-- Approximate scroll-to-letter (docs/superpowers/specs/2026-08-09-library-toolbar-design.md
             Phase B) - no virtualized ListBox backs this grid, so there's no real ScrollIntoView;
             LibraryScreen.axaml.cs estimates a row-based offset instead. Only meaningful against an
             alphabetically-sorted, ungrouped flat list (Phase C's ShowAlphabetIndex). -->
        <Border Grid.Row="1" IsVisible="{Binding ShowAlphabetIndex}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                Background="{DynamicResource PbChromeBrush}" BorderBrush="{DynamicResource PbBorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="2,6">
            <ItemsControl ItemsSource="{Binding AlphabetIndexLetters}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Vertical" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Button Content="{Binding}" Click="OnAlphabetIndexLetterClick" Tag="{Binding}"
                                Background="Transparent" BorderThickness="0" Padding="4,1" FontSize="9.5"
                                Foreground="{DynamicResource PbTextFaintBrush}" Cursor="Hand"
                                HorizontalContentAlignment="Center" HorizontalAlignment="Stretch" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- P6 fix (docs/alpha-todo.md): none of the 7 display modes had a "no series match" empty
             state - a zero-result search/filter combination (or an empty library) just rendered a
             blank area below the toolbar. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding !HasAnyResults}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Classes="icon" Width="13" Height="13">
                <Border.OpacityMask>
                    <ImageBrush Source="/Assets/Icons/Info.png" Stretch="Uniform" />
                </Border.OpacityMask>
            </Border>
            <TextBlock Text="No series match your filters." FontSize="13" Foreground="{DynamicResource PbTextFaintBrush}" />
        </StackPanel>

    </Grid>
</UserControl>
