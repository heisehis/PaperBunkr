<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:controls="using:Paperbunkr.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Paperbunkr.App.Views.SmartTemplateGallery"
             x:DataType="vm:SmartTemplateGalleryViewModel">

    <!-- The "New Smart List" gallery (docs/superpowers/specs/2026-10-06-smart-features-design.md §3.2): kind tabs, a card grid with
         "Blank list" first, each template's rules as chips, and a Create button. -->
    <UserControl.Styles>
        <StyleInclude Source="avares://Paperbunkr.App/Styles/ReadingListsChrome.axaml" />

        <!-- Cards fill their grid cell; the gaps come from the UniformGrid's own spacing, so every row and column gap is the same 12 px. -->
        <Style Selector="Button.clickCard">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
    </UserControl.Styles>

    <controls:OverlayShell IsOpen="{Binding IsOpen}" CloseCommand="{Binding CloseCommand}" CloseButtonAutomationId="SmartTemplateGalleryCloseButton">
        <!-- The card list scrolls itself; the kind tabs stay put above it. -->
        <controls:DialogCard Title="New smart list" Size="Large" IsBodyScrollable="False" Margin="40" KeyboardNavigation.TabNavigation="Cycle"
                             AutomationProperties.AutomationId="SmartTemplateGallery">
            <Grid RowDefinitions="Auto,*" RowSpacing="12">
            <ItemsControl Grid.Row="0" ItemsSource="{Binding Kinds}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SmartTemplateKindTab">
                        <Button Classes="segItem segToggle" Classes.on="{Binding IsActive}" Content="{Binding Label}"
                                Command="{Binding $parent[ItemsControl].((vm:SmartTemplateGalleryViewModel)DataContext).SelectKindCommand}"
                                CommandParameter="{Binding}" AutomationProperties.Name="{Binding Label}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="CardList" ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" ColumnSpacing="12" RowSpacing="12" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SmartTemplateCard">
                            <Button Classes="clickCard" Classes.on="{Binding IsSelected}"
                                    Command="{Binding $parent[ItemsControl].((vm:SmartTemplateGalleryViewModel)DataContext).SelectCardCommand}"
                                    CommandParameter="{Binding}" DoubleTapped="OnCardDoubleTapped"
                                    AutomationProperties.Name="{Binding Name}">
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <fi:SymbolIcon Symbol="Add" FontSize="{StaticResource PbIconSizeXs}" IsVisible="{Binding IsBlank}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PbTextBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding Chips}" IsVisible="{Binding !IsBlank}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border Classes="pbChip" Margin="0,4,4,0">
                                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource PbTextMutedBrush}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            </Grid>
            <controls:DialogCard.Footer>
                <StackPanel>
                    <Button Classes="ghost" Content="Cancel" Command="{Binding CloseCommand}" AutomationProperties.AutomationId="SmartTemplateGalleryCancelButton" />
                    <Button Classes="primary" Content="{Binding CreateLabel}" Click="OnCreateClick" AutomationProperties.AutomationId="SmartTemplateGalleryCreateButton" />
                </StackPanel>
            </controls:DialogCard.Footer>
        </controls:DialogCard>
    </controls:OverlayShell>
</UserControl>
