<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- MinimalNative/ThrowingNative are each their own SDK project nested under this one
         (SampleNativePlugins/<name>/) - excluded from this project's own default **/*.cs glob so
         their .cs sources and generated obj/ AssemblyInfo files aren't compiled twice (once by
         their own .csproj, once swept in here). -->
    <Compile Remove="SampleNativePlugins\MinimalNative\**\*.cs" />
    <Compile Remove="SampleNativePlugins\ThrowingNative\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paperbunkr.Plugins\Paperbunkr.Plugins.csproj" />
    <!-- Test fixtures only (implementation plan Phase 1 Step 1.3/1.4, and docs/superpowers/specs/
         2026-09-12-plugin-management-screen-redesign-plan.md Step 2) - minimal real compiled
         native-tier plugins; the tests locate each built DLL via typeof(...).Assembly.Location
         rather than relying on build-output-copying conventions, so no CopyToOutputDirectory wiring
         is needed for either. -->
    <ProjectReference Include="SampleNativePlugins\MinimalNative\MinimalNative.csproj" />
    <ProjectReference Include="SampleNativePlugins\ThrowingNative\ThrowingNative.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real end-to-end fixture plugins - copied to output so each *PluginTests class can point
         PluginEngine.Discover at an absolute, stable path. -->
    <None Include="SamplePlugins\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Duplicate Finder (docs/superpowers/specs/2026-08-24-plugin-api-v2-design.md §7 - the "one
         real test plugin" the Beta bar asks for) is no longer a separate test-only copy - this
         pulls the exact same source repo root sample-plugins/DuplicateFinder/ ships to real users
         (docs/superpowers/specs/2026-09-05-plugin-api-v2-remaining-hooks-plan.md follow-up), so the
         two can never drift apart. Paperbunkr.App.Tests/PluginPackageServiceTests.cs separately
         proves the *packaged* sample-plugins/DuplicateFinder.zip installs correctly - this fixture
         is for exercising hook logic against the loose source. -->
    <None Include="..\..\sample-plugins\DuplicateFinder\**" Link="SamplePlugins\DuplicateFinder\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
