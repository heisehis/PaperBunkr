<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Paperbunkr.App.Models"
             xmlns:entities="using:Paperbunkr.Data.Entities"
             xmlns:views="using:Paperbunkr.App.Views"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:controls="using:Paperbunkr.App.Controls"
             xmlns:reader="using:Paperbunkr.App.Views.Reader"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="600"
             x:Class="Paperbunkr.App.Views.ReaderSettingsSheet"
             x:Name="Root">

    <!-- Font & Theme sheet, redesigned into grouped mini-cards rather than 8 flat stacked sections
         (docs/superpowers/specs/2026-09-03-books-reader-hud-redesign-design.md). The approved
         design's original "controls stay a bottom sheet" call didn't hold up once seen on-screen
         (real user feedback after the first on-screen pass), so it became a drawer - originally on
         the right, deliberately opposite ReaderListDrawer's left (TOC/Bookmarks/Highlights/Search),
         but commit fbaa4de (2026-09-05) later flipped it to the left too, "matching every other
         reader drawer's now-consistent side" - this comment previously went stale on that point,
         fixed 2026-09-16.

         Hosted in a real, separately-owned Window (OverlayWindowController, wired from
         ReaderSettingsSheet.axaml.cs) rather than a Popup - Popup + ShouldUseOverlayLayer="False"
         alone does NOT reliably keep this sheet above the reading pane's native WebView in this
         app: Program.cs's Win32PlatformOptions.OverlayPopups = true overrides it app-wide (see the
         detailed airspace-problem note above BookReaderScreen.axaml's own NativeWebView element). A
         real Window isn't subject to OverlayPopups at all. This Grid is UserControl.Content only
         nominally - the code-behind detaches it immediately in the constructor and re-parents it
         into/out of a real Window as IsOpen changes, so it never actually renders inline here. -->
    <Grid x:Name="OverlayRoot" Width="{Binding #Root.OverlayReference.Bounds.Width}" Height="{Binding #Root.OverlayReference.Bounds.Height}">
        <!-- Local styles declared here (not UserControl.Styles) so they travel with this Grid when
             it's reparented into the overlay Window - Avalonia resolves Styles by walking up from
             the styled element's own current logical parent, and once this Grid is re-parented, the
             UserControl above stops being an ancestor. -->
        <Grid.Styles>
            <Style Selector="TextBlock.cardTitle">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>
        </Grid.Styles>
        <Border Background="{DynamicResource PbReaderScrimBrush}" PointerPressed="OnScrimPointerPressed" />
            <!-- A floating card under the actions cluster (books redesign §5.3), its tokens re-tinted from the book theme in code-behind. -->
            <Border x:Name="SheetCard" HorizontalAlignment="Right" Width="360" Margin="0,72,16,16" Background="{DynamicResource PbChromeBrush}"
                    BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource PbRadiusLg}"
                    BoxShadow="{StaticResource PbElevationShadow}" Padding="16">
                <ScrollViewer>
                <StackPanel Spacing="14">

                    <!-- Paged or scroll (docs/superpowers/specs/2026-10-27-books-reader-paged-scroll-modes-design.md §5): app-wide, remembered. -->
                    <Border Classes="card" IsVisible="{Binding #Root.HasReadingAids}">
                        <StackPanel Spacing="14">
                            <TextBlock Classes="cardTitle" Text="LAYOUT" Foreground="{Binding #Root.SheetForeground}" />
                            <Border Classes="segGroup" HorizontalAlignment="Stretch">
                                <UniformGrid Rows="1" ColumnSpacing="2">
                                    <Button Classes="segItem" Classes.on="{Binding #Root.LayoutPaged}" Content="Paged" HorizontalAlignment="Stretch"
                                            Command="{Binding #Root.SetLayoutCommand}" CommandParameter="{x:Static entities:BookReaderLayout.Paged}"
                                            AutomationProperties.AutomationId="BookReaderLayout_Paged" />
                                    <Button Classes="segItem" Classes.on="{Binding !#Root.LayoutPaged}" Content="Scroll" HorizontalAlignment="Stretch"
                                            Command="{Binding #Root.SetLayoutCommand}" CommandParameter="{x:Static entities:BookReaderLayout.Scroll}"
                                            AutomationProperties.AutomationId="BookReaderLayout_Scroll" />
                                </UniformGrid>
                            </Border>
                            <TextBlock Classes="fieldLabel" TextWrapping="Wrap" Foreground="{Binding #Root.SheetForeground}"
                                       Text="Paged shows one screen at a time and starts every chapter on a new page. Scroll shows a chapter as one long page." />
                        </StackPanel>
                    </Border>

                    <Border Classes="card" IsVisible="{Binding #Root.HasTypographyControls}">
                        <StackPanel Spacing="14">
                            <TextBlock Classes="cardTitle" Text="TYPOGRAPHY" Foreground="{Binding #Root.SheetForeground}" />

                            <StackPanel Spacing="8">
                                <TextBlock Classes="fieldLabel" Text="Text size" Foreground="{Binding #Root.SheetForeground}" />
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Text="A" FontSize="12" Foreground="{Binding #Root.SheetForeground}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Slider Grid.Column="1" Minimum="{x:Static models:BookReaderSettings.MinFontSize}" Maximum="{x:Static models:BookReaderSettings.MaxFontSize}"
                                            Value="{Binding #Root.Settings.FontSize}" />
                                    <TextBlock Grid.Column="2" Text="A" FontSize="22" Foreground="{Binding #Root.SheetForeground}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Classes="fieldLabel" Text="Font" Foreground="{Binding #Root.SheetForeground}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="secondary" Classes.active="{Binding #Root.Settings.FontFamilyOption, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:BookFontFamilyOption.Serif}}"
                                            Content="Serif" FontFamily="Georgia,Cambria,serif"
                                            Command="{Binding #Root.SetFontFamilyCommand}" CommandParameter="{x:Static entities:BookFontFamilyOption.Serif}" />
                                    <Button Classes="secondary" Classes.active="{Binding #Root.Settings.FontFamilyOption, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:BookFontFamilyOption.Sans}}"
                                            Content="Sans" FontFamily="Segoe UI,Arial,sans-serif"
                                            Command="{Binding #Root.SetFontFamilyCommand}" CommandParameter="{x:Static entities:BookFontFamilyOption.Sans}" />
                                    <Button Classes="secondary" Classes.active="{Binding #Root.Settings.FontFamilyOption, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:BookFontFamilyOption.Mono}}"
                                            Content="Mono" FontFamily="Consolas,monospace"
                                            Command="{Binding #Root.SetFontFamilyCommand}" CommandParameter="{x:Static entities:BookFontFamilyOption.Mono}" />
                                    <Button Classes="secondary" Classes.active="{Binding #Root.Settings.FontFamilyOption, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:BookFontFamilyOption.OpenDyslexic}}"
                                            Content="OpenDyslexic" FontFamily="OpenDyslexic,Georgia,Cambria,serif"
                                            Command="{Binding #Root.SetFontFamilyCommand}" CommandParameter="{x:Static entities:BookFontFamilyOption.OpenDyslexic}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Classes="fieldLabel" Text="Line spacing" Foreground="{Binding #Root.SheetForeground}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="secondary" Classes.active="{Binding #Root.Settings.LineSpacing, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:BookLineSpacingOption.Compact}}"
                                            Content="Compact" Command="{Binding #Root.SetLineSpacingCommand}" CommandParameter="{x:Static entities:BookLineSpacingOption.Compact}" />
                                    <Button Classes="secondary" Classes.active="{Binding #Root.Settings.LineSpacing, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:BookLineSpacingOption.Normal}}"
                                            Content="Normal" Command="{Binding #Root.SetLineSpacingCommand}" CommandParameter="{x:Static entities:BookLineSpacingOption.Normal}" />
                                    <Button Classes="secondary" Classes.active="{Binding #Root.Settings.LineSpacing, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:BookLineSpacingOption.Relaxed}}"
                                            Content="Relaxed" Command="{Binding #Root.SetLineSpacingCommand}" CommandParameter="{x:Static entities:BookLineSpacingOption.Relaxed}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Slice 3b (docs/superpowers/specs/2026-10-27-books-slice3b-reader-typography-aids-design.md §3). Justify and
                         hyphenation are per-book (global default + override); the book's-own-styling switch and the installed font are global. -->
                    <Border Classes="card" IsVisible="{Binding #Root.HasTypographyControls}">
                        <StackPanel Spacing="14">
                            <TextBlock Classes="cardTitle" Text="TEXT" Foreground="{Binding #Root.SheetForeground}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Justify text" VerticalAlignment="Center" Foreground="{Binding #Root.SheetForeground}" Margin="0,0,8,0" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding #Root.Settings.Justify}" OnContent="{x:Null}" OffContent="{x:Null}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Hyphenate" VerticalAlignment="Center" Foreground="{Binding #Root.SheetForeground}" Margin="0,0,8,0" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding #Root.Settings.Hyphenate}" OnContent="{x:Null}" OffContent="{x:Null}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Use the book's own styling" VerticalAlignment="Center" Foreground="{Binding #Root.SheetForeground}" Margin="0,0,8,0" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding #Root.Settings.UsePublisherStyles}" OnContent="{x:Null}" OffContent="{x:Null}" />
                            </Grid>
                            <StackPanel Spacing="8">
                                <TextBlock Classes="fieldLabel" Text="Font from this machine" Foreground="{Binding #Root.SheetForeground}" />
                                <controls:SuggestBox IsStrict="True" Watermark="Choose an installed font"
                                                     Text="{Binding #Root.Settings.CustomFont}"
                                                     Suggestions="{x:Static views:ReaderSettingsSheet.InstalledFonts}" />
                            </StackPanel>
                            <TextBlock Classes="fieldLabel" TextWrapping="Wrap" Foreground="{Binding #Root.SheetForeground}"
                                       Text="Justify and hyphenation can differ per book. The styling switch and the font are global. The book's own styling covers what is written inside its chapters; a separate stylesheet file is not loaded." />
                        </StackPanel>
                    </Border>

                    <Border Classes="card" IsVisible="{Binding #Root.HasReadingAids}">
                        <StackPanel Spacing="14">
                            <TextBlock Classes="cardTitle" Text="READING AIDS" Foreground="{Binding #Root.SheetForeground}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Line ruler" VerticalAlignment="Center" Foreground="{Binding #Root.SheetForeground}" Margin="0,0,8,0" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding #Root.RulerOn}" OnContent="{x:Null}" OffContent="{x:Null}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Auto-scroll" VerticalAlignment="Center" Foreground="{Binding #Root.SheetForeground}" Margin="0,0,8,0"
                                           ToolTip.Tip="Scroll layout only: paged reading turns pages instead." />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding #Root.AutoScrollOn}" IsEnabled="{Binding !#Root.LayoutPaged}" OnContent="{x:Null}" OffContent="{x:Null}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Look up unknown words online" VerticalAlignment="Center" Foreground="{Binding #Root.SheetForeground}" Margin="0,0,8,0"
                                           ToolTip.Tip="Sends the selected word to dictionaryapi.dev when the offline dictionary has no entry." />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding #Root.LookUpOnline}" OnContent="{x:Null}" OffContent="{x:Null}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" IsVisible="{Binding #Root.HasSpeech}">
                        <StackPanel Spacing="14">
                            <TextBlock Classes="cardTitle" Text="READ ALOUD" Foreground="{Binding #Root.SheetForeground}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Read this chapter aloud" VerticalAlignment="Center" Foreground="{Binding #Root.SheetForeground}" Margin="0,0,8,0" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding #Root.SpeakOn}" OnContent="{x:Null}" OffContent="{x:Null}" />
                            </Grid>
                            <StackPanel Spacing="8">
                                <TextBlock Classes="fieldLabel" Text="Voice" Foreground="{Binding #Root.SheetForeground}" />
                                <controls:SuggestBox IsStrict="True" Watermark="System default" Text="{Binding #Root.SpeechVoice}"
                                                     Suggestions="{Binding #Root.SpeechVoices}" />
                            </StackPanel>
                            <TextBlock Classes="fieldLabel" TextWrapping="Wrap" Foreground="{Binding #Root.SheetForeground}"
                                       Text="Reads from the top of the page, one paragraph at a time, and stops at the end of the chapter. Speed: Ctrl+Up / Ctrl+Down while reading." />
                        </StackPanel>
                    </Border>

                    <Border Classes="card" IsVisible="{Binding #Root.HasTypographyControls}">
                        <StackPanel Spacing="14">
                            <TextBlock Classes="cardTitle" Text="SPACING &amp; MARGINS" Foreground="{Binding #Root.SheetForeground}" />
                            <StackPanel Spacing="8">
                                <TextBlock Classes="fieldLabel" Text="Character spacing" Foreground="{Binding #Root.SheetForeground}" />
                                <Slider Minimum="0" Maximum="4" Value="{Binding #Root.Settings.CharacterSpacing}" />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Classes="fieldLabel" Text="Word spacing" Foreground="{Binding #Root.SheetForeground}" />
                                <Slider Minimum="0" Maximum="20" Value="{Binding #Root.Settings.WordSpacing}" />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Classes="fieldLabel" Text="Paragraph spacing" Foreground="{Binding #Root.SheetForeground}" />
                                <Slider Minimum="0" Maximum="30" Value="{Binding #Root.Settings.ParagraphSpacing}" />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Classes="fieldLabel" Text="Page margin" Foreground="{Binding #Root.SheetForeground}" />
                                <Slider Minimum="16" Maximum="100" Value="{Binding #Root.Settings.PageMargin}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="14">
                            <TextBlock Classes="cardTitle" Text="THEME" Foreground="{Binding #Root.SheetForeground}" />
                            <!-- The active theme's swatch carries an accent ring (books redesign §5.3). -->
                            <!-- Tag carries the sheet: the content is moved into its own window when open, so the template cannot find the sheet as an ancestor. -->
                            <ItemsControl ItemsSource="{Binding #Root.ThemeOptions}" Tag="{Binding #Root}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="10" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="entities:BookTheme">
                                        <Button Classes="chromeIcon" Width="44" Height="44" Padding="0" x:CompileBindings="False"
                                                Command="{Binding Tag.SetThemeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding}">
                                            <Border CornerRadius="{DynamicResource PbRadius}" BorderThickness="2" Padding="2">
                                                <Border.BorderBrush>
                                                    <MultiBinding Converter="{x:Static reader:ActiveSwatchRingConverter.Instance}">
                                                        <Binding />
                                                        <Binding Path="Tag.Settings.Theme" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                    </MultiBinding>
                                                </Border.BorderBrush>
                                                <Border Classes="themeSwatch" Background="{Binding Converter={x:Static views:BookThemeSwatchConverter.Instance}}" />
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding #Root.HasAutoHideToggle}">
                                <TextBlock Grid.Column="0" Text="Keep toolbar visible" VerticalAlignment="Center" Foreground="{Binding #Root.SheetForeground}" Margin="0,0,8,0" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding #Root.AutoHideToggle, Converter={x:Static reader:InvertBoolConverter.Instance}, Mode=TwoWay}"
                                              OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.Name="Keep toolbar visible" />
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
                </ScrollViewer>
            </Border>
    </Grid>
</UserControl>
