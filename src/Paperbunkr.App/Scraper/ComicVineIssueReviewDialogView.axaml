<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Paperbunkr.App.Scraper"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="380"
             x:Class="Paperbunkr.App.Scraper.ComicVineIssueReviewDialogView"
             x:DataType="vm:ComicVineIssueReviewDialogViewModel">

    <!-- docs/superpowers/specs/2026-09-13-cluster-scraper-ui-redesign-design.md §3: CE's second
         dialog ("Choose a Comic Book Issue"), same list+cover-pane shape as the series dialog for
         visual consistency, no source/sort toolbar. ReadOnlyPeek swaps the footer to a single Close
         button - see the ViewModel's own doc comment. -->
    <UserControl.Styles>
        <Style Selector="Border.selected">
            <Setter Property="Background" Value="{DynamicResource PbAccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Same unified button language as ComicVineMatchReviewDialogView.axaml - see that file's
             own comment for why this is duplicated rather than shared. -->
        <Style Selector="Button.primary">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbBadgeTextBrush}" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.9" />
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource PbSurface1Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="14" Width="640">
        <TextBlock Text="Which issue is this?" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PbTextBrush}" />
        <TextBlock Text="{Binding BookLabel}" FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" TextWrapping="Wrap" />

        <Grid ColumnDefinitions="*,160">
            <!-- Padding for scrollbar breathing room - see ComicVineMatchReviewDialogView.axaml's
                 own comment on this exact fix. -->
            <ScrollViewer Grid.Column="0" MaxHeight="260" Margin="0,0,16,0" Padding="0,0,10,0">
                <ItemsControl ItemsSource="{Binding Candidates}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ComicVineIssueCandidateViewModel">
                            <Border CornerRadius="6" Padding="10,8" Margin="0,2" Classes.selected="{Binding IsSelected}">
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Background="Transparent" BorderThickness="0" Padding="0"
                                        Command="{Binding SelectCommand}">
                                    <TextBlock Text="{Binding DisplayLabel}" TextWrapping="Wrap" Foreground="{DynamicResource PbTextBrush}" />
                                </Button>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Column="1" Spacing="8" HorizontalAlignment="Center">
                <Border Width="140" Height="210" CornerRadius="6" Background="{DynamicResource PbSurface2Brush}">
                    <Image Stretch="Uniform" vm:RemoteCoverImage.SourceUrl="{Binding SelectedCandidate.CoverImageUrl}" />
                </Border>
                <TextBlock Text="{Binding SelectedCandidate.DisplayLabel}" FontSize="12" Foreground="{DynamicResource PbTextBrush}"
                           TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="*,Auto,Auto,Auto" IsVisible="{Binding !ReadOnlyPeek}">
            <Button Grid.Column="1" Content="Go Back" Classes="secondary" Command="{Binding GoBackCommand}" Margin="0,0,8,0" />
            <Button Grid.Column="2" Content="Skip" Classes="secondary" Command="{Binding SkipCommand}" Margin="0,0,8,0" />
            <Button Grid.Column="3" Content="OK" Classes="primary" Command="{Binding ConfirmCommand}" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ReadOnlyPeek}">
            <Button Grid.Column="1" Content="Close" Classes="secondary" Command="{Binding CloseCommand}" />
        </Grid>
    </StackPanel>
</UserControl>
