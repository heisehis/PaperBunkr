<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:models="using:Paperbunkr.App.Models"
             xmlns:entities="using:Paperbunkr.Data.Entities"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="760"
             x:Class="Paperbunkr.App.Views.IssueListScreen"
             x:DataType="vm:IssueListScreenViewModel">

    <UserControl.Resources>
        <DataTemplate x:Key="IssueRowTemplate" x:DataType="models:IssueListRow">
            <Button Classes="issueRow" Command="{Binding $parent[UserControl].((vm:IssueListScreenViewModel)DataContext).OpenIssueCommand}" CommandParameter="{Binding}">
                <Grid ColumnDefinitions="44,60,*,180,150,150,110">
                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="4" Background="{Binding CoverBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding Number}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" />
                    <TextBlock Grid.Column="2" Text="{Binding Title}" VerticalAlignment="Center" FontSize="12.5" Margin="8,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="3" Text="{Binding SeriesName}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="4" Text="{Binding Writer}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="5" Text="{Binding Publisher}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="6" Text="{Binding AddedTime, StringFormat='{}{0:yyyy-MM-dd}'}" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" />
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.modeOption">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.modeOption.active">
            <Setter Property="Background" Value="{DynamicResource PbAccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbAccentTextBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.groupHeader">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style Selector="Button.issueRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.issueRow:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PbAccentSoftBrush}" />
        </Style>
        <Style Selector="Button.headerCol">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextFaintBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.headerCol.active">
            <Setter Property="Foreground" Value="{DynamicResource PbAccentBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <!-- ============ Column headers ============ -->
        <!-- No Sort/Group toolbar here anymore - Library's own top toolbar (LibraryScreen.axaml)
             is the single Sort/Group control for every mode, including this one; see
             LibraryScreenViewModel.SortLabel/GroupLabel for how it delegates to this VM's fields
             when Comic List mode is active. Click-to-sort column headers below are a bonus
             shortcut, not a second copy of that control. -->
        <Grid Grid.Row="0" ColumnDefinitions="44,60,*,180,150,150,110" Margin="34,10,34,6">
            <TextBlock Grid.Column="1" Text="#" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PbTextFaintBrush}" />
            <Button Grid.Column="2" Classes="headerCol" Classes.active="{Binding SortField, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:IssueListSortField.Title}}"
                    Content="Title" Command="{Binding SetSortFieldCommand}" CommandParameter="{x:Static entities:IssueListSortField.Title}" />
            <Button Grid.Column="3" Classes="headerCol" Classes.active="{Binding SortField, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:IssueListSortField.Series}}"
                    Content="Series" Command="{Binding SetSortFieldCommand}" CommandParameter="{x:Static entities:IssueListSortField.Series}" />
            <Button Grid.Column="4" Classes="headerCol" Classes.active="{Binding SortField, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:IssueListSortField.Writer}}"
                    Content="Writer" Command="{Binding SetSortFieldCommand}" CommandParameter="{x:Static entities:IssueListSortField.Writer}" />
            <Button Grid.Column="5" Classes="headerCol" Classes.active="{Binding SortField, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:IssueListSortField.Publisher}}"
                    Content="Publisher" Command="{Binding SetSortFieldCommand}" CommandParameter="{x:Static entities:IssueListSortField.Publisher}" />
            <Button Grid.Column="6" Classes="headerCol" Classes.active="{Binding SortField, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:IssueListSortField.Added}}"
                    Content="Added" Command="{Binding SetSortFieldCommand}" CommandParameter="{x:Static entities:IssueListSortField.Added}" />
        </Grid>

        <!-- ============ Rows ============ -->
        <ScrollViewer Grid.Row="1" Margin="24,0,24,0">
            <Grid>
                <ItemsControl IsVisible="{Binding !IsGrouped}" ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource IssueRowTemplate}" Margin="0,0,0,40" />
                <ItemsControl IsVisible="{Binding IsGrouped}" ItemsSource="{Binding Groups}" Margin="0,0,0,40">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:IssueListRowGroup">
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="{Binding Header}" Classes="groupHeader" Margin="10,8,0,4" />
                                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource IssueRowTemplate}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
