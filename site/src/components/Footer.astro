---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { REPO_URL, WIKI_URL } from '../lib/content';
import { RELEASES_URL } from '../lib/release';

const blob = `${REPO_URL}/blob/master`;
const links = [
  { href: REPO_URL, label: 'GitHub' },
  { href: WIKI_URL, label: 'Wiki' },
  { href: RELEASES_URL, label: 'Releases' },
  { href: `${REPO_URL}/issues`, label: 'Report an issue' },
  { href: `${blob}/PRIVACY.md`, label: 'Privacy' },
  { href: `${blob}/COMICVINE_NOTICE.md`, label: 'ComicVine & Metron notice' },
];
---
<footer>
  <div class="wrap inner">
    <div class="brand">
      <Image src={logo} alt="" width={44} height={44} densities={[1, 2]} />
      <div>
        <strong>PaperBunkr</strong>
        <p>Built on .NET 10 and Avalonia UI.</p>
      </div>
    </div>
    <nav aria-label="Footer">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <p class="legal">
      Free software under the <a href={`${blob}/LICENSE`}>GNU Affero General Public License v3.0</a>.
      Not affiliated with ComicRack, ComicVine or Metron.
    </p>
  </div>
</footer>

<style>
  footer { border-top: 1px solid var(--line); padding: 56px 0 64px; background: var(--bg-raised); }
  .inner { display: grid; grid-template-columns: auto 1fr; gap: 24px 48px; align-items: center; }
  .brand { display: flex; align-items: center; gap: 14px; }
  strong { font-family: var(--font-display); font-weight: 400; font-size: 1.7rem; letter-spacing: 0.05em; line-height: 1; }
  .brand p { margin: 2px 0 0; color: var(--faint); font-size: 0.88rem; }
  nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 10px 24px; }
  nav a { color: var(--muted); text-decoration: none; font-size: 0.95rem; }
  nav a:hover { color: var(--text); text-decoration: underline; }
  .legal { grid-column: 1 / -1; margin: 12px 0 0; padding-top: 24px; border-top: 1px solid var(--line); color: var(--faint); font-size: 0.88rem; }
  .legal a { color: var(--muted); }

  @media (max-width: 760px) {
    .inner { grid-template-columns: minmax(0, 1fr); }
    nav { justify-content: flex-start; }
  }
</style>
