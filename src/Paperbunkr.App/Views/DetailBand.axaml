<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pbc="using:Paperbunkr.App.Controls"
             xmlns:views="using:Paperbunkr.App.Views"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:entities="using:Paperbunkr.Data.Entities"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:sys="using:System"
             xmlns:svc="using:Paperbunkr.App.Services"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="320"
             x:Class="Paperbunkr.App.Views.DetailBand"
             x:DataType="vm:DetailBandViewModel"
             x:Name="u"
             ClipToBounds="False"
             pbc:ContextMenuHost.Provider="{Binding}">

    <!--
        Always-visible band beneath the hero (docs/superpowers/specs/2026-08-28-detail-screens-
        streaming-redesign-design.md). Inline meta row (host screen injects its content-type
        picker via LeadingContent), clamped synopsis, then the tamed metadata groups. Renders
        nothing but the inline row + synopsis when Groups is empty (book "lite" mode).
    -->
    <UserControl.Styles>
        <!-- Squircle chips (PbRadius, matching the Library toolbar's own squircled chips - commit
             07a93af), with a smooth amber-glow reaction on hover: the app's established
             "reactive" idiom (design-language-foundation-design.md - glow ring, no scale-lift). -->
        <!-- Squircle (PbRadius), not a capsule - user direction 2026-09-07 after seeing a 999
             capsule land in the real app (this briefly changed shape during the badge-unification
             pass; reverted). Everything else here (weight-class colors, hover/focus states,
             transitions, the Border variant's glow ring below) is untouched. -->
        <!-- The collapsed synopsis clips its MarkdownView to SynopsisMaxHeight, which would cut the outside focus ring off the
             focusable text blocks and links it renders; draw their ring inside their own bounds instead. -->
        <Style Selector="pbc|MarkdownView.synopsis SelectableTextBlock, pbc|MarkdownView.synopsis Button.mdLink">
            <Setter Property="FocusAdorner" Value="{DynamicResource PbFocusAdornerInside}" />
        </Style>

        <Style Selector="Border.pbChip">
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style Selector="Button.filterChip">
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>

        <!-- Weight-class visuals (docs/superpowers/specs/2026-08-23-weighted-categorized-tags-
             design.md) - Core/Defining read as "this defines the series", Recurrent full-strength,
             Incidental de-emphasised. Unset keeps the plain look.
             Every colour here is one the theme guarantees to read on what it sits on: PbOnAccent on the accent fill, and
             PbAccentText (contrast-adjusted against the background) for accent strokes and text. The raw accent and badge text
             are not: badge text is tuned for the badge colour, so it vanished on accent fills like Vintage Paperback's dark red,
             and a dark accent (a theme's, or the cover-derived one DetailAccentScope sets) disappeared as a dot or border. -->
        <Style Selector="Button.filterChip.core Ellipse">
            <Setter Property="Fill" Value="{DynamicResource PbOnAccentBrush}" />
        </Style>
        <Style Selector="Button.filterChip.incidental">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <!-- Non-interactive Border chips (Virtual Tags) still get the glow-ring on hover. -->
    </UserControl.Styles>

    <Border Background="{DynamicResource PbSurface2Brush}" BorderBrush="{DynamicResource PbAccentBrush}"
            BorderThickness="2,0,0,0" Padding="22,14,24,4">
        <StackPanel Spacing="10">

            <!-- Inline meta row - the content-type picker + derived "special" chips only. Publisher /
                 status / year / format / age-rating / language / reading-status all moved up to the
                 hero badge row (docs/superpowers/specs/2026-09-04-detail-screen-icons-and-glyphs-
                 design.md Part 4); this row hides entirely when nothing's in it. -->
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ContentControl Content="{Binding #u.LeadingContent}" VerticalAlignment="Center" />

                <ItemsControl ItemsSource="{Binding SpecialMarks}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border Classes="pbChip">
                                <TextBlock Text="{Binding}" FontSize="{DynamicResource PbFontSizeMicro}" FontWeight="Bold"
                                           Foreground="{DynamicResource PbTextMutedBrush}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Synopsis -->
            <StackPanel IsVisible="{Binding Summary, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                <pbc:MarkdownView Classes="synopsis" Blocks="{Binding SummaryBlocks}" BaseFontSize="{DynamicResource PbFontSizeBody}" BodyBrushKey="PbTextMutedBrush"
                                  LinkCommand="{x:Static svc:ExternalLinks.OpenWebCommand}"
                                  MaxHeight="{Binding SynopsisMaxHeight}" ClipToBounds="True" />
                <Button Classes="detailGroupMore" Content="{Binding SynopsisToggleLabel}"
                        Command="{Binding ToggleSynopsisCommand}" Margin="0,4,0,0" HorizontalAlignment="Left" />
            </StackPanel>

            <!-- Metadata groups -->
            <ItemsControl ItemsSource="{Binding Groups}" IsVisible="{Binding HasGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DetailBandGroupViewModel">
                        <StackPanel Margin="0,0,0,6">
                            <!-- header -->
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,4">
                                <TextBlock Classes="detailGroupLabel" Text="{Binding Label}" VerticalAlignment="Center" />
                                <Button Classes="detailGroupMore" Content="{Binding MoreLabel}"
                                        Command="{Binding ToggleExpandCommand}" IsVisible="{Binding HasOverflow}" VerticalAlignment="Center" />
                                <Button Classes="detailGroupMore" Content="{Binding RevealHint}"
                                        Command="{Binding ToggleHiddenCommand}" IsVisible="{Binding HasHidden}"
                                        Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- credits group -->
                            <StackPanel IsVisible="{Binding IsCreditsGroup}" Orientation="Horizontal">
                                <ItemsControl ItemsSource="{Binding Writers}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TagPillViewModel">
                                            <Button Classes="creditName" Command="{Binding SearchCommand}" Background="Transparent" BorderThickness="0" Padding="0,0,6,0" Cursor="Hand">
                                                <TextBlock Text="{Binding Value}" FontSize="{DynamicResource PbFontSizeBody}" Foreground="{DynamicResource PbTextBrush}" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="  •  art by  " FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}"
                                           VerticalAlignment="Center" IsVisible="{Binding HasArtists}" />
                                <ItemsControl ItemsSource="{Binding Artists}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TagPillViewModel">
                                            <Button Classes="creditName" Command="{Binding SearchCommand}" Background="Transparent" BorderThickness="0" Padding="0,0,6,0" Cursor="Hand">
                                                <TextBlock Text="{Binding Value}" FontSize="{DynamicResource PbFontSizeBody}" Foreground="{DynamicResource PbTextBrush}" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Classes="detailGroupMore" Content="full credits ›" Command="{Binding FullCreditsCommand}"
                                        Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- regular group -->
                            <ItemsControl ItemsSource="{Binding Chips}" IsVisible="{Binding !IsCreditsGroup}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TagPillViewModel">
                                        <Button Classes="filterChip" Command="{Binding SearchCommand}" ToolTip.Tip="{Binding Category}"
                                                Classes.core="{Binding WeightClass, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=core}"
                                                Classes.defining="{Binding WeightClass, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=defining}"
                                                Classes.recurrent="{Binding WeightClass, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=recurrent}"
                                                Classes.incidental="{Binding WeightClass, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=incidental}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Ellipse Width="5" Height="5" VerticalAlignment="Center" IsVisible="{Binding IsWeighted}"
                                                         Fill="{DynamicResource PbAccentTextBrush}" />
                                                <TextBlock Text="{Binding Value}" FontWeight="{Binding TextWeight}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Virtual Tags -->
            <StackPanel IsVisible="{Binding HasVirtualTags}" Margin="0,0,0,6">
                <TextBlock Classes="detailGroupLabel" Text="Virtual Tags" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding VirtualTags}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="sys:String">
                            <Border Classes="pbChip" BorderBrush="{DynamicResource PbAccentBrush}">
                                <Border.Background>
                                    <SolidColorBrush Color="{DynamicResource PbAccentColor}" Opacity="0.14" />
                                </Border.Background>
                                <TextBlock Text="{Binding}" FontSize="{DynamicResource PbFontSizeMeta}" FontWeight="SemiBold" Foreground="{DynamicResource PbAccentTextBrush}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
