<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="320"
             xmlns:controls="using:Paperbunkr.App.Controls"
             x:Class="Paperbunkr.App.Views.BookSeriesPropertiesOverlay"
             x:DataType="vm:BookSeriesPropertiesScreenViewModel">

    <UserControl.Styles>
    </UserControl.Styles>

    <controls:DialogCard Title="{Binding HeaderLabel}" Size="Medium">
        <StackPanel Margin="20,16,20,16" Spacing="12">
                        <StackPanel>
                            <TextBlock Classes="fieldLabel" Text="NAME" />
                            <TextBox Text="{Binding Name}" AutomationProperties.AutomationId="BookSeriesPropertiesName" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Classes="fieldLabel" Text="SORT NAME" />
                            <TextBox Text="{Binding SortName}" PlaceholderText="Optional — for A–Z ordering" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Classes="fieldLabel" Text="AUTHOR" />
                            <TextBox Text="{Binding Author}" />
                        </StackPanel>
                        <TextBlock Classes="fieldLabel" TextWrapping="Wrap"
                                   Text="Renaming updates the series for every book in it." />
                    </StackPanel>
        <controls:DialogCard.Footer>
            <StackPanel>
                <Button Classes="ghost" Content="Cancel" Command="{Binding CancelCommand}" />
                <Button Classes="primary" Content="Save" Command="{Binding SaveCommand}"
                        AutomationProperties.AutomationId="BookSeriesPropertiesSave" />
            </StackPanel>
        </controls:DialogCard.Footer>
    </controls:DialogCard>
</UserControl>
