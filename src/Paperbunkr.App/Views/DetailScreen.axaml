<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:views="using:Paperbunkr.App.Views"
             xmlns:controls="using:Paperbunkr.App.Controls"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
             x:Class="Paperbunkr.App.Views.DetailScreen"
             x:DataType="vm:DetailScreenViewModel"
             x:Name="Screen">

    <!--
        Series Detail (comic), rebuilt on the shared DetailHero / DetailBand / DetailTabs controls
        for UI rework Phase 5 (docs/superpowers/specs/2026-08-28-detail-screens-streaming-redesign-
        design.md). The tab strip is not sticky - Avalonia has no native sticky positioning and the
        design's Risks section allows a non-sticky fallback.
    -->
    <UserControl.Styles>
        <!-- contentTypePicker: the accent "pill" look for the reclassify SuggestBox. Brush/radius
             setters ride the ControlTheme's TemplateBindings down to PART_TextBox; the inner
             padding/min-height need the /template/ selector since those aren't template-bound
             (they must keep the FluentAvalonia TextBox defaults everywhere else). FontSize/Weight
             inherit into the TextBox on their own. -->
        <Style Selector="controls|SuggestBox.contentTypePicker">
            <Setter Property="Background" Value="{DynamicResource PbAccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadius}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PbAccentTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="controls|SuggestBox.contentTypePicker /template/ TextBox#PART_TextBox">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="controls|SuggestBox.contentTypePicker:pointerover">
            <Setter Property="Background" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbBadgeTextBrush}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="0,0,0,50">
            <Button Classes="backLink" Command="{Binding GoBackCommand}" Margin="28,20,28,12">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <fi:SymbolIcon Symbol="ArrowLeft" FontSize="{StaticResource PbIconSizeSm}" VerticalAlignment="Center" />
                    <TextBlock Text="Back to Library" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <views:DetailHero DataContext="{Binding}" />

            <views:DetailBand DataContext="{Binding Band}">
                <views:DetailBand.LeadingContent>
                    <controls:SuggestBox Classes="contentTypePicker" IsStrict="True"
                                         Text="{Binding #Screen.((vm:DetailScreenViewModel)DataContext).SelectedContentTypeText}"
                                         Suggestions="{Binding #Screen.((vm:DetailScreenViewModel)DataContext).ContentTypeNames}"
                                         ToolTip.Tip="Content Type" />
                </views:DetailBand.LeadingContent>
            </views:DetailBand>

            <views:DetailTabs DataContext="{Binding Tabs}" Margin="28,0,28,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
