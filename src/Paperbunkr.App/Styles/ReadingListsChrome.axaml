<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Paperbunkr.App.Controls">
    <!-- Shared chrome for the Reading Lists section (docs/superpowers/specs/2026-09-28-reading-lists-redesign-design.md), included by each of
         its views the way ContinuityChrome.axaml is. Every colour is a Pb skin resource. -->

    <Style Selector="Button.headerAction">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusSm}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.headerAction.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
    </Style>
    <Style Selector="Button.headerAction.secondary">
        <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
    </Style>
    <Style Selector="Button.headerAction.primary">
        <Setter Property="Background" Value="{DynamicResource PbAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource PbBadgeTextBrush}" />
    </Style>
    <Style Selector="Button.headerAction.danger">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource PbDangerBrush}" />
    </Style>

    <!-- Path | Covers segmented toggle and the drawer tabs -->
    <Style Selector="Button.segToggle">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusSm}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
    </Style>
    <Style Selector="Button.segToggle.on">
        <Setter Property="Background" Value="{DynamicResource PbSurface3Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Captions -->
    <Style Selector="TextBlock.rlCaption">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="0.8" />
        <Setter Property="Foreground" Value="{DynamicResource PbTextFaintBrush}" />
    </Style>
    <Style Selector="TextBlock.rlFaint">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource PbTextFaintBrush}" />
    </Style>

    <!-- Gallery tiles and Continue cards -->
    <Style Selector="Button.rlTile">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.rlTile:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- a missing issue's row/tile is a disabled button (nothing to read): keep it flat, not the theme's grey disabled box -->
    <Style Selector="Button.rlTile:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.rlTileCover">
        <Setter Property="CornerRadius" Value="{DynamicResource PbRadius}" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="{DynamicResource PbMotionFast}" Easing="{StaticResource PbMotionEase}" />
            </Transitions>
        </Setter>
    </Style>
    <!-- Hover and focus use Library's card ring (LibraryScreen.axaml's Button.card rules): PbGlowRing plus an accent edge, never transitioned
         (animating BoxShadow tears the ring), clipping dropped while it shows so the spread isn't cut off. -->
    <Style Selector="Button.rlTile">
        <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>
    <Style Selector="Button.rlTile:pointerover Border.rlTileCover, Button.rlTile:focus-within Border.rlTileCover">
        <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
        <Setter Property="BoxShadow" Value="{DynamicResource PbGlowRing}" />
        <Setter Property="ClipToBounds" Value="False" />
    </Style>
    <Style Selector="Border.rlTileHost.dropInto Border.rlTileCover">
        <Setter Property="Background" Value="{DynamicResource PbAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
    </Style>
    <Style Selector="Border.rlDropBar">
        <Setter Property="Width" Value="3" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background" Value="{DynamicResource PbAccentBrush}" />
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Button.rlContinue">
        <Setter Property="Padding" Value="8" />
        <Setter Property="Width" Value="236" />
        <Setter Property="CornerRadius" Value="{DynamicResource PbRadius}" />
        <Setter Property="Background" Value="{DynamicResource PbSurface1Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.rlContinue:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
    </Style>
    <Style Selector="Button.rlChip">
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusChip}" />
        <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.rlChip.on">
        <Setter Property="Background" Value="{DynamicResource PbAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PbAccentTextBrush}" />
    </Style>

    <!-- Cover rail -->
    <!-- 4 px of gutter round the 40x56 cover so its ring has room -->
    <Style Selector="Button.rlRail">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="64" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>
    <Style Selector="Button.rlRail:pointerover /template/ ContentPresenter, Button.rlRail:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.rlRailCover">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PbSurface3Brush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.rlRailCover.active">
        <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
    </Style>
    <Style Selector="Button.rlRail:pointerover Border.rlRailCover, Button.rlRail:focus-within Border.rlRailCover">
        <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
        <Setter Property="BoxShadow" Value="{DynamicResource PbGlowRing}" />
        <Setter Property="ClipToBounds" Value="False" />
    </Style>

    <!-- Journey path: spine segments, dots, chapter diamonds, rows -->
    <Style Selector="Border.rlSpine">
        <Setter Property="Width" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource PbSurface3Brush}" />
    </Style>
    <Style Selector="Border.rlSpine.lit">
        <Setter Property="Background" Value="{DynamicResource PbAccentBrush}" />
    </Style>
    <Style Selector="Border.rlDot">
        <Setter Property="Width" Value="13" />
        <Setter Property="Height" Value="13" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="BorderThickness" Value="2.5" />
        <Setter Property="BorderBrush" Value="{DynamicResource PbSurface3Brush}" />
        <Setter Property="Background" Value="{DynamicResource PbBgBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.rlDot.read">
        <Setter Property="Background" Value="{DynamicResource PbAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
    </Style>
    <Style Selector="Border.rlDot.missing">
        <Setter Property="BorderBrush" Value="{DynamicResource PbTextFaintBrush}" />
        <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="Border.rlDot.current">
        <Setter Property="Width" Value="17" />
        <Setter Property="Height" Value="17" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
    </Style>
    <Style Selector="Border.rlDiamond">
        <Setter Property="Width" Value="11" />
        <Setter Property="Height" Value="11" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource PbSurface3Brush}" />
        <Setter Property="RenderTransform" Value="rotate(45deg)" />
    </Style>
    <Style Selector="Border.rlDiamond.lit">
        <Setter Property="Background" Value="{DynamicResource PbAccentBrush}" />
    </Style>
    <!-- A row, the Up next card and a cover tile are each one Button.rlCard (Library's Button.card model): no command, so a click only focuses;
         double-click, Enter or Space reads (ReadingListPageView's code-behind). Hover and focus show Library's ring - PbGlowRing plus an accent
         edge, BoxShadow never transitioned (a BoxShadowsTransition tears the ring) - and the ringed Border keeps a 4 px gutter inside the card so
         the spread isn't clipped. The Fluent focus rectangle is off; the ring is the focus indicator. -->
    <Style Selector="Button.rlCard">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>
    <Style Selector="Button.rlCard:pointerover /template/ ContentPresenter, Button.rlCard:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.rlCard:pressed">
        <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector="Border.rlRow">
        <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusSm}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="{DynamicResource PbMotionFast}" Easing="{StaticResource PbMotionEase}" />
                <BrushTransition Property="BorderBrush" Duration="{DynamicResource PbMotionFast}" Easing="{StaticResource PbMotionEase}" />
            </Transitions>
        </Setter>
    </Style>
    <!-- :focus-within on Border.rlRow itself would never match - the actually-focused element is Button.rlCard, the row's PARENT, not a
         descendant of it, so these check the button (matching the rlCoverArt/rlUpNext/rlRailCover pattern below) instead. -->
    <Style Selector="Border.rlRow:pointerover, Button.rlCard:focus-within Border.rlRow">
        <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
        <Setter Property="BoxShadow" Value="{DynamicResource PbGlowRing}" />
    </Style>
    <Style Selector="TextBlock.rlTitle">
        <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
    </Style>
    <Style Selector="Border.rlRow.read TextBlock.rlTitle">
        <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
    </Style>
    <Style Selector="Border.rlCoverArt">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Button.rlCard:pointerover Border.rlCoverArt, Button.rlCard:focus-within Border.rlCoverArt">
        <Setter Property="BoxShadow" Value="{DynamicResource PbGlowRing}" />
        <Setter Property="ClipToBounds" Value="False" />
    </Style>
    <Style Selector="Border.rlRow :is(Control).rlHover">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Border.rlRow:pointerover :is(Control).rlHover, Button.rlCard:focus-within Border.rlRow :is(Control).rlHover">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <Style Selector="Border.rlRow.selected">
        <Setter Property="Background" Value="{DynamicResource PbAccentSoftBrush}" />
    </Style>
    <Style Selector="Border.rlRow.dragging">
        <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="Border.rlInsertLine">
        <Setter Property="Height" Value="2" />
        <Setter Property="Background" Value="{DynamicResource PbAccentBrush}" />
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Border.rlUpNext">
        <Setter Property="CornerRadius" Value="{DynamicResource PbRadius}" />
        <Setter Property="Background" Value="{DynamicResource PbAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="Button.rlCard:pointerover Border.rlUpNext, Button.rlCard:focus-within Border.rlUpNext">
        <Setter Property="BoxShadow" Value="{DynamicResource PbGlowRing}" />
    </Style>
    <Style Selector="Button.rlChapter">
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.rlChapter:pointerover /template/ ContentPresenter, Button.rlChapter:focus-visible /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PbSurface3Brush}" />
    </Style>

    <!-- Checks strip, edit bars, drawer -->
    <Style Selector="Border.rlStrip">
        <Setter Property="CornerRadius" Value="{DynamicResource PbRadius}" />
        <Setter Property="Background" Value="{DynamicResource PbSurface1Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.rlStripLine">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="Border.rlStripLine.first">
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.rlBar">
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="CornerRadius" Value="{DynamicResource PbRadius}" />
        <Setter Property="Background" Value="{DynamicResource PbSurface1Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.rlBar.accent">
        <Setter Property="Background" Value="{DynamicResource PbAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
    </Style>
    <Style Selector="Border.rlDrawer">
        <Setter Property="Background" Value="{DynamicResource PbSurface1Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
        <Setter Property="BoxShadow" Value="-12 0 28 0 #66000000" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource PbMotionStandard}" Easing="{StaticResource PbMotionEase}" />
                <DoubleTransition Property="Opacity" Duration="{DynamicResource PbMotionStandard}" Easing="{StaticResource PbMotionEase}" />
            </Transitions>
        </Setter>
        <Setter Property="RenderTransform" Value="translateX(380px)" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Border.rlDrawer.open">
        <Setter Property="RenderTransform" Value="translateX(0px)" />
        <Setter Property="Opacity" Value="1" />
        <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
</Styles>
