<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="320"
             xmlns:controls="using:Paperbunkr.App.Controls"
             x:Class="Paperbunkr.App.Views.QuickRateOverlay"
             x:DataType="vm:QuickRateScreenViewModel">

    <!-- Cancel/Save now use the shared Button.ghost/Button.primary primitives (Styles/Primitives.axaml)
         in place of this file's former local "headerAction" styles - see docs/superpowers/specs/
         2026-08-24-design-language-foundation-design.md Component Primitives section. -->
    <UserControl.Styles>
        <Style Selector="Button.star">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.star fi|SymbolIcon">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextFaintBrush}" />
        </Style>
        <Style Selector="Button.star.filled fi|SymbolIcon">
            <Setter Property="Foreground" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="IconVariant" Value="Filled" />
        </Style>
    </UserControl.Styles>

    <controls:DialogCard Title="Quick rate" Subtitle="{Binding HeaderLabel}" Size="Small" CloseCommand="{Binding CancelCommand}">
        <StackPanel Spacing="16">
            <StackPanel>
                <TextBlock Classes="fieldLabel" Text="RATING" />
                <StackPanel Orientation="Horizontal" Spacing="3">
                    <Button AutomationProperties.Name="Rate 1 star" Classes="star" Classes.filled="{Binding Star1}" Command="{Binding SetStar1Command}"><fi:SymbolIcon Symbol="Star" /></Button>
                    <Button AutomationProperties.Name="Rate 2 stars" Classes="star" Classes.filled="{Binding Star2}" Command="{Binding SetStar2Command}"><fi:SymbolIcon Symbol="Star" /></Button>
                    <Button AutomationProperties.Name="Rate 3 stars" Classes="star" Classes.filled="{Binding Star3}" Command="{Binding SetStar3Command}"><fi:SymbolIcon Symbol="Star" /></Button>
                    <Button AutomationProperties.Name="Rate 4 stars" Classes="star" Classes.filled="{Binding Star4}" Command="{Binding SetStar4Command}"><fi:SymbolIcon Symbol="Star" /></Button>
                    <Button AutomationProperties.Name="Rate 5 stars" Classes="star" Classes.filled="{Binding Star5}" Command="{Binding SetStar5Command}"><fi:SymbolIcon Symbol="Star" /></Button>
                </StackPanel>
            </StackPanel>
            <StackPanel>
                <TextBlock Classes="fieldLabel" Text="REVIEW" />
                <TextBox Text="{Binding Review}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" />
            </StackPanel>
        </StackPanel>
        <controls:DialogCard.Footer>
            <StackPanel>
                <Button Classes="ghost" Content="Cancel" Command="{Binding CancelCommand}" />
                <Button Classes="primary" Content="Save" Command="{Binding SaveCommand}" />
            </StackPanel>
        </controls:DialogCard.Footer>
    </controls:DialogCard>
</UserControl>
