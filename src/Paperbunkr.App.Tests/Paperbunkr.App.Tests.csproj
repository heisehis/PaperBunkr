<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <!-- Bootstraps a real (windowless) Avalonia platform once per test assembly (TestAppBuilder.cs)
         - needed because Avalonia.Media.Imaging.Bitmap construction requires
         IPlatformRenderInterface to be registered, which only happens once an AppBuilder has run. -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paperbunkr.App\Paperbunkr.App.csproj" />
  </ItemGroup>

  <!-- The real, shipped Duplicate Finder plugin package (repo root sample-plugins/, not test
       fixture data) - PluginPackageServiceTests installs this exact .zip to prove the actual
       distributable a user would download works end-to-end, not just its loose source files
       (which src/Paperbunkr.Plugins.Tests/SamplePlugins/DuplicateFinder/ already covers). -->
  <ItemGroup>
    <None Include="..\..\sample-plugins\DuplicateFinder.zip" Link="SamplePlugins\DuplicateFinder.zip" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
