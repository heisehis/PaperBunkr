<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:views="using:Paperbunkr.App.Views"
             xmlns:models="using:Paperbunkr.App.Models"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:controls="using:Paperbunkr.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="900"
             x:Class="Paperbunkr.App.Views.MangaDetailScreen"
             x:DataType="vm:MangaDetailScreenViewModel"
             x:Name="Screen"
             controls:ContextMenuHost.Provider="{Binding}">

    <!--
        Manga/Manhua/Manhwa detail, rebuilt on the shared DetailHero / DetailBand / DetailTabs
        controls for UI rework Phase 5 (docs/superpowers/specs/2026-08-28-detail-screens-streaming-
        redesign-design.md). Distinct from the comic screen by its Chapters tab: a release feed with
        volume section headers, scanlation groups, relative dates, and NEW badges - no cover tiles
        (manga chapters have no variant covers). A tracker-progress ring + native-title line are a
        deferred follow-up (needs provider-payload parsing).
    -->
    <UserControl.Styles>
        <!-- See DetailScreen.axaml for why this splits into a control-level + a /template/ style. -->
        <Style Selector="controls|SuggestBox.contentTypePicker">
            <Setter Property="Background" Value="{DynamicResource PbAccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadius}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PbAccentTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="controls|SuggestBox.contentTypePicker /template/ TextBox#PART_TextBox">
            <Setter Property="Padding" Value="10,0" />
            <!-- Same 28 px as the Undo / Needs review buttons beside it (2026-10-20 remaining screens Q2). -->
            <Setter Property="MinHeight" Value="{DynamicResource PbControlHeight}" />
        </Style>


        <Style Selector="TextBlock.volumeHeader">
            <Setter Property="FontFamily" Value="{DynamicResource PbDisplayFontFamily}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="LetterSpacing" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>

        <Style Selector="Button.chapterRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="8,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.chapterRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource PbSurface3Brush}" />
        </Style>
        <Style Selector="Button.chapterRow.read">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="TextBlock.chapterNumber">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
        </Style>
        <Style Selector="TextBlock.chapterTitle">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.chapterMeta">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ProgressBar.chapterProgress">
            <Setter Property="Height" Value="3" />
            <Setter Property="Foreground" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="0" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="0,0,0,50">
            <Button Classes="backLink" Command="{Binding GoBackCommand}" Margin="24,20,24,12">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <fi:SymbolIcon Symbol="ArrowLeft" FontSize="{StaticResource PbIconSizeSm}" VerticalAlignment="Center" />
                    <TextBlock Text="Back to Library" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <views:DetailHero DataContext="{Binding}" />

            <views:DetailBand DataContext="{Binding Band}">
                <views:DetailBand.LeadingContent>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:SuggestBox Classes="contentTypePicker" IsStrict="True"
                                             Text="{Binding #Screen.((vm:MangaDetailScreenViewModel)DataContext).SelectedContentTypeText}"
                                             Suggestions="{Binding #Screen.((vm:MangaDetailScreenViewModel)DataContext).ContentTypeNames}"
                                             ToolTip.Tip="Content Type" />
                        <Button Classes="ghost" Content="Needs review" VerticalAlignment="Center"
                                IsVisible="{Binding #Screen.((vm:MangaDetailScreenViewModel)DataContext).NeedsReview}"
                                Command="{Binding #Screen.((vm:MangaDetailScreenViewModel)DataContext).EditSeriesCommand}"
                                ToolTip.Tip="This series' chapters disagree on some details (for example two publishers). Open Edit Series to confirm them."
                                AutomationProperties.Name="Needs review: open Edit Series" />
                        <Button Classes="ghost" Content="Undo" VerticalAlignment="Center"
                                IsVisible="{Binding #Screen.((vm:MangaDetailScreenViewModel)DataContext).CanUndoContentType}"
                                Command="{Binding #Screen.((vm:MangaDetailScreenViewModel)DataContext).UndoContentTypeCommand}"
                                ToolTip.Tip="{Binding #Screen.((vm:MangaDetailScreenViewModel)DataContext).UndoContentTypeLabel, StringFormat='{}{0}. Undo puts the old type back.'}"
                                AutomationProperties.Name="Undo the automatic content type" />
                    </StackPanel>
                </views:DetailBand.LeadingContent>
            </views:DetailBand>

            <StackPanel Margin="24,0,24,0">
                <!-- Unified tab strip -->
                <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,0,0,1" Margin="0,18,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <Button Classes="tab" Classes.active="{Binding IsChaptersTab}" Command="{Binding GoChaptersTabCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <fi:SymbolIcon Symbol="TextBulletList" FontSize="{StaticResource PbIconSizeSm}" VerticalAlignment="Center" />
                                <TextBlock Text="Chapters" VerticalAlignment="Center" />
                                <TextBlock Classes="tabCount" Text="{Binding Chapters.Count}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="tab" Classes.active="{Binding IsRelatedTabActive}" Command="{Binding GoRelatedTabCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <fi:SymbolIcon Symbol="Link" FontSize="{StaticResource PbIconSizeSm}" VerticalAlignment="Center" />
                                <TextBlock Text="Related" VerticalAlignment="Center" />
                                <TextBlock Classes="tabCount" Text="{Binding Tabs.Related.Count}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="tab" Classes.active="{Binding IsDetailsTabActive}" Command="{Binding GoDetailsTabCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <fi:SymbolIcon Symbol="Info" FontSize="{StaticResource PbIconSizeSm}" VerticalAlignment="Center" />
                                <TextBlock Text="Details" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="tab" Classes.active="{Binding IsActivityTabActive}" Command="{Binding GoActivityTabCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <fi:SymbolIcon Symbol="Pulse" FontSize="{StaticResource PbIconSizeSm}" VerticalAlignment="Center" />
                                <TextBlock Text="Activity" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Chapters tab: release feed -->
                <StackPanel IsVisible="{Binding IsChaptersTab}" controls:Replace.On="{Binding IsChaptersTab}" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                        <Button Classes="filterChip" Classes.active="{Binding ChapterFilter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static models:ChapterListFilter.All}}"
                                Content="All" Command="{Binding SetChapterFilterCommand}" CommandParameter="{x:Static models:ChapterListFilter.All}" />
                        <Button Classes="filterChip" Classes.active="{Binding ChapterFilter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static models:ChapterListFilter.Unread}}"
                                Content="Unread" Command="{Binding SetChapterFilterCommand}" CommandParameter="{x:Static models:ChapterListFilter.Unread}" />
                        <Button Classes="filterChip" Classes.active="{Binding ChapterFilter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static models:ChapterListFilter.Bookmarked}}"
                                Content="Bookmarked" Command="{Binding SetChapterFilterCommand}" CommandParameter="{x:Static models:ChapterListFilter.Bookmarked}" />
                        <Button Classes="filterChip" Classes.active="{Binding ChapterFilter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static models:ChapterListFilter.Missing}}"
                                Content="Missing" Command="{Binding SetChapterFilterCommand}" CommandParameter="{x:Static models:ChapterListFilter.Missing}" />
                        <Border Width="1" Background="{DynamicResource PbBorderBrush}" Margin="6,2" />
                        <Button Classes="filterChip" Classes.active="{Binding IsChapterSortByNumber}"
                                Command="{Binding SetChapterSortFieldCommand}" CommandParameter="{x:Static models:ChapterSortField.Number}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <fi:SymbolIcon Symbol="TextSortAscending" FontSize="{StaticResource PbIconSizeXs}" VerticalAlignment="Center" />
                                <TextBlock Text="By Number" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="filterChip" Classes.active="{Binding IsChapterSortByDate}"
                                Command="{Binding SetChapterSortFieldCommand}" CommandParameter="{x:Static models:ChapterSortField.Date}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <fi:SymbolIcon Symbol="Calendar" FontSize="{StaticResource PbIconSizeXs}" VerticalAlignment="Center" />
                                <TextBlock Text="By Date" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="filterChip" Command="{Binding ToggleChapterSortDirectionCommand}"
                                ToolTip.Tip="Toggle sort direction" AutomationProperties.Name="Toggle sort direction">
                            <fi:SymbolIcon Symbol="{Binding ChapterSortDirectionSymbol}" FontSize="{StaticResource PbIconSizeXs}" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>

                    <TextBlock IsVisible="{Binding !HasChapters}" Text="No chapters match this filter." FontSize="13"
                               Foreground="{DynamicResource PbTextMutedBrush}" Margin="0,10,0,0" />

                    <!-- Draggable chapter-table header (resize / reorder columns); 23px = card border + card padding + row padding. -->
                    <views:DetailListHeader x:Name="ChapterListHeader" Cells="{Binding ChapterHeaderCells}" IsVisible="{Binding HasChapters}"
                                            LeadingInset="23,0,0,0" Margin="0,10,0,6" />

                    <ItemsControl x:Name="ChapterGroupsList" ItemsSource="{Binding ChapterGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ChapterVolumeGroup">
                                <Border Classes="card" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Classes="volumeHeader" Text="{Binding VolumeLabel}" />
                                    <ItemsControl ItemsSource="{Binding Chapters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:ChapterRowSample">
                                                <Button Classes="chapterRow" Classes.read="{Binding IsRead}" KeyDown="OnChapterKeyDown"
                                                        Command="{Binding #ChapterGroupsList.((vm:MangaDetailScreenViewModel)DataContext).OpenChapterCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Grid>
                                                        <ItemsControl ItemsSource="{Binding ListCells}" VerticalAlignment="Center">
                                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="models:DetailListCell">
                                                                    <TextBlock Width="{Binding Width}" Text="{Binding Text}" VerticalAlignment="Center" Margin="8,0"
                                                                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource PbTextMutedBrush}"
                                                                               ToolTip.Tip="{Binding AccessibleLabel}" AutomationProperties.Name="{Binding AccessibleLabel}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <ProgressBar Classes="chapterProgress" Value="{Binding ReadPercentage}" Minimum="0" Maximum="100" IsVisible="{Binding ShowProgressIndicator}" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Related / Details / Activity - the shared DetailTabs content -->
                <Border IsVisible="{Binding !IsChaptersTab}">
                    <views:DetailTabs DataContext="{Binding Tabs}" />
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
