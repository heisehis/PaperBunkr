<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pbc="using:Paperbunkr.App.Controls"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="920" d:DesignHeight="780"
             x:Class="Paperbunkr.App.Views.IssuePropertiesScreen"
             x:DataType="vm:IssuePropertiesScreenViewModel">

    <!-- Copy/Paste/Cancel/Save now use the shared Button.ghost/Button.primary primitives
         (Styles/Primitives.axaml) in place of this file's former local "headerAction" styles - see
         docs/superpowers/specs/2026-08-24-design-language-foundation-design.md Component Primitives
         section. -->
    <UserControl.Styles>
        <Style Selector="Button.ipTab">
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.ipTab.active">
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style Selector="Border.groupBox">
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.groupHeader">
            <Setter Property="Background" Value="{DynamicResource PbChromeBrush}" />
            <Setter Property="Padding" Value="14,11" />
        </Style>

        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextFaintBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="StackPanel.field">
            <Setter Property="Width" Value="240" />
            <Setter Property="Margin" Value="0,0,16,16" />
        </Style>

        <Style Selector="Button.star">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.star fi|SymbolIcon">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextFaintBrush}" />
        </Style>
        <Style Selector="Button.star.filled fi|SymbolIcon">
            <Setter Property="Foreground" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="IconVariant" Value="Filled" />
        </Style>

        <!-- Token-insert flyout button (docs/ce-feature-inventory.md §A "Templated/token text field
             editor") - same toolbarPill/modeOption shape as BulkIssuePropertiesScreen.axaml's enum
             picker (Avalonia styles don't share across files, so this mirrors rather than references it). -->
        <Style Selector="Button.toolbarPill">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource PbChromeBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.modeOption">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
        </Style>
    </UserControl.Styles>

    <!-- Borderless floating panel over the caller's dimmed backdrop (docs/superpowers/specs/2026-08-23-
         issue-editor-borderless-overlay-design.md) - same CornerRadius/no-title-bar treatment as
         MigrationOverlay/ReadingListPropertiesOverlay. Header + tab strip stay pinned via DockPanel.Dock
         so only the tab content underneath scrolls when the panel's bounded height overflows. -->
    <Border Width="920" MaxHeight="820" Classes="floatingPanel">
        <DockPanel LastChildFill="True">

            <Grid DockPanel.Dock="Top" Margin="28,20,28,16" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                    <TextBlock Text="Edit Issue" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PbTextBrush}" />
                    <TextBlock Text="{Binding HeaderLabel}" FontSize="12.5" Foreground="{DynamicResource PbTextFaintBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
                    <!-- Copy/paste metadata fields between books (docs/ce-feature-inventory.md §A) -
                         Copy snapshots every editable field on this screen; Paste (disabled until
                         something's been copied) overwrites this screen's own fields from that
                         snapshot, letting the user copy from one book's editor, Cancel/Save out,
                         open a different book, and paste the same values in. -->
                    <Button Classes="ghost" FontSize="12.5" Command="{Binding CopyFieldsCommand}" ToolTip.Tip="Copy every field on this screen">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <fi:SymbolIcon Symbol="Copy" Foreground="{DynamicResource PbTextMutedBrush}" />
                            <TextBlock Text="Copy" />
                        </StackPanel>
                    </Button>
                    <Button Classes="ghost" FontSize="12.5" Command="{Binding PasteFieldsCommand}" ToolTip.Tip="Paste the last copied fields">
                        <TextBlock Text="Paste" />
                    </Button>
                    <Border Width="1" Height="24" Background="{DynamicResource PbBorderBrush}" />
                    <Button Classes="ghost" FontSize="12.5" Command="{Binding CancelCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <fi:SymbolIcon Symbol="DismissCircle" Foreground="{DynamicResource PbTextMutedBrush}" />
                            <TextBlock Text="Cancel" />
                        </StackPanel>
                    </Button>
                    <Button Classes="primary" FontSize="12.5" Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <fi:SymbolIcon Symbol="Save" Foreground="{DynamicResource PbBadgeTextBrush}" />
                            <TextBlock Text="Save" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,0,0,1" />

            <!-- Tab strip -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="28,0,28,0">
                <Button Classes="ipTab" Classes.active="{Binding IsSummaryTab}"
                        Command="{Binding GoSummaryCommand}" Content="Summary" />
                <Button Classes="ipTab" Classes.active="{Binding IsDetailsTab}"
                        Command="{Binding GoDetailsCommand}" Content="Details" />
                <Button Classes="ipTab" Classes.active="{Binding IsPlotNotesTab}"
                        Command="{Binding GoPlotNotesCommand}" Content="Plot &amp; Notes" />
            </StackPanel>
            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,24" />

            <ScrollViewer>
                <StackPanel>

                    <!-- ===================== Summary tab ===================== -->
                    <StackPanel IsVisible="{Binding IsSummaryTab}" Margin="28,0,28,40" Spacing="20">

                        <Border Classes="groupBox">
                            <StackPanel>
                                <Border Classes="groupHeader">
                                    <TextBlock Text="Overview" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                                </Border>
                                <Grid ColumnDefinitions="120,*" Margin="14">
                                    <Border Grid.Column="0" Width="120" Height="168" CornerRadius="6" ClipToBounds="True" Background="{Binding CoverBrush}">
                                        <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="20,0,0,0" Spacing="10">
                                        <StackPanel>
                                            <TextBlock Classes="fieldLabel" Text="TYPE" />
                                            <TextBlock Text="{Binding TypeLabel}" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Classes="fieldLabel" Text="FILE PATH" />
                                            <TextBlock Text="{Binding FilePathLabel}" FontSize="12.5" Foreground="{DynamicResource PbTextBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Classes="fieldLabel" Text="PAGE COUNT" />
                                            <TextBlock Text="{Binding PageCountLabel}" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="groupBox">
                            <StackPanel>
                                <Border Classes="groupHeader">
                                    <TextBlock Text="Ratings" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                                </Border>
                                <StackPanel Margin="14" Spacing="16">
                                    <StackPanel>
                                        <TextBlock Classes="fieldLabel" Text="MY RATING" />
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <Button Classes="star" Classes.filled="{Binding MyRatingStar1}" Command="{Binding SetMyRating1Command}"><fi:SymbolIcon Symbol="Star" /></Button>
                                            <Button Classes="star" Classes.filled="{Binding MyRatingStar2}" Command="{Binding SetMyRating2Command}"><fi:SymbolIcon Symbol="Star" /></Button>
                                            <Button Classes="star" Classes.filled="{Binding MyRatingStar3}" Command="{Binding SetMyRating3Command}"><fi:SymbolIcon Symbol="Star" /></Button>
                                            <Button Classes="star" Classes.filled="{Binding MyRatingStar4}" Command="{Binding SetMyRating4Command}"><fi:SymbolIcon Symbol="Star" /></Button>
                                            <Button Classes="star" Classes.filled="{Binding MyRatingStar5}" Command="{Binding SetMyRating5Command}"><fi:SymbolIcon Symbol="Star" /></Button>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Classes="fieldLabel" Text="COMMUNITY RATING" />
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <Button Classes="star" Classes.filled="{Binding CommunityRatingStar1}" Command="{Binding SetCommunityRating1Command}"><fi:SymbolIcon Symbol="Star" /></Button>
                                            <Button Classes="star" Classes.filled="{Binding CommunityRatingStar2}" Command="{Binding SetCommunityRating2Command}"><fi:SymbolIcon Symbol="Star" /></Button>
                                            <Button Classes="star" Classes.filled="{Binding CommunityRatingStar3}" Command="{Binding SetCommunityRating3Command}"><fi:SymbolIcon Symbol="Star" /></Button>
                                            <Button Classes="star" Classes.filled="{Binding CommunityRatingStar4}" Command="{Binding SetCommunityRating4Command}"><fi:SymbolIcon Symbol="Star" /></Button>
                                            <Button Classes="star" Classes.filled="{Binding CommunityRatingStar5}" Command="{Binding SetCommunityRating5Command}"><fi:SymbolIcon Symbol="Star" /></Button>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <!-- ===================== Details tab ===================== -->
                    <StackPanel IsVisible="{Binding IsDetailsTab}" Margin="28,0,28,40" Spacing="20">
                        <Border Classes="groupBox">
                            <StackPanel>
                                <Border Classes="groupHeader">
                                    <TextBlock Text="Details" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                                </Border>
                                <WrapPanel Margin="14,14,0,0">
                                    <StackPanel Classes="field"><TextBlock Classes="fieldLabel" Text="NUMBER" /><TextBox Text="{Binding Number}" /></StackPanel>
                                    <StackPanel Classes="field"><TextBlock Classes="fieldLabel" Text="VOLUME" /><TextBox Text="{Binding VolumeText}" /></StackPanel>
                                    <StackPanel Classes="field"><TextBlock Classes="fieldLabel" Text="COUNT" /><TextBox Text="{Binding CountText}" /></StackPanel>
                                    <StackPanel Classes="field">
                                        <TextBlock Classes="fieldLabel" Text="TITLE" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox Grid.Column="0" Text="{Binding Title}" />
                                            <Button x:Name="TitleTokenButton" Grid.Column="1" Classes="toolbarPill" Content="{}{ }" Margin="4,0,0,0" ToolTip.Tip="Insert a token">
                                                <Button.Flyout>
                                                    <Flyout Placement="Bottom">
                                                        <StackPanel Width="120">
                                                            <ItemsControl ItemsSource="{Binding TokenOptions}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="x:String">
                                                                        <Button Classes="modeOption" Content="{Binding}"
                                                                                Command="{Binding #TitleTokenButton.((vm:IssuePropertiesScreenViewModel)DataContext).InsertTokenIntoTitleCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Classes="field">
                                        <TextBlock Classes="fieldLabel" Text="ALTERNATE SERIES" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox Grid.Column="0" Text="{Binding AlternateSeries}" />
                                            <Button x:Name="AltSeriesTokenButton" Grid.Column="1" Classes="toolbarPill" Content="{}{ }" Margin="4,0,0,0" ToolTip.Tip="Insert a token">
                                                <Button.Flyout>
                                                    <Flyout Placement="Bottom">
                                                        <StackPanel Width="120">
                                                            <ItemsControl ItemsSource="{Binding TokenOptions}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="x:String">
                                                                        <Button Classes="modeOption" Content="{Binding}"
                                                                                Command="{Binding #AltSeriesTokenButton.((vm:IssuePropertiesScreenViewModel)DataContext).InsertTokenIntoAlternateSeriesCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Classes="field"><TextBlock Classes="fieldLabel" Text="ALTERNATE NUMBER" /><TextBox Text="{Binding AlternateNumber}" /></StackPanel>
                                    <StackPanel Classes="field">
                                        <TextBlock Classes="fieldLabel" Text="STORY ARC" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox Grid.Column="0" Text="{Binding StoryArc}" />
                                            <Button x:Name="StoryArcTokenButton" Grid.Column="1" Classes="toolbarPill" Content="{}{ }" Margin="4,0,0,0" ToolTip.Tip="Insert a token">
                                                <Button.Flyout>
                                                    <Flyout Placement="Bottom">
                                                        <StackPanel Width="120">
                                                            <ItemsControl ItemsSource="{Binding TokenOptions}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="x:String">
                                                                        <Button Classes="modeOption" Content="{Binding}"
                                                                                Command="{Binding #StoryArcTokenButton.((vm:IssuePropertiesScreenViewModel)DataContext).InsertTokenIntoStoryArcCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Classes="field"><TextBlock Classes="fieldLabel" Text="STORY ARC NUMBER" /><TextBox Text="{Binding StoryArcNumber}" /></StackPanel>
                                    <StackPanel Classes="field">
                                        <TextBlock Classes="fieldLabel" Text="SERIES GROUP" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox Grid.Column="0" Text="{Binding SeriesGroup}" />
                                            <Button x:Name="SeriesGroupTokenButton" Grid.Column="1" Classes="toolbarPill" Content="{}{ }" Margin="4,0,0,0" ToolTip.Tip="Insert a token">
                                                <Button.Flyout>
                                                    <Flyout Placement="Bottom">
                                                        <StackPanel Width="120">
                                                            <ItemsControl ItemsSource="{Binding TokenOptions}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="x:String">
                                                                        <Button Classes="modeOption" Content="{Binding}"
                                                                                Command="{Binding #SeriesGroupTokenButton.((vm:IssuePropertiesScreenViewModel)DataContext).InsertTokenIntoSeriesGroupCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Classes="field"><TextBlock Classes="fieldLabel" Text="PUBLISHER" /><TextBox Text="{Binding Publisher}" /></StackPanel>
                                    <StackPanel Classes="field"><TextBlock Classes="fieldLabel" Text="IMPRINT" /><TextBox Text="{Binding Imprint}" /></StackPanel>
                                    <StackPanel Classes="field">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Classes="fieldLabel" Text="FORMAT" />
                                            <pbc:BrandMark Grid.Column="1" Family="Format" Value="{Binding Format}" ShowText="False" MarkSize="14" />
                                        </Grid>
                                        <AutoCompleteBox Text="{Binding Format}" ItemsSource="{Binding FormatOptions}" />
                                    </StackPanel>
                                    <StackPanel Classes="field"><TextBlock Classes="fieldLabel" Text="YEAR" /><TextBox Text="{Binding YearText}" /></StackPanel>
                                    <StackPanel Classes="field"><TextBlock Classes="fieldLabel" Text="MONTH" /><TextBox Text="{Binding MonthText}" /></StackPanel>
                                    <StackPanel Classes="field"><TextBlock Classes="fieldLabel" Text="DAY" /><TextBox Text="{Binding DayText}" /></StackPanel>
                                    <StackPanel Classes="field"><TextBlock Classes="fieldLabel" Text="GENRE" /><TextBox Text="{Binding Genre}" /></StackPanel>
                                    <StackPanel Classes="field"><TextBlock Classes="fieldLabel" Text="TAGS" /><TextBox Text="{Binding Tags}" /></StackPanel>
                                    <StackPanel Classes="field"><TextBlock Classes="fieldLabel" Text="WRITER" /><TextBox Text="{Binding Writer}" /></StackPanel>
                                    <StackPanel Classes="field"><TextBlock Classes="fieldLabel" Text="PENCILLER" /><TextBox Text="{Binding Penciller}" /></StackPanel>
                                    <StackPanel Classes="field"><TextBlock Classes="fieldLabel" Text="INKER" /><TextBox Text="{Binding Inker}" /></StackPanel>
                                    <StackPanel Classes="field"><TextBlock Classes="fieldLabel" Text="COLORIST" /><TextBox Text="{Binding Colorist}" /></StackPanel>
                                    <StackPanel Classes="field"><TextBlock Classes="fieldLabel" Text="LETTERER" /><TextBox Text="{Binding Letterer}" /></StackPanel>
                                    <StackPanel Classes="field"><TextBlock Classes="fieldLabel" Text="COVER ARTIST" /><TextBox Text="{Binding CoverArtist}" /></StackPanel>
                                    <StackPanel Classes="field"><TextBlock Classes="fieldLabel" Text="EDITOR" /><TextBox Text="{Binding Editor}" /></StackPanel>
                                    <StackPanel Classes="field"><TextBlock Classes="fieldLabel" Text="TRANSLATOR" /><TextBox Text="{Binding Translator}" /></StackPanel>
                                    <StackPanel Classes="field">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Classes="fieldLabel" Text="AGE RATING" />
                                            <pbc:BrandMark Grid.Column="1" Family="AgeRating" Value="{Binding AgeRating}" ShowText="False" MarkSize="18" />
                                        </Grid>
                                        <TextBox Text="{Binding AgeRating}" />
                                    </StackPanel>
                                    <StackPanel Classes="field">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Classes="fieldLabel" Text="LANGUAGE (ISO)" />
                                            <pbc:BrandMark Grid.Column="1" Family="Language" Value="{Binding LanguageIso}" ShowText="False" MarkSize="13" />
                                        </Grid>
                                        <TextBox Text="{Binding LanguageIso}" />
                                    </StackPanel>
                                    <StackPanel Classes="field">
                                        <TextBlock Classes="fieldLabel" Text="COLOR MODE" />
                                        <ComboBox ItemsSource="{Binding ColorModeOptions}" SelectedItem="{Binding ColorModeText}" />
                                    </StackPanel>
                                    <StackPanel Classes="field" VerticalAlignment="Bottom">
                                        <CheckBox Content="Final issue" IsChecked="{Binding IsFinalIssue}" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Category/Weight editor rows (docs/superpowers/specs/2026-08-23-weighted-
                             categorized-tags-design.md) - adding/removing values stays on the GENRE/TAGS
                             text boxes above; this only edits Category/Weight for values that already
                             exist. Hidden entirely when there's nothing to show (a brand-new issue with no
                             tags yet). -->
                        <Border Classes="groupBox" IsVisible="{Binding HasGenreTagRows}">
                            <StackPanel>
                                <Border Classes="groupHeader">
                                    <TextBlock Text="Genre Details" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                                </Border>
                                <ItemsControl ItemsSource="{Binding GenreTagRows}" Margin="14">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TagEditRowViewModel">
                                            <Grid ColumnDefinitions="140,*,140" Margin="0,0,0,8">
                                                <TextBlock Grid.Column="0" Text="{Binding Value}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                <TextBox Grid.Column="1" Text="{Binding Category}" Watermark="Category (e.g. Theme, Setting)" Margin="0,0,8,0" />
                                                <ComboBox Grid.Column="2" ItemsSource="{Binding $parent[UserControl].((vm:IssuePropertiesScreenViewModel)DataContext).WeightOptions, Mode=OneTime}" SelectedItem="{Binding Weight}" HorizontalAlignment="Stretch" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Classes="groupBox" IsVisible="{Binding HasTagsTagRows}">
                            <StackPanel>
                                <Border Classes="groupHeader">
                                    <TextBlock Text="Tags Details" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                                </Border>
                                <ItemsControl ItemsSource="{Binding TagsTagRows}" Margin="14">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TagEditRowViewModel">
                                            <Grid ColumnDefinitions="140,*,140" Margin="0,0,0,8">
                                                <TextBlock Grid.Column="0" Text="{Binding Value}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                <TextBox Grid.Column="1" Text="{Binding Category}" Watermark="Category (e.g. Theme, Setting)" Margin="0,0,8,0" />
                                                <ComboBox Grid.Column="2" ItemsSource="{Binding $parent[UserControl].((vm:IssuePropertiesScreenViewModel)DataContext).WeightOptions, Mode=OneTime}" SelectedItem="{Binding Weight}" HorizontalAlignment="Stretch" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===================== Plot & Notes tab ===================== -->
                    <StackPanel IsVisible="{Binding IsPlotNotesTab}" Margin="28,0,28,40" Spacing="20">
                        <Border Classes="groupBox">
                            <StackPanel>
                                <Border Classes="groupHeader">
                                    <TextBlock Text="Plot" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                                </Border>
                                <WrapPanel Margin="14,14,0,0">
                                    <StackPanel Classes="field"><TextBlock Classes="fieldLabel" Text="CHARACTERS" /><TextBox Text="{Binding Characters}" /></StackPanel>
                                    <StackPanel Classes="field"><TextBlock Classes="fieldLabel" Text="TEAMS" /><TextBox Text="{Binding Teams}" /></StackPanel>
                                    <StackPanel Classes="field"><TextBlock Classes="fieldLabel" Text="MAIN CHARACTER OR TEAM" /><TextBox Text="{Binding MainCharacterOrTeam}" /></StackPanel>
                                    <StackPanel Classes="field"><TextBlock Classes="fieldLabel" Text="LOCATIONS" /><TextBox Text="{Binding Locations}" /></StackPanel>
                                    <StackPanel Classes="field"><TextBlock Classes="fieldLabel" Text="WEB" /><TextBox Text="{Binding Web}" /></StackPanel>
                                    <StackPanel Classes="field"><TextBlock Classes="fieldLabel" Text="SCAN INFORMATION" /><TextBox Text="{Binding ScanInformation}" /></StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="groupBox">
                            <StackPanel>
                                <Border Classes="groupHeader">
                                    <TextBlock Text="Notes" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                                </Border>
                                <StackPanel Margin="14" Spacing="14">
                                    <StackPanel>
                                        <TextBlock Classes="fieldLabel" Text="SUMMARY" />
                                        <TextBox Text="{Binding Summary}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Classes="fieldLabel" Text="NOTES" />
                                        <TextBox Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Classes="fieldLabel" Text="REVIEW" />
                                        <TextBox Text="{Binding Review}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
