<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="620"
             xmlns:controls="using:Paperbunkr.App.Controls"
             x:Class="Paperbunkr.App.Views.BulkBookPropertiesOverlay"
             x:DataType="vm:BulkBookPropertiesScreenViewModel">

    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.groupHeader">
            <Setter Property="Background" Value="{DynamicResource PbChromeBrush}" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style Selector="TextBlock.applyHint">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
        </Style>
    </UserControl.Styles>

    <controls:DialogCard Title="{Binding HeaderLabel}" Subtitle="Only the fields you tick are written to every selected book." Size="Medium">
        <StackPanel Spacing="14">

            <StackPanel>
                <CheckBox Content="Author" IsChecked="{Binding ApplyAuthor}" FontWeight="SemiBold" />
                <TextBox Text="{Binding Author}" PlaceholderText="{Binding AuthorWatermark}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel>
                <CheckBox Content="Summary" IsChecked="{Binding ApplySummary}" FontWeight="SemiBold" />
                <TextBox Text="{Binding Summary}" PlaceholderText="{Binding SummaryWatermark}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel>
                <CheckBox Content="Published date" IsChecked="{Binding ApplyPublishedDate}" FontWeight="SemiBold" />
                <DatePicker SelectedDate="{Binding PublishedDate}" HorizontalAlignment="Left" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel>
                <CheckBox Content="Reading status" IsChecked="{Binding ApplyStatus}" FontWeight="SemiBold" />
                <controls:SuggestBox Text="{Binding StatusLabel}" Suggestions="{Binding StatusOptions}" IsStrict="True"
                                     HorizontalAlignment="Left" Width="248" Margin="0,4,0,0" AutomationProperties.AutomationId="BulkBookStatus" />
            </StackPanel>

            <StackPanel>
                <CheckBox Content="My rating (ticked with no stars clears it)" IsChecked="{Binding ApplyRating}" FontWeight="SemiBold" />
                <controls:StarRating Value="{Binding Rating, Mode=TwoWay}" StarSize="20" HorizontalAlignment="Left" Margin="0,4,0,0"
                                     AutomationProperties.Name="My rating" AutomationProperties.AutomationId="BulkBookRating" />
            </StackPanel>

            <WrapPanel>
                <StackPanel Width="230" Margin="0,0,16,0">
                    <CheckBox Content="Publisher" IsChecked="{Binding ApplyPublisher}" FontWeight="SemiBold" />
                    <controls:SuggestBox Text="{Binding Publisher}" Suggestions="{Binding Vocabulary.Publishers}" HorizontalAlignment="Stretch" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Width="230">
                    <CheckBox Content="Language" IsChecked="{Binding ApplyLanguage}" FontWeight="SemiBold" />
                    <controls:SuggestBox Text="{Binding LanguageIso}" Suggestions="{Binding Vocabulary.Languages}" HorizontalAlignment="Stretch" Margin="0,4,0,0" />
                </StackPanel>
            </WrapPanel>

            <Border Classes="card" Padding="0">
                <StackPanel>
                    <Border Classes="groupHeader">
                        <TextBlock Text="Genres &amp; tags" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                    </Border>
                    <StackPanel Margin="14">
                        <TextBlock Classes="fieldLabel" Text="ADD GENRES" />
                        <controls:SuggestBox Text="{Binding AddGenres}" Suggestions="{Binding Vocabulary.Genres}" IsMultiValue="True"
                                             HorizontalAlignment="Stretch" Margin="0,0,0,12" />
                        <TextBlock Classes="fieldLabel" Text="ADD TAGS" />
                        <controls:SuggestBox Text="{Binding AddTags}" Suggestions="{Binding Vocabulary.Tags}" IsMultiValue="True"
                                             HorizontalAlignment="Stretch" Margin="0,0,0,12" />
                        <TextBlock Classes="fieldLabel" Text="REMOVE FROM GENRES AND TAGS" />
                        <controls:SuggestBox Text="{Binding RemoveTags}" Suggestions="{Binding Vocabulary.Tags}" IsMultiValue="True" HorizontalAlignment="Stretch" />
                        <TextBlock Classes="applyHint" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="Tags are added to and removed from each book; nothing else on a book's tag list changes." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="0">
                <StackPanel>
                    <Border Classes="groupHeader">
                        <CheckBox Content="Series" IsChecked="{Binding ApplySeries}" FontWeight="Bold" FontSize="13" />
                    </Border>
                    <StackPanel Margin="14">
                        <TextBlock Classes="fieldLabel" Text="SERIES NAME" />
                        <TextBox Text="{Binding SeriesName}" PlaceholderText="{Binding SeriesNameWatermark}" Margin="0,0,0,12" />
                        <WrapPanel>
                            <StackPanel Width="230" Margin="0,0,16,0">
                                <TextBlock Classes="fieldLabel" Text="SERIES AUTHOR" />
                                <TextBox Text="{Binding SeriesAuthor}" IsEnabled="{Binding HasSeriesName}" />
                            </StackPanel>
                            <StackPanel Width="230">
                                <TextBlock Classes="fieldLabel" Text="SERIES SORT NAME" />
                                <TextBox Text="{Binding SeriesSortName}" IsEnabled="{Binding HasSeriesName}" />
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Classes="applyHint" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="A blank series name detaches every selected book to standalone. Series author and sort name apply to the whole series." />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
        <controls:DialogCard.Footer>
            <StackPanel>
                <Button Classes="ghost" Content="Cancel" Command="{Binding CancelCommand}" />
                <Button Classes="primary" Content="Save" Command="{Binding SaveCommand}"
                        AutomationProperties.AutomationId="BulkBookPropertiesSave" />
            </StackPanel>
        </controls:DialogCard.Footer>
    </controls:DialogCard>
</UserControl>
