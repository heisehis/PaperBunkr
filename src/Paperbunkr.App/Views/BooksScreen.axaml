<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:models="using:Paperbunkr.App.Models"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="760"
             x:Class="Paperbunkr.App.Views.BooksScreen"
             x:DataType="vm:BooksScreenViewModel">

    <UserControl.Styles>
        <Style Selector="Button.card">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <!-- Cover treatment shared with Library's 4a poster tiles: token radius + scrim + amber
             glow ring on hover / keyboard focus. -->
        <Style Selector="Border.bookCover">
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusSm}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Transitions">
                <Transitions>
                    <BoxShadowsTransition Property="BoxShadow" Duration="{DynamicResource PbMotionFast}" Easing="{StaticResource PbMotionEase}" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.card:pointerover Border.bookCover">
            <Setter Property="BoxShadow" Value="{StaticResource PbGlowRing}" />
        </Style>
        <Style Selector="Button.card:focus-within Border.bookCover">
            <Setter Property="BoxShadow" Value="{StaticResource PbGlowRing}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0" Padding="28,20,28,16" Background="{DynamicResource PbSurface1Brush}"
                BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Books" Classes="pbTextHeading" />
                <TextBlock Text="Novels — EPUB and PDF" Classes="pbTextCaption" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1">
            <Grid>
                <ItemsControl ItemsSource="{Binding Books}" Margin="24,22,24,40" IsVisible="{Binding HasBooks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:BookCardSample">
                            <Button Classes="card" Width="150" Margin="0,0,20,20"
                                    Command="{Binding $parent[UserControl].((vm:BooksScreenViewModel)DataContext).SelectBookCommand}"
                                    CommandParameter="{Binding}">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Delete Book">
                                            <MenuItem Header="Yes, delete this book"
                                                      Command="{Binding $parent[UserControl].((vm:BooksScreenViewModel)DataContext).DeleteBookCommand}"
                                                      CommandParameter="{Binding BookId}" />
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <StackPanel Spacing="8">
                                    <Border Classes="bookCover" Background="{Binding CoverBrush}" Height="216">
                                        <Grid>
                                            <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                                            <Border Classes="posterScrim" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PbTextBrush}" TextWrapping="Wrap"
                                               MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Author}" Classes="pbTextCaption"
                                               TextTrimming="CharacterEllipsis" IsVisible="{Binding Author, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                                    <TextBlock Text="{Binding SeriesName}" Classes="pbTextCaption" FontStyle="Italic"
                                               TextTrimming="CharacterEllipsis" IsVisible="{Binding HasSeries}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel IsVisible="{Binding !HasBooks}" Spacing="12" MaxWidth="340"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Classes="pbIcon" Width="34" Height="34" HorizontalAlignment="Center"
                          Data="{StaticResource PbIconBook}" Stroke="{DynamicResource PbTextFaintBrush}" />
                    <TextBlock Classes="pbTextBody" Text="No books yet." TextAlignment="Center"
                               Foreground="{DynamicResource PbTextMutedBrush}" />
                    <TextBlock Classes="pbTextCaption" TextWrapping="Wrap" TextAlignment="Center"
                               Text="Add a book folder in Preferences → Libraries, then scan for EPUB and PDF novels." />
                    <Button Classes="secondary" HorizontalAlignment="Center" Content="Open Library settings"
                            Command="{Binding OpenLibrarySettingsCommand}"
                            AutomationProperties.AutomationId="BooksEmptyStateSettings" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

    </Grid>
</UserControl>
