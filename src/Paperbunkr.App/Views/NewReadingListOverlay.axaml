<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:models="using:Paperbunkr.App.Models"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="560"
             x:Class="Paperbunkr.App.Views.NewReadingListOverlay"
             x:DataType="vm:NewReadingListViewModel">

    <UserControl.Styles>
        <Style Selector="Button.method">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusSm}" />
            <Setter Property="Padding" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.method.active">
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
        </Style>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </UserControl.Styles>

    <Border Classes="floatingPanel" Width="460" MaxHeight="640">
        <Grid RowDefinitions="Auto,*,Auto">

            <Border Grid.Row="0" Padding="18,15" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,0,0,1">
                <TextBlock Classes="pbTextHeading" Text="NEW READING LIST" />
            </Border>

            <ScrollViewer Grid.Row="1" Padding="18,16">
                <StackPanel Spacing="16">
                    <StackPanel>
                        <TextBlock Classes="fieldLabel" Text="NAME" />
                        <TextBox Text="{Binding Name}" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Classes="fieldLabel" Text="BUILD IT FROM…" />
                        <StackPanel Spacing="7">
                            <Button Classes="method" Classes.active="{Binding IsBlankMethod}"
                                    Command="{Binding SelectMethodCommand}" CommandParameter="Blank">
                                <StackPanel>
                                    <TextBlock Text="Start blank" FontSize="12.5" Foreground="{DynamicResource PbTextBrush}" />
                                    <TextBlock Text="Add issues yourself, one at a time." FontSize="10.5" Foreground="{DynamicResource PbTextFaintBrush}" />
                                </StackPanel>
                            </Button>
                            <Button Classes="method" Classes.active="{Binding IsImportMethod}"
                                    Command="{Binding SelectMethodCommand}" CommandParameter="Import">
                                <StackPanel>
                                    <TextBlock Text="Import a file" FontSize="12.5" Foreground="{DynamicResource PbTextBrush}" />
                                    <TextBlock Text="A .CBL or .CSV reading list." FontSize="10.5" Foreground="{DynamicResource PbTextFaintBrush}" />
                                </StackPanel>
                            </Button>
                            <Button Classes="method" Classes.active="{Binding IsArcMethod}"
                                    Command="{Binding SelectMethodCommand}" CommandParameter="Arc">
                                <StackPanel>
                                    <TextBlock Text="A published story arc" FontSize="12.5" Foreground="{DynamicResource PbTextBrush}" />
                                    <TextBlock Text="Search ComicVine, Metron &amp; reading-order sites; matched to your library." FontSize="10.5" Foreground="{DynamicResource PbTextFaintBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>
                            <Button Classes="method" Classes.active="{Binding IsEventMethod}"
                                    Command="{Binding SelectMethodCommand}" CommandParameter="Event">
                                <StackPanel>
                                    <TextBlock Text="An existing story event" FontSize="12.5" Foreground="{DynamicResource PbTextBrush}" />
                                    <TextBlock Text="Pull in every issue tied to one of your Story Events." FontSize="10.5" Foreground="{DynamicResource PbTextFaintBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Arc sub-panel -->
                    <StackPanel Spacing="8" IsVisible="{Binding IsArcMethod}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <ComboBox Grid.Column="0" ItemsSource="{Binding ArcSourceOptions}" SelectedItem="{Binding SelectedArcSource}" Width="160">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:ArcSourceOption"><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBox Grid.Column="1" Text="{Binding ArcSearchQuery}" Watermark="Arc or event name…" />
                            <Button Grid.Column="2" Classes="primary" Content="Search" Command="{Binding SearchArcCommand}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding ArcSearchResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ArcSearchResultRow">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="1" Classes="primary" Content="Use"
                                                Command="{Binding $parent[ItemsControl].((vm:NewReadingListViewModel)DataContext).UseArcCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Event sub-panel -->
                    <StackPanel Spacing="6" IsVisible="{Binding IsEventMethod}">
                        <TextBlock Classes="fieldLabel" Text="STORY EVENT" />
                        <ComboBox ItemsSource="{Binding StoryEventOptions}" SelectedItem="{Binding SelectedStoryEvent}"
                                  HorizontalAlignment="Stretch" PlaceholderText="Pick an event…">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:NewReadingListViewModel+StoryEventOption"><TextBlock Text="{Binding Name}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="No story events yet." FontSize="10.5" Foreground="{DynamicResource PbTextFaintBrush}"
                                   IsVisible="{Binding !StoryEventOptions.Count}" />
                    </StackPanel>

                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{DynamicResource PbTextFaintBrush}"
                               TextWrapping="Wrap" IsVisible="{Binding StatusMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Padding="18,13" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Classes="ghost" Content="Cancel" Command="{Binding CancelCommand}" />
                    <Button Classes="primary" Content="Create" Command="{Binding CreateCommand}" IsEnabled="{Binding CanCreate}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
