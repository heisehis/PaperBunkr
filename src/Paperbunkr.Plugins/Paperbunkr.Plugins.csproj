<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compiles/runs each Command's .csx script at runtime (docs/superpowers/specs/
         2026-08-24-plugin-api-v2-design.md §2/§3) - the C# scripting initializer replacing CE's
         IronPython PythonPluginInitializer. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.11.0" />
    <!-- Runs each Command's .py script (docs/superpowers/specs/2026-08-30-python-plugin-scripting-
         design.md) - IronPython 3.4 targets .NET 8.0+/10.0, unlike the legacy 2.7 line CE itself
         used (Python 2 syntax, .NET Framework/Core 2.0 only). -->
    <PackageReference Include="IronPython" Version="3.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paperbunkr.Data\Paperbunkr.Data.csproj" />
    <!-- IPluginEnvironment/IPluginConfig/the 17 hook-global types moved out to
         Paperbunkr.Plugins.Abstractions (docs/superpowers/specs/2026-09-11-plugin-api-v4-native-tier-
         design.md, implementation plan Phase 0) so a native-tier plugin project can reference just
         the contracts without Roslyn scripting/IronPython. Namespaces unchanged, so no `using`
         updates were needed anywhere in this project. -->
    <ProjectReference Include="..\Paperbunkr.Plugins.Abstractions\Paperbunkr.Plugins.Abstractions.csproj" />
  </ItemGroup>

</Project>
