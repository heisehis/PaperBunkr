<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:pref="using:Paperbunkr.App.Views.Preferences"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="480"
             x:Class="Paperbunkr.App.Views.Preferences.GeneralSection"
             x:DataType="vm:PreferencesScreenViewModel">

    <ScrollViewer>
        <StackPanel Margin="28,20,28,40" Spacing="20">
            <TextBlock Classes="pbTextHeading" Text="General" />

        <StackPanel Tag="general.startup">
            <TextBlock Classes="settingsGroupCaption" Text="STARTUP" />
            <pref:SettingsRow Icon="Play" Title="Reopen the screen I was on last time"
                               Description="Scanning folders for new files at startup is now a scheduled task — set it up under Automation.">
                <pref:SettingsRow.SettingsContent>
                    <ToggleSwitch IsChecked="{Binding RestoreSessionOnStartup}" OnContent="{x:Null}" OffContent="{x:Null}" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
        </StackPanel>

        <StackPanel Tag="general.reading">
            <TextBlock Classes="settingsGroupCaption" Text="READING" />
            <pref:SettingsRow Icon="Book" Title="Resume issues where you left off">
                <pref:SettingsRow.SettingsContent>
                    <ToggleSwitch IsChecked="{Binding OpenLastPage}" OnContent="{x:Null}" OffContent="{x:Null}" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
            <pref:SettingsRow Icon="ArrowNext" Title="Reading past the last page opens the next issue">
                <pref:SettingsRow.SettingsContent>
                    <ToggleSwitch IsChecked="{Binding AutoNavigateComics}" OnContent="{x:Null}" OffContent="{x:Null}" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
            <pref:SettingsRow Icon="Star" Title="Ask me to rate a comic when I finish it">
                <pref:SettingsRow.SettingsContent>
                    <ToggleSwitch IsChecked="{Binding PromptReviewOnFinish}" OnContent="{x:Null}" OffContent="{x:Null}" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
        </StackPanel>

        <StackPanel Tag="general.library">
            <TextBlock Classes="settingsGroupCaption" Text="LIBRARY" />
            <pref:SettingsRow Icon="ArrowUpload" Title="Allow importing files by dragging them into the window">
                <pref:SettingsRow.SettingsContent>
                    <ToggleSwitch IsChecked="{Binding EnableDragDropImport}" OnContent="{x:Null}" OffContent="{x:Null}" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
        </StackPanel>

        <StackPanel Tag="general.window">
            <TextBlock Classes="settingsGroupCaption" Text="WINDOW" />
            <pref:SettingsRow Icon="WindowArrowUp" Title="Minimize to tray"
                               Description="Closing the window also minimizes to tray while this is on.">
                <pref:SettingsRow.SettingsContent>
                    <ToggleSwitch IsChecked="{Binding MinimizeToTray}" OnContent="{x:Null}" OffContent="{x:Null}" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</UserControl>
