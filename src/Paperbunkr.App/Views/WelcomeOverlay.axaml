<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:controls="using:Paperbunkr.App.Controls"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="460"
             x:Class="Paperbunkr.App.Views.WelcomeOverlay"
             x:DataType="vm:WelcomeOverlayViewModel">

    <!--
        First-run welcome (docs/superpowers/specs/2026-08-31-first-run-onboarding-design.md, restyled
        onto the shared FirstLookShell per 2026-09-09-startup-onboarding-whats-new-design.md
        Decision 4). Setup-only - three equal paths + Skip; no reader/theme steps. The CE card is
        badged and equal-weight when a CE install is detected, muted (and read as secondary) when
        not - most non-CE users never need it.
    -->
    <UserControl.Styles>
        <Style Selector="Button.setupCard">
            <Setter Property="Padding" Value="16,15" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="{DynamicResource PbMotionFast}" Easing="{StaticResource PbMotionEase}" />
                    <DoubleTransition Property="Opacity" Duration="{DynamicResource PbMotionFast}" Easing="{StaticResource PbMotionEase}" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.setupCard:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
        </Style>
        <Style Selector="Button.setupCard.muted">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="Button.setupCard.muted:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="TextBlock.setupCardTitle">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
        </Style>
        <Style Selector="TextBlock.setupCardDescription">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>

    <controls:FirstLookShell Title="Welcome to Paperbunkr"
                             Subtitle="Let's point it at your library — you can add more any time.">

        <StackPanel>
            <Button Classes="setupCard" Command="{Binding AddComicFolderCommand}"
                    AutomationProperties.AutomationId="WelcomeAddComicFolder">
                <Grid ColumnDefinitions="Auto,*">
                    <fi:SymbolIcon Grid.Column="0" Symbol="FolderOpen" FontSize="{StaticResource PbIconSizeLg}" Foreground="{DynamicResource PbAccentTextBrush}" VerticalAlignment="Top" Margin="0,2,14,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Classes="setupCardTitle" Text="Add a comic folder" />
                        <TextBlock Classes="setupCardDescription" Text="A folder of CBZ, CBR, CB7 and other comics already on disk." />
                    </StackPanel>
                </Grid>
            </Button>

            <Button Classes="setupCard" Command="{Binding AddBookFolderCommand}"
                    AutomationProperties.AutomationId="WelcomeAddBookFolder">
                <Grid ColumnDefinitions="Auto,*">
                    <fi:SymbolIcon Grid.Column="0" Symbol="Book" FontSize="{StaticResource PbIconSizeLg}" Foreground="{DynamicResource PbAccentTextBrush}" VerticalAlignment="Top" Margin="0,2,14,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Classes="setupCardTitle" Text="Add a book folder" />
                        <TextBlock Classes="setupCardDescription" Text="Same idea for novels — EPUB and PDF, kept on their own shelf." />
                    </StackPanel>
                </Grid>
            </Button>

            <Button Classes="setupCard" Classes.muted="{Binding !CeInstallDetected}"
                    Command="{Binding ImportFromCeCommand}"
                    AutomationProperties.AutomationId="WelcomeImportFromCe">
                <Grid ColumnDefinitions="Auto,*">
                    <fi:SymbolIcon Grid.Column="0" Symbol="CloudArrowUp" FontSize="{StaticResource PbIconSizeLg}" Foreground="{DynamicResource PbAccentTextBrush}" VerticalAlignment="Top" Margin="0,2,14,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Classes="setupCardTitle" Text="Import from ComicRack CE" />
                        <TextBlock Classes="setupCardDescription" Text="Bring over your CE library — series, issues, and reading progress." />
                        <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,6,0,0" IsVisible="{Binding CeInstallDetected}">
                            <fi:SymbolIcon Symbol="CheckmarkCircle" FontSize="{StaticResource PbIconSizeSm}" Foreground="{DynamicResource PbAccentTextBrush}" />
                            <TextBlock Text="Found your CE install" Foreground="{DynamicResource PbAccentTextBrush}" FontSize="11.5" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Button>
        </StackPanel>

        <controls:FirstLookShell.Footer>
            <Grid ColumnDefinitions="*,Auto">
                <Button Grid.Column="0" Classes="linkText" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Command="{Binding ShowWhatsNewCommand}"
                        Content="{Binding WhatsNewLinkText}"
                        AutomationProperties.AutomationId="WelcomeWhatsNew" />
                <Button Grid.Column="1" Classes="linkText" Content="Skip for now"
                        Command="{Binding SkipCommand}"
                        AutomationProperties.AutomationId="WelcomeSkip" />
            </Grid>
        </controls:FirstLookShell.Footer>
    </controls:FirstLookShell>
</UserControl>
