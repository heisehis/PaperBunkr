<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="520"
             xmlns:controls="using:Paperbunkr.App.Controls"
             x:Class="Paperbunkr.App.Views.PasteDataOverlay"
             x:DataType="vm:PasteDataScreenViewModel">

    <!-- Paste Data (CE's ComicDataPasteDialog; docs/superpowers/specs/2026-09-29-library-bulk-actions-design.md §3): one checkbox per
         book-owned field, semibold where the copied book has a value, the ticks remembered between uses. -->
    <UserControl.Styles>
        <Style Selector="TextBlock.groupLabel">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style Selector="CheckBox.field">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style Selector="CheckBox.field.defined">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
        </Style>
    </UserControl.Styles>

    <controls:DialogCard Title="{Binding Title}" Subtitle="{Binding Subtitle}" Size="Medium">
        <ItemsControl ItemsSource="{Binding Groups}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PasteDataFieldGroup">
                    <StackPanel>
                        <TextBlock Classes="groupLabel" Text="{Binding Name}" />
                        <ItemsControl ItemsSource="{Binding Fields}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PasteDataFieldOption">
                                    <CheckBox Classes="field" Classes.defined="{Binding HasValue}"
                                              Content="{Binding Label}" IsChecked="{Binding IsChecked}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <controls:DialogCard.Footer>
            <StackPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6">
                                    <Button Classes="ghost" Content="Mark defined" Command="{Binding MarkDefinedCommand}"
                                            AutomationProperties.AutomationId="PasteDataMarkDefined" />
                                    <Button Classes="ghost" Content="All" Command="{Binding SelectAllCommand}" />
                                    <Button Classes="ghost" Content="None" Command="{Binding SelectNoneCommand}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <Button Classes="ghost" Content="Cancel" Command="{Binding CancelCommand}" />
                                    <Button Classes="primary" Content="{Binding PasteLabel}" Command="{Binding PasteCommand}"
                                            AutomationProperties.AutomationId="PasteDataConfirm" />
                                </StackPanel>
                            </DockPanel>
            </StackPanel>
        </controls:DialogCard.Footer>
    </controls:DialogCard>
</UserControl>
