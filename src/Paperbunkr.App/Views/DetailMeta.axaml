<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="100"
             x:Class="Paperbunkr.App.Views.DetailMeta"
             x:DataType="vm:DetailMetaViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.metaLabel">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextFaintBrush}" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style Selector="TextBlock.metaValue">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*" Margin="0,20">
        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,28,14">
            <TextBlock Classes="metaLabel" Text="WRITER" />
            <TextBlock Classes="metaValue" Text="{Binding Writer}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,14">
            <TextBlock Classes="metaLabel" Text="ARTIST" />
            <TextBlock Classes="metaValue" Text="{Binding Artist}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,28,14">
            <TextBlock Classes="metaLabel" Text="COVER ARTIST" />
            <TextBlock Classes="metaValue" Text="{Binding CoverArtist}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,14">
            <TextBlock Classes="metaLabel" Text="COLORIST" />
            <TextBlock Classes="metaValue" Text="{Binding Colorist}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,28,0">
            <TextBlock Classes="metaLabel" Text="LETTERER" />
            <TextBlock Classes="metaValue" Text="{Binding Letterer}" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
