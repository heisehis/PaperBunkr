<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Vector icon set (docs/superpowers/specs/2026-08-24-design-language-foundation-design.md
        Iconography section) - converts the 7 icons actually used by this phase's touched files
        (the 5 FloatingPanel overlays + verified against all 17 consuming files for one-icon-per-
        action conflicts - none found) from the existing 96x96 raster PNGs in Assets/Icons/ to
        stroked StreamGeometry on a 24x24 viewbox. This is a deliberate style change, not a re-trace:
        the raster originals are filled "donut" shapes (a solid ring drawn as one filled contour);
        these are genuine stroked outlines (Stroke, Fill="Transparent"), matching the "thin outline,
        Lucide/Feather-style, ~1.5px stroke" direction the design doc actually calls for - geometry
        built from known Lucide icon shapes (copy, circle-x, save, circle-check, folder-open,
        circle-alert) plus a hand-computed 5-point star, not pixel-traced from the PNGs.

        The remaining 32 icons stay on the old raster/OpacityMask path for now - see
        Assets/Icons/icon-mapping.md for the full audit and the one-icon-per-action mapping.
    -->

    <Styles.Resources>
        <StreamGeometry x:Key="PbIconStar">M 12,3 L 14.12,9.09 L 20.56,9.22 L 15.42,13.11 L 17.29,19.28 L 12,15.6 L 6.71,19.28 L 8.58,13.11 L 3.44,9.22 L 9.88,9.09 Z</StreamGeometry>

        <StreamGeometry x:Key="PbIconCopy">M 10,8 L 20,8 A 2,2 0 0 1 22,10 L 22,20 A 2,2 0 0 1 20,22 L 10,22 A 2,2 0 0 1 8,20 L 8,10 A 2,2 0 0 1 10,8 Z M 4,16 C 2.9,16 2,15.1 2,14 L 2,4 C 2,2.9 2.9,2 4,2 L 14,2 C 15.1,2 16,2.9 16,4</StreamGeometry>

        <StreamGeometry x:Key="PbIconCloseCircle">M 12,2 A 10,10 0 1 0 12,22 A 10,10 0 1 0 12,2 Z M 15,9 L 9,15 M 9,9 L 15,15</StreamGeometry>

        <StreamGeometry x:Key="PbIconSave">M 5,3 L 16,3 L 21,8 L 21,19 A 2,2 0 0 1 19,21 L 5,21 A 2,2 0 0 1 3,19 L 3,5 A 2,2 0 0 1 5,3 Z M 8,7 L 15,7 M 9,21 L 9,15 A 1,1 0 0 1 10,14 L 14,14 A 1,1 0 0 1 15,15 L 15,21</StreamGeometry>

        <StreamGeometry x:Key="PbIconCircleCheck">M 12,2 A 10,10 0 1 0 12,22 A 10,10 0 1 0 12,2 Z M 9,12 L 11,14 L 15,10</StreamGeometry>

        <StreamGeometry x:Key="PbIconFolderOpen">M 3,6 A 1,1 0 0 1 4,5 L 9,5 L 10.5,6.5 L 20,6.5 A 1,1 0 0 1 21,7.5 L 21,16 A 1,1 0 0 1 20,17 L 4,17 A 1,1 0 0 1 3,16 Z M 2,10 L 20,10 A 1,1 0 0 1 20.9,11.4 L 18.5,18.6 A 1,1 0 0 1 17.6,19.3 L 4,19.3 A 1,1 0 0 1 3.1,18.6 L 1.1,11.4 A 1,1 0 0 1 2,10 Z</StreamGeometry>

        <StreamGeometry x:Key="PbIconCircleWarning">M 12,2 A 10,10 0 1 0 12,22 A 10,10 0 1 0 12,2 Z M 12,8 L 12,12 M 12,16 L 12,16.01</StreamGeometry>

        <!-- Nav rail icons (docs/superpowers/specs/2026-08-24-navigation-shell-motion-system-design.md
             Step 2) - same computed-not-traced approach as the Phase 1 set above. -->
        <StreamGeometry x:Key="PbIconHome">M 3,11 L 12,4 L 21,11 M 5,10 L 5,20 A 1,1 0 0 0 6,21 L 18,21 A 1,1 0 0 0 19,20 L 19,10 M 10,21 L 10,14 A 1,1 0 0 1 11,13 L 13,13 A 1,1 0 0 1 14,14 L 14,21</StreamGeometry>

        <StreamGeometry x:Key="PbIconBook">M 6,3 L 16,3 A 2,2 0 0 1 18,5 L 18,19 A 2,2 0 0 1 16,21 L 6,21 A 2,2 0 0 1 4,19 L 4,5 A 2,2 0 0 1 6,3 Z M 6,17 L 16,17</StreamGeometry>

        <StreamGeometry x:Key="PbIconLayers">M 12,2 L 21,7.5 L 12,13 L 3,7.5 Z M 3,12 L 12,17.5 L 21,12 M 3,16.5 L 12,22 L 21,16.5</StreamGeometry>

        <StreamGeometry x:Key="PbIconFilter">M 4,4 L 20,4 L 13,12.5 L 13,19 L 11,17.5 L 11,12.5 Z</StreamGeometry>

        <StreamGeometry x:Key="PbIconBookmark">M 6,3 A 1,1 0 0 0 5,4 L 5,21 L 12,16 L 19,21 L 19,4 A 1,1 0 0 0 18,3 Z</StreamGeometry>

        <StreamGeometry x:Key="PbIconUndo">M 3,7 L 3,13 L 9,13 M 3,13 A 9,9 0 1 0 6,5.3</StreamGeometry>

        <StreamGeometry x:Key="PbIconSettings">M 12,4 A 8,8 0 1 0 12,20 A 8,8 0 1 0 12,4 Z M 12,8.5 A 3.5,3.5 0 1 0 12,15.5 A 3.5,3.5 0 1 0 12,8.5 Z M 20,12 L 22.5,12 M 17.66,17.66 L 19.42,19.42 M 12,20 L 12,22.5 M 6.34,17.66 L 4.58,19.42 M 4,12 L 1.5,12 M 6.34,6.34 L 4.58,4.58 M 12,4 L 12,1.5 M 17.66,6.34 L 19.42,4.58</StreamGeometry>

        <!-- Pin toggle (docs/superpowers/specs/2026-08-24-navigation-shell-motion-system-design.md) -
             new concept, no raster precedent. One icon, pinned/unpinned state shown via Stroke color
             like the rail's existing .active convention, not a second geometry. -->
        <StreamGeometry x:Key="PbIconPin">M 12,4 A 3,3 0 1 0 12,10 A 3,3 0 1 0 12,4 Z M 12,10 L 12,20 M 9,20 L 15,20</StreamGeometry>

        <!-- Home screen (docs/superpowers/specs/2026-08-24-home-screen-design.md) - Refresh.png was
             this screen's only consumer (grepped, confirmed no conflicts). Two-arrow circular
             refresh glyph, same computed-not-traced approach as the rest of this set. -->
        <StreamGeometry x:Key="PbIconRefresh">M 21,12 A 9,9 0 1 1 18.36,5.64 M 21,4 L 21,9 L 16,9</StreamGeometry>

        <!-- Reader chrome (docs/superpowers/specs/2026-08-25-reader-chrome-design.md) - Skip_Back.png/
             Skip_Forward.png were each single-consumer (ReaderScreen.axaml's page-turn buttons only,
             grepped, confirmed no conflicts). Simple triangle-plus-bar "skip" glyphs - real bug found
             via on-screen check, not just review: the two geometries were originally drawn backwards
             relative to their names (SkipBack rendered a forward-pointing "▶|" shape and vice versa). -->
        <StreamGeometry x:Key="PbIconSkipBack">M 5,5 L 5,19 M 7,12 L 18,5 L 18,19 Z</StreamGeometry>
        <StreamGeometry x:Key="PbIconSkipForward">M 19,5 L 19,19 M 17,12 L 6,5 L 6,19 Z</StreamGeometry>

        <!-- Reader chrome icon pass (docs/superpowers/specs/2026-08-27-reader-chrome-icon-pass-design.md)
             - completes the reader chrome's icon language: the Reader Chrome phase itself converted
             only Skip_Back/Skip_Forward and left every other control on a text glyph or emoji. Same
             computed-not-traced approach as the rest of this set. New concepts (no raster precedent):
             MoreVertical, Fullscreen, the four chevrons, Minus/Plus, Close, RotateCw/Ccw, Fit, and the
             three Arrow* direction glyphs. Vector versions of an existing raster: Search
             (Search_Magnifying_Glass), Edit (Edit_Pencil), Check (Check), Trash (Trash_Empty), BookOpen
             (Book_Open), Play (Play) - those PNGs stay on disk for screens not yet through their phase.
             Close/Check are deliberately distinct from PbIconCloseCircle/PbIconCircleCheck (plain vs
             circled - different actions, both kept). -->
        <!-- Three small rings rather than the zero-length-line dot trick: a 1-D geometry (all points
             share x) has a zero-width bounding box, which Path.pbIcon's Stretch="Uniform" collapses
             to a single dot. Same reason PbIconMinus below is drawn as a thin bar, not one line. -->
        <StreamGeometry x:Key="PbIconMoreVertical">M 12,4.9 A 1.3,1.3 0 1 0 12,7.5 A 1.3,1.3 0 1 0 12,4.9 Z M 12,10.7 A 1.3,1.3 0 1 0 12,13.3 A 1.3,1.3 0 1 0 12,10.7 Z M 12,16.5 A 1.3,1.3 0 1 0 12,19.1 A 1.3,1.3 0 1 0 12,16.5 Z</StreamGeometry>
        <StreamGeometry x:Key="PbIconFullscreen">M 8,4 L 6,4 A 2,2 0 0 0 4,6 L 4,8 M 16,4 L 18,4 A 2,2 0 0 1 20,6 L 20,8 M 20,16 L 20,18 A 2,2 0 0 1 18,20 L 16,20 M 8,20 L 6,20 A 2,2 0 0 1 4,18 L 4,16</StreamGeometry>
        <StreamGeometry x:Key="PbIconChevronsLeft">M 11,7 L 6,12 L 11,17 M 17,7 L 12,12 L 17,17</StreamGeometry>
        <StreamGeometry x:Key="PbIconChevronsRight">M 13,7 L 18,12 L 13,17 M 7,7 L 12,12 L 7,17</StreamGeometry>
        <StreamGeometry x:Key="PbIconChevronLeft">M 15,6 L 9,12 L 15,18</StreamGeometry>
        <StreamGeometry x:Key="PbIconChevronRight">M 9,6 L 15,12 L 9,18</StreamGeometry>
        <!-- Two hairline-spaced strokes so the bounding box has non-zero height (a single M 5,12 L 19,12
             line collapses under Stretch="Uniform"); renders as one crisp minus bar at icon size. -->
        <StreamGeometry x:Key="PbIconMinus">M 5,11.85 L 19,11.85 M 5,12.15 L 19,12.15</StreamGeometry>
        <StreamGeometry x:Key="PbIconPlus">M 12,5 L 12,19 M 5,12 L 19,12</StreamGeometry>
        <StreamGeometry x:Key="PbIconSearch">M 11,4 A 7,7 0 1 0 11,18 A 7,7 0 1 0 11,4 Z M 16,16 L 21,21</StreamGeometry>
        <StreamGeometry x:Key="PbIconClose">M 6,6 L 18,18 M 18,6 L 6,18</StreamGeometry>
        <StreamGeometry x:Key="PbIconRotateCw">M 21,12 A 9,9 0 1 1 18,5.26 M 21,3 L 21,8 L 16,8</StreamGeometry>
        <StreamGeometry x:Key="PbIconRotateCcw">M 3,12 A 9,9 0 1 0 6,5.26 M 3,3 L 3,8 L 8,8</StreamGeometry>
        <StreamGeometry x:Key="PbIconEdit">M 16.5,3.5 L 20.5,7.5 L 8,20 L 3,21 L 4,16 Z M 14.5,5.5 L 18.5,9.5</StreamGeometry>
        <StreamGeometry x:Key="PbIconCheck">M 20,6 L 9,17 L 4,12</StreamGeometry>
        <StreamGeometry x:Key="PbIconTrash">M 3,6 L 21,6 M 19,6 L 19,20 A 2,2 0 0 1 17,22 L 7,22 A 2,2 0 0 1 5,20 L 5,6 M 8,6 L 8,4 A 2,2 0 0 1 10,2 L 14,2 A 2,2 0 0 1 16,4 L 16,6 M 10,11 L 10,17 M 14,11 L 14,17</StreamGeometry>
        <StreamGeometry x:Key="PbIconBookOpen">M 12,7 L 12,21 M 3,18 A 1,1 0 0 1 2,17 L 2,4 A 1,1 0 0 1 3,3 L 8,3 A 4,4 0 0 1 12,7 A 4,4 0 0 1 16,3 L 21,3 A 1,1 0 0 1 22,4 L 22,17 A 1,1 0 0 1 21,18 L 15,18 A 3,3 0 0 0 12,21 A 3,3 0 0 0 9,18 Z</StreamGeometry>
        <StreamGeometry x:Key="PbIconPlay">M 7,4 L 20,12 L 7,20 Z</StreamGeometry>
        <StreamGeometry x:Key="PbIconFit">M 5,3 L 19,3 A 2,2 0 0 1 21,5 L 21,19 A 2,2 0 0 1 19,21 L 5,21 A 2,2 0 0 1 3,19 L 3,5 A 2,2 0 0 1 5,3 Z M 7.5,10 L 16.5,10 L 16.5,14 L 7.5,14 Z</StreamGeometry>
        <StreamGeometry x:Key="PbIconArrowRight">M 5,12 L 19,12 M 13,6 L 19,12 L 13,18</StreamGeometry>
        <StreamGeometry x:Key="PbIconArrowLeft">M 19,12 L 5,12 M 11,6 L 5,12 L 11,18</StreamGeometry>
        <StreamGeometry x:Key="PbIconArrowDown">M 12,5 L 12,19 M 6,13 L 12,19 L 18,13</StreamGeometry>

        <!-- Phase 4b (docs/superpowers/specs/2026-08-27-library-browsing-4b-toolbar-rework-design.md
             §3) - Library toolbar's "View & Sort" button, the Sort-tab direction affordance, and
             the View-tab grid glyph. Same hand-built Lucide-style stroked geometry as the set above. -->
        <StreamGeometry x:Key="PbIconViewSort">M 3,7 L 12,7 M 16,7 L 21,7 M 12,7 A 2,2 0 1 0 16,7 A 2,2 0 1 0 12,7 Z M 3,17 L 6,17 M 10,17 L 21,17 M 6,17 A 2,2 0 1 0 10,17 A 2,2 0 1 0 6,17 Z</StreamGeometry>
        <StreamGeometry x:Key="PbIconSortAsc">M 6,4 L 6,20 M 3,17 L 6,20 L 9,17 M 12,7 L 15,7 M 12,12 L 18,12 M 12,17 L 21,17</StreamGeometry>
        <StreamGeometry x:Key="PbIconGrid">M 4,4 L 10,4 A 1,1 0 0 1 11,5 L 11,10 A 1,1 0 0 1 10,11 L 4,11 A 1,1 0 0 1 3,10 L 3,5 A 1,1 0 0 1 4,4 Z M 14,4 L 20,4 A 1,1 0 0 1 21,5 L 21,10 A 1,1 0 0 1 20,11 L 14,11 A 1,1 0 0 1 13,10 L 13,5 A 1,1 0 0 1 14,4 Z M 4,13 L 10,13 A 1,1 0 0 1 11,14 L 11,19 A 1,1 0 0 1 10,20 L 4,20 A 1,1 0 0 1 3,19 L 3,14 A 1,1 0 0 1 4,13 Z M 14,13 L 20,13 A 1,1 0 0 1 21,14 L 21,19 A 1,1 0 0 1 20,20 L 14,20 A 1,1 0 0 1 13,19 L 13,14 A 1,1 0 0 1 14,13 Z</StreamGeometry>
    </Styles.Resources>

    <!-- Shared stroke treatment - callers set Stroke (and Width/Height, default 14 matching the old
         Border.icon default in App.axaml) the same way they used to set Background on Border.icon. -->
    <Style Selector="Path.pbIcon">
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Stroke" Value="{DynamicResource PbTextMutedBrush}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
    </Style>
</Styles>
