<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:models="using:Paperbunkr.App.Models"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="760"
             x:Class="Paperbunkr.App.Views.EventsScreen"
             x:DataType="vm:EventsScreenViewModel">

    <UserControl.Styles>
        <!-- statCard / statNumber / statLabel / issueRow / searchBox come from Styles/ScreenChrome.axaml. -->
        <Style Selector="Button.headerAction">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusSm}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.headerAction.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
        </Style>
        <Style Selector="Button.headerAction.secondary">
            <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
        </Style>
        <Style Selector="Button.headerAction.secondary.active">
            <Setter Property="Background" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbBadgeTextBrush}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel>

            <!-- Mode switcher (docs/superpowers/specs/2026-08-27-metadata-model-phase4f-continuity-
                 browse-design.md + phase4g-age-progression) - Events | Continuities | Timeline -->
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="28,20,28,16">
                <Button Classes="headerAction secondary" Classes.active="{Binding IsEventsMode}" Content="Events"
                        Command="{Binding SetModeCommand}" CommandParameter="{x:Static models:EventsScreenMode.Events}" />
                <Button Classes="headerAction secondary" Classes.active="{Binding IsContinuitiesMode}" Content="Continuities"
                        Command="{Binding SetModeCommand}" CommandParameter="{x:Static models:EventsScreenMode.Continuities}" />
                <Button Classes="headerAction secondary" Classes.active="{Binding IsTimelineMode}" Content="Timeline"
                        Command="{Binding SetModeCommand}" CommandParameter="{x:Static models:EventsScreenMode.Timeline}" />
            </StackPanel>

          <StackPanel IsVisible="{Binding IsEventsMode}">
            <Grid ColumnDefinitions="*,Auto" Margin="28,0,28,16">
                <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                    <TextBlock Classes="pbTextHeading" Text="{Binding EventName}" />
                    <TextBlock Text="{Binding Description}" FontSize="12.5" Foreground="{DynamicResource PbTextFaintBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
            <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,24" />

            <TextBlock Text="No story events yet — create one from the sidebar to get started." FontSize="13"
                       Foreground="{DynamicResource PbTextFaintBrush}" Margin="28,0,28,40" TextWrapping="Wrap"
                       IsVisible="{Binding HasNoEvents}" />

            <StackPanel MaxWidth="820" HorizontalAlignment="Left" Margin="28,0,28,40" IsVisible="{Binding !HasNoEvents}">

                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,22">
                    <Border Classes="statCard">
                        <StackPanel><TextBlock Classes="statNumber" Text="{Binding TotalMembers}" Foreground="{DynamicResource PbTextBrush}" />
                            <TextBlock Classes="statLabel" Text="MEMBERS" /></StackPanel>
                    </Border>
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,20">
                    <TextBox Grid.Column="0" Classes="searchBox" Watermark="Search your library by series or number…"
                              Text="{Binding SearchQuery}" />
                    <ComboBox Grid.Column="1" Margin="8,0,0,0" ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding SelectedRoleOption}"
                              MinWidth="120" FontSize="12">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:EventMembershipRoleOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="2" Classes="headerAction secondary" Margin="8,0,0,0" Command="{Binding SearchCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Path Classes="pbIcon" Width="11" Height="11" Data="{StaticResource PbIconSearch}" />
                            <TextBlock Text="Search" />
                        </StackPanel>
                    </Button>
                </Grid>
                <ItemsControl ItemsSource="{Binding SearchResults}" Margin="0,0,0,20">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:IssueSearchResult">
                            <Border Classes="issueRow" Background="{DynamicResource PbSurface2Brush}" Margin="0,0,0,4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayLabel}" FontSize="13" Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Classes="headerAction secondary"
                                            Command="{Binding $parent[ItemsControl].((vm:EventsScreenViewModel)DataContext).AddIssueCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Path Classes="pbIcon" Width="10" Height="10" Data="{StaticResource PbIconPlus}" />
                                            <TextBlock Text="Add" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="No members yet — search above to add issues." FontSize="12.5"
                           Foreground="{DynamicResource PbTextFaintBrush}" IsVisible="{Binding HasNoMembers}" />

                <ItemsControl ItemsSource="{Binding Members}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:EventMemberRowViewModel">
                            <Border Classes="issueRow">
                                <Grid ColumnDefinitions="30,*,140,Auto,Auto,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Number}" FontFamily="Consolas,monospace"
                                               FontSize="11" Foreground="{DynamicResource PbTextFaintBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13"
                                               Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" Margin="12,0" />
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding SelectedRoleOption}"
                                              FontSize="12" VerticalAlignment="Center">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:EventMembershipRoleOption">
                                                <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Grid.Column="3" Classes="headerAction ghost" Content="↑" Command="{Binding MoveUpCommand}" />
                                    <Button Grid.Column="4" Classes="headerAction ghost" Content="↓" Command="{Binding MoveDownCommand}" />
                                    <Button Grid.Column="5" Classes="headerAction ghost" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove">
                                        <Path Classes="pbIcon" Width="11" Height="11" Data="{StaticResource PbIconTrash}" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Connected Events (docs/superpowers/specs/2026-08-27-metadata-model-phase4d-event-relations-design.md) -->
                <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,0,0,1" Margin="0,28,0,16" />
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                    <TextBlock Grid.Column="0" Text="Connected Events" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="headerAction secondary" Command="{Binding ToggleConnectEventCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Path Classes="pbIcon" Width="10" Height="10" Data="{StaticResource PbIconPlus}" />
                            <TextBlock Text="Connect Event" />
                        </StackPanel>
                    </Button>
                </Grid>

                <StackPanel IsVisible="{Binding IsConnectingEvent}" Margin="0,0,0,14">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <TextBox Grid.Column="0" Classes="searchBox" Watermark="Search story events by name…" Text="{Binding ConnectEventQuery}" />
                        <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="130" FontSize="12"
                                  ItemsSource="{Binding EventRelationTypeOptions}" SelectedItem="{Binding SelectedEventRelationTypeOption}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:RelationTypeOption">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding EventSearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:StoryEventSearchResult">
                                <Border Classes="issueRow" Background="{DynamicResource PbSurface2Brush}" Margin="0,0,0,4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Classes="headerAction secondary"
                                                Command="{Binding $parent[ItemsControl].((vm:EventsScreenViewModel)DataContext).ConnectEventCommand}"
                                                CommandParameter="{Binding}" Content="Connect" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Text="No connected events yet." FontSize="12.5"
                           Foreground="{DynamicResource PbTextFaintBrush}" IsVisible="{Binding HasNoConnectedEvents}" />

                <ItemsControl ItemsSource="{Binding ConnectedEvents}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ConnectedEventCard">
                            <Border Classes="issueRow" Background="{DynamicResource PbSurface2Brush}" Margin="0,0,0,4">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <Button Grid.Column="0" Classes="headerAction ghost" HorizontalAlignment="Left"
                                            Command="{Binding $parent[ItemsControl].((vm:EventsScreenViewModel)DataContext).OpenConnectedEventCommand}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                                    </Button>
                                    <Border Grid.Column="1" Classes="pbChip" Padding="8,3" VerticalAlignment="Center" Margin="8,0">
                                        <TextBlock Text="{Binding RelationLabel}" FontSize="10.5" Foreground="{DynamicResource PbTextFaintBrush}" />
                                    </Border>
                                    <Button Grid.Column="2" Classes="headerAction ghost" ToolTip.Tip="Unlink"
                                            Command="{Binding $parent[ItemsControl].((vm:EventsScreenViewModel)DataContext).RemoveConnectedEventCommand}"
                                            CommandParameter="{Binding}">
                                        <Path Classes="pbIcon" Width="11" Height="11" Data="{StaticResource PbIconTrash}" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Suggested connections (docs/superpowers/specs/2026-08-27-metadata-model-phase4d-event-relations-design.md) -->
                <StackPanel IsVisible="{Binding !HasNoConnectionSuggestions}" Margin="0,10,0,0">
                    <TextBlock Text="Suggested connections" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PbTextMutedBrush}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding EventConnectionSuggestions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:EventConnectionSuggestionCard">
                                <Border Classes="issueRow" Background="{DynamicResource PbSurface2Brush}" Margin="0,0,0,4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                                            <TextBlock Text="{Binding Reason}" FontSize="10.5" Foreground="{DynamicResource PbTextFaintBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="headerAction secondary" Content="Connect" VerticalAlignment="Center"
                                                Command="{Binding $parent[ItemsControl].((vm:EventsScreenViewModel)DataContext).ConnectSuggestedEventCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Event chain / transitive graph (docs/superpowers/specs/2026-08-27-metadata-model-phase4d-event-relations-design.md) -->
                <Button Classes="headerAction ghost" HorizontalAlignment="Left" Margin="0,14,0,0"
                        Command="{Binding ToggleEventFamilyCommand}" IsVisible="{Binding HasEventChain}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Event chain" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PbTextBrush}" />
                        <Path Classes="pbIcon" Width="10" Height="10" Data="{StaticResource PbIconChevronRight}" IsVisible="{Binding !EventFamilyExpanded}" />
                        <Path Classes="pbIcon" Width="10" Height="10" Data="{StaticResource PbIconArrowDown}" IsVisible="{Binding EventFamilyExpanded}" />
                    </StackPanel>
                </Button>
                <ItemsControl ItemsSource="{Binding EventFamily}" IsVisible="{Binding EventFamilyExpanded}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:EventFamilyNodeCard">
                            <Button Classes="headerAction ghost" HorizontalAlignment="Left" Padding="4,3"
                                    Command="{Binding $parent[ItemsControl].((vm:EventsScreenViewModel)DataContext).OpenFamilyEventCommand}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="{Binding Indent}" />
                                    <Path Classes="pbIcon" Width="8" Height="8" Data="{StaticResource PbIconChevronRight}"
                                          Margin="0,0,5,0" VerticalAlignment="Center" IsVisible="{Binding !IsRoot}" />
                                    <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource PbTextBrush}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Suggested Issues (docs/superpowers/specs/2026-08-27-metadata-model-phase4e-format-signal-suggestions-design.md) -->
                <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,0,0,1" Margin="0,28,0,16"
                        IsVisible="{Binding !HasNoSuggestions}" />
                <Button Classes="headerAction ghost" HorizontalAlignment="Left" Margin="0,0,0,10"
                        Command="{Binding ToggleSuggestionsCommand}" IsVisible="{Binding !HasNoSuggestions}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Suggested for this Event" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PbTextBrush}" />
                        <Path Classes="pbIcon" Width="10" Height="10" Data="{StaticResource PbIconChevronRight}"
                              IsVisible="{Binding !SuggestionsExpanded}" />
                        <Path Classes="pbIcon" Width="10" Height="10" Data="{StaticResource PbIconArrowDown}"
                              IsVisible="{Binding SuggestionsExpanded}" />
                    </StackPanel>
                </Button>

                <ItemsControl ItemsSource="{Binding SuggestedIssues}" IsVisible="{Binding SuggestionsExpanded}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SuggestedIssueRowViewModel">
                            <Border Classes="issueRow" Background="{DynamicResource PbSurface2Brush}" Margin="0,0,0,4">
                                <Grid ColumnDefinitions="*,140,Auto,Auto" RowDefinitions="Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DisplayLabel}" FontSize="13"
                                               Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Reason}" FontSize="10.5"
                                               Foreground="{DynamicResource PbTextFaintBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    <ComboBox Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" ItemsSource="{Binding RoleOptions}"
                                              SelectedItem="{Binding SelectedRoleOption}" FontSize="12" VerticalAlignment="Center" Margin="8,0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:EventMembershipRoleOption">
                                                <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Classes="headerAction secondary" Content="Add"
                                            Command="{Binding AddCommand}" VerticalAlignment="Center" />
                                    <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" Classes="headerAction ghost" Content="Dismiss"
                                            Command="{Binding DismissCommand}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Dismissed suggestions (docs/superpowers/specs/2026-08-27-metadata-model-phase4e-format-signal-suggestions-design.md) -->
                <Button Classes="headerAction ghost" HorizontalAlignment="Left" Margin="0,8,0,0"
                        Command="{Binding ToggleDismissedCommand}" IsVisible="{Binding !HasNoDismissed}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Dismissed" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PbTextMutedBrush}" />
                        <Border Classes="pbChip" Padding="6,1"><TextBlock Text="{Binding DismissedSuggestions.Count}" FontSize="10" Foreground="{DynamicResource PbTextFaintBrush}" /></Border>
                        <Path Classes="pbIcon" Width="10" Height="10" Data="{StaticResource PbIconChevronRight}" IsVisible="{Binding !DismissedExpanded}" />
                        <Path Classes="pbIcon" Width="10" Height="10" Data="{StaticResource PbIconArrowDown}" IsVisible="{Binding DismissedExpanded}" />
                    </StackPanel>
                </Button>
                <ItemsControl ItemsSource="{Binding DismissedSuggestions}" IsVisible="{Binding DismissedExpanded}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:DismissedSuggestionCard">
                            <Border Classes="issueRow" Background="{DynamicResource PbSurface2Brush}" Margin="0,0,0,4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12.5" Foreground="{DynamicResource PbTextFaintBrush}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Classes="headerAction ghost" Content="Restore"
                                            Command="{Binding $parent[ItemsControl].((vm:EventsScreenViewModel)DataContext).RestoreDismissedCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
          </StackPanel>

          <!-- ===== Continuities mode (docs/superpowers/specs/2026-08-27-metadata-model-phase4f-continuity-browse-design.md) ===== -->
          <StackPanel IsVisible="{Binding IsContinuitiesMode}" Margin="28,0,28,40" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="No continuities yet — create one from the sidebar." FontSize="13"
                       Foreground="{DynamicResource PbTextFaintBrush}" IsVisible="{Binding HasNoContinuities}" TextWrapping="Wrap" />

            <StackPanel IsVisible="{Binding HasActiveContinuity}">
                <TextBlock Classes="pbTextHeading" Text="{Binding ContinuityName}" />
                <TextBlock Text="{Binding ContinuityPublisher}" FontSize="12.5" Foreground="{DynamicResource PbTextFaintBrush}" Margin="0,4,0,0"
                           IsVisible="{Binding ContinuityPublisher, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="{Binding ContinuityDescription}" FontSize="12.5" Foreground="{DynamicResource PbTextFaintBrush}" Margin="0,6,0,0"
                           TextWrapping="Wrap" IsVisible="{Binding ContinuityDescription, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,0,0,1" Margin="0,16,0,16" />

                <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,12">
                    <TextBlock Grid.Column="0" Text="Series in this continuity" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="headerAction ghost" Content="Compare" Margin="0,0,6,0"
                            Command="{Binding ToggleCompareContinuitiesCommand}" IsVisible="{Binding !HasNoOverlappingContinuities}" />
                    <Button Grid.Column="2" Classes="headerAction ghost" Content="Reading list" Margin="0,0,6,0"
                            Command="{Binding CreateReadingListFromContinuityCommand}" ToolTip.Tip="Create a reading list from this continuity in publication order" />
                    <Button Grid.Column="3" Classes="headerAction secondary" Content="+ Add Series" Command="{Binding ToggleAddContinuitySeriesCommand}" />
                </Grid>

                <!-- Cross-continuity comparison (docs/superpowers/specs/2026-08-27-metadata-model-phase4f-continuity-browse-design.md) -->
                <StackPanel IsVisible="{Binding IsComparingContinuities}" Margin="0,0,0,14">
                    <TextBlock Text="Compare with another continuity:" FontSize="12" Foreground="{DynamicResource PbTextFaintBrush}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding OverlappingContinuities}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ContinuityOverlapCard">
                                <Border Classes="issueRow" Background="{DynamicResource PbSurface2Brush}" Margin="0,0,0,4">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding SharedSeriesLabel}" FontSize="10.5" Foreground="{DynamicResource PbTextFaintBrush}" VerticalAlignment="Center" Margin="8,0" />
                                        <Button Grid.Column="2" Classes="headerAction secondary" Content="Show overlap"
                                                Command="{Binding $parent[ItemsControl].((vm:EventsScreenViewModel)DataContext).CompareWithContinuityCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel IsVisible="{Binding HasComparison}" Margin="0,8,0,0">
                        <TextBlock Text="{Binding CompareContinuityName, StringFormat='Series in both this continuity and {0}'}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PbTextBrush}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding SharedContinuitySeries}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:SeriesCardSample">
                                    <Border Classes="pbChip" Padding="10,5" Margin="0,0,6,6">
                                        <TextBlock Text="{Binding Name}" FontSize="11.5" Foreground="{DynamicResource PbTextBrush}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <StackPanel IsVisible="{Binding IsAddingContinuitySeries}" Margin="0,0,0,14">
                    <TextBox Classes="searchBox" Watermark="Search series by name…" Text="{Binding ContinuitySeriesSearchQuery}" />
                    <ItemsControl ItemsSource="{Binding ContinuitySeriesSearchResults}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:SeriesSearchResult">
                                <Border Classes="issueRow" Background="{DynamicResource PbSurface2Brush}" Margin="0,0,0,4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Classes="headerAction secondary" Content="Add"
                                                Command="{Binding $parent[ItemsControl].((vm:EventsScreenViewModel)DataContext).AddSeriesToActiveContinuityCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Text="No series in this continuity yet." FontSize="12.5"
                           Foreground="{DynamicResource PbTextFaintBrush}" IsVisible="{Binding HasNoContinuityMembers}" />

                <ItemsControl ItemsSource="{Binding ContinuityMembers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:SeriesCardSample">
                            <StackPanel Width="150" Margin="0,0,10,14">
                                <Button Classes="headerAction ghost" Padding="0"
                                        Command="{Binding $parent[ItemsControl].((vm:EventsScreenViewModel)DataContext).OpenContinuitySeriesCommand}"
                                        CommandParameter="{Binding}">
                                    <Border Height="150" CornerRadius="6" ClipToBounds="True" Background="{Binding CoverBrush}">
                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="White" FontWeight="SemiBold"
                                                   Margin="8" VerticalAlignment="Bottom" TextWrapping="Wrap" />
                                    </Border>
                                </Button>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11.5" Foreground="{DynamicResource PbTextBrush}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Classes="headerAction ghost" ToolTip.Tip="Remove from continuity"
                                            Command="{Binding $parent[ItemsControl].((vm:EventsScreenViewModel)DataContext).RemoveSeriesFromActiveContinuityCommand}"
                                            CommandParameter="{Binding}">
                                        <Path Classes="pbIcon" Width="10" Height="10" Data="{StaticResource PbIconTrash}" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
          </StackPanel>

          <!-- ===== Timeline mode (docs/superpowers/specs/2026-08-27-metadata-model-phase4g-age-progression-design.md) ===== -->
          <StackPanel IsVisible="{Binding IsTimelineMode}" Margin="28,0,28,40" MaxWidth="1100" HorizontalAlignment="Left">

            <!-- Scope selector -->
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,14">
                <Button Classes="headerAction secondary" Classes.active="{Binding IsSeriesFamilyScope}" Content="Series family"
                        Command="{Binding SetTimelineScopeCommand}" CommandParameter="{x:Static models:TimelineScope.SeriesFamily}" />
                <Button Classes="headerAction secondary" Classes.active="{Binding IsContinuityScope}" Content="Continuity"
                        Command="{Binding SetTimelineScopeCommand}" CommandParameter="{x:Static models:TimelineScope.Continuity}" />
                <Button Classes="headerAction secondary" Classes.active="{Binding IsLibraryScope}" Content="Whole library"
                        Command="{Binding SetTimelineScopeCommand}" CommandParameter="{x:Static models:TimelineScope.Library}" />
            </StackPanel>

            <CheckBox Content="Include series that only share a character" IsChecked="{Binding TimelineCharacterAware}"
                      FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" Margin="0,0,0,10"
                      IsVisible="{Binding IsSeriesFamilyScope}" />

            <StackPanel IsVisible="{Binding IsContinuityScope}" Margin="0,0,0,10">
                <TextBlock Text="Pick a continuity:" FontSize="12" Foreground="{DynamicResource PbTextFaintBrush}" Margin="0,0,0,6" />
                <ComboBox ItemsSource="{Binding TimelineContinuityChoices}" SelectedItem="{Binding SelectedTimelineContinuity}" MinWidth="220" FontSize="12">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:ContinuitySummary"><TextBlock Text="{Binding Name}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <TextBlock Text="Pick a series from the sidebar to lay out its family's issues by comic age." FontSize="13"
                       Foreground="{DynamicResource PbTextFaintBrush}" IsVisible="{Binding !HasTimelineSeed}" TextWrapping="Wrap" />

            <StackPanel IsVisible="{Binding HasTimelineSeed}">
                <TextBlock Classes="pbTextHeading" Text="{Binding TimelineTitle}" Margin="0,0,0,4" />
                <TextBlock Text="No issues in this scope have a resolvable comic age yet." FontSize="12.5"
                           Foreground="{DynamicResource PbTextFaintBrush}" IsVisible="{Binding HasNoTimelineSections}" />

                <!-- Review inferred ages (docs/superpowers/specs/2026-08-27-metadata-model-phase4g-age-progression-design.md) -->
                <Button Classes="headerAction ghost" HorizontalAlignment="Left" Margin="0,10,0,0"
                        Command="{Binding ToggleInferredAgesCommand}" IsVisible="{Binding !HasNoInferredAges}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Review inferred ages" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PbTextBrush}" />
                        <Border Classes="pbChip" Padding="6,1"><TextBlock Text="{Binding InferredAges.Count}" FontSize="10" Foreground="{DynamicResource PbTextFaintBrush}" /></Border>
                        <Path Classes="pbIcon" Width="10" Height="10" Data="{StaticResource PbIconChevronRight}" IsVisible="{Binding !InferredAgesExpanded}" />
                        <Path Classes="pbIcon" Width="10" Height="10" Data="{StaticResource PbIconArrowDown}" IsVisible="{Binding InferredAgesExpanded}" />
                    </StackPanel>
                </Button>
                <StackPanel IsVisible="{Binding InferredAgesExpanded}" Margin="0,8,0,0">
                    <Button Classes="headerAction secondary" Content="Accept all" HorizontalAlignment="Left" Margin="0,0,0,8"
                            Command="{Binding AcceptAllInferredAgesCommand}" />
                    <ItemsControl ItemsSource="{Binding InferredAges}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:InferredAgeRowViewModel">
                                <Border Classes="issueRow" Background="{DynamicResource PbSurface2Brush}" Margin="0,0,0,4">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayLabel}" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                                            <TextBlock FontSize="10.5" Foreground="{DynamicResource PbTextFaintBrush}">
                                                <Run Text="{Binding YearLabel}" /><Run Text=" → " /><Run Text="{Binding AgeLabel}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <Border Grid.Column="1" Classes="pbChip" Padding="6,2" VerticalAlignment="Center" Margin="8,0"
                                                IsVisible="{Binding IsReducedConfidence}" ToolTip.Tip="{Binding ConfidenceReason}">
                                            <TextBlock Text="disputed" FontSize="9.5" Foreground="{DynamicResource PbTextFaintBrush}" />
                                        </Border>
                                        <Button Grid.Column="2" Classes="headerAction secondary" Content="Accept" VerticalAlignment="Center"
                                                Command="{Binding AcceptCommand}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding TimelineSections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TimelineSectionViewModel">
                            <StackPanel Margin="0,16,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PbTextBrush}"
                                               ToolTip.Tip="{Binding CommonlyCitedRange}" />
                                    <TextBlock Text="{Binding CommonlyCitedRange}" FontSize="10.5" Foreground="{DynamicResource PbTextFaintBrush}"
                                               VerticalAlignment="Center" IsVisible="{Binding HasCommonlyCitedRange}" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Issues}" Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:TimelineIssueCard">
                                            <Button Classes="headerAction ghost" Padding="0" Margin="0,0,10,12"
                                                    Command="{Binding $parent[ItemsControl].((vm:EventsScreenViewModel)DataContext).OpenTimelineIssueCommand}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Width="104">
                                                    <Panel>
                                                        <Border Height="150" CornerRadius="5" ClipToBounds="True" Background="{Binding CoverBrush}">
                                                            <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                                                        </Border>
                                                        <Border Width="9" Height="9" CornerRadius="9" Background="{DynamicResource PbAccentBrush}"
                                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5"
                                                                IsVisible="{Binding IsUnread}" ToolTip.Tip="Unread" />
                                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5" Padding="4,1"
                                                                CornerRadius="3" Background="{DynamicResource PbBadgeBrush}"
                                                                IsVisible="{Binding IsReducedConfidence}" ToolTip.Tip="{Binding ConfidenceReason}">
                                                            <TextBlock Text="?" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource PbBadgeTextBrush}" />
                                                        </Border>
                                                    </Panel>
                                                    <TextBlock Text="{Binding SeriesName}" FontSize="10.5" Foreground="{DynamicResource PbTextBrush}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                                    <TextBlock FontSize="9.5" Foreground="{DynamicResource PbTextFaintBrush}">
                                                        <Run Text="{Binding Title}" /><Run Text="  " /><Run Text="{Binding YearLabel}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
          </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
