<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:models="using:Paperbunkr.App.Models"
             xmlns:views="using:Paperbunkr.App.Views"
             xmlns:controls="using:Paperbunkr.App.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="Paperbunkr.App.Views.ReadingGalleryView"
             x:DataType="vm:ReadingGalleryViewModel">
    <!-- The Reading Lists gallery home (docs/superpowers/specs/2026-09-28-reading-lists-redesign-design.md §2, H1): header + breadcrumb,
         tag chips, "Continue reading", then one grid of folder and list tiles. Tiles drag to reorder or into folders (code-behind); a
         dropped directory of .cbl files imports as a folder. -->
    <UserControl.Styles>
        <StyleInclude Source="avares://Paperbunkr.App/Styles/ReadingListsChrome.axaml" />
        <Style Selector="Border.rlProgressSegment">
            <Setter Property="Background" Value="{DynamicResource PbSurface3Brush}" />
        </Style>
        <Style Selector="Border.rlProgressSegment.read">
            <Setter Property="Background" Value="{DynamicResource PbAccentBrush}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled" DragDrop.AllowDrop="True">
        <StackPanel x:Name="GalleryContent" Margin="24,26,24,40" Spacing="16">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Grid.Column="0" Spacing="4">
                    <ItemsControl ItemsSource="{Binding Breadcrumb}" IsVisible="{Binding IsInFolder}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ReadingBreadcrumb">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button Classes="ghost" Content="{Binding Name}"
                                            Command="{Binding $parent[views:ReadingGalleryView].((vm:ReadingGalleryViewModel)DataContext).OpenCrumbCommand}"
                                            CommandParameter="{Binding}" IsEnabled="{Binding !IsLast}" />
                                    <TextBlock Text="›" Classes="rlFaint" VerticalAlignment="Center" IsVisible="{Binding !IsLast}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="pbTextHeading" FontSize="34" LineHeight="40" Text="Reading Lists" IsVisible="{Binding !IsInFolder}" />
                    <TextBlock Classes="pbTextHeading" FontSize="34" LineHeight="40" Text="{Binding CurrentFolderName}" IsVisible="{Binding IsInFolder}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                    <Button Classes="secondary" Command="{Binding CreateFolderCommand}" CommandParameter="{x:Null}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <fi:SymbolIcon Symbol="FolderAdd" FontSize="{StaticResource PbIconSizeXs}" />
                            <TextBlock Text="Folder" />
                        </StackPanel>
                    </Button>
                    <Button Classes="primary"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenNewReadingListDialogCommand}"
                            AutomationProperties.AutomationId="NewReadingListButton">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <fi:SymbolIcon Symbol="Add" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbBadgeTextBrush}" />
                            <TextBlock Text="New list" />
                        </StackPanel>
                    </Button>
                    <Button Classes="ghost" ToolTip.Tip="More" AutomationProperties.Name="More reading list actions">
                        <fi:SymbolIcon Symbol="MoreHorizontal" FontSize="{StaticResource PbIconSizeSm}" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Import folder of .CBL…" Command="{Binding ImportFolderCommand}" />
                                <MenuItem Header="Export this folder as .CBL…" Command="{Binding ExportFolderCommand}" CommandParameter="{x:Null}" IsVisible="{Binding IsInFolder}" />
                                <MenuItem Header="Sort A–Z" Command="{Binding SortFolderCommand}" CommandParameter="{x:Null}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Tag chips: one row that scrolls sideways (the wheel too, see the code-behind), its right edge fading out -->
            <ScrollViewer x:Name="TagScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="-8,-8,-8,-8" IsVisible="{Binding TagChips.Count}">
                <ScrollViewer.OpacityMask>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Offset="0.0" Color="Black" />
                        <GradientStop Offset="0.94" Color="Black" />
                        <GradientStop Offset="1.0" Color="Transparent" />
                    </LinearGradientBrush>
                </ScrollViewer.OpacityMask>
                <ItemsControl ItemsSource="{Binding TagChips}" Margin="8">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ReadingTagChip">
                            <Button Classes="filterChip" Classes.on="{Binding IsActive}" Content="{Binding Label}"
                                    Command="{Binding $parent[views:ReadingGalleryView].((vm:ReadingGalleryViewModel)DataContext).SelectTagCommand}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Continue reading -->
            <StackPanel Spacing="8" IsVisible="{Binding ShowContinueRow}">
                <TextBlock Classes="rlCaption" Text="CONTINUE READING" />
                <ItemsControl ItemsSource="{Binding ContinueCards}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ReadingContinueCard">
                            <Button Classes="rlContinue" Margin="0,0,12,12" AutomationProperties.Name="{Binding Name}"
                                    Command="{Binding $parent[views:ReadingGalleryView].((vm:ReadingGalleryViewModel)DataContext).OpenContinueCommand}"
                                    CommandParameter="{Binding}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Border Grid.Column="0" Width="34" Height="51" CornerRadius="{DynamicResource PbRadiusSm}" ClipToBounds="True" Background="{DynamicResource PbSurface3Brush}">
                                        <Image views:AsyncCoverImage.SourceId="{Binding CoverKey}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{Binding Name}" Classes="pbTextBody" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                        <TextBlock Text="{Binding NextLine}" Classes="rlFaint" TextTrimming="CharacterEllipsis" />
                                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="4" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Grid: folders first (compact cards), then the lists (wide cards). One ItemsControl so drag, rename and the arrow keys treat them alike;
                 ReadingTileWrapPanel sizes the cells (folders in narrower columns, a row break, then the lists). -->
            <ItemsControl x:Name="TileGrid" ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:ReadingTileWrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ReadingGalleryTile">
                        <Border Classes="rlTileHost" Margin="0,0,12,12" DragDrop.AllowDrop="True" Background="Transparent">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Classes="rlDropBar dropBefore" Margin="0,0,4,0" />
                                <Button Grid.Column="1" Classes="rlTile" Command="{Binding $parent[views:ReadingGalleryView].((vm:ReadingGalleryViewModel)DataContext).OpenTileCommand}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}">
                                    <!-- The ringed Border keeps Border.rlTileCover's 2px margin so the glow has room (see the ring note in ReadingListsChrome.axaml). -->
                                    <Border Classes="rlTileCover rlListCard" Classes.folder="{Binding IsFolder}">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                            <!-- A list's cover: an arc cover alone, else a fanned stack of up to three member covers -->
                                            <Panel Grid.Column="0" Width="84" Height="118" VerticalAlignment="Top" IsVisible="{Binding IsList}">
                                                <Border Classes="rlCardCover" Width="84" Height="118" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                        IsVisible="{Binding ArcCover, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                                                    <Image Source="{Binding ArcCover}" Stretch="UniformToFill" />
                                                </Border>
                                                <Panel IsVisible="{Binding ShowMosaic}">
                                                    <Border Classes="rlCardCover" Width="68" Height="102" Margin="16,0,0,0" Opacity="0.55" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                            IsVisible="{Binding BackCoverKey, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                                                        <Image views:AsyncCoverImage.SourceId="{Binding BackCoverKey}" Stretch="UniformToFill" />
                                                    </Border>
                                                    <Border Classes="rlCardCover" Width="68" Height="102" Margin="8,8,0,0" Opacity="0.8" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                            IsVisible="{Binding MidCoverKey, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                                                        <Image views:AsyncCoverImage.SourceId="{Binding MidCoverKey}" Stretch="UniformToFill" />
                                                    </Border>
                                                    <Border Classes="rlCardCover" Width="68" Height="102" Margin="0,16,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                            BoxShadow="{StaticResource PbElevationShadow}">
                                                        <Image views:AsyncCoverImage.SourceId="{Binding FrontCoverKey}" Stretch="UniformToFill" />
                                                    </Border>
                                                </Panel>
                                                <Border Classes="rlCardCover" Width="68" Height="102" Margin="0,16,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsVisible="{Binding ShowGlyph}">
                                                    <fi:SymbolIcon Symbol="TextBulletListSquare" FontSize="26" Foreground="{DynamicResource PbTextFaintBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Panel>
                                            <!-- A folder's cover: a small fan of the first lists' covers -->
                                            <Panel Grid.Column="0" Width="48" Height="56" VerticalAlignment="Center" IsVisible="{Binding IsFolder}">
                                                <Border Classes="rlCardCover" Width="32" Height="48" Margin="16,0,0,0" Opacity="0.55" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                        IsVisible="{Binding BackCoverKey, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                                                    <Image views:AsyncCoverImage.SourceId="{Binding BackCoverKey}" Stretch="UniformToFill" />
                                                </Border>
                                                <Border Classes="rlCardCover" Width="32" Height="48" Margin="8,4,0,0" Opacity="0.8" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                        IsVisible="{Binding MidCoverKey, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                                                    <Image views:AsyncCoverImage.SourceId="{Binding MidCoverKey}" Stretch="UniformToFill" />
                                                </Border>
                                                <Border Classes="rlCardCover" Width="32" Height="48" Margin="0,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                    <Panel>
                                                        <Image views:AsyncCoverImage.SourceId="{Binding FrontCoverKey}" Stretch="UniformToFill" />
                                                        <fi:SymbolIcon Symbol="Folder" FontSize="{StaticResource PbIconSizeSm}" Foreground="{DynamicResource PbTextFaintBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowGlyph}" />
                                                    </Panel>
                                                </Border>
                                            </Panel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsList}">
                                                    <TextBlock Classes="rlTypeCaption" Text="{Binding TypeCaption}" IsVisible="{Binding HasTypeCaption}" />
                                                    <TextBlock Classes="pbTextOverline" Text="{Binding CaptionLine}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Name}" Classes="pbTextSection" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding Name}" IsVisible="{Binding !IsRenaming}" />
                                                <TextBox Classes="rlRename" Text="{Binding RenameText}" IsVisible="{Binding IsRenaming}" FontSize="12"
                                                         AutomationProperties.Name="Name" />
                                                <TextBlock Text="{Binding Synopsis}" Classes="pbTextMeta" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                                           IsVisible="{Binding ShowSynopsis}" />
                                                <TextBlock Text="{Binding SubLine}" Classes="pbTextMeta" IsVisible="{Binding IsFolder}" />
                                                <ItemsControl ItemsSource="{Binding ProgressSegments}" IsVisible="{Binding ShowProgress}" Margin="0,4,0,0"
                                                              AutomationProperties.Name="{Binding ProgressLabel}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:ReadingProgressSegment">
                                                            <Border Classes="rlProgressSegment" Classes.read="{Binding IsRead}" Height="4" Width="4" CornerRadius="2" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsList}">
                                                    <TextBlock Grid.Column="0" Text="{Binding FooterLeft}" Classes="pbTextCaption" Classes.finished="{Binding IsFinished}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding FooterRight}" Classes="pbTextCaption" />
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>
                                <Border Grid.Column="2" Classes="rlDropBar dropAfter" Margin="4,0,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Empty states (Q18) -->
            <StackPanel Spacing="12" HorizontalAlignment="Center" Margin="0,40,0,0" IsVisible="{Binding HasNoLists}">
                <controls:EmptyIllustration Kind="Bookmark" HorizontalAlignment="Center" />
                <TextBlock Text="No reading lists yet" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource PbTextBrush}" />
                <TextBlock Text="Build one from a story arc, import a .CBL, or start a blank list." Classes="rlFaint" HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <Button Classes="primary"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenNewReadingListDialogCommand}"><StackPanel Orientation="Horizontal" Spacing="6"><fi:SymbolIcon Symbol="Add" FontSize="{StaticResource PbIconSizeXs}" /><TextBlock Text="New list" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Classes="secondary" Content="Import folder of .CBL…" Command="{Binding ImportFolderCommand}" />
                </StackPanel>
            </StackPanel>
            <TextBlock Text="This folder is empty. Drag lists here, or create one." Classes="rlFaint" FontSize="13" IsVisible="{Binding IsEmptyFolder}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
