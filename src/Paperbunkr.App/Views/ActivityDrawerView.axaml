<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:views="using:Paperbunkr.App.Views"
             xmlns:models="using:Paperbunkr.App.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="360"
             x:Class="Paperbunkr.App.Views.ActivityDrawerView"
             x:DataType="vm:ActivityCenterViewModel">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Paperbunkr.App/Views/ActivityTemplates.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.activityIconBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.activityIconBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
        </Style>
        <Style Selector="Button.activityLink">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="{DynamicResource PbFontSizeOverline}" />
            <Setter Property="Foreground" Value="{DynamicResource PbAccentTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.activityTab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="6,6,0,0" />
            <Setter Property="FontSize" Value="{DynamicResource PbFontSizeControl}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextFaintBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.activityTab.active">
            <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbAccentTextBrush}" />
        </Style>
        <Style Selector="Border#DrawerRoot">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="{StaticResource PbMotionEase}" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
            <!-- Avalonia's transform mini-language has no % unit - the drawer is 360px tall, so
                 380px clears it fully. -->
            <Setter Property="RenderTransform" Value="translateY(380px)" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Border#DrawerRoot.open">
            <Setter Property="RenderTransform" Value="translateY(0px)" />
            <Setter Property="Opacity" Value="1" />
        </Style>
    </UserControl.Styles>

    <Border x:Name="DrawerRoot" Classes.open="{Binding IsDrawerOpen}"
            VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
            Height="360" Background="{DynamicResource PbSurface2Brush}"
            BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,1,0,0"
            CornerRadius="10,10,0,0" BoxShadow="0 -6 24 0 #66000000">
        <Grid RowDefinitions="Auto,Auto,*">

            <!-- Tab strip -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="8,8,8,0">
                <Button Grid.Column="0" Classes="activityTab" Classes.active="{Binding !IsHistory}"
                        Command="{Binding ShowActiveTabCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Active" />
                        <Border CornerRadius="999" Background="{DynamicResource PbSurface3Brush}" Padding="5,0"
                                IsVisible="{Binding HasRunningJobs}">
                            <TextBlock Text="{Binding RunningCount}" FontSize="10" Foreground="{DynamicResource PbAccentTextBrush}" />
                        </Border>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Classes="activityTab" Classes.active="{Binding IsHistory}"
                        Command="{Binding ShowHistoryTabCommand}" Content="History" />
                <Button Grid.Column="2" Classes="activityTab" IsEnabled="False" Content="Scheduled"
                        ToolTip.Tip="Coming soon" />

                <Button Grid.Column="4" Classes="activityLink" Content="Stop all" Margin="0,0,12,0"
                        Command="{Binding StopAllCommand}" IsVisible="{Binding HasRunningJobs}" />
                <Button Grid.Column="5" Classes="activityIconBtn" Command="{Binding CloseCommand}"
                        AutomationProperties.Name="Close activity center" ToolTip.Tip="Close">
                    <fi:SymbolIcon Symbol="ChevronDown" FontSize="{StaticResource PbIconSizeSm}" />
                </Button>
            </Grid>

            <Border Grid.Row="1" Height="1" Background="{DynamicResource PbBorderBrush}" />

            <!-- Active tab -->
            <ScrollViewer Grid.Row="2" Padding="12" IsVisible="{Binding !IsHistory}">
                <StackPanel Spacing="2">
                    <ItemsControl ItemsSource="{Binding RunningJobs}" ItemTemplate="{StaticResource ActivityJobRowTemplate}" />

                    <StackPanel IsVisible="{Binding UpkeepJob.UpkeepActive, FallbackValue=False}" Margin="0,4,0,0">
                        <TextBlock Text="BACKGROUND UPKEEP" FontSize="{DynamicResource PbFontSizeMicro}" FontWeight="Bold"
                                   Foreground="{DynamicResource PbTextFaintBrush}" Margin="2,4,0,3" />
                        <Border Background="{DynamicResource PbSurface3Brush}" CornerRadius="{DynamicResource PbRadiusSm}" Padding="9,7">
                            <TextBlock Text="{Binding UpkeepJob.Detail}" FontSize="{DynamicResource PbFontSizeOverline}"
                                       Foreground="{DynamicResource PbTextMutedBrush}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding HasAlerts}" Margin="0,4,0,0">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,3">
                            <TextBlock Grid.Column="0" Text="ALERTS" FontSize="{DynamicResource PbFontSizeMicro}" FontWeight="Bold"
                                       Foreground="{DynamicResource PbTextFaintBrush}" Margin="2,0,0,0" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="activityLink" Content="Dismiss all" Command="{Binding DismissAllAlertsCommand}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Alerts}" ItemTemplate="{StaticResource ActivityAlertRowTemplate}" />
                    </StackPanel>

                    <TextBlock Text="No jobs running." FontSize="{DynamicResource PbFontSizeControl}"
                               Foreground="{DynamicResource PbTextFaintBrush}" Margin="2,24" HorizontalAlignment="Center"
                               IsVisible="{Binding !HasRunningJobs}" />
                </StackPanel>
            </ScrollViewer>

            <!-- History tab -->
            <Grid Grid.Row="2" RowDefinitions="Auto,*,Auto" IsVisible="{Binding IsHistory}">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" Margin="12,10" ColumnSpacing="8">
                    <TextBox Grid.Column="0" Text="{Binding HistorySearch}" Watermark="Search history…"
                             FontSize="{DynamicResource PbFontSizeControl}" />
                    <ComboBox Grid.Column="1" SelectedItem="{Binding HistoryKind}" MinWidth="130"
                              ItemsSource="{Binding HistoryKindOptions}" />
                    <ComboBox Grid.Column="2" SelectedItem="{Binding HistoryAge}" MinWidth="120"
                              ItemsSource="{Binding HistoryAgeOptions}" />
                    <CheckBox Grid.Column="3" Content="Failures only" IsChecked="{Binding HistoryFailuresOnly}"
                              FontSize="{DynamicResource PbFontSizeControl}" VerticalAlignment="Center" />
                </Grid>

                <ScrollViewer Grid.Row="1">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding HistoryRows}" ItemTemplate="{StaticResource ActivityHistoryRowTemplate}" />
                        <TextBlock Text="No matching history." FontSize="{DynamicResource PbFontSizeControl}"
                                   Foreground="{DynamicResource PbTextFaintBrush}" Margin="14,24" HorizontalAlignment="Center"
                                   IsVisible="{Binding HistoryIsEmpty}" />
                    </StackPanel>
                </ScrollViewer>

                <Button Grid.Row="2" Classes="activityLink" Content="Load more" Margin="14,8"
                        HorizontalAlignment="Center" Command="{Binding LoadMoreHistoryCommand}"
                        IsVisible="{Binding HistoryHasMore}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
