<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pbc="using:Paperbunkr.App.Controls"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:models="using:Paperbunkr.App.Models"
             xmlns:views="using:Paperbunkr.App.Views"
             xmlns:entities="using:Paperbunkr.Data.Entities"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="500"
             x:Class="Paperbunkr.App.Views.DetailTabs"
             x:DataType="vm:DetailTabsViewModel"
             x:Name="Root"
             pbc:ContextMenuHost.Provider="{Binding}">

    <UserControl.Styles>
        <Style Selector="Border.issueTile">
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusSm}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.issueTile.selected">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
        </Style>
        <Style Selector="Border.issueTile:focus-visible">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
        </Style>
        <Style Selector="Border.issueTile.current">
            <Setter Property="BoxShadow" Value="{StaticResource PbGlowRing}" />
        </Style>
        <Style Selector="StackPanel.posterItem.read">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <!-- Run separator bar (docs/superpowers/specs/2026-08-30-series-detail-run-separator-design.md) -
             same treatment as IssueListScreen.axaml's TextBlock.groupHeader. -->
        <Style Selector="TextBlock.runHeader">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
            <Setter Property="Margin" Value="0,4,0,10" />
        </Style>
        <Style Selector="Grid.issueRow">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Grid.issueRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource PbSurface3Brush}" />
        </Style>
        <Style Selector="Grid.issueRow.selected">
            <Setter Property="Background" Value="{DynamicResource PbAccentSoftBrush}" />
        </Style>
        <Style Selector="Grid.issueRow.read">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="Border.issueCard">
            <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusSm}" />
            <Setter Property="Padding" Value="9" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.issueCard.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
        </Style>

        <!-- View-mode segmented control -->
        <Style Selector="Button.segItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextFaintBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.segItem.active">
            <Setter Property="Background" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbBadgeTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.railAdd">
            <Setter Property="Background" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbBadgeTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <!-- Shared IssueCardSample tile templates (docs/superpowers/specs/2026-08-28-series-detail-
             specials-tab-design.md) - the Issues tab's run groups and the flat Specials tab both
             render the same tiles, just from different source collections. -->
        <DataTemplate x:Key="IssuePosterTileTemplate" x:DataType="models:IssueCardSample">
            <StackPanel Classes="posterItem" Classes.read="{Binding IsRead}" Width="118" Margin="0,0,14,16" Spacing="5">
                <Border Classes="issueTile" Classes.selected="{Binding IsSelected}" Height="168"
                        Background="{Binding CoverBrush}" Focusable="True"
                        PointerPressed="OnIssueTilePointerPressed" KeyDown="OnIssueTileKeyDown">
                    <Grid>
                        <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                        <Border Classes="posterScrim" />
                        <Border Height="3" VerticalAlignment="Bottom" Background="{DynamicResource PbAccentBrush}"
                                IsVisible="{Binding IsInProgress}" HorizontalAlignment="Left" Width="70" />
                    </Grid>
                </Border>
                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PbTextBrush}" />
                <TextBlock Text="{Binding ArcTitle}" FontSize="10" Foreground="{DynamicResource PbTextFaintBrush}"
                           TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding ArcTitle, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="IssueListRowTemplate" x:DataType="models:IssueCardSample">
            <Grid Classes="issueRow" Classes.selected="{Binding IsSelected}" Classes.read="{Binding IsRead}"
                  ColumnDefinitions="44,*,150,80,50" Height="30" Focusable="True"
                  ContextMenu="{StaticResource IssueContextMenu}"
                  PointerPressed="OnIssueTilePointerPressed" KeyDown="OnIssueTileKeyDown">
                <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{DynamicResource PbTextBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding FullTitle}" VerticalAlignment="Center" Margin="8,0"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource PbTextMutedBrush}" FontSize="12" />
                <TextBlock Grid.Column="2" Text="{Binding ArcTitle}" VerticalAlignment="Center"
                           Foreground="{DynamicResource PbTextFaintBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Text="{Binding CoverDateLabel}" VerticalAlignment="Center"
                           Foreground="{DynamicResource PbTextFaintBrush}" FontSize="11" />
                <TextBlock Grid.Column="4" Text="{Binding RatingLabel}" VerticalAlignment="Center"
                           Foreground="{DynamicResource PbBadgeBrush}" FontSize="11" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="IssueCardTileTemplate" x:DataType="models:IssueCardSample">
            <Border Classes="issueCard" Classes.selected="{Binding IsSelected}" Width="250" Margin="0,0,12,12"
                    Focusable="True" ContextMenu="{StaticResource IssueContextMenu}"
                    PointerPressed="OnIssueTilePointerPressed" KeyDown="OnIssueTileKeyDown">
                <Grid ColumnDefinitions="54,*">
                    <Border Grid.Column="0" Width="54" Height="80" CornerRadius="3" ClipToBounds="True"
                            Background="{Binding CoverBrush}" VerticalAlignment="Top">
                        <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="4">
                        <TextBlock Text="{Binding FullTitle}" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PbTextBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding CardProgressLabel}" FontSize="9.5" Foreground="{DynamicResource PbTextFaintBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="{Binding CardActionLabel}" Padding="10,2" FontSize="11" FontWeight="SemiBold"
                                    CornerRadius="4" Background="{DynamicResource PbAccentBrush}" Foreground="{DynamicResource PbBadgeTextBrush}"
                                    BorderThickness="0"
                                    Command="{Binding #Root.((vm:DetailTabsViewModel)DataContext).OpenIssueInReaderCommand}"
                                    CommandParameter="{Binding}" />
                            <Button Classes="creditName"
                                    Command="{Binding #Root.((vm:DetailTabsViewModel)DataContext).MarkIssueReadCommand}"
                                    CommandParameter="{Binding}" ToolTip.Tip="Mark read">
                                <fi:SymbolIcon Symbol="Checkmark" FontSize="13" />
                            </Button>
                            <Button Classes="creditName"
                                    Command="{Binding #Root.((vm:DetailTabsViewModel)DataContext).EditIssuePropertiesCommand}"
                                    CommandParameter="{Binding}" ToolTip.Tip="Edit">
                                <fi:SymbolIcon Symbol="Edit" FontSize="13" />
                            </Button>
                            <Button Classes="creditName"
                                    Command="{Binding #Root.((vm:DetailTabsViewModel)DataContext).RevealIssueCommand}"
                                    CommandParameter="{Binding}" IsEnabled="{Binding HasFile}" ToolTip.Tip="Show in Explorer">
                                <fi:SymbolIcon Symbol="FolderOpen" FontSize="13" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,0,0,1" Margin="0,24,0,0" IsVisible="{Binding ShowTabStrip}">
            <StackPanel Orientation="Horizontal" Spacing="22">
                <Button Classes="tab" Classes.active="{Binding IsIssuesTab}" Command="{Binding GoIssuesCommand}" IsVisible="{Binding ShowIssuesTab}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="Issues" />
                        <TextBlock Classes="tabCount" Text="{Binding Issues.Count}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="tab" Classes.active="{Binding IsSpecialsTab}" Command="{Binding GoSpecialsCommand}" IsVisible="{Binding HasSpecials}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="Specials" />
                        <TextBlock Classes="tabCount" Text="{Binding Specials.Count}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="tab" Classes.active="{Binding IsRelatedTab}" Command="{Binding GoRelatedCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="Related" />
                        <TextBlock Classes="tabCount" Text="{Binding Related.Count}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="tab" Classes.active="{Binding IsDetailsTab}" Command="{Binding GoDetailsCommand}" Content="Details" />
                <Button Classes="tab" Classes.active="{Binding IsActivityTab}" Command="{Binding GoActivityCommand}" Content="Activity" />
            </StackPanel>
        </Border>

        <!-- ================= ISSUES TAB ================= -->
        <StackPanel IsVisible="{Binding IsIssuesTab}" Margin="0,16,0,0">
            <!-- chrome: view-mode segment -->
            <DockPanel Margin="0,0,0,14">
                <Border DockPanel.Dock="Right" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1"
                        CornerRadius="6" ClipToBounds="True" Height="24">
                    <StackPanel Orientation="Horizontal">
                        <Button Classes="segItem" Classes.active="{Binding IsPosterView}" Content="Poster"
                                Command="{Binding SetIssueViewModeCommand}" CommandParameter="{x:Static entities:DetailIssueViewMode.Poster}" />
                        <Border Width="1" Background="{DynamicResource PbBorderBrush}" />
                        <Button Classes="segItem" Classes.active="{Binding IsListView}" Content="List"
                                Command="{Binding SetIssueViewModeCommand}" CommandParameter="{x:Static entities:DetailIssueViewMode.List}" />
                        <Border Width="1" Background="{DynamicResource PbBorderBrush}" />
                        <Button Classes="segItem" Classes.active="{Binding IsCardView}" Content="Card"
                                Command="{Binding SetIssueViewModeCommand}" CommandParameter="{x:Static entities:DetailIssueViewMode.Card}" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding Issues.Count, StringFormat='{}{0} issues'}" Classes="pbTextCaption" VerticalAlignment="Center" />
            </DockPanel>

            <!-- POSTER -->
            <ItemsControl x:Name="IssuesList" IsVisible="{Binding IsPosterView}" ItemsSource="{Binding IssueGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:IssueRunGroup">
                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Text="{Binding Header}" Classes="runHeader"
                                       IsVisible="{Binding Header, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource IssuePosterTileTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- LIST -->
            <ItemsControl IsVisible="{Binding IsListView}" ItemsSource="{Binding IssueGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:IssueRunGroup">
                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Text="{Binding Header}" Classes="runHeader"
                                       IsVisible="{Binding Header, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource IssueListRowTemplate}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- CARD -->
            <ItemsControl IsVisible="{Binding IsCardView}" ItemsSource="{Binding IssueGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:IssueRunGroup">
                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Text="{Binding Header}" Classes="runHeader"
                                       IsVisible="{Binding Header, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource IssueCardTileTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- ================= SPECIALS TAB ================= -->
        <!-- One-shots/annuals/omnibuses etc. (docs/superpowers/specs/2026-08-28-series-detail-
             specials-tab-design.md) - flat, no run grouping (a handful of specials doesn't need a
             separator), sharing the Issues tab's own view-mode toggle rather than growing a second
             one. Same tile templates as the Issues tab, bound to Specials instead of IssueGroups. -->
        <StackPanel IsVisible="{Binding IsSpecialsTab}" Margin="0,16,0,0">
            <TextBlock Text="{Binding Specials.Count, StringFormat='{}{0} specials'}" Classes="pbTextCaption" Margin="0,0,0,14" />

            <ItemsControl IsVisible="{Binding IsPosterView}" ItemsSource="{Binding Specials}" ItemTemplate="{StaticResource IssuePosterTileTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <ItemsControl IsVisible="{Binding IsListView}" ItemsSource="{Binding Specials}" ItemTemplate="{StaticResource IssueListRowTemplate}" />

            <ItemsControl IsVisible="{Binding IsCardView}" ItemsSource="{Binding Specials}" ItemTemplate="{StaticResource IssueCardTileTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>

        <!-- ================= RELATED TAB ================= -->
        <StackPanel IsVisible="{Binding IsRelatedTab}" Margin="0,20,0,0" Spacing="4">

            <!-- Continuity membership -->
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
                <TextBlock Text="Continuities" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                <Button Classes="railAdd" Content="+ Add to Continuity" Command="{Binding ToggleAddContinuityCommand}" />
            </StackPanel>
            <Border IsVisible="{Binding IsAddingContinuity}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="12" Margin="0,0,0,8">
                <StackPanel Spacing="8">
                    <TextBox Text="{Binding ContinuitySearchQuery}" Watermark="Search or create a continuity…" FontSize="12" />
                    <ItemsControl ItemsSource="{Binding ContinuitySearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ContinuitySearchResult">
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6" Margin="0,2"
                                        Background="Transparent" BorderThickness="0" FontSize="12.5"
                                        Foreground="{DynamicResource PbTextMutedBrush}"
                                        Command="{Binding #Root.((vm:DetailTabsViewModel)DataContext).AddContinuityCommand}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding Name}" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding ContinuityChips}" Margin="0,0,0,12">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ContinuityChip">
                        <Border Background="{DynamicResource PbSurfaceAltBrush}" CornerRadius="{DynamicResource PbRadius}" Padding="10,4" Margin="0,0,6,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Name}" FontSize="11.5" Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                                <Button Content="✕" Padding="0" Width="16" Height="16" FontSize="9.5" CornerRadius="8"
                                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PbTextFaintBrush}"
                                        Command="{Binding #Root.((vm:DetailTabsViewModel)DataContext).RemoveContinuityCommand}"
                                        CommandParameter="{Binding}" ToolTip.Tip="Remove from this continuity" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Collection membership (docs/superpowers/specs/2026-08-27-collections-design.md,
                 step 10) - byte-for-byte the Continuity block above. -->
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
                <TextBlock Text="Collections" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                <Button Classes="railAdd" Content="+ Add to Collection" Command="{Binding ToggleAddCollectionCommand}" />
            </StackPanel>
            <Border IsVisible="{Binding IsAddingCollection}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="12" Margin="0,0,0,8">
                <StackPanel Spacing="8">
                    <TextBox Text="{Binding CollectionSearchQuery}" Watermark="Search or create a collection…" FontSize="12" />
                    <ItemsControl ItemsSource="{Binding CollectionSearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:CollectionSearchResult">
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6" Margin="0,2"
                                        Background="Transparent" BorderThickness="0" FontSize="12.5"
                                        Foreground="{DynamicResource PbTextMutedBrush}"
                                        Command="{Binding #Root.((vm:DetailTabsViewModel)DataContext).AddCollectionCommand}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding Name}" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding CollectionChips}" Margin="0,0,0,12">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:CollectionChip">
                        <Border Background="{DynamicResource PbSurfaceAltBrush}" CornerRadius="{DynamicResource PbRadius}" Padding="10,4" Margin="0,0,6,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Name}" FontSize="11.5" Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                                <Button Content="✕" Padding="0" Width="16" Height="16" FontSize="9.5" CornerRadius="8"
                                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PbTextFaintBrush}"
                                        Command="{Binding #Root.((vm:DetailTabsViewModel)DataContext).RemoveCollectionCommand}"
                                        CommandParameter="{Binding}" ToolTip.Tip="Remove from this collection" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Add-related-series expander -->
            <Border IsVisible="{Binding IsAddingRelation}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="12" Margin="0,0,0,10">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Relationship:" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource PbTextMutedBrush}" />
                        <ComboBox ItemsSource="{Binding RelationTypeOptions}" SelectedItem="{Binding SelectedRelationTypeOption}" MinWidth="160" FontSize="12">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:RelationTypeOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <TextBox Text="{Binding RelationSearchQuery}" Watermark="Search for a series or collection…" FontSize="12" />
                    <ItemsControl ItemsSource="{Binding RelationSearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:RelationSearchResult">
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6" Margin="0,2"
                                        Background="Transparent" BorderThickness="0" FontSize="12.5"
                                        Foreground="{DynamicResource PbTextMutedBrush}"
                                        Command="{Binding #Root.((vm:DetailTabsViewModel)DataContext).AddRelationCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Text="{Binding Kind}" FontSize="10.5" Foreground="{DynamicResource PbTextFaintBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock IsVisible="{Binding !HasAnyRelatedRail}" Text="No related series yet." FontSize="12.5"
                       Foreground="{DynamicResource PbTextFaintBrush}" Margin="0,6,0,10" />

            <views:PosterRail Title="Related" ContextLabel="{Binding Related.Count, StringFormat='{}{0} · manage'}"
                              ItemsSource="{Binding RelatedRail}" ShowAddCard="True"
                              AddCommand="{Binding ToggleAddRelationCommand}"
                              RemoveCommand="{Binding RemoveRelationCommand}"
                              ClickCommand="{Binding OpenRelatedSeriesCommand}" />

            <views:PosterRail Title="Same Continuity" ItemsSource="{Binding ContinuityRail}"
                              IsVisible="{Binding HasSameContinuity}"
                              ClickCommand="{Binding OpenRelatedSeriesCommand}" />

            <views:PosterRail Title="Same Collection" ItemsSource="{Binding CollectionRail}"
                              IsVisible="{Binding HasSameCollection}"
                              ClickCommand="{Binding OpenRelatedSeriesCommand}" />

            <views:PosterRail Title="Same Event" ItemsSource="{Binding EventRail}"
                              IsVisible="{Binding HasSameEvent}"
                              ClickCommand="{Binding OpenRelatedSeriesCommand}" />

            <views:PosterRail Title="More Like This" ContextLabel="from your library"
                              ItemsSource="{Binding MoreLikeThisRail}" IsVisible="{Binding HasMoreLikeThis}"
                              ClickCommand="{Binding OpenRelatedSeriesCommand}" />
        </StackPanel>

        <!-- ================= DETAILS TAB ================= -->
        <Grid IsVisible="{Binding IsDetailsTab}" ColumnDefinitions="*,*" Margin="0,20,0,0">
            <StackPanel Grid.Column="0" Margin="0,0,28,0">
                <TextBlock Text="PUBLISHER" FontSize="10.5" Foreground="{DynamicResource PbTextFaintBrush}" Margin="0,0,0,4" />
                <pbc:BrandMark Family="Publisher" Value="{Binding Publisher}" ShowText="True" MarkSize="16"
                               HorizontalAlignment="Left" Foreground="{DynamicResource PbTextBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="READING MODE" FontSize="10.5" Foreground="{DynamicResource PbTextFaintBrush}" Margin="0,0,0,4" />
                <Button Command="{Binding ToggleReadingModeCommand}" Content="{Binding ReadingModeLabel}"
                        Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                        HorizontalAlignment="Left" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
            </StackPanel>
        </Grid>

        <StackPanel IsVisible="{Binding IsDetailsTab}" Margin="0,24,0,0" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="External Metadata" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                <Button Classes="railAdd" Content="+ Link External Metadata" Command="{Binding ToggleSearchMetadataCommand}" />
            </StackPanel>

            <Border IsVisible="{Binding IsSearchingMetadata}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="12">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox ItemsSource="{x:Static vm:DetailTabsViewModel.MetadataProviderOptions}"
                                  SelectedItem="{Binding SelectedMetadataProvider}" Width="130" FontSize="12" />
                        <TextBox Text="{Binding MetadataSearchQuery}" Watermark="Search…" FontSize="12" Width="220" />
                        <Button Content="Search" Command="{Binding SearchMetadataCommand}" Padding="10,5" FontSize="12" CornerRadius="5" />
                    </StackPanel>
                    <TextBlock IsVisible="{Binding IsMetadataSearchInProgress}" Text="Searching…" FontSize="12" Foreground="{DynamicResource PbTextFaintBrush}" />
                    <TextBlock IsVisible="{Binding MetadataSearchError, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                               Text="{Binding MetadataSearchError}" FontSize="12" Foreground="{DynamicResource PbTextFaintBrush}" />
                    <ItemsControl ItemsSource="{Binding MetadataSearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:AniListMatchSample">
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3">
                                    <Border Grid.Column="0" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center"
                                            Classes.auto="{Binding TierClass, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=auto}"
                                            Classes.review="{Binding TierClass, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=review}"
                                            Classes.reject="{Binding TierClass, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=reject}">
                                        <Border.Styles>
                                            <Style Selector="Border.auto"><Setter Property="Background" Value="#2E7D32" /></Style>
                                            <Style Selector="Border.review"><Setter Property="Background" Value="#8A6D1D" /></Style>
                                            <Style Selector="Border.reject"><Setter Property="Background" Value="{DynamicResource PbSurfaceAltBrush}" /></Style>
                                        </Border.Styles>
                                        <TextBlock Text="{Binding TierLabel}" FontSize="10" Foreground="White" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" Foreground="{DynamicResource PbTextMutedBrush}" />
                                        <TextBlock Text="{Binding ConfidencePercent, StringFormat='{}{0}% match'}" FontSize="10.5" Foreground="{DynamicResource PbTextFaintBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Link" Padding="10,4" FontSize="11.5" CornerRadius="5"
                                            Background="{DynamicResource PbAccentBrush}" Foreground="{DynamicResource PbBadgeTextBrush}" BorderThickness="0"
                                            Command="{Binding #Root.((vm:DetailTabsViewModel)DataContext).LinkMetadataCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock IsVisible="{Binding !HasExternalLinks}" Text="Not linked to any external metadata source yet." FontSize="12.5"
                       Foreground="{DynamicResource PbTextFaintBrush}" />
            <ItemsControl ItemsSource="{Binding ExternalLinks}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ExternalLinkSample">
                        <Border Background="{DynamicResource PbSurfaceAltBrush}" CornerRadius="{DynamicResource PbRadius}" Padding="10,4" Margin="0,0,6,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding ProviderLabel}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                                <Button Content="✕" Padding="0" Width="16" Height="16" FontSize="9.5" CornerRadius="8"
                                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PbTextFaintBrush}"
                                        Command="{Binding #Root.((vm:DetailTabsViewModel)DataContext).UnlinkMetadataCommand}"
                                        CommandParameter="{Binding}" ToolTip.Tip="Remove this link" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsDetailsTab}" Margin="0,24,0,0" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Trackers" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                <Button Classes="railAdd" Content="+ Link for Tracking" Command="{Binding ToggleLinkTrackerCommand}" />
                <Button Content="Sync to Trackers" IsVisible="{Binding HasTrackerLinks}"
                        Command="{Binding SyncToTrackersCommand}" Padding="10,5" FontSize="12" CornerRadius="5"
                        Background="{DynamicResource PbSurfaceAltBrush}" Foreground="{DynamicResource PbTextMutedBrush}" BorderThickness="0" />
            </StackPanel>

            <Border IsVisible="{Binding IsLinkingTracker}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="12">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox ItemsSource="{x:Static vm:DetailTabsViewModel.TrackerServiceOptions}"
                                  SelectedItem="{Binding SelectedTrackerService}" Width="140" FontSize="12" />
                        <TextBox Text="{Binding TrackerSearchQuery}" Watermark="Search title…" FontSize="12" Width="220" />
                        <Button Content="Search" Command="{Binding SearchTrackerCommand}" Padding="10,5" FontSize="12" CornerRadius="5" />
                    </StackPanel>
                    <TextBlock IsVisible="{Binding IsTrackerSearchInProgress}" Text="Searching…" FontSize="12" Foreground="{DynamicResource PbTextFaintBrush}" />
                    <TextBlock IsVisible="{Binding TrackerSearchError, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                               Text="{Binding TrackerSearchError}" FontSize="12" Foreground="{DynamicResource PbTextFaintBrush}" />
                    <ItemsControl ItemsSource="{Binding TrackerSearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:TrackerMatchSample">
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3">
                                    <Border Grid.Column="0" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center"
                                            Classes.auto="{Binding TierClass, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=auto}"
                                            Classes.review="{Binding TierClass, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=review}"
                                            Classes.reject="{Binding TierClass, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=reject}">
                                        <Border.Styles>
                                            <Style Selector="Border.auto"><Setter Property="Background" Value="#2E7D32" /></Style>
                                            <Style Selector="Border.review"><Setter Property="Background" Value="#8A6D1D" /></Style>
                                            <Style Selector="Border.reject"><Setter Property="Background" Value="{DynamicResource PbSurfaceAltBrush}" /></Style>
                                        </Border.Styles>
                                        <TextBlock Text="{Binding TierLabel}" FontSize="10" Foreground="White" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" Foreground="{DynamicResource PbTextMutedBrush}" />
                                        <TextBlock Text="{Binding ConfidencePercent, StringFormat='{}{0}% match'}" FontSize="10.5" Foreground="{DynamicResource PbTextFaintBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="{Binding LinkConfirm.Label}" Padding="10,4" FontSize="11.5" CornerRadius="5"
                                            Background="{DynamicResource PbAccentBrush}" Foreground="{DynamicResource PbBadgeTextBrush}" BorderThickness="0"
                                            Command="{Binding LinkConfirm.TriggerCommand}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock IsVisible="{Binding TrackerSyncStatus, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                       Text="{Binding TrackerSyncStatus}" FontSize="12" Foreground="{DynamicResource PbTextFaintBrush}" />
            <TextBlock IsVisible="{Binding !HasTrackerLinks}" Text="Not linked to any tracker yet." FontSize="12.5"
                       Foreground="{DynamicResource PbTextFaintBrush}" />
            <ItemsControl ItemsSource="{Binding TrackerLinks}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:TrackerLinkSample">
                        <Border Background="{DynamicResource PbSurfaceAltBrush}" CornerRadius="{DynamicResource PbRadius}" Padding="10,4" Margin="0,0,6,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Service}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                                <Button Content="✕" Padding="0" Width="16" Height="16" FontSize="9.5" CornerRadius="8"
                                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PbTextFaintBrush}"
                                        Command="{Binding #Root.((vm:DetailTabsViewModel)DataContext).UnlinkTrackerCommand}"
                                        CommandParameter="{Binding}" ToolTip.Tip="Remove this tracker link" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- ================= ACTIVITY TAB ================= -->
        <StackPanel IsVisible="{Binding IsActivityTab}" Margin="0,20,0,0" Spacing="4">
            <TextBlock Text="No recent activity." FontSize="12.5" Foreground="{DynamicResource PbTextFaintBrush}" />
        </StackPanel>
    </StackPanel>
</UserControl>
