<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:controls="using:Paperbunkr.App.Controls"
             xmlns:entities="using:Paperbunkr.Data.Entities"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:pref="using:Paperbunkr.App.Views.Preferences"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="900"
             x:Class="Paperbunkr.App.Views.Preferences.ReaderSection"
             x:DataType="vm:PreferencesScreenViewModel">

    <ScrollViewer>
        <StackPanel Margin="28,20,28,40" Spacing="20">
            <TextBlock Classes="pbTextHeading" Text="Reader" />

        <StackPanel Tag="reader.rtl">
            <TextBlock Classes="settingsGroupCaption" Text="RIGHT TO LEFT" />
            <pref:SettingsRow Icon="ArrowLeft" Title="Reverse left/right page-turn direction for right-to-left books">
                <pref:SettingsRow.SettingsContent>
                    <ToggleSwitch IsChecked="{Binding ReverseRtlNavigation}" OnContent="{x:Null}" OffContent="{x:Null}" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
        </StackPanel>

        <StackPanel Tag="reader.display">
            <TextBlock Classes="settingsGroupCaption" Text="DISPLAY" />
            <pref:SettingsRow Icon="Image" Title="High quality page display"
                               Description="Smoother scaling, more CPU.">
                <pref:SettingsRow.SettingsContent>
                    <ToggleSwitch IsChecked="{Binding HighQualityPageDisplay}" OnContent="{x:Null}" OffContent="{x:Null}" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
            <pref:SettingsRow Icon="ArrowFit" Title="Default fit mode"
                               Description="Used for any book that hasn't been set to a different fit mode from the reader itself.">
                <pref:SettingsRow.SettingsContent>
                    <controls:SuggestBox IsStrict="True" Text="{Binding DefaultPageFitModeText}"
                                         Suggestions="{Binding FitModeNames}" Width="150" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
            <pref:SettingsRow Icon="ArrowRotateClockwise" Title="Auto-rotate landscape pages by default">
                <pref:SettingsRow.SettingsContent>
                    <ToggleSwitch IsChecked="{Binding DefaultAutoRotate}" OnContent="{x:Null}" OffContent="{x:Null}" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
            <pref:SettingsRow Icon="DualScreen" Title="Double-page spread"
                               Description="Used for any series that hasn't been set to a different double-page mode from the reader toolbar itself.">
                <pref:SettingsRow.SettingsContent>
                    <controls:SuggestBox IsStrict="True" Text="{Binding DefaultPageLayoutModeText}"
                                         Suggestions="{Binding PageLayoutModeNames}" Width="150" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
            <pref:SettingsRow Icon="SlideTransition" Title="Page transition"
                               Description="Animates turning the page (arrow keys, click-zones, flick, scrubber) - jumping to a page (e.g. a thumbnail click) is always instant.">
                <pref:SettingsRow.SettingsContent>
                    <controls:SuggestBox IsStrict="True" Text="{Binding PageTransitionStyleText}"
                                         Suggestions="{Binding PageTransitionStyleNames}" Width="150" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
            <pref:SettingsRow Icon="TopSpeed" Title="{Binding PageTransitionDurationMs, StringFormat='Page transition speed: {0}ms'}">
                <pref:SettingsRow.SettingsContent>
                    <Slider Minimum="100" Maximum="600" TickFrequency="50" IsSnapToTickEnabled="True"
                            Value="{Binding PageTransitionDurationMs}" Width="220" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
        </StackPanel>

        <StackPanel Tag="reader.zoomNav">
            <TextBlock Classes="settingsGroupCaption" Text="ZOOM &amp; NAVIGATION" />
            <pref:SettingsRow Icon="ZoomFit" Title="Reset zoom when turning the page">
                <pref:SettingsRow.SettingsContent>
                    <ToggleSwitch IsChecked="{Binding ResetZoomOnPageChange}" OnContent="{x:Null}" OffContent="{x:Null}" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
            <pref:SettingsRow Icon="ArrowSort" Title="{Binding MouseWheelSpeed, StringFormat='Mouse wheel scroll speed: {0:F1}'}">
                <pref:SettingsRow.SettingsContent>
                    <Slider Minimum="0.5" Maximum="5" Value="{Binding MouseWheelSpeed}" Width="220" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
        </StackPanel>

        <StackPanel Tag="reader.imageAdjust">
            <TextBlock Classes="settingsGroupCaption" Text="IMAGE ADJUSTMENT" />
            <TextBlock Text="Default brightness/contrast/saturation/gamma for every book - a book's own reader toolbar can adjust further from here."
                       FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
            <pref:SettingsRow Icon="BrightnessHigh" Title="{Binding DefaultBrightness, StringFormat='Brightness: {0:F0}'}">
                <pref:SettingsRow.SettingsContent>
                    <Slider Minimum="-100" Maximum="100" Value="{Binding DefaultBrightness}" Width="220" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
            <pref:SettingsRow Icon="Options" Title="{Binding DefaultContrast, StringFormat='Contrast: {0:F0}'}">
                <pref:SettingsRow.SettingsContent>
                    <Slider Minimum="-100" Maximum="100" Value="{Binding DefaultContrast}" Width="220" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
            <pref:SettingsRow Icon="ColorBackground" Title="{Binding DefaultSaturation, StringFormat='Saturation: {0:F0}'}">
                <pref:SettingsRow.SettingsContent>
                    <Slider Minimum="-100" Maximum="100" Value="{Binding DefaultSaturation}" Width="220" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
            <pref:SettingsRow Icon="Gauge" Title="{Binding DefaultGamma, StringFormat='Gamma: {0:F0}'}">
                <pref:SettingsRow.SettingsContent>
                    <Slider Minimum="-100" Maximum="100" Value="{Binding DefaultGamma}" Width="220" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
        </StackPanel>

        <StackPanel Tag="reader.background">
            <TextBlock Classes="settingsGroupCaption" Text="BACKGROUND &amp; MARGIN" />
            <pref:SettingsRow Icon="ColorBackground" Title="Canvas background"
                               Description="Auto keeps the app's own background; Color fills the canvas with the color below.">
                <pref:SettingsRow.SettingsContent>
                    <controls:SuggestBox IsStrict="True" Text="{Binding ImageBackgroundModeText}"
                                         Suggestions="{Binding BackgroundModeNames}" Width="150" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
            <!-- Compound content: two controls (presets + freeform hex) for one logical setting
                 (docs/superpowers/specs/2026-09-07-preferences-tile-hub-redesign-plan.md's own note
                 on this row) - SettingsContent holds both side by side. -->
            <pref:SettingsRow Icon="ColorBackground" Title="Background color"
                               IsVisible="{Binding ImageBackgroundMode, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:ImageBackgroundMode.Color}}">
                <pref:SettingsRow.SettingsContent>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:SuggestBox Text="{Binding BackgroundColor}"
                                             Suggestions="{Binding BackgroundColorPresetNames}" Width="130" Watermark="Presets" />
                        <TextBox Text="{Binding BackgroundColor}" Width="130" ToolTip.Tip="A named color (e.g. WhiteSmoke) or hex value (e.g. #F5F5F5)" />
                    </StackPanel>
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
            <pref:SettingsRow Icon="BorderAll" Title="Add a margin around the page">
                <pref:SettingsRow.SettingsContent>
                    <ToggleSwitch IsChecked="{Binding PageMarginEnabled}" OnContent="{x:Null}" OffContent="{x:Null}" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
            <pref:SettingsRow Icon="ArrowExpand" Title="{Binding PageMarginPercentWidth, StringFormat='Margin width: {0:P0}'}"
                               IsVisible="{Binding PageMarginEnabled}">
                <pref:SettingsRow.SettingsContent>
                    <Slider Minimum="0" Maximum="0.3" Value="{Binding PageMarginPercentWidth}" Width="220" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</UserControl>
