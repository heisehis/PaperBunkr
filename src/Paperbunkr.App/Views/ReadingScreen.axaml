<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:models="using:Paperbunkr.App.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="760"
             x:Class="Paperbunkr.App.Views.ReadingScreen"
             x:DataType="vm:ReadingScreenViewModel">

    <UserControl.Styles>
        <Style Selector="Button.headerAction">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.headerAction.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
        </Style>
        <Style Selector="Button.headerAction.secondary">
            <Setter Property="Background" Value="{DynamicResource PbChromeBrush}" />
            <Setter Property="BorderBrush" Value="#383D47" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
        </Style>

        <Style Selector="Border.statCard">
            <Setter Property="Background" Value="{DynamicResource PbChromeBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="MinWidth" Value="120" />
        </Style>
        <Style Selector="TextBlock.statNumber">
            <Setter Property="FontFamily" Value="Consolas,monospace" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.statLabel">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextFaintBrush}" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style Selector="Border.issueRow">
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="12,9" />
        </Style>

        <Style Selector="TextBox.searchBox">
            <Setter Property="Background" Value="{DynamicResource PbChromeBrush}" />
            <Setter Property="BorderBrush" Value="#383D47" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel>

            <Grid ColumnDefinitions="*,Auto" Margin="28,20,28,16">
                <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding ListName}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PbTextBrush}" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="{DynamicResource PbTextFaintBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                    <Button Classes="headerAction ghost" Content="Copy as Text" Command="{Binding CopyAsTextCommand}" />
                    <Button Classes="headerAction secondary" Content="Refresh" IsEnabled="False"
                            ToolTip.Tip="Requires an external story-arc source — deferred to a future pass" />
                </StackPanel>
            </Grid>
            <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,24" />

            <TextBlock Text="No reading lists yet — create one from the sidebar to get started." FontSize="13"
                       Foreground="{DynamicResource PbTextFaintBrush}" Margin="28,0,28,40" TextWrapping="Wrap"
                       IsVisible="{Binding HasNoReadingLists}" />

            <StackPanel MaxWidth="820" HorizontalAlignment="Left" Margin="28,0,28,40" IsVisible="{Binding !HasNoReadingLists}">

                <Border Background="{DynamicResource PbAccentSoftBrush}" CornerRadius="5" Padding="10,7" Margin="0,0,0,16"
                        IsVisible="{Binding HasStatusMessage}">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource PbTextBrush}" />
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,22">
                    <Border Classes="statCard">
                        <StackPanel><TextBlock Classes="statNumber" Text="{Binding TotalIssues}" Foreground="{DynamicResource PbTextBrush}" />
                            <TextBlock Classes="statLabel" Text="TOTAL ISSUES" /></StackPanel>
                    </Border>
                    <Border Classes="statCard">
                        <StackPanel><TextBlock Classes="statNumber" Text="{Binding OwnedIssues}" Foreground="{DynamicResource PbSuccessBrush}" />
                            <TextBlock Classes="statLabel" Text="OWNED" /></StackPanel>
                    </Border>
                    <Border Classes="statCard">
                        <StackPanel><TextBlock Classes="statNumber" Text="{Binding MissingIssues}" Foreground="{DynamicResource PbBadgeBrush}" />
                            <TextBlock Classes="statLabel" Text="MISSING" /></StackPanel>
                    </Border>
                </StackPanel>

                <WrapPanel Margin="0,0,0,20">
                    <Button Classes="headerAction secondary" Content="Import .CBL" Margin="0,0,8,8" Command="{Binding ImportCblCommand}" />
                    <Button Classes="headerAction secondary" Content="Import .CSV" Margin="0,0,8,8" Command="{Binding ImportCsvCommand}" />
                    <Button Classes="headerAction secondary" Content="Export .CBL" Margin="0,0,8,8" Command="{Binding ExportCblCommand}" />
                    <Button Classes="headerAction secondary" Content="Export as Text" Margin="0,0,8,8" Command="{Binding ExportAsTextCommand}" />
                    <Button Classes="headerAction secondary" Content="AniList" Margin="0,0,8,8" IsEnabled="False"
                            ToolTip.Tip="External tracker import — deferred to a future pass" />
                    <Button Classes="headerAction secondary" Content="MyAnimeList" Margin="0,0,8,8" IsEnabled="False"
                            ToolTip.Tip="External tracker import — deferred to a future pass" />
                    <Button Classes="headerAction secondary" Content="Auto-Build from Tracked Arc" Margin="0,0,8,8" IsEnabled="False"
                            ToolTip.Tip="External story-arc lookup — deferred to a future pass" />
                </WrapPanel>

                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                    <TextBox Grid.Column="0" Classes="searchBox" Watermark="Search your library by series or number…"
                              Text="{Binding SearchQuery}" />
                    <Button Grid.Column="1" Classes="headerAction secondary" Content="Search" Margin="8,0,0,0" Command="{Binding SearchCommand}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding SearchResults}" Margin="0,0,0,20">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:IssueSearchResult">
                            <Border Classes="issueRow" Background="{DynamicResource PbChromeBrush}" Margin="0,0,0,4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayLabel}" FontSize="13" Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Classes="headerAction secondary" Content="+ Add"
                                            Command="{Binding $parent[ItemsControl].((vm:ReadingScreenViewModel)DataContext).AddIssueCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ReadingListGroupViewModel">
                            <StackPanel Margin="0,0,0,22">
                                <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource PbTextFaintBrush}"
                                           Margin="2,0,0,8" IsVisible="{Binding HasLabel}" />
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ReadingListItemRowViewModel">
                                            <Border Classes="issueRow">
                                                <Grid ColumnDefinitions="30,30,*,Auto,Auto,Auto,Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding Number}" FontFamily="Consolas,monospace"
                                                               FontSize="11" Foreground="{DynamicResource PbTextFaintBrush}" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Width="30" Height="42" CornerRadius="3"
                                                            Background="#264A6B8A" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="13"
                                                               Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" Margin="12,0" />
                                                    <TextBlock Grid.Column="3" IsVisible="{Binding IsOwned}" Text="✓ Owned"
                                                               FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PbSuccessBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                    <TextBlock Grid.Column="3" IsVisible="{Binding IsMissing}" Text="⚠ Missing"
                                                               FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PbBadgeBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                    <Button Grid.Column="4" Classes="headerAction ghost" Content="↑" Command="{Binding MoveUpCommand}" />
                                                    <Button Grid.Column="5" Classes="headerAction ghost" Content="↓" Command="{Binding MoveDownCommand}" />
                                                    <Button Grid.Column="6" Classes="headerAction ghost" Content="✕" Command="{Binding RemoveCommand}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
