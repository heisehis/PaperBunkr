<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pbc="using:Paperbunkr.App.Controls"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:models="using:Paperbunkr.App.Models"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="900"
             x:Class="Paperbunkr.App.Views.Preferences.ConnectionsSection"
             x:DataType="vm:PreferencesScreenViewModel">

    <UserControl.Styles>
        <!-- Connections redesign (docs/superpowers/specs/2026-09-07-connections-redesign-design.md)
             §1 - a connected row gets a soft accent tint; the checkmark stays as the primary signal,
             this is additional weight, not a replacement. Unconnected rows stay neutral - "not
             connected yet" isn't a negative state worth dimming. -->
        <Style Selector="Button.sideItemButton.connConnected">
            <Setter Property="Background" Value="{DynamicResource PbAccentSoftBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource PbRadiusSm}" />
            <Setter Property="Margin" Value="6,1" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <!-- One row template shared by both provider lists (docs/superpowers/specs/2026-09-06-
             connections-tracker-dialog-redesign-design.md) - BrandMark, name, a checkmark when
             connected (nothing when not), whole row opens that provider's dialog. -->
        <DataTemplate x:Key="ProviderRowTemplate" x:DataType="models:ConnectionProviderRow">
            <Button Classes="sideItemButton" Classes.connConnected="{Binding IsConnected}" HorizontalAlignment="Stretch"
                    Command="{Binding #Root.((vm:PreferencesScreenViewModel)DataContext).OpenConnectionDialogCommand}"
                    CommandParameter="{Binding}">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,8">
                    <pbc:BrandMark Grid.Column="0" Family="Service" Value="{Binding DisplayName}" MarkSize="15" ShowText="True" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="✓" FontSize="14" FontWeight="Bold" Foreground="#4CAF50"
                               VerticalAlignment="Center" IsVisible="{Binding IsConnected}"
                               ToolTip.Tip="Connected" />
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <ScrollViewer>
            <StackPanel Margin="28,20,28,40" Spacing="20">
                <TextBlock Classes="pbTextHeading" Text="Connections" />

                <!-- Reading List Sources -->
                <Border Classes="groupBox" Tag="connections.metadataSources">
                    <StackPanel>
                        <Border Classes="groupHeader">
                            <TextBlock Text="Reading List Sources" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding SourceProviderRows}" ItemTemplate="{StaticResource ProviderRowTemplate}" Margin="6" />
                    </StackPanel>
                </Border>

                <!-- Trackers -->
                <Border Classes="groupBox" Tag="connections.trackers">
                    <StackPanel>
                        <Border Classes="groupHeader">
                            <TextBlock Text="Trackers" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding TrackerProviderRows}" ItemTemplate="{StaticResource ProviderRowTemplate}" Margin="6" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Connection dialog overlay - local to this section (PreferencesScreenViewModel already owns
             every field/command involved), matching MainWindow's IsIssuePropertiesOverlayOpen scrim
             weight without hoisting state to MainViewModel. Three IsVisible-gated panels keyed on
             SelectedConnectionProvider.Kind, per docs/superpowers/specs/2026-09-06-connections-
             tracker-dialog-redesign-design.md. Each panel is now one generic block bound to the
             row's own fields/command references instead of 3 DisplayName-gated copies (docs/
             superpowers/specs/2026-09-07-connections-redesign-design.md §2). -->
        <Border IsVisible="{Binding IsConnectionDialogOpen}" Background="#B0000000">
            <Border Background="{DynamicResource PbSurface1Brush}" BorderBrush="{DynamicResource PbBorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="24" Width="420" MaxHeight="560"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14" DataContext="{Binding SelectedConnectionProvider}" x:DataType="models:ConnectionProviderRow">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <pbc:BrandMark Grid.Column="0" Family="Service" Value="{Binding DisplayName}" MarkSize="18" ShowText="True" VerticalAlignment="Center" />

                        <!-- Status dot (docs/superpowers/specs/2026-09-07-connections-redesign-
                             design.md §2) - a live, always-current connected signal, independent of
                             whatever the shared status line last said. Nothing renders when not
                             connected - the row-level checkmark already covers that state. -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                    Margin="0,0,10,0" IsVisible="{Binding IsConnected}">
                            <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource PbSuccessBrush}" />
                            <TextBlock Text="Connected" FontSize="11.5" Foreground="{DynamicResource PbSuccessBrush}" />
                        </StackPanel>

                        <Button Grid.Column="2" Classes="headerAction ghost"
                                Command="{Binding #Root.((vm:PreferencesScreenViewModel)DataContext).CloseConnectionDialogCommand}"
                                ToolTip.Tip="Close" AutomationProperties.AutomationId="ConnectionDialogCloseButton">
                        </Button>
                    </Grid>

                    <TextBlock Text="{Binding HelpText}" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" TextWrapping="Wrap" />

                    <!-- OAuth shape: AniList, MyAnimeList, Shikimori -->
                    <StackPanel Spacing="10" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:ConnectionDialogKind.OAuth}}">
                        <TextBox Text="{Binding ClientId}" Watermark="Client ID" />
                        <TextBox Text="{Binding ClientSecret}" Watermark="Client Secret" PasswordChar="•" IsVisible="{Binding RequiresClientSecret}" />
                        <Button Classes="headerAction primary" Content="Open Authorization Page"
                                Command="{Binding ConnectCommand}" HorizontalAlignment="Left" />
                        <TextBox Text="{Binding PastedValue}" Watermark="{Binding PasteWatermark}" />
                        <Button Classes="headerAction" Content="Complete Connection"
                                Command="{Binding CompleteCommand}" HorizontalAlignment="Left" />
                        <Button Classes="headerAction ghost" Foreground="{DynamicResource PbDangerBrush}" BorderBrush="{DynamicResource PbDangerSoftBrush}"
                                HorizontalAlignment="Left" IsVisible="{Binding IsConnected}" Command="{Binding DisconnectCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <fi:SymbolIcon Symbol="PlugDisconnected" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbDangerBrush}" />
                                <TextBlock Text="Disconnect" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Token shape: Bangumi, MangaBaka, ComicVine -->
                    <StackPanel Spacing="10" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:ConnectionDialogKind.Token}}">
                        <TextBox Text="{Binding SecretValue}" Watermark="Personal Access Token / API Key" PasswordChar="•" />
                        <Button Classes="headerAction primary" Content="{Binding PrimaryActionLabel}"
                                Command="{Binding SaveCommand}" HorizontalAlignment="Left" />
                        <Button Classes="headerAction ghost" Foreground="{DynamicResource PbDangerBrush}" BorderBrush="{DynamicResource PbDangerSoftBrush}"
                                HorizontalAlignment="Left" IsVisible="{Binding IsConnected}" Command="{Binding DisconnectCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <fi:SymbolIcon Symbol="PlugDisconnected" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbDangerBrush}" />
                                <TextBlock Text="Disconnect" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Credential shape: Metron, MangaUpdates, Kitsu -->
                    <StackPanel Spacing="10" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:ConnectionDialogKind.Credential}}">
                        <TextBox Text="{Binding Username}" Watermark="Username" />
                        <TextBox Text="{Binding Password}" Watermark="Password" PasswordChar="•" />
                        <Button Classes="headerAction primary" Content="{Binding PrimaryActionLabel}"
                                Command="{Binding PrimaryCommand}" HorizontalAlignment="Left" />
                        <Button Classes="headerAction ghost" Foreground="{DynamicResource PbDangerBrush}" BorderBrush="{DynamicResource PbDangerSoftBrush}"
                                HorizontalAlignment="Left" IsVisible="{Binding IsConnected}" Command="{Binding DisconnectCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <fi:SymbolIcon Symbol="PlugDisconnected" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbDangerBrush}" />
                                <TextBlock Text="Disconnect" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock Text="{Binding #Root.((vm:PreferencesScreenViewModel)DataContext).ConnectionDialogStatus}" FontSize="12"
                               Foreground="{DynamicResource PbTextFaintBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
