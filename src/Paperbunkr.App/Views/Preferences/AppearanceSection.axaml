<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:beh="using:Paperbunkr.App.Behaviors"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:controls="using:Paperbunkr.App.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:models="using:Paperbunkr.App.Models"
             xmlns:pref="using:Paperbunkr.App.Views.Preferences"
             xmlns:homevm="using:Paperbunkr.App.ViewModels.Home"
             xmlns:homeviews="using:Paperbunkr.App.Views.Home"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="720"
             x:Class="Paperbunkr.App.Views.Preferences.AppearanceSection"
             x:DataType="vm:PreferencesScreenViewModel">

    <UserControl.Styles>
        <!-- Appearance redesign (docs/superpowers/specs/2026-10-12-connections-appearance-redesign-design.md). The active theme's mini-mockup
             card gets an accent border ring: the app's own current accent (not the previewed theme's), so the selection affordance always reads
             consistently whichever theme a card is showing. -->
        <Style Selector="Border.skinActive">
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <!-- Contrast badges in the inspector: green when the pair meets 4.5:1, amber when it does not. -->
        <Style Selector="Border.statusBadge > StackPanel > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PbSuccessBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Border.statusBadge.contrastLow > StackPanel > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PbBadgeBrush}" />
        </Style>

        <!-- A customize box holding something that is not a value yet (a half-typed colour). Nothing is applied until it is valid. -->
        <Style Selector="TextBox.invalid">
            <Setter Property="BorderBrush" Value="{DynamicResource PbDangerBrush}" />
        </Style>

        <!-- Live samples (glow tiers, density): the active one is outlined in the app accent. -->
        <Style Selector="Border.sampleBox">
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusSm}" />
            <Setter Property="Background" Value="{DynamicResource PbSurface1Brush}" />
        </Style>
        <Style Selector="Border.sampleBox.sampleActive">
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </UserControl.Styles>

    <!-- Three sub-tabs, same shape as Reader (docs/superpowers/specs/2026-09-26-preferences-reader-organize-tabs-design.md): title and tab strip
         stay put; each tab's panel scrolls on its own. A new setting goes in the matching captioned group; a new group gets a Tag + a PreferenceIndex
         entry naming its tab. -->
    <Grid RowDefinitions="Auto,Auto,*" Margin="28,20,0,0">
        <TextBlock Grid.Row="0" Classes="pbTextHeading" Text="Appearance" Margin="0,0,0,14" />
        <pref:SettingsTabStrip Grid.Row="1" Tabs="{Binding AppearanceTabs}" AutomationProperties.Name="Appearance tabs" />

        <Panel Grid.Row="2">

            <!-- THEME (docs/superpowers/specs/2026-11-09-theme-gallery-and-roster-design.md Q1-Q4): two panes that scroll on their own. Left, the gallery behind a
                 Dark / Light / Accessibility / Installed switch, four tiles a row, each drawn with the theme's own brushes. Right, a fixed rail: the active
                 theme's inspector, its variants, theme options and Auto switch, so they stay in view while browsing. -->
            <Grid IsVisible="{Binding AppearanceTabs.SelectedKey, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=theme}"
                  ColumnDefinitions="*,24,380" Margin="0,16,0,0">
                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Tag="appearance.skin" Margin="0,0,12,40" Spacing="12">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <Border Grid.Column="0" Classes="segGroup" HorizontalAlignment="Left">
                                <ItemsControl ItemsSource="{Binding ThemeGallerySegments}" AutomationProperties.Name="Theme groups"
                                              AutomationProperties.AutomationId="ThemeGallerySegments">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ThemeGallerySegment">
                                            <Button Classes="segItem" Classes.active="{Binding IsSelected}" Content="{Binding Label}"
                                                    Command="{Binding $parent[UserControl].((vm:PreferencesScreenViewModel)DataContext).SelectGallerySegmentCommand}" CommandParameter="{Binding Key}"
                                                    AutomationProperties.Name="{Binding AutomationName}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <Button Grid.Column="1" Classes="ghost" Content="Install…" Margin="0,0,8,0" VerticalAlignment="Center"
                                    Command="{Binding BrowseForSkinCommand}" AutomationProperties.AutomationId="InstallSkinButton" />
                            <Button Grid.Column="2" Classes="iconButton" Command="{Binding OpenSkinsFolderCommand}" VerticalAlignment="Center"
                                    AutomationProperties.Name="Open themes folder" ToolTip.Tip="Open themes folder"
                                    AutomationProperties.AutomationId="OpenSkinsFolderButton">
                                <fi:SymbolIcon Symbol="FolderOpen" FontSize="{StaticResource PbIconSizeXs}" />
                            </Button>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding HasInstallSkinError}">
                            <fi:SymbolIcon Symbol="Warning" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbDangerBrush}" />
                            <TextBlock Text="{Binding InstallSkinError}" Foreground="{DynamicResource PbDangerBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- What the installer found in the last package: each line names the place in the theme's files it is about. -->
                        <StackPanel IsVisible="{Binding HasInstallNotes}" Spacing="2">
                            <TextBlock Text="Notes about the installed theme" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PbTextMutedBrush}" />
                            <ItemsControl ItemsSource="{Binding InstallNotes}" AutomationProperties.AutomationId="ThemeInstallNotes">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource PbTextMutedBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- 4 px in from the left and top so the first tiles' focus ring is not cut by the pane's scroll viewport. -->
                        <ItemsControl ItemsSource="{Binding VisibleThemes}" Margin="4,4,0,0" controls:Replace.On="{Binding SelectedGallerySegment}"
                                      AutomationProperties.AutomationId="ThemeGallery">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ThemeSummary">
                                    <Button Classes="clickCard" Classes.active="{Binding IsActive}" Margin="0,0,12,12"
                                            Command="{Binding $parent[UserControl].((vm:PreferencesScreenViewModel)DataContext).SelectThemeCommand}" CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding Name}">
                                        <pref:ThemeGalleryTile />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,28,40" Spacing="16">
                    <Border Background="{DynamicResource PbSurface1Brush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource PbRadius}" Padding="16"
                            DataContext="{Binding ActiveThemeSummary}" x:DataType="models:ThemeSummary" IsVisible="{Binding ., Converter={x:Static ObjectConverters.IsNotNull}}"
                            AutomationProperties.Name="Active theme inspector">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="1">
                                <TextBlock Classes="pbTextTitle" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="pbTextMeta" Text="{Binding Subtitle}" Foreground="{DynamicResource PbTextMutedBrush}" />
                            </StackPanel>

                            <!-- One large active-theme folio at a time. Samples use the selected theme's real brushes. -->
                            <Border Classes="segGroup" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Classes="segItem" Classes.active="{Binding $parent[UserControl].((vm:PreferencesScreenViewModel)DataContext).ShowLibraryThemePreview}" Content="Library"
                                            Command="{Binding $parent[UserControl].((vm:PreferencesScreenViewModel)DataContext).SelectThemePreviewTabCommand}" CommandParameter="Library" AutomationProperties.Name="Preview Library theme" />
                                    <Button Classes="segItem" Classes.active="{Binding $parent[UserControl].((vm:PreferencesScreenViewModel)DataContext).ShowReaderThemePreview}" Content="Reader"
                                            Command="{Binding $parent[UserControl].((vm:PreferencesScreenViewModel)DataContext).SelectThemePreviewTabCommand}" CommandParameter="Reader" AutomationProperties.Name="Preview Reader theme" />
                                    <Button Classes="segItem" Classes.active="{Binding $parent[UserControl].((vm:PreferencesScreenViewModel)DataContext).ShowBookshelfThemePreview}" Content="Bookshelf"
                                            Command="{Binding $parent[UserControl].((vm:PreferencesScreenViewModel)DataContext).SelectThemePreviewTabCommand}" CommandParameter="Bookshelf" AutomationProperties.Name="Preview Bookshelf theme" />
                                </StackPanel>
                            </Border>
                            <Border Height="174" CornerRadius="{DynamicResource PbRadiusSm}" Background="{Binding BackgroundBrush}"
                                    BorderBrush="{Binding BorderBrush}" BorderThickness="1" ClipToBounds="True">
                                <Panel>
                                    <Grid IsVisible="{Binding $parent[UserControl].((vm:PreferencesScreenViewModel)DataContext).ShowLibraryThemePreview}" Margin="14" RowDefinitions="Auto,*">
                                        <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,0,0,12">
                                            <Ellipse Width="7" Height="7" Fill="{Binding AccentBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="MY LIBRARY" FontSize="11" FontWeight="Bold" Foreground="{Binding TextBrush}" />
                                            <TextBlock Text="· 128 books" FontSize="10" Foreground="{Binding TextMutedBrush}" />
                                        </StackPanel>
                                        <WrapPanel Grid.Row="1" Orientation="Horizontal">
                                            <Border Width="60" Height="94" Margin="0,0,10,0" Padding="4" Background="{Binding SurfaceBrush}" BorderBrush="{Binding AccentBrush}" BorderThickness="2" CornerRadius="{DynamicResource PbRadiusSm}">
                                                <Border Background="{Binding AccentBrush}" CornerRadius="2" />
                                            </Border>
                                            <Border Width="60" Height="94" Margin="0,0,10,0" Padding="4" Background="{Binding SurfaceBrush}" BorderBrush="{Binding BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource PbRadiusSm}">
                                                <Border Background="{Binding ChartBlueBrush}" CornerRadius="2" />
                                            </Border>
                                            <StackPanel Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="Collector’s index" FontSize="12" FontWeight="SemiBold" Foreground="{Binding TextBrush}" />
                                                <Border Height="5" Width="120" HorizontalAlignment="Left" Background="{Binding SurfaceBrush}" CornerRadius="{DynamicResource PbRadiusSm}">
                                                    <Border Width="76" HorizontalAlignment="Left" Background="{Binding AccentBrush}" CornerRadius="{DynamicResource PbRadiusSm}" />
                                                </Border>
                                            </StackPanel>
                                        </WrapPanel>
                                    </Grid>
                                    <Grid IsVisible="{Binding $parent[UserControl].((vm:PreferencesScreenViewModel)DataContext).ShowReaderThemePreview}" Margin="14" ColumnDefinitions="*,Auto">
                                        <StackPanel VerticalAlignment="Center" Spacing="8">
                                            <TextBlock Text="READER" FontSize="11" FontWeight="Bold" Foreground="{Binding TextMutedBrush}" />
                                            <TextBlock Text="A chapter waits\nbetween the covers." FontFamily="Georgia" FontSize="15" TextWrapping="Wrap" Foreground="{Binding TextBrush}" />
                                            <Border Height="2" Width="72" HorizontalAlignment="Left" Background="{Binding AccentBrush}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Width="92" Height="132" Margin="10,0,14,0" Background="{Binding SurfaceBrush}" BorderBrush="{Binding AccentBrush}" BorderThickness="2" CornerRadius="{DynamicResource PbRadiusSm}" BoxShadow="{DynamicResource PbElevationShadow}">
                                            <Border Margin="8" BorderBrush="{Binding BorderBrush}" BorderThickness="1" />
                                        </Border>
                                    </Grid>
                                    <Grid IsVisible="{Binding $parent[UserControl].((vm:PreferencesScreenViewModel)DataContext).ShowBookshelfThemePreview}" Margin="14" RowDefinitions="Auto,*">
                                        <TextBlock Text="BOOKSHELF" FontSize="11" FontWeight="Bold" Foreground="{Binding TextBrush}" />
                                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="8">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                <Border Width="42" Height="48" Background="{Binding AccentBrush}" CornerRadius="{DynamicResource PbRadiusSm}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                    <TextBlock Text="Favorites" FontSize="12" FontWeight="SemiBold" Foreground="{Binding TextBrush}" />
                                                    <TextBlock Text="24 books · 68% read" FontSize="10" Foreground="{Binding TextMutedBrush}" />
                                                </StackPanel>
                                            </Grid>
                                            <Border Height="1" Background="{Binding BorderBrush}" />
                                            <ProgressBar Minimum="0" Maximum="100" Value="68" Height="5" />
                                        </StackPanel>
                                    </Grid>
                                </Panel>
                            </Border>

                            <!-- Palette -->
                            <StackPanel Orientation="Horizontal" Spacing="6" AutomationProperties.Name="Palette">
                                <Border Width="24" Height="24" CornerRadius="{DynamicResource PbRadiusSm}" Background="{Binding BackgroundBrush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1" ToolTip.Tip="Background" />
                                <Border Width="24" Height="24" CornerRadius="{DynamicResource PbRadiusSm}" Background="{Binding ChromeBrush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1" ToolTip.Tip="Chrome" />
                                <Border Width="24" Height="24" CornerRadius="{DynamicResource PbRadiusSm}" Background="{Binding TextBrush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1" ToolTip.Tip="Text" />
                                <Border Width="24" Height="24" CornerRadius="{DynamicResource PbRadiusSm}" Background="{Binding AccentBrush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1" ToolTip.Tip="Accent" />
                                <Border Width="24" Height="24" CornerRadius="{DynamicResource PbRadiusSm}" Background="{Binding BadgeBrush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1" ToolTip.Tip="Badge" />
                                <Border Width="24" Height="24" CornerRadius="{DynamicResource PbRadiusSm}" Background="{Binding SuccessBrush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1" ToolTip.Tip="Success" />
                            </StackPanel>

                            <!-- Computed WCAG contrast -->
                            <WrapPanel Orientation="Horizontal">
                                <Border Classes="statusBadge success" Classes.warning="{Binding !TextContrastOk}" Margin="0,0,6,4"
                                        AutomationProperties.Name="{Binding TextContrastAutomationName}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="Text" />
                                        <TextBlock Text="{Binding TextContrastText}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border Classes="statusBadge success" Classes.warning="{Binding !AccentContrastOk}" Margin="0,0,6,4"
                                        AutomationProperties.Name="{Binding AccentContrastAutomationName}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="Accent" />
                                        <TextBlock Text="{Binding AccentContrastText}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- The active family's variants (Light / Dark ...) as one switch; OLED variants are reached through True black (design Q7). Hidden for a single-variant theme. -->
                    <StackPanel IsVisible="{Binding HasActiveFamilyVariants}" Spacing="8" Tag="appearance.variants">
                        <TextBlock Classes="settingsGroupCaption" Text="VARIANTS" Margin="0" />
                        <Border Classes="segGroup" HorizontalAlignment="Left">
                            <ItemsControl ItemsSource="{Binding ActiveFamilyVariants}" AutomationProperties.AutomationId="ThemeVariants">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ThemeSummary">
                                        <Button Classes="segItem" Classes.active="{Binding IsActive}" Content="{Binding VariantName}"
                                                Command="{Binding $parent[UserControl].((vm:PreferencesScreenViewModel)DataContext).SelectThemeCommand}"
                                                CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <!-- Per-theme options (docs/superpowers/specs/2026-09-16-theme-system-design.md § Extended scope) -->
                    <StackPanel Tag="appearance.themeOptions">
                        <TextBlock Classes="settingsGroupCaption" Text="THEME OPTIONS" />
                        <pref:SettingsRow Icon="DarkTheme" Title="True black"
                                           Description="Forces pure black backgrounds on dark themes - saves battery on OLED screens. Automatically suspended while reading."
                                           IsVisible="{Binding IsActiveThemeDarkMode}">
                            <pref:SettingsRow.SettingsContent>
                                <ToggleSwitch IsChecked="{Binding TrueBlackDark}" OnContent="{x:Null}" OffContent="{x:Null}" />
                            </pref:SettingsRow.SettingsContent>
                        </pref:SettingsRow>
                        <pref:SettingsRow Icon="Sparkle" Title="Matrix rain"
                                           Description="The falling-glyph background animation. Turn off for a static Matrix look (also saves GPU/battery)."
                                           IsVisible="{Binding IsActiveThemeMatrix}">
                            <pref:SettingsRow.SettingsContent>
                                <ToggleSwitch IsChecked="{Binding MatrixRainEnabled}" OnContent="{x:Null}" OffContent="{x:Null}" />
                            </pref:SettingsRow.SettingsContent>
                        </pref:SettingsRow>
                        <!-- The accent moved to Personalize (swatches + picker), docs/superpowers/specs/2026-11-06-personalization-design.md. -->
                    </StackPanel>

                    <!-- Auto switch: a global behaviour, so it sits apart from the per-theme options above. -->
                    <StackPanel Tag="appearance.autoSwitch">
                        <TextBlock Classes="settingsGroupCaption" Text="AUTO SWITCH" />
                        <pref:SettingsRow Icon="Clock" Title="Auto switch"
                                           Description="Follow the system Light/Dark preference, or switch on a schedule.">
                            <pref:SettingsRow.SettingsContent>
                                <controls:SuggestBox IsStrict="True" Text="{Binding ThemeAutoModeText}" Suggestions="{Binding ThemeAutoModeOptionsList}" Width="160" />
                            </pref:SettingsRow.SettingsContent>
                        </pref:SettingsRow>
                        <pref:SettingsRow Icon="Clock" Title="Switch to dark at" IsVisible="{Binding IsThemeScheduledMode}">
                            <pref:SettingsRow.SettingsContent>
                                <TextBox Text="{Binding ThemeScheduledDarkHour}" beh:TextSpinner.Enabled="True" beh:TextSpinner.ClampTyped="True" beh:TextSpinner.Minimum="0" beh:TextSpinner.Maximum="23" Width="120" />
                            </pref:SettingsRow.SettingsContent>
                        </pref:SettingsRow>
                        <pref:SettingsRow Icon="Clock" Title="Switch to light at" IsVisible="{Binding IsThemeScheduledMode}">
                            <pref:SettingsRow.SettingsContent>
                                <TextBox Text="{Binding ThemeScheduledLightHour}" beh:TextSpinner.Enabled="True" beh:TextSpinner.ClampTyped="True" beh:TextSpinner.Minimum="0" beh:TextSpinner.Maximum="23" Width="120" />
                            </pref:SettingsRow.SettingsContent>
                        </pref:SettingsRow>
                        <pref:SettingsRow Icon="Clock" Title="Auto-enable true black at"
                                           Description="Local hour (0-23), blank = manual toggle only.">
                            <pref:SettingsRow.SettingsContent>
                                <TextBox Text="{Binding TrueBlackAutoHourText}" Width="80" PlaceholderText="e.g. 22" />
                            </pref:SettingsRow.SettingsContent>
                        </pref:SettingsRow>
                    </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- PERSONALIZE (design Q2/Q13): the controls and Customize scroll on the left; the live preview stays pinned on the right. -->
            <Grid IsVisible="{Binding AppearanceTabs.SelectedKey, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=personalize}"
                  ColumnDefinitions="*,24,380" Margin="0,16,0,0">
                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,12,40" Spacing="22">
                        <!-- Personalize (docs/superpowers/specs/2026-11-06-personalization-design.md): the friendly controls, above the token-level Customize list. -->
                        <StackPanel Tag="appearance.personalize">
                            <pref:PersonalizeGroup DataContext="{Binding Personalize}" />
                        </StackPanel>

                        <!-- Customize (docs/superpowers/specs/2026-10-12-theme-system-v2-gap-analysis-and-plan.md, phase 2): the user's own values for all
                             themes, this theme family or this variant. These are overrides kept beside the database; the installed theme is never edited. -->
                        <StackPanel Tag="appearance.customize" Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Classes="settingsGroupCaption" Text="CUSTOMIZE" Margin="0" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="ghost" Content="Reset these" Command="{Binding ThemeCustomization.ResetScopeCommand}"
                                        IsVisible="{Binding ThemeCustomization.HasOverridesInScope}" ToolTip.Tip="Remove every change in the scope chosen below"
                                        AutomationProperties.AutomationId="ThemeCustomizeReset" />
                            </Grid>
                            <pref:SettingsRow Icon="Options" Title="Apply my changes to"
                                               Description="All themes, only this theme (every variant of it), or only this variant. A narrower choice wins over a wider one.">
                                <pref:SettingsRow.SettingsContent>
                                    <controls:SuggestBox IsStrict="True" Text="{Binding ThemeCustomization.ScopeText}" Suggestions="{Binding ThemeCustomization.ScopeOptions}" Width="160"
                                                         AutomationProperties.AutomationId="ThemeCustomizeScope" AutomationProperties.Name="Apply my changes to" />
                                </pref:SettingsRow.SettingsContent>
                            </pref:SettingsRow>
                            <TextBlock Text="{Binding ThemeCustomization.ScopeSummary}" FontSize="12" Margin="12,0,0,2" Foreground="{DynamicResource PbTextMutedBrush}"
                                       AutomationProperties.LiveSetting="Polite" />

                            <TextBlock Classes="pbTextMeta" Margin="12,0,0,2" TextWrapping="Wrap" IsVisible="{Binding ThemeCustomization.ShowPersonalizeNote}"
                                       Text="Accent and corners for all themes are set in Personalize above. Choose this theme or this variant to give one theme its own." />
                            <ItemsControl ItemsSource="{Binding ThemeCustomization.Rows}" AutomationProperties.AutomationId="ThemeCustomizeRows">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ThemeOverrideRowViewModel">
                                        <Grid ColumnDefinitions="22,*,Auto,34" ColumnSpacing="10" Margin="12,4,0,4" ToolTip.Tip="{Binding Description}" IsVisible="{Binding IsShown}">
                                            <Border Grid.Column="0" Width="22" Height="22" CornerRadius="{DynamicResource PbRadiusSm}" Background="{Binding Swatch}"
                                                    BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1" IsVisible="{Binding IsColor}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource PbTextBrush}" />
                                                <TextBlock Text="{Binding SourceText}" FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" />
                                            </StackPanel>
                                            <TextBox Grid.Column="2" Width="128" Text="{Binding ValueText}" PlaceholderText="{Binding ResolvedText}" Classes.invalid="{Binding IsInvalid}"
                                                     VerticalAlignment="Center" AutomationProperties.Name="{Binding AutomationName}" />
                                            <Button Grid.Column="3" Classes="iconButton" Command="{Binding ResetCommand}" IsVisible="{Binding IsOverridden}"
                                                    ToolTip.Tip="Reset to the theme value" AutomationProperties.Name="Reset" VerticalAlignment="Center">
                                                <fi:SymbolIcon Symbol="ArrowUndo" FontSize="{StaticResource PbIconSizeXs}" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <pref:SettingsRow Icon="Accessibility" Title="Boost contrast"
                                               Description="Raises text colours until they read clearly on the background. A theme is never changed unless this is on.">
                                <pref:SettingsRow.SettingsContent>
                                    <ToggleSwitch IsChecked="{Binding ThemeCustomization.BoostContrast}" OnContent="{x:Null}" OffContent="{x:Null}"
                                                  AutomationProperties.AutomationId="ThemeBoostContrast" AutomationProperties.Name="Boost contrast" />
                                </pref:SettingsRow.SettingsContent>
                            </pref:SettingsRow>

                            <pref:SettingsRow Icon="Sparkle" Title="Effect quality"
                                               Description="High draws everything a theme asks for. Balanced stops continuous motion. Performance uses plain fills and no theme motion.">
                                <pref:SettingsRow.SettingsContent>
                                    <controls:SuggestBox IsStrict="True" Text="{Binding ThemeCustomization.EffectQualityText}" Suggestions="{Binding ThemeCustomization.EffectQualityOptions}" Width="160"
                                                         AutomationProperties.AutomationId="ThemeEffectQuality" AutomationProperties.Name="Effect quality" />
                                </pref:SettingsRow.SettingsContent>
                            </pref:SettingsRow>

                            <pref:SettingsRow Icon="Grid" Title="Theme layouts (experimental)"
                                               Description="Let a theme rearrange a screen. Colours, type and control styles always apply; layouts only when this is on. A layout that cannot be used falls back to the built-in one.">
                                <pref:SettingsRow.SettingsContent>
                                    <ToggleSwitch IsChecked="{Binding ThemeCustomization.AllowThemeLayouts}" OnContent="{x:Null}" OffContent="{x:Null}"
                                                  AutomationProperties.AutomationId="ThemeAllowLayouts" AutomationProperties.Name="Theme layouts" />
                                </pref:SettingsRow.SettingsContent>
                            </pref:SettingsRow>
                            <Grid ColumnDefinitions="*,Auto" Margin="12,0,0,2">
                                <TextBlock Grid.Column="0" Text="{Binding ThemeCustomization.LayoutSummary}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                           Foreground="{DynamicResource PbTextMutedBrush}" AutomationProperties.AutomationId="ThemeLayoutSummary" />
                                <Button Grid.Column="1" Classes="ghost" Content="Reset layout" Command="{Binding ThemeCustomization.ResetLayoutCommand}"
                                        IsVisible="{Binding ThemeCustomization.HasLayoutAdjustments}" ToolTip.Tip="Remove your own adjustments to this theme's layouts"
                                        AutomationProperties.AutomationId="ThemeResetLayout" />
                            </Grid>

                            <!-- Files: a theme exported as it is installed, and the customizations above as their own small file. -->
                            <WrapPanel Orientation="Horizontal" Margin="12,6,0,0">
                                <Button Classes="ghost" Content="Export this theme…" Margin="0,0,8,6" Command="{Binding ExportActiveThemeCommand}"
                                        ToolTip.Tip="Save this theme as a .crpck, exactly as installed" AutomationProperties.AutomationId="ThemeExport" />
                                <Button Classes="ghost" Content="Export my look…" Margin="0,0,8,6" Command="{Binding ExportThemeCustomizationsCommand}"
                                        ToolTip.Tip="Your theme customizations and Personalize settings, as one file"
                                        AutomationProperties.AutomationId="ThemeExportCustomizations" />
                                <Button Classes="ghost" Content="Import a look…" Margin="0,0,8,6" Command="{Binding ImportThemeCustomizationsCommand}"
                                        ToolTip.Tip="Replace your theme customizations and Personalize settings with an exported look" AutomationProperties.AutomationId="ThemeImportCustomizations" />
                            </WrapPanel>
                            <TextBlock Text="{Binding ThemeFileMessage}" IsVisible="{Binding HasThemeFileMessage}" FontSize="12" TextWrapping="Wrap" Margin="12,0,0,0"
                                       Foreground="{DynamicResource PbTextMutedBrush}" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="ThemeFileMessage" />

                            <StackPanel IsVisible="{Binding ThemeCustomization.HasNotes}" Margin="12,4,0,0" Spacing="3">
                                <TextBlock Text="Notes about this theme as shown" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PbTextMutedBrush}" />
                                <ItemsControl ItemsSource="{Binding ThemeCustomization.Notes}" AutomationProperties.AutomationId="ThemeNotes">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource PbTextMutedBrush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled">
                    <pref:PersonalizePreview DataContext="{Binding Personalize}" Margin="0,0,28,40" VerticalAlignment="Top" />
                </ScrollViewer>
            </Grid>

            <!-- COVERS & DETAIL -->
            <ScrollViewer IsVisible="{Binding AppearanceTabs.SelectedKey, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=covers}">
                <StackPanel Margin="0,16,28,40" Spacing="20">
        <!-- Cosmetics (docs/superpowers/specs/2026-09-21-cosmetics-pitch-design.md) - Paperbunkr
             additions with no ComicRack equivalent; all applied live. -->
        <StackPanel Tag="appearance.cosmetics">
            <TextBlock Classes="settingsGroupCaption" Text="COVER COSMETICS" />
            <pref:SettingsRow Icon="Book" Title="Binding spine"
                               Description="A subtle spine shadow on the cover edge in the Poster and Panorama grids.">
                <pref:SettingsRow.SettingsContent>
                    <ToggleSwitch IsChecked="{Binding BindingSpine}" OnContent="{x:Null}" OffContent="{x:Null}" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
            <pref:SettingsRow Icon="Clock" Title="Read-progress bar"
                               Description="A thin bar along the bottom of a cover showing how far through a series or issue you are while it's in progress.">
                <pref:SettingsRow.SettingsContent>
                    <ToggleSwitch IsChecked="{Binding ProgressRing}" OnContent="{x:Null}" OffContent="{x:Null}" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
            <pref:SettingsRow Icon="Image" Title="Fade in covers"
                               Description="Covers fade in the first time they appear instead of popping in.">
                <pref:SettingsRow.SettingsContent>
                    <ToggleSwitch IsChecked="{Binding FadeInThumbnails}" OnContent="{x:Null}" OffContent="{x:Null}" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
            <pref:SettingsRow Icon="CursorHover" Title="Cover tooltips"
                               Description="A details card after resting the pointer on a cover in the Poster and Panorama grids.">
                <pref:SettingsRow.SettingsContent>
                    <ToggleSwitch IsChecked="{Binding ShowToolTips}" OnContent="{x:Null}" OffContent="{x:Null}" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
            <pref:SettingsRow Icon="Checkmark" Title="Selection checkbox on tiles"
                               Description="Off: select several tiles with Ctrl+click (Shift+click for a range). A selected tile still shows its checked box.">
                <pref:SettingsRow.SettingsContent>
                    <ToggleSwitch IsChecked="{Binding ShowSelectionCheckbox}" OnContent="{x:Null}" OffContent="{x:Null}" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
            <pref:SettingsRow Icon="Library" Title="Reading-list cover mosaic"
                               Description="Shows a 2×2 collage of a list's first covers when it has no cover of its own.">
                <pref:SettingsRow.SettingsContent>
                    <ToggleSwitch IsChecked="{Binding ReadingListMosaic}" OnContent="{x:Null}" OffContent="{x:Null}" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
            <pref:SettingsRow Icon="Library" Title="Collection progress ring"
                               Description="A small ring beside each collection's count in the sidebar and on its Home card, showing how much of it you have read.">
                <pref:SettingsRow.SettingsContent>
                    <ToggleSwitch IsChecked="{Binding ShowCollectionProgress}" OnContent="{x:Null}" OffContent="{x:Null}"
                                  AutomationProperties.AutomationId="PrefShowCollectionProgress" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
            <pref:SettingsRow Icon="Library" Title="Collection row density"
                               Description="Row height of the Collections list in the Library sidebar.">
                <pref:SettingsRow.SettingsContent>
                    <controls:SuggestBox IsStrict="True" Text="{Binding CollectionDensityText}" Suggestions="{Binding CollectionDensityOptionsList}" Width="160" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
            <pref:SettingsRow Icon="Library" Title="Collection marker shape"
                               Description="The accent marker of a collection that has no icon: a circle or a rounded square.">
                <pref:SettingsRow.SettingsContent>
                    <controls:SuggestBox IsStrict="True" Text="{Binding CollectionDotShapeText}" Suggestions="{Binding CollectionDotShapeOptionsList}" Width="160" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
            <pref:SettingsRow Icon="Sparkle" Title="Splash ambient motion"
                               Description="Slow drifting dots behind the startup splash. Applies at the next launch; off when Reduce motion is on.">
                <pref:SettingsRow.SettingsContent>
                    <ToggleSwitch IsChecked="{Binding SplashAmbientMotion}" OnContent="{x:Null}" OffContent="{x:Null}" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
            <!-- Accent glow moved to Personalize as Ring strength (docs/superpowers/specs/2026-11-06-personalization-design.md). -->
        </StackPanel>

        <!-- Detail screens (docs/superpowers/specs/2026-09-21-cosmetics-pitch-2-design.md #8/#9). -->
        <StackPanel Tag="appearance.detail">
            <TextBlock Classes="settingsGroupCaption" Text="DETAIL SCREENS" />
            <pref:SettingsRow Icon="Image" Title="Hero backdrop"
                               Description="A blurred copy of the cover behind the series header.">
                <pref:SettingsRow.SettingsContent>
                    <ToggleSwitch IsChecked="{Binding HeroBackdrop}" OnContent="{x:Null}" OffContent="{x:Null}" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
            <pref:SettingsRow Icon="Color" Title="Series accent color"
                               Description="Tint a series page's chips, progress and buttons from its cover. Falls back to your skin's accent.">
                <pref:SettingsRow.SettingsContent>
                    <ToggleSwitch IsChecked="{Binding SeriesAccentColor}" OnContent="{x:Null}" OffContent="{x:Null}" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
        </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- HOME & INTERFACE -->
            <ScrollViewer IsVisible="{Binding AppearanceTabs.SelectedKey, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=interface}">
                <StackPanel Margin="0,16,28,40" Spacing="20">
        <!-- Home (docs/superpowers/specs/2026-09-28-home-improvements-design.md I1/I5, 2026-09-28-home-cosmetics-design.md C10):
             section order and visibility, the seasonal flourish, and the "Not interested" list. -->
        <StackPanel Tag="appearance.home" Spacing="8">
            <TextBlock Classes="settingsGroupCaption" Text="HOME" />
            <pref:SettingsRow Icon="Home" Title="Sections"
                               Description="Drag to reorder, untick to hide. The greeting and search always stay at the top.">
                <pref:SettingsRow.SettingsContent>
                    <Button Content="Reset to default" Command="{Binding HomePrefs.ResetLayoutCommand}"
                            AutomationProperties.AutomationId="HomeSectionsReset" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
            <ItemsControl ItemsSource="{Binding HomePrefs.Sections}" Margin="12,0,0,0" AutomationProperties.AutomationId="HomeSectionsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="homevm:HomeSectionRow">
                        <Border Background="{DynamicResource PbSurface2Brush}" CornerRadius="{DynamicResource PbRadiusSm}" Padding="8,4" Margin="0,2"
                                homeviews:HomeSectionRowDrag.Owner="{Binding $parent[UserControl].((vm:PreferencesScreenViewModel)DataContext).HomePrefs}">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                                <Border Grid.Column="0" Background="Transparent" Cursor="SizeAll" Padding="4" ToolTip.Tip="Drag to reorder"
                                        homeviews:HomeSectionRowDrag.Handle="True">
                                    <fi:SymbolIcon Symbol="ReOrderDotsVertical" FontSize="{StaticResource PbIconSizeSm}"
                                                   Foreground="{DynamicResource PbTextFaintBrush}" />
                                </Border>
                                <CheckBox Grid.Column="1" IsChecked="{Binding IsVisible}" Margin="6,0" VerticalAlignment="Center"
                                          AutomationProperties.Name="{Binding Name}" />
                                <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource PbTextBrush}" />
                                <Button Grid.Column="3" Classes="iconButton" ToolTip.Tip="Move up" AutomationProperties.Name="Move up"
                                        Command="{Binding $parent[UserControl].((vm:PreferencesScreenViewModel)DataContext).HomePrefs.MoveUpCommand}"
                                        CommandParameter="{Binding}">
                                    <fi:SymbolIcon Symbol="ArrowUp" FontSize="{StaticResource PbIconSizeXs}" />
                                </Button>
                                <Button Grid.Column="4" Classes="iconButton" ToolTip.Tip="Move down" AutomationProperties.Name="Move down"
                                        Command="{Binding $parent[UserControl].((vm:PreferencesScreenViewModel)DataContext).HomePrefs.MoveDownCommand}"
                                        CommandParameter="{Binding}">
                                    <fi:SymbolIcon Symbol="ArrowDown" FontSize="{StaticResource PbIconSizeXs}" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <pref:SettingsRow Icon="Star" Title="Seasonal flourish"
                               Description="A small icon and greeting tint on Free Comic Book Day, Halloween, the winter holidays and New Year.">
                <pref:SettingsRow.SettingsContent>
                    <ToggleSwitch IsChecked="{Binding HomePrefs.SeasonalFlourish}" OnContent="{x:Null}" OffContent="{x:Null}" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
            <pref:SettingsRow Icon="EyeOff" Title="Hidden recommendations"
                               Description="Series you marked &quot;Not interested&quot; on Home. Unhide one to see it recommended again." />
            <TextBlock Text="Nothing hidden" FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" Margin="12,0,0,0" IsVisible="{Binding !HomePrefs.HasHiddenRecommendations}" />
            <ItemsControl ItemsSource="{Binding HomePrefs.HiddenRecommendations}" Margin="12,0,0,0"
                          AutomationProperties.AutomationId="HomeHiddenRecommendationsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="homevm:HiddenRecommendationRow">
                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                            <TextBlock Grid.Column="0" Text="{Binding SeriesName}" VerticalAlignment="Center" Foreground="{DynamicResource PbTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding DismissedText}" VerticalAlignment="Center" Margin="12,0"
                                       FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" />
                            <Button Grid.Column="2" Content="Unhide"
                                    Command="{Binding $parent[UserControl].((vm:PreferencesScreenViewModel)DataContext).HomePrefs.UnhideCommand}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Interface - Motion/Navigation/Developer consolidated from 3 single-row groups into one
             (docs/superpowers/specs/2026-09-07-appearance-redesign-design.md §4/Goal 6). Developer's
             row keeps its own IsDebugBuild visibility rather than the whole group needing it. -->
        <StackPanel Tag="appearance.interface">
            <TextBlock Classes="settingsGroupCaption" Text="INTERFACE" />
            <pref:SettingsRow Icon="TextLineSpacing" Title="Density"
                               Description="How tightly list rows and sidebar items are spaced. Comfortable is the default.">
                <pref:SettingsRow.SettingsContent>
                    <controls:SuggestBox IsStrict="True" Text="{Binding DensityText}" Suggestions="{Binding DensityOptionsList}" Width="160" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
            <ItemsControl ItemsSource="{Binding DensitySamples}" Margin="12,6,0,8" AutomationProperties.AutomationId="DensitySamples">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:DensitySample">
                        <StackPanel Spacing="4" Width="116" AutomationProperties.Name="{Binding Label}">
                            <Border Classes="sampleBox" Classes.sampleActive="{Binding IsActive}" Padding="8">
                                <StackPanel Spacing="3">
                                    <Border Background="{DynamicResource PbSurface3Brush}" CornerRadius="{DynamicResource PbRadiusSm}" Padding="{Binding RowPadding}"><Border Height="4" Width="64" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource PbTextMutedBrush}" /></Border>
                                    <Border Background="{DynamicResource PbSurface3Brush}" CornerRadius="{DynamicResource PbRadiusSm}" Padding="{Binding RowPadding}"><Border Height="4" Width="48" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource PbTextMutedBrush}" /></Border>
                                    <Border Background="{DynamicResource PbSurface3Brush}" CornerRadius="{DynamicResource PbRadiusSm}" Padding="{Binding RowPadding}"><Border Height="4" Width="58" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource PbTextMutedBrush}" /></Border>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding Label}" FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource PbTextMutedBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <pref:SettingsRow Icon="Pulse" Title="Motion"
                               Description="{Binding MotionPreferenceDescription}">
                <pref:SettingsRow.SettingsContent>
                    <controls:SuggestBox IsStrict="True" Text="{Binding MotionPreferenceText}"
                                         Suggestions="{Binding MotionPreferenceModeNames}" Width="150" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
            <pref:SettingsRow Icon="ArrowSort" Title="Smooth scrolling"
                               Description="Each mouse-wheel notch glides to its place in the Library instead of jumping. Mouse wheel only.">
                <pref:SettingsRow.SettingsContent>
                    <ToggleSwitch IsChecked="{Binding SmoothScrolling}" OnContent="{x:Null}" OffContent="{x:Null}" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
            <pref:SettingsRow Icon="Navigation" Title="Expand nav rail on hover"
                               Description="When off, the rail only expands while pinned open.">
                <pref:SettingsRow.SettingsContent>
                    <ToggleSwitch IsChecked="{Binding NavRailHoverExpandEnabled}" OnContent="{x:Null}" OffContent="{x:Null}" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
            <pref:SettingsRow Icon="Code" Title="Open the internal component/style showcase" IsVisible="{Binding IsDebugBuild}">
                <pref:SettingsRow.SettingsContent>
                    <Button Content="Open Design Showcase" Command="{Binding OpenDesignShowcaseCommand}" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
        </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Panel>
    </Grid>
</UserControl>
