<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="220"
             x:Class="Paperbunkr.App.Views.DetailPills">

    <UserControl.Styles>
        <Style Selector="TextBlock.pillGroupLabel">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource PbTextMutedBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style Selector="Border.tagPill">
            <Setter Property="Background" Value="{StaticResource PbChromeBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PbBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="12,5" />
        </Style>
        <Style Selector="Border.tagPill.highlight">
            <Setter Property="Background" Value="#24D7AC4C" />
            <Setter Property="BorderBrush" Value="{StaticResource PbBadgeBrush}" />
        </Style>
        <Style Selector="TextBlock.tagText">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource PbTextMutedBrush}" />
        </Style>
        <Style Selector="Border.tagPill.highlight TextBlock.tagText">
            <Setter Property="Foreground" Value="{StaticResource PbBadgeBrush}" />
        </Style>
    </UserControl.Styles>

    <StackPanel Margin="0,20,0,0">
        <Border BorderBrush="{StaticResource PbBorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">

            <StackPanel>
                <TextBlock Classes="pillGroupLabel" Text="Teams" />
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Classes="tagPill highlight" Margin="0,0,8,0"><TextBlock Classes="tagText" Text="Deep Vault Consortium" /></Border>
                    <Border Classes="tagPill highlight" Margin="0,0,8,0"><TextBlock Classes="tagText" Text="Meridian Watch" /></Border>
                </WrapPanel>

                <TextBlock Classes="pillGroupLabel" Text="Locations" />
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Classes="tagPill" Margin="0,0,8,0"><TextBlock Classes="tagText" Text="The Hollow Line" /></Border>
                    <Border Classes="tagPill" Margin="0,0,8,0"><TextBlock Classes="tagText" Text="Port Ashcombe" /></Border>
                    <Border Classes="tagPill" Margin="0,0,8,0"><TextBlock Classes="tagText" Text="Kilo Station Ring" /></Border>
                </WrapPanel>

                <TextBlock Classes="pillGroupLabel" Text="Genres &amp; Concepts" />
                <WrapPanel Orientation="Horizontal">
                    <Border Classes="tagPill" Margin="0,0,8,0"><TextBlock Classes="tagText" Text="Salvage Noir" /></Border>
                    <Border Classes="tagPill" Margin="0,0,8,0"><TextBlock Classes="tagText" Text="Post-Collapse" /></Border>
                    <Border Classes="tagPill" Margin="0,0,8,0"><TextBlock Classes="tagText" Text="Found Family" /></Border>
                    <Border Classes="tagPill" Margin="0,0,8,0"><TextBlock Classes="tagText" Text="Signal Ghosts" /></Border>
                </WrapPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
