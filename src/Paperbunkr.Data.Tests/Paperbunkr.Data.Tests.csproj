<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paperbunkr.Data\Paperbunkr.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Checked-in reference ComicDb.xml fixture (docs/onboarding.md §14): generated once via the
         real ported ComicDatabase.SaveXml serializer rather than hand-written, so its shape is
         guaranteed valid. See CeLibraryMigratorTests.Migrate_FromCheckedInFixture. -->
    <None Include="TestData\SampleComicDb.xml" CopyToOutputDirectory="PreserveNewest" />
    <!-- Real ComicRack smart-list .cbl files (a user's workflow lists), one per matcher type, for the CE smart-list import reader. -->
    <None Include="TestData\CeSmartLists\*.cbl" CopyToOutputDirectory="PreserveNewest" />
    <!-- A few real ComicRack reading-order .cbl files (event reading orders), to check the reading-list import against files made by ComicRack itself. -->
    <None Include="TestData\ReadingOrders\*.cbl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
