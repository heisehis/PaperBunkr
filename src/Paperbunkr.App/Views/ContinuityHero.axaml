<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:controls="using:Paperbunkr.App.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="220"
             x:Class="Paperbunkr.App.Views.ContinuityHero"
             x:DataType="vm:ContinuityPageViewModel">

    <UserControl.Styles>
        <StyleInclude Source="avares://Paperbunkr.App/Styles/ContinuityChrome.axaml" />
    </UserControl.Styles>

    <controls:HeroBand CoverKeys="{Binding CollageKeys}">
        <!-- Right margin leaves room for the screen's Overview | Map | Timeline switch -->
        <StackPanel Spacing="6" Margin="0,0,250,0" MaxWidth="900" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <controls:BrandMark Family="Publisher" Value="{Binding Publisher}" MarkSize="24" MaxMarkWidth="80" ShowText="False" EnsureContrast="True" VerticalAlignment="Center">
                    <controls:BrandMark.IsVisible>
                        <!-- only a real logo: a publisher with none would fall back to plain text, which reads as a stray mark here -->
                        <MultiBinding Converter="{x:Static conv:BoolConverters.Or}">
                            <Binding Path="IsImage" RelativeSource="{RelativeSource Self}" />
                            <Binding Path="IsRaster" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </controls:BrandMark.IsVisible>
                </controls:BrandMark>
                <TextBlock Classes="pbTextHeading" Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </StackPanel>

            <WrapPanel>
                <TextBlock Text="{Binding StatsLine}" FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <Border Classes="heroChip" IsVisible="{Binding ShowGcdChip}"
                        ToolTip.Tip="Series continuity and on-sale dates from the Grand Comics Database™ (CC BY-SA 4.0)">
                    <TextBlock Text="GCD" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PbTextMutedBrush}" />
                </Border>
                <TextBlock Text="Working out the overview…" Classes="csFaint" VerticalAlignment="Center" IsVisible="{Binding IsOverviewLoading}" />
            </WrapPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasOverviewError}">
                <TextBlock Text="{Binding OverviewError}" FontSize="11.5" Foreground="{DynamicResource PbDangerBrush}" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="560" />
                <Button Classes="headerAction secondary" Content="Retry" Command="{Binding RetryOverviewCommand}" />
            </StackPanel>

            <!-- Description: 3 lines, more/less -->
            <StackPanel IsVisible="{Binding HasDescription}" Spacing="2">
                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" TextWrapping="Wrap"
                           MaxWidth="640" HorizontalAlignment="Left" MaxLines="3" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding !IsDescriptionExpanded}" />
                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" TextWrapping="Wrap"
                           MaxWidth="640" HorizontalAlignment="Left" IsVisible="{Binding IsDescriptionExpanded}" />
                <Button Classes="headerAction ghost" Padding="0,2" FontSize="11" HorizontalAlignment="Left" Command="{Binding ToggleDescriptionCommand}">
                    <Panel>
                        <TextBlock Text="More" IsVisible="{Binding !IsDescriptionExpanded}" />
                        <TextBlock Text="Less" IsVisible="{Binding IsDescriptionExpanded}" />
                    </Panel>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                <Button Classes="headerAction primary" Command="{Binding ContinueReadingCommand}" IsVisible="{Binding HasContinue}"
                        ToolTip.Tip="Opens the first unread issue in the continuity map's order">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <fi:SymbolIcon Symbol="Play" IconVariant="Filled" FontSize="{StaticResource PbIconSizeXs}" />
                        <TextBlock Text="{Binding ContinueLabel}" MaxWidth="320" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
                <Button Classes="headerAction secondary" Content="＋ Add series" Command="{Binding ToggleAddSeriesCommand}" />
                <Button Classes="headerAction secondary" Content="⋯ Manage" AutomationProperties.Name="Manage continuity">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Edit details…"
                                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenEditContinuityDialogCommand}" />
                            <MenuItem Header="Compare &amp; merge…" Command="{Binding ToggleCompareCommand}"
                                      IsEnabled="{Binding !HasNoOverlappingContinuities}" />
                            <!-- Two orders (docs/superpowers/specs/2026-09-28-reading-lists-build-from-events-design.md §2, Q17/Q18); story order first. -->
                            <MenuItem Header="Create reading list">
                                <MenuItem Header="Story order — as on the map" Command="{Binding CreateReadingListCommand}" CommandParameter="story" />
                                <MenuItem Header="Publication order — by release date" Command="{Binding CreateReadingListCommand}" CommandParameter="publication" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="{Binding DeleteConfirm.Label}" Command="{Binding DeleteConfirm.TriggerCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </StackPanel>
    </controls:HeroBand>
</UserControl>
