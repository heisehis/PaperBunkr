<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:services="using:Paperbunkr.App.Services"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:pref="using:Paperbunkr.App.Views.Preferences"
             xmlns:views="using:Paperbunkr.App.Views"
             xmlns:controls="using:Paperbunkr.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="900"
             x:Class="Paperbunkr.App.Views.Preferences.AboutSection"
             x:DataType="vm:PreferencesScreenViewModel">

    <!-- About (docs/superpowers/specs/2026-09-26-about-polish-design.md §5): an identity header, then Overview / Changelog /
         Legal & notices tabs on the shared SettingsTabStrip, one ScrollViewer per tab like the Reader section (a nested
         ScrollViewer inside one shared scroller would fight for the wheel). Each group's Tag is a PreferenceIndex anchor naming
         its tab, so a search hit or the "What's New" toast lands on the right one. -->
    <Panel Name="AboutRoot">
        <Grid RowDefinitions="Auto,Auto,*" Margin="28,20,0,0">

            <!-- Identity header: the version appears here once (Q9). -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,28,16">
                <Image Grid.Column="0" Source="avares://Paperbunkr.App/Assets/paperbunkr-logo-source.png" Width="56" Height="56"
                       VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3" Margin="16,0,12,0">
                    <TextBlock Text="Paperbunkr" Classes="pbTextHeading" />
                    <SelectableTextBlock Text="{Binding AboutVersionLine}" FontSize="12.5" TextWrapping="Wrap"
                                         Foreground="{DynamicResource PbTextFaintBrush}" />
                </StackPanel>
                <Button Grid.Column="2" Classes="headerAction ghost" VerticalAlignment="Center"
                        Command="{Binding CopyVersionInfoCommand}"
                        ToolTip.Tip="Copies the version, build, Windows and .NET versions for a bug report"
                        AutomationProperties.AutomationId="AboutCopyVersionInfo">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Panel>
                            <fi:SymbolIcon Symbol="Copy" FontSize="{StaticResource PbIconSizeSm}" IsVisible="{Binding !VersionInfoCopied}" />
                            <fi:SymbolIcon Symbol="Checkmark" FontSize="{StaticResource PbIconSizeSm}" IsVisible="{Binding VersionInfoCopied}"
                                           Foreground="{DynamicResource PbSuccessBrush}" />
                        </Panel>
                        <Panel>
                            <TextBlock Text="Copy version info" IsVisible="{Binding !VersionInfoCopied}" />
                            <TextBlock Text="Copied" IsVisible="{Binding VersionInfoCopied}" />
                        </Panel>
                    </StackPanel>
                </Button>
            </Grid>

            <pref:SettingsTabStrip Grid.Row="1" Margin="0,0,28,0" Tabs="{Binding AboutTabs}" AutomationProperties.Name="About tabs" />

            <Panel Grid.Row="2">

                <!-- OVERVIEW -->
                <ScrollViewer IsVisible="{Binding AboutTabs.SelectedKey, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=overview}">
                    <StackPanel Margin="0,16,28,40" Spacing="20">

                        <StackPanel Tag="about.updates">
                            <TextBlock Classes="settingsGroupCaption" Text="UPDATES" />
                            <pref:SettingsRow Icon="Sparkle" Title="What's new" Description="Highlights from this release">
                                <pref:SettingsRow.SettingsContent>
                                    <Button Classes="headerAction ghost" Command="{Binding OpenWhatsNewCommand}" Content="View"
                                            AutomationProperties.AutomationId="AboutWhatsNew" />
                                </pref:SettingsRow.SettingsContent>
                            </pref:SettingsRow>
                            <pref:SettingsRow Icon="ArrowSync" Title="Check for updates"
                                              Description="{Binding UpdateCheckResultText, TargetNullValue='New versions are published as GitHub releases.'}">
                                <pref:SettingsRow.SettingsContent>
                                    <Button Classes="headerAction primary" Command="{Binding CheckForUpdatesCommand}" Content="Check now" />
                                </pref:SettingsRow.SettingsContent>
                            </pref:SettingsRow>
                            <pref:SettingsRow Icon="ArrowClockwise" Title="Check for updates on startup"
                                              Description="Asks GitHub whether a newer version exists. Nothing is downloaded without asking.">
                                <pref:SettingsRow.SettingsContent>
                                    <ToggleSwitch IsChecked="{Binding CheckForUpdatesOnStartup}" OnContent="{x:Null}" OffContent="{x:Null}" />
                                </pref:SettingsRow.SettingsContent>
                            </pref:SettingsRow>
                        </StackPanel>

                        <StackPanel Tag="about.project">
                            <TextBlock Classes="settingsGroupCaption" Text="PROJECT" />
                            <pref:SettingsRow Icon="Code" Title="Source code" Description="Paperbunkr on GitHub">
                                <pref:SettingsRow.SettingsContent>
                                    <Button Classes="headerAction ghost" Command="{Binding OpenProjectLinkCommand}"
                                            CommandParameter="{x:Static services:ProjectLinks.Repository}" ToolTip.Tip="{x:Static services:ProjectLinks.Repository}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Open" />
                                            <fi:SymbolIcon Symbol="Open" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </pref:SettingsRow.SettingsContent>
                            </pref:SettingsRow>
                            <pref:SettingsRow Icon="BookQuestionMark" Title="Wiki" Description="How-to guides for every screen">
                                <pref:SettingsRow.SettingsContent>
                                    <Button Classes="headerAction ghost" Command="{Binding OpenProjectLinkCommand}"
                                            CommandParameter="{x:Static services:ProjectLinks.Wiki}" ToolTip.Tip="{x:Static services:ProjectLinks.Wiki}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Open" />
                                            <fi:SymbolIcon Symbol="Open" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </pref:SettingsRow.SettingsContent>
                            </pref:SettingsRow>
                            <pref:SettingsRow Icon="Bug" Title="Report an issue"
                                              Description="Opens a bug report or feature request on GitHub. Copy version info above first.">
                                <pref:SettingsRow.SettingsContent>
                                    <Button Classes="headerAction ghost" Command="{Binding OpenProjectLinkCommand}"
                                            CommandParameter="{x:Static services:ProjectLinks.NewIssue}" ToolTip.Tip="{x:Static services:ProjectLinks.NewIssue}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Open" />
                                            <fi:SymbolIcon Symbol="Open" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </pref:SettingsRow.SettingsContent>
                            </pref:SettingsRow>
                            <pref:SettingsRow Icon="Tag" Title="Releases" Description="Every version, with installers and release notes">
                                <pref:SettingsRow.SettingsContent>
                                    <Button Classes="headerAction ghost" Command="{Binding OpenProjectLinkCommand}"
                                            CommandParameter="{x:Static services:ProjectLinks.Releases}" ToolTip.Tip="{x:Static services:ProjectLinks.Releases}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Open" />
                                            <fi:SymbolIcon Symbol="Open" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </pref:SettingsRow.SettingsContent>
                            </pref:SettingsRow>
                            <pref:SettingsRow Icon="Folder" Title="Logs and data"
                                              Description="Logs holds startup and crash logs. Data holds your database, covers, backups and plugins.">
                                <pref:SettingsRow.SettingsContent>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Classes="headerAction ghost" Content="Logs" Command="{Binding OpenLogsFolderCommand}"
                                                AutomationProperties.AutomationId="AboutOpenLogsFolder" />
                                        <Button Classes="headerAction ghost" Content="Data" Command="{Binding OpenDataFolderCommand}"
                                                AutomationProperties.AutomationId="AboutOpenDataFolder" />
                                    </StackPanel>
                                </pref:SettingsRow.SettingsContent>
                            </pref:SettingsRow>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- CHANGELOG: the same ChangelogEntryView What's New uses; empty [Unreleased] entries are hidden, and the running
                     version's entry (or the newest one before it) is marked Current and starts expanded. -->
                <ScrollViewer IsVisible="{Binding AboutTabs.SelectedKey, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=changelog}">
                    <!-- Capped at a comfortable reading width: changelog bullets are long sentences. -->
                    <StackPanel Margin="0,16,28,40" MaxWidth="860" HorizontalAlignment="Left" Tag="about.changelog">
                        <ItemsControl ItemsSource="{Binding ChangelogRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="services:ChangelogRow">
                                    <views:ChangelogEntryView Margin="0,0,0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No changelog is bundled with this build." FontSize="12.5"
                                   Foreground="{DynamicResource PbTextFaintBrush}" IsVisible="{Binding !HasChangelog}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- LEGAL & NOTICES: each row opens the in-app viewer below. -->
                <ScrollViewer IsVisible="{Binding AboutTabs.SelectedKey, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=legal}">
                    <StackPanel Margin="0,16,28,40" Spacing="20">
                        <StackPanel Tag="about.legal">
                            <TextBlock Classes="settingsGroupCaption" Text="DOCUMENTS" />
                            <ItemsControl ItemsSource="{Binding LegalDocumentList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="services:LegalDocument">
                                        <pref:SettingsRow Icon="{Binding Icon}" Title="{Binding Title}" Description="{Binding Description}">
                                            <pref:SettingsRow.SettingsContent>
                                                <Button Classes="headerAction ghost" Content="Read"
                                                        Command="{Binding #AboutRoot.((vm:PreferencesScreenViewModel)DataContext).OpenLegalDocumentCommand}"
                                                        CommandParameter="{Binding FileName}"
                                                        AutomationProperties.Name="{Binding Title, StringFormat='Read {0}'}" />
                                            </pref:SettingsRow.SettingsContent>
                                        </pref:SettingsRow>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Classes="settingsGroupCaption" Text="BUILT WITH" />
                            <TextBlock FontSize="12.5" TextWrapping="Wrap" LineHeight="19" Foreground="{DynamicResource PbTextMutedBrush}"
                                       Text="Avalonia, FluentAvalonia, CommunityToolkit.Mvvm, Entity Framework Core and SQLite, Fluent System Icons, ScottPlot, Svg.Skia and NetSparkle, among others listed in Open-source notices." />
                            <TextBlock FontSize="12.5" TextWrapping="Wrap" LineHeight="19" Foreground="{DynamicResource PbTextMutedBrush}"
                                       Text="Metadata comes from ComicVine, Metron, AniList, MangaDex, MangaBaka and Wikidata, each under its own terms." />
                            <TextBlock FontSize="12.5" TextWrapping="Wrap" LineHeight="19" Foreground="{DynamicResource PbTextMutedBrush}"
                                       Text="Inspired by ComicRack and ComicRack Community Edition." />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Panel>
        </Grid>

        <controls:OverlayShell IsOpen="{Binding IsLegalDocumentViewerOpen}"
                               CloseCommand="{Binding CloseLegalDocumentViewerCommand}"
                               ShowCloseButton="False">
            <views:LegalDocumentViewerOverlay />
        </controls:OverlayShell>
    </Panel>
</UserControl>
