<?xml version="1.0"?>
<ReadingList xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Name>7.1 Dupe with Comicvine_issue</Name>
  <Books />
  <Matchers>
    <ComicBookMatcher xsi:type="ComicBookPluginMatcher" MatchOperator="2" PluginKey="SameXDifferentY">
      <MatchValue>comicvine_issue|Format</MatchValue>
    </ComicBookMatcher>
    <ComicBookMatcher xsi:type="ComicBookCustomValuesMatcher">
      <MatchValue>datamanager_processed</MatchValue>
      <MatchValue2>yes</MatchValue2>
    </ComicBookMatcher>
  </Matchers>
</ReadingList>