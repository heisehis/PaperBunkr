---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { REPO_URL, WIKI_URL } from '../lib/content';
import { getLatestRelease, RELEASES_URL } from '../lib/release';

const release = await getLatestRelease();
const downloadUrl = release.installer?.url ?? `${RELEASES_URL}/latest`;

const links = [
  { href: '#features', label: 'Features' },
  { href: '#comicrack', label: 'ComicRack users' },
  { href: WIKI_URL, label: 'Wiki' },
  { href: REPO_URL, label: 'GitHub' },
];
---
<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href="#top" aria-label="PaperBunkr, back to top">
      <Image src={logo} alt="" width={36} height={36} densities={[1, 2]} loading="eager" />
      <span>PaperBunkr</span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav-links">
      <span class="visually-hidden">Menu</span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </button>

    <nav id="nav-links" class="links" aria-label="Main">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
      <a class="btn btn-primary nav-download" href={downloadUrl}>Download</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const links = document.getElementById('nav-links');
  if (toggle && links) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      links.classList.toggle('open', open);
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    links.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && links.classList.contains('open')) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(11, 11, 13, 0.82);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(42, 39, 35, 0.7);
  }
  .nav-inner { display: flex; align-items: center; gap: 16px; height: 68px; }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    text-decoration: none;
    margin-right: auto;
  }
  .brand span { font-family: var(--font-display); font-size: 1.6rem; letter-spacing: 0.05em; line-height: 1; padding-top: 3px; }
  .links { display: flex; align-items: center; gap: 28px; }
  .links a:not(.btn) { color: var(--muted); text-decoration: none; font-size: 0.97rem; }
  .links a:not(.btn):hover { color: var(--text); }
  .nav-download { padding: 9px 16px; font-size: 0.95rem; }

  .menu-toggle {
    display: none;
    background: none;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-s);
    color: var(--text);
    width: 42px;
    height: 42px;
    padding: 0;
    cursor: pointer;
  }
  .menu-toggle svg { width: 22px; height: 22px; margin: auto; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
  .visually-hidden {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap;
  }

  @media (max-width: 760px) {
    .menu-toggle { display: grid; }
    .links {
      display: none;
      position: absolute;
      top: 68px;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 8px var(--gutter) 20px;
      background: var(--bg-raised);
      border-bottom: 1px solid var(--line);
    }
    .links.open { display: flex; }
    .links a:not(.btn) { padding: 13px 0; border-bottom: 1px solid var(--line); font-size: 1.05rem; }
    .nav-download { margin-top: 16px; justify-content: center; }
  }
</style>
