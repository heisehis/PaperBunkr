<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:views="using:Paperbunkr.App.Views"
             xmlns:controls="using:Paperbunkr.App.Controls"
             xmlns:models="using:Paperbunkr.App.Models"
             xmlns:entities="using:Paperbunkr.Data.Entities"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="140"
             x:Class="Paperbunkr.App.Views.LibraryToolbar"
             x:DataType="vm:LibraryScreenViewModel">

    <UserControl.Styles>
        <!-- Phase 1 tokens, rounded-rect (not 999), vector icons (design §3). -->
        <Style Selector="Button.toolbarPill">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource PbSurface3Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadius}" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.toolbarPill.open">
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource PbAccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbAccentTextBrush}" />
        </Style>
        <Style Selector="Button.toolbarPill Path.pbIcon">
            <Setter Property="Stroke" Value="{DynamicResource PbTextMutedBrush}" />
        </Style>
        <Style Selector="Button.toolbarPill.open Path.pbIcon">
            <Setter Property="Stroke" Value="{DynamicResource PbAccentTextBrush}" />
        </Style>

        <Style Selector="Button.browseBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.browseBtn:disabled Path.pbIcon">
            <Setter Property="Opacity" Value="0.35" />
        </Style>

        <Style Selector="Button.addBtn">
            <Setter Property="Background" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbBadgeTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadius}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.addBtn Path.pbIcon">
            <Setter Property="Stroke" Value="{DynamicResource PbBadgeTextBrush}" />
        </Style>

        <Style Selector="Border.dropdown">
            <Setter Property="Background" Value="{DynamicResource PbSurface3Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusLg}" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="BoxShadow" Value="0 16 40 -8 #99000000" />
        </Style>
        <Style Selector="TextBlock.dropdownRow">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
            <Setter Property="Margin" Value="0,3" />
        </Style>

        <Style Selector="Button.modeOption">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.modeOption.active">
            <Setter Property="Background" Value="{DynamicResource PbAccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbAccentTextBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- Tab strip in the View & Sort popup -->
        <Style Selector="Button.viewSortTab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.viewSortTab.active">
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbAccentTextBrush}" />
        </Style>

        <!-- Removable filter / read-only state chips - squircle (PbRadius), matching the
             toolbarPill buttons rather than the fully-round DetailPills primitive. -->
        <Style Selector="Border.chip">
            <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadius}" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style Selector="Button.chipBtn">
            <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadius}" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.chipClose">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2,0,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.selAction">
            <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadius}" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Styles>

    <StackPanel>
        <!-- ============ Row 1: two-zone bar ============ -->
        <Border Padding="24,12" Background="{DynamicResource PbSurface1Brush}"
                BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Classes="browseBtn" Command="{Binding BrowsePreviousCommand}" IsEnabled="{Binding CanBrowsePrevious}"
                            ToolTip.Tip="Back" AutomationProperties.AutomationId="LibraryBrowsePreviousButton">
                        <Path Classes="pbIcon" Data="{StaticResource PbIconChevronLeft}" />
                    </Button>
                    <Button Classes="browseBtn" Command="{Binding BrowseNextCommand}" IsEnabled="{Binding CanBrowseNext}"
                            ToolTip.Tip="Forward" AutomationProperties.AutomationId="LibraryBrowseNextButton">
                        <Path Classes="pbIcon" Data="{StaticResource PbIconChevronRight}" />
                    </Button>
                </StackPanel>

                <Border Grid.Column="1" Background="{DynamicResource PbSurface3Brush}" CornerRadius="{DynamicResource PbRadius}"
                        BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1" Padding="10,0" MaxWidth="560" HorizontalAlignment="Stretch">
                    <DockPanel LastChildFill="True">
                        <Path DockPanel.Dock="Left" Classes="pbIcon" Data="{StaticResource PbIconSearch}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button DockPanel.Dock="Right" x:Name="SearchModeButton" Classes.open="{Binding IsSearchModeOpen}"
                                Background="Transparent" BorderThickness="0" Padding="6,0,0,0" FontSize="12" Cursor="Hand"
                                Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center"
                                Command="{Binding ToggleSearchModeCommand}" AutomationProperties.AutomationId="LibrarySearchModeButton"
                                AutomationProperties.Name="{Binding SearchModeLabel, StringFormat='Search: {0}'}">
                            <TextBlock Text="{Binding SearchModeLabel, StringFormat='{}{0} ▾'}" />
                        </Button>
                        <TextBox Text="{Binding SearchQuery}" PlaceholderText="Search library…" FontSize="12.5"
                                 Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                 AutomationProperties.AutomationId="LibrarySearchBox" />
                    </DockPanel>
                </Border>

                <Button Grid.Column="2" x:Name="FilterButton" Classes="toolbarPill" Classes.open="{Binding IsAddFilterOpen}"
                        Command="{Binding ToggleAddFilterCommand}" VerticalAlignment="Center"
                        AutomationProperties.AutomationId="LibraryFilterButton" AutomationProperties.Name="Filter">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Classes="pbIcon" Data="{StaticResource PbIconFilter}" />
                        <TextBlock Text="Filter" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="3" x:Name="ViewSortButton" Classes="toolbarPill" Classes.open="{Binding IsViewSortOpen}"
                        Command="{Binding ToggleViewSortCommand}" VerticalAlignment="Center"
                        AutomationProperties.AutomationId="LibraryViewSortButton"
                        AutomationProperties.Name="{Binding DisplayModeLabel, StringFormat='View and Sort: {0}'}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Classes="pbIcon" Data="{StaticResource PbIconViewSort}" />
                        <TextBlock Text="View &amp; Sort" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="4" Classes="addBtn" Command="{Binding OpenAddIssueCommand}" VerticalAlignment="Center"
                        ToolTip.Tip="Add issue to library" AutomationProperties.AutomationId="LibraryAddIssueButton" AutomationProperties.Name="Add issue">
                    <Path Classes="pbIcon" Data="{StaticResource PbIconPlus}" />
                </Button>
            </Grid>
        </Border>

        <!-- ============ Row 2: chips ============ -->
        <Border IsVisible="{Binding HasVisibleChips}" Padding="24,10,24,10"
                Background="{DynamicResource PbSurface1Brush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,0,0,1">
            <WrapPanel Orientation="Horizontal" ItemWidth="NaN">
                <Border Classes="chip" Margin="0,0,8,6" IsVisible="{Binding FilterUnreadOnly}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Unread only" FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                        <Button Classes="chipClose" Content="✕" Command="{Binding ClearUnreadFilterCommand}" />
                    </StackPanel>
                </Border>
                <Border Classes="chip" Margin="0,0,8,6" IsVisible="{Binding FilterMissingIssues}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Missing" FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                        <Button Classes="chipClose" Content="✕" Command="{Binding ClearMissingFilterCommand}" />
                    </StackPanel>
                </Border>
                <Border Classes="chip" Margin="0,0,8,6" IsVisible="{Binding FilterTrackedOnly}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Tracked" FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                        <Button Classes="chipClose" Content="✕" Command="{Binding ClearTrackedFilterCommand}" />
                    </StackPanel>
                </Border>
                <Border Classes="chip" Margin="0,0,8,6" IsVisible="{Binding ShowSearchScopeChip}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{Binding SearchScopeChipLabel, StringFormat='Search: {0}'}" FontSize="12"
                                   Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                        <Button Classes="chipClose" Content="✕" Command="{Binding ClearSearchScopeCommand}" />
                    </StackPanel>
                </Border>

                <Button Classes="chipBtn" Margin="0,0,8,6" IsVisible="{Binding IsSortNonDefault}"
                        Content="{Binding ActiveSortLabel, StringFormat='Sorted: {0}'}"
                        Command="{Binding OpenViewSortTabCommand}" CommandParameter="{x:Static vm:ViewSortTab.Sort}"
                        AutomationProperties.AutomationId="LibrarySortChip" />
                <Button Classes="chipBtn" Margin="0,0,8,6" IsVisible="{Binding ShowGroupChip}"
                        Content="{Binding ActiveGroupLabel, StringFormat='Grouped: {0}'}"
                        Command="{Binding OpenViewSortTabCommand}" CommandParameter="{x:Static vm:ViewSortTab.Group}"
                        AutomationProperties.AutomationId="LibraryGroupChip" />
            </WrapPanel>
        </Border>

        <!-- ============ Selection second row ============ -->
        <Border IsVisible="{Binding HasAnySelection}" Padding="24,10"
                Background="{DynamicResource PbAccentSoftBrush}" BorderBrush="{DynamicResource PbAccentBrush}" BorderThickness="0,1,0,1">
            <Panel>
                <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasSelection}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectionCount, StringFormat='{}{0} selected'}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                    <Button Classes="selAction" Command="{Binding BulkEditSelectionCommand}" Content="Bulk Edit" />
                    <Button Classes="selAction" Command="{Binding RunLibraryPluginsOnSelectionCommand}" Content="Find Duplicates"
                            IsVisible="{Binding HasPluginHost}" />
                    <Button Classes="selAction" Command="{Binding MarkSelectionReadCommand}" Content="Mark Read" />
                    <Button Classes="selAction" Command="{Binding MarkSelectionUnreadCommand}" Content="Mark Unread" />
                    <Button x:Name="AddToListButton" Classes="selAction" Classes.open="{Binding IsAddToListOpen}"
                            Command="{Binding ToggleAddToListCommand}" Content="Add to List ▾" />
                    <Button Classes="selAction" Command="{Binding DeleteSelectionCommand}" Content="Delete" />
                    <Button Classes="selAction" Command="{Binding ClearSelectionCommand}" Content="Clear" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasSeriesSelection}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SeriesSelectionCount, StringFormat='{}{0} series selected'}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                    <Button Classes="selAction" Command="{Binding BulkEditSeriesSelectionCommand}" Content="Bulk Edit" />
                    <Button Classes="selAction" Command="{Binding DeleteSeriesSelectionCommand}" Content="Delete" />
                    <Button Classes="selAction" Command="{Binding ClearSeriesSelectionCommand}" Content="Clear" />
                </StackPanel>
            </Panel>
        </Border>

        <!-- ============ Popups ============ -->
        <Popup PlacementTarget="{Binding #SearchModeButton}" Placement="BottomEdgeAlignedRight" VerticalOffset="6"
               IsOpen="{Binding IsSearchModeOpen}" IsLightDismissEnabled="True">
            <Border Classes="dropdown" Width="160">
                <StackPanel Spacing="1">
                    <Button Classes="modeOption" Classes.active="{Binding SearchMode, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:SearchMode.All}}"
                            Content="All" Command="{Binding SetSearchModeCommand}" CommandParameter="{x:Static entities:SearchMode.All}" AutomationProperties.AutomationId="LibrarySearchModeOption_All" />
                    <Button Classes="modeOption" Classes.active="{Binding SearchMode, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:SearchMode.Series}}"
                            Content="Series" Command="{Binding SetSearchModeCommand}" CommandParameter="{x:Static entities:SearchMode.Series}" AutomationProperties.AutomationId="LibrarySearchModeOption_Series" />
                    <Button Classes="modeOption" Classes.active="{Binding SearchMode, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:SearchMode.Writer}}"
                            Content="Writer" Command="{Binding SetSearchModeCommand}" CommandParameter="{x:Static entities:SearchMode.Writer}" AutomationProperties.AutomationId="LibrarySearchModeOption_Writer" />
                    <Button Classes="modeOption" Classes.active="{Binding SearchMode, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:SearchMode.Artists}}"
                            Content="Artists" Command="{Binding SetSearchModeCommand}" CommandParameter="{x:Static entities:SearchMode.Artists}" AutomationProperties.AutomationId="LibrarySearchModeOption_Artists" />
                    <Button Classes="modeOption" Classes.active="{Binding SearchMode, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:SearchMode.Descriptive}}"
                            Content="Descriptive" Command="{Binding SetSearchModeCommand}" CommandParameter="{x:Static entities:SearchMode.Descriptive}" AutomationProperties.AutomationId="LibrarySearchModeOption_Descriptive" />
                    <Button Classes="modeOption" Classes.active="{Binding SearchMode, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:SearchMode.File}}"
                            Content="File" Command="{Binding SetSearchModeCommand}" CommandParameter="{x:Static entities:SearchMode.File}" AutomationProperties.AutomationId="LibrarySearchModeOption_File" />
                    <Button Classes="modeOption" Classes.active="{Binding SearchMode, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:SearchMode.Catalog}}"
                            Content="Catalog" Command="{Binding SetSearchModeCommand}" CommandParameter="{x:Static entities:SearchMode.Catalog}" AutomationProperties.AutomationId="LibrarySearchModeOption_Catalog" />
                </StackPanel>
            </Border>
        </Popup>

        <Popup PlacementTarget="{Binding #FilterButton}" Placement="BottomEdgeAlignedRight" VerticalOffset="6"
               IsOpen="{Binding IsAddFilterOpen}" IsLightDismissEnabled="True">
            <Border Classes="dropdown" Width="210">
                <StackPanel Spacing="4">
                    <CheckBox Content="Unread only" FontSize="12.5" IsChecked="{Binding FilterUnreadOnly}" AutomationProperties.AutomationId="LibraryFilterUnreadOnly" />
                    <CheckBox Content="Missing issues" FontSize="12.5" IsChecked="{Binding FilterMissingIssues}" AutomationProperties.AutomationId="LibraryFilterMissingIssues" />
                    <CheckBox Content="Tracked series" FontSize="12.5" IsChecked="{Binding FilterTrackedOnly}" AutomationProperties.AutomationId="LibraryFilterTrackedOnly" />
                </StackPanel>
            </Border>
        </Popup>

        <!-- View & Sort tabbed popup (design §4) -->
        <Popup PlacementTarget="{Binding #ViewSortButton}" Placement="BottomEdgeAlignedRight" VerticalOffset="6"
               IsOpen="{Binding IsViewSortOpen}" IsLightDismissEnabled="True">
            <Border Classes="dropdown" Width="256">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="2" Margin="0,0,0,10">
                        <Button Classes="viewSortTab" Classes.active="{Binding IsViewTabActive}" Content="View"
                                Command="{Binding OpenViewSortTabCommand}" CommandParameter="{x:Static vm:ViewSortTab.View}"
                                AutomationProperties.AutomationId="LibraryViewSortTab_View" />
                        <Button Classes="viewSortTab" Classes.active="{Binding IsSortTabActive}" Content="Sort"
                                Command="{Binding OpenViewSortTabCommand}" CommandParameter="{x:Static vm:ViewSortTab.Sort}"
                                AutomationProperties.AutomationId="LibraryViewSortTab_Sort" />
                        <Button Classes="viewSortTab" Classes.active="{Binding IsGroupTabActive}" Content="Group"
                                Command="{Binding OpenViewSortTabCommand}" CommandParameter="{x:Static vm:ViewSortTab.Group}"
                                AutomationProperties.AutomationId="LibraryViewSortTab_Group" />
                    </StackPanel>

                    <ScrollViewer MaxHeight="420" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                      <Panel>
                        <!-- View tab -->
                        <StackPanel Spacing="1" IsVisible="{Binding IsViewTabActive}">
                            <TextBlock Classes="dropdownRow" Text="Display mode" Foreground="{DynamicResource PbTextBrush}" Margin="0,0,0,4" />
                            <Button Classes="modeOption" Classes.active="{Binding IsPosterGrid}" Content="Poster grid"
                                    Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static entities:LibraryViewMode.PosterGrid}" AutomationProperties.AutomationId="LibraryViewModeOption_PosterGrid" />
                            <Button Classes="modeOption" Classes.active="{Binding IsPanoramaGrid}" Content="Panorama grid"
                                    Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static entities:LibraryViewMode.PanoramaGrid}" AutomationProperties.AutomationId="LibraryViewModeOption_PanoramaGrid" />
                            <Button Classes="modeOption" Classes.active="{Binding IsListView}" Content="List"
                                    Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static entities:LibraryViewMode.List}" AutomationProperties.AutomationId="LibraryViewModeOption_List" />
                            <Button Classes="modeOption" Classes.active="{Binding IsDetailsView}" Content="Details"
                                    Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static entities:LibraryViewMode.Details}" AutomationProperties.AutomationId="LibraryViewModeOption_Details" />
                            <Button Classes="modeOption" Classes.active="{Binding IsTilesView}" Content="Tiles"
                                    Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static entities:LibraryViewMode.Tiles}" AutomationProperties.AutomationId="LibraryViewModeOption_Tiles" />
                            <Button Classes="modeOption" Classes.active="{Binding IsIssueListView}" Content="Comic List"
                                    Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static entities:LibraryViewMode.IssueList}" AutomationProperties.AutomationId="LibraryViewModeOption_IssueList" />

                            <Border Height="1" Background="{DynamicResource PbBorderBrush}" Margin="0,10" />

                            <TextBlock Classes="dropdownRow" Text="Card content" Foreground="{DynamicResource PbTextBrush}" Margin="0,0,0,4" />
                            <Button Classes="modeOption" Classes.active="{Binding IsIssueGranularity}" Content="Per-issue tiles"
                                    Command="{Binding SetGranularityCommand}" CommandParameter="{x:Static entities:LibraryContentGranularity.Issue}" AutomationProperties.AutomationId="LibraryGranularityOption_Issue" />
                            <Button Classes="modeOption" Classes.active="{Binding IsSeriesGranularity}" Content="Series cards"
                                    Command="{Binding SetGranularityCommand}" CommandParameter="{x:Static entities:LibraryContentGranularity.Series}" AutomationProperties.AutomationId="LibraryGranularityOption_Series" />

                            <Border Height="1" Background="{DynamicResource PbBorderBrush}" Margin="0,10" />

                            <CheckBox Content="Show titles" IsChecked="{Binding ShowTileTitles}" Margin="0,2,0,0"
                                      IsVisible="{Binding IsPosterGrid}" AutomationProperties.AutomationId="LibraryShowTitlesToggle" />
                            <TextBlock Classes="dropdownRow" Text="Grid density" Foreground="{DynamicResource PbTextBrush}" Margin="0,6,0,0"
                                       IsVisible="{Binding IsPosterGrid}" />
                            <Slider Minimum="0.6" Maximum="1.6" Value="{Binding GridDensity}" IsVisible="{Binding IsPosterGrid}" />

                            <Border Height="1" Background="{DynamicResource PbBorderBrush}" Margin="0,10" />

                            <TextBlock Classes="dropdownRow" Text="Overlay" Foreground="{DynamicResource PbTextBrush}" Margin="0,0,0,4" />
                            <CheckBox Content="Unread badge" FontSize="12.5" IsChecked="{Binding ShowUnreadBadge}" />
                            <CheckBox Content="Publisher badge" FontSize="12.5" IsChecked="{Binding ShowPublisherBadge}" />
                            <CheckBox Content="Language badge" FontSize="12.5" IsChecked="{Binding ShowLanguageBadge}" />
                            <CheckBox Content="Use language icon" FontSize="12.5" IsChecked="{Binding UseLanguageIcon}" />
                            <CheckBox Content="Continue reading button" FontSize="12.5" IsChecked="{Binding ShowContinueReadingButton}"
                                      IsVisible="{Binding IsSeriesGranularity}" />
                        </StackPanel>

                        <!-- Sort tab -->
                        <StackPanel Spacing="1" IsVisible="{Binding IsSortTabActive}">
                            <StackPanel Spacing="1" IsVisible="{Binding IsIssueGranularity}">
                                <ItemsControl ItemsSource="{Binding IssueList.SortFieldOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:IssueListSortFieldDescriptor">
                                            <Button Classes="modeOption"
                                                    Classes.active="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).IssueList.SortField, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={Binding Field}}"
                                                    Content="{Binding DisplayName}"
                                                    Command="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).IssueList.SetSortFieldCommand}"
                                                    CommandParameter="{Binding Field}"
                                                    AutomationProperties.AutomationId="{Binding Field, StringFormat='ComicListSortOption_{0}'}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Height="1" Background="{DynamicResource PbBorderBrush}" Margin="0,8" />
                                <Button Classes="modeOption" Classes.active="{Binding IssueList.SortDirection, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:SortDirection.Ascending}}"
                                        Content="↑ Ascending" Command="{Binding IssueList.ToggleSortDirectionCommand}" AutomationProperties.AutomationId="ComicListSortAscending" />
                                <Button Classes="modeOption" Classes.active="{Binding IssueList.SortDirection, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:SortDirection.Descending}}"
                                        Content="↓ Descending" Command="{Binding IssueList.ToggleSortDirectionCommand}" AutomationProperties.AutomationId="ComicListSortDescending" />
                            </StackPanel>
                            <StackPanel Spacing="1" IsVisible="{Binding IsSeriesGranularity}">
                                <Button Classes="modeOption" Classes.active="{Binding SortField, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:LibrarySortField.Name}}"
                                        Content="Name" Command="{Binding SetSortFieldCommand}" CommandParameter="{x:Static entities:LibrarySortField.Name}" AutomationProperties.AutomationId="LibrarySortOption_Name" />
                                <Button Classes="modeOption" Classes.active="{Binding SortField, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:LibrarySortField.DateAdded}}"
                                        Content="Date Added" Command="{Binding SetSortFieldCommand}" CommandParameter="{x:Static entities:LibrarySortField.DateAdded}" AutomationProperties.AutomationId="LibrarySortOption_DateAdded" />
                                <Button Classes="modeOption" Classes.active="{Binding SortField, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:LibrarySortField.LastRead}}"
                                        Content="Last Read" Command="{Binding SetSortFieldCommand}" CommandParameter="{x:Static entities:LibrarySortField.LastRead}" AutomationProperties.AutomationId="LibrarySortOption_LastRead" />
                                <Button Classes="modeOption" Classes.active="{Binding SortField, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:LibrarySortField.Size}}"
                                        Content="Size" Command="{Binding SetSortFieldCommand}" CommandParameter="{x:Static entities:LibrarySortField.Size}" AutomationProperties.AutomationId="LibrarySortOption_Size" />
                                <Button Classes="modeOption" Classes.active="{Binding SortField, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:LibrarySortField.IssueCount}}"
                                        Content="Issue Count" Command="{Binding SetSortFieldCommand}" CommandParameter="{x:Static entities:LibrarySortField.IssueCount}" AutomationProperties.AutomationId="LibrarySortOption_IssueCount" />
                                <Button Classes="modeOption" Classes.active="{Binding SortField, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:LibrarySortField.UnreadCount}}"
                                        Content="Unread Count" Command="{Binding SetSortFieldCommand}" CommandParameter="{x:Static entities:LibrarySortField.UnreadCount}" AutomationProperties.AutomationId="LibrarySortOption_UnreadCount" />
                                <Button Classes="modeOption" Classes.active="{Binding SortField, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:LibrarySortField.Publisher}}"
                                        Content="Publisher" Command="{Binding SetSortFieldCommand}" CommandParameter="{x:Static entities:LibrarySortField.Publisher}" AutomationProperties.AutomationId="LibrarySortOption_Publisher" />
                                <Border Height="1" Background="{DynamicResource PbBorderBrush}" Margin="0,8" />
                                <Button Classes="modeOption" Classes.active="{Binding SortDirection, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:SortDirection.Ascending}}"
                                        Content="↑ Ascending" Command="{Binding ToggleSortDirectionCommand}" AutomationProperties.AutomationId="LibrarySortAscending" />
                                <Button Classes="modeOption" Classes.active="{Binding SortDirection, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:SortDirection.Descending}}"
                                        Content="↓ Descending" Command="{Binding ToggleSortDirectionCommand}" AutomationProperties.AutomationId="LibrarySortDescending" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Group tab -->
                        <StackPanel Spacing="1" IsVisible="{Binding IsGroupTabActive}">
                            <StackPanel Spacing="1" IsVisible="{Binding IsIssueGranularity}">
                                <Button Classes="modeOption" Classes.active="{Binding IssueList.GroupField, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:IssueListGroupField.None}}"
                                        Content="None" Command="{Binding IssueList.SetGroupFieldCommand}" CommandParameter="{x:Static entities:IssueListGroupField.None}" AutomationProperties.AutomationId="ComicListGroupOption_None" />
                                <ItemsControl ItemsSource="{Binding IssueList.GroupFieldOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:IssueListGroupFieldDescriptor">
                                            <Button Classes="modeOption"
                                                    Classes.active="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).IssueList.GroupField, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={Binding Field}}"
                                                    Content="{Binding DisplayName}"
                                                    Command="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).IssueList.SetGroupFieldCommand}"
                                                    CommandParameter="{Binding Field}"
                                                    AutomationProperties.AutomationId="{Binding Field, StringFormat='ComicListGroupOption_{0}'}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Spacing="1" IsVisible="{Binding IsSeriesGranularity}">
                                <Button Classes="modeOption" Classes.active="{Binding GroupField, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:LibraryGroupField.None}}"
                                        Content="None" Command="{Binding SetGroupFieldCommand}" CommandParameter="{x:Static entities:LibraryGroupField.None}" AutomationProperties.AutomationId="LibraryGroupOption_None" />
                                <Button Classes="modeOption" Classes.active="{Binding GroupField, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:LibraryGroupField.ContentType}}"
                                        Content="Content Type" Command="{Binding SetGroupFieldCommand}" CommandParameter="{x:Static entities:LibraryGroupField.ContentType}" AutomationProperties.AutomationId="LibraryGroupOption_ContentType" />
                                <Button Classes="modeOption" Classes.active="{Binding GroupField, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:LibraryGroupField.Publisher}}"
                                        Content="Publisher" Command="{Binding SetGroupFieldCommand}" CommandParameter="{x:Static entities:LibraryGroupField.Publisher}" AutomationProperties.AutomationId="LibraryGroupOption_Publisher" />
                                <Button Classes="modeOption" Classes.active="{Binding GroupField, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:LibraryGroupField.Alphabetical}}"
                                        Content="Alphabetical" Command="{Binding SetGroupFieldCommand}" CommandParameter="{x:Static entities:LibraryGroupField.Alphabetical}" AutomationProperties.AutomationId="LibraryGroupOption_Alphabetical" />
                            </StackPanel>
                        </StackPanel>
                      </Panel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>

        <Popup PlacementTarget="{Binding #AddToListButton}" Placement="BottomEdgeAlignedLeft" VerticalOffset="6"
               IsOpen="{Binding IsAddToListOpen}" IsLightDismissEnabled="True">
            <Border Classes="dropdown" Width="220">
                <StackPanel Spacing="1">
                    <Button Classes="modeOption" Content="+ New Reading List…" Command="{Binding CreateReadingListAndAddSelectionCommand}" />
                    <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,0,0,1" Margin="0,4" />
                    <ItemsControl ItemsSource="{Binding ReadingLists}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ReadingListOption">
                                <Button Classes="modeOption"
                                        Content="{Binding Name}"
                                        Command="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).AddSelectionToReadingListCommand}"
                                        CommandParameter="{Binding Id}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
