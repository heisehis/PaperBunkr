<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:models="using:Paperbunkr.App.Models"
             xmlns:views="using:Paperbunkr.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="260"
             x:Class="Paperbunkr.App.Views.Home.CollectionHeroCard"
             x:Name="ThisControl"
             x:DataType="models:HomeCollectionCard">

    <!-- The Continue hero of the Home Collections shelf (docs/superpowers/specs/2026-11-06-collection-surfaces-design.md): the collection you read from most
         recently, as a cover tile plus a Continue button for its next unread issue. The tile opens the collection; Continue is a real Button, so its press never
         reaches the tile. DataContext is the HomeCollectionCard; commands arrive through OpenCommand / ContinueCommand. -->
    <Border CornerRadius="{DynamicResource PbRadiusLg}" Background="{DynamicResource PbSurface2Brush}"
            BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1" Padding="12"
            AutomationProperties.AutomationId="CollectionHeroCard">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
            <views:PosterTile Grid.Column="0"
                              CoverSource="{Binding CoverImage}" MosaicSources="{Binding MosaicCovers}" FanSources="{Binding FanCovers}"
                              RingFraction="{Binding RingFraction}" RingText="{Binding RingText}"
                              TitleText="{Binding Name}" BadgeText="{Binding Count, StringFormat='{}{0}'}"
                              Command="{Binding #ThisControl.OpenCommand}" CommandParameter="{Binding}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8" MinWidth="180" MaxWidth="260">
                <TextBlock Classes="pbTextOverline" Text="PICK UP WHERE YOU LEFT OFF" />
                <TextBlock Classes="pbTextTitle" Text="{Binding Name}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="pbTextMeta" IsVisible="{Binding HasContinue}" Text="{Binding ContinueLabel, StringFormat='Next: {0}'}" TextWrapping="Wrap" />
                <TextBlock Classes="pbTextMeta" IsVisible="{Binding !HasContinue}" Text="Everything here is read." />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="primary" IsVisible="{Binding HasContinue}" Command="{Binding #ThisControl.ContinueCommand}" CommandParameter="{Binding}"
                            AutomationProperties.AutomationId="CollectionHeroContinue"
                            AutomationProperties.Name="{Binding ContinueLabel, StringFormat='Continue {0}'}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <fi:SymbolIcon Symbol="Play" FontSize="{StaticResource PbIconSizeXs}" />
                            <TextBlock Text="Continue" />
                        </StackPanel>
                    </Button>
                    <Button Classes="ghost" Content="Open" Command="{Binding #ThisControl.OpenCommand}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding Name, StringFormat='Open {0}'}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
