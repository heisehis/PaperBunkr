<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:controls="using:Paperbunkr.App.Controls"
             mc:Ignorable="d" d:DesignWidth="680" d:DesignHeight="560"
             x:Class="Paperbunkr.App.Views.LegalDocumentViewerOverlay"
             x:DataType="vm:PreferencesScreenViewModel">

    <!--
        The legal/notice document viewer (docs/superpowers/specs/2026-09-26-about-polish-design.md §6), hosted by OverlayShell with
        its own close button in the header row (the shell's corner button sized its cell around the wrapped text and landed
        mid-card - 2026-09-07 fix). The body is the shared MarkdownView: paragraphs reflow, text is selectable, links to another
        bundled document swap this viewer's content, web links open the browser. LICENSE is shown verbatim in a monospaced font.
    -->
    <!-- The document keeps its own named scroller (code-behind scrolls it to the top on a document swap), so the card body doesn't scroll. -->
    <controls:DialogCard Title="{Binding SelectedLegalDocumentTitle}" Size="Large" IsBodyScrollable="False"
                         Subtitle="{Binding SelectedLegalDocumentUpdated, StringFormat='Last updated {0}'}"
                         CloseCommand="{Binding CloseLegalDocumentViewerCommand}">
        <ScrollViewer Name="BodyScroller" HorizontalScrollBarVisibility="Disabled">
            <controls:MarkdownView Blocks="{Binding SelectedLegalDocumentBlocks}" BaseFontSize="13"
                                   LinkCommand="{Binding OpenLegalLinkCommand}" Margin="0,0,14,4" />
        </ScrollViewer>
        <controls:DialogCard.Footer>
            <StackPanel>
                <Button Classes="ghost" Command="{Binding CopyLegalDocumentCommand}" ToolTip.Tip="Copy the whole document"
                        AutomationProperties.AutomationId="LegalDocumentViewerCopyButton">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Panel>
                            <fi:SymbolIcon Symbol="Copy" FontSize="{StaticResource PbIconSizeXs}" IsVisible="{Binding !LegalDocumentCopied}" />
                            <fi:SymbolIcon Symbol="Checkmark" FontSize="{StaticResource PbIconSizeXs}" IsVisible="{Binding LegalDocumentCopied}"
                                           Foreground="{DynamicResource PbSuccessBrush}" />
                        </Panel>
                        <Panel>
                            <TextBlock Text="Copy text" IsVisible="{Binding !LegalDocumentCopied}" />
                            <TextBlock Text="Copied" IsVisible="{Binding LegalDocumentCopied}" />
                        </Panel>
                    </StackPanel>
                </Button>
            </StackPanel>
        </controls:DialogCard.Footer>
    </controls:DialogCard>
</UserControl>
