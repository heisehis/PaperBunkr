<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dev-only console harness for docs/superpowers/specs/2026-09-28-guided-view-detection-upgrade-design.md.
       NOT in Paperbunkr.sln, not built by CI or the installer. Read-only against the comics folder.
       It links the Avalonia-free detector sources instead of referencing the app, so it builds in seconds.
       Run by hand: dotnet run with the project path tools/Paperbunkr.PanelHarness and the harness arguments (see Program.cs). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Paperbunkr.App\Services\Reader\Panels\PanelDetector.cs" Link="Linked\PanelDetector.cs" />
    <Compile Include="..\..\src\Paperbunkr.App\Services\Reader\Panels\SkPanelAnalyzer.cs" Link="Linked\SkPanelAnalyzer.cs" />
    <Compile Include="..\..\src\Paperbunkr.App\Services\Reader\Panels\PanelOrdering.cs" Link="Linked\PanelOrdering.cs" />
    <Compile Include="..\..\src\Paperbunkr.App\Services\Reader\Panels\OnnxPanelDetector.cs" Link="Linked\OnnxPanelDetector.cs" />
    <Compile Include="..\..\src\Paperbunkr.App\Services\Reader\Panels\PanelDetectionService.cs" Link="Linked\PanelDetectionService.cs" />
  </ItemGroup>

</Project>
