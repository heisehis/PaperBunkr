<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless acquisition daemon (docs/superpowers/specs/2026-09-19-comic-acquisition-daemon-design.md §3).
       Rule: NEVER reference Avalonia here - AcquisitionDaemonBoundaryTests enforces it, so the daemon can
       later be extracted into a headless host. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Paperbunkr.Daemon</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paperbunkr.Data\Paperbunkr.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Paperbunkr.Daemon.Tests" />
    <InternalsVisibleTo Include="Paperbunkr.App" />
    <InternalsVisibleTo Include="Paperbunkr.App.Tests" />
  </ItemGroup>

</Project>
