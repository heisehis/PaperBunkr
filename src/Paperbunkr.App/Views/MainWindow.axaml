<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Paperbunkr.App.ViewModels"
        xmlns:views="using:Paperbunkr.App.Views"
        xmlns:models="using:Paperbunkr.App.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
        x:Class="Paperbunkr.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/paperbunkr.ico"
        Title="Paperbunkr"
        Width="1200" Height="760"
        Background="{DynamicResource PbBgBrush}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- P5 (docs/alpha-roadmap.md) - single app-wide Esc-to-close/cancel binding, routed through
         MainViewModel.EscapeCommand rather than per-screen handlers since none of Migration/Issue
         Properties/Bulk Editing are real Windows/Popups with native dialog-Escape behavior. -->
    <Window.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding EscapeCommand}" />
    </Window.KeyBindings>

    <Window.Styles>
        <!-- Rail nav button: 44x44, rounded, active state = accent-soft fill + accent text -->
        <Style Selector="Button.rail">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextFaintBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.rail:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PbAccentSoftBrush}" />
        </Style>
        <Style Selector="Button.rail.active">
            <Setter Property="Background" Value="{DynamicResource PbAccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbAccentTextBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.rail.plugin">
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
        </Style>

        <!-- Rail nav icon: follows the button's own Foreground so the existing
             pointerover/active Setters (below) recolor the icon along with everything else. -->
        <Style Selector="Button.rail Border.icon">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Background" Value="{DynamicResource PbTextFaintBrush}" />
        </Style>
        <Style Selector="Button.rail:pointerover Border.icon">
            <Setter Property="Background" Value="{DynamicResource PbTextFaintBrush}" />
        </Style>
        <Style Selector="Button.rail.active Border.icon">
            <Setter Property="Background" Value="{DynamicResource PbAccentTextBrush}" />
        </Style>

        <!-- Sidebar nav row -->
        <Style Selector="Button.sideItemButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.sideItemButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PbAccentSoftBrush}" />
        </Style>
        <Style Selector="Button.sideItemButton.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PbAccentSoftBrush}" />
        </Style>
        <Style Selector="Button.sideItemButton.active TextBlock.sideItemLabel">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
        </Style>

        <Style Selector="TextBlock.sideHeading">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextFaintBrush}" />
        </Style>

        <Style Selector="TextBlock.count">
            <Setter Property="FontFamily" Value="Consolas,monospace" />
            <Setter Property="FontSize" Value="10.5" />
        </Style>

        <Style Selector="Border.countBadge">
            <Setter Property="Background" Value="#30353F" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Discard-confirm banner buttons, styled to match IssuePropertiesScreen's headerAction ghost/primary pair -->
        <Style Selector="Button.discardConfirm">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.discardConfirm.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
        </Style>
        <Style Selector="Button.discardConfirm.primary">
            <Setter Property="Background" Value="#D96C6C" />
            <Setter Property="BorderBrush" Value="#D96C6C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#241505" />
        </Style>
    </Window.Styles>

    <Grid>
    <DockPanel LastChildFill="True">

        <!-- ============ Rail nav (64px) ============ -->
        <!-- Real bug, found via manual testing: the Reader's own fullscreen toggle (docs/superpowers/
             specs/2026-08-10-reader-polish-continuous-scroll-chrome-overlays-design.md §7) only sets
             Window.WindowState - it has no reach into MainWindow's own persistent rail nav, which
             lives here as a sibling of the Reader's ContentControl, not inside ReaderScreen's own
             visual tree. Hidden directly off Reader.IsFullscreen (a stable ReaderScreenViewModel
             instance, per MainViewModel.Reader) rather than adding a MainViewModel-level mirror
             property - one source of truth. -->
        <Border DockPanel.Dock="Left" Width="64" Background="{DynamicResource PbChromeBrush}"
                BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,0,1,0"
                IsVisible="{Binding !Reader.IsFullscreen}">
            <Grid RowDefinitions="Auto,*,Auto" Margin="0,14,0,10">

                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="2">
                    <Border Width="26" Height="26" CornerRadius="6" BorderThickness="1.5"
                            BorderBrush="{DynamicResource PbAccentBrush}" Margin="0,0,0,12" />

                    <Button Classes="rail" Classes.active="{Binding IsLibrary}"
                            Command="{Binding GoLibraryCommand}" ToolTip.Tip="Library">
                        <Border Classes="icon">
                            <Border.OpacityMask>
                                <ImageBrush Source="/Assets/Icons/Book.png" Stretch="Uniform" />
                            </Border.OpacityMask>
                        </Border>
                    </Button>
                    <Button Classes="rail" Classes.active="{Binding IsBooks}"
                            Command="{Binding GoBooksCommand}" ToolTip.Tip="Books">
                        <Border Classes="icon">
                            <Border.OpacityMask>
                                <ImageBrush Source="/Assets/Icons/Layers.png" Stretch="Uniform" />
                            </Border.OpacityMask>
                        </Border>
                    </Button>
                    <Button Classes="rail" Classes.active="{Binding IsSmart}"
                            Command="{Binding GoSmartCommand}" ToolTip.Tip="Smart Lists">
                        <Border Classes="icon">
                            <Border.OpacityMask>
                                <ImageBrush Source="/Assets/Icons/Filter.png" Stretch="Uniform" />
                            </Border.OpacityMask>
                        </Border>
                    </Button>
                    <Button Classes="rail" Classes.active="{Binding IsReading}"
                            Command="{Binding GoReadingCommand}" ToolTip.Tip="Reading Lists">
                        <Border Classes="icon">
                            <Border.OpacityMask>
                                <ImageBrush Source="/Assets/Icons/Bookmark.png" Stretch="Uniform" />
                            </Border.OpacityMask>
                        </Border>
                    </Button>
                    <Button Classes="rail" Classes.active="{Binding IsEvents}"
                            Command="{Binding GoEventsCommand}" ToolTip.Tip="Story Events">
                        <Border Classes="icon">
                            <Border.OpacityMask>
                                <ImageBrush Source="/Assets/Icons/Star.png" Stretch="Uniform" />
                            </Border.OpacityMask>
                        </Border>
                    </Button>

                    <Border Width="28" Height="1" Background="{DynamicResource PbBorderBrush}" Margin="0,8" />

                    <Button Classes="rail plugin" Classes.active="{Binding IsPlugin}"
                            Command="{Binding GoPluginCommand}" ToolTip.Tip="Plugins">
                        <Border Classes="icon">
                            <Border.OpacityMask>
                                <ImageBrush Source="/Assets/Icons/Puzzle.png" Stretch="Uniform" />
                            </Border.OpacityMask>
                        </Border>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2" HorizontalAlignment="Center" Spacing="2">
                    <Button Classes="rail" Classes.active="{Binding IsPreferences}"
                            Command="{Binding GoPreferencesCommand}" ToolTip.Tip="Preferences">
                        <Border Classes="icon">
                            <Border.OpacityMask>
                                <ImageBrush Source="/Assets/Icons/Settings.png" Stretch="Uniform" />
                            </Border.OpacityMask>
                        </Border>
                    </Button>
                    <Button Classes="rail" Classes.active="{Binding IsReader}"
                            Command="{Binding GoReaderCommand}" ToolTip.Tip="Reader">
                        <Border Classes="icon">
                            <Border.OpacityMask>
                                <ImageBrush Source="/Assets/Icons/Book_Open.png" Stretch="Uniform" />
                            </Border.OpacityMask>
                        </Border>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Contextual sidebar (236px) ============ -->
        <Border DockPanel.Dock="Left" Width="236" Background="{DynamicResource PbChromeBrush}"
                BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,0,1,0"
                IsVisible="{Binding ShowContextualSidebar}">
            <ScrollViewer Padding="12,18">
                <StackPanel Spacing="2">

                    <!-- Library sidebar content -->
                    <StackPanel IsVisible="{Binding IsLibrary}" Spacing="2">
                        <TextBlock Text="Library" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource PbTextBrush}" Margin="8,0,8,14" />

                        <Button Classes="sideItemButton" Classes.active="{Binding Library.IsAllSeriesActive}"
                                Command="{Binding Library.SelectAllSeriesCommand}">
                            <Grid ColumnDefinitions="8,*,Auto">
                                <Border Grid.Column="0" Width="8" Height="8" CornerRadius="2"
                                        Background="{DynamicResource PbAccentTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="sideItemLabel" Text="All Series" Margin="9,0,0,0" FontSize="13"
                                           Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Classes="count" Text="{Binding Library.AllSeriesCount}"
                                           Foreground="{DynamicResource PbTextFaintBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <TextBlock Classes="sideHeading" Text="COLLECTIONS" Margin="8,12,8,6" />
                        <TextBlock Text="No collections yet." FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}"
                                   Margin="8,0,8,4" IsVisible="{Binding !Library.HasCollections}" />
                        <ItemsControl x:Name="LibraryCollections" ItemsSource="{Binding Library.Collections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:CategorySummary">
                                    <Button Classes="sideItemButton" Classes.active="{Binding IsActive}"
                                            Command="{Binding #LibraryCollections.((vm:MainViewModel)DataContext).Library.SelectCollectionCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Classes="sideItemLabel" Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource PbTextMutedBrush}" />
                                            <TextBlock Grid.Column="1" Classes="count" Text="{Binding Count}" Foreground="{DynamicResource PbTextFaintBrush}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Height="1" Background="{DynamicResource PbBorderBrush}" Margin="0,12" />

                        <TextBlock Classes="sideHeading" Text="CONTENT TYPE" Margin="8,0,8,6" />

                        <ItemsControl x:Name="LibraryContentTypes" ItemsSource="{Binding Library.ContentTypes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ContentTypeSummary">
                                    <Button Classes="sideItemButton" Classes.active="{Binding IsActive}"
                                            Command="{Binding #LibraryContentTypes.((vm:MainViewModel)DataContext).Library.SelectContentTypeCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Classes="sideItemLabel" Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource PbTextMutedBrush}" />
                                            <TextBlock Grid.Column="1" Classes="count" Text="{Binding Count}" Foreground="{DynamicResource PbTextFaintBrush}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Smart Lists sidebar (SmartSidebar.dc.html), wired to real SmartList data -->
                    <StackPanel IsVisible="{Binding IsSmart}" Spacing="1">
                        <TextBlock Text="Smart Lists" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource PbTextBrush}" Margin="8,0,8,14" />

                        <ItemsControl x:Name="BuiltInSmartLists" ItemsSource="{Binding Smart.BuiltInLists}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:SmartListSummary">
                                    <Button Classes="sideItemButton" Classes.active="{Binding IsActive}"
                                            Command="{Binding #BuiltInSmartLists.((vm:MainViewModel)DataContext).Smart.SelectListCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Classes="sideItemLabel" Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource PbTextMutedBrush}" />
                                            <Border Grid.Column="1" Classes="countBadge"><TextBlock Classes="count" Text="{Binding MatchCount}" Foreground="{DynamicResource PbTextFaintBrush}" /></Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Classes="sideHeading" Text="CUSTOM" Margin="8,12,8,6" />

                        <ItemsControl x:Name="CustomSmartLists" ItemsSource="{Binding Smart.CustomLists}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:SmartListSummary">
                                    <Button Classes="sideItemButton" Classes.active="{Binding IsActive}"
                                            Command="{Binding #CustomSmartLists.((vm:MainViewModel)DataContext).Smart.SelectListCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Classes="sideItemLabel" Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource PbTextMutedBrush}" />
                                            <Border Grid.Column="1" Classes="countBadge"><TextBlock Classes="count" Text="{Binding MatchCount}" Foreground="{DynamicResource PbTextFaintBrush}" /></Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Classes="sideItemButton" Command="{Binding Smart.ToggleMaintenanceCommand}"
                                Padding="8,7" HorizontalContentAlignment="Left">
                            <Panel>
                                <TextBlock Text="▾ Maintenance" FontSize="13" Foreground="{DynamicResource PbTextMutedBrush}"
                                           IsVisible="{Binding Smart.IsMaintenanceExpanded}" />
                                <TextBlock Text="▸ Maintenance" FontSize="13" Foreground="{DynamicResource PbTextMutedBrush}"
                                           IsVisible="{Binding !Smart.IsMaintenanceExpanded}" />
                            </Panel>
                        </Button>
                        <StackPanel Margin="14,0,0,0" Spacing="0" IsVisible="{Binding Smart.IsMaintenanceExpanded}">
                            <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1,0,0,0" Padding="10,0,0,0">
                                <ItemsControl x:Name="MaintenanceSmartLists" ItemsSource="{Binding Smart.MaintenanceLists}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:SmartListSummary">
                                            <Button Classes="sideItemButton" Classes.active="{Binding IsActive}"
                                                    Command="{Binding #MaintenanceSmartLists.((vm:MainViewModel)DataContext).Smart.SelectListCommand}"
                                                    CommandParameter="{Binding}">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Classes="sideItemLabel" Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource PbTextMutedBrush}" />
                                                    <TextBlock Grid.Column="1" Classes="count" Text="{Binding MatchCount}" Foreground="{DynamicResource PbTextFaintBrush}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>

                        <Border BorderThickness="1" BorderBrush="#383D47" CornerRadius="5" Margin="0,12,0,0" Padding="8">
                            <Button Classes="sideItemButton" HorizontalContentAlignment="Center"
                                    Command="{Binding Smart.CreateNewCommand}"
                                    Foreground="{DynamicResource PbTextFaintBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <Border Classes="icon" Width="11" Height="11" Background="{DynamicResource PbTextFaintBrush}">
                                        <Border.OpacityMask>
                                            <ImageBrush Source="/Assets/Icons/Add_Plus.png" Stretch="Uniform" />
                                        </Border.OpacityMask>
                                    </Border>
                                    <TextBlock Text="New Smart List" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </Border>
                    </StackPanel>

                    <!-- Reading Lists sidebar (ReadingSidebar.dc.html), wired to real ReadingList data -->
                    <StackPanel IsVisible="{Binding IsReading}" Spacing="1">
                        <TextBlock Text="Reading Lists" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource PbTextBrush}" Margin="8,0,8,14" />

                        <ItemsControl x:Name="ReadingLists" ItemsSource="{Binding Reading.Lists}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ReadingListSummary">
                                    <Button Classes="sideItemButton" Classes.active="{Binding IsActive}"
                                            Command="{Binding #ReadingLists.((vm:MainViewModel)DataContext).Reading.SelectListCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Classes="sideItemLabel" Text="{Binding Name}" FontSize="13"
                                                       Foreground="{DynamicResource PbTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="1" Classes="countBadge"><TextBlock Classes="count" Text="{Binding TotalCount}" Foreground="{DynamicResource PbTextFaintBrush}" /></Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border BorderThickness="1" BorderBrush="#383D47" CornerRadius="5" Margin="0,12,0,0" Padding="8">
                            <Button Classes="sideItemButton" HorizontalContentAlignment="Center"
                                    Command="{Binding Reading.CreateNewCommand}"
                                    Foreground="{DynamicResource PbTextFaintBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <Border Classes="icon" Width="11" Height="11" Background="{DynamicResource PbTextFaintBrush}">
                                        <Border.OpacityMask>
                                            <ImageBrush Source="/Assets/Icons/Add_Plus.png" Stretch="Uniform" />
                                        </Border.OpacityMask>
                                    </Border>
                                    <TextBlock Text="New Reading List" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </Border>
                    </StackPanel>

                    <!-- Story Events sidebar (docs/superpowers/specs/2026-08-17-metadata-model-
                         phase4b-story-events-design.md), wired to real StoryEvent data -->
                    <StackPanel IsVisible="{Binding IsEvents}" Spacing="1">
                        <TextBlock Text="Story Events" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource PbTextBrush}" Margin="8,0,8,14" />

                        <ItemsControl x:Name="StoryEvents" ItemsSource="{Binding Events.Events}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:StoryEventSummary">
                                    <Button Classes="sideItemButton" Classes.active="{Binding IsActive}"
                                            Command="{Binding #StoryEvents.((vm:MainViewModel)DataContext).Events.SelectEventCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Classes="sideItemLabel" Text="{Binding Name}" FontSize="13"
                                                       Foreground="{DynamicResource PbTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="1" Classes="countBadge"><TextBlock Classes="count" Text="{Binding MemberCount}" Foreground="{DynamicResource PbTextFaintBrush}" /></Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border BorderThickness="1" BorderBrush="#383D47" CornerRadius="5" Margin="0,12,0,0" Padding="8">
                            <Button Classes="sideItemButton" HorizontalContentAlignment="Center"
                                    Command="{Binding Events.CreateNewCommand}"
                                    Foreground="{DynamicResource PbTextFaintBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <Border Classes="icon" Width="11" Height="11" Background="{DynamicResource PbTextFaintBrush}">
                                        <Border.OpacityMask>
                                            <ImageBrush Source="/Assets/Icons/Add_Plus.png" Stretch="Uniform" />
                                        </Border.OpacityMask>
                                    </Border>
                                    <TextBlock Text="New Story Event" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ============ Main content ============ -->
        <Grid>
            <ContentControl IsVisible="{Binding IsLibrary}" Content="{Binding Library}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:LibraryScreenViewModel">
                        <views:LibraryScreen />
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
            <ContentControl IsVisible="{Binding IsBooks}" Content="{Binding Books}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:BooksScreenViewModel">
                        <views:BooksScreen />
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
            <ContentControl IsVisible="{Binding IsBookReader}" Content="{Binding BookReader}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:BookReaderScreenViewModel">
                        <views:BookReaderScreen />
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
            <ContentControl IsVisible="{Binding IsPdfReader}" Content="{Binding PdfReader}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:PdfPageReaderScreenViewModel">
                        <views:PdfPageReaderScreen />
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
            <ContentControl IsVisible="{Binding IsDetail}" Content="{Binding Detail}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:DetailScreenViewModel">
                        <views:DetailScreen />
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
            <ContentControl IsVisible="{Binding IsSmart}" Content="{Binding Smart}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:SmartScreenViewModel">
                        <views:SmartScreen />
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
            <ContentControl IsVisible="{Binding IsReading}" Content="{Binding Reading}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:ReadingScreenViewModel">
                        <views:ReadingScreen />
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
            <ContentControl IsVisible="{Binding IsEvents}" Content="{Binding Events}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:EventsScreenViewModel">
                        <views:EventsScreen />
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
            <ContentControl IsVisible="{Binding IsPlugin}" Content="{Binding Plugin}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:PluginScreenViewModel">
                        <views:PluginScreen />
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
            <ContentControl IsVisible="{Binding IsPreferences}" Content="{Binding Preferences}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:PreferencesScreenViewModel">
                        <views:PreferencesScreen />
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
            <ContentControl IsVisible="{Binding IsReader}" Content="{Binding Reader}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:ReaderScreenViewModel">
                        <views:ReaderScreen />
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
            <ContentControl IsVisible="{Binding IsIssueProperties}" Content="{Binding IssueProperties}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:IssuePropertiesScreenViewModel">
                        <views:IssuePropertiesScreen />
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
            <ContentControl IsVisible="{Binding IsBulkIssueProperties}" Content="{Binding BulkIssueProperties}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:BulkIssuePropertiesScreenViewModel">
                        <views:BulkIssuePropertiesScreen />
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Grid>

    </DockPanel>

    <!-- ============ Migration overlay (docs/superpowers/specs/2026-08-06-migration-ux-design.md §B) ============ -->
    <Border IsVisible="{Binding IsMigrationOverlayOpen}" Background="#B0000000">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <views:MigrationOverlay DataContext="{Binding Migration}" />
            <Button Classes="rail" Width="28" Height="28"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-14,0"
                    Background="{DynamicResource PbChromeBrush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1"
                    Command="{Binding CloseMigrationOverlayCommand}" ToolTip.Tip="Close"
                    AutomationProperties.AutomationId="MigrationOverlayCloseButton">
                <Border Classes="icon" Width="13" Height="13">
                    <Border.OpacityMask>
                        <ImageBrush Source="/Assets/Icons/Close_Circle.png" Stretch="Uniform" />
                    </Border.OpacityMask>
                </Border>
            </Button>
        </Grid>
    </Border>

    <!-- ============ Unsaved-changes discard confirm (P6 follow-up, docs/alpha-todo.md) - guards
         the rail nav against silently abandoning an in-progress Issue Properties/Bulk Editing edit,
         see MainViewModel.TryLeaveCurrentEditor ============ -->
    <Border IsVisible="{Binding IsDiscardConfirmOpen}" Background="#B0000000">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="360"
                Background="{DynamicResource PbChromeBrush}" BorderBrush="{DynamicResource PbBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="20">
            <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Classes="icon" Width="18" Height="18" Background="#D96C6C">
                        <Border.OpacityMask>
                            <ImageBrush Source="/Assets/Icons/Circle_Warning.png" Stretch="Uniform" />
                        </Border.OpacityMask>
                    </Border>
                    <TextBlock Text="Unsaved changes" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="You have unsaved edits on this screen. Leaving now will discard them."
                           FontSize="12.5" Foreground="{DynamicResource PbTextMutedBrush}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Classes="discardConfirm ghost" Content="Keep Editing" Command="{Binding CancelDiscardCommand}" />
                    <Button Classes="discardConfirm primary" Content="Discard" Command="{Binding ConfirmDiscardCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
    </Grid>
</Window>
