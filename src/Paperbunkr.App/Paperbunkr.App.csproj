<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\paperbunkr.ico</ApplicationIcon>
    <!-- Single source of truth for the release version (docs/superpowers/specs/
         2026-09-01-auto-update-and-changelog-design.md). CI derives the SemVer release tag/appcast
         version from this by dropping the trailing revision segment and appending "-beta". -->
    <Version>0.2.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- CoverThumbnailService's internal test-injection constructor (docs/superpowers/specs/
         2026-08-06-cover-thumbnails-design.md §2) needs this. -->
    <InternalsVisibleTo Include="Paperbunkr.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Native 7z.dll (LGPL, the redistributable 7-Zip library itself, not ComicRackCE's own
         code) - CBZ/CBR both default to EngineConfiguration.CbEngines.SevenZip, which loads this
         via NativeInterop.ResolveNativeAssetPath's {baseDir}/x64/ search
         (docs/superpowers/specs/2026-08-06-reader-canvas-alpha-design.md §1). -->
    <Content Include="x64\7z.dll" CopyToOutputDirectory="PreserveNewest" />
    <!-- Changelog source of truth (docs/superpowers/specs/2026-09-01-auto-update-and-changelog-
         design.md) - bundled so the About section can render full update history offline; only the
         "is there a newer version" check itself needs a network call. -->
    <None Include="..\..\CHANGELOG.md" CopyToOutputDirectory="PreserveNewest" Link="CHANGELOG.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <!-- Books reflow reader WebView redesign (docs/superpowers/specs/2026-09-02-books-reflow-reader-
         webview-redesign-design.md) - first-party AvaloniaUI package, Windows uses WebView2
         automatically (matches this app's WinExe/Windows-only build already). 12.0.0 has a fatal
         bug (confirmed via the upstream repo, not guessed): WM_ACTIVATE fires synchronously before
         the async WebView2 controller finishes initializing, so ICoreWebView2Controller.MoveFocus()
         returns E_INVALIDARG and NativeWebView.OnGotFocus lets the resulting ArgumentException
         escape a native WndProc callback - unrecoverable, kills the whole process (AppDomain.
         UnhandledException, Terminating: True), reproduced 2026-09-02 on first window activation
         after opening a book. Fixed upstream in 12.0.1 (github.com/AvaloniaUI/Avalonia.Controls.
         WebView PR #41, "Fix WebView2 MoveFocus crash on window activation"); pinned to the latest
         12.1.0 here rather than the minimum-fix 12.0.1, since it also has a WebView2 memory-leak fix. -->
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="DialogHost.Avalonia" Version="0.12.3" />
    <PackageReference Include="FluentAvaloniaUI" Version="3.1.0" />
    <PackageReference Include="FluentIcons.Avalonia" Version="2.1.337" />
    <PackageReference Include="FluentIcons.Avalonia.Fluent" Version="2.1.337" />
    <PackageReference Include="Optris.Icons.Avalonia" Version="12.0.7" />
    <PackageReference Include="Optris.Icons.Avalonia.FontAwesome" Version="12.0.7" />
    <PackageReference Include="Optris.Icons.Avalonia.MaterialDesign" Version="12.0.7" />
    <!-- Svg.Skia 5.1.0 pins SkiaSharp 3.119.2 / HarfBuzzSharp 8.3.1.3 - matches Avalonia 12.1.1's
         own SkiaSharp/HarfBuzzSharp (5.2.x jumps to SkiaSharp 4.x and conflicts). Used to rasterise
         the bundled brand/flag SVGs into cached Bitmaps (Services/SvgMarkRenderer.cs). -->
    <PackageReference Include="Svg.Skia" Version="5.1.0" />
    <!-- Auto-update (docs/superpowers/specs/2026-09-01-auto-update-and-changelog-design.md) -
         SparkleUpdater checks/downloads/runs whatever installer the appcast points at; unlike
         Velopack (the original pick, reverted - see the design doc's revision note) this is
         installer-agnostic, so the existing Inno Setup installer stays as-is. No Avalonia UI
         package - NetSparkleUpdater.UI.Avalonia 3.1.0 targets Avalonia 11.3.9 (a major-version gap
         against this project's 12.1.1, confirmed via its own nuspec, not assumed) with no stable
         12.x-compatible release yet, so the hand-rolled overlay/toast UI is used instead. -->
    <PackageReference Include="NetSparkleUpdater.SparkleUpdater" Version="3.1.0" />
    <!-- Insights dashboard bar charts (docs/superpowers/specs/2026-09-05-insights-dashboard-design.md
         §9). 5.1.59 is the first ScottPlot.Avalonia with real Avalonia 12 support (Avalonia/
         Avalonia.Skia >= 12.0.0, published 2026-06-22, github.com/ScottPlot/ScottPlot#5230). Its
         core ScottPlot dep wants SkiaSharp/SkiaSharp.HarfBuzz >= 3.119.0, which unifies cleanly with
         Svg.Skia 5.1.0's SkiaSharp 3.119.2 pin above (verified, not assumed). Only the two bar
         charts use it; the completion donut is a hand-rolled OnRender control. -->
    <PackageReference Include="ScottPlot.Avalonia" Version="5.1.59" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paperbunkr.Common\Paperbunkr.Common.csproj" />
    <ProjectReference Include="..\Paperbunkr.Engine\Paperbunkr.Engine.csproj" />
    <ProjectReference Include="..\Paperbunkr.Data\Paperbunkr.Data.csproj" />
    <ProjectReference Include="..\Paperbunkr.Plugins\Paperbunkr.Plugins.csproj" />
  </ItemGroup>
</Project>
