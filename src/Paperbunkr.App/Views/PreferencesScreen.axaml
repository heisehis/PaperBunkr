<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:pref="using:Paperbunkr.App.Views.Preferences"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="760"
             x:Class="Paperbunkr.App.Views.PreferencesScreen"
             x:Name="Root"
             x:DataType="vm:PreferencesScreenViewModel">

    <!--
        Sidebar + hard-switch pane (docs/superpowers/specs/2026-08-28-preferences-rework-design.md).
        The single-scroll/tile-hub shell from 2026-09-07-preferences-tile-hub-redesign-design.md was
        tried and reverted the same session - too annoying to navigate once actually built (user
        feedback) - so this is back to one section visible at a time. Kept from that pass: sidebar
        items now show an icon (a literal fi:SymbolIcon per button - no converter needed since each
        item is a distinct hardcoded button, not a data-templated repeater) instead of plain text;
        every section's individual settings restructured onto SettingsRow where they fit (see each
        *Section.axaml); the Windows 11 skin fix and 3 new skins.
    -->
    <UserControl.Styles>
        <!-- Sidebar section nav -->
        <Style Selector="Button.prefNavItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="15,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.prefNavItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PbAccentSoftBrush}" />
        </Style>
        <Style Selector="Button.prefNavItem.active">
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
        </Style>

        <!-- Search box -->
        <Style Selector="Border.prefSearchBox">
            <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusSm}" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
        <Style Selector="Border.prefSearchBox TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Settings group card (design-language restyle of the old groupBox/groupHeader) - still
             used by every group not yet converted to SettingsRow (docs/superpowers/specs/2026-09-07-
             preferences-tile-hub-redesign-design.md §4's deferred list). -->
        <Style Selector="Border.groupBox">
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadius}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.groupHeader">
            <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
            <Setter Property="Padding" Value="14,11" />
        </Style>

        <!-- Light caption-style group label (design.md item 2) - replaces groupBox/groupHeader's
             card chrome for groups converted to SettingsRow: small, uppercase, no border/background,
             so long sections stay scannable without the heavier old card treatment. -->
        <Style Selector="TextBlock.settingsGroupCaption">
            <Setter Property="FontSize" Value="{DynamicResource PbFontSizeMicro}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="0.6" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextFaintBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- Header-row action buttons (kept: already token-based) -->
        <Style Selector="Button.headerAction">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusSm}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.headerAction.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
        </Style>
        <Style Selector="Button.headerAction.primary">
            <Setter Property="Background" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PbBadgeTextBrush}" />
        </Style>

        <Style Selector="Button.sideItemButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.sideItemButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PbAccentSoftBrush}" />
        </Style>
        <Style Selector="Border.skinRow">
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>

        <!-- Search-result "pulse" target - the shell code-behind toggles the .searchPulse class. -->
        <Style Selector="Border.groupBox">
            <Setter Property="Transitions">
                <Transitions>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.45" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.groupBox.searchPulse">
            <Setter Property="BoxShadow" Value="{StaticResource PbGlowRing}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="28,20,28,14" Spacing="12">
            <TextBlock Classes="pbTextHeading" Text="PREFERENCES" />
            <Border Classes="prefSearchBox" MaxWidth="360" HorizontalAlignment="Left">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <fi:SymbolIcon Grid.Column="0" Symbol="Search" Margin="0,0,8,0" />
                    <TextBox Grid.Column="1" Text="{Binding SearchQuery}" Watermark="Search settings…"
                             AutomationProperties.AutomationId="PreferencesSearchBox">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Escape" Command="{Binding ClearSearchCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Button Grid.Column="2" Classes="headerAction ghost" Padding="7,3" FontSize="11"
                            IsVisible="{Binding IsSearching}" Content="Clear" Command="{Binding ClearSearchCommand}" />
                </Grid>
            </Border>
        </StackPanel>
        <Border Grid.Row="0" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,0,0,1" VerticalAlignment="Bottom" />

        <Grid Grid.Row="1" ColumnDefinitions="220,*">

            <!-- Sidebar -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,0,1,0">
                <Panel>
                    <ScrollViewer IsVisible="{Binding !IsSearching}">
                        <StackPanel Margin="0,10">
                            <Button Classes="prefNavItem" Classes.active="{Binding IsGeneralSection}"
                                    Command="{Binding GoGeneralCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <fi:SymbolIcon Symbol="Settings" FontSize="{StaticResource PbIconSizeSm}" VerticalAlignment="Center" />
                                    <TextBlock Text="General" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="prefNavItem" Classes.active="{Binding IsAppearanceSection}"
                                    Command="{Binding GoAppearanceCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <fi:SymbolIcon Symbol="PaintBrush" FontSize="{StaticResource PbIconSizeSm}" VerticalAlignment="Center" />
                                    <TextBlock Text="Appearance" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="prefNavItem" Classes.active="{Binding IsLibrarySection}"
                                    Command="{Binding GoLibraryCommand}"
                                    AutomationProperties.AutomationId="PreferencesLibraryNavButton">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <fi:SymbolIcon Symbol="Folder" FontSize="{StaticResource PbIconSizeSm}" VerticalAlignment="Center" />
                                    <TextBlock Text="Library" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="prefNavItem" Classes.active="{Binding IsAutomationSection}"
                                    Command="{Binding GoAutomationCommand}"
                                    AutomationProperties.AutomationId="PreferencesAutomationNavButton">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <fi:SymbolIcon Symbol="Clock" FontSize="{StaticResource PbIconSizeSm}" VerticalAlignment="Center" />
                                    <TextBlock Text="Automation" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="prefNavItem" Classes.active="{Binding IsReaderSection}"
                                    Command="{Binding GoReaderCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <fi:SymbolIcon Symbol="Book" FontSize="{StaticResource PbIconSizeSm}" VerticalAlignment="Center" />
                                    <TextBlock Text="Reader" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="prefNavItem" Classes.active="{Binding IsKeyboardShortcutsSection}"
                                    Command="{Binding GoKeyboardShortcutsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <fi:SymbolIcon Symbol="Keyboard" FontSize="{StaticResource PbIconSizeSm}" VerticalAlignment="Center" />
                                    <TextBlock Text="Keyboard Shortcuts" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="prefNavItem" Classes.active="{Binding IsConnectionsSection}"
                                    Command="{Binding GoConnectionsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <fi:SymbolIcon Symbol="Link" FontSize="{StaticResource PbIconSizeSm}" VerticalAlignment="Center" />
                                    <TextBlock Text="Connections" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="prefNavItem" Classes.active="{Binding IsPluginsSection}"
                                    Command="{Binding GoPluginsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <fi:SymbolIcon Symbol="PuzzlePiece" FontSize="{StaticResource PbIconSizeSm}" VerticalAlignment="Center" />
                                    <TextBlock Text="Plugins" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="prefNavItem" Classes.active="{Binding IsAdvancedSection}"
                                    Command="{Binding GoAdvancedCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <fi:SymbolIcon Symbol="Wrench" FontSize="{StaticResource PbIconSizeSm}" VerticalAlignment="Center" />
                                    <TextBlock Text="Advanced" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="prefNavItem" Classes.active="{Binding IsAboutSection}"
                                    Command="{Binding GoAboutCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <fi:SymbolIcon Symbol="Info" FontSize="{StaticResource PbIconSizeSm}" VerticalAlignment="Center" />
                                    <TextBlock Text="About" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer IsVisible="{Binding IsSearching}">
                        <StackPanel Margin="0,10">
                            <TextBlock Text="No matching settings" Margin="15,10" FontSize="12"
                                       Foreground="{DynamicResource PbTextFaintBrush}"
                                       IsVisible="{Binding NoSearchResults}" />
                            <ItemsControl x:Name="SearchResultsList" ItemsSource="{Binding SearchResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PreferenceSearchResultViewModel">
                                        <Button Classes="prefNavItem"
                                                Command="{Binding #SearchResultsList.((vm:PreferencesScreenViewModel)DataContext).OpenSearchResultCommand}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" Foreground="{DynamicResource PbTextBrush}" />
                                                <TextBlock Text="{Binding SectionLabel}" FontSize="10.5" Foreground="{DynamicResource PbTextFaintBrush}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Panel>
            </Border>

            <!-- Content pane - one section visible at a time (hard switch) -->
            <Panel Grid.Column="1" x:Name="ContentHost">
                <pref:GeneralSection IsVisible="{Binding IsGeneralSection}" />
                <pref:AppearanceSection IsVisible="{Binding IsAppearanceSection}" />
                <pref:LibrarySection IsVisible="{Binding IsLibrarySection}" />
                <pref:AutomationSection IsVisible="{Binding IsAutomationSection}" />
                <pref:ReaderSection IsVisible="{Binding IsReaderSection}" />
                <pref:KeyboardShortcutsSection IsVisible="{Binding IsKeyboardShortcutsSection}" />
                <pref:ConnectionsSection IsVisible="{Binding IsConnectionsSection}" />
                <pref:PluginsSection IsVisible="{Binding IsPluginsSection}" />
                <pref:AdvancedSection IsVisible="{Binding IsAdvancedSection}" />
                <pref:AboutSection IsVisible="{Binding IsAboutSection}" />
            </Panel>
        </Grid>
    </Grid>
</UserControl>
