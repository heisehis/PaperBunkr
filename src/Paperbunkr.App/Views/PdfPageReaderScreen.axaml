<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:views="using:Paperbunkr.App.Views"
             xmlns:reader="using:Paperbunkr.App.Views.Reader"
             xmlns:models="using:Paperbunkr.App.Models"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Paperbunkr.App.Views.PdfPageReaderScreen"
             x:DataType="vm:PdfPageReaderScreenViewModel">

    <!-- Full-bleed page + overlaid chrome (docs/superpowers/specs/2026-09-03-books-reader-hud-
         redesign-design.md), matching EPUB's reading pane now instead of the old fixed Auto/*/Auto
         row layout with permanently-docked toolbar/scrubber bars. No WebView-airspace problem here
         (PageCanvas is an ordinary Avalonia-drawn control, not a native windowed one), so ReaderChrome
         can simply overlay it via normal z-order - no reserved-margin trick needed. -->
    <Grid x:Name="RootGrid" Background="{Binding CanvasBackground}">

        <Grid>
            <views:PageCanvas x:Name="PageCanvasControl"
                              Page="{Binding CurrentPage}"
                              LeftCommand="{Binding GoLeftCommand}"
                              RightCommand="{Binding GoRightCommand}"
                              HighQualityDisplay="{Binding HighQualityPageDisplay}"
                              ZoomLevel="{Binding ZoomLevel}"
                              PanOffsetX="{Binding PanOffsetX}"
                              PanOffsetY="{Binding PanOffsetY}"
                              IsVisible="{Binding !HasError}" />

            <views:CaptureOverlay x:Name="CaptureOverlayControl" IsCaptureMode="{Binding IsCaptureMode}"
                                   IsVisible="{Binding !HasError}" RegionCaptured="OnRegionCaptured" />

            <Border IsVisible="{Binding HasError}" Width="400" CornerRadius="{DynamicResource PbRadius}"
                    Background="{DynamicResource PbReaderChromeBrush}" BorderBrush="{DynamicResource PbReaderBorderBrush}"
                    BorderThickness="1" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding ErrorMessage}" FontSize="13" Foreground="{DynamicResource PbReaderTextMutedBrush}"
                           TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
            </Border>
        </Grid>

        <!-- Page edges either side of the page (books redesign §5.5), sized from the share of the book read before and after it. -->
        <reader:PageEdges x:Name="PageEdgesControl" IsHitTestVisible="False" IsVisible="{Binding !HasError}"
                          Fraction="{Binding ProgressFraction}" PageColor="{Binding Theme, Converter={x:Static reader:ReaderPanelBackgroundConverter.Instance}}"
                          InkColor="{Binding Theme, Converter={x:Static views:ReaderChromeForegroundConverter.Instance}}" />

        <!-- The same three clusters as the EPUB reader (books redesign §5.5), drawn in-window: no native page to stay above here. Always
             visible, as the PDF reader's chrome always was (page number and zoom are glanced at continuously). -->
        <reader:ReaderCluster Part="Navigate" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                              ClusterBackground="{Binding Theme, Converter={x:Static views:ReaderChromeBackgroundConverter.Instance}}"
                              ClusterForeground="{Binding Theme, Converter={x:Static views:ReaderChromeForegroundConverter.Instance}}"
                              ClusterBorder="{DynamicResource PbBorderBrush}"
                              Title="{Binding BookTitle}" BackCommand="{Binding CloseCommand}" />
        <reader:ReaderCluster Part="Actions" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                              ClusterBackground="{Binding Theme, Converter={x:Static views:ReaderChromeBackgroundConverter.Instance}}"
                              ClusterForeground="{Binding Theme, Converter={x:Static views:ReaderChromeForegroundConverter.Instance}}"
                              ClusterBorder="{DynamicResource PbBorderBrush}"
                              CapturesCommand="{Binding OpenCapturesCommand}"
                              CaptureToggleCommand="{Binding ToggleCaptureModeCommand}" IsCaptureMode="{Binding IsCaptureMode}"
                              SettingsCommand="{Binding OpenFontThemeCommand}" />
        <reader:ReaderCluster Part="Page" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="8"
                              ClusterBackground="{Binding Theme, Converter={x:Static views:ReaderChromeBackgroundConverter.Instance}}"
                              ClusterForeground="{Binding Theme, Converter={x:Static views:ReaderChromeForegroundConverter.Instance}}"
                              ClusterBorder="{DynamicResource PbBorderBrush}"
                              ProgressFraction="{Binding ProgressFraction}" LeftLabel="{Binding ProgressLabel}"
                              PreviousRequested="OnClusterPrevious" NextRequested="OnClusterNext" />

        <!-- Captures drawer - ReaderListDrawer (left, matching every other list drawer in both
             readers now - it used to open from the right, an inconsistency this redesign resolves). -->
        <views:ReaderListDrawer PanelBackground="{Binding Theme, Converter={x:Static reader:ReaderPanelBackgroundConverter.Instance}}" PanelForeground="{Binding Theme, Converter={x:Static views:ReaderChromeForegroundConverter.Instance}}" IsOpen="{Binding IsCapturesOpen}" HeaderText="Captures" OverlayReference="{Binding #RootGrid}" ScrimPressed="OnCapturesScrimPointerPressed">
            <views:ReaderListDrawer.DrawerContent>
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding AnnotationImages}" Margin="8,0,8,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:BookAnnotationImageSummary">
                                <Border Margin="0,0,0,10" CornerRadius="{DynamicResource PbRadiusSm}" ClipToBounds="True"
                                        BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1">
                                    <Grid RowDefinitions="Auto,Auto">
                                        <Image Grid.Row="0" Source="{Binding ImagePath, Converter={x:Static views:FilePathImageConverter.Instance}}"
                                               Stretch="UniformToFill" MaxHeight="140" />
                                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="8,6">
                                            <TextBlock Grid.Column="0" Text="{Binding CreatedTime, StringFormat={}{0:d}}" FontSize="11"
                                                       Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Background="Transparent" BorderThickness="0"
                                                    Foreground="{DynamicResource PbTextMutedBrush}" Cursor="Hand"
                                                    Command="{Binding $parent[UserControl].((vm:PdfPageReaderScreenViewModel)DataContext).DeleteCaptureCommand}"
                                                    CommandParameter="{Binding}" ToolTip.Tip="Remove capture" AutomationProperties.Name="Remove capture">
                                                <fi:SymbolIcon Symbol="Dismiss" FontSize="{StaticResource PbIconSizeXs}" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </views:ReaderListDrawer.DrawerContent>
        </views:ReaderListDrawer>

        <!-- Font & Theme sheet - PDF's first-ever theme setting (Step 7). HasTypographyControls="False":
             just the Theme mini-card (Light/Dark/Sepia), no font/spacing sliders since there's no
             reflowable text to restyle, and no auto-hide toggle since this chrome never hides. -->
        <views:ReaderSettingsSheet IsOpen="{Binding IsFontThemeOpen}" HasTypographyControls="False"
                                    SheetBackground="{Binding Theme, Converter={x:Static views:ReaderChromeBackgroundConverter.Instance}}"
                                    SheetForeground="{Binding Theme, Converter={x:Static views:ReaderChromeForegroundConverter.Instance}}"
                                    SetThemeCommand="{Binding SetThemeCommand}"
                                    ThemeOptions="{x:Static views:ReaderSettingsSheet.PdfThemes}"
                                    OverlayReference="{Binding #RootGrid}"
                                    ScrimPressed="OnFontThemeScrimPointerPressed" />

    </Grid>
</UserControl>
