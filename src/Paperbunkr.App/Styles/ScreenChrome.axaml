<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Shared list-screen chrome (docs/superpowers/specs/2026-08-28-preferences-rework-plan.md
        Steps 13-15). These style classes were duplicated verbatim in ReadingScreen.axaml and
        EventsScreen.axaml (and the old PreferencesScreen.axaml) with ad-hoc #383D47 / PbChromeBrush
        literals; promoted here and rebuilt on design tokens so the Reading Lists and Story Events
        screens read as part of the same system as the rest of the reworked app.
    -->

    <Style Selector="TextBlock.statNumber">
        <Setter Property="FontFamily" Value="{DynamicResource PbDisplayFontFamily}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
    </Style>
    <Style Selector="TextBlock.statLabel">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style Selector="Border.issueRow">
        <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusSm}" />
        <Setter Property="Padding" Value="12,9" />
    </Style>

    <Style Selector="TextBox.searchBox">
        <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusSm}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,6" />
    </Style>
    <!-- Toolbar search boxes keep a full rounded border (foundation design §4, Q12): form fields are underlined via FluentBridge.axaml's
         TextControlBorderThemeThickness, and FluentAvalonia's state styles assign PART_BorderElement from those keys, so the part itself is
         pinned here for every state. -->
    <Style Selector="TextBox.searchBox /template/ Border#PART_BorderElement">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusSm}" />
    </Style>
    <Style Selector="TextBox.searchBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource PbTextMutedBrush}" />
    </Style>
    <Style Selector="TextBox.searchBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
    </Style>

    <!-- A text box drawn inside its own pill or container (Library toolbar search, Quick Open, ...): no border and no fill in any state.
         FluentAvalonia's :focus/:pointerover styles set PART_BorderElement's background and thickness from resources, ignoring the
         TextBox's own Background="Transparent" BorderThickness="0", so the part is pinned here. -->
    <Style Selector="TextBox.bare">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.bare /template/ Border#PART_BorderElement, TextBox.bare:pointerover /template/ Border#PART_BorderElement, TextBox.bare:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
</Styles>
