<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Paperbunkr.App.Scraper"
             xmlns:data="using:Paperbunkr.Data.Organizing"
             mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="480"
             x:Class="Paperbunkr.App.Scraper.OrganizePreviewDialogView"
             x:DataType="vm:OrganizePreviewDialogViewModel">

    <UserControl.Styles>
        <Style Selector="Button.primary">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbBadgeTextBrush}" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
    </UserControl.Styles>

    <!-- No card chrome here - the host's NativePluginModalHost Border owns it (same as FileConflictDialogView). -->
    <StackPanel Spacing="12" Width="520">
        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PbTextBrush}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" TextWrapping="Wrap" />

        <ItemsControl ItemsSource="{Binding Counts}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource PbTextBrush}" TextWrapping="Wrap" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Spacing="4" IsVisible="{Binding HasSample}">
            <TextBlock Text="First files" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PbTextMutedBrush}" />
            <ScrollViewer MaxHeight="220">
                <ItemsControl ItemsSource="{Binding Sample}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="data:PlanPreviewRow">
                            <StackPanel Margin="0,0,0,8" Spacing="1">
                                <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource PbTextBrush}" />
                                <TextBlock Text="{Binding From}" FontSize="11" Foreground="{DynamicResource PbTextFaintBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding To, StringFormat='→ {0}'}" FontSize="11" Foreground="{DynamicResource PbTextMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="{Binding SampleNote}" FontSize="11" Foreground="{DynamicResource PbTextFaintBrush}" />
        </StackPanel>

        <StackPanel Spacing="4" IsVisible="{Binding HasProblems}">
            <TextBlock Text="Cannot be organized" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PbDangerBrush}" />
            <ItemsControl ItemsSource="{Binding ProblemMessages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource PbTextBrush}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="{Binding CancelLabel}" Command="{Binding CancelCommand}" />
            <Button Content="{Binding ConfirmLabel}" Classes="primary" Command="{Binding ConfirmCommand}" IsVisible="{Binding !IsSimulation}" />
        </StackPanel>
    </StackPanel>
</UserControl>
