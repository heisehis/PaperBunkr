<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Paperbunkr.App.Scraper"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="380"
             x:Class="Paperbunkr.App.Scraper.ComicVineIssueReviewDialogView"
             x:DataType="vm:ComicVineIssueReviewDialogViewModel">

    <!-- docs/superpowers/specs/2026-09-13-cluster-scraper-ui-redesign-design.md §3: CE's second
         dialog ("Choose a Comic Book Issue"), same list+cover-pane shape as the series dialog for
         visual consistency, no source/sort toolbar. ReadOnlyPeek swaps the footer to a single Close
         button - see the ViewModel's own doc comment. -->
    <UserControl.Styles>
        <Style Selector="Border.selected">
            <Setter Property="Background" Value="{DynamicResource PbAccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Same unified button language as ComicVineMatchReviewDialogView.axaml - see that file's
             own comment for why this is duplicated rather than shared. -->
        <Style Selector="Button.primary">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbBadgeTextBrush}" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.9" />
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource PbSurface1Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="14" Width="640">
        <TextBlock Text="Which issue is this?" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PbTextBrush}" />
        <TextBlock Text="{Binding BookLabel}" FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" TextWrapping="Wrap" />

        <Grid ColumnDefinitions="*,160">
            <!-- Real sortable table (docs/superpowers/specs/2026-09-24-scraper-review-tables-and-
                 batch-summary-design.md §1.2) - CE's own issueform.py shape, verified: a DataGridView
                 with Issue#/Title columns, natural-sort on Issue# specifically (CE's own SortCompare
                 handler calling utils.natural_compare - ported into NaturalSortKey below). -->
            <DataGrid Grid.Column="0" Margin="0,0,16,0" MaxHeight="260"
                      ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}"
                      AutoGenerateColumns="False" CanUserSortColumns="True" CanUserResizeColumns="True" CanUserReorderColumns="True"
                      IsReadOnly="True" SelectionMode="Single" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      Background="Transparent" BorderThickness="0" RowBackground="Transparent">
                <DataGrid.Columns>
                    <!-- SortMemberPath redirects the header's sort to NaturalSortKey while the cell
                         itself keeps displaying the issue's real number - DataGrid has no per-column
                         custom-comparer hook, only this single-property redirect. -->
                    <DataGridTemplateColumn Header="Issue#" SortMemberPath="NaturalSortKey" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Issue.IssueNumber}" Margin="8,0" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Title" Binding="{Binding Issue.Name}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Column="1" Spacing="8" HorizontalAlignment="Center">
                <Border Width="140" Height="210" CornerRadius="6" Background="{DynamicResource PbSurface2Brush}" IsVisible="{Binding ShowCovers}">
                    <Image Stretch="Uniform" vm:RemoteCoverImage.SourceUrl="{Binding SelectedCandidate.CoverImageUrl}" />
                </Border>
                <TextBlock Text="{Binding SelectedCandidate.DisplayLabel}" FontSize="12" Foreground="{DynamicResource PbTextBrush}"
                           TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="*,Auto,Auto,Auto" IsVisible="{Binding !ReadOnlyPeek}">
            <Button Grid.Column="1" Content="Go Back" Classes="secondary" Command="{Binding GoBackCommand}" Margin="0,0,8,0" />
            <!-- Ctrl-held Skip (docs/superpowers/specs/2026-09-24-comicvine-scraper-fidelity-plan.md
                 Step 16, CE's real issueform.py affordance, verified) - see the series dialog's own
                 Skip button for the full rationale (same pattern, mirrored here). -->
            <Button Grid.Column="2" Content="{Binding SkipLabel}" Classes="secondary" Margin="0,0,8,0"
                    PointerPressed="OnSkipPointerPressed" PointerMoved="OnSkipPointerMoved" PointerExited="OnSkipPointerExited"
                    KeyDown="OnSkipKeyDown" />
            <Button Grid.Column="3" Content="OK" Classes="primary" Command="{Binding ConfirmCommand}" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ReadOnlyPeek}">
            <Button Grid.Column="1" Content="Close" Classes="secondary" Command="{Binding CloseCommand}" />
        </Grid>
    </StackPanel>
</UserControl>
