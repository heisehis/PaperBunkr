<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:controls="using:Paperbunkr.App.Controls"
             xmlns:em="using:Paperbunkr.App.Controls.EventMap"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:eventMap="using:Paperbunkr.App.Services.EventMap"
             xmlns:views="using:Paperbunkr.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="640"
             x:Class="Paperbunkr.App.Views.EventMapView"
             x:DataType="vm:EventMapViewModel">

    <!-- The Event Map (docs/superpowers/specs/2026-09-25-event-map-design.md §3-§4). Toolbar, then a 2×2 grid: corner
         label / pinned ruler / pinned lane headers / two-axis ScrollViewer holding the virtualized surface, with the
         340 px inspector drawer on the right. Colours are skin tokens only - no hex. -->

    <UserControl.Resources>
        <!-- Card themes, one per density stop; EventMapSurface assigns EventMapCard{Density}Theme. The shared states
             (:selected, :dimmed, :missing, :focus-visible, hover) live on the base theme. -->
        <ControlTheme x:Key="EventMapCardBaseTheme" TargetType="em:EventMapCard">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="{DynamicResource PbMotionFast}" Easing="{StaticResource PbMotionEase}" />
                </Transitions>
            </Setter>
            <Style Selector="^:dimmed">
                <Setter Property="Opacity" Value="0.25" />
            </Style>
            <Style Selector="^:pointerover /template/ Border#PART_Frame">
                <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
            </Style>
            <Style Selector="^:selected /template/ Border#PART_Frame">
                <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
                <Setter Property="BorderThickness" Value="2" />
            </Style>
            <!-- Keyboard focus is the app-wide glow ring (the adorner). A selected card that also has focus drops its accent border back to the
                 resting one, so the two never stack into a double ring; the card keeps the same 2px footprint so nothing shifts. -->
            <Style Selector="^:selected:focus-visible /template/ Border#PART_Frame">
                <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            </Style>
            <Style Selector="^:missing /template/ Panel#PART_Content">
                <Setter Property="Opacity" Value="0.55" />
            </Style>
            <Style Selector="^:trunk /template/ Border#PART_Frame">
                <Setter Property="Background" Value="{DynamicResource PbSurface1Brush}" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="EventMapCardCompactTheme" TargetType="em:EventMapCard" BasedOn="{StaticResource EventMapCardBaseTheme}">
            <Setter Property="Template">
                <ControlTemplate x:DataType="vm:EventMapCardViewModel">
                    <Border Name="PART_Frame" Background="{DynamicResource PbChromeBrush}" BorderBrush="{DynamicResource PbBorderBrush}"
                            BorderThickness="1" CornerRadius="{DynamicResource PbRadiusSm}" ClipToBounds="True">
                        <Panel Name="PART_Content">
                            <Grid ColumnDefinitions="3,*,Auto">
                                <Border Grid.Column="0" em:EventMapLaneBrush.ColorIndex="{Binding ColorIndex}" />
                                <TextBlock Grid.Column="1" Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold" Margin="6,0,2,0"
                                           Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Panel Grid.Column="2" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Stroke="{DynamicResource PbTextMutedBrush}" StrokeThickness="1.25" IsVisible="{Binding IsUnread}" />
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource PbAccentBrush}" IsVisible="{Binding IsInProgress}" />
                                    <fi:SymbolIcon Symbol="Checkmark" FontSize="12" Foreground="{DynamicResource PbSuccessBrush}" IsVisible="{Binding IsRead}" />
                                </Panel>
                            </Grid>
                            <fi:SymbolIcon Symbol="Warning" FontSize="10" Foreground="{DynamicResource PbDangerBrush}" IsVisible="{Binding IsMissing}"
                                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,2,0" />
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <ControlTheme x:Key="EventMapCardStandardTheme" TargetType="em:EventMapCard" BasedOn="{StaticResource EventMapCardBaseTheme}">
            <Setter Property="Template">
                <ControlTemplate x:DataType="vm:EventMapCardViewModel">
                    <Border Name="PART_Frame" Background="{DynamicResource PbChromeBrush}" BorderBrush="{DynamicResource PbBorderBrush}"
                            BorderThickness="1" CornerRadius="{DynamicResource PbRadiusSm}" ClipToBounds="True">
                        <Panel Name="PART_Content">
                            <Grid ColumnDefinitions="3,Auto,*">
                                <Border Grid.Column="0" em:EventMapLaneBrush.ColorIndex="{Binding ColorIndex}" />
                                <Border Grid.Column="1" Width="36" Height="54" Margin="4,0,0,0" CornerRadius="{DynamicResource PbRadiusSm}" ClipToBounds="True"
                                        Background="{DynamicResource PbSurface2Brush}" VerticalAlignment="Center">
                                    <Image views:AsyncCoverImage.SourceId="{Binding CoverKey}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="2" Margin="8,4,6,4" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{Binding SeriesName}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PbTextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Number, StringFormat='#{0}'}" FontSize="11" Foreground="{DynamicResource PbTextBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Panel Width="12" Height="12" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Stroke="{DynamicResource PbTextMutedBrush}" StrokeThickness="1.25" IsVisible="{Binding IsUnread}" />
                                            <Ellipse Width="8" Height="8" Fill="{DynamicResource PbAccentBrush}" IsVisible="{Binding IsInProgress}" />
                                            <fi:SymbolIcon Symbol="Checkmark" FontSize="12" Foreground="{DynamicResource PbSuccessBrush}" IsVisible="{Binding IsRead}" />
                                        </Panel>
                                        <TextBlock Text="{Binding CoverDate}" FontSize="10" Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <fi:SymbolIcon Symbol="Warning" FontSize="12" Foreground="{DynamicResource PbDangerBrush}" IsVisible="{Binding IsMissing}"
                                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0" />
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <ControlTheme x:Key="EventMapCardCoversTheme" TargetType="em:EventMapCard" BasedOn="{StaticResource EventMapCardBaseTheme}">
            <Setter Property="Template">
                <ControlTemplate x:DataType="vm:EventMapCardViewModel">
                    <Border Name="PART_Frame" Background="{DynamicResource PbChromeBrush}" BorderBrush="{DynamicResource PbBorderBrush}"
                            BorderThickness="1" CornerRadius="{DynamicResource PbRadiusSm}" ClipToBounds="True">
                        <Panel Name="PART_Content">
                            <Grid RowDefinitions="*,Auto">
                                <Panel Grid.Row="0" Background="{DynamicResource PbSurface2Brush}">
                                    <Image views:AsyncCoverImage.SourceId="{Binding CoverKey}" Stretch="UniformToFill" />
                                </Panel>
                                <Border Grid.Row="0" Height="3" VerticalAlignment="Top" em:EventMapLaneBrush.ColorIndex="{Binding ColorIndex}" />
                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="6,4">
                                    <TextBlock Grid.Column="0" Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PbTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Panel Grid.Column="1" Width="12" Height="12" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Stroke="{DynamicResource PbTextMutedBrush}" StrokeThickness="1.25" IsVisible="{Binding IsUnread}" />
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource PbAccentBrush}" IsVisible="{Binding IsInProgress}" />
                                        <fi:SymbolIcon Symbol="Checkmark" FontSize="12" Foreground="{DynamicResource PbSuccessBrush}" IsVisible="{Binding IsRead}" />
                                    </Panel>
                                </Grid>
                            </Grid>
                            <fi:SymbolIcon Symbol="Warning" FontSize="14" Foreground="{DynamicResource PbDangerBrush}" IsVisible="{Binding IsMissing}"
                                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" />
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="em|EventMapOverviewStrip">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions"><Transitions><DoubleTransition Property="Opacity" Duration="{DynamicResource PbMotionRevealFade}" Easing="{StaticResource PbMotionEase}" /></Transitions></Setter>
        </Style>
        <Style Selector="em|EventMapOverviewStrip.open"><Setter Property="Opacity" Value="1" /></Style>
        <Style Selector="Button.mapLink">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusSm}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.mapLink:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
        </Style>
        <Style Selector="Border.segmentRow.current">
            <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- Save as image renders off screen through this host (it's in the live tree, so styles and the theme apply); never shown. -->
        <Panel Name="ExportHost" Grid.RowSpan="2" Opacity="0" IsHitTestVisible="False" ClipToBounds="True" />

        <!-- ===== Toolbar ===== -->
        <WrapPanel Grid.Row="0" Margin="24,0,24,10" Orientation="Horizontal" ItemSpacing="14" LineSpacing="8">
            <Border Classes="segGroup" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Button Classes="segItem" Classes.active="{Binding IsMapMode}" Content="Map" Command="{Binding ShowMapModeCommand}" />
                    <Button Classes="segItem" Classes.active="{Binding IsMatrixMode}" Content="Matrix" Command="{Binding ShowMatrixModeCommand}" />
                    <Button Classes="segItem" Classes.active="{Binding IsListMode}" Content="List" Command="{Binding ShowListModeCommand}" />
                    <Button Classes="segItem" Classes.active="{Binding IsAtlasMode}" Content="Atlas" Command="{Binding ShowAtlasModeCommand}"
                            IsVisible="{Binding IsAtlasAvailable}" ToolTip.Tip="This continuity's events across the years" />
                </StackPanel>
            </Border>
            <Button Name="SeriesButton" Classes="secondary" Content="Series" Command="{Binding ToggleRollCallCommand}" />
            <TextBlock Classes="pbTextCaption" Text="{Binding ProgressText}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsSpinePickerVisible}">
                <TextBlock Text="Spine" FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                <controls:SuggestBox MinWidth="220" FontSize="12" IsStrict="True" AutomationProperties.Name="Spine series"
                                     Suggestions="{Binding SpineOptions}" Text="{Binding SpineText}" />
            </StackPanel>

            <Border Background="{DynamicResource PbSurface2Brush}" BorderBrush="{DynamicResource PbBorderBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource PbRadiusSm}" Padding="4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Classes="segItem segToggle" Classes.on="{Binding IsFilterAll}" Content="All"
                            Command="{Binding SetFilterCommand}" CommandParameter="{x:Static eventMap:EventMapFilter.All}" />
                    <Button Classes="segItem segToggle" Classes.on="{Binding IsFilterSpineOnly}" Content="Spine only" IsVisible="{Binding CanFilterSpineOnly}"
                            Command="{Binding SetFilterCommand}" CommandParameter="{x:Static eventMap:EventMapFilter.SpineOnly}" />
                    <Button Classes="segItem segToggle" Classes.on="{Binding IsFilterHideOptional}" Content="Hide optional"
                            Command="{Binding SetFilterCommand}" CommandParameter="{x:Static eventMap:EventMapFilter.HideOptional}" />
                    <Button Classes="segItem segToggle" Classes.on="{Binding IsFilterEventsOnly}" Content="Events only" IsVisible="{Binding CanFilterEventsOnly}"
                            ToolTip.Tip="Hide the issues that are in no event"
                            Command="{Binding SetFilterCommand}" CommandParameter="{x:Static eventMap:EventMapFilter.EventsOnly}" />
                </StackPanel>
            </Border>

            <Border Classes="segGroup" IsVisible="{Binding IsPackingVisible}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Button Classes="segItem" Classes.active="{Binding IsRelayPacked}" Content="Packed" Command="{Binding UsePackedRelayCommand}" />
                    <Button Classes="segItem" Classes.active="{Binding IsOnePerColumn}" Content="One per column" Command="{Binding UseOnePerColumnCommand}" />
                </StackPanel>
            </Border>

            <Button Classes="secondary" Content="{Binding HideReadLabel}" Command="{Binding ToggleHideReadCommand}" />
            <!-- M5: Featuring, Colour by and Arcs (docs/superpowers/specs/2026-11-11-continuity-map-structure-links-design.md) -->
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding HasFeaturingChoices}">
                <TextBlock Text="Featuring" Classes="pbTextMeta" VerticalAlignment="Center" />
                <controls:SuggestBox MinWidth="200" IsStrict="True" AutomationProperties.Name="Featuring character or team"
                                     Suggestions="{Binding FeaturingOptions}" Text="{Binding FeaturingText}" />
                <Button Classes="iconButton sm" Command="{Binding ClearFeaturingCommand}" IsVisible="{Binding IsFeaturing}"
                        AutomationProperties.Name="Clear featuring" ToolTip.Tip="Clear featuring">
                    <fi:SymbolIcon Symbol="Dismiss" FontSize="{StaticResource PbIconSizeXs}" />
                </Button>
                <Button Classes="secondary" Content="{Binding HideOthersLabel}" Command="{Binding ToggleFeaturingHideOthersCommand}" IsVisible="{Binding IsFeaturing}" />
                <TextBlock Classes="pbTextCaption" Text="{Binding FeaturingStatus}" VerticalAlignment="Center" IsVisible="{Binding IsFeaturing}" />
            </StackPanel>
            <TextBlock Classes="pbTextCaption" Text="Character index still building" VerticalAlignment="Center" IsVisible="{Binding IsIndexBuilding}" />
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsMapMode}">
                <TextBlock Text="Colour by" Classes="pbTextMeta" VerticalAlignment="Center" />
                <controls:SuggestBox Width="140" IsStrict="True" AutomationProperties.Name="Colour cards by"
                                     Suggestions="{Binding ColourByOptions}" Text="{Binding ColourByText}" />
                <Button Classes="secondary" Content="{Binding ArcsLabel}" Command="{Binding ToggleArcsCommand}" ToolTip.Tip="Story arcs drawn under each lane" />
            </StackPanel>
            <Button Classes="secondary" Command="{Binding ToggleShowMissingCommand}" IsVisible="{Binding HasMissingSnapshot}"
                    ToolTip.Tip="Issues this event's Metron or ComicVine list has that your library doesn't">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <fi:SymbolIcon Symbol="BookQuestionMark" FontSize="{StaticResource PbIconSizeXs}" />
                    <TextBlock Text="{Binding ShowMissingLabel}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Classes="ghost" IsVisible="{Binding HasGaps}" AutomationProperties.Name="Possible gaps">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <fi:SymbolIcon Symbol="Warning" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbBadgeBrush}" />
                    <TextBlock Text="{Binding GapsLabel}" VerticalAlignment="Center" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                        <Border Classes="dropdown">
                            <StackPanel MinWidth="240" MaxWidth="360">
                                <TextBlock Classes="pbTextCaption" Text="These may not be part of this event." Margin="8,4,8,6" TextWrapping="Wrap" />
                                <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Gaps}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:EventGapItem">
                                                <Button Classes="menuRow" Content="{Binding Label}" ToolTip.Tip="Open the series"
                                                        Command="{Binding $parent[UserControl].((vm:EventMapViewModel)DataContext).OpenGapSeriesCommand}" CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button Classes="ghost" Content="Undo add to Wanted" Command="{Binding UndoWantedCommand}" IsVisible="{Binding HasUndoWanted}" />
            <TextBlock Classes="pbTextCaption" Text="{Binding MissingStaleText}" VerticalAlignment="Center" IsVisible="{Binding MissingStaleText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <Button Classes="ghost" Content="More" AutomationProperties.Name="More map options">
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                        <StackPanel MinWidth="200">
                            <Button Classes="menuRow" Content="{Binding FoldShortLanesLabel}" Command="{Binding ToggleShortLanesCommand}" IsVisible="{Binding CanFoldShortLanes}" />
                            <Button Classes="menuRow" Content="{Binding ProgressLineLabel}" Command="{Binding ToggleProgressLineCommand}" />
                            <Button Classes="menuRow" Content="Save as image…" Command="{Binding SaveAsImageCommand}" IsVisible="{Binding CanSaveImage}" />
                            <Button Classes="menuRow" Content="Check for missing issues" Command="{Binding CheckForMissingIssuesCommand}" IsEnabled="{Binding !IsCheckingMissing}" />
                            <Button Classes="menuRow" Content="Add all missing to Wanted" Command="{Binding AddAllMissingToWantedCommand}">
                                <Button.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="ShowMissing" />
                                        <Binding Path="HasMissingIssues" />
                                    </MultiBinding>
                                </Button.IsVisible>
                            </Button>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <!-- Continuity map: hide whole events (docs/superpowers/specs/2026-09-27-continuity-map-design.md §4) -->
            <Button Classes="secondary" VerticalAlignment="Center" IsVisible="{Binding HasEventChoices}"
                    AutomationProperties.Name="Choose which events to show">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Events" VerticalAlignment="Center" />
                    <fi:SymbolIcon Symbol="ChevronDown" FontSize="{StaticResource PbIconSizeXs}" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                        <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding EventChoices}" MinWidth="220">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EventMapEventChoice">
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsShown}" Margin="2,1" FontSize="12" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <Button Classes="secondary" Content="Covers" Command="{Binding ToggleMatrixCoversCommand}" IsVisible="{Binding IsMatrixMode}" />
            <Button Classes="iconButton" Command="{Binding FitAtlasCommand}" IsVisible="{Binding IsAtlasMode}" AutomationProperties.Name="Fit atlas" ToolTip.Tip="Fit atlas (Ctrl + mouse wheel zooms)">
                <fi:SymbolIcon Symbol="ArrowFit" FontSize="{StaticResource PbIconSizeSm}" />
            </Button>
            <Button Classes="ghost" AutomationProperties.Name="Undated events">
                <Button.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="IsAtlasMode" />
                        <Binding Path="HasUndatedEvents" />
                    </MultiBinding>
                </Button.IsVisible>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding UndatedLabel}" VerticalAlignment="Center" />
                    <fi:SymbolIcon Symbol="ChevronDown" FontSize="{StaticResource PbIconSizeXs}" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                        <Border Classes="dropdown">
                            <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding UndatedEvents}" MinWidth="220">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AtlasUndatedEvent">
                                            <Button Classes="menuRow" Content="{Binding Name}"
                                                    Command="{Binding $parent[UserControl].((vm:EventMapViewModel)DataContext).OpenUndatedEventCommand}" CommandParameter="{Binding EventId}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" ToolTip.Tip="Map zoom" IsVisible="{Binding IsMapMode}">
                <TextBlock Text="Zoom" Classes="pbTextMeta" VerticalAlignment="Center" />
                <Slider Width="110" Minimum="0" Maximum="1" AutomationProperties.Name="Map zoom" Value="{Binding SliderValue, Mode=TwoWay}" />
                <Button Classes="iconButton" Command="{Binding FitAllCommand}" AutomationProperties.Name="Fit map" ToolTip.Tip="Fit map"><fi:SymbolIcon Symbol="ArrowFit" FontSize="{StaticResource PbIconSizeSm}" /></Button>
                <Button Classes="iconButton" Command="{Binding ToggleMapMaximizeCommand}" AutomationProperties.Name="{Binding MapMaximizeLabel}" ToolTip.Tip="{Binding MapMaximizeLabel}">
                    <Panel><fi:SymbolIcon Symbol="FullScreenMaximize" FontSize="{StaticResource PbIconSizeSm}" IsVisible="{Binding !IsMapMaximized}" /><fi:SymbolIcon Symbol="FullScreenMinimize" FontSize="{StaticResource PbIconSizeSm}" IsVisible="{Binding IsMapMaximized}" /></Panel>
                </Button>
            </StackPanel>

            <Button Classes="iconButton" VerticalAlignment="Center" Command="{Binding JumpToFirstUnreadCommand}"
                    AutomationProperties.Name="Jump to first unread" ToolTip.Tip="Jump to first unread">
                <fi:SymbolIcon Symbol="ArrowNext" FontSize="{StaticResource PbIconSizeSm}" />
            </Button>

            <Button Classes="ghost" VerticalAlignment="Center" IsVisible="{Binding HasPendingDuplicates}"
                    Command="{Binding ShowDuplicatesCommand}" ToolTip.Tip="These pairs wait under Possible duplicates in the sidebar">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <fi:SymbolIcon Symbol="Warning" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbBadgeBrush}" />
                    <TextBlock Text="{Binding PendingDuplicatesText}" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <!-- Colour by legend (M5 §3): click a creator to dim everyone else -->
            <ItemsControl ItemsSource="{Binding Legend}" VerticalAlignment="Center" IsVisible="{Binding HasLegend}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel ItemSpacing="8" LineSpacing="4" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MapLegendItem">
                        <Button Classes="filterChip" Classes.active="{Binding IsActive}" IsEnabled="{Binding !IsOthers}"
                                Command="{Binding $parent[UserControl].((vm:EventMapViewModel)DataContext).HighlightCreatorCommand}" CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="10" Height="10" CornerRadius="{DynamicResource PbRadiusSm}" em:EventMapLaneBrush.ColorIndex="{Binding ColorIndex}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </WrapPanel>

        <!-- ===== Map + inspector ===== -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
            <em:EventMapRollCallPanel Grid.Column="0" controls:Reveal.IsOpen="{Binding IsRollCallOpen}" controls:Reveal.ReturnFocusTo="{Binding #SeriesButton}" />
            <Border Grid.Column="1" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,1,0,0">
                <Panel>
                    <!-- The map -->
                    <Grid RowDefinitions="Auto,*" IsVisible="{Binding HasMap}">
                        <em:EventMatrixCanvas Grid.RowSpan="2" Name="MatrixCanvas" Matrix="{Binding Matrix}" Cards="{Binding Cards}" Covers="{Binding MatrixCovers}" SelectedIndex="{Binding SelectedIndex}" IsVisible="{Binding IsMatrixMode}" AutomationProperties.Name="Event matrix" />
                        <views:EventListView Grid.RowSpan="2" Name="ListView" IsVisible="{Binding IsListMode}" controls:Replace.On="{Binding IsListMode}" />
                        <em:ContinuityAtlasCanvas Grid.RowSpan="2" Name="AtlasCanvas" Atlas="{Binding Atlas}" IsVisible="{Binding IsAtlasMode}" controls:Replace.On="{Binding IsAtlasMode}"
                                                  AutomationProperties.Name="{Binding EventName, StringFormat='Atlas of {0}'}" />
                        <Grid Grid.RowSpan="2" RowDefinitions="Auto,*" IsVisible="{Binding IsMapMode}">
                        <em:EventMapOverviewStrip Grid.Row="0" Canvas="{Binding #MapCanvas}" AutomationProperties.Name="Map overview" AutomationProperties.ControlTypeOverride="Image" />
                        <em:EventMapCanvas Grid.Row="1" Name="MapCanvas" Layout="{Binding Layout}" Cards="{Binding Cards}" LaneHeaders="{Binding LaneHeaders}" Connectors="{Binding Connectors}" RelatedSet="{Binding RelatedSet}" SelectedIndex="{Binding SelectedIndex}" Scale="{Binding Scale, Mode=TwoWay}" IsLaneRailWide="{Binding IsLaneRailWide}" RulerHeight="{Binding RulerHeight}" ShowProgressLine="{Binding ShowProgressLine}" FeatureSet="{Binding FeatureSet}" BarColors="{Binding BarColors}" Brackets="{Binding Brackets}" ObscuredRight="{Binding FloatingInspectorFootprint}" AutomationProperties.Name="{Binding SurfaceAutomationName}" />
                        <Popup Grid.Row="1" PlacementTarget="{Binding #MapCanvas}" Placement="Pointer" HorizontalOffset="12" VerticalOffset="12" IsOpen="{Binding IsPeekOpen, Mode=OneWay}" IsHitTestVisible="False">
                            <Border Classes="dropdown" Padding="8" IsHitTestVisible="False">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="72" Height="108" Background="{DynamicResource PbSurface2Brush}" ClipToBounds="True"><Image views:AsyncCoverImage.SourceId="{Binding PeekCard.CoverKey}" Stretch="UniformToFill" /></Border>
                                    <StackPanel MaxWidth="220" Spacing="4"><TextBlock Classes="pbTextMeta" Text="{Binding PeekCard.Title}" TextWrapping="Wrap" /><TextBlock Classes="pbTextCaption" Text="{Binding PeekCard.CoverDate}" /><TextBlock Classes="pbTextCaption" Text="{Binding PeekCard.ReadStateLabel}" /></StackPanel>
                                </StackPanel>
                            </Border>
                        </Popup>
                        <Button Grid.Row="1" Classes="iconButton sm" HorizontalAlignment="Left" VerticalAlignment="Top" Command="{Binding ToggleLaneRailCommand}" AutomationProperties.Name="Toggle lane rail width" ToolTip.Tip="Toggle lane rail width"><fi:SymbolIcon Symbol="Navigation" FontSize="{StaticResource PbIconSizeXs}" /></Button>
                        <TextBlock Grid.Row="1" Margin="28,6,0,0" MaxWidth="145" HorizontalAlignment="Left" VerticalAlignment="Top" Classes="pbTextCaption" Text="{Binding ProgressText}" TextTrimming="CharacterEllipsis" IsVisible="{Binding IsLaneRailWide}" IsHitTestVisible="False" />
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="24,40" HorizontalAlignment="Center" VerticalAlignment="Top" IsVisible="{Binding IsFilteredEmpty}">
                            <TextBlock Text="Nothing to show - change the filters" Classes="pbTextBody" IsVisible="{Binding !IsEverythingRead}" />
                            <TextBlock Text="Everything here is read" Classes="pbTextBody" IsVisible="{Binding IsEverythingRead}" />
                            <Button Classes="ghost" Content="Show read" Command="{Binding ToggleHideReadCommand}" IsVisible="{Binding IsEverythingRead}" />
                        </StackPanel>
                    </Grid>

                    <!-- No members -->
                    <StackPanel Spacing="10" Margin="24,40" HorizontalAlignment="Center" VerticalAlignment="Top" IsVisible="{Binding IsEmpty}">
                        <controls:EmptyIllustration Kind="Stack" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding EmptyText}" FontSize="13" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource PbTextMutedBrush}" />
                        <Button Classes="secondary" HorizontalAlignment="Center" Command="{Binding AddIssuesCommand}"
                                IsVisible="{Binding IsAddIssuesVisible}"><StackPanel Orientation="Horizontal" Spacing="6"><fi:SymbolIcon Symbol="Add" FontSize="{StaticResource PbIconSizeXs}" /><TextBlock Text="Add issues" VerticalAlignment="Center" /></StackPanel></Button>
                    </StackPanel>

                    <!-- Load failure (also raised as an Activity Center alert) -->
                    <StackPanel Spacing="8" Margin="24,40" HorizontalAlignment="Center" VerticalAlignment="Top" IsVisible="{Binding HasError}">
                        <fi:SymbolIcon Symbol="Warning" FontSize="{StaticResource PbIconSizeLg}" Foreground="{DynamicResource PbDangerBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding ErrorText}" FontSize="13" Foreground="{DynamicResource PbTextMutedBrush}" TextWrapping="Wrap"
                                   MaxWidth="520" HorizontalAlignment="Center" TextAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="Loading map…" FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" Margin="24,40"
                               HorizontalAlignment="Center" VerticalAlignment="Top" IsVisible="{Binding IsLoading}" />
                </Panel>
            </Border>

            <Border Grid.Column="2" Width="340" IsVisible="{Binding IsInspectorDockedOpen}" />
            <!-- ===== Inspector drawer ===== -->
            <Border Grid.Column="1" Grid.ColumnSpan="2" Width="340" Margin="12" HorizontalAlignment="Right" Classes="floatingPanel" controls:Reveal.IsOpen="{Binding IsInspectorOpen}" controls:Reveal.ReturnFocusTo="{Binding #MapCanvas}">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="16,10,8,0">
                        <TextBlock Text="Issue" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="iconButton sm" Command="{Binding ToggleInspectorDockCommand}" AutomationProperties.Name="{Binding InspectorDockLabel}" ToolTip.Tip="{Binding InspectorDockLabel}"><fi:SymbolIcon Symbol="Pin" FontSize="{StaticResource PbIconSizeXs}" /></Button>
                        <Button Grid.Column="2" Classes="iconButton" Command="{Binding CloseInspectorCommand}"
                                AutomationProperties.Name="Close inspector" ToolTip.Tip="Close (Esc)">
                            <fi:SymbolIcon Symbol="Dismiss" FontSize="{StaticResource PbIconSizeXs}" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,6,16,20" Spacing="10">
                            <Border Width="120" Height="180" HorizontalAlignment="Left" CornerRadius="{DynamicResource PbRadiusSm}" ClipToBounds="True"
                                    Background="{DynamicResource PbSurface2Brush}" IsVisible="{Binding SelectedCard.IsMember}">
                                <Image views:AsyncCoverImage.SourceId="{Binding SelectedCard.CoverKey}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding SelectedCard.Title}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PbTextBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedCard.CoverDate}" FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}"
                                           IsVisible="{Binding SelectedCard.HasCoverDate}" />
                            </StackPanel>
                            <!-- A missing issue (M4): where it came from and what you can do with it -->
                            <StackPanel Spacing="8" IsVisible="{Binding SelectedCard.IsGhost}">
                                <Border Classes="pbChip" HorizontalAlignment="Left">
                                    <TextBlock Classes="pbTextCaption" Text="{Binding SelectedCard.GhostLabel}" />
                                </Border>
                                <TextBlock Classes="pbTextCaption" Text="{Binding SelectedCard.GhostSourceLabel}" />
                                <WrapPanel ItemSpacing="8" LineSpacing="8">
                                    <Button Classes="primary" Content="Add to Wanted" Command="{Binding AddSelectedToWantedCommand}">
                                        <Button.IsVisible>
                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                <Binding Path="SelectedCard.IsMissingGhost" />
                                                <Binding Path="!SelectedCard.IsWanted" />
                                            </MultiBinding>
                                        </Button.IsVisible>
                                    </Button>
                                    <Border Classes="statusBadge" IsVisible="{Binding SelectedCard.IsWanted}" VerticalAlignment="Center">
                                        <TextBlock Classes="pbTextCaption" Text="Wanted" />
                                    </Border>
                                    <Button Classes="primary" Content="Add to event" Command="{Binding AddSelectedToEventCommand}" IsVisible="{Binding SelectedCard.IsOwnedGhost}" />
                                    <Button Classes="ghost" Content="{Binding SelectedCard.GhostProviderLabel}" Command="{Binding OpenGhostOnProviderCommand}" />
                                </WrapPanel>
                                <Button Classes="ghost sm" Content="Add all missing to Wanted" Command="{Binding AddAllMissingToWantedCommand}" HorizontalAlignment="Left"
                                        IsVisible="{Binding SelectedCard.IsMissingGhost}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding SelectedCard.IsMember}">
                                <Border Classes="pbChip" Padding="8,4">
                                    <TextBlock Text="{Binding SelectedCard.RoleLabel}" FontSize="10" Foreground="{DynamicResource PbTextMutedBrush}" />
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Panel Width="12" Height="12" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Stroke="{DynamicResource PbTextMutedBrush}" StrokeThickness="1.25" IsVisible="{Binding SelectedCard.IsUnread}" />
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource PbAccentBrush}" IsVisible="{Binding SelectedCard.IsInProgress}" />
                                        <fi:SymbolIcon Symbol="Checkmark" FontSize="12" Foreground="{DynamicResource PbSuccessBrush}" IsVisible="{Binding SelectedCard.IsRead}" />
                                    </Panel>
                                    <TextBlock Text="{Binding SelectedCard.ReadStateLabel}" FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding SelectedCard.IsMissing}">
                                    <fi:SymbolIcon Symbol="Warning" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbDangerBrush}" />
                                    <TextBlock Text="File missing" FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="Outside this continuity: its series isn't a member." FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}"
                                       TextWrapping="Wrap" IsVisible="{Binding SelectedCard.IsOutsideContinuity}" />
                            <StackPanel Spacing="{DynamicResource PbSpacingUnit}" IsVisible="{Binding SelectedCard.HasCbroOverlapNotes}">
                                <TextBlock Text="CBRO timeline notes" FontSize="{DynamicResource PbFontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource PbTextMutedBrush}" />
                                <ItemsControl ItemsSource="{Binding SelectedCard.CbroOverlapNotes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="{DynamicResource PbFontSizeMeta}" Foreground="{DynamicResource PbTextMutedBrush}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedCard.Summary}" FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" TextWrapping="Wrap"
                                       MaxLines="6" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectedCard.Summary}"
                                       IsVisible="{Binding SelectedCard.HasSummary}" />
                            <WrapPanel ItemSpacing="8" LineSpacing="8" IsVisible="{Binding SelectedCard.IsMember}">
                                <Button Classes="primary" Command="{Binding OpenReaderCommand}" ToolTip.Tip="Read in event order (Ctrl+Enter)">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <fi:SymbolIcon Symbol="BookOpen" FontSize="{StaticResource PbIconSizeXs}" />
                                        <TextBlock Text="Open reader" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="secondary" Content="{Binding SelectedCard.MarkReadLabel}" Command="{Binding ToggleReadCommand}" />
                                <Button Classes="ghost" Content="Series details" Command="{Binding OpenSeriesDetailCommand}" />
                            </WrapPanel>

                            <StackPanel Spacing="4" IsVisible="{Binding HasConnections}">
                                <TextBlock Text="Connections" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PbTextMutedBrush}" Margin="0,6,0,0" />
                                <ItemsControl ItemsSource="{Binding Connections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:EventMapLinkViewModel">
                                            <Button Classes="mapLink" Command="{Binding $parent[UserControl].((vm:EventMapViewModel)DataContext).SelectLinkCommand}"
                                                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title, StringFormat='Go to {0}'}">
                                                <Grid ColumnDefinitions="110,*">
                                                    <TextBlock Grid.Column="0" Text="{Binding Relation}" FontSize="11" Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource PbTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Spacing="4" IsVisible="{Binding HasSegmentOrder}">
                                <TextBlock Text="Segment order" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PbTextMutedBrush}" Margin="0,6,0,0" />
                                <ItemsControl ItemsSource="{Binding SegmentOrder}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:EventMapLinkViewModel">
                                            <Border Classes="segmentRow" Classes.current="{Binding IsCurrent}" CornerRadius="{DynamicResource PbRadiusSm}">
                                                <Button Classes="mapLink" Command="{Binding $parent[UserControl].((vm:EventMapViewModel)DataContext).SelectLinkCommand}"
                                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title, StringFormat='Go to {0}'}">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource PbTextBrush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding RoleLabel}" FontSize="10" Foreground="{DynamicResource PbTextMutedBrush}" Margin="8,0,0,0" />
                                                    </Grid>
                                                </Button>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
