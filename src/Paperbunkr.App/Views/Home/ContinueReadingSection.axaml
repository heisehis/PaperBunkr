<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fi="using:FluentIcons.Avalonia"
                    xmlns:vm="using:Paperbunkr.App.ViewModels"
                    xmlns:home="using:Paperbunkr.App.ViewModels.Home"
                    xmlns:models="using:Paperbunkr.App.Models"
                    xmlns:views="using:Paperbunkr.App.Views"
                    xmlns:controls="using:Paperbunkr.App.Controls">

    <!--
        Continue Reading - comics and books in one row, last-read first (docs/superpowers/specs/2026-09-28-home-improvements-
        design.md I2). Books carry a small book marker and their author line; comics their issue-number badge.
    -->
    <DataTemplate x:Key="HomeSection.continueReading" DataType="home:ContinueReadingSectionViewModel">
        <StackPanel Spacing="12" controls:ScrollReveal.Enabled="True">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <fi:SymbolIcon Classes="sectionIcon" Symbol="{Binding Icon}" />
                <controls:SplitText Classes="heading" Text="{Binding Title}" AutomationProperties.AutomationId="{Binding HeaderAutomationId}" />
            </StackPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="-8,-8,-8,0" IsVisible="{Binding Home.HasContinueReading}">
                <ItemsControl ItemsSource="{Binding Home.ContinueReading}" Margin="2,2,2,6" AutomationProperties.AutomationId="HomeContinueReadingList"
                              controls:EntranceAnimation.Enabled="{Binding Home.PlayEntranceAnimation}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:HomeResumeCard">
                            <views:PosterTile
                                CoverSource="{Binding CoverImage}"
                                TitleText="{Binding Title}"
                                MetaText="{Binding Meta}"
                                BadgeText="{Binding Badge}"
                                ShowBookGlyph="{Binding IsBook}"
                                ShowProgress="{Binding ShowProgress}"
                                ProgressFraction="{Binding ProgressFraction}"
                                Command="{Binding $parent[UserControl].((vm:HomeScreenViewModel)DataContext).OpenResumeCommand}"
                                CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="Nothing in progress yet" Classes="emptyState" IsVisible="{Binding !Home.HasContinueReading}" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
