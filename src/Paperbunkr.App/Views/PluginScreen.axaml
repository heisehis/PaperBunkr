<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:models="using:Paperbunkr.App.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="760"
             x:Class="Paperbunkr.App.Views.PluginScreen"
             x:DataType="vm:PluginScreenViewModel">

    <UserControl.Styles>
        <Style Selector="Button.headerAction">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.headerAction.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
        </Style>
        <Style Selector="Button.headerAction.primary">
            <Setter Property="Background" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PbBadgeTextBrush}" />
        </Style>

        <Style Selector="Border.groupBox">
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.groupHeader">
            <Setter Property="Background" Value="{DynamicResource PbChromeBrush}" />
            <Setter Property="Padding" Value="14,11" />
        </Style>
        <Style Selector="Border.dupItemRow">
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
        <Style Selector="Border.dupItemRow.keep">
            <Setter Property="Background" Value="#245FA889" />
        </Style>
        <Style Selector="Ellipse.dupRadio">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Stroke" Value="#383D47" />
            <Setter Property="StrokeThickness" Value="1.5" />
        </Style>
        <Style Selector="Ellipse.dupRadio.keep">
            <Setter Property="Fill" Value="{DynamicResource PbSuccessBrush}" />
            <Setter Property="Stroke" Value="{DynamicResource PbSuccessBrush}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel>

            <Grid ColumnDefinitions="*,Auto" Margin="28,20,28,16">
                <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                    <Border BorderBrush="#383D47" BorderThickness="1" CornerRadius="999" Padding="9,3"
                            HorizontalAlignment="Left" Margin="0,0,0,10">
                        <TextBlock Text="{Binding PluginBadge}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PbTextFaintBrush}" />
                    </Border>
                    <TextBlock Text="Duplicate Finder" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PbTextBrush}" />
                    <TextBlock Text="{Binding LastScanLabel}" FontSize="12.5" Foreground="{DynamicResource PbTextFaintBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Classes="headerAction primary" Content="Scan Library" VerticalAlignment="Bottom" />
            </Grid>
            <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,24" />

            <StackPanel Margin="28,0,28,40">

                <Border Background="{DynamicResource PbChromeBrush}" BorderBrush="{DynamicResource PbBorderBrush}"
                        BorderThickness="1" CornerRadius="7" Padding="18,16" Margin="0,0,0,26">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <TextBlock Text="{Binding GroupCount}" FontFamily="Consolas,monospace" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource PbBadgeBrush}" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="duplicate groups found across" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" />
                            <TextBlock Text="3 series" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PbTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:DuplicateGroupSample">
                            <Border Classes="groupBox">
                                <StackPanel>
                                    <Border Classes="groupHeader">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource PbTextBrush}" />
                                            <TextBlock Text="{Binding Note, StringFormat='— {0}'}" FontFamily="Consolas,monospace"
                                                       FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:DuplicateItemSample">
                                                <Border Classes="dupItemRow" Classes.keep="{Binding Keep}">
                                                    <Grid ColumnDefinitions="15,30,*">
                                                        <Ellipse Grid.Column="0" Classes="dupRadio" Classes.keep="{Binding Keep}" VerticalAlignment="Center" />
                                                        <Border Grid.Column="1" Width="30" Height="42" CornerRadius="3"
                                                                Background="#442A1C" VerticalAlignment="Center" Margin="12,0" />
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FileName}" FontFamily="Consolas,monospace" FontSize="12.5"
                                                                       Foreground="{DynamicResource PbTextBrush}" />
                                                            <TextBlock Text="{Binding Info}" FontSize="11" Foreground="{DynamicResource PbTextFaintBrush}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="9" Margin="0,20,0,0">
                    <Button Classes="headerAction ghost" Content="Skip All" />
                    <Button Classes="headerAction primary" Content="Remove Selected Duplicates" />
                </StackPanel>

            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
