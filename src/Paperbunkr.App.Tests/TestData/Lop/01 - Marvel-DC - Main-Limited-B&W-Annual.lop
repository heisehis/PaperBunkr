<?xml version="1.0" encoding="utf-8"?>
<Profile Name="01 - Marvel/DC - Main/Limited/B&amp;W/Annual" Version="2.1">
  <FolderTemplate>{&lt;publisher&gt;}\{ &lt;Custom(First Series)&gt;}\{ &lt;seriesgroup&gt;}\{ &lt;Custom(Second Series)&gt;}\{ &lt;maincharacter&gt;}\{ &lt;format&gt;}\{ (&lt;volume0&gt;)} { &lt;series&gt;}\{ &lt;Custom(Volume Number)&gt;}</FolderTemplate>
  <BaseFolder>D:\Books\ComicBooks\</BaseFolder>
  <FileTemplate>{&lt;series&gt;} - {&lt;number3&gt;} {(&lt;volume&gt;)}</FileTemplate>
  <EmptyFolder />
  <EmptyData />
  <Postfix />
  <Prefix />
  <Seperator />
  <IllegalCharacters>
    <Item Name="&quot;" Value="'" />
    <Item Name="/" Value="" />
    <Item Name="*" Value="" />
    <Item Name="&lt;" Value="[" />
    <Item Name="?" Value="" />
    <Item Name="&gt;" Value="]" />
    <Item Name="|" Value="!" />
    <Item Name=":" Value=" - " />
    <Item Name="\" Value="" />
  </IllegalCharacters>
  <Months>
    <Item Name="1" Value="January" />
    <Item Name="2" Value="February" />
    <Item Name="3" Value="March" />
    <Item Name="4" Value="April" />
    <Item Name="5" Value="May" />
    <Item Name="6" Value="June" />
    <Item Name="7" Value="July" />
    <Item Name="8" Value="August" />
    <Item Name="9" Value="September" />
    <Item Name="10" Value="October" />
    <Item Name="11" Value="November" />
    <Item Name="12" Value="December" />
    <Item Name="13" Value="Spring" />
    <Item Name="14" Value="Summer" />
    <Item Name="15" Value="Fall" />
    <Item Name="16" Value="Winter" />
  </Months>
  <TextBox />
  <UseFolder>true</UseFolder>
  <UseFileName>true</UseFileName>
  <ExcludeFolders />
  <DontAskWhenMultiOne>true</DontAskWhenMultiOne>
  <ExcludeOperator>All</ExcludeOperator>
  <RemoveEmptyFolder>true</RemoveEmptyFolder>
  <ExcludedEmptyFolder />
  <MoveFileless>false</MoveFileless>
  <FilelessFormat>.jpg</FilelessFormat>
  <ExcludeMode>Only</ExcludeMode>
  <FailEmptyValues>false</FailEmptyValues>
  <MoveFailed>false</MoveFailed>
  <FailedFolder />
  <FailedFields />
  <Mode>Move</Mode>
  <CopyMode>true</CopyMode>
  <AutoSpaceFields>true</AutoSpaceFields>
  <ReplaceMultipleSpaces>true</ReplaceMultipleSpaces>
  <CopyReadPercentage>true</CopyReadPercentage>
  <ExcludeRules Operator="All" ExcludeMode="Only">
    <ExcludeGroup Operator="Any">
      <ExcludeRule Field="Format" Operator="is" Value="Main Series" />
      <ExcludeRule Field="Format" Operator="is" Value="Limited Series" />
      <ExcludeRule Field="Format" Operator="is" Value="Black &amp; White" />
      <ExcludeRule Field="Format" Operator="is" Value="Annual" />
    </ExcludeGroup>
    <ExcludeGroup Operator="All">
      <ExcludeRule Field="Tags" Operator="does not contain" Value="Alternate Universes" />
      <ExcludeRule Field="Tags" Operator="does not contain" Value="Publisher" />
      <ExcludeRule Field="Tags" Operator="does not contain" Value="Universe" />
    </ExcludeGroup>
    <ExcludeGroup Operator="Any">
      <ExcludeRule Field="Publisher" Operator="is" Value="Marvel" />
      <ExcludeRule Field="Publisher" Operator="is" Value="DC Comics" />
    </ExcludeGroup>
  </ExcludeRules>
</Profile>