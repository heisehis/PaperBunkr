<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:views="using:Paperbunkr.App.Views"
             xmlns:models="using:Paperbunkr.App.Models"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="850"
             x:Class="Paperbunkr.App.Views.BookDetailScreen"
             x:DataType="vm:BookDetailScreenViewModel">

    <!--
        Book detail, rebuilt on the shared DetailHero / DetailBand controls for UI rework Phase 5
        (docs/superpowers/specs/2026-08-28-detail-screens-streaming-redesign-design.md). Book mode:
        hero + "lite" band (inline meta + synopsis, no metadata groups) + stacked section cards, no
        tab strip. Series mode: hero + poster grid of member books.
    -->
    <UserControl.Styles>
        <Style Selector="Border.sectionCard">
            <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextFaintBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style Selector="Button.listRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.listRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource PbSurface3Brush}" />
        </Style>
        <Style Selector="Button.card">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Border.bookCover">
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusSm}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Button.card:pointerover Border.bookCover">
            <Setter Property="BoxShadow" Value="{StaticResource PbGlowRing}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <Grid>

            <!-- ================= BOOK MODE ================= -->
            <StackPanel Margin="0,0,0,50" IsVisible="{Binding IsBookMode}">
                <Button Classes="backLink" Command="{Binding GoBackCommand}" Content="{Binding BackLabel}" Margin="28,20,28,12" />

                <views:DetailHero DataContext="{Binding}" />
                <views:DetailBand DataContext="{Binding Band}" />

                <StackPanel Margin="28,0,28,0">
                    <!-- Reading progress -->
                    <Border Classes="sectionCard" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Classes="sectionTitle" Text="READING PROGRESS" />
                            <TextBlock Text="{Binding ProgressLabel}" Classes="pbTextBody" IsVisible="{Binding HasChapterProgress}"
                                       Foreground="{DynamicResource PbTextBrush}" Margin="0,0,0,8" />
                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding ProgressFraction}" Height="6"
                                         IsVisible="{Binding HasChapterProgress}" Margin="0,0,0,12" />
                            <Button Classes="detailAction ghost" HorizontalAlignment="Left"
                                    Content="{Binding FinishedToggleLabel}" Command="{Binding ToggleFinishedCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- Chapters -->
                    <Border Classes="sectionCard" IsVisible="{Binding HasChapters}">
                        <StackPanel>
                            <TextBlock Classes="sectionTitle" Text="CHAPTERS" />
                            <ItemsControl ItemsSource="{Binding Chapters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:BookChapterSummary">
                                        <Button Classes="listRow"
                                                Command="{Binding $parent[ItemsControl].((vm:BookDetailScreenViewModel)DataContext).OpenChapterCommand}"
                                                CommandParameter="{Binding}">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Index, StringFormat='{}{0}.'}"
                                                           Classes="pbTextCaption" Width="34" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource PbTextBrush}"
                                                           FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Classes="sectionCard" IsVisible="{Binding ChaptersUnavailable}">
                        <TextBlock Classes="pbTextCaption" TextWrapping="Wrap"
                                   Text="Chapter list unavailable — the file may be missing or damaged." />
                    </Border>

                    <!-- Bookmarks -->
                    <Border Classes="sectionCard" IsVisible="{Binding HasBookmarks}">
                        <StackPanel>
                            <TextBlock Classes="sectionTitle" Text="BOOKMARKS" />
                            <ItemsControl ItemsSource="{Binding Bookmarks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:BookBookmarkSummary">
                                        <Button Classes="listRow"
                                                Command="{Binding $parent[ItemsControl].((vm:BookDetailScreenViewModel)DataContext).OpenBookmarkCommand}"
                                                CommandParameter="{Binding}">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Delete Bookmark"
                                                              Command="{Binding $parent[ItemsControl].((vm:BookDetailScreenViewModel)DataContext).DeleteBookmarkCommand}"
                                                              CommandParameter="{Binding}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{Binding Excerpt}" Foreground="{DynamicResource PbTextBrush}"
                                                           FontSize="12.5" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding ChapterTitle}" Classes="pbTextCaption" />
                                                    <TextBlock Text="{Binding CreatedTime, StringFormat='{}{0:MMM d, yyyy}'}" Classes="pbTextCaption" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Button Classes="detailAction ghost" HorizontalAlignment="Left" Margin="0,20,0,0" Foreground="#E06060">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <fi:SymbolIcon Symbol="Delete" FontSize="15" Foreground="#E06060" />
                                <TextBlock Text="Delete Book" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button.Content>
                        <Button.Flyout>
                            <Flyout>
                                <StackPanel Spacing="8" Width="220">
                                    <TextBlock Classes="pbTextCaption" TextWrapping="Wrap"
                                               Text="Move this book's file to the Recycle Bin and remove it from the library?" />
                                    <Button Classes="detailAction ghost" HorizontalAlignment="Left" Foreground="#E06060"
                                            Content="Yes, delete this book" Command="{Binding DeleteBookCommand}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- ================= SERIES MODE ================= -->
            <StackPanel Margin="0,0,0,50" IsVisible="{Binding IsSeriesMode}">
                <Button Classes="backLink" Command="{Binding GoBackCommand}" Content="{Binding BackLabel}" Margin="28,20,28,12" />

                <views:DetailHero DataContext="{Binding}" />

                <ItemsControl ItemsSource="{Binding SeriesBooks}" Margin="28,22,28,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:BookCardSample">
                            <Button Classes="card" Width="150" Margin="0,0,20,20"
                                    Command="{Binding $parent[ItemsControl].((vm:BookDetailScreenViewModel)DataContext).OpenBookFromSeriesCommand}"
                                    CommandParameter="{Binding}">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Edit…"
                                                  Command="{Binding $parent[ItemsControl].((vm:BookDetailScreenViewModel)DataContext).EditBookInSeriesCommand}"
                                                  CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <StackPanel Spacing="8">
                                    <Border Classes="bookCover" Background="{Binding CoverBrush}" Height="216">
                                        <Grid>
                                            <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                                            <Border Classes="posterScrim" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PbTextBrush}" TextWrapping="Wrap"
                                               MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Author}" Classes="pbTextCaption" TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding Author, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </Grid>
    </ScrollViewer>
</UserControl>
