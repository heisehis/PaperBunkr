<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:models="using:Paperbunkr.App.Models"
             xmlns:views="using:Paperbunkr.App.Views"
             xmlns:controls="using:Paperbunkr.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="640"
             x:Class="Paperbunkr.App.Views.CollectionPropertiesOverlay"
             x:DataType="vm:CollectionPropertiesScreenViewModel"
             controls:ContextMenuHost.Provider="{Binding}">

    <!-- Same "floatingPanel" + Button.ghost/primary primitives as ReadingListPropertiesOverlay
         (Styles/Primitives.axaml) - docs/superpowers/specs/2026-08-27-collections-design.md step 8. -->
    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.groupHeader">
            <Setter Property="Background" Value="{DynamicResource PbChromeBrush}" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style Selector="StackPanel.field">
            <Setter Property="Width" Value="250" />
            <Setter Property="Margin" Value="0,0,16,16" />
        </Style>
        <Style Selector="Button.swatch">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.memberRow">
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,8" />
        </Style>
    </UserControl.Styles>

    <controls:DialogCard Title="Edit collection" Subtitle="{Binding HeaderLabel}" Size="Medium">
        <StackPanel>

            <WrapPanel>
                <StackPanel Classes="field">
                    <TextBlock Classes="fieldLabel" Text="NAME" />
                    <TextBox Text="{Binding Name}" />
                </StackPanel>
                <StackPanel Classes="field" Width="480">
                    <TextBlock Classes="fieldLabel" Text="DESCRIPTION" />
                    <TextBox Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
                </StackPanel>
            </WrapPanel>

            <Border Classes="card" Padding="0" Margin="0,0,0,16">
                <StackPanel>
                    <Border Classes="groupHeader">
                        <TextBlock Text="Appearance" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                    </Border>
                    <StackPanel Margin="14">
                        <TextBlock Classes="fieldLabel" Text="ACCENT COLOR" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
                            <Ellipse Width="22" Height="22" Fill="{Binding AccentColor, Converter={x:Static views:AccentColorToBrushConverter.Instance}}" />
                            <ItemsControl ItemsSource="{Binding AccentSwatches}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <!-- Was <SolidColorBrush Color="{Binding}"/> - a raw hex
                                             string bound directly to a Color-typed property with
                                             no explicit conversion, which doesn't reliably coerce
                                             under this app's compiled-binding mode (found while
                                             fixing the Master-Detail redesign's own accent-color
                                             work, docs/superpowers/specs/2026-09-14-library-
                                             visual-redesign-design.md §6 - every other accent-color
                                             binding in this codebase already goes through an
                                             explicit converter like this one instead of relying on
                                             automatic string-to-Color coercion). -->
                                        <Button Classes="swatch"
                                                Background="{Binding Converter={x:Static views:AccentColorToBrushConverter.Instance}}"
                                                Command="{Binding $parent[UserControl].((vm:CollectionPropertiesScreenViewModel)DataContext).SetAccentColorCommand}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Classes="ghost" Content="None" Command="{Binding ClearAccentColorCommand}" />
                        </StackPanel>

                        <TextBlock Classes="fieldLabel" Text="COVER" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="ghost" Content="Auto (first member)" Command="{Binding UseAutoCoverCommand}"
                                    IsEnabled="{Binding !IsAutoCover}" />
                            <Button Classes="ghost" Content="Choose file…" Command="{Binding ChangeCoverCommand}" />
                            <TextBlock Text="{Binding CoverImagePath}" FontSize="11" Foreground="{DynamicResource PbTextMutedBrush}"
                                       VerticalAlignment="Center" IsVisible="{Binding !IsAutoCover}" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="0">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" Classes="groupHeader">
                        <TextBlock Grid.Column="0" Text="Members" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Members.Count}" FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" />
                    </Grid>
                    <StackPanel Margin="14">
                        <TextBlock Text="No members yet - add some from a Library or Books tile's right-click menu." FontSize="12"
                                   Foreground="{DynamicResource PbTextMutedBrush}" IsVisible="{Binding !Members.Count}" />
                        <ItemsControl ItemsSource="{Binding Members}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CollectionMemberRowViewModel">
                                    <Border Classes="memberRow">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                                        ToolTip.Tip="{Binding RuleMatchedTooltip}">
                                                <TextBlock Text="{Binding DisplayTitle}" FontSize="13" Foreground="{DynamicResource PbTextBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding KindLabelDisplay}" FontSize="10" Foreground="{DynamicResource PbTextMutedBrush}" />
                                            </StackPanel>
                                            <Button AutomationProperties.Name="Move up" Grid.Column="1" Classes="iconButton" IsEnabled="{Binding !IsRuleMatched}"
                                                    Command="{Binding $parent[UserControl].((vm:CollectionPropertiesScreenViewModel)DataContext).MoveMemberUpCommand}"
                                                    CommandParameter="{Binding}" ToolTip.Tip="Move up">
                                                <fi:SymbolIcon Symbol="ChevronUp" FontSize="{StaticResource PbIconSizeXs}" />
                                            </Button>
                                            <Button AutomationProperties.Name="Move down" Grid.Column="2" Classes="iconButton" IsEnabled="{Binding !IsRuleMatched}"
                                                    Command="{Binding $parent[UserControl].((vm:CollectionPropertiesScreenViewModel)DataContext).MoveMemberDownCommand}"
                                                    CommandParameter="{Binding}" ToolTip.Tip="Move down">
                                                <fi:SymbolIcon Symbol="ChevronDown" FontSize="{StaticResource PbIconSizeXs}" />
                                            </Button>
                                            <Button AutomationProperties.Name="Remove from collection" Grid.Column="4" Classes="iconButton"
                                                    Command="{Binding RemoveCommand}" ToolTip.Tip="Remove from collection">
                                                <fi:SymbolIcon Symbol="SubtractCircle" FontSize="{StaticResource PbIconSizeXs}" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="0" Margin="0,16,0,0">
                <StackPanel>
                    <Border Classes="groupHeader">
                        <TextBlock Text="Issues rule" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                    </Border>
                    <StackPanel Margin="14" Orientation="Horizontal" Spacing="8">
                        <controls:SuggestBox IsStrict="True" Suggestions="{Binding IssueSmartListNames}" Text="{Binding SelectedIssueSmartListText}"
                                  MinWidth="220" FontSize="12" Watermark="No Issue smart lists yet" />
                        <Button Classes="ghost" Content="Set" Command="{Binding SetIssueRuleCommand}" />
                        <Button Classes="ghost" Content="Clear" Command="{Binding ClearIssueRuleCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="0" Margin="0,16,0,0">
                <StackPanel>
                    <Border Classes="groupHeader">
                        <TextBlock Text="Series rule" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                    </Border>
                    <StackPanel Margin="14" Orientation="Horizontal" Spacing="8">
                        <controls:SuggestBox IsStrict="True" Suggestions="{Binding SeriesSmartListNames}" Text="{Binding SelectedSeriesSmartListText}"
                                  MinWidth="220" FontSize="12" Watermark="No Series smart lists yet" />
                        <Button Classes="ghost" Content="Set" Command="{Binding SetSeriesRuleCommand}" />
                        <Button Classes="ghost" Content="Clear" Command="{Binding ClearSeriesRuleCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="0" Margin="0,16,0,0">
                <StackPanel>
                    <Border Classes="groupHeader">
                        <TextBlock Text="Novels rule" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                    </Border>
                    <StackPanel Margin="14" Orientation="Horizontal" Spacing="8">
                        <controls:SuggestBox IsStrict="True" Suggestions="{Binding NovelSmartListNames}" Text="{Binding SelectedNovelSmartListText}"
                                  MinWidth="220" FontSize="12" Watermark="No Novel smart lists yet" />
                        <Button Classes="ghost" Content="Set" Command="{Binding SetNovelRuleCommand}" />
                        <Button Classes="ghost" Content="Clear" Command="{Binding ClearNovelRuleCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="0" Margin="0,16,0,0">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" Classes="groupHeader">
                        <TextBlock Grid.Column="0" Text="Related Collections" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                        <Button Grid.Column="1" Classes="ghost" Content="+ Add" Command="{Binding ToggleAddRelationCommand}" />
                    </Grid>
                    <StackPanel Margin="14">
                        <Border IsVisible="{Binding IsAddingRelation}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource PbRadiusSm}" Padding="12" Margin="0,0,0,12">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Relationship:" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource PbTextMutedBrush}" />
                                    <controls:SuggestBox IsStrict="True" Suggestions="{Binding RelationTypeNames}"
                                                         Text="{Binding SelectedRelationTypeOptionText}" MinWidth="160" FontSize="12" />
                                </StackPanel>
                                <TextBox Text="{Binding RelationSearchQuery}" PlaceholderText="Search for a collection…" FontSize="12" />
                                <ItemsControl ItemsSource="{Binding RelationSearchResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:CollectionSearchResult">
                                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6" Margin="0,2"
                                                    Background="Transparent" BorderThickness="0" FontSize="13"
                                                    Foreground="{DynamicResource PbTextMutedBrush}"
                                                    Command="{Binding $parent[UserControl].((vm:CollectionPropertiesScreenViewModel)DataContext).AddRelationCommand}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding Name}" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="No related collections yet." FontSize="12"
                                   Foreground="{DynamicResource PbTextMutedBrush}" IsVisible="{Binding !RelatedCollections.Count}" />
                        <ItemsControl ItemsSource="{Binding RelatedCollections}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:RelatedCollectionChip">
                                    <Border Background="{DynamicResource PbSurfaceAltBrush}" CornerRadius="{DynamicResource PbRadius}" Padding="10,4" Margin="0,0,6,6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center">
                                                <Run Text="{Binding Name}" FontWeight="SemiBold" />
                                                <Run Text="{Binding RelationTypeLabel, StringFormat=' · {0}', Mode=OneWay}" Foreground="{DynamicResource PbTextMutedBrush}" />
                                            </TextBlock>
                                            <Button AutomationProperties.Name="Remove this relation" Classes="iconButton sm"
                                                    Foreground="{DynamicResource PbTextMutedBrush}"
                                                    Command="{Binding $parent[UserControl].((vm:CollectionPropertiesScreenViewModel)DataContext).RemoveRelationCommand}"
                                                    CommandParameter="{Binding}" ToolTip.Tip="Remove this relation"><fi:SymbolIcon Symbol="Dismiss" FontSize="{StaticResource PbIconSizeXs}" /></Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="0" Margin="0,16,0,0">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" Classes="groupHeader">
                        <TextBlock Grid.Column="0" Text="Related" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                        <Button Grid.Column="1" Classes="ghost" Content="+ Add" Command="{Binding ToggleAddSeriesRelationCommand}" />
                    </Grid>
                    <StackPanel Margin="14">
                        <Border IsVisible="{Binding IsAddingSeriesRelation}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource PbRadiusSm}" Padding="12" Margin="0,0,0,12">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Relationship:" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource PbTextMutedBrush}" />
                                    <controls:SuggestBox IsStrict="True" Suggestions="{Binding RelationTypeNames}"
                                                         Text="{Binding SelectedSeriesRelationTypeOptionText}" MinWidth="160" FontSize="12" />
                                </StackPanel>
                                <TextBox Text="{Binding SeriesRelationSearchQuery}" PlaceholderText="Search for a series…" FontSize="12" />
                                <ItemsControl ItemsSource="{Binding SeriesRelationSearchResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:SeriesSearchResult">
                                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6" Margin="0,2"
                                                    Background="Transparent" BorderThickness="0" FontSize="13"
                                                    Foreground="{DynamicResource PbTextMutedBrush}"
                                                    Command="{Binding $parent[UserControl].((vm:CollectionPropertiesScreenViewModel)DataContext).AddSeriesRelationCommand}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding Name}" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="No related series yet." FontSize="12"
                                   Foreground="{DynamicResource PbTextMutedBrush}" IsVisible="{Binding !RelatedSeries.Count}" />
                        <ItemsControl ItemsSource="{Binding RelatedSeries}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:RelatedSeriesChip">
                                    <Border Background="{DynamicResource PbSurfaceAltBrush}" CornerRadius="{DynamicResource PbRadius}" Padding="10,4" Margin="0,0,6,6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center">
                                                <Run Text="{Binding Name}" FontWeight="SemiBold" />
                                                <Run Text="{Binding RelationTypeLabel, StringFormat=' · {0}', Mode=OneWay}" Foreground="{DynamicResource PbTextMutedBrush}" />
                                            </TextBlock>
                                            <Button AutomationProperties.Name="Remove this relation" Classes="iconButton sm"
                                                    Foreground="{DynamicResource PbTextMutedBrush}"
                                                    Command="{Binding $parent[UserControl].((vm:CollectionPropertiesScreenViewModel)DataContext).RemoveSeriesRelationCommand}"
                                                    CommandParameter="{Binding}" ToolTip.Tip="Remove this relation"><fi:SymbolIcon Symbol="Dismiss" FontSize="{StaticResource PbIconSizeXs}" /></Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
        <controls:DialogCard.Footer>
            <StackPanel>
                <Button Classes="ghost" Content="Cancel" Command="{Binding CancelCommand}" />
                <Button Classes="primary" Content="Save" Command="{Binding SaveCommand}" />
            </StackPanel>
        </controls:DialogCard.Footer>
    </controls:DialogCard>
</UserControl>
