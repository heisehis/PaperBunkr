<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:views="using:Paperbunkr.App.Views"
             xmlns:controls="using:Paperbunkr.App.Controls"
             xmlns:models="using:Paperbunkr.App.Models"
             xmlns:entities="using:Paperbunkr.Data.Entities"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="Paperbunkr.App.Views.LibraryScreen"
             x:DataType="vm:LibraryScreenViewModel"
             controls:ContextMenuHost.Provider="{Binding}">

    <UserControl.Styles>
        <!-- Toolbar-only styles (Button.toolbarPill / Border.dropdown / TextBlock.dropdownRow /
             Button.modeOption) moved to Views/LibraryToolbar.axaml alongside the toolbar markup
             (docs/superpowers/specs/2026-08-27-library-browsing-4b-toolbar-rework-design.md §1). -->
        <Style Selector="Button.card">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Border.cover">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="BoxShadow" Value="0 8 24 -12 #80000000" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <!-- Poster-grid glow (UI rework Phase 4a) - the PbGlowRing that PosterTile gets on its root,
             here on the inner cover Border of a Button.card since the card root stays a Button. -->
        <Style Selector="Border.posterCover">
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusSm}" />
            <!-- Real bug, found via manual testing 2026-09-02: even after fixing ClipToBounds (see
                 the note below), the glow was only ever visible as a tiny sliver at the card's
                 bottom edge - this Border shares its exact bounds with the Grid.RowDefinitions="*,Auto"
                 cell above the title/subtitle text row right below it (Grid.Row="1" in the templates
                 below), with zero gap reserved for a shadow to spread into on that side, and every
                 sibling card in the WrapPanel sitting immediately at the ItemSpacing boundary on the
                 other three. A permanent 5px margin (not conditional on the glow states - that would
                 make the cover visibly resize/jump every time you hover or focus a card) reserves a
                 consistent gutter on all four sides so PbGlowRing's 4px spread always has room,
                 whether it's currently showing or not.-->
            <Setter Property="Margin" Value="5,10,5,5" />
            <!-- Real bug found 2026-09-03 via a headless Skia render diagnostic (forced/withheld
                 render-timer ticks to isolate mid-animation frames): animating BoxShadow via
                 BoxShadowsTransition made the ring render incomplete (missing edges, most visibly
                 the top) on every intermediate frame while the spread interpolates from 0 to 4px -
                 the compositor's per-frame invalidated/dirty region doesn't reliably keep up with
                 the shadow's growing overflow beyond this Border's own layout bounds during the
                 transition, so a torn-looking ring shows for the ~150ms of PbMotionFast, self-
                 healing only once the transition settles - which reads as "always broken" if focus
                 moves quickly enough to keep re-triggering it. Confirmed via the same diagnostic
                 that forcing enough render-timer ticks for the transition to finish always produces
                 a complete ring, on any card, regardless of focus order - so removing the animation
                 (instant BoxShadow application, like every other pseudo-class-driven Setter on this
                 Border) is the fix, not a margin/clip/ancestor change.-->
        </Style>
        <!-- Real bug, found via manual testing 2026-09-02: this Border also carries the "cover"
             class (Classes="cover posterCover" in the templates below), whose own style sets
             ClipToBounds="True" (so the cover Image's corners get clipped to the rounded shape).
             PbGlowRing is a spread-only BoxShadow (0 0 0 2 - no blur/offset, just a 2px expansion
             beyond the element's own bounds), which ClipToBounds clips away entirely - the glow was
             never actually invisible-only-on-focus, it never rendered at all, on hover either,
             confirmed by checking both states. Disabling clipping only while the glow itself is
             showing is the standard tradeoff (the cover Image's corners can peek very slightly
             square during hover/focus) rather than losing the glow ring completely. -->
        <Style Selector="Button.card:pointerover Border.posterCover">
            <Setter Property="BoxShadow" Value="{StaticResource PbGlowRing}" />
            <Setter Property="ClipToBounds" Value="False" />
        </Style>
        <Style Selector="Button.card:focus-within Border.posterCover">
            <Setter Property="BoxShadow" Value="{StaticResource PbGlowRing}" />
            <Setter Property="ClipToBounds" Value="False" />
        </Style>

        <!-- Poster-grid group section header (UI rework Phase 4a) - Bebas display type + count + rule. -->
        <Style Selector="StackPanel.posterGroup > DockPanel">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- modeOption list rows - also used by LibraryToolbar.axaml (its own copy); kept here for
             the Add-issue overlay's content-type / reading-mode pickers. -->
        <Style Selector="Button.modeOption">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.modeOption.active">
            <Setter Property="Background" Value="{DynamicResource PbAccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbAccentTextBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- Row-mode hover (4b §7) - List/Tiles rows get a surface-tint on hover. -->
        <Style Selector="Border.libRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="{DynamicResource PbMotionFast}" Easing="{StaticResource PbMotionEase}" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.card:pointerover Border.libRow">
            <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
        </Style>

        <!-- Configurable Details table header cell (4b §8) - borderless click-to-sort button. -->
        <Style Selector="Button.detailsHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,2" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextFaintBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.detailsHeader:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
        </Style>


        <!-- Continue Reading overlay button (docs/superpowers/specs/2026-08-09-library-toolbar-design.md Phase D) -->
        <Style Selector="Button.continueReading">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Background" Value="#B814161B" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="3,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.continueReading Border.icon">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Background" Value="White" />
        </Style>

        <!-- Multi-selection checkbox (docs/superpowers/specs/2026-08-24-library-multiselect-slice1-
             design.md §3) - hover-revealed by default (Opacity 0 -> 1 on Border.cover:pointerover),
             forced visible on every tile once anything is selected (the "forceVisible" class,
             toggled from LibraryScreenViewModel.HasSelection) so the whole active selection stays
             visible/adjustable without hunting for hover targets. -->
        <Style Selector="CheckBox.tileSelect">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.cover:pointerover CheckBox.tileSelect">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="CheckBox.tileSelect.forceVisible">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- Virtualized row list (docs/superpowers/specs — Library issue view-mode virtualization,
             2026-09-03). List / Details modes are a single ListBox over a flat FlatRows/FlatCovers
             collection so one VirtualizingStackPanel virtualizes header + row alike. The ListBox is
             purely a virtualizing host: multi-select stays the app's own checkbox/PointerPressed
             mechanism (SelectedItem is never bound), and ListBoxItem is retemplated to a bare,
             non-focusable ContentPresenter - no selection/hover visual of its own, not a tab stop -
             so the inner Button.card stays the only focus target and its own :pointerover hover
             (Border.libRow) is the only row highlight, matching the old ItemsControl exactly.
             (SelectionMode has no "None" value in Avalonia; the bare non-focusable item template
             makes residual internal selection state inert instead.) -->
        <Style Selector="ListBox.virtualRows">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.virtualRows > ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="Stretch"
                                      VerticalContentAlignment="Stretch"
                                      Padding="0" />
                </ControlTemplate>
            </Setter>
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <!-- Section-header row for the flattened grouped List / Details lists - lifted from the
             per-group DockPanel headers the old nested ItemsControls used (Bebas pbTextHeading +
             count + rule). Resolved by runtime type; only GridSectionHeader items ever hit it. -->
        <DataTemplate DataType="models:GridSectionHeader">
            <DockPanel Margin="0,16,0,10">
                <TextBlock DockPanel.Dock="Left" Text="{Binding Header}" Classes="pbTextHeading" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding Count}" Classes="pbTextCaption" Margin="8,0,0,0" VerticalAlignment="Center" />
                <Border Height="1" VerticalAlignment="Center" Margin="14,0,0,0" Background="{DynamicResource PbBorderBrush}" />
            </DockPanel>
        </DataTemplate>
    </UserControl.DataTemplates>

    <UserControl.Resources>
        <DataTemplate x:Key="PanoramaGridItemTemplate" x:DataType="models:IssueListRow">
            <Button Classes="card" Margin="0" Width="{Binding PanoramaWidth}"
                    Command="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).IssueList.OpenIssueCommand}"
                    CommandParameter="{Binding}" KeyDown="OnCardKeyDown" PointerPressed="OnTilePointerPressed">
                <StackPanel>
                    <Border Classes="cover" Background="{Binding CoverBrush}"
                            Height="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).PanoramaCardHeight}">
                        <Grid>
                            <!-- Uniform (not UniformToFill) - the box is already sized to this cover's own
                                 aspect ratio, so nothing gets cropped; only extreme clamped outliers letterbox. -->
                            <Image views:AsyncCoverImage.SourceId="{Binding Id}" Stretch="Uniform" />
                            <Border Classes="posterScrim" />
                            <Border IsVisible="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ShowUnreadBadge}">
                                <Border IsVisible="{Binding !IsRead}" Background="#B814161B"
                                        CornerRadius="999" Padding="6,2" HorizontalAlignment="Right"
                                        VerticalAlignment="Top" Margin="7">
                                    <TextBlock Text="●" FontFamily="Consolas,monospace"
                                               FontSize="10" FontWeight="Bold" Foreground="White" />
                                </Border>
                            </Border>
                            <Border IsVisible="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ShowPublisherBadge}">
                                <Border IsVisible="{Binding HasPublisher}" Background="#B814161B" CornerRadius="999" Padding="5,2"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7">
                                    <controls:BrandMark Family="Publisher" Value="{Binding Publisher}" ShowText="False"
                                                        MarkSize="12" Foreground="White" />
                                </Border>
                            </Border>
                            <Border IsVisible="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ShowLanguageBadge}">
                                <Border IsVisible="{Binding HasLanguage}" Background="#B814161B" CornerRadius="999" Padding="5,2"
                                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="7">
                                    <Panel>
                                        <TextBlock Text="{Binding LanguageIso}" FontSize="9" FontWeight="Bold" Foreground="White"
                                                   IsVisible="{Binding !$parent[UserControl].((vm:LibraryScreenViewModel)DataContext).UseLanguageIcon}" />
                                        <controls:BrandMark Family="Language" Value="{Binding LanguageIso}" ShowText="False" MarkSize="11"
                                                            Foreground="White"
                                                            IsVisible="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).UseLanguageIcon}" />
                                    </Panel>
                                </Border>
                            </Border>
                            <CheckBox Classes="tileSelect" Classes.forceVisible="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).HasSelection}"
                                      IsChecked="{Binding IsSelected, Mode=OneWay}"
                                      Command="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ToggleIssueSelectionCheckboxCommand}"
                                      CommandParameter="{Binding}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="7" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding SeriesName}" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource PbTextBrush}" TextTrimming="CharacterEllipsis"
                               Margin="0,8,0,0" ToolTip.Tip="{Binding SeriesName}" />
                    <TextBlock Text="{Binding Number, StringFormat='#{0}'}" FontSize="11" Foreground="{DynamicResource PbTextFaintBrush}"
                               Margin="0,1,0,0" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="ListItemTemplate" x:DataType="models:IssueListRow">
            <Button Classes="card" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                    Command="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).IssueList.OpenIssueCommand}"
                    CommandParameter="{Binding}" PointerPressed="OnTilePointerPressed">
                <Border Classes="libRow" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource PbRadius}" Padding="10">
                    <Grid ColumnDefinitions="44,*,Auto">
                        <Panel Grid.Column="0">
                            <Border CornerRadius="{DynamicResource PbRadiusSm}" Width="44" Height="63"
                                    Background="{Binding CoverBrush}" ClipToBounds="True">
                                <Image views:AsyncCoverImage.SourceId="{Binding Id}" Stretch="UniformToFill" />
                            </Border>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}"
                                      Command="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ToggleIssueSelectionCheckboxCommand}"
                                      CommandParameter="{Binding}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4" />
                        </Panel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PbTextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SeriesName}" FontSize="11" Foreground="{DynamicResource PbTextFaintBrush}" Margin="0,2,0,0"
                                       ToolTip.Tip="{Binding SeriesName}" />
                        </StackPanel>
                        <Border Grid.Column="2" IsVisible="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ShowUnreadBadge}">
                            <Border IsVisible="{Binding !IsRead}" Background="{DynamicResource PbAccentSoftBrush}"
                                    CornerRadius="999" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="●" FontFamily="Consolas,monospace" FontSize="11"
                                           FontWeight="Bold" Foreground="{DynamicResource PbAccentTextBrush}" />
                            </Border>
                        </Border>
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="DetailsItemTemplate" x:DataType="models:IssueListRow">
            <Button Classes="card" HorizontalAlignment="Stretch" Margin="0,0,0,4"
                    Command="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).IssueList.OpenIssueCommand}"
                    CommandParameter="{Binding}" PointerPressed="OnTilePointerPressed">
                <Grid ColumnDefinitions="52,*" Margin="0,6">
                    <Panel Grid.Column="0">
                        <Border Width="36" Height="50" CornerRadius="{DynamicResource PbRadiusSm}" Background="{Binding CoverBrush}" ClipToBounds="True">
                            <Image views:AsyncCoverImage.SourceId="{Binding Id}" Stretch="UniformToFill" />
                        </Border>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}"
                                  Command="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ToggleIssueSelectionCheckboxCommand}"
                                  CommandParameter="{Binding}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4" />
                    </Panel>
                    <!-- Configurable columns (4b §8) - one horizontal cell per visible DetailsColumn;
                         a hidden column drops out of the StackPanel so the header row (same source,
                         same fixed widths) stays aligned. -->
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).DetailsColumns}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:DetailsColumn">
                                <TextBlock IsVisible="{Binding IsVisible}" Width="{Binding Width}" Margin="0,0,10,0"
                                           FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource PbTextMutedBrush}">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{x:Static views:DetailsCellConverter.Instance}">
                                            <Binding Path="Field" />
                                            <Binding Path="$parent[Button].DataContext" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="TilesItemTemplate" x:DataType="models:IssueListRow">
            <Button Classes="card" Margin="0"
                    Width="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).TilesCardWidth}"
                    Command="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).IssueList.OpenIssueCommand}"
                    CommandParameter="{Binding}" PointerPressed="OnTilePointerPressed">
                <Border Classes="libRow" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource PbRadius}" Padding="8">
                    <Grid ColumnDefinitions="Auto,*">
                        <Panel Grid.Column="0">
                            <Border CornerRadius="{DynamicResource PbRadiusSm}"
                                    Width="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).TilesThumbWidth}"
                                    Height="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).TilesThumbHeight}"
                                    Background="{Binding CoverBrush}" ClipToBounds="True">
                                <Image views:AsyncCoverImage.SourceId="{Binding Id}" Stretch="UniformToFill" />
                            </Border>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}"
                                      Command="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ToggleIssueSelectionCheckboxCommand}"
                                      CommandParameter="{Binding}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4" />
                        </Panel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PbTextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SeriesName}" FontSize="10.5" Foreground="{DynamicResource PbTextFaintBrush}"
                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SeriesName}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>

        <!-- ============ Series-granularity card templates ============
             Mirrors the per-issue templates above field-for-field, retargeted at SeriesCardSample
             instead of IssueListRow - the switchable one-card-per-series Granularity (docs/
             superpowers/specs/2026-08-18-library-book-centric-redesign-design.md). Phase 4a's
             PosterGridSeriesTemplate lives further down with its issue counterpart. -->
        <DataTemplate x:Key="SeriesPanoramaGridItemTemplate" x:DataType="models:SeriesCardSample">
            <Button Classes="card" Margin="0" Width="{Binding PanoramaWidth}"
                    Command="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).SelectCardCommand}"
                    CommandParameter="{Binding}" KeyDown="OnCardKeyDown" PointerPressed="OnSeriesTilePointerPressed">
                <StackPanel>
                    <Border Classes="cover" Background="{Binding CoverBrush}"
                            Height="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).PanoramaCardHeight}">
                        <Grid>
                            <!-- Uniform (not UniformToFill) - the box is already sized to this cover's own
                                 aspect ratio, so nothing gets cropped; only extreme clamped outliers letterbox. -->
                            <Image views:AsyncCoverImage.SourceId="{Binding CoverIssueId}" Stretch="Uniform" />
                            <Border Classes="posterScrim" />
                            <Border IsVisible="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ShowUnreadBadge}">
                                <Border IsVisible="{Binding HasUnread}" Background="#B814161B"
                                        CornerRadius="999" Padding="6,2" HorizontalAlignment="Right"
                                        VerticalAlignment="Top" Margin="7">
                                    <TextBlock Text="{Binding UnreadCount}" FontFamily="Consolas,monospace"
                                               FontSize="10" FontWeight="Bold" Foreground="White" />
                                </Border>
                            </Border>
                            <Border IsVisible="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ShowPublisherBadge}">
                                <Border IsVisible="{Binding HasPublisher}" Background="#B814161B" CornerRadius="999" Padding="5,2"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7">
                                    <controls:BrandMark Family="Publisher" Value="{Binding Publisher}" ShowText="False"
                                                        MarkSize="12" Foreground="White" />
                                </Border>
                            </Border>
                            <Border IsVisible="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ShowLanguageBadge}">
                                <Border IsVisible="{Binding HasLanguage}" Background="#B814161B" CornerRadius="999" Padding="5,2"
                                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="7">
                                    <Panel>
                                        <TextBlock Text="{Binding LanguageIso}" FontSize="9" FontWeight="Bold" Foreground="White"
                                                   IsVisible="{Binding !$parent[UserControl].((vm:LibraryScreenViewModel)DataContext).UseLanguageIcon}" />
                                        <controls:BrandMark Family="Language" Value="{Binding LanguageIso}" ShowText="False" MarkSize="11"
                                                            Foreground="White"
                                                            IsVisible="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).UseLanguageIcon}" />
                                    </Panel>
                                </Border>
                            </Border>
                            <Border IsVisible="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ShowContinueReadingButton}">
                                <Button Classes="continueReading" IsVisible="{Binding HasContinueReading}"
                                        Command="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ContinueReadingCommand}"
                                        CommandParameter="{Binding}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <fi:SymbolIcon Symbol="Play" />
                                </Button>
                            </Border>
                            <CheckBox Classes="tileSelect" Classes.forceVisible="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).HasSeriesSelection}"
                                      IsChecked="{Binding IsSelected, Mode=OneWay}"
                                      Command="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ToggleSeriesSelectionCheckboxCommand}"
                                      CommandParameter="{Binding}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource PbTextBrush}" TextTrimming="CharacterEllipsis"
                               Margin="0,8,0,0" />
                    <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="{DynamicResource PbTextFaintBrush}"
                               Margin="0,1,0,0" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="SeriesListItemTemplate" x:DataType="models:SeriesCardSample">
            <Button Classes="card" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                    Command="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).SelectCardCommand}"
                    CommandParameter="{Binding}" PointerPressed="OnSeriesTilePointerPressed">
                <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                    <Grid ColumnDefinitions="44,*,Auto">
                        <Border Grid.Column="0" CornerRadius="4" Width="44" Height="63"
                                Background="{Binding CoverBrush}" ClipToBounds="True">
                            <Grid>
                                <Image views:AsyncCoverImage.SourceId="{Binding CoverIssueId}" Stretch="UniformToFill" />
                                <!-- Always visible (not hover-gated like the grid-card templates above) -
                                     this thumbnail is too small to have a Border.cover-class hover parent
                                     to key off, and a permanently tiny checkbox is unobtrusive at this scale. -->
                                <CheckBox Classes="tileSelect forceVisible"
                                          IsChecked="{Binding IsSelected, Mode=OneWay}"
                                          Command="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ToggleSeriesSelectionCheckboxCommand}"
                                          CommandParameter="{Binding}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="1" Padding="0" MinWidth="14" MinHeight="14" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PbTextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="{DynamicResource PbTextFaintBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Grid.Column="2" IsVisible="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ShowUnreadBadge}">
                            <Border IsVisible="{Binding HasUnread}" Background="{DynamicResource PbAccentSoftBrush}"
                                    CornerRadius="999" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UnreadCount}" FontFamily="Consolas,monospace" FontSize="11"
                                           FontWeight="Bold" Foreground="{DynamicResource PbAccentTextBrush}" />
                            </Border>
                        </Border>
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="SeriesDetailsItemTemplate" x:DataType="models:SeriesCardSample">
            <Button Classes="card" HorizontalAlignment="Stretch" Margin="0,0,0,4"
                    Command="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).SelectCardCommand}"
                    CommandParameter="{Binding}" PointerPressed="OnSeriesTilePointerPressed">
                <Grid ColumnDefinitions="52,*,110,70,70,140" Margin="0,6">
                    <Border Grid.Column="0" Width="36" Height="50" CornerRadius="3" Background="{Binding CoverBrush}" ClipToBounds="True">
                        <Grid>
                            <Image views:AsyncCoverImage.SourceId="{Binding CoverIssueId}" Stretch="UniformToFill" />
                            <CheckBox Classes="tileSelect forceVisible"
                                      IsChecked="{Binding IsSelected, Mode=OneWay}"
                                      Command="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ToggleSeriesSelectionCheckboxCommand}"
                                      CommandParameter="{Binding}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="1" Padding="0" MinWidth="14" MinHeight="14" />
                        </Grid>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource PbTextBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding ContentTypeLabel}" FontSize="12"
                               Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding IssueCount}" FontFamily="Consolas,monospace" FontSize="12"
                               Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{Binding UnreadCount}" FontFamily="Consolas,monospace" FontSize="12"
                               Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                    <controls:BrandMark Grid.Column="5" Family="Publisher" Value="{Binding Publisher}" ShowText="True"
                                        MarkSize="13" Foreground="{DynamicResource PbTextFaintBrush}" VerticalAlignment="Center" />
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="SeriesTilesItemTemplate" x:DataType="models:SeriesCardSample">
            <Button Classes="card" Margin="0"
                    Width="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).TilesCardWidth}"
                    Command="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).SelectCardCommand}"
                    CommandParameter="{Binding}" PointerPressed="OnSeriesTilePointerPressed">
                <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0" CornerRadius="4"
                                Width="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).TilesThumbWidth}"
                                Height="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).TilesThumbHeight}"
                                Background="{Binding CoverBrush}" ClipToBounds="True">
                            <Grid>
                                <Image views:AsyncCoverImage.SourceId="{Binding CoverIssueId}" Stretch="UniformToFill" />
                                <CheckBox Classes="tileSelect forceVisible"
                                          IsChecked="{Binding IsSelected, Mode=OneWay}"
                                          Command="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ToggleSeriesSelectionCheckboxCommand}"
                                          CommandParameter="{Binding}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="1" Padding="0" MinWidth="14" MinHeight="14" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PbTextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Sub}" FontSize="10.5" Foreground="{DynamicResource PbTextFaintBrush}"
                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>

        <!-- ============ Poster grid (UI rework Phase 4a) ============
             The single grid template replacing Compact/Comfortable/Cover-only. Size comes from
             PosterCardWidth/Height (the density slider); the title row shows per
             EffectiveShowTileTitles. Root stays a Button so ContextMenu/Command/OnCardKeyDown/
             OnTilePointerPressed carry over unchanged; the glow ring lives on the inner
             Border.posterCover via a Button.card:pointerover selector. Scrim + pbChip + unread dot
             per docs/superpowers/specs/2026-08-27-library-browsing-4a-poster-grid-design.md. -->
        <DataTemplate x:Key="PosterGridIssueTemplate" x:DataType="models:IssueListRow">
            <Button Classes="card" Margin="0"
                    Width="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).PosterCardWidth}"
                    KeyDown="OnCardKeyDown" PointerPressed="OnTilePointerPressed" DoubleTapped="OnCardDoubleTapped">
                <Grid RowDefinitions="*,Auto">
                    <Border Grid.Row="0" Classes="cover posterCover" Background="{Binding CoverBrush}"
                            Height="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).PosterCoverHeight}">
                        <Grid>
                            <Image views:AsyncCoverImage.SourceId="{Binding Id}" Stretch="UniformToFill" />
                            <Border Classes="posterScrim" />
                            <Border Classes="pbChip" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                                <Border.IsVisible>
                                    <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                                        <Binding Path="HasPublisher" />
                                        <Binding Path="$parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ShowPublisherBadge" />
                                    </MultiBinding>
                                </Border.IsVisible>
                                <controls:BrandMark Family="Publisher" Value="{Binding Publisher}" ShowText="True"
                                                    MarkSize="12" Foreground="{DynamicResource PbBadgeBrush}" />
                            </Border>
                            <Ellipse Width="9" Height="9" Fill="{DynamicResource PbAccentTextBrush}" Stroke="Black" StrokeThickness="1.5"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="7">
                                <Ellipse.IsVisible>
                                    <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                                        <Binding Path="!IsRead" />
                                        <Binding Path="$parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ShowUnreadBadge" />
                                    </MultiBinding>
                                </Ellipse.IsVisible>
                            </Ellipse>
                            <CheckBox Classes="tileSelect" Classes.forceVisible="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).HasSelection}"
                                      IsChecked="{Binding IsSelected, Mode=OneWay}"
                                      Command="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ToggleIssueSelectionCheckboxCommand}"
                                      CommandParameter="{Binding}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="0,8,0,0" Spacing="1"
                                IsVisible="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).EffectiveShowTileTitles}">
                        <TextBlock Text="{Binding SeriesName}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PbTextBrush}" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding SeriesName}" />
                        <TextBlock Text="{Binding Number, StringFormat='#{0}'}" Classes="pbTextCaption" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="PosterGridSeriesTemplate" x:DataType="models:SeriesCardSample">
            <Button Classes="card" Margin="0"
                    Width="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).PosterCardWidth}"
                    KeyDown="OnCardKeyDown" PointerPressed="OnSeriesTilePointerPressed" DoubleTapped="OnCardDoubleTapped">
                <Grid RowDefinitions="*,Auto">
                    <Border Grid.Row="0" Classes="cover posterCover" Background="{Binding CoverBrush}"
                            Height="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).PosterCoverHeight}">
                        <Grid>
                            <Image views:AsyncCoverImage.SourceId="{Binding CoverIssueId}" Stretch="UniformToFill" />
                            <Border Classes="posterScrim" />
                            <Border Classes="pbChip" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                                <Border.IsVisible>
                                    <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                                        <Binding Path="HasPublisher" />
                                        <Binding Path="$parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ShowPublisherBadge" />
                                    </MultiBinding>
                                </Border.IsVisible>
                                <controls:BrandMark Family="Publisher" Value="{Binding Publisher}" ShowText="True"
                                                    MarkSize="12" Foreground="{DynamicResource PbBadgeBrush}" />
                            </Border>
                            <Border Background="{DynamicResource PbAccentBrush}" CornerRadius="999" Padding="5,1"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6">
                                <Border.IsVisible>
                                    <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                                        <Binding Path="HasUnread" />
                                        <Binding Path="$parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ShowUnreadBadge" />
                                    </MultiBinding>
                                </Border.IsVisible>
                                <TextBlock Text="{Binding UnreadCount}" FontFamily="Consolas,monospace" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource PbBadgeTextBrush}" />
                            </Border>
                            <Button Classes="continueReading" Width="26" Height="26"
                                    Command="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ContinueReadingCommand}"
                                    CommandParameter="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button.IsVisible>
                                    <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                                        <Binding Path="HasContinueReading" />
                                        <Binding Path="$parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ShowContinueReadingButton" />
                                    </MultiBinding>
                                </Button.IsVisible>
                                <fi:SymbolIcon Symbol="Play" />
                            </Button>
                            <CheckBox Classes="tileSelect" Classes.forceVisible="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).HasSeriesSelection}"
                                      IsChecked="{Binding IsSelected, Mode=OneWay}"
                                      Command="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).ToggleSeriesSelectionCheckboxCommand}"
                                      CommandParameter="{Binding}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="0,8,0,0" Spacing="1"
                                IsVisible="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).EffectiveShowTileTitles}">
                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PbTextBrush}" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding Name}" />
                        <TextBlock Text="{Binding Sub}" Classes="pbTextCaption" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
        <!-- Mixed-membership Collection grid (docs/superpowers/specs/2026-08-27-collections-
             design.md, step 9) - a trimmed PosterGridIssueTemplate: no selection checkbox/publisher
             badge/unread dot, since a Collection's grid isn't multi-select-aware and members span
             three entity kinds those badges don't uniformly apply to. Series/Issue tiles resolve
             their cover lazily via CoverIssueId; Book tiles carry an already-decoded CoverImage
             instead (see LibraryTile's own doc comment) - stacking both Images is simpler than a
             null-check converter, since whichever one is unbound just renders nothing. -->
        <DataTemplate x:Key="CollectionTileTemplate" x:DataType="models:LibraryTile">
            <Button Classes="card" Margin="0"
                    Width="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).PosterCardWidth}"
                    Command="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).SelectCollectionMemberCommand}"
                    CommandParameter="{Binding}">
                <Grid RowDefinitions="*,Auto">
                    <Border Grid.Row="0" Classes="cover posterCover" Background="{Binding CoverBrush}"
                            Height="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).PosterCoverHeight}">
                        <Grid>
                            <Image views:AsyncCoverImage.SourceId="{Binding CoverIssueId}" Stretch="UniformToFill" />
                            <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                            <Border Classes="posterScrim" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="0,8,0,0" Spacing="1">
                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PbTextBrush}" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding Title}" />
                        <TextBlock Text="{Binding Subtitle}" Classes="pbTextCaption" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <!-- DragDrop.AllowDrop on the screen root so a file/folder drop anywhere on the Library screen
         imports it (docs/superpowers/specs/2026-08-31-drag-and-drop-import-design.md) - matches CE's
         "drop anywhere on the list" behavior. No drag-over affordance, same as CE. -->
    <Grid RowDefinitions="Auto,*"
          DragDrop.AllowDrop="True" DragDrop.DragOver="OnDragOver" DragDrop.Drop="OnDrop">

        <!-- ============ Toolbar (extracted to Views/LibraryToolbar.axaml, 4b §1) ============ -->
        <views:LibraryToolbar x:Name="Toolbar" Grid.Row="0" />

        <!-- ============ Poster grid (UI rework Phase 4a) - one grid replacing Compact/
             Comfortable/Cover-only. Same 4-way inner split (Issue/Series x grouped/ungrouped);
             PosterCardWidth/Height (density slider) size the wrap panel, EffectiveShowTileTitles
             gates each tile's own text row. ============ -->
        <ScrollViewer x:Name="PosterGridScrollViewer" Grid.Row="1" IsVisible="{Binding IsPosterGrid}">
            <Grid>
                <Panel IsVisible="{Binding IsIssueGranularity}">
                    <ItemsControl IsVisible="{Binding !IssueList.IsGrouped}" ItemsSource="{Binding IssueList.Rows}"
                                  ItemTemplate="{StaticResource PosterGridIssueTemplate}" Margin="24,22,24,40">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><controls:VirtualizingWrapPanel ItemWidth="{Binding PosterCardWidth}" ItemHeight="{Binding PosterCardHeight}" ItemSpacing="20" LineSpacing="20" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <ItemsControl IsVisible="{Binding IssueList.IsGrouped}" ItemsSource="{Binding IssueList.Groups}" Margin="24,22,24,40">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:IssueListRowGroup">
                                <StackPanel Classes="posterGroup" Margin="0,0,0,22">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Header}" Classes="pbTextHeading" VerticalAlignment="Center" />
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Items.Count}" Classes="pbTextCaption" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        <Border Height="1" VerticalAlignment="Center" Margin="14,0,0,0" Background="{DynamicResource PbBorderBrush}" />
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource PosterGridIssueTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><controls:VirtualizingWrapPanel ItemWidth="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).PosterCardWidth}" ItemHeight="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).PosterCardHeight}" ItemSpacing="20" LineSpacing="20" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Panel>
                <Panel IsVisible="{Binding IsSeriesGranularity}">
                    <ItemsControl IsVisible="{Binding !IsGrouped}" ItemsSource="{Binding Covers}"
                                  ItemTemplate="{StaticResource PosterGridSeriesTemplate}" Margin="24,22,24,40">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><controls:VirtualizingWrapPanel ItemWidth="{Binding PosterCardWidth}" ItemHeight="{Binding PosterCardHeight}" ItemSpacing="20" LineSpacing="20" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <ItemsControl IsVisible="{Binding IsGrouped}" ItemsSource="{Binding Groups}" Margin="24,22,24,40">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:SeriesCardGroup">
                                <StackPanel Classes="posterGroup" Margin="0,0,0,22">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Header}" Classes="pbTextHeading" VerticalAlignment="Center" />
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Items.Count}" Classes="pbTextCaption" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        <Border Height="1" VerticalAlignment="Center" Margin="14,0,0,0" Background="{DynamicResource PbBorderBrush}" />
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource PosterGridSeriesTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><controls:VirtualizingWrapPanel ItemWidth="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).PosterCardWidth}" ItemHeight="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).PosterCardHeight}" ItemSpacing="20" LineSpacing="20" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Panel>
            </Grid>
        </ScrollViewer>

        <!-- ============ Panorama comfortable grid ============ -->
        <!-- Variable per-cover tile width (each card binds its own IssueListRow/SeriesCardSample
             .PanoramaWidth, derived from the real cover aspect ratio) on a virtualizing panel that
             packs rows from those widths without decoding every cover - VirtualizingVariableWrapPanel,
             not the uniform-cell VirtualizingWrapPanel the other grids ride. Landscape covers wide,
             portrait covers narrow, side by side - the reason Panorama exists. -->
        <ScrollViewer x:Name="PanoramaScrollViewer" Grid.Row="1" IsVisible="{Binding IsPanoramaGrid}">
            <Grid>
                <Panel IsVisible="{Binding IsIssueGranularity}">
                    <ItemsControl IsVisible="{Binding !IssueList.IsGrouped}" ItemsSource="{Binding IssueList.Rows}"
                                  ItemTemplate="{StaticResource PanoramaGridItemTemplate}" Margin="24,22,24,40">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><controls:VirtualizingVariableWrapPanel ItemHeight="{Binding PanoramaGridItemHeight}" ItemSpacing="20" LineSpacing="20" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <ItemsControl IsVisible="{Binding IssueList.IsGrouped}" ItemsSource="{Binding IssueList.Groups}" Margin="24,22,24,40">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:IssueListRowGroup">
                                <StackPanel Margin="0,0,0,18">
                                    <DockPanel Margin="0,0,0,10"><TextBlock DockPanel.Dock="Left" Text="{Binding Header}" Classes="pbTextHeading" VerticalAlignment="Center" /><TextBlock DockPanel.Dock="Left" Text="{Binding Items.Count}" Classes="pbTextCaption" Margin="8,0,0,0" VerticalAlignment="Center" /><Border Height="1" VerticalAlignment="Center" Margin="14,0,0,0" Background="{DynamicResource PbBorderBrush}" /></DockPanel>
                                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource PanoramaGridItemTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><controls:VirtualizingVariableWrapPanel ItemHeight="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).PanoramaGridItemHeight}" ItemSpacing="20" LineSpacing="20" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Panel>
                <Panel IsVisible="{Binding IsSeriesGranularity}">
                    <ItemsControl IsVisible="{Binding !IsGrouped}" ItemsSource="{Binding Covers}"
                                  ItemTemplate="{StaticResource SeriesPanoramaGridItemTemplate}" Margin="24,22,24,40">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><controls:VirtualizingVariableWrapPanel ItemHeight="{Binding PanoramaGridItemHeight}" ItemSpacing="20" LineSpacing="20" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <ItemsControl IsVisible="{Binding IsGrouped}" ItemsSource="{Binding Groups}" Margin="24,22,24,40">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:SeriesCardGroup">
                                <StackPanel Margin="0,0,0,18">
                                    <DockPanel Margin="0,0,0,10"><TextBlock DockPanel.Dock="Left" Text="{Binding Header}" Classes="pbTextHeading" VerticalAlignment="Center" /><TextBlock DockPanel.Dock="Left" Text="{Binding Items.Count}" Classes="pbTextCaption" Margin="8,0,0,0" VerticalAlignment="Center" /><Border Height="1" VerticalAlignment="Center" Margin="14,0,0,0" Background="{DynamicResource PbBorderBrush}" /></DockPanel>
                                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource SeriesPanoramaGridItemTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><controls:VirtualizingVariableWrapPanel ItemHeight="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).PanoramaGridItemHeight}" ItemSpacing="20" LineSpacing="20" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Panel>
            </Grid>
        </ScrollViewer>

        <!-- ============ List ============ -->
        <!-- One virtualized ListBox per granularity over the flat FlatRows/FlatCovers projection
             (grouped => GridSectionHeader rows interleaved). See the ListBox.virtualRows style. -->
        <Panel Grid.Row="1" IsVisible="{Binding IsListView}">
            <ListBox x:Name="ListModeIssueBox" Classes="virtualRows" IsVisible="{Binding IsIssueGranularity}"
                     ItemsSource="{Binding IssueList.FlatRows}"
                     Padding="24,18,24,40" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.DataTemplates>
                    <DataTemplate DataType="models:IssueListRow">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ListItemTemplate}" />
                    </DataTemplate>
                </ListBox.DataTemplates>
            </ListBox>
            <ListBox x:Name="ListModeSeriesBox" Classes="virtualRows" IsVisible="{Binding IsSeriesGranularity}"
                     ItemsSource="{Binding FlatCovers}"
                     Padding="24,18,24,40" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.DataTemplates>
                    <DataTemplate DataType="models:SeriesCardSample">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SeriesListItemTemplate}" />
                    </DataTemplate>
                </ListBox.DataTemplates>
            </ListBox>
        </Panel>

        <!-- ============ Details ============ -->
        <DockPanel Grid.Row="1" IsVisible="{Binding IsDetailsView}" Margin="24,18,24,0">
            <!-- Configurable, click-to-sort header (4b §8) - same DetailsColumns source + fixed
                 widths as each data row, so hiding a column keeps both aligned. Right-click for the
                 column picker. -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="52,*" Margin="0,0,16,8" IsVisible="{Binding IsIssueGranularity}"
                  controls:ContextMenuHost.Provider="{Binding DetailsColumnsMenuProvider}">
                <ItemsControl Grid.Column="1" ItemsSource="{Binding DetailsColumns}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:DetailsColumn">
                            <Button Classes="detailsHeader" IsVisible="{Binding IsVisible}" Width="{Binding Width}"
                                    Command="{Binding $parent[ItemsControl].((vm:LibraryScreenViewModel)DataContext).SetDetailsSortCommand}"
                                    CommandParameter="{Binding Field}"
                                    AutomationProperties.AutomationId="{Binding Field, StringFormat='LibraryDetailsHeader_{0}'}">
                                <TextBlock TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding DisplayName}" />
                                    <Run>
                                        <Run.Text>
                                            <MultiBinding Converter="{x:Static views:DetailsSortGlyphConverter.Instance}">
                                                <Binding Path="Field" />
                                                <Binding Path="$parent[ItemsControl].((vm:LibraryScreenViewModel)DataContext).IssueList.SortField" />
                                                <Binding Path="$parent[ItemsControl].((vm:LibraryScreenViewModel)DataContext).IssueList.SortDirection" />
                                            </MultiBinding>
                                        </Run.Text>
                                    </Run>
                                </TextBlock>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="52,*,110,70,70,140" Margin="0,0,16,8" IsVisible="{Binding IsSeriesGranularity}">
                <TextBlock Grid.Column="1" Text="Name" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PbTextFaintBrush}" Margin="10,0,0,0" />
                <TextBlock Grid.Column="2" Text="Content Type" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PbTextFaintBrush}" />
                <TextBlock Grid.Column="3" Text="Issues" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PbTextFaintBrush}" />
                <TextBlock Grid.Column="4" Text="Unread" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PbTextFaintBrush}" />
                <TextBlock Grid.Column="5" Text="Publisher" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PbTextFaintBrush}" />
            </Grid>
            <Panel>
                <ListBox x:Name="DetailsModeIssueBox" Classes="virtualRows" IsVisible="{Binding IsIssueGranularity}"
                         ItemsSource="{Binding IssueList.FlatRows}"
                         Padding="0,0,16,40" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.DataTemplates>
                        <DataTemplate DataType="models:IssueListRow">
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource DetailsItemTemplate}" />
                        </DataTemplate>
                    </ListBox.DataTemplates>
                </ListBox>
                <ListBox x:Name="DetailsModeSeriesBox" Classes="virtualRows" IsVisible="{Binding IsSeriesGranularity}"
                         ItemsSource="{Binding FlatCovers}"
                         Padding="0,0,16,40" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.DataTemplates>
                        <DataTemplate DataType="models:SeriesCardSample">
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SeriesDetailsItemTemplate}" />
                        </DataTemplate>
                    </ListBox.DataTemplates>
                </ListBox>
            </Panel>
        </DockPanel>

        <!-- ============ Tiles ============ -->
        <ScrollViewer x:Name="TilesScrollViewer" Grid.Row="1" IsVisible="{Binding IsTilesView}">
            <Grid>
                <Panel IsVisible="{Binding IsIssueGranularity}">
                    <ItemsControl IsVisible="{Binding !IssueList.IsGrouped}" ItemsSource="{Binding IssueList.Rows}"
                                  ItemTemplate="{StaticResource TilesItemTemplate}" Margin="24,18,24,40">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><controls:VirtualizingWrapPanel ItemWidth="{Binding TilesCardWidth}" ItemHeight="{Binding TilesCardHeight}" ItemSpacing="14" LineSpacing="10" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <ItemsControl IsVisible="{Binding IssueList.IsGrouped}" ItemsSource="{Binding IssueList.Groups}" Margin="24,18,24,40">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:IssueListRowGroup">
                                <StackPanel Margin="0,0,0,18">
                                    <DockPanel Margin="0,0,0,10"><TextBlock DockPanel.Dock="Left" Text="{Binding Header}" Classes="pbTextHeading" VerticalAlignment="Center" /><TextBlock DockPanel.Dock="Left" Text="{Binding Items.Count}" Classes="pbTextCaption" Margin="8,0,0,0" VerticalAlignment="Center" /><Border Height="1" VerticalAlignment="Center" Margin="14,0,0,0" Background="{DynamicResource PbBorderBrush}" /></DockPanel>
                                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource TilesItemTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><controls:VirtualizingWrapPanel ItemWidth="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).TilesCardWidth}" ItemHeight="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).TilesCardHeight}" ItemSpacing="14" LineSpacing="10" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Panel>
                <Panel IsVisible="{Binding IsSeriesGranularity}">
                    <ItemsControl IsVisible="{Binding !IsGrouped}" ItemsSource="{Binding Covers}"
                                  ItemTemplate="{StaticResource SeriesTilesItemTemplate}" Margin="24,18,24,40">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><controls:VirtualizingWrapPanel ItemWidth="{Binding TilesCardWidth}" ItemHeight="{Binding TilesCardHeight}" ItemSpacing="14" LineSpacing="10" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <ItemsControl IsVisible="{Binding IsGrouped}" ItemsSource="{Binding Groups}" Margin="24,18,24,40">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:SeriesCardGroup">
                                <StackPanel Margin="0,0,0,18">
                                    <DockPanel Margin="0,0,0,10"><TextBlock DockPanel.Dock="Left" Text="{Binding Header}" Classes="pbTextHeading" VerticalAlignment="Center" /><TextBlock DockPanel.Dock="Left" Text="{Binding Items.Count}" Classes="pbTextCaption" Margin="8,0,0,0" VerticalAlignment="Center" /><Border Height="1" VerticalAlignment="Center" Margin="14,0,0,0" Background="{DynamicResource PbBorderBrush}" /></DockPanel>
                                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource SeriesTilesItemTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><controls:VirtualizingWrapPanel ItemWidth="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).TilesCardWidth}" ItemHeight="{Binding $parent[UserControl].((vm:LibraryScreenViewModel)DataContext).TilesCardHeight}" ItemSpacing="14" LineSpacing="10" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Panel>
            </Grid>
        </ScrollViewer>

        <!-- ============ Mixed-membership Collection grid (Step 9) - only shown for a collection
             with at least one Issue/Book member; a series-only collection keeps using whichever
             normal view-mode grid above is active (full sort/group support, no need to duplicate
             it here). ============ -->
        <ScrollViewer x:Name="CollectionGridScrollViewer" Grid.Row="1" IsVisible="{Binding IsCollectionView}">
            <ItemsControl ItemsSource="{Binding CollectionTiles}" ItemTemplate="{StaticResource CollectionTileTemplate}" Margin="24,22,24,40">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><controls:VirtualizingWrapPanel ItemWidth="{Binding PosterCardWidth}" ItemHeight="{Binding PosterCardHeight}" ItemSpacing="20" LineSpacing="20" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <!-- ============ A-Z jump indexer ============ -->
        <!-- Approximate scroll-to-letter (docs/superpowers/specs/2026-08-09-library-toolbar-design.md
             Phase B) - no virtualized ListBox backs this grid, so there's no real ScrollIntoView;
             LibraryScreen.axaml.cs estimates a row-based offset instead. Only meaningful against an
             alphabetically-sorted, ungrouped flat list (Phase C's ShowAlphabetIndex). -->
        <Border Grid.Row="1" IsVisible="{Binding ShowAlphabetIndex}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                Background="{DynamicResource PbChromeBrush}" BorderBrush="{DynamicResource PbBorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="2,6">
            <ItemsControl ItemsSource="{Binding AlphabetIndexLetters}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Vertical" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Button Content="{Binding}" Click="OnAlphabetIndexLetterClick" Tag="{Binding}"
                                Background="Transparent" BorderThickness="0" Padding="4,1" FontSize="9.5"
                                Foreground="{DynamicResource PbTextFaintBrush}" Cursor="Hand"
                                HorizontalContentAlignment="Center" HorizontalAlignment="Stretch" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Empty state (4b §9) - message + action chosen by VM computed properties: a zero-result
             search, a filter with no matches, or an entirely empty library. -->
        <StackPanel Grid.Row="1" Spacing="12" IsVisible="{Binding ShowEmptyState}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320">
            <fi:SymbolIcon Symbol="Layer" FontSize="34" HorizontalAlignment="Center" Foreground="{DynamicResource PbTextFaintBrush}" />
            <TextBlock Classes="pbTextBody" Text="{Binding EmptyStateMessage}" TextWrapping="Wrap"
                       TextAlignment="Center" Foreground="{DynamicResource PbTextMutedBrush}" />
            <Button Classes="secondary" HorizontalAlignment="Center"
                    Content="{Binding EmptyStateActionLabel}" Command="{Binding EmptyStateActionCommand}"
                    AutomationProperties.AutomationId="LibraryEmptyStateAction" />
        </StackPanel>

        <!-- ============ Add-issue overlay (4b §6) - centered FloatingPanel over the grid, state on
             LibraryScreenViewModel (no MainViewModel extraction). Escape / backdrop click close. ============ -->
        <Border Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsAddIssueOpen}" Background="#B0000000"
                PointerPressed="OnAddIssueBackdropPressed" />
        <Border Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsAddIssueOpen}" Classes="floatingPanel"
                Width="380" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="12">
                <TextBlock Text="Add issue to library" Classes="pbTextHeading" />
                <AutoCompleteBox PlaceholderText="Series name" Text="{Binding NewIssueSeriesName}"
                                 ItemsSource="{Binding ExistingSeriesNames}" FontSize="13" />
                <TextBox PlaceholderText="Number" Text="{Binding NewIssueNumber}" FontSize="13" />

                <TextBlock Text="Content type" Classes="pbTextCaption" />
                <StackPanel Spacing="1">
                    <Button Classes="modeOption" Classes.active="{Binding NewIssueContentType, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:ContentType.Comic}}"
                            Content="Comic" Command="{Binding SetNewIssueContentTypeCommand}" CommandParameter="{x:Static entities:ContentType.Comic}" />
                    <Button Classes="modeOption" Classes.active="{Binding NewIssueContentType, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:ContentType.Manga}}"
                            Content="Manga" Command="{Binding SetNewIssueContentTypeCommand}" CommandParameter="{x:Static entities:ContentType.Manga}" />
                    <Button Classes="modeOption" Classes.active="{Binding NewIssueContentType, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:ContentType.Manhua}}"
                            Content="Manhua" Command="{Binding SetNewIssueContentTypeCommand}" CommandParameter="{x:Static entities:ContentType.Manhua}" />
                    <Button Classes="modeOption" Classes.active="{Binding NewIssueContentType, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:ContentType.Manhwa}}"
                            Content="Manhwa" Command="{Binding SetNewIssueContentTypeCommand}" CommandParameter="{x:Static entities:ContentType.Manhwa}" />
                </StackPanel>

                <StackPanel Spacing="1" IsVisible="{Binding ShowAddReadingModePicker}">
                    <TextBlock Text="Reading direction" Classes="pbTextCaption" />
                    <Button Classes="modeOption" Classes.active="{Binding NewIssueReadingMode, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:ReadingMode.LeftToRight}}"
                            Content="Left to Right" Command="{Binding SetNewIssueReadingModeCommand}" CommandParameter="{x:Static entities:ReadingMode.LeftToRight}" />
                    <Button Classes="modeOption" Classes.active="{Binding NewIssueReadingMode, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:ReadingMode.RightToLeft}}"
                            Content="Right to Left" Command="{Binding SetNewIssueReadingModeCommand}" CommandParameter="{x:Static entities:ReadingMode.RightToLeft}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Classes="ghost" Content="Cancel" Command="{Binding CloseAddIssueCommand}"
                            AutomationProperties.AutomationId="LibraryAddIssueCancel" />
                    <Button Classes="primary" Content="Add" Command="{Binding CreatePlaceholderIssueCommand}"
                            AutomationProperties.AutomationId="LibraryAddIssueConfirm" />
                </StackPanel>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
