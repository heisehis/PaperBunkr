<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ClusterLibraryManager.Settings"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="620"
             x:Class="ClusterLibraryManager.Settings.SettingsRootView"
             x:DataType="vm:SettingsRootViewModel">

    <!-- Hardcoded colors, not DynamicResource - this plugin's compiled Control is loaded via its own
         AssemblyLoadContext (docs/superpowers/specs/2026-09-11-plugin-api-v4-native-tier-design.md),
         and host-theme DynamicResource lookups (PbChromeBrush/PbBorderBrush) never resolved for it in
         practice even after using the correct key name - found on-screen, not in a test. Matching
         Paperbunkr's own dark theme values (App.axaml: PbChromeColor/PbBorderColor) directly sidesteps
         whatever cross-assembly resource-resolution gap causes that, rather than depending on it. -->
    <Border Background="#131519" BorderBrush="#2A2E37"
            BorderThickness="1" CornerRadius="8" Padding="16" Width="640" Height="620">
        <TabControl>
            <TabItem Header="General">
                <vm:SettingsView DataContext="{Binding General}" />
            </TabItem>
            <TabItem Header="Profiles">
                <vm:ProfileManagerView DataContext="{Binding Profiles}" />
            </TabItem>
        </TabControl>
    </Border>
</UserControl>
