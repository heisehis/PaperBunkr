<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paperbunkr.Plugins\Paperbunkr.Plugins.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real end-to-end fixture plugin (docs/superpowers/specs/2026-08-24-plugin-api-v2-design.md
         §7) - the "one real test plugin" the Beta bar asks for. Copied to output so
         DuplicateFinderPluginTests can point PluginEngine.Discover at an absolute, stable path. -->
    <None Include="SamplePlugins\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
