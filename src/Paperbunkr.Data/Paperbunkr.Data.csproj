<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
    <!-- Direct use for cover-image hashing and processing. Version 4 requires a Six Labors license
         key at build time; keep that key outside the repository and provide it through the build
         environment (docs/superpowers/specs/2026-09-24-comicvine-scraper-fidelity-design.md §2.1). -->
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paperbunkr.Engine\Paperbunkr.Engine.csproj" />
    <ProjectReference Include="..\Paperbunkr.Sharing\Paperbunkr.Sharing.csproj" />
  </ItemGroup>

  <!--
    Plugin API v3 §7 (docs/superpowers/specs/2026-08-28-plugin-api-v3-data-manager-design.md): the
    query builder and metadata resolvers are internal so a plugin .csx script referencing this
    assembly can't reach the app's rule/graph engine outside the curated IPluginEnvironment surface.
    Granted to the app (its IMetadataGraph/IRulesEngine adapters) and the first-party test
    assemblies - never to Paperbunkr.Plugins.
    (Deviation from the spec's literal "App + Data.Tests only": Paperbunkr.App.Tests also calls
    ContinuityResolver directly - ContinuityPageViewModelTests / DetailTabsViewModelTests - so it
    needs the same test-assembly access as Data.Tests.)
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Paperbunkr.App" />
    <InternalsVisibleTo Include="Paperbunkr.Data.Tests" />
    <InternalsVisibleTo Include="Paperbunkr.App.Tests" />
  </ItemGroup>

</Project>
