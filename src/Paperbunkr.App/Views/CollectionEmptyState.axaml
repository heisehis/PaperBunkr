<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:controls="using:Paperbunkr.App.Controls"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:views="using:Paperbunkr.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
             x:Class="Paperbunkr.App.Views.CollectionEmptyState"
             x:DataType="vm:LibraryScreenViewModel">

    <!-- Shown when the active collection has no members at all (docs/superpowers/specs/2026-11-06-collection-surfaces-design.md): a card that says how to
         fill it. A filter that hides everything keeps the Library's generic empty message instead. DataContext is the Library view model. -->
    <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360"
                IsVisible="{Binding ShowCollectionEmptyState}" AutomationProperties.AutomationId="CollectionEmptyState">
        <Panel HorizontalAlignment="Center">
            <controls:CollectionGlyphView Value="{Binding ActiveCollectionBanner.IconGlyph}" IconSize="{StaticResource PbIconSizeXl}"
                                          IsVisible="{Binding ActiveCollectionBanner.HasGlyph}"
                                          Accent="{Binding ActiveCollectionBanner.AccentColor, Converter={x:Static views:AccentColorToBrushConverter.Instance}}" />
            <fi:SymbolIcon Symbol="Layer" FontSize="{StaticResource PbIconSizeXl}"
                           IsVisible="{Binding !ActiveCollectionBanner.HasGlyph}"
                           Foreground="{Binding ActiveCollectionBanner.AccentColor, Converter={x:Static views:AccentColorToBrushConverter.Instance}}" />
        </Panel>
        <TextBlock Classes="pbTextTitle" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                   Text="{Binding ActiveCollectionBanner.Name, StringFormat='Nothing in {0} yet'}" />
        <TextBlock Classes="pbTextBody" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource PbTextMutedBrush}"
                   Text="Right-click a series or issue in the Library and choose Add to Collection, or give this collection a rule." />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Button Classes="primary" Content="Edit collection…" Command="{Binding EditActiveCollectionCommand}"
                    AutomationProperties.AutomationId="CollectionEmptyEdit" />
            <Button Classes="ghost" Content="Go to All Series" Command="{Binding SelectAllSeriesCommand}"
                    AutomationProperties.AutomationId="CollectionEmptyAllSeries" />
        </StackPanel>
    </StackPanel>
</UserControl>
