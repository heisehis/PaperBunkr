<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ClusterLibraryManager.Settings"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="620"
             x:Class="ClusterLibraryManager.Settings.SettingsRootView"
             x:DataType="vm:SettingsRootViewModel">

    <Border Background="{DynamicResource PbSurfaceBrush}" CornerRadius="8" Padding="16" Width="640" Height="620">
        <TabControl>
            <TabItem Header="General">
                <vm:SettingsView DataContext="{Binding General}" />
            </TabItem>
            <TabItem Header="Profiles">
                <vm:ProfileManagerView DataContext="{Binding Profiles}" />
            </TabItem>
        </TabControl>
    </Border>
</UserControl>
