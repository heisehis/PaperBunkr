<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:controls="using:Paperbunkr.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Paperbunkr.App.Views.WantedScreen"
             x:Name="Root"
             x:DataType="vm:WantedScreenViewModel">

    <UserControl.Styles>
        <!-- A virtualizing list that owns its scroller: rows are only realized while visible, so thousands of wants stay cheap.
             (An ItemsControl inside a plain ScrollViewer is measured with infinite height and never virtualizes.) -->
        <Style Selector="ItemsControl.vlist">
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter Margin="24,8,24,32" ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter>
        </Style>
    </UserControl.Styles>

    <!-- The Wanted screen (docs/superpowers/specs/2026-09-19-comic-acquisition-daemon-design.md 7, layout A): stage tabs in a top bar,
         one list per tab. Shared chrome only - Button.tab/Border.card/pbChip from Styles, Pb* tokens, no hardcoded colors. -->
    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Top bar: title, stage tabs, Search now -->
        <Border Grid.Row="0" Background="{DynamicResource PbChromeBrush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,0,0,1" Padding="24,10,24,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Classes="pbTextHeading" Text="Wanted" VerticalAlignment="Center" Margin="0,0,24,10" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                    <Button Classes="tab" Classes.active="{Binding IsWantedTab}" Command="{Binding GoWantedCommand}"
                            AutomationProperties.AutomationId="WantedTabWanted">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Wanted" VerticalAlignment="Center" />
                            <TextBlock Classes="tabCount" Text="{Binding WantedTabCount}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tab" Classes.active="{Binding IsUpcomingTab}" Command="{Binding GoUpcomingCommand}"
                            AutomationProperties.AutomationId="WantedTabUpcoming">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Upcoming" VerticalAlignment="Center" />
                            <TextBlock Classes="tabCount" Text="{Binding UpcomingRows.Count}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tab" Classes.active="{Binding IsCandidatesTab}" Command="{Binding GoCandidatesCommand}"
                            AutomationProperties.AutomationId="WantedTabCandidates">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Candidates" VerticalAlignment="Center" />
                            <TextBlock Classes="tabCount" Text="{Binding CandidateCount}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tab" Classes.active="{Binding IsSeriesTab}" Command="{Binding GoSeriesCommand}"
                            AutomationProperties.AutomationId="WantedTabSeries">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Series" VerticalAlignment="Center" />
                            <TextBlock Classes="tabCount" Text="{Binding SeriesRows.Count}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tab" Classes.active="{Binding IsReleasesTab}" Command="{Binding GoReleasesCommand}"
                            AutomationProperties.AutomationId="WantedTabReleases">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Releases" VerticalAlignment="Center" />
                            <TextBlock Classes="tabCount" Text="{Binding ReleaseCount}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button Grid.Column="2" Classes="headerAction primary" Command="{Binding SearchNowCommand}" VerticalAlignment="Center" Margin="0,0,0,10"
                        AutomationProperties.AutomationId="WantedSearchNowButton">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <fi:SymbolIcon Symbol="Search" FontSize="{StaticResource PbIconSizeXs}" />
                        <TextBlock Text="Search now" IsVisible="{Binding !IsSearching}" />
                        <TextBlock Text="Searching…" IsVisible="{Binding IsSearching}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Status line (live region) -->
        <Border Grid.Row="1" Padding="24,10,24,0" IsVisible="{Binding HasStatus}">
            <StackPanel>
                <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasErrorStatus}" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource PbDangerBrush}" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasInfoStatus}" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource PbSuccessBrush}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>

        <!-- One scroll region per tab (single vertical scroll per view) -->
        <Panel Grid.Row="2">

            <!-- WANTED -->
            <Grid IsVisible="{Binding IsWantedTab}" RowDefinitions="Auto,Auto,*">
                    <!-- Grabbed issues: on their way (progress) or failed (retry) -->
                    <StackPanel Grid.Row="0" IsVisible="{Binding !HasNoDownloads}" Spacing="8" Margin="24,16,24,4" MaxWidth="960" HorizontalAlignment="Left">
                        <TextBlock Classes="settingsGroupCaption" Text="DOWNLOADS" />
                        <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding DownloadRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DownloadRowViewModel">
                                    <Border Classes="card" Margin="0,0,0,8" Padding="14,10">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Border Grid.Column="0" Width="40" Height="58" CornerRadius="{StaticResource PbRadiusSm}" ClipToBounds="True" Margin="0,0,12,0" VerticalAlignment="Center"
                                                 Background="{DynamicResource PbSurface2Brush}">
                                                <Image Source="{Binding Cover.Image}" Stretch="UniformToFill" />
                                            </Border>
                                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                                                <Border Classes="pbChip" Padding="8,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource PbAccentBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Button Classes="headerAction ghost" Content="Retry" IsVisible="{Binding IsFailed}"
                                                        AutomationProperties.Name="{Binding Title, StringFormat='Try again for {0}'}"
                                                        Command="{Binding #Root.((vm:WantedScreenViewModel)DataContext).RetryDownloadCommand}" CommandParameter="{Binding}" />
                                                <Button Classes="headerAction ghost" Content="Cancel" IsVisible="{Binding ShowProgress}"
                                                        AutomationProperties.Name="{Binding Title, StringFormat='Cancel downloading {0}'}"
                                                        Command="{Binding #Root.((vm:WantedScreenViewModel)DataContext).CancelDownloadCommand}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                            <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,8,0,0" IsVisible="{Binding ShowProgress}">
                                                <ProgressBar Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="6" VerticalAlignment="Center"
                                                             AutomationProperties.Name="Download progress" />
                                                <TextBlock Grid.Column="1" Text="{Binding ProgressText}" FontSize="11.5" Margin="10,0,0,0" Foreground="{DynamicResource PbTextMutedBrush}" />
                                            </Grid>
                                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Detail}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0"
                                                       Foreground="{DynamicResource PbTextFaintBrush}"
                                                       IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                                        <!-- Imported issues still missing their ComicVine details: durable state, retried by the sweep, bulk actions here -->
                    <StackPanel Grid.Row="1" IsVisible="{Binding HasScrapeReview}" Spacing="8" Margin="24,8,24,4" MaxWidth="960" HorizontalAlignment="Left">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Grid.Column="0" Classes="settingsGroupCaption" Text="{Binding ScrapeReviewHeading}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="headerAction ghost" Content="Retry all" Command="{Binding RetryAllScrapesCommand}"
                                    AutomationProperties.Name="Try again for every issue missing details" />
                            <Button Grid.Column="2" Classes="headerAction ghost" Content="Dismiss all" Command="{Binding DismissAllScrapesCommand}" Margin="6,0,0,0"
                                    AutomationProperties.Name="Stop trying for every issue missing details" />
                        </Grid>
                        <ScrollViewer MaxHeight="240" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ScrapeReviewRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ScrapeReviewRowViewModel">
                                    <Border Classes="card" Margin="0,0,0,8" Padding="14,10">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Grid.Column="0" Width="40" Height="58" CornerRadius="{StaticResource PbRadiusSm}" ClipToBounds="True" Margin="0,0,12,0" VerticalAlignment="Center"
                                                    Background="{DynamicResource PbSurface2Brush}">
                                                <Image Source="{Binding Cover.Image}" Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PbTextBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Reason}" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource PbTextMutedBrush}" />
                                                <TextBlock Text="{Binding Hint}" FontSize="11" Foreground="{DynamicResource PbTextFaintBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Button Classes="headerAction ghost" Content="Retry"
                                                        AutomationProperties.Name="{Binding Title, StringFormat='Try again to add details to {0}'}"
                                                        Command="{Binding #Root.((vm:WantedScreenViewModel)DataContext).RetryScrapeCommand}" CommandParameter="{Binding}" />
                                                <Button Classes="headerAction ghost" Content="Dismiss"
                                                        AutomationProperties.Name="{Binding Title, StringFormat='Stop trying to add details to {0}'}"
                                                        Command="{Binding #Root.((vm:WantedScreenViewModel)DataContext).DismissScrapeCommand}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <ItemsControl Grid.Row="2" Classes="vlist" ItemsSource="{Binding WantedRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WantedRowViewModel">
                                <Border Classes="card" Margin="0,0,0,8" Padding="14,10" MaxWidth="960" HorizontalAlignment="Left">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Grid.Column="0" Width="40" Height="58" CornerRadius="{StaticResource PbRadiusSm}" ClipToBounds="True" Margin="0,0,12,0" VerticalAlignment="Center"
                                             Background="{DynamicResource PbSurface2Brush}">
                                            <Image Source="{Binding Cover.Image}" Stretch="UniformToFill" />
                                        </Border>
                                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto,Auto,Auto">
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PbTextBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" TextTrimming="CharacterEllipsis"
                                                       IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <Border Classes="pbChip" Padding="8,2" IsVisible="{Binding IsMetron}">
                                                <TextBlock Text="Metron" FontSize="11" Foreground="{DynamicResource PbTextMutedBrush}" />
                                            </Border>
                                            <Border Classes="pbChip" Padding="8,2">
                                                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource PbAccentBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding CandidateText}" IsVisible="{Binding HasCandidates}" Margin="12,0,0,0" VerticalAlignment="Center"
                                                   FontSize="11.5" Foreground="{DynamicResource PbTextMutedBrush}" />
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <Button Classes="headerAction ghost" Content="I have this"
                                                    AutomationProperties.Name="{Binding Title, StringFormat='I already have {0}'}"
                                                    Command="{Binding #Root.((vm:WantedScreenViewModel)DataContext).IgnoreCommand}" CommandParameter="{Binding}" />
                                            <Button Classes="headerAction ghost" Content="Remove"
                                                    AutomationProperties.Name="{Binding Title, StringFormat='Stop wanting {0}'}"
                                                    Command="{Binding #Root.((vm:WantedScreenViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                        </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty state: icon + headline + description + action -->
                    <StackPanel Grid.Row="2" IsVisible="{Binding HasNoWanted}" Spacing="8" HorizontalAlignment="Center" Margin="0,56,0,0" MaxWidth="440">
                        <fi:SymbolIcon Symbol="Search" FontSize="{StaticResource PbIconSizeXl}" Foreground="{DynamicResource PbTextFaintBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Nothing wanted right now" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PbTextBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Request missing issues from a series' page or a reading list, or track a series on the Series tab."
                                   FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                        <Button Classes="headerAction primary" Content="Track a series" Command="{Binding GoSeriesCommand}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        <TextBlock Text="Automatic searching is off. Turn it on in Acquisition settings." IsVisible="{Binding !IsEnabled}"
                                   FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" TextAlignment="Center" Margin="0,12,0,0" />
                        <Button Classes="headerAction ghost" Content="Open Acquisition settings" IsVisible="{Binding !IsEnabled}"
                                Command="{Binding OpenAcquisitionSettingsCommand}" HorizontalAlignment="Center" />
                    </StackPanel>
            </Grid>

            <!-- UPCOMING -->
            <Grid IsVisible="{Binding IsUpcomingTab}">
                    <ItemsControl Classes="vlist" ItemsSource="{Binding UpcomingRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WantedRowViewModel">
                                <Border Classes="card" Margin="0,0,0,8" Padding="14,10" MaxWidth="960" HorizontalAlignment="Left">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Grid.Column="0" Width="40" Height="58" CornerRadius="{StaticResource PbRadiusSm}" ClipToBounds="True" Margin="0,0,12,0" VerticalAlignment="Center"
                                             Background="{DynamicResource PbSurface2Brush}">
                                            <Image Source="{Binding Cover.Image}" Stretch="UniformToFill" />
                                        </Border>
                                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto,Auto">
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PbTextBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <Border Classes="pbChip" Padding="8,2" IsVisible="{Binding IsMetron}">
                                                <TextBlock Text="Metron" FontSize="11" Foreground="{DynamicResource PbTextMutedBrush}" />
                                            </Border>
                                            <Border Classes="pbChip" Padding="8,2">
                                                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource PbAccentBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <Button Grid.Column="2" Classes="headerAction ghost" Content="Remove" Margin="12,0,0,0" VerticalAlignment="Center"
                                                AutomationProperties.Name="{Binding Title, StringFormat='Stop wanting {0}'}"
                                                Command="{Binding #Root.((vm:WantedScreenViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}" />
                                    </Grid>
                                        </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel IsVisible="{Binding HasNoUpcoming}" Spacing="8" HorizontalAlignment="Center" Margin="0,56,0,0" MaxWidth="440">
                        <fi:SymbolIcon Symbol="Clock" FontSize="{StaticResource PbIconSizeXl}" Foreground="{DynamicResource PbTextFaintBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="No upcoming releases" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PbTextBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Follow a series on the Series tab and its future issues appear here until their release date, then move to Wanted automatically."
                                   FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>
            </Grid>

            <!-- CANDIDATES -->
            <Grid IsVisible="{Binding IsCandidatesTab}" RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Margin="24,16,24,0" MaxWidth="960" HorizontalAlignment="Left" IsVisible="{Binding !HasNoCandidates}" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" TextWrapping="Wrap"
                               Text="Best match first. Grab sends a release to qBittorrent (set it up in Acquisition settings); Copy link works with any download client. Reject blocks a release for good." />
                    <ItemsControl Grid.Row="1" Classes="vlist" ItemsSource="{Binding CandidateGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CandidateGroupViewModel">
                                <Border Classes="card" Margin="0,0,0,10" MaxWidth="960" HorizontalAlignment="Left">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PbTextBrush}" />
                                        <ItemsControl ItemsSource="{Binding Candidates}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:CandidateRowViewModel">
                                                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,6">
                                                        <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource PbTextBrush}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource PbTextFaintBrush}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Classes="pbChip" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center" IsVisible="{Binding IsPack}">
                                                            <TextBlock Text="Pack" FontSize="11" Foreground="{DynamicResource PbTextMutedBrush}" />
                                                        </Border>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="10,0,0,0" VerticalAlignment="Center">
                                                            <Button Classes="headerAction primary" Content="Grab"
                                                                    IsVisible="{Binding #Root.((vm:WantedScreenViewModel)DataContext).HasDownloadClient}"
                                                                    AutomationProperties.Name="{Binding Title, StringFormat='Send {0} to qBittorrent'}"
                                                                    Command="{Binding #Root.((vm:WantedScreenViewModel)DataContext).GrabCommand}" CommandParameter="{Binding}" />
                                                            <Button Classes="headerAction ghost" Content="Copy link"
                                                                    AutomationProperties.Name="{Binding Title, StringFormat='Copy download link for {0}'}"
                                                                    Command="{Binding #Root.((vm:WantedScreenViewModel)DataContext).CopyLinkCommand}" CommandParameter="{Binding}" />
                                                            <Button Classes="headerAction ghost" Content="Reject"
                                                                    AutomationProperties.Name="{Binding Title, StringFormat='Never offer {0} again'}"
                                                                    Command="{Binding #Root.((vm:WantedScreenViewModel)DataContext).RejectCandidateCommand}" CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Grid.Row="1" IsVisible="{Binding HasNoCandidates}" Spacing="8" HorizontalAlignment="Center" Margin="0,56,0,0" MaxWidth="440">
                        <fi:SymbolIcon Symbol="Link" FontSize="{StaticResource PbIconSizeXl}" Foreground="{DynamicResource PbTextFaintBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="No candidates yet" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PbTextBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Releases Prowlarr finds for your wanted issues show up here. Press Search now, or wait for the next automatic check."
                                   FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>
            </Grid>

            <!-- SERIES -->
            <ScrollViewer IsVisible="{Binding IsSeriesTab}">
                <StackPanel Margin="24,16,24,32" Spacing="12" MaxWidth="960" HorizontalAlignment="Left">
                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Track a series" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PbTextBrush}" />
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <controls:SuggestBox Grid.Column="0" IsStrict="True" Width="120" Text="{Binding SeriesProviderText}" Suggestions="{x:Static vm:WantedScreenViewModel.ProviderNames}"
                                                     AutomationProperties.Name="Search source" AutomationProperties.AutomationId="WantedSeriesProviderSelect" />
                                <TextBox Grid.Column="1" Text="{Binding SeriesSearchText}" Watermark="{Binding SeriesSearchWatermark}"
                                         AutomationProperties.Name="Search for a series" AutomationProperties.AutomationId="WantedSeriesSearchBox" />
                                <Button Grid.Column="2" Classes="headerAction primary" Content="Search" Command="{Binding SearchSeriesCommand}" />
                            </Grid>
                            <TextBlock IsVisible="{Binding !HasSeriesProviderCredentials}" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" TextWrapping="Wrap"
                                       Text="This source needs its login saved under Preferences → Connections." />

                            <ItemsControl ItemsSource="{Binding SearchResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:VolumeResultViewModel">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                            <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" Foreground="{DynamicResource PbTextBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource PbTextFaintBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="headerAction ghost" Content="Track" IsVisible="{Binding !IsTracked}" Margin="10,0,0,0"
                                                    AutomationProperties.Name="{Binding Title, StringFormat='Track {0}'}"
                                                    Command="{Binding #Root.((vm:WantedScreenViewModel)DataContext).TrackVolumeCommand}" CommandParameter="{Binding}" />
                                            <TextBlock Grid.Column="1" Text="Tracked" IsVisible="{Binding IsTracked}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                       FontSize="11.5" Foreground="{DynamicResource PbSuccessBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding SeriesRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WatchedSeriesRowViewModel">
                                <Border Classes="card" Margin="0,0,0,8" Padding="14,10">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                        <Border Grid.Column="0" Width="34" Height="50" CornerRadius="{StaticResource PbRadiusSm}" ClipToBounds="True" Margin="0,0,12,0" VerticalAlignment="Center"
                                                Background="{DynamicResource PbSurface2Brush}">
                                            <Image Source="{Binding Cover.Image}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PbTextBrush}" TextTrimming="CharacterEllipsis" />
                                                <Border Classes="pbChip" Padding="7,1" IsVisible="{Binding IsMetron}" VerticalAlignment="Center">
                                                    <TextBlock Text="Metron" FontSize="10.5" Foreground="{DynamicResource PbTextMutedBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}">
                                                <Run Text="{Binding Subtitle}" /><Run Text="  ·  " /><Run Text="{Binding CountsText}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Follow" FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                                            <ToggleSwitch IsChecked="{Binding WatchFutureReleases}" OnContent="{x:Null}" OffContent="{x:Null}"
                                                          AutomationProperties.Name="Follow this series and request its new issues automatically" />
                                        </StackPanel>
                                        <Button Grid.Column="3" Classes="headerAction ghost" Content="Open" IsVisible="{Binding CanOpen}" Margin="12,0,0,0" VerticalAlignment="Center"
                                                AutomationProperties.Name="{Binding Name, StringFormat='Open {0}'}"
                                                Command="{Binding #Root.((vm:WantedScreenViewModel)DataContext).OpenSeriesCommand}" CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel IsVisible="{Binding HasNoSeries}" Spacing="8" HorizontalAlignment="Center" Margin="0,24,0,0" MaxWidth="440">
                        <fi:SymbolIcon Symbol="Folder" FontSize="{StaticResource PbIconSizeXl}" Foreground="{DynamicResource PbTextFaintBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="No series tracked yet" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PbTextBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Search above to track a series. Its missing issues will then show on its page, and following it requests new issues as they're released."
                                   FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <!-- RELEASES: the weekly pull list (docs/superpowers/specs/2026-09-20-weekly-pull-list-design.md) -->
            <Grid IsVisible="{Binding IsReleasesTab}" RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="16" Margin="24,16,24,0" MaxWidth="960" HorizontalAlignment="Left">
                    <controls:SuggestBox Grid.Column="0" IsStrict="True" Width="200" Text="{Binding ReleasePublisherText}" Suggestions="{Binding ReleasePublisherNames}"
                                         AutomationProperties.Name="Publisher" AutomationProperties.AutomationId="WantedReleasesPublisher" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Followed only" FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                        <ToggleSwitch IsChecked="{Binding ReleasesFollowedOnly}" OnContent="{x:Null}" OffContent="{x:Null}"
                                      AutomationProperties.Name="Show releases of followed series only" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Show hidden" FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                        <ToggleSwitch IsChecked="{Binding ReleasesShowHidden}" OnContent="{x:Null}" OffContent="{x:Null}"
                                      AutomationProperties.Name="Also show hidden releases" />
                    </StackPanel>
                </Grid>

                <ItemsControl Grid.Row="1" Classes="vlist" ItemsSource="{Binding ReleaseWeeks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ReleaseWeekViewModel">
                            <StackPanel Spacing="6" Margin="0,8,0,10" MaxWidth="960" HorizontalAlignment="Left">
                                <TextBlock Classes="settingsGroupCaption" Text="{Binding Title}" />
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ReleaseRowViewModel">
                                            <Border Classes="card" Margin="0,0,0,6" Padding="14,8">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <Border Grid.Column="0" Width="34" Height="50" CornerRadius="{StaticResource PbRadiusSm}" ClipToBounds="True" Margin="0,0,12,0" VerticalAlignment="Center"
                                                            Background="{DynamicResource PbSurface2Brush}">
                                                        <Image Source="{Binding Cover.Image}" Stretch="UniformToFill" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource PbTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                            <Border Classes="pbChip" Padding="7,1" IsVisible="{Binding HasStatus}" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding StatusText}" FontSize="10.5" Foreground="{DynamicResource PbAccentBrush}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource PbTextFaintBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <Button Classes="headerAction ghost" Content="Hide" IsVisible="{Binding CanHide}"
                                                                AutomationProperties.Name="{Binding Title, StringFormat='Hide {0} from the release list'}"
                                                                Command="{Binding #Root.((vm:WantedScreenViewModel)DataContext).HideReleaseCommand}" CommandParameter="{Binding}" />
                                                        <Button Classes="headerAction ghost" Content="Restore" IsVisible="{Binding IsHidden}"
                                                                AutomationProperties.Name="{Binding Title, StringFormat='Restore {0} to the release list'}"
                                                                Command="{Binding #Root.((vm:WantedScreenViewModel)DataContext).RestoreReleaseCommand}" CommandParameter="{Binding}" />
                                                        <Button Classes="headerAction ghost" Content="Follow" IsVisible="{Binding CanFollow}"
                                                                AutomationProperties.Name="{Binding Title, StringFormat='Follow the series of {0}'}"
                                                                Command="{Binding #Root.((vm:WantedScreenViewModel)DataContext).FollowReleaseSeriesCommand}" CommandParameter="{Binding}" />
                                                        <Button Classes="headerAction primary" Content="Request" IsVisible="{Binding CanRequest}"
                                                                AutomationProperties.Name="{Binding Title, StringFormat='Request {0}'}"
                                                                Command="{Binding #Root.((vm:WantedScreenViewModel)DataContext).RequestReleaseCommand}" CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Row="1" IsVisible="{Binding HasNoReleases}" Spacing="8" HorizontalAlignment="Center" Margin="0,56,0,0" MaxWidth="440">
                    <fi:SymbolIcon Symbol="Calendar" FontSize="{StaticResource PbIconSizeXl}" Foreground="{DynamicResource PbTextFaintBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="No releases to show" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PbTextBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding ReleasesEmptyText}" FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Panel>
    </Grid>
</UserControl>
