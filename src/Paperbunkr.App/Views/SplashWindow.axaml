<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Paperbunkr.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="340"
        x:Class="Paperbunkr.App.Views.SplashWindow"
        x:DataType="vm:SplashViewModel"
        Title="Paperbunkr"
        Width="480" Height="340"
        CanResize="False"
        SystemDecorations="None"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="None"
        Background="#0A0B0D">

    <!--
        Shown first from App.axaml.cs while the heavy startup work runs on a background thread
        (docs/superpowers/specs/2026-09-09-startup-onboarding-whats-new-design.md, Decision 2).
        Background is the literal brand dark - renders before SkinService has necessarily run.

        Motion follows the codebase's proven "class toggle + TransformOperationsTransition" pattern
        (Styles/Primitives.axaml's Control.entranceReady, HomeScreen's MastheadVisualLayer ken-burns)
        - NOT keyframe Animation on RenderTransform, which has no registered animator in this
        Avalonia build and crashed at window construction. Code-behind (Opened + a ping-pong timer)
        adds/removes the .enter / .breathe classes; the transitions do the tweening. The glow's blur
        is a static RadialGradientBrush; only its Opacity moves.
    -->
    <Window.Styles>
        <Style Selector="Image#LogoImage">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.5" Easing="CubicEaseOut" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.9" Easing="SineEaseInOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Image#LogoImage.enter">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="scale(0.86)" />
        </Style>
        <Style Selector="Image#LogoImage.breathe">
            <Setter Property="RenderTransform" Value="scale(1.04)" />
        </Style>

        <Style Selector="Border#GlowBorder">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:1.3" Easing="SineEaseInOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border#GlowBorder.breathe">
            <Setter Property="Opacity" Value="0.75" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto,Auto,*">
        <Panel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,28">
            <Border x:Name="GlowBorder" Width="190" Height="190" Opacity="0.4">
                <Border.Background>
                    <RadialGradientBrush GradientOrigin="50%,50%" Center="50%,50%" RadiusX="50%" RadiusY="50%">
                        <GradientStop Color="#8CC9803F" Offset="0" />
                        <GradientStop Color="#00C9803F" Offset="0.72" />
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <Image x:Name="LogoImage" Classes="enter" Width="122" Height="122"
                   Source="avares://Paperbunkr.App/Assets/paperbunkr-logo-source.png" />
        </Panel>

        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Spacing="14">
            <ProgressBar Width="240" Height="3" Minimum="0" Maximum="1"
                         Value="{Binding Progress}"
                         Background="#25252B" CornerRadius="2" ShowProgressText="False">
                <ProgressBar.Foreground>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Color="#B06A2E" Offset="0" />
                        <GradientStop Color="#D9A441" Offset="1" />
                    </LinearGradientBrush>
                </ProgressBar.Foreground>
            </ProgressBar>
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#8A8F98"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <TextBlock Grid.Row="3" Text="{Binding VersionText}"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,15,13"
                   FontSize="10.5" Foreground="#565B64" />
    </Grid>
</Window>
