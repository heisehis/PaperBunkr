<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="780"
             x:Class="Paperbunkr.App.Views.BulkIssuePropertiesScreen"
             x:DataType="vm:BulkIssuePropertiesScreenViewModel">

    <!-- Cancel/Save now use the shared Button.ghost/Button.primary primitives (Styles/Primitives.axaml)
         in place of this file's former local "headerAction" styles - see docs/superpowers/specs/
         2026-08-24-design-language-foundation-design.md Component Primitives section. -->
    <UserControl.Styles>
        <Style Selector="Border.groupBox">
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.groupHeader">
            <Setter Property="Background" Value="{DynamicResource PbChromeBrush}" />
            <Setter Property="Padding" Value="14,11" />
        </Style>

        <Style Selector="Button.star">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.star fi|SymbolIcon">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextFaintBrush}" />
        </Style>
        <Style Selector="Button.star.filled fi|SymbolIcon">
            <Setter Property="Foreground" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="IconVariant" Value="Filled" />
        </Style>

        <!-- Enum-field picker (docs/superpowers/specs/2026-08-16-manga-content-type-classification-
             design.md §1) - same shape/class names as LibraryScreen.axaml's toolbarPill/modeOption
             (Avalonia styles don't share across files, so this mirrors rather than references them). -->
        <Style Selector="Button.toolbarPill">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource PbChromeBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.modeOption">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <DataTemplate x:Key="FieldRowTemplate" x:DataType="vm:BulkFieldViewModel">
            <Grid ColumnDefinitions="Auto,160,*" Margin="0,0,0,10" IsVisible="{Binding IsRowVisible}">
                <CheckBox Grid.Column="0" IsChecked="{Binding IsStaged}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12.5" Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />

                <Grid Grid.Column="2" ColumnDefinitions="*,Auto" IsVisible="{Binding IsTextKind}">
                    <TextBox Grid.Column="0" Text="{Binding Value}" IsVisible="{Binding IsPlainTextKind}" />
                    <!-- Free-text-with-autocomplete field, e.g. Format (docs/superpowers/specs/2026-08-27-
                         metadata-model-phase4e-format-signal-suggestions-design.md). -->
                    <AutoCompleteBox Grid.Column="0" Text="{Binding Value}" ItemsSource="{Binding AutocompleteOptions}"
                                     IsVisible="{Binding HasAutocomplete}" />
                    <!-- Templated/token text field editor (docs/ce-feature-inventory.md §A) - inserts the
                         literal placeholder; BulkIssuePropertiesScreenViewModel.Save expands it per issue. -->
                    <Button x:Name="TokenButton" Grid.Column="1" Classes="toolbarPill" Content="{}{ }" Margin="6,0,0,0" ToolTip.Tip="Insert a token">
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <StackPanel Width="140">
                                    <ItemsControl ItemsSource="{Binding TokenOptions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Button Classes="modeOption" Content="{Binding}"
                                                        Command="{Binding #TokenButton.((vm:BulkFieldViewModel)DataContext).InsertTokenCommand}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <CheckBox Grid.Column="2" IsChecked="{Binding BoolValue}" IsVisible="{Binding IsBooleanKind}"
                          Content="Yes" Foreground="{DynamicResource PbTextBrush}" FontSize="13" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" IsVisible="{Binding IsRatingKind}">
                    <Button Classes="star" Classes.filled="{Binding Star1}" Command="{Binding SetStar1Command}"><fi:SymbolIcon Symbol="Star" /></Button>
                    <Button Classes="star" Classes.filled="{Binding Star2}" Command="{Binding SetStar2Command}"><fi:SymbolIcon Symbol="Star" /></Button>
                    <Button Classes="star" Classes.filled="{Binding Star3}" Command="{Binding SetStar3Command}"><fi:SymbolIcon Symbol="Star" /></Button>
                    <Button Classes="star" Classes.filled="{Binding Star4}" Command="{Binding SetStar4Command}"><fi:SymbolIcon Symbol="Star" /></Button>
                    <Button Classes="star" Classes.filled="{Binding Star5}" Command="{Binding SetStar5Command}"><fi:SymbolIcon Symbol="Star" /></Button>
                </StackPanel>

                <!-- Fixed-choice picker (docs/superpowers/specs/2026-08-16-manga-content-type-classification-design.md §1) -
                     this app's established flyout-of-buttons enum-picker idiom (e.g. ReaderScreen.axaml's reading-mode/
                     fit-mode pickers), data-driven off Options instead of hardcoded per-option buttons. -->
                <Button x:Name="EnumPickerButton" Grid.Column="2" Classes="toolbarPill" Content="{Binding Value}" HorizontalAlignment="Left"
                        IsVisible="{Binding IsEnumKind}">
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Width="160">
                                <ItemsControl ItemsSource="{Binding Options}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Button Classes="modeOption" Content="{Binding}"
                                                    Command="{Binding #EnumPickerButton.((vm:BulkFieldViewModel)DataContext).SetValueCommand}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Borderless floating panel over the caller's dimmed backdrop (docs/superpowers/specs/2026-08-23-
         issue-editor-borderless-overlay-design.md) - same treatment as IssuePropertiesScreen.axaml. -->
    <Border Width="900" MaxHeight="780" Classes="floatingPanel">
        <DockPanel LastChildFill="True">

            <Grid DockPanel.Dock="Top" Margin="28,20,28,16" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                    <TextBlock Text="Edit Issues" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PbTextBrush}" />
                    <TextBlock Text="{Binding HeaderLabel}" FontSize="12.5" Foreground="{DynamicResource PbTextFaintBrush}" Margin="0,4,0,0" />
                    <TextBlock Text="Only checked fields are applied - leave a field unchecked to keep every issue's own value."
                               FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
                    <Button Classes="ghost" FontSize="12.5" Command="{Binding CancelCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <fi:SymbolIcon Symbol="DismissCircle" />
                            <TextBlock Text="Cancel" />
                        </StackPanel>
                    </Button>
                    <Button Classes="primary" FontSize="12.5" Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <fi:SymbolIcon Symbol="Save" Foreground="{DynamicResource PbBadgeTextBrush}" />
                            <TextBlock Text="Apply" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,24" />

            <ScrollViewer>
                <StackPanel Margin="28,0,28,40" Spacing="20">

                    <Border Classes="groupBox">
                        <StackPanel>
                            <Border Classes="groupHeader">
                                <TextBlock Text="Main" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                            </Border>
                            <ItemsControl Margin="14" ItemsSource="{Binding MainFields}" ItemTemplate="{StaticResource FieldRowTemplate}" />
                            <!-- Content Type writes through to each selected issue's owning Series, not the Issue
                                 itself - a multi-series selection can silently reclassify more series than were
                                 explicitly selected (docs/superpowers/specs/2026-08-16-manga-content-type-
                                 classification-design.md §1). -->
                            <TextBlock Margin="14,0,14,14" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}"
                                       IsVisible="{Binding HasSeriesAffected}"
                                       Text="{Binding SeriesAffectedCount, StringFormat='{}{0} series will be affected.'}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="groupBox">
                        <StackPanel>
                            <Border Classes="groupHeader">
                                <TextBlock Text="Artists" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                            </Border>
                            <ItemsControl Margin="14" ItemsSource="{Binding ArtistFields}" ItemTemplate="{StaticResource FieldRowTemplate}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="groupBox">
                        <StackPanel>
                            <Border Classes="groupHeader">
                                <TextBlock Text="Plot &amp; Notes" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                            </Border>
                            <ItemsControl Margin="14" ItemsSource="{Binding PlotNotesFields}" ItemTemplate="{StaticResource FieldRowTemplate}" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
