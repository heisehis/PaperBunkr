<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="700"
             x:Class="Paperbunkr.App.Views.ReadingListPropertiesOverlay"
             x:DataType="vm:ReadingListPropertiesScreenViewModel">

    <!-- Cancel/Save/Change-Cover now use the shared Button.ghost/Button.primary primitives
         (Styles/Primitives.axaml) in place of this file's former local "headerAction" styles - see
         docs/superpowers/specs/2026-08-24-design-language-foundation-design.md Component Primitives
         section. -->
    <UserControl.Styles>
        <Style Selector="Border.groupBox">
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.groupHeader">
            <Setter Property="Background" Value="{DynamicResource PbChromeBrush}" />
            <Setter Property="Padding" Value="14,11" />
        </Style>

        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextFaintBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="StackPanel.field">
            <Setter Property="Width" Value="260" />
            <Setter Property="Margin" Value="0,0,16,16" />
        </Style>
    </UserControl.Styles>

    <Border Width="620" MaxHeight="720" Classes="floatingPanel">
        <DockPanel LastChildFill="True">

            <StackPanel DockPanel.Dock="Top" Margin="20,18,20,0">
                <TextBlock Text="{Binding HeaderLabel}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource PbTextBrush}" />
                <Border Height="1" Background="{DynamicResource PbBorderBrush}" Margin="0,14,0,0" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" Margin="20,0,20,18">
                <Button Classes="ghost" FontSize="12.5" Content="Cancel" Command="{Binding CancelCommand}" />
                <Button Classes="primary" FontSize="12.5" Content="Save" Command="{Binding SaveCommand}" />
            </StackPanel>

            <ScrollViewer Padding="20,16,20,16">
                <StackPanel>

                    <WrapPanel>
                        <StackPanel Classes="field">
                            <TextBlock Classes="fieldLabel" Text="NAME" />
                            <TextBox Text="{Binding Name}" />
                        </StackPanel>
                        <StackPanel Classes="field" Width="536">
                            <TextBlock Classes="fieldLabel" Text="DESCRIPTION" />
                            <TextBox Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
                        </StackPanel>
                        <StackPanel Classes="field">
                            <TextBlock Classes="fieldLabel" Text="TYPE" />
                            <ComboBox ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding TypeText}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </WrapPanel>

                    <Border Classes="groupBox" Margin="0,0,0,16">
                        <StackPanel>
                            <Border Classes="groupHeader">
                                <TextBlock Text="Cover" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                            </Border>
                            <Grid ColumnDefinitions="90,*" Margin="14">
                                <Border Grid.Column="0" Width="70" Height="100" CornerRadius="5" ClipToBounds="True"
                                        Background="{DynamicResource PbChromeBrush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1">
                                    <Image Source="{Binding CoverPreview}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Top">
                                    <Button Classes="ghost" FontSize="12.5" Content="Change Cover…" Command="{Binding ChangeCoverCommand}" Margin="0,0,0,12" />
                                    <TextBlock Classes="fieldLabel" Text="COVER IMAGE URL" />
                                    <TextBox Text="{Binding CoverImageUrl}" Watermark="https://…" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="groupBox" Margin="0,0,0,16">
                        <StackPanel>
                            <Border Classes="groupHeader">
                                <TextBlock Text="Arc Info" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                            </Border>
                            <WrapPanel Margin="14,14,0,0">
                                <StackPanel Classes="field"><TextBlock Classes="fieldLabel" Text="SOURCE" /><TextBox Text="{Binding Source}" /></StackPanel>
                                <StackPanel Classes="field"><TextBlock Classes="fieldLabel" Text="ARC ID" /><TextBox Text="{Binding ArcId}" /></StackPanel>
                                <StackPanel Classes="field"><TextBlock Classes="fieldLabel" Text="ARC NAME" /><TextBox Text="{Binding ArcName}" /></StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="groupBox">
                        <StackPanel>
                            <Border Classes="groupHeader">
                                <TextBlock Text="Tags" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                            </Border>
                            <StackPanel Margin="14">
                                <TextBlock Classes="fieldLabel" Text="TAGS" />
                                <TextBox Text="{Binding TagsText}" Margin="0,0,0,12" />

                                <ItemsControl ItemsSource="{Binding TagRows}" IsVisible="{Binding TagRows.Count}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TagEditRowViewModel">
                                            <Grid ColumnDefinitions="140,*,140" Margin="0,0,0,8">
                                                <TextBlock Grid.Column="0" Text="{Binding Value}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                <TextBox Grid.Column="1" Text="{Binding Category}" Watermark="Category" Margin="0,0,8,0" />
                                                <ComboBox Grid.Column="2" ItemsSource="{Binding $parent[UserControl].((vm:ReadingListPropertiesScreenViewModel)DataContext).WeightOptions, Mode=OneTime}" SelectedItem="{Binding Weight}" HorizontalAlignment="Stretch" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
