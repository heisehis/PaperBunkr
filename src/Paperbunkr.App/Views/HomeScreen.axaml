<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:models="using:Paperbunkr.App.Models"
             xmlns:views="using:Paperbunkr.App.Views"
             xmlns:controls="using:Paperbunkr.App.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="900"
             x:Class="Paperbunkr.App.Views.HomeScreen"
             x:Name="Root"
             x:DataType="vm:HomeScreenViewModel">

    <!--
        App launch screen (docs/superpowers/specs/2026-08-28-home-screen-redesign-design.md,
        supersedes the 2026-08-24 pass). Top to bottom: a masthead on a blurred "cover-wall" of the
        user's own covers (MastheadBackdrop, built by CoverWallRenderer), a spotlight hero rendered
        through the shared DetailHero control (SpotlightHeader adapter), then the shelves - Continue
        Reading, Continue Reading - Books, Recently Added, Because You Read, Try This Reading List -
        each a horizontal row of PosterTile cards. All data/pick logic lives in HomeScreenViewModel /
        HomeFeedResolver / RecommendationResolver; this view only renders it.
    -->

    <UserControl.Styles>
        <Style Selector="TextBlock.emptyState">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextFaintBrush}" />
        </Style>
        <Style Selector="Button.viewAllLink">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource PbAccentTextBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="{DynamicResource PbMotionFast}" Easing="{StaticResource PbMotionEase}" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.viewAllLink:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
        </Style>

        <!-- Plain icon+text header links (Refresh) - transparent, no chrome, just a hover color shift. -->
        <Style Selector="Button.headerLink">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="{DynamicResource PbMotionFast}" Easing="{StaticResource PbMotionEase}" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.headerLink:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PbAccentTextBrush}" />
        </Style>
        <Style Selector="Button.headerLink:pointerover fi|SymbolIcon">
            <Setter Property="Foreground" Value="{DynamicResource PbAccentTextBrush}" />
        </Style>

        <Style Selector="TextBox.searchBox">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="{DynamicResource PbMotionFast}" Easing="{StaticResource PbMotionEase}" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBox.searchBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
        </Style>

        <!-- Hero card wrapper: a Button so a click anywhere on the card opens the spotlight issue
             (the DetailHero "Read now" action does the same). No fixed height - DetailHero drives it. -->
        <Style Selector="Button.heroCard">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Button.spotlightCard">
            <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusLg}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Border.spotlightCover">
            <Setter Property="CornerRadius" Value="7,0,0,7" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Width" Value="120" />
            <Setter Property="Height" Value="172" />
        </Style>

        <Style Selector="Button.spotlightDot">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Width" Duration="{DynamicResource PbMotionFast}" Easing="{StaticResource PbMotionEase}" />
                    <BrushTransition Property="Background" Duration="{DynamicResource PbMotionFast}" Easing="{StaticResource PbMotionEase}" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.spotlightDot:pointerover">
            <Setter Property="Background" Value="{DynamicResource PbTextFaintBrush}" />
        </Style>
        <Style Selector="Button.spotlightDot.active">
            <Setter Property="Width" Value="22" />
            <Setter Property="Background" Value="{DynamicResource PbAccentBrush}" />
        </Style>
        <Style Selector="Button.spotlightDot.active:pointerover">
            <Setter Property="Background" Value="{DynamicResource PbAccentBrush}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="0,0,0,48">

            <!-- ============ Masthead on the cover-wall (full-bleed, edge to edge) ============ -->
            <Panel Height="210">
                <Image Source="{Binding MastheadBackdrop}" Stretch="UniformToFill"
                       IsVisible="{Binding MastheadBackdrop, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                <Border IsVisible="{Binding MastheadBackdrop, Converter={x:Static conv:ObjectConverters.IsNull}}">
                    <Border.Background>
                        <RadialGradientBrush GradientOrigin="18%,0%" Center="18%,0%" RadiusX="1.1" RadiusY="0.9">
                            <GradientStop Offset="0" Color="#241812" />
                            <GradientStop Offset="0.5" Color="#0C0B0A" />
                            <GradientStop Offset="1" Color="#060606" />
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,55%" EndPoint="0%,100%">
                            <GradientStop Offset="0" Color="#00000000" />
                            <GradientStop Offset="1" Color="{DynamicResource PbSurface0Color}" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <controls:SplitText Text="PAPERBUNKR" FontSize="15" Foreground="{DynamicResource PbAccentTextBrush}"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="22,18,0,0" />

                <Button Classes="headerLink" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,18,0"
                        Command="{Binding RefreshCommand}" AutomationProperties.AutomationId="HomeRefreshButton"
                        ToolTip.Tip="Refresh">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <fi:SymbolIcon Symbol="ArrowClockwise" FontSize="{StaticResource PbIconSizeSm}" />
                        <TextBlock Text="Refresh library" FontSize="11.5" Foreground="{DynamicResource PbTextMutedBrush}" />
                    </StackPanel>
                </Button>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="620">
                    <controls:SplitText Text="Your Library" FontSize="40" HorizontalAlignment="Center"
                                        Foreground="{DynamicResource PbTextBrush}" />
                    <TextBlock Text="Search for a specific series, or discover something new below."
                               FontSize="12.5" HorizontalAlignment="Center" Foreground="{DynamicResource PbTextMutedBrush}" />
                    <Grid ColumnDefinitions="*,Auto" Width="470">
                        <TextBox Grid.Column="0" Classes="searchBox" Text="{Binding SearchQuery}" Watermark="Search for a comic series..."
                                 FontSize="12.5" AutomationProperties.AutomationId="HomeSearchBox">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button Grid.Column="1" Classes="primary" Content="Search" Margin="8,0,0,0"
                                Command="{Binding SearchCommand}" AutomationProperties.AutomationId="HomeSearchButton" />
                    </Grid>
                </StackPanel>
            </Panel>

            <Border Height="1" Background="{DynamicResource PbBorderBrush}" />

            <StackPanel HorizontalAlignment="Center" MaxWidth="1180" Margin="24,20,24,0" Spacing="28">

                <!-- ============ Spotlight hero ============ -->
                <StackPanel Spacing="12">
                    <StackPanel Spacing="12" IsVisible="{Binding HasSpotlight}">
                        <Button Classes="heroCard" Command="{Binding OpenSpotlightCommand}"
                                AutomationProperties.AutomationId="HomeSpotlightCard">
                            <Border CornerRadius="{DynamicResource PbRadiusLg}" ClipToBounds="True">
                                <views:DetailHero DataContext="{Binding SpotlightHeader}" MutedBackdrop="True" HeroHeight="264" />
                            </Border>
                        </Button>
                        <ItemsControl ItemsSource="{Binding SpotlightItems}" HorizontalAlignment="Center"
                                      AutomationProperties.AutomationId="HomeSpotlightDots">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:SpotlightIssueSample">
                                    <Button Classes="spotlightDot"
                                            Classes.active="{Binding $parent[UserControl].((vm:HomeScreenViewModel)DataContext).CurrentSpotlight, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={Binding}}"
                                            Command="{Binding $parent[UserControl].((vm:HomeScreenViewModel)DataContext).SetSpotlightItemCommand}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <TextBlock AutomationProperties.AutomationId="HomeSpotlightHeader"
                               Text="Your library's all caught up" Classes="emptyState" IsVisible="{Binding !HasSpotlight}" />
                </StackPanel>

                <!-- ============ Continue Reading ============ -->
                <StackPanel Spacing="12">
                    <controls:SplitText Classes="heading" Text="Continue Reading" AutomationProperties.AutomationId="HomeContinueReadingHeader" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" IsVisible="{Binding HasContinueReading}">
                        <ItemsControl ItemsSource="{Binding ContinueReading}" Margin="0,0,0,12" AutomationProperties.AutomationId="HomeContinueReadingList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="16" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:HomeContinueReadingCard">
                                    <views:PosterTile
                                        CoverSource="{Binding Series.CoverIssueId, Converter={x:Static views:CoverImageConverter.Instance}}"
                                        TitleText="{Binding Series.Name}"
                                        BadgeText="{Binding ResumeIssueBadge}"
                                        ShowProgress="True"
                                        ProgressFraction="{Binding ResumeProgressFraction}"
                                        Command="{Binding $parent[UserControl].((vm:HomeScreenViewModel)DataContext).OpenContinueReadingCommand}"
                                        CommandParameter="{Binding ResumeIssueId}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="Nothing in progress yet" Classes="emptyState" IsVisible="{Binding !HasContinueReading}" />
                </StackPanel>

                <!-- ============ Continue Reading — Books ============ -->
                <StackPanel Spacing="12" IsVisible="{Binding HasBooksLibrary}">
                    <controls:SplitText Classes="heading" Text="Continue Reading — Books" AutomationProperties.AutomationId="HomeContinueReadingBooksHeader" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" IsVisible="{Binding HasContinueReadingBooks}">
                        <ItemsControl ItemsSource="{Binding ContinueReadingBooks}" Margin="0,0,0,12" AutomationProperties.AutomationId="HomeContinueReadingBooksList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="16" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:HomeBookCard">
                                    <views:PosterTile
                                        CoverSource="{Binding BookId, Converter={x:Static views:BookCoverImageConverter.Instance}}"
                                        TitleText="{Binding Title}"
                                        MetaText="{Binding Author}"
                                        ShowProgress="{Binding ShowProgress}"
                                        ProgressFraction="{Binding ProgressFraction}"
                                        Command="{Binding $parent[UserControl].((vm:HomeScreenViewModel)DataContext).OpenContinueReadingBookCommand}"
                                        CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="Nothing in progress yet" Classes="emptyState" IsVisible="{Binding !HasContinueReadingBooks}" />
                </StackPanel>

                <!-- ============ Recently Added ============ -->
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <controls:SplitText Grid.Column="0" Classes="heading" Text="Recently Added" AutomationProperties.AutomationId="HomeRecentlyAddedHeader" />
                        <Button Grid.Column="1" Classes="viewAllLink" Content="View Library →"
                                Command="{Binding GoToLibraryCommand}"
                                AutomationProperties.AutomationId="HomeViewLibraryLink" />
                    </Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" IsVisible="{Binding HasRecentlyAdded}">
                        <ItemsControl ItemsSource="{Binding RecentlyAdded}" Margin="0,0,0,12" AutomationProperties.AutomationId="HomeRecentlyAddedList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="16" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:SeriesCardSample">
                                    <views:PosterTile
                                        CoverSource="{Binding CoverIssueId, Converter={x:Static views:CoverImageConverter.Instance}}"
                                        TitleText="{Binding Name}"
                                        BadgeText="{Binding RecentAddBadgeLabel}"
                                        Command="{Binding $parent[UserControl].((vm:HomeScreenViewModel)DataContext).OpenSeriesCommand}"
                                        CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="Nothing added yet" Classes="emptyState" IsVisible="{Binding !HasRecentlyAdded}" />
                </StackPanel>

                <!-- ============ Collections (docs/superpowers/specs/2026-08-27-collections-design.md's
                     own deferred "Home-feed shelf" follow-on) ============ -->
                <StackPanel Spacing="12" IsVisible="{Binding HasCollections}">
                    <Grid ColumnDefinitions="*,Auto">
                        <controls:SplitText Grid.Column="0" Classes="heading" Text="Collections" AutomationProperties.AutomationId="HomeCollectionsHeader" />
                        <Button Grid.Column="1" Classes="viewAllLink" Content="View Library →"
                                Command="{Binding GoToLibraryCommand}"
                                AutomationProperties.AutomationId="HomeViewLibraryFromCollectionsLink" />
                    </Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Collections}" Margin="0,0,0,12" AutomationProperties.AutomationId="HomeCollectionsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="16" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:HomeCollectionCard">
                                    <views:PosterTile
                                        CoverSource="{Binding CoverImage}"
                                        TitleText="{Binding Name}"
                                        BadgeText="{Binding Count, StringFormat='{}{0}'}"
                                        Command="{Binding $parent[UserControl].((vm:HomeScreenViewModel)DataContext).OpenCollectionCommand}"
                                        CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- ============ Because You Read ============ -->
                <ItemsControl ItemsSource="{Binding BecauseYouRead}" IsVisible="{Binding HasBecauseYouRead}"
                              AutomationProperties.AutomationId="HomeBecauseYouReadSection">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:BecauseYouReadRow">
                            <StackPanel Spacing="12" Margin="0,0,0,20">
                                <controls:SplitText Classes="heading" Text="{Binding SeedSeriesName, StringFormat='Because you read {0}'}" />
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Cards}" Margin="0,0,0,12">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="16" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:SeriesCardSample">
                                                <views:PosterTile
                                                    CoverSource="{Binding CoverIssueId, Converter={x:Static views:CoverImageConverter.Instance}}"
                                                    TitleText="{Binding Name}"
                                                    BadgeText="{Binding IssueCountLabel}"
                                                    Command="{Binding $parent[UserControl].((vm:HomeScreenViewModel)DataContext).OpenSeriesCommand}"
                                                    CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No recommendations yet — link related series from a series' Detail screen to see them here."
                           Classes="emptyState" TextWrapping="Wrap" IsVisible="{Binding !HasBecauseYouRead}"
                           AutomationProperties.AutomationId="HomeBecauseYouReadEmptyState" />

                <!-- ============ Try This Reading List ============ -->
                <StackPanel Spacing="12">
                    <controls:SplitText Classes="heading" Text="Try This Reading List" AutomationProperties.AutomationId="HomeReadingListSpotlightHeader" />
                    <Button Classes="spotlightCard" IsVisible="{Binding HasReadingListSpotlight}"
                            Command="{Binding OpenReadingListSpotlightCommand}" AutomationProperties.AutomationId="HomeReadingListSpotlightCard">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" Classes="spotlightCover" Background="{Binding ReadingListSpotlight.CoverBrush}">
                                <Image Source="{Binding ReadingListSpotlight.CoverImage}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="22,0" Spacing="6">
                                <TextBlock Text="{Binding ReadingListSpotlight.Name}" Classes="pbTextHeading" FontSize="24" />
                                <TextBlock Text="{Binding ReadingListSpotlight.Synopsis}" FontSize="12.5"
                                           Foreground="{DynamicResource PbTextMutedBrush}" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding ReadingListSpotlight.Tags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border Classes="pbChip" Margin="0,4,6,0">
                                                <TextBlock Text="{Binding}" FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PbAccentTextBrush}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Start the list →" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"
                                           Foreground="{DynamicResource PbAccentTextBrush}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <TextBlock Text="No reading lists with anything left to read" Classes="emptyState" IsVisible="{Binding !HasReadingListSpotlight}" />
                </StackPanel>

            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
