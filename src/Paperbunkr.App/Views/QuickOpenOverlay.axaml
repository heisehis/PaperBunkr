<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:models="using:Paperbunkr.App.Models"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="480"
             x:Class="Paperbunkr.App.Views.QuickOpenOverlay"
             x:DataType="vm:QuickOpenViewModel">

    <UserControl.Styles>
        <Style Selector="ListBox#QuickOpenResults ListBoxItem">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="ListBox#QuickOpenResults ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PbAccentSoftBrush}" />
        </Style>
        <Style Selector="TextBlock.qoKind">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextFaintBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Border Classes="floatingPanel" Width="560" MaxHeight="520" VerticalAlignment="Top" Margin="0,80,0,0">
        <Grid RowDefinitions="Auto,*,Auto">

            <Border Grid.Row="0" Padding="14,10" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                    <fi:SymbolIcon DockPanel.Dock="Left" Symbol="Search" VerticalAlignment="Center" Margin="2,0,10,0" />
                    <TextBox x:Name="SearchBox" Text="{Binding Query}" PlaceholderText="Jump to a series, book, list, screen…"
                             FontSize="14" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                             KeyDown="OnSearchBoxKeyDown" AutomationProperties.AutomationId="QuickOpenSearchBox" />
                </DockPanel>
            </Border>

            <ListBox Grid.Row="1" ItemsSource="{Binding Results}" SelectedIndex="{Binding SelectedIndex}"
                     Background="Transparent" BorderThickness="0" Padding="6"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Tapped="OnResultTapped" AutomationProperties.AutomationId="QuickOpenResults">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:QuickOpenEntry">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <fi:SymbolIcon Grid.Column="0" Symbol="{Binding Icon}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Primary}" FontSize="13" Foreground="{DynamicResource PbTextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Secondary}" FontSize="11" Foreground="{DynamicResource PbTextFaintBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding Secondary, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Classes="qoKind" Text="{Binding KindLabel}" Margin="12,0,0,0" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="1" Text="No matches" VerticalAlignment="Center" HorizontalAlignment="Center"
                       FontSize="12.5" Foreground="{DynamicResource PbTextFaintBrush}"
                       IsVisible="{Binding HasNoMatches}" />

            <Border Grid.Row="2" Padding="14,8" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,1,0,0">
                <TextBlock Text="↑↓ navigate    ↵ open    esc close" FontSize="11"
                           Foreground="{DynamicResource PbTextFaintBrush}" />
            </Border>
        </Grid>
    </Border>
</UserControl>
