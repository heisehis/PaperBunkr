<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fi="using:FluentIcons.Avalonia"
        xmlns:c="using:Paperbunkr.App.Controls">
    <!--
        Form-control skin coordination for the metadata editors (docs/superpowers/specs/
        2026-09-05-metadata-editor-affordances-design.md §3.4). FluentAvaloniaTheme owns the base
        templates for NumericUpDown / AutoCompleteBox / editable ComboBox; these Styles only pull
        their surface/border/radius onto the Pb* skin tokens so they match the plain TextBoxes they
        sit beside and react to a runtime skin switch. No literal hex, no literal sizes where a
        PbRadius*/PbFontSize* token fits.

        Kept as plain Styles rather than ControlTheme overrides - same rationale as Primitives.axaml:
        these are token nudges on existing templated controls, not re-templates.
    -->

    <!-- NumericUpDown: match the TextBox corner radius. Its own spin buttons are now restyled too
         (docs/superpowers/specs/2026-09-14-metadata-editors-redesign-design.md §4). Three prior
         misses on this exact style, root cause found by fetching FluentAvalonia's real theme
         source (amwx/FluentAvalonia, src/FluentAvalonia/Styling/ControlThemes/BasicControls/
         NumericUpDownStyles.axaml) - App.axaml's FluentAvaloniaTheme REPLACES Avalonia's built-in
         FluentTheme, so base Avalonia's ButtonSpinner.cs (src/Avalonia.Controls) was never the
         control actually rendering here; every earlier attempt was reading the wrong theme's
         source. FluentAvalonia's own template: NumericUpDown hosts a ButtonSpinner, whose own
         template hosts a StackPanel (PART_SpinnerPanel) containing the two RepeatButtons -
         PART_IncreaseButton / PART_DecreaseButton. Type is RepeatButton, not Button (that was
         miss #1); two /template/ levels are required to cross both templated-control boundaries
         (miss #2 only had one). -->
    <Style Selector="NumericUpDown">
        <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusSm}" />
        <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
    </Style>
    <Style Selector="NumericUpDown /template/ ButtonSpinner /template/ RepeatButton#PART_IncreaseButton, NumericUpDown /template/ ButtonSpinner /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource PbTextFaintBrush}" />
    </Style>
    <Style Selector="NumericUpDown /template/ ButtonSpinner /template/ RepeatButton#PART_IncreaseButton:pointerover, NumericUpDown /template/ ButtonSpinner /template/ RepeatButton#PART_DecreaseButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource PbAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PbBadgeTextBrush}" />
    </Style>

    <!-- AutoCompleteBox: the inner TextBox is themed by FluentAvalonia; the drop-down popup is a
         bare ListBox in a Popup - give it the same surface/border as our other flyouts. -->
    <Style Selector="AutoCompleteBox">
        <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusSm}" />
        <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
    </Style>
    <Style Selector="AutoCompleteBox /template/ Popup#PART_Popup Border">
        <Setter Property="Background" Value="{DynamicResource PbSurface3Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusSm}" />
    </Style>

    <!-- Editable ComboBox: used for Format / Publisher / Imprint / Age Rating / Book Age / Language.
         Only the radius + surface need pinning; FluentAvalonia handles the rest incl. the accent
         focus border from SystemAccentColor (seeded from our amber, see App.axaml). -->
    <Style Selector="ComboBox">
        <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusSm}" />
        <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
    </Style>

    <!-- ToggleSwitch (docs/superpowers/specs/2026-09-06-toggleswitch-adoption-design.md) - only the
         thumb-slide duration is overridden, via the real KnobTransitions property FluentAvalonia's
         own ControlTheme already exposes directly on ToggleSwitch (confirmed against FluentAvalonia's
         source, ToggleSwitchStyles.axaml - no /template/ part targeting needed). Track/thumb colors,
         sizing, and every other visual stay FluentAvalonia's defaults. Same DynamicResource-bound-
         Duration convention as every BrushTransition/DoubleTransition in Primitives.axaml above -
         closes the gap where Reduced Motion previously had zero effect on this control. -->
    <Styles.Resources>
        <!-- FluentAvalonia's own ToggleSwitchStyles.axaml reserves these as GridLength *rows* above
             and below the 20px switch track (10px each = 20px total) for OnContent/OffContent labels
             sitting beside the switch. Every conversion in this app uses a bare switch with the label
             in a separate adjacent TextBlock instead (OnContent/OffContent left null) - without this
             override, that reserved space still renders as dead empty space in every converted
             control's bounding box, making rows look taller than intended and the label center
             against the wrong height. Zeroed here once, app-wide, instead of overriding per instance. -->
        <GridLength x:Key="ToggleSwitchPreContentMargin">0</GridLength>
        <GridLength x:Key="ToggleSwitchPostContentMargin">0</GridLength>

        <!-- SuggestBox (Controls/SuggestBox.cs) - the ComboBox/AutoCompleteBox replacement for the
             metadata editors. A TextBox + disclosure button + a plain Popup list, mirroring
             LibraryToolbar's own dropdown idiom. Deliberately NO two-way IsOpen<->IsDropDownOpen
             binding (the popup's IsOpen is one-way off IsDropDownOpen; the control's code owns every
             close via Popup.Closed) - that cross-property oscillation is exactly the dropdown-open
             freeze this control was built to sidestep (see SuggestBox / FluentAvaloniaWorkarounds). -->
        <ControlTheme x:Key="{x:Type c:SuggestBox}" TargetType="c:SuggestBox">
            <!-- Defaults for the metadata-editor look; a classed Style (e.g. .contentTypePicker on
                 the detail screens) can override any of these and the TemplateBindings below carry
                 the override down to PART_TextBox. -->
            <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusSm}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Name="PART_TextBox" Grid.Column="0"
                                 Watermark="{TemplateBinding Watermark}"
                                 IsReadOnly="{TemplateBinding IsStrict}"
                                 CornerRadius="{TemplateBinding CornerRadius}"
                                 Background="{TemplateBinding Background}"
                                 BorderBrush="{TemplateBinding BorderBrush}"
                                 Foreground="{TemplateBinding Foreground}" />

                        <Button Name="PART_DropDownButton" Grid.Column="1" Margin="-28,0,0,0"
                                Width="26" Background="Transparent" BorderThickness="0"
                                Padding="0" VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Cursor="Hand" ToolTip.Tip="Show suggestions">
                            <fi:SymbolIcon Symbol="ChevronDown" FontSize="12"
                                           Foreground="{DynamicResource PbTextFaintBrush}" />
                        </Button>

                        <Popup Name="PART_Popup" PlacementTarget="{Binding #PART_TextBox}"
                               Placement="BottomEdgeAlignedLeft" VerticalOffset="4"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               IsLightDismissEnabled="True">
                            <Border Background="{DynamicResource PbSurface3Brush}"
                                    BorderBrush="{DynamicResource PbBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource PbRadiusSm}"
                                    MinWidth="{Binding #PART_TextBox.Bounds.Width}"
                                    MaxHeight="280" Padding="3"
                                    BoxShadow="0 16 40 -8 #99000000">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <ListBox Name="PART_Items"
                                             ItemsSource="{Binding FilteredItems, RelativeSource={RelativeSource TemplatedParent}}"
                                             Background="Transparent" BorderThickness="0"
                                             SelectionMode="Single">
                                        <!-- Non-virtualizing panel: the default VirtualizingStackPanel's
                                             recycled-container bookkeeping corrupts when this Popup
                                             closes (ArgumentOutOfRangeException deep in Avalonia's
                                             detach walk, SetVisualParent -> AvaloniaList<T>.Remove),
                                             independent of what triggers the close or when. List is
                                             capped at MaxRows (60) in SuggestBox.cs, so virtualization
                                             buys nothing here - a plain StackPanel sidesteps the whole
                                             recycling path. -->
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="12.5"
                                                           Foreground="{DynamicResource PbTextBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>

    <Style Selector="ToggleSwitch">
        <Setter Property="KnobTransitions">
            <Transitions>
                <DoubleTransition Property="Canvas.Left" Duration="{DynamicResource PbMotionFast}" Easing="{StaticResource PbMotionEase}" />
            </Transitions>
        </Setter>
    </Style>

    <!-- Text-box spinner (Behaviors/TextSpinner.cs), restyled per docs/superpowers/specs/2026-09-14-
         metadata-editors-redesign-design.md §4 - a bordered pill container around the two
         RepeatButtons instead of them floating borderless, divider between the halves, solid accent
         fill (not just a foreground-color change) on hover. -->
    <Style Selector="Border.textSpinnerContainer">
        <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="20" />
    </Style>
    <Style Selector="Border.textSpinnerDivider">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource PbBorderBrush}" />
    </Style>
    <Style Selector="RepeatButton.textSpinner">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource PbTextFaintBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="RepeatButton.textSpinner:pointerover">
        <Setter Property="Background" Value="{DynamicResource PbAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PbBadgeTextBrush}" />
    </Style>
    <Style Selector="RepeatButton.textSpinner fi|SymbolIcon">
        <Setter Property="FontSize" Value="8" />
    </Style>
</Styles>
