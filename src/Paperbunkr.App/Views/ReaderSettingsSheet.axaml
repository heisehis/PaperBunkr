<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Paperbunkr.App.Models"
             xmlns:entities="using:Paperbunkr.Data.Entities"
             xmlns:views="using:Paperbunkr.App.Views"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="600"
             x:Class="Paperbunkr.App.Views.ReaderSettingsSheet"
             x:Name="Root">

    <!-- Font & Theme sheet, redesigned into grouped mini-cards rather than 8 flat stacked sections
         (docs/superpowers/specs/2026-09-03-books-reader-hud-redesign-design.md). The approved
         design's original "controls stay a bottom sheet" call didn't hold up once seen on-screen
         (real user feedback after the first on-screen pass), so it became a drawer - originally on
         the right, deliberately opposite ReaderListDrawer's left (TOC/Bookmarks/Highlights/Search),
         but commit fbaa4de (2026-09-05) later flipped it to the left too, "matching every other
         reader drawer's now-consistent side" - this comment previously went stale on that point,
         fixed 2026-09-16.

         Hosted in a real, separately-owned Window (OverlayWindowController, wired from
         ReaderSettingsSheet.axaml.cs) rather than a Popup - Popup + ShouldUseOverlayLayer="False"
         alone does NOT reliably keep this sheet above the reading pane's native WebView in this
         app: Program.cs's Win32PlatformOptions.OverlayPopups = true overrides it app-wide (see the
         detailed airspace-problem note above BookReaderScreen.axaml's own NativeWebView element). A
         real Window isn't subject to OverlayPopups at all. This Grid is UserControl.Content only
         nominally - the code-behind detaches it immediately in the constructor and re-parents it
         into/out of a real Window as IsOpen changes, so it never actually renders inline here. -->
    <Grid x:Name="OverlayRoot" Width="{Binding #Root.OverlayReference.Bounds.Width}" Height="{Binding #Root.OverlayReference.Bounds.Height}">
        <!-- Local styles declared here (not UserControl.Styles) so they travel with this Grid when
             it's reparented into the overlay Window - Avalonia resolves Styles by walking up from
             the styled element's own current logical parent, and once this Grid is re-parented, the
             UserControl above stops being an ancestor. -->
        <Grid.Styles>
            <Style Selector="Border.miniCard">
                <Setter Property="Background" Value="{DynamicResource PbSurface3Brush}" />
                <Setter Property="CornerRadius" Value="{DynamicResource PbRadius}" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style Selector="TextBlock.cardTitle">
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>
            <Style Selector="TextBlock.fieldLabel">
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="LetterSpacing" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource PbTextFaintBrush}" />
            </Style>
        </Grid.Styles>
        <Border Background="#B0000000" PointerPressed="OnScrimPointerPressed" />
            <Border HorizontalAlignment="Left" Width="340" Background="{Binding #Root.SheetBackground}"
                    BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,0,1,0"
                    Padding="16,18">
                <ScrollViewer>
                <StackPanel Spacing="14">

                    <Border Classes="miniCard" IsVisible="{Binding #Root.HasTypographyControls}">
                        <StackPanel Spacing="14">
                            <TextBlock Classes="cardTitle" Text="TYPOGRAPHY" Foreground="{Binding #Root.SheetForeground}" />

                            <StackPanel Spacing="8">
                                <TextBlock Classes="fieldLabel" Text="Text size" Foreground="{Binding #Root.SheetForeground}" />
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Text="A" FontSize="12" Foreground="{Binding #Root.SheetForeground}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Slider Grid.Column="1" Minimum="{x:Static models:BookReaderSettings.MinFontSize}" Maximum="{x:Static models:BookReaderSettings.MaxFontSize}"
                                            Value="{Binding #Root.Settings.FontSize}" />
                                    <TextBlock Grid.Column="2" Text="A" FontSize="20" Foreground="{Binding #Root.SheetForeground}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Classes="fieldLabel" Text="Font" Foreground="{Binding #Root.SheetForeground}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="sheetOption" Classes.active="{Binding #Root.Settings.FontFamilyOption, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:BookFontFamilyOption.Serif}}"
                                            Content="Serif" FontFamily="Georgia,Cambria,serif"
                                            Command="{Binding #Root.SetFontFamilyCommand}" CommandParameter="{x:Static entities:BookFontFamilyOption.Serif}" />
                                    <Button Classes="sheetOption" Classes.active="{Binding #Root.Settings.FontFamilyOption, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:BookFontFamilyOption.Sans}}"
                                            Content="Sans" FontFamily="Segoe UI,Arial,sans-serif"
                                            Command="{Binding #Root.SetFontFamilyCommand}" CommandParameter="{x:Static entities:BookFontFamilyOption.Sans}" />
                                    <Button Classes="sheetOption" Classes.active="{Binding #Root.Settings.FontFamilyOption, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:BookFontFamilyOption.Mono}}"
                                            Content="Mono" FontFamily="Consolas,monospace"
                                            Command="{Binding #Root.SetFontFamilyCommand}" CommandParameter="{x:Static entities:BookFontFamilyOption.Mono}" />
                                    <Button Classes="sheetOption" Classes.active="{Binding #Root.Settings.FontFamilyOption, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:BookFontFamilyOption.OpenDyslexic}}"
                                            Content="OpenDyslexic" FontFamily="OpenDyslexic,Georgia,Cambria,serif"
                                            Command="{Binding #Root.SetFontFamilyCommand}" CommandParameter="{x:Static entities:BookFontFamilyOption.OpenDyslexic}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Classes="fieldLabel" Text="Line spacing" Foreground="{Binding #Root.SheetForeground}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="sheetOption" Classes.active="{Binding #Root.Settings.LineSpacing, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:BookLineSpacingOption.Compact}}"
                                            Content="Compact" Command="{Binding #Root.SetLineSpacingCommand}" CommandParameter="{x:Static entities:BookLineSpacingOption.Compact}" />
                                    <Button Classes="sheetOption" Classes.active="{Binding #Root.Settings.LineSpacing, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:BookLineSpacingOption.Normal}}"
                                            Content="Normal" Command="{Binding #Root.SetLineSpacingCommand}" CommandParameter="{x:Static entities:BookLineSpacingOption.Normal}" />
                                    <Button Classes="sheetOption" Classes.active="{Binding #Root.Settings.LineSpacing, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:BookLineSpacingOption.Relaxed}}"
                                            Content="Relaxed" Command="{Binding #Root.SetLineSpacingCommand}" CommandParameter="{x:Static entities:BookLineSpacingOption.Relaxed}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="miniCard" IsVisible="{Binding #Root.HasTypographyControls}">
                        <StackPanel Spacing="14">
                            <TextBlock Classes="cardTitle" Text="SPACING &amp; MARGINS" Foreground="{Binding #Root.SheetForeground}" />
                            <StackPanel Spacing="8">
                                <TextBlock Classes="fieldLabel" Text="Character spacing" Foreground="{Binding #Root.SheetForeground}" />
                                <Slider Minimum="0" Maximum="4" Value="{Binding #Root.Settings.CharacterSpacing}" />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Classes="fieldLabel" Text="Word spacing" Foreground="{Binding #Root.SheetForeground}" />
                                <Slider Minimum="0" Maximum="20" Value="{Binding #Root.Settings.WordSpacing}" />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Classes="fieldLabel" Text="Paragraph spacing" Foreground="{Binding #Root.SheetForeground}" />
                                <Slider Minimum="0" Maximum="30" Value="{Binding #Root.Settings.ParagraphSpacing}" />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Classes="fieldLabel" Text="Page margin" Foreground="{Binding #Root.SheetForeground}" />
                                <Slider Minimum="16" Maximum="100" Value="{Binding #Root.Settings.PageMargin}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="miniCard">
                        <StackPanel Spacing="14">
                            <TextBlock Classes="cardTitle" Text="THEME" Foreground="{Binding #Root.SheetForeground}" />
                            <!-- Active-swatch ring omitted here (a real, disclosed simplification): a
                                 generic ItemsControl over ThemeOptions can't cleanly compare each item
                                 against #Root.Settings.Theme without a MultiBinding/converter pair this
                                 pass didn't add - clicking still sets the theme via SetThemeCommand,
                                 only the "which one is active" ring is missing. -->
                            <ItemsControl ItemsSource="{Binding #Root.ThemeOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="10" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="entities:BookTheme">
                                        <Button Classes="chromeIcon" Width="44" Height="44" Padding="0"
                                                Command="{Binding #Root.SetThemeCommand}" CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding}">
                                            <Border Classes="themeSwatch" Background="{Binding Converter={x:Static views:BookThemeSwatchConverter.Instance}}" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding #Root.HasAutoHideToggle}">
                                <TextBlock Grid.Column="0" Text="Auto-hide toolbar when idle" VerticalAlignment="Center" Foreground="{Binding #Root.SheetForeground}" Margin="0,0,8,0" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding #Root.AutoHideToggle}" OnContent="{x:Null}" OffContent="{x:Null}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
                </ScrollViewer>
            </Border>
    </Grid>
</UserControl>
