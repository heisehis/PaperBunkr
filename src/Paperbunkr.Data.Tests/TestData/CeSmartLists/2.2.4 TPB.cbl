<?xml version="1.0"?>
<ReadingList xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Name>2.2.4 TPB</Name>
  <Books />
  <Matchers>
    <ComicBookMatcher xsi:type="ComicBookFormatMatcher" Not="true">
      <MatchValue>TPB</MatchValue>
    </ComicBookMatcher>
    <ComicBookMatcher xsi:type="ComicBookFullPathMatcher" MatchOperator="4">
      <MatchValue>D:\Books\Comics</MatchValue>
    </ComicBookMatcher>
    <ComicBookMatcher xsi:type="ComicBookDirectoryMatcher" MatchOperator="1">
      <MatchValue>TPB</MatchValue>
    </ComicBookMatcher>
    <ComicBookMatcher xsi:type="ComicBookPublisherMatcher" Not="true">
      <MatchValue>DC Comics</MatchValue>
    </ComicBookMatcher>
    <ComicBookMatcher xsi:type="ComicBookPublisherMatcher" Not="true">
      <MatchValue>marvel</MatchValue>
    </ComicBookMatcher>
  </Matchers>
</ReadingList>