<Project Sdk="Microsoft.NET.Sdk">

  <!-- Builds the Grand Comics Database extract from GCD's SQLite dump (docs/superpowers/specs/2026-09-27-gcd-data-design.md §1).
       A maintainer tool: run by hand, never shipped. The logic lives in Paperbunkr.Data (Gcd/GcdExtractor.cs) so it's tested there. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Paperbunkr.Data\Paperbunkr.Data.csproj" />
  </ItemGroup>

</Project>
