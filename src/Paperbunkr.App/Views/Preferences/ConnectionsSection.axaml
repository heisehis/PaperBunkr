<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pbc="using:Paperbunkr.App.Controls"
             xmlns:pref="using:Paperbunkr.App.Views.Preferences"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:models="using:Paperbunkr.App.Models"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="900"
             x:Class="Paperbunkr.App.Views.Preferences.ConnectionsSection"
             x:DataType="vm:PreferencesScreenViewModel">

    <UserControl.Styles>
        <!-- Connections redesign (docs/superpowers/specs/2026-09-07-connections-redesign-design.md)
             §1 - a connected row gets a soft accent tint; the checkmark stays as the primary signal,
             this is additional weight, not a replacement. Unconnected rows stay neutral - "not
             connected yet" isn't a negative state worth dimming. -->
        <Style Selector="Button.sideItemButton.connConnected">
            <Setter Property="Background" Value="{DynamicResource PbAccentSoftBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource PbRadiusSm}" />
            <Setter Property="Margin" Value="6,1" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <!-- One row template shared by both provider lists (docs/superpowers/specs/2026-09-06-
             connections-tracker-dialog-redesign-design.md) - BrandMark, name, a checkmark when
             connected (nothing when not), whole row opens that provider's dialog. -->
        <DataTemplate x:Key="ProviderRowTemplate" x:DataType="models:ConnectionProviderRow">
            <Button Classes="sideItemButton" Classes.connConnected="{Binding IsConnected}" HorizontalAlignment="Stretch"
                    Command="{Binding #Root.((vm:PreferencesScreenViewModel)DataContext).OpenConnectionDialogCommand}"
                    CommandParameter="{Binding}">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,8">
                    <pbc:BrandMark Grid.Column="0" Family="Service" Value="{Binding DisplayName}" MarkSize="15" ShowText="True" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="✓" FontSize="14" FontWeight="Bold" Foreground="#4CAF50"
                               VerticalAlignment="Center" IsVisible="{Binding IsConnected}"
                               ToolTip.Tip="Connected" />
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <ScrollViewer>
            <StackPanel Margin="28,20,28,40" Spacing="20">
                <TextBlock Classes="pbTextHeading" Text="Connections" />

                <!-- Reading List Sources -->
                <Border Classes="groupBox" Tag="connections.metadataSources">
                    <StackPanel>
                        <Border Classes="groupHeader">
                            <TextBlock Text="Reading List Sources" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding SourceProviderRows}" ItemTemplate="{StaticResource ProviderRowTemplate}" Margin="6" />
                    </StackPanel>
                </Border>

                <!-- Download automation (docs/superpowers/specs/2026-09-20-cluster-library-manager-into-core-design.md 7) -->
                <Border Classes="groupBox" Tag="connections.downloadAutomation">
                    <StackPanel>
                        <Border Classes="groupHeader">
                            <TextBlock Text="Download automation" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding DownloadProviderRows}" ItemTemplate="{StaticResource ProviderRowTemplate}" Margin="6" />
                    </StackPanel>
                </Border>

                <!-- Trackers -->
                <Border Classes="groupBox" Tag="connections.trackers">
                    <StackPanel>
                        <Border Classes="groupHeader">
                            <TextBlock Text="Trackers" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding TrackerProviderRows}" ItemTemplate="{StaticResource ProviderRowTemplate}" Margin="6" />
                    </StackPanel>
                </Border>

                <!-- Tracking behavior (docs/superpowers/specs/2026-09-18-tracker-behavior-settings-design.md)
                     - global toggles modeled on Komikku's Settings -> Tracking. Each is read fresh at the
                     moment it applies, so a change takes effect without a restart. -->
                <Border Classes="groupBox" Tag="connections.trackingBehavior">
                    <StackPanel>
                        <Border Classes="groupHeader">
                            <TextBlock Text="Tracking behavior" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                        </Border>
                        <StackPanel Margin="6">
                            <pref:SettingsRow Icon="Link" Title="Open the tracker link panel automatically"
                                               Description="The first time you open a manga that has a metadata source link and a connected tracker account, jump to its tracker link panel. Once per series.">
                                <pref:SettingsRow.SettingsContent>
                                    <ToggleSwitch IsChecked="{Binding TrackerAutoOpenLinkPanel}" OnContent="{x:Null}" OffContent="{x:Null}"
                                                  AutomationProperties.AutomationId="TrackerAutoOpenLinkPanel" AutomationProperties.Name="Open the tracker link panel automatically" />
                                </pref:SettingsRow.SettingsContent>
                            </pref:SettingsRow>
                            <pref:SettingsRow Icon="Book" Title="Update progress after reading"
                                               Description="When you finish an issue in the reader, push your progress to linked trackers. Only ever moves a tracker forward, and never touches score or dates.">
                                <pref:SettingsRow.SettingsContent>
                                    <ToggleSwitch IsChecked="{Binding TrackerUpdateAfterReading}" OnContent="{x:Null}" OffContent="{x:Null}"
                                                  AutomationProperties.AutomationId="TrackerUpdateAfterReading" AutomationProperties.Name="Update progress after reading" />
                                </pref:SettingsRow.SettingsContent>
                            </pref:SettingsRow>
                            <pref:SettingsRow Icon="Checkmark" Title="Update progress when marked as read"
                                               Description="When you mark issues as read yourself: Always updates trackers, Ask shows a prompt first, Never leaves them alone.">
                                <pref:SettingsRow.SettingsContent>
                                    <pbc:SuggestBox IsStrict="True" Text="{Binding TrackerUpdateOnMarkReadText}"
                                                    Suggestions="{Binding TrackerUpdateModeNames}" MinWidth="150"
                                                    AutomationProperties.AutomationId="TrackerUpdateOnMarkRead" AutomationProperties.Name="Update progress when marked as read" />
                                </pref:SettingsRow.SettingsContent>
                            </pref:SettingsRow>
                            <pref:SettingsRow Icon="ArrowSync" Title="Auto sync progress from trackers"
                                               Description="When you open a linked series, pull any further-along progress from its trackers and mark those issues read here. Off by default because it changes your local read state.">
                                <pref:SettingsRow.SettingsContent>
                                    <ToggleSwitch IsChecked="{Binding TrackerAutoSyncFromTrackers}" OnContent="{x:Null}" OffContent="{x:Null}"
                                                  AutomationProperties.AutomationId="TrackerAutoSyncFromTrackers" AutomationProperties.Name="Auto sync progress from trackers" />
                                </pref:SettingsRow.SettingsContent>
                            </pref:SettingsRow>
                            <pref:SettingsRow Icon="Search" Title="Select entries using source metadata"
                                               Description="When linking a tracker, show the series' already-linked metadata source at the top of the results. You still confirm before anything is written to your account.">
                                <pref:SettingsRow.SettingsContent>
                                    <ToggleSwitch IsChecked="{Binding TrackerUseSourceMetadata}" OnContent="{x:Null}" OffContent="{x:Null}"
                                                  AutomationProperties.AutomationId="TrackerUseSourceMetadata" AutomationProperties.Name="Select entries using source metadata" />
                                </pref:SettingsRow.SettingsContent>
                            </pref:SettingsRow>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Connection dialog overlay - local to this section (PreferencesScreenViewModel already owns
             every field/command involved), matching MainWindow's IsIssuePropertiesOverlayOpen scrim
             weight without hoisting state to MainViewModel. Three IsVisible-gated panels keyed on
             SelectedConnectionProvider.Kind, per docs/superpowers/specs/2026-09-06-connections-
             tracker-dialog-redesign-design.md. Each panel is now one generic block bound to the
             row's own fields/command references instead of 3 DisplayName-gated copies (docs/
             superpowers/specs/2026-09-07-connections-redesign-design.md §2). -->
        <Border IsVisible="{Binding IsConnectionDialogOpen}" Background="#B0000000">
            <Border Background="{DynamicResource PbSurface1Brush}" BorderBrush="{DynamicResource PbBorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="24" Width="420" MaxHeight="560"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14" DataContext="{Binding SelectedConnectionProvider}" x:DataType="models:ConnectionProviderRow">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <pbc:BrandMark Grid.Column="0" Family="Service" Value="{Binding DisplayName}" MarkSize="18" ShowText="True" VerticalAlignment="Center" />

                        <!-- Status dot (docs/superpowers/specs/2026-09-07-connections-redesign-
                             design.md §2) - a live, always-current connected signal, independent of
                             whatever the shared status line last said. Nothing renders when not
                             connected - the row-level checkmark already covers that state. -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                    Margin="0,0,10,0" IsVisible="{Binding IsConnected}">
                            <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource PbSuccessBrush}" />
                            <TextBlock Text="Connected" FontSize="11.5" Foreground="{DynamicResource PbSuccessBrush}" />
                        </StackPanel>

                        <Button Grid.Column="2" Classes="headerAction ghost"
                                Command="{Binding #Root.((vm:PreferencesScreenViewModel)DataContext).CloseConnectionDialogCommand}"
                                ToolTip.Tip="Close" AutomationProperties.AutomationId="ConnectionDialogCloseButton">
                        </Button>
                    </Grid>

                    <TextBlock Text="{Binding HelpText}" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" TextWrapping="Wrap" />

                    <!-- OAuth shape: AniList, MyAnimeList, Shikimori -->
                    <StackPanel Spacing="10" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:ConnectionDialogKind.OAuth}}">
                        <TextBox Text="{Binding ClientId}" Watermark="Client ID" />
                        <TextBox Text="{Binding ClientSecret}" Watermark="Client Secret" PasswordChar="•" IsVisible="{Binding RequiresClientSecret}" />
                        <Button Classes="headerAction primary" Content="Open Authorization Page"
                                Command="{Binding ConnectCommand}" HorizontalAlignment="Left" />
                        <TextBox Text="{Binding PastedValue}" Watermark="{Binding PasteWatermark}" />
                        <Button Classes="headerAction" Content="Complete Connection"
                                Command="{Binding CompleteCommand}" HorizontalAlignment="Left" />
                        <Button Classes="headerAction ghost" Foreground="{DynamicResource PbDangerBrush}" BorderBrush="{DynamicResource PbDangerSoftBrush}"
                                HorizontalAlignment="Left" IsVisible="{Binding IsConnected}" Command="{Binding DisconnectCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <fi:SymbolIcon Symbol="PlugDisconnected" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbDangerBrush}" />
                                <TextBlock Text="Disconnect" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Token shape: Bangumi, MangaBaka, ComicVine -->
                    <StackPanel Spacing="10" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:ConnectionDialogKind.Token}}">
                        <TextBox Text="{Binding SecretValue}" Watermark="Personal Access Token / API Key" PasswordChar="•" />
                        <Button Classes="headerAction primary" Content="{Binding PrimaryActionLabel}"
                                Command="{Binding SaveCommand}" HorizontalAlignment="Left" />
                        <Button Classes="headerAction ghost" Foreground="{DynamicResource PbDangerBrush}" BorderBrush="{DynamicResource PbDangerSoftBrush}"
                                HorizontalAlignment="Left" IsVisible="{Binding IsConnected}" Command="{Binding DisconnectCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <fi:SymbolIcon Symbol="PlugDisconnected" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbDangerBrush}" />
                                <TextBlock Text="Disconnect" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Prowlarr: address + API key. Fields live on the acquisition view-model (one source of truth), reached through the section's DataContext. -->
                    <StackPanel Spacing="10" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:ConnectionDialogKind.Prowlarr}}">
                        <TextBox Text="{Binding #Root.((vm:PreferencesScreenViewModel)DataContext).Acquisition.ProwlarrUrl}" Watermark="http://localhost:9696"
                                 AutomationProperties.Name="Prowlarr address" AutomationProperties.AutomationId="ConnectionProwlarrUrl" />
                        <TextBox Text="{Binding #Root.((vm:PreferencesScreenViewModel)DataContext).Acquisition.ProwlarrApiKey}" PasswordChar="•"
                                 Watermark="{Binding #Root.((vm:PreferencesScreenViewModel)DataContext).Acquisition.ApiKeyWatermark}"
                                 AutomationProperties.Name="Prowlarr API key" AutomationProperties.AutomationId="ConnectionProwlarrKey" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Classes="headerAction primary" Content="Save"
                                    Command="{Binding #Root.((vm:PreferencesScreenViewModel)DataContext).Acquisition.SaveConnectionsCommand}"
                                    AutomationProperties.AutomationId="ConnectionProwlarrSave" />
                            <Button Classes="headerAction ghost" Content="Test connection"
                                    Command="{Binding #Root.((vm:PreferencesScreenViewModel)DataContext).Acquisition.TestProwlarrCommand}"
                                    AutomationProperties.AutomationId="ConnectionProwlarrTest" />
                        </StackPanel>
                        <TextBlock Text="{Binding #Root.((vm:PreferencesScreenViewModel)DataContext).Acquisition.StatusMessage}"
                                   IsVisible="{Binding #Root.((vm:PreferencesScreenViewModel)DataContext).Acquisition.HasErrorStatus}"
                                   FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource PbDangerBrush}" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="{Binding #Root.((vm:PreferencesScreenViewModel)DataContext).Acquisition.StatusMessage}"
                                   IsVisible="{Binding #Root.((vm:PreferencesScreenViewModel)DataContext).Acquisition.HasInfoStatus}"
                                   FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource PbSuccessBrush}" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>

                    <!-- qBittorrent: web UI address, username, password, category. -->
                    <StackPanel Spacing="10" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:ConnectionDialogKind.QBittorrent}}">
                        <TextBox Text="{Binding #Root.((vm:PreferencesScreenViewModel)DataContext).Acquisition.QBittorrentUrl}" Watermark="http://localhost:8080"
                                 AutomationProperties.Name="qBittorrent web UI address" AutomationProperties.AutomationId="ConnectionQBittorrentUrl" />
                        <TextBox Text="{Binding #Root.((vm:PreferencesScreenViewModel)DataContext).Acquisition.QBittorrentUsername}" Watermark="Username"
                                 AutomationProperties.Name="qBittorrent username" />
                        <TextBox Text="{Binding #Root.((vm:PreferencesScreenViewModel)DataContext).Acquisition.QBittorrentPassword}" PasswordChar="•"
                                 Watermark="{Binding #Root.((vm:PreferencesScreenViewModel)DataContext).Acquisition.QBittorrentPasswordWatermark}"
                                 AutomationProperties.Name="qBittorrent password" />
                        <TextBox Text="{Binding #Root.((vm:PreferencesScreenViewModel)DataContext).Acquisition.QBittorrentCategory}" Watermark="paperbunkr-comics"
                                 AutomationProperties.Name="qBittorrent category" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Classes="headerAction primary" Content="Save"
                                    Command="{Binding #Root.((vm:PreferencesScreenViewModel)DataContext).Acquisition.SaveConnectionsCommand}"
                                    AutomationProperties.AutomationId="ConnectionQBittorrentSave" />
                            <Button Classes="headerAction ghost" Content="Test connection"
                                    Command="{Binding #Root.((vm:PreferencesScreenViewModel)DataContext).Acquisition.TestQBittorrentCommand}"
                                    AutomationProperties.AutomationId="ConnectionQBittorrentTest" />
                        </StackPanel>
                        <TextBlock Text="{Binding #Root.((vm:PreferencesScreenViewModel)DataContext).Acquisition.StatusMessage}"
                                   IsVisible="{Binding #Root.((vm:PreferencesScreenViewModel)DataContext).Acquisition.HasErrorStatus}"
                                   FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource PbDangerBrush}" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="{Binding #Root.((vm:PreferencesScreenViewModel)DataContext).Acquisition.StatusMessage}"
                                   IsVisible="{Binding #Root.((vm:PreferencesScreenViewModel)DataContext).Acquisition.HasInfoStatus}"
                                   FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource PbSuccessBrush}" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>

                    <!-- Credential shape: Metron, MangaUpdates, Kitsu -->
                    <StackPanel Spacing="10" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:ConnectionDialogKind.Credential}}">
                        <TextBox Text="{Binding Username}" Watermark="Username" />
                        <TextBox Text="{Binding Password}" Watermark="Password" PasswordChar="•" />
                        <Button Classes="headerAction primary" Content="{Binding PrimaryActionLabel}"
                                Command="{Binding PrimaryCommand}" HorizontalAlignment="Left" />
                        <Button Classes="headerAction ghost" Foreground="{DynamicResource PbDangerBrush}" BorderBrush="{DynamicResource PbDangerSoftBrush}"
                                HorizontalAlignment="Left" IsVisible="{Binding IsConnected}" Command="{Binding DisconnectCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <fi:SymbolIcon Symbol="PlugDisconnected" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbDangerBrush}" />
                                <TextBlock Text="Disconnect" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Credential + own app registration shape: MangaDex only - Client ID/Secret
                         (its own Personal Client, no shared public client) plus username/password. -->
                    <StackPanel Spacing="10" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:ConnectionDialogKind.CredentialWithClient}}">
                        <TextBox Text="{Binding ClientId}" Watermark="Client ID" />
                        <TextBox Text="{Binding ClientSecret}" Watermark="Client Secret" PasswordChar="•" />
                        <TextBox Text="{Binding Username}" Watermark="Username" />
                        <TextBox Text="{Binding Password}" Watermark="Password" PasswordChar="•" />
                        <Button Classes="headerAction primary" Content="{Binding PrimaryActionLabel}"
                                Command="{Binding PrimaryCommand}" HorizontalAlignment="Left" />
                        <Button Classes="headerAction ghost" Foreground="{DynamicResource PbDangerBrush}" BorderBrush="{DynamicResource PbDangerSoftBrush}"
                                HorizontalAlignment="Left" IsVisible="{Binding IsConnected}" Command="{Binding DisconnectCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <fi:SymbolIcon Symbol="PlugDisconnected" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbDangerBrush}" />
                                <TextBlock Text="Disconnect" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock Text="{Binding #Root.((vm:PreferencesScreenViewModel)DataContext).ConnectionDialogStatus}" FontSize="12"
                               Foreground="{DynamicResource PbTextFaintBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
