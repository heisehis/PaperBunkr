<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="360"
             xmlns:controls="using:Paperbunkr.App.Controls"
             x:Class="Paperbunkr.App.Views.UpdateAvailableOverlay"
             x:DataType="vm:UpdateAvailableOverlayViewModel">

    <controls:DialogCard Title="Update available" Subtitle="{Binding VersionText, StringFormat='Paperbunkr {0} is ready to download.'}"
                         Size="Small" CloseCommand="{Binding NotNowCommand}">
        <StackPanel Spacing="12">
            <Button Classes="linkText" HorizontalAlignment="Left"
                    Command="{Binding OpenReleaseNotesCommand}" ToolTip.Tip="{Binding ReleaseNotesUrl}"
                    AutomationProperties.AutomationId="UpdateAvailableReleaseNotes">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="See what's new in this release" />
                    <fi:SymbolIcon Symbol="Open" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="Don't check for updates on startup" VerticalAlignment="Center" Foreground="{DynamicResource PbTextBrush}" Margin="0,0,10,0" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding DontCheckOnStartup}" OnContent="{x:Null}" OffContent="{x:Null}"
                              AutomationProperties.Name="Don't check for updates on startup" />
            </Grid>
        </StackPanel>
        <controls:DialogCard.Footer>
            <StackPanel>
                <Button Classes="ghost" Content="Not now" Command="{Binding NotNowCommand}"
                        AutomationProperties.AutomationId="UpdateAvailableNotNow" />
                <Button Classes="primary" Command="{Binding DownloadCommand}"
                        AutomationProperties.AutomationId="UpdateAvailableDownload">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <fi:SymbolIcon Symbol="ArrowDownload" FontSize="{StaticResource PbIconSizeXs}" />
                        <TextBlock Text="Download" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </controls:DialogCard.Footer>
    </controls:DialogCard>
</UserControl>
