<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:views="using:Paperbunkr.App.Views"
             xmlns:controls="using:Paperbunkr.App.Controls"
             xmlns:models="using:Paperbunkr.App.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="Paperbunkr.App.Views.SmartScreen"
             x:DataType="vm:SmartScreenViewModel">

    <UserControl.Styles>
        <Style Selector="Button.headerAction">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.headerAction.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
        </Style>
        <Style Selector="Button.headerAction.primary">
            <Setter Property="Background" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PbBadgeTextBrush}" />
        </Style>

        <Style Selector="ComboBox.conditionPicker">
            <Setter Property="Background" Value="{DynamicResource PbChromeBrush}" />
            <Setter Property="BorderBrush" Value="#383D47" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinWidth" Value="120" />
        </Style>
        <Style Selector="TextBox.conditionValue">
            <Setter Property="Background" Value="{DynamicResource PbChromeBrush}" />
            <Setter Property="BorderBrush" Value="#383D47" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinWidth" Value="120" />
        </Style>

        <!-- Matches Button.card in LibraryScreen.axaml - transparent hit-target wrapper. -->
        <Style Selector="Button.resultCard">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Matches Border.issueTile in DetailTabs.axaml exactly (docs/superpowers/specs/
             2026-08-09-smart-lists-results-view-design.md) - same visual, no selection state since
             results here are read-only/click-to-navigate. -->
        <Style Selector="Border.resultTile">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="Height" Value="168" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel>

            <Grid ColumnDefinitions="*,Auto" Margin="28,20,28,16">
                <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding ListName}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PbTextBrush}" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="{DynamicResource PbTextFaintBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                    <Button Classes="headerAction ghost" Command="{Binding DuplicateCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <fi:SymbolIcon Symbol="Copy" FontSize="12" />
                            <TextBlock Text="Duplicate" />
                        </StackPanel>
                    </Button>
                    <Button Classes="headerAction primary" Command="{Binding SaveCommand}" IsVisible="{Binding !IsReadOnly}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <fi:SymbolIcon Symbol="Save" FontSize="12" Foreground="{DynamicResource PbBadgeTextBrush}" />
                            <TextBlock Text="Save" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,24" />

            <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="28,0,28,40">

                <Border Background="{DynamicResource PbChromeBrush}" BorderBrush="{DynamicResource PbBorderBrush}"
                        BorderThickness="1" CornerRadius="999" Padding="12,6" HorizontalAlignment="Left" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource PbSuccessBrush}" VerticalAlignment="Center" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}">
                            <Run Text="Currently matches " />
                            <Run Text="{Binding MatchCountLabel}" FontFamily="Consolas,monospace" FontWeight="Bold" Foreground="{DynamicResource PbTextBrush}" />
                            <Run Text=" issues" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource PbChromeBrush}" BorderBrush="{DynamicResource PbBorderBrush}"
                        BorderThickness="1" CornerRadius="7" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Match ALL of the following:" FontSize="11.5" FontWeight="Bold"
                                   Foreground="{DynamicResource PbTextFaintBrush}" Margin="0,0,0,10" />

                        <ItemsControl ItemsSource="{Binding Conditions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SmartListConditionViewModel">
                                    <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ComboBox Classes="conditionPicker" ItemsSource="{Binding FieldOptions}"
                                                      SelectedItem="{Binding SelectedField}"
                                                      IsEnabled="{Binding !$parent[UserControl].((vm:SmartScreenViewModel)DataContext).IsReadOnly}" />

                                            <TextBox Classes="conditionValue" Width="150" Watermark="value name"
                                                     Text="{Binding CustomValueName}" IsVisible="{Binding IsCustomValueField}"
                                                     IsReadOnly="{Binding $parent[UserControl].((vm:SmartScreenViewModel)DataContext).IsReadOnly}" />

                                            <ComboBox Classes="conditionPicker" Width="150" PlaceholderText="virtual tag"
                                                      ItemsSource="{Binding VirtualTagOptions}" SelectedItem="{Binding SelectedVirtualTag}"
                                                      IsVisible="{Binding IsVirtualTagField}"
                                                      IsEnabled="{Binding !$parent[UserControl].((vm:SmartScreenViewModel)DataContext).IsReadOnly}" />

                                            <ComboBox Classes="conditionPicker" ItemsSource="{Binding OperatorOptions}"
                                                      SelectedItem="{Binding SelectedOperator}" IsVisible="{Binding !IsDuplicateField}"
                                                      IsEnabled="{Binding !$parent[UserControl].((vm:SmartScreenViewModel)DataContext).IsReadOnly}" />

                                            <TextBox Classes="conditionValue" Text="{Binding Value}" IsVisible="{Binding !IsDuplicateField}"
                                                      IsReadOnly="{Binding $parent[UserControl].((vm:SmartScreenViewModel)DataContext).IsReadOnly}" />

                                            <TextBlock Text="and" FontSize="12.5" Foreground="{DynamicResource PbTextFaintBrush}"
                                                       VerticalAlignment="Center" IsVisible="{Binding ShowValue2}" />
                                            <TextBox Classes="conditionValue" Width="90" Text="{Binding Value2}" IsVisible="{Binding ShowValue2}"
                                                      IsReadOnly="{Binding $parent[UserControl].((vm:SmartScreenViewModel)DataContext).IsReadOnly}" />

                                            <Button Classes="headerAction ghost" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove condition"
                                                    IsVisible="{Binding !$parent[UserControl].((vm:SmartScreenViewModel)DataContext).IsReadOnly}">
                                                <fi:SymbolIcon Symbol="SubtractCircle" FontSize="13" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Classes="headerAction ghost" Command="{Binding AddConditionCommand}"
                                HorizontalAlignment="Left" Padding="0" Margin="0,12,0,0"
                                Foreground="{DynamicResource PbAccentTextBrush}" IsVisible="{Binding !IsReadOnly}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <fi:SymbolIcon Symbol="Add" FontSize="12" />
                                <TextBlock Text="Add condition" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="9" Margin="0,20,0,0" IsVisible="{Binding !IsReadOnly}">
                    <Button Classes="headerAction ghost" Padding="14,8" Command="{Binding CancelCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <fi:SymbolIcon Symbol="DismissCircle" FontSize="12" />
                            <TextBlock Text="Cancel" />
                        </StackPanel>
                    </Button>
                    <Button Classes="headerAction primary" Padding="14,8" Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <fi:SymbolIcon Symbol="Save" FontSize="12" Foreground="{DynamicResource PbBadgeTextBrush}" />
                            <TextBlock Text="Apply" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,32,0,0" IsVisible="{Binding !HasResults}">
                    <fi:SymbolIcon Symbol="Search" FontSize="13" />
                    <TextBlock Text="No issues match this list yet." FontSize="12.5"
                               Foreground="{DynamicResource PbTextFaintBrush}" />
                </StackPanel>

                <ItemsControl x:Name="ResultsList" ItemsSource="{Binding Results}" Margin="0,32,0,0"
                              IsVisible="{Binding HasResults}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:VirtualizingWrapPanel ItemWidth="120" ItemHeight="168" ItemSpacing="16" LineSpacing="16" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:IssueCardSample">
                            <Button Classes="resultCard" Width="120"
                                    Command="{Binding #ResultsList.((vm:SmartScreenViewModel)DataContext).SelectResultCommand}"
                                    CommandParameter="{Binding}">
                                <Border Classes="resultTile" Background="{Binding CoverBrush}">
                                    <Grid>
                                        <Image views:AsyncCoverImage.SourceId="{Binding CoverIssueId}" Stretch="UniformToFill" />
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Black" Foreground="#FFFFF8EC"
                                                   VerticalAlignment="Bottom" Margin="9" />
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
