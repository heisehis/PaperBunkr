<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:models="using:Paperbunkr.App.Models"
             xmlns:views="using:Paperbunkr.App.Views"
             xmlns:entities="using:Paperbunkr.Data.Entities"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="760"
             x:Class="Paperbunkr.App.Views.EventsScreen"
             x:DataType="vm:EventsScreenViewModel">

    <UserControl.Styles>
        <!-- issueRow / searchBox from Styles/ScreenChrome.axaml. -->
        <Style Selector="Button.headerAction">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusSm}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.headerAction.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
        </Style>
        <Style Selector="Button.headerAction.secondary">
            <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
        </Style>
        <Style Selector="Button.headerAction.primary">
            <Setter Property="Background" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PbBadgeTextBrush}" />
        </Style>

        <!-- Segmented Primary/Timeline toggle -->
        <Style Selector="Button.segToggle">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.segToggle.on">
            <Setter Property="Background" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbBadgeTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Member row: calm at rest, ⋮ on hover -->
        <Style Selector="Border.itemRow">
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusSm}" />
            <Setter Property="Padding" Value="6,7" />
            <Setter Property="Margin" Value="0,1" />
        </Style>
        <Style Selector="Border.itemRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
        </Style>
        <Style Selector="Border.itemRow :is(Control).rowManage">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Border.itemRow:pointerover :is(Control).rowManage">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="CheckBox.rowPick.pinned">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="CheckBox.posterPick">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Panel.posterCell:pointerover CheckBox.posterPick">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="CheckBox.posterPick.pinned">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <!-- Continuity member card: move / note-edit affordances appear on hover -->
        <Style Selector="StackPanel.memberCard :is(Control).cardHover">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="StackPanel.memberCard:pointerover :is(Control).cardHover">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>

        <!-- Recessed panel header -->
        <Style Selector="Button.panelHead">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,9" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.panelHead:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ===== Empty state (nothing at all) ===== -->
        <StackPanel Grid.Row="0" Grid.RowSpan="3" Margin="28,40" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsVisible="{Binding HasNoEvents}">
            <TextBlock Text="Create an event or a continuity to get started" FontSize="13"
                       Foreground="{DynamicResource PbTextMutedBrush}" HorizontalAlignment="Center"
                       IsVisible="{Binding HasNoContinuities}" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" IsVisible="{Binding HasNoContinuities}">
                <Button Classes="headerAction primary" Content="＋ New event"
                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenNewEventDialogCommand}" CommandParameter="Event" />
                <Button Classes="headerAction secondary" Content="＋ New continuity"
                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenNewEventDialogCommand}" CommandParameter="Continuity" />
            </StackPanel>
        </StackPanel>

        <!-- ===== Top band ===== -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="28,20,28,12"
              IsVisible="{Binding !HasNoEvents}">
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <!-- Event header -->
                <StackPanel IsVisible="{Binding IsEventSelected}">
                    <TextBlock Classes="pbTextHeading" Text="{Binding EventName}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding MetaLine}" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" Margin="0,5,0,0" />
                    <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{DynamicResource PbTextMutedBrush}"
                               TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" MaxWidth="620" HorizontalAlignment="Left"
                               Margin="0,6,0,0" IsVisible="{Binding !HasNoEventDescription}" />
                </StackPanel>
                <!-- Continuity header -->
                <StackPanel IsVisible="{Binding IsContinuitySelected}">
                    <TextBlock Classes="pbTextHeading" Text="{Binding ContinuityName}" TextWrapping="Wrap" />
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" Margin="0,5,0,0">
                        <Run Text="Continuity" /><Run Text=" · " /><Run Text="{Binding ContinuityPublisher}" />
                    </TextBlock>
                    <TextBlock Text="{Binding ContinuityDescription}" FontSize="11.5" Foreground="{DynamicResource PbTextMutedBrush}"
                               TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" MaxWidth="620" HorizontalAlignment="Left"
                               Margin="0,6,0,0"
                               IsVisible="{Binding ContinuityDescription, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="1" Background="{DynamicResource PbSurface2Brush}" BorderBrush="{DynamicResource PbBorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="3" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Classes="segToggle" Classes.on="{Binding IsPrimaryView}"
                            Command="{Binding SetDetailViewCommand}" CommandParameter="{x:Static models:EventsDetailView.Primary}">
                        <Panel>
                            <TextBlock Text="Members" IsVisible="{Binding IsEventSelected}" />
                            <TextBlock Text="Series" IsVisible="{Binding IsContinuitySelected}" />
                        </Panel>
                    </Button>
                    <Button Classes="segToggle" Classes.on="{Binding IsTimelineView}" Content="Timeline"
                            Command="{Binding SetDetailViewCommand}" CommandParameter="{x:Static models:EventsDetailView.Timeline}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Action row ===== -->
        <StackPanel Grid.Row="1" Margin="28,0,28,8" Spacing="10" IsVisible="{Binding !HasNoEvents}">
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsPrimaryView}">
                <!-- event -->
                <Button Classes="headerAction primary" Content="＋ Add issues" Command="{Binding ToggleAddIssuesCommand}"
                        IsVisible="{Binding IsEventSelected}" />
                <Button Classes="headerAction secondary" Content="⋯ Manage" IsVisible="{Binding IsEventSelected}">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Edit details…"
                                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenEditEventDialogCommand}" />
                            <MenuItem Header="Delete event" Command="{Binding DeleteActiveEventCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <!-- continuity -->
                <Button Classes="headerAction primary" Content="＋ Add series" Command="{Binding ToggleAddContinuitySeriesCommand}"
                        IsVisible="{Binding IsContinuitySelected}" />
                <Button Classes="headerAction secondary" Content="⋯ Manage" IsVisible="{Binding IsContinuitySelected}">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Edit details…"
                                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenEditContinuityDialogCommand}" />
                            <MenuItem Header="Compare with another continuity" Command="{Binding ToggleCompareContinuitiesCommand}"
                                      IsVisible="{Binding !HasNoOverlappingContinuities}" />
                            <MenuItem Header="Create reading list (publication order)" Command="{Binding CreateReadingListFromContinuityCommand}" />
                            <Separator />
                            <MenuItem Header="Delete continuity" Command="{Binding DeleteActiveContinuityCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <!-- Add issues (event) -->
            <Border Classes="issueRow" Background="{DynamicResource PbSurface2Brush}" Padding="12"
                    IsVisible="{Binding IsAddingIssues}">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Classes="searchBox" Watermark="Search your library by series or number…" Text="{Binding SearchQuery}">
                            <TextBox.InnerLeftContent>
                                <fi:SymbolIcon Symbol="Search" FontSize="13" Margin="8,0,2,0" />
                            </TextBox.InnerLeftContent>
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                        <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="120" FontSize="12"
                                  ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding SelectedRoleOption}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:EventMembershipRoleOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <Border Background="{DynamicResource PbSurface3Brush}" CornerRadius="5" Padding="8,6" IsVisible="{Binding AnyEventSearchSelected}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding EventSearchSelectionSummary}" FontSize="11.5" Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                            <Button Classes="headerAction primary" Padding="10,4" FontSize="11" Content="Add selected" Command="{Binding AddSelectedMembersCommand}" />
                            <Button Classes="headerAction ghost" Padding="8,4" FontSize="11" Content="Clear" Command="{Binding ClearEventSearchSelectionCommand}" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding SearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:IssueSearchResult">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,2,6,2" ColumnSpacing="8">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" MinWidth="0" Padding="0"
                                              Command="{Binding $parent[ItemsControl].((vm:EventsScreenViewModel)DataContext).ToggleEventSearchSelectionCommand}"
                                              CommandParameter="{Binding}" />
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayLabel}" FontSize="12.5" Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Classes="headerAction ghost" Padding="6,3" FontSize="10.5" Content="＋ series"
                                            ToolTip.Tip="Add every issue of this series"
                                            Command="{Binding $parent[ItemsControl].((vm:EventsScreenViewModel)DataContext).AddAllOfSeriesToEventCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Grid.Column="3" Classes="headerAction ghost" Content="Add"
                                            Command="{Binding $parent[ItemsControl].((vm:EventsScreenViewModel)DataContext).AddIssueCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Add series (continuity) -->
            <Border Classes="issueRow" Background="{DynamicResource PbSurface2Brush}" Padding="12"
                    IsVisible="{Binding IsAddingContinuitySeries}">
                <StackPanel Spacing="8">
                    <TextBox Classes="searchBox" Watermark="Search series by name…" Text="{Binding ContinuitySeriesSearchQuery}">
                        <TextBox.InnerLeftContent>
                            <fi:SymbolIcon Symbol="Search" FontSize="13" Margin="8,0,2,0" />
                        </TextBox.InnerLeftContent>
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding SearchContinuitySeriesCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Border Background="{DynamicResource PbSurface3Brush}" CornerRadius="5" Padding="8,6" IsVisible="{Binding AnyContinuitySeriesSelected}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding ContinuitySeriesSelectionSummary}" FontSize="11.5" Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                            <Button Classes="headerAction primary" Padding="10,4" FontSize="11" Content="Add selected" Command="{Binding AddSelectedSeriesCommand}" />
                            <Button Classes="headerAction ghost" Padding="8,4" FontSize="11" Content="Clear" Command="{Binding ClearContinuitySeriesSelectionCommand}" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding ContinuitySeriesSearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:SeriesSearchResult">
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2,6,2" ColumnSpacing="8">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" MinWidth="0" Padding="0"
                                              Command="{Binding $parent[ItemsControl].((vm:EventsScreenViewModel)DataContext).ToggleContinuitySeriesSelectionCommand}"
                                              CommandParameter="{Binding}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Classes="headerAction ghost" Content="Add"
                                            Command="{Binding $parent[ItemsControl].((vm:EventsScreenViewModel)DataContext).AddSeriesToActiveContinuityCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Compare panel (continuity) -->
            <Border Classes="issueRow" Background="{DynamicResource PbSurface2Brush}" Padding="12"
                    IsVisible="{Binding IsComparingContinuities}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Compare with another continuity:" FontSize="12" Foreground="{DynamicResource PbTextFaintBrush}" />
                    <ItemsControl ItemsSource="{Binding OverlappingContinuities}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ContinuityOverlapCard">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,3">
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding SharedSeriesLabel}" FontSize="10.5" Foreground="{DynamicResource PbTextFaintBrush}" VerticalAlignment="Center" Margin="8,0" />
                                    <Button Grid.Column="2" Classes="headerAction ghost" Content="Show overlap"
                                            Command="{Binding $parent[ItemsControl].((vm:EventsScreenViewModel)DataContext).CompareWithContinuityCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Grid.Column="3" Classes="headerAction ghost" Margin="6,0,0,0"
                                            Content="{Binding MergeConfirm.Label}" Command="{Binding MergeConfirm.TriggerCommand}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel IsVisible="{Binding HasComparison}" Spacing="6" Margin="0,6,0,0">
                        <TextBlock Text="{Binding CompareContinuityName, StringFormat='Shared with {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PbTextBrush}" />
                        <ItemsControl ItemsSource="{Binding SharedContinuitySeries}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:SeriesCardSample">
                                    <Border Classes="pbChip" Padding="10,5" Margin="0,0,6,6">
                                        <TextBlock Text="{Binding Name}" FontSize="11.5" Foreground="{DynamicResource PbTextBrush}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ===== Content ===== -->
        <ScrollViewer Grid.Row="2" IsVisible="{Binding !HasNoEvents}">
            <StackPanel Margin="0,0,0,40">

                <!-- Event · Primary (members + panels) -->
                <StackPanel IsVisible="{Binding IsEventSelected}">
                    <StackPanel IsVisible="{Binding IsPrimaryView}">
                        <TextBlock Text="No members yet — Add issues to get started." FontSize="12.5" Margin="28,8,28,0"
                                   Foreground="{DynamicResource PbTextFaintBrush}" IsVisible="{Binding HasNoMembers}" />

                        <Border Margin="16,4,16,6" Background="{DynamicResource PbSurface2Brush}" CornerRadius="5" Padding="8,6"
                                IsVisible="{Binding AnyEventMembersSelected}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{Binding EventMemberSelectionSummary}" FontSize="11.5" Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                                <Button Classes="headerAction ghost" Padding="8,4" FontSize="11" Content="Remove" Command="{Binding RemoveSelectedMembersCommand}" />
                                <ComboBox ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding BulkRole}" FontSize="11" MinWidth="110" PlaceholderText="Set role">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:EventMembershipRoleOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Classes="headerAction ghost" Padding="8,4" FontSize="11" Content="Apply" Command="{Binding SetRoleForSelectedMembersCommand}" />
                                <Button Classes="headerAction ghost" Padding="8,4" FontSize="11" Content="Clear" Command="{Binding ClearEventMemberSelectionCommand}" />
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Members}" Margin="16,6,16,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:EventMemberRowViewModel">
                                    <Border Classes="itemRow">
                                        <Grid ColumnDefinitions="22,26,46,*,Auto,Auto">
                                            <CheckBox Grid.Column="0" Classes="rowManage rowPick"
                                                      Classes.pinned="{Binding $parent[UserControl].((vm:EventsScreenViewModel)DataContext).AnyEventMembersSelected}"
                                                      IsChecked="{Binding IsSelected}" VerticalAlignment="Center" MinWidth="0" Padding="0"
                                                      Command="{Binding $parent[UserControl].((vm:EventsScreenViewModel)DataContext).ToggleEventMemberSelectionCommand}"
                                                      CommandParameter="{Binding}" />
                                            <TextBlock Grid.Column="1" Classes="pbTextHeading" Text="{Binding Position}" FontSize="15"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource PbTextFaintBrush}" />
                                            <Border Grid.Column="2" Width="42" Height="63" Margin="0,0,12,0" CornerRadius="3" ClipToBounds="True"
                                                    Background="{DynamicResource PbSurface3Brush}">
                                                <Image views:AsyncCoverImage.SourceId="{Binding CoverKey}" Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TitleLine}" FontSize="13.5" Foreground="{DynamicResource PbTextBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding SeriesLine}" FontSize="11" Margin="0,1,0,0" Foreground="{DynamicResource PbTextFaintBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Border Grid.Column="4" Classes="pbChip" Padding="8,3" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding RoleChipLabel}" FontSize="10" Foreground="{DynamicResource PbTextMutedBrush}" />
                                            </Border>
                                            <Button Grid.Column="5" Classes="rowManage headerAction ghost" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip.Tip="More">
                                                <fi:SymbolIcon Symbol="MoreVertical" FontSize="13" />
                                                <Button.Flyout>
                                                    <MenuFlyout>
                                                        <MenuItem Header="Set role">
                                                            <MenuItem Header="Prologue" Command="{Binding SetRoleCommand}" CommandParameter="{x:Static entities:EventMembershipRole.Prologue}" />
                                                            <MenuItem Header="Core" Command="{Binding SetRoleCommand}" CommandParameter="{x:Static entities:EventMembershipRole.Core}" />
                                                            <MenuItem Header="Tie-in" Command="{Binding SetRoleCommand}" CommandParameter="{x:Static entities:EventMembershipRole.TieIn}" />
                                                            <MenuItem Header="Epilogue" Command="{Binding SetRoleCommand}" CommandParameter="{x:Static entities:EventMembershipRole.Epilogue}" />
                                                            <MenuItem Header="Optional" Command="{Binding SetRoleCommand}" CommandParameter="{x:Static entities:EventMembershipRole.Optional}" />
                                                            <MenuItem Header="Aftermath" Command="{Binding SetRoleCommand}" CommandParameter="{x:Static entities:EventMembershipRole.Aftermath}" />
                                                        </MenuItem>
                                                        <Separator />
                                                        <MenuItem Header="Move up" Command="{Binding MoveUpCommand}" />
                                                        <MenuItem Header="Move down" Command="{Binding MoveDownCommand}" />
                                                        <Separator />
                                                        <MenuItem Header="Remove from event" Command="{Binding RemoveCommand}" />
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Related events panel -->
                        <StackPanel Margin="24,14,24,0" IsVisible="{Binding !HasNoMembers}">
                            <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,1,0,0" />
                            <Button Classes="panelHead" Command="{Binding ToggleRelatedEventsCommand}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Related events" FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding RelatedEventsSummary}" FontSize="10.5" Foreground="{DynamicResource PbTextFaintBrush}" />
                                        <fi:SymbolIcon Symbol="ChevronRight" FontSize="9" IsVisible="{Binding !RelatedEventsExpanded}" />
                                        <fi:SymbolIcon Symbol="ArrowDown" FontSize="9" IsVisible="{Binding RelatedEventsExpanded}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <StackPanel IsVisible="{Binding RelatedEventsExpanded}" Margin="8,0,0,8" Spacing="4">
                                <ItemsControl ItemsSource="{Binding ConnectedEvents}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ConnectedEventCard">
                                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                                                <Button Grid.Column="0" Classes="headerAction ghost" HorizontalAlignment="Left" Padding="4,3"
                                                        Command="{Binding $parent[ItemsControl].((vm:EventsScreenViewModel)DataContext).OpenConnectedEventCommand}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource PbTextBrush}" />
                                                </Button>
                                                <Border Grid.Column="1" Classes="pbChip" Padding="7,2" VerticalAlignment="Center" Margin="6,0">
                                                    <TextBlock Text="{Binding RelationLabel}" FontSize="9.5" Foreground="{DynamicResource PbTextFaintBrush}" />
                                                </Border>
                                                <Button Grid.Column="2" Classes="headerAction ghost" Padding="5" ToolTip.Tip="Unlink"
                                                        Command="{Binding $parent[ItemsControl].((vm:EventsScreenViewModel)DataContext).RemoveConnectedEventCommand}"
                                                        CommandParameter="{Binding}">
                                                    <fi:SymbolIcon Symbol="Delete" FontSize="11" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Suggested" FontSize="9" Foreground="{DynamicResource PbTextFaintBrush}"
                                           Margin="0,6,0,2" IsVisible="{Binding !HasNoConnectionSuggestions}" />
                                <ItemsControl ItemsSource="{Binding EventConnectionSuggestions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:EventConnectionSuggestionCard">
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource PbTextMutedBrush}" />
                                                    <TextBlock Text="{Binding Reason}" FontSize="10" Foreground="{DynamicResource PbTextFaintBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Classes="headerAction ghost" Content="Connect" VerticalAlignment="Center"
                                                        Command="{Binding $parent[ItemsControl].((vm:EventsScreenViewModel)DataContext).ConnectSuggestedEventCommand}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Classes="headerAction ghost" HorizontalAlignment="Left" Padding="4,4" Content="＋ Connect an event…"
                                        Command="{Binding ToggleConnectEventCommand}" />
                                <StackPanel IsVisible="{Binding IsConnectingEvent}" Spacing="6" Margin="0,4,0,0">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" Classes="searchBox" Watermark="Search story events…" Text="{Binding ConnectEventQuery}" />
                                        <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="120" FontSize="12"
                                                  ItemsSource="{Binding EventRelationTypeOptions}" SelectedItem="{Binding SelectedEventRelationTypeOption}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:RelationTypeOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding EventSearchResults}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:StoryEventSearchResult">
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                                                    <Button Grid.Column="1" Classes="headerAction ghost" Content="Connect"
                                                            Command="{Binding $parent[ItemsControl].((vm:EventsScreenViewModel)DataContext).ConnectEventCommand}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <Button Classes="headerAction ghost" HorizontalAlignment="Left" Padding="4,4"
                                        Command="{Binding ToggleEventFamilyCommand}" IsVisible="{Binding HasEventChain}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="Event chain" FontSize="11.5" Foreground="{DynamicResource PbTextMutedBrush}" />
                                        <fi:SymbolIcon Symbol="ChevronRight" FontSize="8" IsVisible="{Binding !EventFamilyExpanded}" />
                                        <fi:SymbolIcon Symbol="ArrowDown" FontSize="8" IsVisible="{Binding EventFamilyExpanded}" />
                                    </StackPanel>
                                </Button>
                                <ItemsControl ItemsSource="{Binding EventFamily}" IsVisible="{Binding EventFamilyExpanded}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:EventFamilyNodeCard">
                                            <Button Classes="headerAction ghost" HorizontalAlignment="Left" Padding="4,3"
                                                    Command="{Binding $parent[ItemsControl].((vm:EventsScreenViewModel)DataContext).OpenFamilyEventCommand}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="{Binding Indent}" />
                                                    <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource PbTextBrush}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>

                        <!-- Issue suggestions panel -->
                        <StackPanel Margin="24,4,24,0" IsVisible="{Binding !HasNoSuggestions}">
                            <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,1,0,0" />
                            <Button Classes="panelHead" Command="{Binding ToggleIssueSuggestionsCommand}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Issue suggestions" FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding IssueSuggestionsSummary}" FontSize="10.5" Foreground="{DynamicResource PbTextFaintBrush}" />
                                        <fi:SymbolIcon Symbol="ChevronRight" FontSize="9" IsVisible="{Binding !IssueSuggestionsExpanded}" />
                                        <fi:SymbolIcon Symbol="ArrowDown" FontSize="9" IsVisible="{Binding IssueSuggestionsExpanded}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <StackPanel IsVisible="{Binding IssueSuggestionsExpanded}" Margin="8,0,0,8">
                                <ItemsControl ItemsSource="{Binding SuggestedIssues}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SuggestedIssueRowViewModel">
                                            <Grid ColumnDefinitions="*,120,Auto,Auto" Margin="0,3">
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayLabel}" FontSize="12.5" Foreground="{DynamicResource PbTextBrush}" />
                                                    <TextBlock Text="{Binding Reason}" FontSize="10" Foreground="{DynamicResource PbTextFaintBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding SelectedRoleOption}"
                                                          FontSize="11" VerticalAlignment="Center" Margin="8,0">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="models:EventMembershipRoleOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <Button Grid.Column="2" Classes="headerAction ghost" Content="Add" VerticalAlignment="Center" Command="{Binding AddCommand}" />
                                                <Button Grid.Column="3" Classes="headerAction ghost" Content="Dismiss" VerticalAlignment="Center" Command="{Binding DismissCommand}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Classes="headerAction ghost" HorizontalAlignment="Left" Padding="4,4"
                                        Command="{Binding ToggleDismissedCommand}" IsVisible="{Binding !HasNoDismissed}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="Dismissed" FontSize="11" Foreground="{DynamicResource PbTextFaintBrush}" />
                                        <Border Classes="pbChip" Padding="5,1"><TextBlock Text="{Binding DismissedSuggestions.Count}" FontSize="9.5" Foreground="{DynamicResource PbTextFaintBrush}" /></Border>
                                    </StackPanel>
                                </Button>
                                <ItemsControl ItemsSource="{Binding DismissedSuggestions}" IsVisible="{Binding DismissedExpanded}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:DismissedSuggestionCard">
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource PbTextFaintBrush}" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Classes="headerAction ghost" Content="Restore"
                                                        Command="{Binding $parent[ItemsControl].((vm:EventsScreenViewModel)DataContext).RestoreDismissedCommand}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Event · Timeline -->
                    <ContentControl IsVisible="{Binding IsTimelineView}">
                        <views:EventTimelineView />
                    </ContentControl>
                </StackPanel>

                <!-- Continuity · Primary (series grid) -->
                <StackPanel IsVisible="{Binding IsContinuitySelected}">
                    <StackPanel IsVisible="{Binding IsPrimaryView}" Margin="24,8,24,0">
                        <TextBlock Text="No series yet — Add series to get started." FontSize="12.5"
                                   Foreground="{DynamicResource PbTextFaintBrush}" IsVisible="{Binding HasNoContinuityMembers}" />

                        <Border Margin="0,0,0,8" Background="{DynamicResource PbSurface2Brush}" CornerRadius="5" Padding="8,6"
                                IsVisible="{Binding AnyContinuityMembersSelected}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{Binding ContinuityMemberSelectionSummary}" FontSize="11.5" Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                                <Button Classes="headerAction ghost" Padding="8,4" FontSize="11" Content="Remove from continuity" Command="{Binding RemoveSelectedSeriesCommand}" />
                                <Button Classes="headerAction ghost" Padding="8,4" FontSize="11" Content="Clear" Command="{Binding ClearContinuityMemberSelectionCommand}" />
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding ContinuityMembers}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:SeriesCardSample">
                                    <StackPanel Classes="memberCard" Width="96" Margin="0,0,12,14">
                                        <Panel Classes="posterCell">
                                            <Button Classes="headerAction ghost" Padding="0"
                                                    Command="{Binding $parent[ItemsControl].((vm:EventsScreenViewModel)DataContext).OpenContinuitySeriesCommand}"
                                                    CommandParameter="{Binding}">
                                                <Border Height="144" CornerRadius="5" ClipToBounds="True" Background="{Binding CoverBrush}">
                                                    <Image views:AsyncCoverImage.SourceId="{Binding CoverKey}" Stretch="UniformToFill" />
                                                </Border>
                                            </Button>
                                            <CheckBox Classes="posterPick"
                                                      Classes.pinned="{Binding $parent[UserControl].((vm:EventsScreenViewModel)DataContext).AnyContinuityMembersSelected}"
                                                      IsChecked="{Binding IsSelected}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4"
                                                      MinWidth="0" Padding="0"
                                                      Command="{Binding $parent[ItemsControl].((vm:EventsScreenViewModel)DataContext).ToggleContinuityMemberSelectionCommand}"
                                                      CommandParameter="{Binding}" />
                                            <Button Classes="headerAction ghost" Padding="4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                                    Background="#B0000000" ToolTip.Tip="Remove from continuity"
                                                    Command="{Binding $parent[ItemsControl].((vm:EventsScreenViewModel)DataContext).RemoveSeriesFromActiveContinuityCommand}"
                                                    CommandParameter="{Binding}">
                                                <fi:SymbolIcon Symbol="Dismiss" FontSize="10" />
                                            </Button>
                                            <Button Classes="headerAction ghost cardHover" Padding="4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4"
                                                    Background="#B0000000" ToolTip.Tip="Move earlier"
                                                    Command="{Binding $parent[ItemsControl].((vm:EventsScreenViewModel)DataContext).MoveContinuitySeriesEarlierCommand}"
                                                    CommandParameter="{Binding}">
                                                <fi:SymbolIcon Symbol="ChevronLeft" FontSize="10" />
                                            </Button>
                                            <Button Classes="headerAction ghost cardHover" Padding="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4"
                                                    Background="#B0000000" ToolTip.Tip="Move later"
                                                    Command="{Binding $parent[ItemsControl].((vm:EventsScreenViewModel)DataContext).MoveContinuitySeriesLaterCommand}"
                                                    CommandParameter="{Binding}">
                                                <fi:SymbolIcon Symbol="ChevronRight" FontSize="10" />
                                            </Button>
                                        </Panel>
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="10.5" Foreground="{DynamicResource PbTextBrush}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Classes="headerAction ghost cardHover" Padding="2" ToolTip.Tip="Edit note"
                                                    Command="{Binding $parent[ItemsControl].((vm:EventsScreenViewModel)DataContext).BeginEditContinuitySeriesNoteCommand}"
                                                    CommandParameter="{Binding}">
                                                <fi:SymbolIcon Symbol="Edit" FontSize="9" />
                                            </Button>
                                        </Grid>
                                        <TextBlock Text="{Binding MembershipNote}" FontSize="9.5" Foreground="{DynamicResource PbTextFaintBrush}"
                                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                                                   IsVisible="{Binding HasMembershipNote}" />
                                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,3,0,0" IsVisible="{Binding IsEditingNote}">
                                            <TextBox Text="{Binding MembershipNote}" FontSize="10" Width="66" MinHeight="0" Padding="4,2"
                                                     Watermark="note" />
                                            <Button Classes="headerAction ghost" Padding="4" ToolTip.Tip="Save note"
                                                    Command="{Binding $parent[ItemsControl].((vm:EventsScreenViewModel)DataContext).SetContinuitySeriesNoteCommand}"
                                                    CommandParameter="{Binding}">
                                                <fi:SymbolIcon Symbol="Checkmark" FontSize="9" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Continuity · Timeline -->
                    <ContentControl IsVisible="{Binding IsTimelineView}">
                        <views:EventTimelineView />
                    </ContentControl>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
