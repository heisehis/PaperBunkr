<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ClusterLibraryManager.Settings"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="620"
             x:Class="ClusterLibraryManager.Settings.SettingsRootView"
             x:DataType="vm:SettingsRootViewModel">

    <!-- No card chrome here - the host's NativePluginModalHost Border (MainWindow.axaml) now owns
         background/border/corner-radius/elevation for every dialog it hosts. Only this view's own
         intended width/height stay here - the host caps width, it doesn't dictate it. -->
    <TabControl Width="640" Height="620">
        <TabItem Header="General">
            <vm:SettingsView DataContext="{Binding General}" />
        </TabItem>
        <TabItem Header="Profiles">
            <vm:ProfileManagerView DataContext="{Binding Profiles}" />
        </TabItem>
    </TabControl>
</UserControl>
