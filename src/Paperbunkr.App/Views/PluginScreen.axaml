<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="760"
             x:Class="Paperbunkr.App.Views.PluginScreen"
             x:DataType="vm:PluginScreenViewModel">

    <!-- No plugin engine exists yet (docs/superpowers/specs/2026-08-09-plugin-screen-cleanup-design.md)
         - a genuine empty state, same treatment as Detail's Related/Activity tabs, rather than the
         fake "Duplicate Finder" demo content this screen used to ship. -->
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6" MaxWidth="360">
        <Border Classes="icon" Width="40" Height="40" Margin="0,0,0,10" HorizontalAlignment="Center">
            <Border.OpacityMask>
                <ImageBrush Source="/Assets/Icons/Puzzle.png" Stretch="Uniform" />
            </Border.OpacityMask>
        </Border>
        <TextBlock Text="Plugins" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PbTextBrush}"
                   HorizontalAlignment="Center" />
        <TextBlock Text="No plugins installed yet." FontSize="13" Foreground="{DynamicResource PbTextMutedBrush}"
                   HorizontalAlignment="Center" TextAlignment="Center" />
        <TextBlock Text="Plugins will appear here once the plugin API ships." FontSize="12"
                   Foreground="{DynamicResource PbTextFaintBrush}" HorizontalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
