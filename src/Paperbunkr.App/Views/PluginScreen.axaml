<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="760"
             x:Class="Paperbunkr.App.Views.PluginScreen"
             x:DataType="vm:PluginScreenViewModel">

    <!--
        Master-detail layout (docs/superpowers/specs/2026-09-12-plugin-management-screen-redesign-
        design.md §4.4), replacing the previous flat "Packages panel + commands grouped by hook"
        layout (docs/superpowers/specs/2026-08-24-plugin-api-v2-design.md §6). Left column: every
        installed package, filterable. Right column: the selected package's identity/health,
        native-settings Configure entry point, master enable/disable, and its own commands only -
        the redesign's actual point is that these all now live together as one visible unit per
        plugin instead of two disconnected panels.
    -->
    <Grid ColumnDefinitions="220,*" Margin="24">

        <!-- ============ Sidebar ============ -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" Margin="0,0,16,0">
            <TextBox Grid.Row="0" Text="{Binding FilterText}" Watermark="Filter plugins…" Margin="0,0,0,10" />

            <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding FilteredPackages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PluginPackageRowViewModel">
                            <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Padding="8,6" Margin="0,0,0,2" Command="{Binding SelectCommand}">
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" IsVisible="{Binding !IsBroken}" Fill="#4CAF50" />
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" IsVisible="{Binding IsBroken}" Fill="#E06060" />
                                        <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource PbTextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Border IsVisible="{Binding IsNativeTier}" Background="#3A2E0E" CornerRadius="3" Padding="5,1">
                                            <TextBlock Text="Native" FontSize="9" Foreground="#E0B84D" />
                                        </Border>
                                        <Border IsVisible="{Binding IsPending}" Background="#1E3A5A" CornerRadius="3" Padding="5,1">
                                            <TextBlock Text="Restart to apply" FontSize="9" Foreground="#6EB4E8" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Button Grid.Row="2" Content="Install Package…" Command="{Binding InstallPackageCommand}" HorizontalAlignment="Stretch" Margin="0,10,0,0"
                    ToolTip.Tip="Installs a plugin package (.pbplugin or .zip). A script package (plugin.xml + .csx scripts) takes effect immediately. A native package (a compiled plugin with full read/write access to your library database) takes effect after you restart Paperbunkr." />
        </Grid>

        <!-- ============ Detail pane ============ -->
        <Grid Grid.Column="1">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6" MaxWidth="360"
                        IsVisible="{Binding SelectedPackageDetail, Converter={x:Static conv:ObjectConverters.IsNull}}">
                <fi:SymbolIcon Symbol="PuzzlePiece" FontSize="{StaticResource PbIconSizeXl}" Margin="0,0,0,10" HorizontalAlignment="Center" />
                <TextBlock Text="No plugin selected." FontSize="13" Foreground="{DynamicResource PbTextMutedBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center" />
                <TextBlock Text="Select a plugin on the left, or install a package to get started." FontSize="12"
                           Foreground="{DynamicResource PbTextFaintBrush}" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <ScrollViewer IsVisible="{Binding SelectedPackageDetail, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                <StackPanel Spacing="16" MaxWidth="720" DataContext="{Binding SelectedPackageDetail}" x:DataType="vm:PluginPackageDetailViewModel">

                    <!-- Header -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PbTextBrush}" />
                                <TextBlock Text="{Binding Version, StringFormat='v{0}'}" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource PbTextMutedBrush}"
                                           IsVisible="{Binding Version, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Author, StringFormat='by {0}'}" FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}"
                                       IsVisible="{Binding Author, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border IsVisible="{Binding IsNativeTier}" Background="#1E3A5A" CornerRadius="3" Padding="6,2">
                                    <TextBlock Text="Native" FontSize="11" Foreground="#6EB4E8" />
                                </Border>
                                <Border IsVisible="{Binding IsNativeTier}" Background="#3A2E0E" CornerRadius="3" Padding="6,2"
                                        ToolTip.Tip="This is a native plugin: it has full read/write access to your library database and does not go through the audited-write gate scripted plugins use.">
                                    <TextBlock Text="Full read/write access" FontSize="11" Foreground="#E0B84D" />
                                </Border>
                                <Border IsVisible="{Binding IsPending}" Background="#1E3A5A" CornerRadius="3" Padding="6,2"
                                        ToolTip.Tip="This change (install or remove) is staged and takes effect the next time you restart Paperbunkr.">
                                    <TextBlock Text="Restart to apply" FontSize="11" Foreground="#6EB4E8" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                            <Button Content="Reload" IsVisible="{Binding ShowReload}" Command="{Binding ReloadCommand}"
                                    ToolTip.Tip="Re-scans and recompiles every script-tier plugin - no restart needed. Use this after fixing a broken script." />
                            <Button Content="⚙ Configure" IsVisible="{Binding HasConfigure}" Command="{Binding ConfigureCommand}" />
                            <Button Content="{Binding DeleteConfirm.Label}" Command="{Binding DeleteConfirm.TriggerCommand}" />
                        </StackPanel>
                    </Grid>

                    <!-- Load-failure banner -->
                    <Border IsVisible="{Binding HasLoadError}" Background="#3A1414" CornerRadius="6" Padding="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding LoadError, StringFormat='Failed to load: {0}'}" FontSize="12"
                                       Foreground="#E06060" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Copy error" FontSize="11" Padding="8,3" Command="{Binding CopyErrorCommand}" />
                        </Grid>
                    </Border>

                    <!-- Master enable/disable -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <!--
                            Bound entirely through MasterEnabledClickCommand, IsChecked stays one-way
                            (docs §4.4) - Avalonia's own ToggleButton.Toggle() cycle is
                            true → null → false → true (verified against its real source), so a
                            plain two-way binding would bulk-*disable* everything on a click starting
                            from a mixed state. The Command binding is what the view actually reacts
                            to; a two-way IsChecked binding here would let Toggle() write back and
                            defeat the point.
                        -->
                        <CheckBox IsThreeState="True" IsChecked="{Binding EnabledState, Mode=OneWay}"
                                  Command="{Binding MasterEnabledClickCommand}" />
                        <TextBlock Text="Enabled" VerticalAlignment="Center" Foreground="{DynamicResource PbTextBrush}" />
                    </StackPanel>

                    <!-- Commands -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Commands" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PbAccentBrush}" />
                        <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,4" />

                        <ItemsControl ItemsSource="{Binding Commands}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PluginCommandRowViewModel">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,4,0,4"
                                          ToolTip.Tip="{Binding Description}" ToolTip.ShowDelay="400">
                                        <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium"
                                                       Foreground="{DynamicResource PbTextBrush}" />
                                            <TextBlock Text="{Binding CompileError}" FontSize="12"
                                                       Foreground="#E06060"
                                                       TextWrapping="Wrap" IsVisible="{Binding IsBroken}" />
                                        </StackPanel>

                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsEnabled}" VerticalAlignment="Top" Margin="0,0,8,0" OnContent="{x:Null}" OffContent="{x:Null}" />

                                        <Button Grid.Column="2" Content="Run" FontSize="11" Padding="8,3"
                                                VerticalAlignment="Top" Margin="0,0,8,0"
                                                IsVisible="{Binding CanRunManually}"
                                                Command="{Binding RunCommand}"
                                                ToolTip.Tip="Runs this command now and shows its result as a toast - this hook needs no live selection/context, so it can be triggered on demand." />

                                        <Button Grid.Column="3" Classes="ghost" Padding="4" VerticalAlignment="Top"
                                                IsVisible="{Binding HasConfigure}"
                                                Command="{Binding OpenConfigureCommand}"
                                                ToolTip.Tip="This command has its own configuration script - click to run it.">
                                            <fi:SymbolIcon Symbol="Settings" FontSize="{StaticResource PbIconSizeMd}" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
