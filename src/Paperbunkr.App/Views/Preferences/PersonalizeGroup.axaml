<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:controls="using:Paperbunkr.App.Controls"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:models="using:Paperbunkr.App.Models"
             xmlns:views="using:Paperbunkr.App.Views"
             xmlns:svc="using:Paperbunkr.App.Services"
             xmlns:pref="using:Paperbunkr.App.Views.Preferences"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="520"
             x:Class="Paperbunkr.App.Views.Preferences.PersonalizeGroup"
             x:DataType="vm:PersonalizeViewModel"
             ClipToBounds="False">

    <!-- Appearance > Personalize (docs/superpowers/specs/2026-11-06-personalization-design.md): friendly controls over the accent override, the Global
         corner-radius overrides and five personalization settings, with a live sample strip built from real controls. Every change applies live. -->
    <UserControl.Styles>
        <Style Selector="Button.swatch">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.swatch.selected">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbTextBrush}" />
        </Style>
        <Style Selector="Button.swatch.plus">
            <Setter Property="Background" Value="{DynamicResource PbSurface3Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="settingsGroupCaption" Text="PERSONALIZE" Margin="0" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Classes="ghost" Content="Export my look…" Command="{Binding ExportLookCommand}" IsVisible="{Binding HasLinks}"
                        ToolTip.Tip="Your theme customizations and Personalize settings, as one file" AutomationProperties.AutomationId="PersonalizeExportLook" />
                <Button Classes="ghost" Content="Import a look…" Command="{Binding ImportLookCommand}" IsVisible="{Binding HasLinks}"
                        ToolTip.Tip="Replace your theme customizations and Personalize settings with an exported look" AutomationProperties.AutomationId="PersonalizeImportLook" />
                <Button Classes="ghost" Content="Reset personalization" Command="{Binding ResetCommand}"
                        ToolTip.Tip="Back to the theme's own accent, corners, text size, fonts, card depth, sidebar and ring"
                        AutomationProperties.AutomationId="PersonalizeReset" />
            </StackPanel>
        </Grid>
        <TextBlock Classes="pbTextMeta" Text="{Binding LookFileMessage}" IsVisible="{Binding HasLookFileMessage}" TextWrapping="Wrap" HorizontalAlignment="Right"
                   AutomationProperties.LiveSetting="Polite" />

        <!-- Looks (docs/superpowers/specs/2026-11-06-looks-and-presets-design.md): corners, card depth, sidebar and ring in one click. Never the accent, fonts or text size. -->
        <!-- 8 px in from the left so the first card's focus ring is not cut by the page's scroll viewport. -->
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="8,4,0,8">
            <ItemsControl Grid.Column="0" ItemsSource="{Binding PresetCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:LookPresetCard">
                        <Button Classes="clickCard" Classes.selected="{Binding IsSelected}" Width="132"
                                Command="{Binding $parent[UserControl].((vm:PersonalizeViewModel)DataContext).ApplyPresetCommand}" CommandParameter="{Binding Name}"
                                AutomationProperties.Name="{Binding AutomationName}" ToolTip.Tip="{Binding Description}">
                            <StackPanel Spacing="8">
                                <!-- A tiny sample from the preset's own values: its corner and card shadow, and its ring. -->
                                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,4">
                                    <Border Width="30" Height="42" CornerRadius="{Binding SampleCorner}" BoxShadow="{Binding SampleShadow}"
                                            Background="{DynamicResource PbSurface3Brush}" />
                                    <Border Width="30" Height="42" CornerRadius="{Binding SampleCorner}" BoxShadow="{Binding SampleRing}"
                                            Background="{DynamicResource PbSurface3Brush}" />
                                </StackPanel>
                                <TextBlock Classes="pbTextBody" Text="{Binding Name}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
                <TextBlock Classes="pbTextMeta" Text="{Binding LookLabel, StringFormat='Look: {0}'}" HorizontalAlignment="Right"
                           AutomationProperties.LiveSetting="Polite" />
                <Button Classes="ghost" Content="Undo" Command="{Binding UndoPresetCommand}" HorizontalAlignment="Right"
                        ToolTip.Tip="Back to the look you had before the last preset" AutomationProperties.Name="Undo the last look" />
            </StackPanel>
        </Grid>

        <!-- The live preview card is its own control (PersonalizePreview), pinned in the Personalize tab's right pane
             (docs/superpowers/specs/2026-11-09-theme-gallery-and-roster-design.md Q13). -->
        <Grid ColumnDefinitions="*">
            <StackPanel Grid.Column="0" Spacing="2">

                <!-- Accent: presets, a custom colour, back to the theme's. One value with Customize's "All themes" accent. -->
                <pref:SettingsRow Icon="Color" Title="Accent colour" Description="Used for selection, buttons and highlights. Reset uses the theme's own accent.">
                    <pref:SettingsRow.SettingsContent>
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ItemsControl ItemsSource="{Binding SwatchItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:AccentSwatchItem">
                                            <Button Classes="swatch" Classes.selected="{Binding IsSelected}"
                                                    Background="{Binding Hex, Converter={x:Static views:AccentColorToBrushConverter.Instance}}"
                                                    AutomationProperties.Name="{Binding AutomationName}" ToolTip.Tip="{Binding Hex}"
                                                    Command="{Binding $parent[UserControl].((vm:PersonalizeViewModel)DataContext).SetAccentCommand}"
                                                    CommandParameter="{Binding Hex}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Classes="swatch selected" IsVisible="{Binding IsCustomAccent}"
                                        Background="{Binding AccentHex, Converter={x:Static views:AccentColorToBrushConverter.Instance}}"
                                        AutomationProperties.Name="Custom accent" ToolTip.Tip="{Binding AccentHex}"
                                        Command="{Binding ToggleColorFlyoutCommand}" />
                                <Button x:Name="CustomAccentButton" Classes="swatch plus" AutomationProperties.Name="Custom colour" ToolTip.Tip="Custom colour"
                                        Command="{Binding ToggleColorFlyoutCommand}">
                                    <fi:SymbolIcon Symbol="Add" FontSize="{StaticResource PbIconSizeXs}" />
                                </Button>
                                <Popup PlacementTarget="{Binding #CustomAccentButton}" Placement="BottomEdgeAlignedLeft" VerticalOffset="6"
                                       IsOpen="{Binding IsColorFlyoutOpen}" IsLightDismissEnabled="True" controls:PopupFit.ToWindow="True">
                                    <Border Classes="dropdown" Width="232"><ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <StackPanel Spacing="8" Margin="4">
                                            <controls:HsvColorPicker Color="{Binding PickerColor}" HorizontalAlignment="Center" />
                                            <TextBlock Classes="fieldLabel" Text="HEX" />
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <TextBox x:Name="AccentHexBox" Text="{Binding CustomAccentHex}" PlaceholderText="RRGGBB" AutomationProperties.Name="Hex colour" />
                                                <Button Grid.Column="1" Classes="ghost" Content="Apply" Command="{Binding ApplyCustomAccentCommand}" />
                                            </Grid>
                                            <TextBlock Classes="pbTextCaption" Foreground="{DynamicResource PbDangerBrush}" TextWrapping="Wrap"
                                                       Text="{Binding CustomAccentError}"
                                                       IsVisible="{Binding CustomAccentError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        </StackPanel>
                                    </ScrollViewer></Border>
                                </Popup>
                                <Button Classes="ghost" Content="Theme's own" Command="{Binding ResetAccentCommand}" IsEnabled="{Binding HasAccentOverride}"
                                        AutomationProperties.Name="Use the theme's own accent" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasAccentContrastWarning}">
                                <fi:SymbolIcon Symbol="Warning" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbDangerBrush}" VerticalAlignment="Center" />
                                <TextBlock Classes="pbTextCaption" Text="Low contrast on this theme" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </pref:SettingsRow.SettingsContent>
                </pref:SettingsRow>

                <pref:SettingsRow Icon="Options" Title="Corners" Description="From square to round, for every card, button and dialog. The middle is the theme's own.">
                    <pref:SettingsRow.SettingsContent>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Slider Minimum="0" Maximum="100" Value="{Binding Corners}" Width="180" TickFrequency="5" IsSnapToTickEnabled="True"
                                    AutomationProperties.Name="Corners" AutomationProperties.HelpText="{Binding CornersText}" VerticalAlignment="Center" />
                            <TextBlock Classes="pbTextMeta" Text="{Binding CornersText}" MinWidth="88" VerticalAlignment="Center" />
                            <Button Classes="iconButton" Command="{Binding ResetCornersCommand}" AutomationProperties.Name="Theme's own corners"
                                    ToolTip.Tip="Theme's own corners">
                                <fi:SymbolIcon Symbol="ArrowUndo" FontSize="{StaticResource PbIconSizeXs}" />
                            </Button>
                        </StackPanel>
                    </pref:SettingsRow.SettingsContent>
                </pref:SettingsRow>

                <pref:SettingsRow Icon="TextFont" Title="Text size" Description="Scales all text. Icons and control heights stay the same.">
                    <pref:SettingsRow.SettingsContent>
                        <controls:SuggestBox IsStrict="True" Text="{Binding FontScaleText}" Suggestions="{x:Static vm:PersonalizeViewModel.FontScaleOptions}" Width="160"
                                             AutomationProperties.Name="Text size" />
                    </pref:SettingsRow.SettingsContent>
                </pref:SettingsRow>

                <!-- Moved here from the old FONT group: one value with the Preferences font setting. -->
                <pref:SettingsRow Icon="TextFont" Title="Body font" Description="The font for everything except headings." IsVisible="{Binding HasLinks}">
                    <pref:SettingsRow.SettingsContent>
                        <StackPanel Spacing="6">
                            <controls:SuggestBox IsStrict="True" Text="{Binding BodyFontText}" Suggestions="{Binding BodyFontOptions}" Width="220" HorizontalAlignment="Right"
                                                 AutomationProperties.Name="Body font" />
                            <TextBlock Classes="pbTextMeta" Text="The quick brown fox jumps over the lazy dog" FontFamily="{Binding BodyFontText}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </pref:SettingsRow.SettingsContent>
                </pref:SettingsRow>

                <pref:SettingsRow Icon="TextFont" Title="Heading font" Description="Titles and headings. The body font is set above.">
                    <pref:SettingsRow.SettingsContent>
                        <controls:SuggestBox IsStrict="True" Text="{Binding HeadingFontText}" Suggestions="{Binding HeadingFontOptions}" Width="220"
                                             AutomationProperties.Name="Heading font" />
                    </pref:SettingsRow.SettingsContent>
                </pref:SettingsRow>

                <pref:SettingsRow Icon="Sparkle" Title="Card depth" Description="The shadow under covers: none, the usual, or lifted.">
                    <pref:SettingsRow.SettingsContent>
                        <controls:SuggestBox IsStrict="True" Text="{Binding ElevationText}" Suggestions="{x:Static vm:PersonalizeViewModel.ElevationOptions}" Width="160"
                                             AutomationProperties.Name="Card depth" />
                    </pref:SettingsRow.SettingsContent>
                </pref:SettingsRow>

                <pref:SettingsRow Icon="Grid" Title="Sidebar selection" Description="How the selected sidebar row is marked: accent bar, rounded fill, or tint only.">
                    <pref:SettingsRow.SettingsContent>
                        <controls:SuggestBox IsStrict="True" Text="{Binding SidebarStyleText}" Suggestions="{x:Static vm:PersonalizeViewModel.SidebarStyleOptions}" Width="160"
                                             AutomationProperties.Name="Sidebar selection" />
                    </pref:SettingsRow.SettingsContent>
                </pref:SettingsRow>

                <pref:SettingsRow Icon="Accessibility" Title="Focus ring" Description="How wide the ring around a focused or hovered item is. Its strength is set below.">
                    <pref:SettingsRow.SettingsContent>
                        <controls:SuggestBox IsStrict="True" Text="{Binding FocusRingText}" Suggestions="{x:Static vm:PersonalizeViewModel.FocusRingOptions}" Width="160"
                                             AutomationProperties.Name="Focus ring" />
                    </pref:SettingsRow.SettingsContent>
                </pref:SettingsRow>

                <!-- Moved here from Cover cosmetics ("Accent glow"): one value with the glow tier. Width is the Focus ring row above, strength is this one. -->
                <pref:SettingsRow Icon="Color" Title="Ring strength" Description="How strongly a hovered or focused item glows. Normal is the default look." IsVisible="{Binding HasLinks}">
                    <pref:SettingsRow.SettingsContent>
                        <controls:SuggestBox IsStrict="True" Text="{Binding RingStrengthText}" Suggestions="{Binding RingStrengthOptions}" Width="160"
                                             AutomationProperties.Name="Ring strength" />
                    </pref:SettingsRow.SettingsContent>
                </pref:SettingsRow>
                <ItemsControl ItemsSource="{Binding RingSamples}" Margin="12,4,0,0" IsVisible="{Binding HasLinks}" AutomationProperties.AutomationId="GlowTierSamples">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="12" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:GlowTierSample">
                            <StackPanel Spacing="4" Width="64" AutomationProperties.Name="{Binding Label}">
                                <Border Width="44" Height="60" Margin="8" CornerRadius="{DynamicResource PbRadiusSm}"
                                        Background="{DynamicResource PbSurface2Brush}" BoxShadow="{Binding Shadow}" />
                                <TextBlock Classes="pbTextMeta" Text="{Binding Label}" HorizontalAlignment="Center" />
                                <Border Height="2" Width="24" CornerRadius="1" Background="{DynamicResource PbAccentBrush}" IsVisible="{Binding IsActive}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </Grid>
    </StackPanel>
</UserControl>
