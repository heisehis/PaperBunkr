<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:views="using:Paperbunkr.App.Views"
             xmlns:metadata="using:Paperbunkr.Data.Metadata"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="320"
             x:Class="Paperbunkr.App.Views.CoverPickerView"
             x:DataType="vm:CoverPickerViewModel"
             x:Name="Root">

    <!--
        Cover picker flyout content (docs/superpowers/specs/2026-09-17-reader-save-page-and-cover-
        picker-design.md) - embedded inside a Button.Flyout at each of the 3 "Change/Set Cover…"
        entry points. 3 tabs: Browse File (today's only option, unchanged), From Series, From
        Reading List. Tab-active state is 3 plain bools (IsXxxTabActive), same shape as
        LibrarySection's own Folders/Maintenance 2-tab toggle - no converter class needed.
    -->
    <UserControl.Styles>
        <Style Selector="Button.coverCandidate">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusSm}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.coverCandidate:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
        </Style>
    </UserControl.Styles>

    <!-- Shown in a Flyout, whose presenter is already the floating-panel card: no second card here (audit shot 5). -->
    <Border Width="460">
        <StackPanel Spacing="10">
            <!-- Equal-width segments in one row so every tab fits; a hidden "External" tab takes no cell. -->
            <Border Classes="segGroup" HorizontalAlignment="Stretch">
            <UniformGrid Rows="1" ColumnSpacing="2">
                <Button Classes="segItem" Classes.active="{Binding IsBrowseFileTabActive}"
                        Content="Browse File" HorizontalAlignment="Stretch" Command="{Binding ShowBrowseFileTabCommand}" />
                <Button Classes="segItem" Classes.active="{Binding IsSeriesTabActive}"
                        Content="From Series" HorizontalAlignment="Stretch" Command="{Binding ShowSeriesTabCommand}" />
                <Button Classes="segItem" Classes.active="{Binding IsReadingListTabActive}"
                        Content="Reading List" HorizontalAlignment="Stretch" Command="{Binding ShowReadingListTabCommand}" />
                <Button Classes="segItem" Classes.active="{Binding IsExternalProviderTabActive}"
                        Content="External" HorizontalAlignment="Stretch" Command="{Binding ShowExternalProviderTabCommand}"
                        IsVisible="{Binding HasExternalProviderTab}" />
            </UniformGrid>
            </Border>

            <!-- Browse File -->
            <StackPanel Spacing="8" IsVisible="{Binding IsBrowseFileTabActive}">
                <TextBlock Text="Choose an image file from disk." FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" TextWrapping="Wrap" />
                <Button Classes="primary" Content="Browse…" Command="{Binding BrowseFileCommand}" HorizontalAlignment="Left" />
                <Button Classes="ghost" Content="Reset to series cover" Command="{Binding ResetCoverCommand}"
                        IsVisible="{Binding IsSeriesTarget}" HorizontalAlignment="Left" />
            </StackPanel>

            <!-- From Series -->
            <StackPanel Spacing="8" IsVisible="{Binding IsSeriesTabActive}">
                <TextBlock Text="No other issues in this series have a cover yet." FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" TextWrapping="Wrap"
                           IsVisible="{Binding !HasSeriesCandidates}" />
                <ScrollViewer MaxHeight="380" IsVisible="{Binding HasSeriesCandidates}">
                    <ItemsControl ItemsSource="{Binding SeriesCandidates}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CoverPickerCandidate">
                                <Button Classes="coverCandidate" Width="64" Height="94" Margin="4"
                                        Command="{Binding #Root.((vm:CoverPickerViewModel)DataContext).SelectCandidateCommand}"
                                        CommandParameter="{Binding}" ToolTip.Tip="{Binding Label}">
                                    <Image views:AsyncCoverImage.SourceId="{Binding SourceKey}" Stretch="UniformToFill" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <!-- From Reading List -->
            <StackPanel Spacing="8" IsVisible="{Binding IsReadingListTabActive}">
                <TextBlock Text="No other issues in a shared reading list have a cover yet." FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" TextWrapping="Wrap"
                           IsVisible="{Binding !HasReadingListCandidates}" />
                <ScrollViewer MaxHeight="380" IsVisible="{Binding HasReadingListCandidates}">
                    <ItemsControl ItemsSource="{Binding ReadingListCandidates}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CoverPickerCandidate">
                                <Button AutomationProperties.Name="{Binding Label}" Classes="coverCandidate" Width="64" Height="94" Margin="4"
                                        Command="{Binding #Root.((vm:CoverPickerViewModel)DataContext).SelectCandidateCommand}"
                                        CommandParameter="{Binding}" ToolTip.Tip="{Binding Label}">
                                    <Image views:AsyncCoverImage.SourceId="{Binding SourceKey}" Stretch="UniformToFill" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <!-- From External Provider (MangaBaka's multi-cover archive) -->
            <StackPanel Spacing="8" IsVisible="{Binding IsExternalProviderTabActive}">
                <TextBlock Text="Loading covers…" FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}"
                           IsVisible="{Binding IsLoadingExternalProviderCandidates}" />
                <TextBlock Text="No covers found." FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}"
                           IsVisible="{Binding ShowNoExternalProviderCandidatesMessage}" />
                <ScrollViewer MaxHeight="380" IsVisible="{Binding HasExternalProviderCandidates}">
                    <ItemsControl ItemsSource="{Binding ExternalProviderCandidates}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="metadata:CoverCandidate">
                                <Button AutomationProperties.Name="{Binding Source}" Classes="coverCandidate" Width="64" Height="94" Margin="4"
                                        Command="{Binding #Root.((vm:CoverPickerViewModel)DataContext).SelectExternalCandidateCommand}"
                                        CommandParameter="{Binding}" ToolTip.Tip="{Binding Source}">
                                    <Image views:RemoteThumbnailImage.SourceUrl="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
