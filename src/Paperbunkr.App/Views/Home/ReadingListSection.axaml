<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fi="using:FluentIcons.Avalonia"
                    xmlns:home="using:Paperbunkr.App.ViewModels.Home"
                    xmlns:controls="using:Paperbunkr.App.Controls">

    <!-- Try This Reading List - unchanged content, now a movable section (docs/superpowers/specs/2026-09-28-home-improvements-design.md I1). -->
    <DataTemplate x:Key="HomeSection.readingList" DataType="home:ReadingListSectionViewModel">
        <StackPanel Spacing="12" controls:ScrollReveal.Enabled="True">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <fi:SymbolIcon Classes="sectionIcon" Symbol="{Binding Icon}" />
                <controls:SplitText Classes="heading" Text="{Binding Title}" AutomationProperties.AutomationId="{Binding HeaderAutomationId}" />
            </StackPanel>
            <Button Classes="spotlightCard" IsVisible="{Binding Home.HasReadingListSpotlight}"
                    Command="{Binding Home.OpenReadingListSpotlightCommand}" AutomationProperties.AutomationId="HomeReadingListSpotlightCard">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Grid.Column="0" Classes="spotlightCover" Background="{Binding Home.ReadingListSpotlight.CoverBrush}">
                        <Image Source="{Binding Home.ReadingListSpotlight.CoverImage}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="22,0" Spacing="6">
                        <TextBlock Text="{Binding Home.ReadingListSpotlight.Name}" Classes="pbTextHeading" FontSize="24" />
                        <TextBlock Text="{Binding Home.ReadingListSpotlight.Synopsis}" FontSize="12.5"
                                   Foreground="{DynamicResource PbTextMutedBrush}" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Home.ReadingListSpotlight.Tags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Classes="pbChip" Margin="0,4,6,0">
                                        <TextBlock Text="{Binding}" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PbAccentTextBrush}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Start the list →" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"
                                   Foreground="{DynamicResource PbAccentTextBrush}" />
                    </StackPanel>
                </Grid>
            </Button>
            <TextBlock Text="No reading lists with anything left to read" Classes="emptyState" IsVisible="{Binding !Home.HasReadingListSpotlight}" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
