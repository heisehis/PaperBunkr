<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Paperbunkr.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="340"
        x:Class="Paperbunkr.App.Views.SplashWindow"
        x:DataType="vm:SplashViewModel"
        Title="Paperbunkr"
        Width="480" Height="340"
        CanResize="False"
        SystemDecorations="None"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="None"
        Background="#0A0B0D">

    <!--
        Shown first from App.axaml.cs while the heavy startup work runs on a background thread
        (docs/superpowers/specs/2026-09-09-startup-onboarding-whats-new-design.md, Decision 2).
        Background is the literal brand dark - renders before SkinService has necessarily run.

        Keyframe Animation on a transform must animate the transform's SUB-properties
        (ScaleTransform.ScaleX/Y) against an explicit <ScaleTransform>, per the Avalonia docs -
        animating RenderTransform directly ("scale(...)") has no registered animator in this build
        and crashes at construction. Same keyframe-Animation shape as StatusBar's IndicatorPulse.
        Reduced motion: code-behind removes the ".animate" class, deactivating these animation
        styles, and snaps Opacity to 1.
    -->
    <Window.Styles>
        <!-- Emblem: entrance (fade + scale-up from 0.86, once) then a slow breathing pulse.
             The ".animate" class is on the element by default; code-behind removes it (and snaps
             Opacity to 1) under reduced motion, which deactivates these animation styles. -->
        <Style Selector="Image#LogoImage.animate">
            <Style.Animations>
                <Animation Duration="0:0:0.55" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="ScaleTransform.ScaleX" Value="0.86" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.86" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                    </KeyFrame>
                </Animation>
                <Animation Duration="0:0:2.6" IterationCount="Infinite" PlaybackDirection="Alternate"
                           Easing="SineEaseInOut" Delay="0:0:0.55">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.045" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1.045" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Glow: opacity breathing, in sync with the emblem. -->
        <Style Selector="Border#GlowBorder.animate">
            <Style.Animations>
                <Animation Duration="0:0:2.6" IterationCount="Infinite" PlaybackDirection="Alternate"
                           Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.4" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.78" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto,Auto,*">
        <Panel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,28">
            <Border x:Name="GlowBorder" Classes="animate" Width="190" Height="190" Opacity="0.4">
                <Border.Background>
                    <RadialGradientBrush GradientOrigin="50%,50%" Center="50%,50%" RadiusX="50%" RadiusY="50%">
                        <GradientStop Color="#8CC9803F" Offset="0" />
                        <GradientStop Color="#00C9803F" Offset="0.72" />
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <Image x:Name="LogoImage" Classes="animate" Width="122" Height="122" Opacity="0"
                   RenderTransformOrigin="50%,50%"
                   Source="avares://Paperbunkr.App/Assets/paperbunkr-logo-source.png">
                <Image.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Image.RenderTransform>
            </Image>
        </Panel>

        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Spacing="14">
            <ProgressBar Width="240" Height="3" Minimum="0" Maximum="1"
                         Value="{Binding Progress}"
                         Background="#25252B" CornerRadius="2" ShowProgressText="False">
                <ProgressBar.Foreground>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Color="#B06A2E" Offset="0" />
                        <GradientStop Color="#D9A441" Offset="1" />
                    </LinearGradientBrush>
                </ProgressBar.Foreground>
            </ProgressBar>
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#8A8F98"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <TextBlock Grid.Row="3" Text="{Binding VersionText}"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,15,13"
                   FontSize="10.5" Foreground="#565B64" />
    </Grid>
</Window>
