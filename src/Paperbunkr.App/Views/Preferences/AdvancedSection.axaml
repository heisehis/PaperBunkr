<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:models="using:Paperbunkr.App.Models"
             xmlns:pref="using:Paperbunkr.App.Views.Preferences"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="900"
             x:Class="Paperbunkr.App.Views.Preferences.AdvancedSection"
             x:DataType="vm:PreferencesScreenViewModel">

    <UserControl.Styles>
        <!-- Advanced redesign (docs/superpowers/specs/2026-09-08-advanced-backup-file-association-
             redesign-design.md) - Restore's armed "Confirm restore?" state gets the same danger-soft
             recipe every other destructive-action confirm this session uses. -->
        <Style Selector="Button.restoreArmed">
            <Setter Property="BorderBrush" Value="{DynamicResource PbDangerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbDangerBrush}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="28,20,28,40" Spacing="20">
            <TextBlock Classes="pbTextHeading" Text="Advanced" />

        <StackPanel Tag="advanced.rendering">
            <TextBlock Classes="settingsGroupCaption" Text="RENDERING" />
            <pref:SettingsRow Icon="DeveloperBoard" Title="Graphics backend"
                               Description="Auto uses the GPU with a software fallback (recommended). Gpu forces the GPU with no fallback — the app may fail to start on a broken driver. Software forces the CPU renderer, for broken GPUs, remote desktop, or VMs.">
                <pref:SettingsRow.SettingsContent>
                    <ComboBox ItemsSource="{x:Static vm:PreferencesScreenViewModel.RenderBackendOptions}"
                              SelectedItem="{Binding RenderingBackend}" Width="150" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
            <pref:SettingsRow Icon="Cube" Title="Prefer native OpenGL over ANGLE"
                               Description="Only try this if the GPU renderer misbehaves — ANGLE (Direct3D) is the better default on Windows.">
                <pref:SettingsRow.SettingsContent>
                    <ToggleSwitch IsChecked="{Binding PreferNativeOpenGl}" OnContent="{x:Null}" OffContent="{x:Null}" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
            <TextBlock Text="Changes take effect after restarting Paperbunkr." FontSize="11.5"
                       Foreground="{DynamicResource PbTextFaintBrush}" FontStyle="Italic" Margin="0,-6,0,0" />
        </StackPanel>

        <!-- File Association (docs/superpowers/specs/2026-09-08-advanced-backup-file-association-
             redesign-design.md) - ToggleSwitch for consistency with every other boolean setting in
             Preferences (this was the one remaining CheckBox), plus a generic document icon (per-
             format branding isn't feasible - see the design doc's investigation). -->
        <StackPanel Tag="advanced.fileAssociation">
            <TextBlock Classes="settingsGroupCaption" Text="FILE ASSOCIATION" />
            <ItemsControl x:Name="FileAssociationsList" ItemsSource="{Binding FileAssociations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:FileAssociationSummary">
                        <Button Classes="sideItemButton" HorizontalAlignment="Stretch"
                                Command="{Binding #FileAssociationsList.((vm:PreferencesScreenViewModel)DataContext).ToggleFileAssociationCommand}"
                                CommandParameter="{Binding}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="7" Background="{DynamicResource PbSurface3Brush}">
                                    <fi:SymbolIcon Symbol="Document" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbTextMutedBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource PbTextBrush}" />
                                    <TextBlock Text="{Binding ExtensionList}" FontSize="11" FontFamily="Consolas,monospace"
                                               Foreground="{DynamicResource PbTextFaintBrush}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2" IsChecked="{Binding IsAssociated, Mode=OneWay}" IsHitTestVisible="False"
                                              OnContent="{x:Null}" OffContent="{x:Null}" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Tag="advanced.fileMetadata">
            <TextBlock Classes="settingsGroupCaption" Text="COMIC FILE METADATA" />
            <pref:SettingsRow Icon="DocumentData" Title="Write metadata changes into comic files"
                               Description="When on, edits you make in Paperbunkr are written back into each comic's embedded ComicInfo.xml. This modifies your original files in place. CBZ, CB7, CBT and image folders can be written; CBR/RAR, PDF and DjVu can't.">
                <pref:SettingsRow.SettingsContent>
                    <ToggleSwitch IsChecked="{Binding WriteMetadataToFiles}" OnContent="{x:Null}" OffContent="{x:Null}" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
            <pref:SettingsRow Icon="ArrowSync" Title="Write automatically after every edit"
                               Description="Off: files are only written when you choose &quot;Write metadata to files&quot; from a comic's right-click menu or the button below."
                               IsEnabled="{Binding WriteMetadataToFiles}">
                <pref:SettingsRow.SettingsContent>
                    <ToggleSwitch IsChecked="{Binding WriteMetadataAutomatically}" OnContent="{x:Null}" OffContent="{x:Null}" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
            <pref:SettingsRow Icon="DocumentDatabase" Title="Also write a paperbunkr.json sidecar"
                               Description="Keeps Paperbunkr-specific details that ComicInfo.xml has no field for — tag categories and weights, your personal rating, review, and collection notes."
                               IsEnabled="{Binding WriteMetadataToFiles}">
                <pref:SettingsRow.SettingsContent>
                    <ToggleSwitch IsChecked="{Binding WriteNativeSidecar}" OnContent="{x:Null}" OffContent="{x:Null}" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
            <pref:SettingsRow Icon="Save" Title="Write all library metadata to files now"
                               Description="{Binding WriteAllMetadataStatus}">
                <pref:SettingsRow.SettingsContent>
                    <Button Classes="headerAction primary" Command="{Binding WriteAllMetadataToFilesCommand}"
                            IsEnabled="{Binding WriteMetadataToFiles}" Content="Write Now…" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
        </StackPanel>

        <!-- Backup Manager (docs/superpowers/specs/2026-09-08-advanced-backup-file-association-
             redesign-design.md) - the 5 fixed fields below are each a small, known-at-authoring-time
             row (the same dividing line Phase 1 itself drew), so they became real SettingsRows; only
             the backup-file list itself stays a dynamic repeater. -->
        <StackPanel Tag="advanced.backup">
            <TextBlock Classes="settingsGroupCaption" Text="BACKUP" />

            <pref:SettingsRow Icon="FolderOpen" Title="Backup location">
                <pref:SettingsRow.SettingsContent>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBox Text="{Binding BackupLocation}" Width="280" IsReadOnly="True" />
                        <Button Classes="headerAction ghost" Command="{Binding BrowseBackupLocationCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <fi:SymbolIcon Symbol="FolderOpen" FontSize="{StaticResource PbIconSizeXs}" />
                                <TextBlock Text="Browse…" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>

            <pref:SettingsRow Icon="Archive" Title="Backups to keep">
                <pref:SettingsRow.SettingsContent>
                    <NumericUpDown Value="{Binding BackupsToKeep}" Minimum="0" Maximum="99" Width="120" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>

            <pref:SettingsRow Icon="History" Title="Automatically back up on startup and shutdown">
                <pref:SettingsRow.SettingsContent>
                    <ToggleSwitch IsChecked="{Binding AutoBackupEnabled}" OnContent="{x:Null}" OffContent="{x:Null}" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>

            <pref:SettingsRow Icon="Clock" Title="Minimum hours between automatic backups" IsVisible="{Binding AutoBackupEnabled}">
                <pref:SettingsRow.SettingsContent>
                    <NumericUpDown Value="{Binding AutoBackupMinIntervalHours}" Minimum="1" Maximum="168" Width="120" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>

            <pref:SettingsRow Icon="Save" Title="Backup now" Description="{Binding BackupStatus}">
                <pref:SettingsRow.SettingsContent>
                    <Button Classes="headerAction primary" Command="{Binding BackupNowCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <fi:SymbolIcon Symbol="Archive" Foreground="{DynamicResource PbBadgeTextBrush}" />
                            <TextBlock Text="Backup Now" />
                        </StackPanel>
                    </Button>
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>

            <ItemsControl ItemsSource="{Binding Backups}" Margin="0,10,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BackupRowViewModel">
                        <Border Classes="skinRow">
                            <Grid ColumnDefinitions="*,Auto" Margin="14,10">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayDate}" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                                    <TextBlock Text="{Binding DisplaySize}" FontSize="11" Foreground="{DynamicResource PbTextFaintBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="headerAction ghost" Classes.restoreArmed="{Binding IsArmed}" Command="{Binding RestoreCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <fi:SymbolIcon Symbol="ArrowUndo" FontSize="{StaticResource PbIconSizeXs}" />
                                        <TextBlock Text="{Binding RestoreLabel}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Restoring a backup requires restarting Paperbunkr to take effect."
                       FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" Margin="0,8,0,0"
                       IsVisible="{Binding HasBackups}" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</UserControl>
