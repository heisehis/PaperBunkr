---
import '@fontsource/bebas-neue';
import '@fontsource-variable/source-serif-4';
import '../styles/global.css';
import { getLatestRelease, RELEASES_URL } from '../lib/release';
import { REPO_URL } from '../lib/content';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const release = await getLatestRelease();

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`${base}og-card.png`, Astro.site).href;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'PaperBunkr',
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Windows 10 or later',
  description,
  url: canonical,
  image: ogImage,
  ...(release.tag ? { softwareVersion: release.version } : {}),
  license: 'https://www.gnu.org/licenses/agpl-3.0.html',
  releaseNotes: release.htmlUrl,
  downloadUrl: release.installer?.url ?? `${RELEASES_URL}/latest`,
  codeRepository: REPO_URL,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0b0d" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="192x192" href={`${base}favicon-192.png`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PaperBunkr" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
