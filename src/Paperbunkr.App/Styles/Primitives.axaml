<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Component primitives (docs/superpowers/specs/2026-08-24-design-language-foundation-design.md
        Component Primitives section). Implemented as style classes rather than literal Avalonia
        ControlTheme records - these are new visual treatments for existing control types
        (Button/Border), not template overrides of a control with its own default template, so a
        plain Style is the right tool. PosterTile (the one primitive with real content slots -
        cover/title/badge/progress) is a UserControl instead - see Views/PosterTile.axaml.
    -->

    <!-- Staggered grid/list item entrance (docs/superpowers/specs/2026-09-07-chrome-content-motion-
         polish-design.md item 1) - Controls/EntranceAnimation.cs adds "entranceReady" only to
         containers actually participating in a given entrance, then "entered" after that
         container's computed per-index delay. A container this never touches is untagged and
         therefore always fully visible - the initial hidden/offset state below only ever applies to
         a container that's about to be animated in. -->
    <!-- Keyboard focus ring, app-wide: Paperbunkr's glow ring (PbGlowRing, so it follows the glow-tier setting and the skin) replaces the
         theme's white/black focus frame on every control. The outer Border is inflated 16px past the control (room for the Vivid tier's 12px halo) so the ring paints inside the
         adorner's own bounds - Avalonia only repaints inside a visual's bounds, so a ring painted outside them shows partly or not at all
         (the Library/Home lesson, 2026-09-26 and 2026-09-29). Controls with a ring of their own set FocusAdorner to null locally, which beats
         this style. -->
    <Style Selector=":is(Control)">
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border Margin="-16" IsHitTestVisible="False">
                    <Border Margin="16" CornerRadius="{DynamicResource PbRadiusSm}" BoxShadow="{DynamicResource PbGlowRing}" />
                </Border>
            </FocusAdornerTemplate>
        </Setter>
    </Style>

    <!-- A plain ItemsControl clips to its bounds by default, which cuts the focus ring off every item along its edges (the first tile
         of a Home shelf, the first card of a grid, a chip row). Nothing relies on that clip - scrolling lists (ListBox etc.) have their
         own ScrollViewer, which still clips - so plain ItemsControls don't clip. -->
    <Style Selector="ItemsControl">
        <Setter Property="ClipToBounds" Value="False" />
    </Style>

    <Style Selector="Control.entranceReady:not(.entered)">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="RenderTransform" Value="translateY(8px)" />
    </Style>
    <Style Selector="Control.entranceReady">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="{DynamicResource PbMotionStandard}" Easing="{StaticResource PbMotionEase}" />
                <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource PbMotionStandard}" Easing="{StaticResource PbMotionEase}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Control.entranceReady.entered">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="RenderTransform" Value="none" />
    </Style>

    <!-- Discard-changes / tour-offer modal fade+scale (docs/superpowers/specs/2026-09-07-chrome-
         content-motion-polish-design.md item 4) - these two are the only remaining overlays still on
         the old hand-copied Border/#B0000000 pattern (everything else migrated to OverlayShell,
         which has no animation of its own either - not reused here to avoid silently animating every
         other OverlayShell consumer app-wide, a bigger blast radius than this item scoped for). -->
    <Style Selector="Border.modalScrim">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="{DynamicResource PbMotionFast}" Easing="{StaticResource PbMotionEase}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.modalScrim.open">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- A closed modal is only faded out, not removed, so its buttons stayed Tab stops and directional-move targets. Disabled while closed. -->
    <Style Selector="Border.modalScrim:not(.open)">
        <Setter Property="IsEnabled" Value="False" />
    </Style>
    <Style Selector="Border.modalCard">
        <Setter Property="RenderTransform" Value="scale(0.96)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource PbMotionFast}" Easing="{StaticResource PbMotionEase}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.modalScrim.open Border.modalCard">
        <Setter Property="RenderTransform" Value="scale(1)" />
    </Style>

    <!-- Button variants - replace default FluentTheme button chrome with Pb* tokens + motion. -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource PbAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource PbBadgeTextBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusSm}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="{DynamicResource PbMotionFast}" Easing="{StaticResource PbMotionEase}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.primary:pointerover">
        <Setter Property="Background" Value="{DynamicResource PbAccentTextBrush}" />
    </Style>

    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusSm}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="{DynamicResource PbMotionFast}" Easing="{StaticResource PbMotionEase}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.secondary:pointerover">
        <Setter Property="Background" Value="{DynamicResource PbSurface3Brush}" />
    </Style>

    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusSm}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="{DynamicResource PbMotionFast}" Easing="{StaticResource PbMotionEase}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.ghost:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
    </Style>

    <!-- Text link - a flat, chrome-less button that reads as an inline link (faint text at rest,
         accent on hover). Used for the "what's new" / "full changelog" links on the first-look
         overlays; replaces per-view local "skipLink"-style copies. -->
    <Style Selector="Button.linkText">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource PbTextFaintBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="{DynamicResource PbMotionFast}" Easing="{StaticResource PbMotionEase}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.linkText:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.linkText:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource PbAccentBrush}" />
    </Style>

    <!-- A link inside MarkdownView's running text (docs/superpowers/specs/2026-09-26-about-polish-design.md §2): the control sets
         its own accent foreground and underline, so this only strips the Fluent button chrome on hover/press and dims on press. -->
    <Style Selector="Button.mdLink:pointerover /template/ ContentPresenter, Button.mdLink:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.mdLink:pressed">
        <Setter Property="Opacity" Value="0.7" />
    </Style>

    <!-- Chip/pill - generalizes the pattern already established in Views/DetailPills.axaml. Two
         separate selectors (not a comma-list) since Border and Button share no common base type
         with Background/BorderBrush/CornerRadius/Padding declared on it. -->
    <Style Selector="Border.pbChip">
        <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PbRadiusChip}" />
        <Setter Property="Padding" Value="12,5" />
    </Style>
    <Style Selector="Button.pbChip">
        <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PbRadiusChip}" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="{DynamicResource PbMotionFast}" Easing="{StaticResource PbMotionEase}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.pbChip:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource PbBadgeBrush}" />
    </Style>

    <!-- Reader background texture picker swatches (docs/superpowers/specs/2026-09-10-reader-
         backlog-batch-b-design.md Item 1) - a clickable Button chrome around a filled preview
         Border, active state shown as an accent ring rather than color alone (a11y: never convey
         state by color alone). -->
    <Style Selector="Button.textureSwatch">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="{DynamicResource PbMotionFast}" Easing="{StaticResource PbMotionEase}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.textureSwatch.active">
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
    </Style>
    <Style Selector="Border.textureSwatchFill">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="38" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!--
        FloatingPanel chrome - the shared outer container for overlay-style views (design doc's
        FloatingPanel migration: ReadingListPropertiesOverlay, IssuePropertiesScreen,
        BulkIssuePropertiesScreen, QuickRateOverlay, MigrationOverlay all apply this class to their
        root Border in place of their previous ad-hoc Background/CornerRadius/BorderThickness).
        PbElevationShadow is genuine depth (always-on), distinct from the glow-ring hover/focus
        treatment PosterTile uses.
    -->
    <Styles.Resources>
        <BoxShadows x:Key="PbElevationShadow">0 16 40 -8 #99000000</BoxShadows>
        <!-- Design-time/pre-ThemeService-apply fallback only (matches default skin's PbGlowColor,
             bumped to 0x99 alpha) - at runtime, ThemeService.ApplyGlowRing overwrites this same key
             in Application.Resources on every theme apply (BoxShadows is parsed from a single string
             and can't embed {DynamicResource PbGlowColor} inside it, so it's rebuilt in code instead
             of bound in markup - see ApplyGlowRing's own doc comment). Every consumer below must use
             {DynamicResource PbGlowRing}, not {StaticResource}, to pick up the runtime overwrite.
             Spread is 4px, alpha 0x99 - bumped from an earlier 2px/0x66 pass once ClipToBounds was
             fixed so this actually rendered at all (see LibraryScreen.axaml's own doc comment); the
             fainter version read as invisible against a card's own drop shadow at typical viewing
             distance. -->
        <BoxShadows x:Key="PbGlowRing">0 0 0 4 #99E0995A</BoxShadows>
        <!-- Fixed Normal-tier twin of PbGlowRing for non-hover consumers (reader bookmark pulse) - the
             glow-tier setting only changes PbGlowRing. Overwritten at runtime by ThemeService.ApplyGlowRing. -->
        <BoxShadows x:Key="PbGlowPulseRing">0 0 0 4 #99E0995A</BoxShadows>
        <!-- Inside twin of PbGlowRing for controls their own container clips (a segmented control's pill). Overwritten at runtime by
             ThemeService.ApplyGlowRing / ApplyGlowTier. -->
        <BoxShadows x:Key="PbGlowRingInset">inset 0 0 0 2 #99E0995A</BoxShadows>
    </Styles.Resources>

    <!-- PosterTile - see Views/PosterTile.axaml. Root there is a Border (not Button) specifically
         so BoxShadow (needed for the glow ring) is unambiguously supported. Cover-forward restyle
         (docs/superpowers/specs/2026-08-28-home-screen-redesign-design.md §4): the root is now
         transparent - no panel - and the drop shadow + glow ring live on the inner .posterCover
         so they wrap the art, not the caption text below it. -->
    <Style Selector="Border.posterTile">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <!-- Real bug found 2026-09-03 (see LibraryScreen.axaml's own Border.posterCover style for the
         full diagnosis): this class-scoped style matches LibraryScreen.axaml's cards too (same
         "posterCover" class, reused across screens), so removing the equivalent BoxShadowsTransition
         there alone didn't fix anything - this global copy was still animating the exact same
         property on the exact same elements. Animating BoxShadow raced the compositor's per-frame
         invalidation of the shadow's growing overflow beyond this Border's own bounds, showing a
         torn/incomplete ring for the ~150ms of PbMotionFast on every focus/hover change - self-
         healing only once the transition settled, which reads as permanently broken under fast
         keyboard navigation. Removed here too so PosterTile (Home) doesn't carry the same latent
         defect even though it wasn't the one reported. -->
    <Style Selector="Border.posterCover">
        <Setter Property="BoxShadow" Value="0 6 18 -4 #80000000" />
    </Style>
    <Style Selector="Border.posterTile:pointerover Border.posterCover">
        <Setter Property="BoxShadow" Value="0 6 18 -4 #80000000, 0 0 0 2 #66E0995A" />
    </Style>
    <Style Selector="Border.posterTile:focus-visible Border.posterCover">
        <Setter Property="BoxShadow" Value="0 6 18 -4 #80000000, 0 0 0 2 #66E0995A" />
    </Style>

    <!-- Kinetic Rail hover treatment (docs/superpowers/specs/2026-09-08-home-navrail-visual-v2-
         design.md §6), scoped to Home's own cards via the "shelfCard" class PosterTile.axaml adds to
         itself - Library's separately-authored card templates share the plain "posterTile"/
         "posterCover" class names above but never get "shelfCard", so this doesn't touch them.
         BoxShadow stays un-transitioned deliberately (see the "Real bug found 2026-09-03" comment
         above this block) - only the widened ring VALUE changes, no animation added to it. The
         scale-pop is a separate RenderTransform, unaffected by that bug since it's a different
         property/compositor path. -->
    <!-- Home pitch (docs/superpowers/specs/2026-09-28-home-cosmetics-design.md, "Card hover and shadow"): Home's cards get the
         landing site's deeper resting shadow. Still static - only the value differs per state, nothing transitions it. -->
    <Style Selector="Border.posterTile.shelfCard Border.posterCover">
        <Setter Property="BoxShadow" Value="0 14 34 0 #66000000" />
    </Style>
    <!-- Hover keeps its faint accent edge; keyboard focus gets the full PbGlowRing on the tileRing overlay (PosterTile.axaml), so a hovered
         tile and the keyboard-focused tile never look the same. -->
    <Style Selector="Border.posterTile.shelfCard:pointerover Border.posterCover">
        <Setter Property="BoxShadow" Value="0 14 34 0 #66000000, 0 0 0 4 #66E0995A" />
    </Style>
    <Style Selector="Border.tileRing">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.posterTile.shelfCard:focus-visible Border.tileRing">
        <Setter Property="IsVisible" Value="True" />
        <Setter Property="BoxShadow" Value="{DynamicResource PbGlowRing}" />
    </Style>
    <!-- Because-You-Read lead card (C8): an accent outline on the seed series' cover. -->
    <Style Selector="Border.posterCover.outlined">
        <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <!-- "NEW" ribbon (C5). -->
    <Style Selector="Border.newRibbon">
        <Setter Property="Background" Value="{DynamicResource PbAccentBrush}" />
        <Setter Property="Padding" Value="0,2" />
    </Style>
    <!-- "Not interested" ✕ (I5): only shows while the card is hovered or keyboard-focused. -->
    <Style Selector="Button.posterDismiss">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource PbRadiusChip}" />
        <Setter Property="Background" Value="#B3000000" />
        <Setter Property="Foreground" Value="#F0ECE7DB" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Border.posterTile:pointerover Button.posterDismiss, Border.posterTile:focus-within Button.posterDismiss">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.posterTile.shelfCard">
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource PbMotionFast}" Easing="{StaticResource PbMotionEase}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.posterTile.shelfCard:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.02)" />
    </Style>
    <Style Selector="Border.posterTile.shelfCard:focus-visible">
        <Setter Property="RenderTransform" Value="scale(1.02)" />
    </Style>

    <!-- Insights Today-tab hero row (docs/superpowers/specs/2026-09-23-insights-redesign-design.md) -
         the three actionable "needs your attention" tiles (goal, continue-reading, recommendation).
         Same glow-tier hover/focus language as Border.posterCover above, applied directly to the card
         itself (not a nested cover Border) since these tiles mix cover art with text/numerals rather
         than being pure cover-forward cards. Deliberately its own class rather than reusing
         posterTile/shelfCard - those are chromed/sized for grid cards elsewhere (Home/Library), not a
         3-across hero row - but the BoxShadow itself is never transitioned, for the same reason
         documented on Border.posterCover above (animating it tears the ring mid-transition).
         Deliberately NOT Focusable itself in the two tiles that hold a real Button (Continue,
         Recommendation) - the Button is the actual interactive element and already gets Avalonia's
         own default focus ring, so making the wrapping Border focusable too would add a second,
         inert tab-stop (review-checklist accessibility catch, 2026-09-23: focus must land only on
         genuinely interactive elements). The :pointerover rule below still applies while hovering the
         inner Button, since pointerover naturally reaches ancestors; :focus-visible is kept here only
         for a future heroTile that's directly clickable with no nested control. -->
    <Style Selector="Border.heroTile">
        <Setter Property="Background" Value="{DynamicResource PbSurface1Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource PbRadius}" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BoxShadow" Value="0 6 18 -4 #80000000" />
    </Style>
    <Style Selector="Border.heroTile:pointerover">
        <Setter Property="BoxShadow" Value="0 6 18 -4 #80000000, 0 0 0 2 #66E0995A" />
    </Style>
    <Style Selector="Border.heroTile:focus-visible">
        <Setter Property="BoxShadow" Value="0 6 18 -4 #80000000, 0 0 0 2 #66E0995A" />
    </Style>

    <!-- Poster cover scrim (docs/superpowers/specs/2026-08-27-library-browsing-4a-poster-grid-
         design.md) - a soft bottom fade on cover art: slight at rest for a consistent finished
         edge + badge legibility, stronger when the card is hovered/focused. Shared class so both
         PosterTile (Home) and the Library grid templates use one definition. Sits inside the
         clipped cover Border, never intercepts clicks. -->
    <Style Selector="Border.posterScrim">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Opacity" Value="0.55" />
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0.45" Color="#00000000" />
                <GradientStop Offset="1.0" Color="#B3000000" />
            </LinearGradientBrush>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="{DynamicResource PbMotionFast}" Easing="{StaticResource PbMotionEase}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.posterTile:pointerover Border.posterScrim">
        <Setter Property="Opacity" Value="1.0" />
    </Style>
    <Style Selector="Border.posterTile:focus-visible Border.posterScrim">
        <Setter Property="Opacity" Value="1.0" />
    </Style>

    <Style Selector="Border.floatingPanel">
        <Setter Property="Background" Value="{DynamicResource PbSurface3Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusLg}" />
        <Setter Property="BoxShadow" Value="{StaticResource PbElevationShadow}" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="{DynamicResource PbMotionFast}" Easing="{StaticResource PbMotionEase}" />
            </Transitions>
        </Setter>
    </Style>
</Styles>
