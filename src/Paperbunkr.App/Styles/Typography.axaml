<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Paperbunkr.App.Controls">
    <!--
        Type scale (docs/superpowers/specs/2026-08-24-design-language-foundation-design.md
        Typography section). Hero/Heading use PbDisplayFontFamily (Bebas Neue) directly via
        StaticResource - a deliberate branded choice for hero/heading moments, never overridden by
        the Preferences font picker. Body/Caption inherit the app-wide {DynamicResource PbFontFamily}
        default already set on TextBlock in App.axaml, so they don't need to set FontFamily
        themselves - only size/weight/color differ.

        SplitText (docs/superpowers/specs/2026-08-28-home-screen-redesign-design.md §5) is the
        RGB-misregistration display treatment - its implicit ControlTheme lives here since it is,
        in effect, a fourth entry in the type scale.
    -->
    <Styles.Resources>
        <ControlTheme x:Key="{x:Type controls:SplitText}" TargetType="controls:SplitText">
            <Setter Property="FontFamily" Value="{DynamicResource PbDisplayFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource PbFontSizeHeading}" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <TextBlock Name="PART_Red" Text="{TemplateBinding Text}" IsHitTestVisible="False"
                                   FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}" LineHeight="{TemplateBinding FontSize}"
                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                   Foreground="#FFFF2E3A" Opacity="0.5" RenderTransform="translateX(-1px)">
                            <TextBlock.Transitions>
                                <Transitions>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource PbMotionFast}" Easing="{StaticResource PbMotionEase}" />
                                </Transitions>
                            </TextBlock.Transitions>
                        </TextBlock>
                        <TextBlock Name="PART_Cyan" Text="{TemplateBinding Text}" IsHitTestVisible="False"
                                   FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}" LineHeight="{TemplateBinding FontSize}"
                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                   Foreground="#FF25C8FF" Opacity="0.5" RenderTransform="translateX(1px)">
                            <TextBlock.Transitions>
                                <Transitions>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource PbMotionFast}" Easing="{StaticResource PbMotionEase}" />
                                </Transitions>
                            </TextBlock.Transitions>
                        </TextBlock>
                        <TextBlock Name="PART_Main" Text="{TemplateBinding Text}"
                                   FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}" LineHeight="{TemplateBinding FontSize}"
                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                   Foreground="{TemplateBinding Foreground}" />
                    </Panel>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:pointerover /template/ TextBlock#PART_Red">
                <Setter Property="RenderTransform" Value="translateX(-2px)" />
            </Style>
            <Style Selector="^:pointerover /template/ TextBlock#PART_Cyan">
                <Setter Property="RenderTransform" Value="translateX(2px)" />
            </Style>
        </ControlTheme>
    </Styles.Resources>

    <!-- Theme typography roles (docs/superpowers/specs/2026-10-12-theme-system-v2-gap-analysis-and-plan.md, phase 3): the display and heading
         families, sizes and weights are written by ThemeService from the theme (defaults: Bebas Neue, 42 / 22, Normal), so they are
         DynamicResource. Line height follows the size, as it always did. -->
    <Style Selector="TextBlock.pbTextHero">
        <Setter Property="FontFamily" Value="{DynamicResource PbDisplayFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource PbFontSizeHero}" />
        <Setter Property="LineHeight" Value="{DynamicResource PbFontSizeHero}" />
        <Setter Property="FontWeight" Value="{DynamicResource PbDisplayFontWeight}" />
        <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
    </Style>

    <Style Selector="TextBlock.pbTextHeading">
        <Setter Property="FontFamily" Value="{DynamicResource PbHeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource PbFontSizeHeading}" />
        <Setter Property="LineHeight" Value="{DynamicResource PbFontSizeHeading}" />
        <Setter Property="FontWeight" Value="{DynamicResource PbHeadingFontWeight}" />
        <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
    </Style>

    <Style Selector="TextBlock.pbTextBody">
        <Setter Property="FontSize" Value="{DynamicResource PbFontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
    </Style>

    <Style Selector="TextBlock.pbTextCaption">
        <Setter Property="FontSize" Value="{DynamicResource PbFontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
    </Style>

    <!-- 2026-10-19 foundation roles (docs/superpowers/specs/2026-10-19-ui-polish-foundation-design.md §1). Secondary text is muted, never
         faint: faint measures 3.1-3.8:1 on surface2 in most themes, too dim to read (§3). -->
    <Style Selector="TextBlock.pbTextTitle">
        <Setter Property="FontSize" Value="{DynamicResource PbFontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
    </Style>

    <Style Selector="TextBlock.pbTextSection">
        <Setter Property="FontSize" Value="{DynamicResource PbFontSizeSection}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
    </Style>

    <Style Selector="TextBlock.pbTextMeta">
        <Setter Property="FontSize" Value="{DynamicResource PbFontSizeMeta}" />
        <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
    </Style>

    <!-- Overline: small caps label above a group or field. The text itself is written in capitals (Avalonia has no text-transform). -->
    <Style Selector="TextBlock.pbTextOverline">
        <Setter Property="FontSize" Value="{DynamicResource PbFontSizeMicro}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="0.6" />
        <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
    </Style>

    <!-- Book-title modifier (docs/superpowers/specs/2026-10-27-books-section-redesign-design.md §1). Combine with a size class
         (pbTextBody / pbTextSection / pbTextHeading / pbTextHero); it only swaps the family to the fixed serif and sets SemiBold.
         It must stay after the size classes: equal specificity, so the later style wins. Hero and heading set LineHeight equal to
         the size, which suits Bebas caps but clips a serif's descenders on a wrapped title, so those two get their line height back. -->
    <Style Selector="TextBlock.bookTitle">
        <Setter Property="FontFamily" Value="{DynamicResource PbBookTitleFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.bookTitle.pbTextHero, TextBlock.bookTitle.pbTextHeading">
        <Setter Property="LineHeight" Value="NaN" />
    </Style>
    <!-- A line quoted from a book (the Books spread's pull quote, a latest highlight): the fixed serif, italic, section size, muted. -->
    <Style Selector="TextBlock.bookQuote">
        <Setter Property="FontFamily" Value="{DynamicResource PbBookTitleFontFamily}" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="FontSize" Value="{DynamicResource PbFontSizeSection}" />
        <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="controls|SplitText.hero">
        <Setter Property="FontSize" Value="{DynamicResource PbFontSizeHero}" />
    </Style>
    <Style Selector="controls|SplitText.heading">
        <Setter Property="FontSize" Value="{DynamicResource PbFontSizeHeading}" />
    </Style>
</Styles>
