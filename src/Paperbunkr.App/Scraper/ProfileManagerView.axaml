<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:vm="using:Paperbunkr.App.Scraper"
             xmlns:controls="using:Paperbunkr.App.Controls"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="600"
             x:Class="Paperbunkr.App.Scraper.ProfileManagerView"
             x:DataType="vm:ProfileManagerViewModel">

    <!-- Config screen redesign (2026-09-13) - same card language as SettingsView.axaml's Comic Vine
         tabs, applied to the master-detail layout this tab already had. -->
    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource PbSurface1Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="TextBlock.cardHeader">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextFaintBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource PbSurface1Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbBadgeTextBrush}" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style Selector="Button.destructive">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource PbDangerSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbDangerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PbDangerBrush}" />
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <!-- One exclude group. Child groups render through this same template (no ItemTemplate on the inner ItemsControl), so groups nest to any depth. -->
        <DataTemplate DataType="vm:ExcludeGroupViewModel" x:DataType="vm:ExcludeGroupViewModel">
            <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Skip a book that matches" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource PbTextMutedBrush}" />
                        <controls:SuggestBox IsStrict="True" Text="{Binding ModeText}" Suggestions="{x:Static vm:ExcludeGroupViewModel.ModeNames}" Width="90" />
                        <TextBlock Text="of these:" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource PbTextMutedBrush}" />
                        <Button Content="Remove group" Classes="secondary" Command="{Binding RemoveCommand}" IsVisible="{Binding !IsRoot}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Conditions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ExcludeConditionRowViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:SuggestBox IsStrict="True" Text="{Binding FieldText}" Suggestions="{x:Static vm:ExcludeConditionRowViewModel.FieldNames}" Width="150" />
                                    <controls:SuggestBox IsStrict="True" Text="{Binding OperatorText}" Suggestions="{x:Static vm:ExcludeConditionRowViewModel.OperatorNames}" Width="150" />
                                    <TextBox Text="{Binding Value}" Watermark="Value" Width="140" />
                                    <CheckBox Content="Not" IsChecked="{Binding Not}" />
                                    <Button Content="Remove" Classes="secondary" Command="{Binding RemoveCommand}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Groups}" Margin="12,0,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Add condition" Classes="secondary" Command="{Binding AddConditionCommand}" />
                        <Button Content="Add group" Classes="secondary" Command="{Binding AddGroupCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid ColumnDefinitions="200,*" Margin="4">
        <StackPanel Grid.Column="0" Spacing="10">
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="Profiles" Classes="cardHeader" />
                    <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Selected}" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:OrganizerProfileRowViewModel">
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource PbTextBrush}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="New profile" Classes="secondary" Command="{Binding AddProfileCommand}" HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="Undo" Classes="cardHeader" />
                    <TextBlock Text="Reverses the most recent Move-mode organize batch." Classes="hint" />
                    <Button Content="Undo last organize" Classes="secondary" Command="{Binding UndoLastOrganizeCommand}"
                            IsEnabled="{Binding !IsUndoing}" HorizontalAlignment="Stretch" />
                    <TextBlock Text="{Binding UndoStatusMessage}" Classes="hint"
                               IsVisible="{Binding UndoStatusMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Column="1" Margin="16,0,0,0"
                      IsVisible="{Binding Selected, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="12">
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Name" Classes="cardHeader" />
                        <TextBox Text="{Binding Selected.Name}" />
                        <TextBlock Text="Base folder" Classes="cardHeader" Margin="0,4,0,0" />
                        <TextBox Text="{Binding Selected.BaseFolder}" Watermark="Root folder this profile organizes into" />
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Naming templates" Classes="cardHeader" />
                        <TextBlock Text="Folder template" Classes="fieldLabel" />
                        <TextBox Text="{Binding Selected.FolderTemplate}" AcceptsReturn="False" />
                        <TextBlock Text="File template" Classes="fieldLabel" />
                        <TextBox Text="{Binding Selected.FileTemplate}" AcceptsReturn="False" />
                        <CheckBox Content="Move files into the folders the folder template describes" IsChecked="{Binding Selected.UseFolder}" Margin="0,4,0,0" />
                        <CheckBox Content="Rename files with the file template" IsChecked="{Binding Selected.UseFileName}" />
                        <TextBlock Text="Turn one off to only rename in place, or only move. Templates are checked when you save." Classes="hint" />
                        <TextBlock Text="Insert token into folder / file template:" Classes="hint" Margin="0,4,0,0" />
                        <ItemsControl ItemsSource="{Binding InsertableTokens}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:InsertableToken">
                                    <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,0,4,4">
                                        <Button Content="{Binding Token}" Classes="secondary" FontSize="11" Height="24" Padding="6,0"
                                                Command="{Binding InsertIntoFolder}" CommandParameter="{Binding Token}"
                                                ToolTip.Tip="Insert into folder template" />
                                        <Button Content="→file" Classes="secondary" FontSize="11" Height="24" Padding="6,0"
                                                Command="{Binding InsertIntoFile}" CommandParameter="{Binding Token}"
                                                ToolTip.Tip="Insert into file template" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Preview" Classes="cardHeader" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Refresh" Classes="secondary" Command="{Binding RefreshPreviewCommand}"
                                    AutomationProperties.Name="Refresh the preview" />
                        </Grid>
                        <TextBlock Text="A few comics from your library, run through the settings above as you edit. Nothing is moved. Exclude rules are not applied here." Classes="hint" />
                        <TextBlock Text="{Binding PreviewMessage}" Classes="hint" IsVisible="{Binding HasPreviewMessage}" />
                        <ItemsControl ItemsSource="{Binding PreviewRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PreviewRowViewModel">
                                    <StackPanel Margin="0,0,0,6" Spacing="1">
                                        <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource PbTextBrush}" />
                                        <TextBlock Text="{Binding Text}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource PbTextMutedBrush}" IsVisible="{Binding IsNotProblem}" />
                                        <TextBlock Text="{Binding Text}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource PbDangerBrush}" IsVisible="{Binding IsProblem}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Behavior" Classes="cardHeader" />
                        <TextBlock Text="Mode" Classes="fieldLabel" />
                        <controls:SuggestBox IsStrict="True" Text="{Binding Selected.ModeText}" Suggestions="{x:Static vm:OrganizerProfileRowViewModel.ModeNames}" HorizontalAlignment="Stretch" />
                        <TextBlock Text="When run automatically and a file already exists" Classes="fieldLabel" Margin="0,4,0,0" />
                        <controls:SuggestBox IsStrict="True" Text="{Binding Selected.CollisionPolicyText}" Suggestions="{x:Static vm:OrganizerProfileRowViewModel.CollisionPolicyNames}" HorizontalAlignment="Stretch" />
                        <CheckBox Content="Remove empty folders left behind after organizing" IsChecked="{Binding Selected.RemoveEmptyFolders}" Margin="0,4,0,0" />
                        <CheckBox Content="Use for the scheduled Organize library task (Preferences → Automation)" IsChecked="{Binding Selected.UseForScheduledRun}" />
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="When a value is missing" Classes="cardHeader" />
                        <TextBlock Text="Folder name for an empty folder part" Classes="fieldLabel" />
                        <TextBox Text="{Binding Selected.EmptyFolder}" Watermark="Blank leaves the part out of the path" />
                        <TextBlock Text="Text to use when a token is empty (one token=text per line, e.g. publisher=Unknown)" Classes="fieldLabel" Margin="0,4,0,0" />
                        <TextBox Text="{Binding Selected.EmptyDataText}" AcceptsReturn="True" Height="70" />
                        <CheckBox Content="Leave a book where it is when one of these tokens is empty" IsChecked="{Binding Selected.FailEmptyValues}" Margin="0,4,0,0" />
                        <TextBox Text="{Binding Selected.FailedFieldsText}" Watermark="series, number" IsEnabled="{Binding Selected.FailEmptyValues}" />
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Exclude from organizing when" Classes="cardHeader" />
                        <TextBlock Text="A book that matches the rule below is left where it is. Groups can hold other groups (all of / any of), to any depth. No conditions means nothing is excluded." Classes="hint" />
                        <ContentControl Content="{Binding Selected.RootGroup}" />
                        <TextBlock Text="Never organize books inside these folders (one per line)" Classes="fieldLabel" Margin="0,4,0,0" />
                        <TextBox Text="{Binding Selected.ExcludeFoldersText}" AcceptsReturn="True" Height="60" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding SaveStatusMessage}" Foreground="{DynamicResource PbDangerBrush}" TextWrapping="Wrap"
                           IsVisible="{Binding SaveStatusMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="Delete" Classes="destructive" Command="{Binding DeleteSelectedCommand}" />
                    <Button Content="Save" Classes="primary" Command="{Binding SaveSelectedCommand}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
