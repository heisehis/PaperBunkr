<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:models="using:Paperbunkr.App.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="680" d:DesignHeight="600"
             x:Class="Paperbunkr.App.Views.Preferences.AutomationSection"
             x:DataType="vm:PreferencesScreenViewModel">

    <ScrollViewer>
        <StackPanel Margin="28,20,28,40" Spacing="20">
            <TextBlock Classes="pbTextHeading" Text="Automation" />

            <Border Classes="groupBox" Tag="automation.tasks">
                <StackPanel>
                    <Border Classes="groupHeader">
                        <TextBlock Text="Scheduled Tasks" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                    </Border>
                    <StackPanel Margin="14" Spacing="16">

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Notify when a scheduled task finishes:" VerticalAlignment="Center"
                                       FontSize="12.5" Foreground="{DynamicResource PbTextBrush}" />
                            <ComboBox ItemsSource="{x:Static vm:PreferencesScreenViewModel.NotificationLevelOptions}"
                                      SelectedItem="{Binding ScheduledTaskNotificationLevel}" MinWidth="150"
                                      AutomationProperties.AutomationId="ScheduledTaskNotificationLevel" />
                        </StackPanel>

                        <TextBlock Text="Maintenance tasks run in the background — on launch for anything overdue, then every 15 minutes while Paperbunkr is open. Up to two run at once. Every run shows in the Activity Center."
                                   FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" TextWrapping="Wrap" />

                        <ItemsControl ItemsSource="{Binding ScheduledTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ScheduledTaskRow">
                                    <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                                            <ToggleSwitch Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                                                          IsChecked="{Binding Enabled}" VerticalAlignment="Top" Margin="0,0,12,0" />

                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DisplayName}"
                                                       FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PbTextBrush}" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Description}"
                                                       FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" TextWrapping="Wrap" />

                                            <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" Content="Run now"
                                                    Command="{Binding RunNowCommand}" VerticalAlignment="Top" />

                                            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                                        Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                                <ComboBox ItemsSource="{x:Static vm:PreferencesScreenViewModel.ScheduleModeOptions}"
                                                          SelectedItem="{Binding Mode}" MinWidth="120" />
                                                <NumericUpDown Value="{Binding IntervalHours}" Minimum="1" Maximum="720" Width="110"
                                                               IsVisible="{Binding IsIntervalMode}" />
                                                <TextBlock Text="hours" VerticalAlignment="Center" IsVisible="{Binding IsIntervalMode}"
                                                           FontSize="12" Foreground="{DynamicResource PbTextFaintBrush}" />
                                                <TimePicker SelectedTime="{Binding DailyAtTime}" ClockIdentifier="24HourClock"
                                                            IsVisible="{Binding IsDailyMode}" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                                        Orientation="Horizontal" Spacing="14" Margin="0,6,0,0">
                                                <TextBlock Text="{Binding LastRunLabel, StringFormat='Last run: {0}'}"
                                                           FontSize="11" Foreground="{DynamicResource PbTextFaintBrush}" />
                                                <TextBlock Text="{Binding NextRunLabel, StringFormat='Next: {0}'}"
                                                           FontSize="11" Foreground="{DynamicResource PbTextFaintBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
