<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:models="using:Paperbunkr.App.Models"
             xmlns:entities="using:Paperbunkr.Data.Entities"
             xmlns:views="using:Paperbunkr.App.Views"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="760"
             x:Class="Paperbunkr.App.Views.ReadingScreen"
             x:DataType="vm:ReadingScreenViewModel">

    <UserControl.Styles>
        <!-- statCard / issueRow / searchBox come from Styles/ScreenChrome.axaml. -->
        <Style Selector="Button.headerAction">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusSm}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.headerAction.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
        </Style>
        <Style Selector="Button.headerAction.secondary">
            <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
        </Style>
        <Style Selector="Button.headerAction.primary">
            <Setter Property="Background" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PbBadgeTextBrush}" />
        </Style>

        <Style Selector="Button.tagPillButton">
            <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.tagPillButton:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource PbBadgeBrush}" />
        </Style>
        <Style Selector="TextBlock.tagPillText">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
        </Style>

        <!-- Issue row: calm at rest, management cluster fades in on hover (fixed column, no layout shift). -->
        <Style Selector="Border.itemRow">
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusSm}" />
            <Setter Property="Padding" Value="6,7" />
            <Setter Property="Margin" Value="0,1" />
        </Style>
        <Style Selector="Border.itemRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
        </Style>
        <Style Selector="Border.itemRow.next">
            <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.itemRow.read">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="Border.itemRow TextBlock.posNum">
            <Setter Property="Foreground" Value="{DynamicResource PbTextFaintBrush}" />
        </Style>
        <Style Selector="Border.itemRow.next TextBlock.posNum">
            <Setter Property="Foreground" Value="{DynamicResource PbAccentTextBrush}" />
        </Style>
        <Style Selector="Border.itemRow :is(Control).rowManage">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Transitions">
                <Transitions><DoubleTransition Property="Opacity" Duration="{DynamicResource PbMotionFast}" /></Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.itemRow:pointerover :is(Control).rowManage">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>

        <Style Selector="Button.rowOpenTarget">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.rowOpenTarget:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

        <!-- ===== Row 0: top band ===== -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="28,20,28,14" IsVisible="{Binding !IsEmptyList}">
            <Panel Grid.Column="0" Width="88" Height="132" Margin="0,0,16,0" VerticalAlignment="Top">
                <Border CornerRadius="{DynamicResource PbRadius}" ClipToBounds="True" BoxShadow="{StaticResource PbElevationShadow}"
                        Background="{DynamicResource PbSurface2Brush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1">
                    <Panel>
                        <TextBlock Text="☰" FontSize="26" Foreground="{DynamicResource PbTextFaintBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding ArcCoverImage, Converter={x:Static conv:ObjectConverters.IsNull}}" />
                        <Image Source="{Binding ArcCoverImage}" Stretch="UniformToFill"
                               IsVisible="{Binding ArcCoverImage, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                    </Panel>
                </Border>
            </Panel>

            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                <TextBlock Classes="pbTextHeading" Text="{Binding ListName}" TextWrapping="Wrap" />
                <Border Background="Transparent" BorderBrush="{DynamicResource PbAccentBrush}" BorderThickness="1" CornerRadius="999"
                        Padding="7,1" HorizontalAlignment="Left" Margin="0,5,0,0" IsVisible="{Binding IsArcLinked}">
                    <TextBlock Text="{Binding ArcSourceLabel}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource PbAccentTextBrush}" />
                </Border>

                <TextBlock Text="{Binding MetaLine}" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />

                <ItemsControl ItemsSource="{Binding Tags}" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TagPillViewModel">
                            <Button Classes="tagPillButton" Command="{Binding SearchCommand}" ToolTip.Tip="{Binding Category}">
                                <Button.ContextMenu>
                                    <ContextMenu IsVisible="{Binding CanReweight}">
                                        <MenuItem Header="Incidental" Command="{Binding SetWeightCommand}" CommandParameter="{x:Static entities:IssueTagWeight.Incidental}" />
                                        <MenuItem Header="Recurrent" Command="{Binding SetWeightCommand}" CommandParameter="{x:Static entities:IssueTagWeight.Recurrent}" />
                                        <MenuItem Header="Defining" Command="{Binding SetWeightCommand}" CommandParameter="{x:Static entities:IssueTagWeight.Defining}" />
                                        <MenuItem Header="Core" Command="{Binding SetWeightCommand}" CommandParameter="{x:Static entities:IssueTagWeight.Core}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <TextBlock Classes="tagPillText" Text="{Binding Value}" FontWeight="{Binding TextWeight}" Opacity="{Binding WeightOpacity}" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{DynamicResource PbTextMutedBrush}"
                               TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left"
                               MaxLines="2" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasSynopsis}"
                               Classes.expanded="{Binding SynopsisExpanded}">
                        <TextBlock.Styles>
                            <Style Selector="TextBlock.expanded"><Setter Property="MaxLines" Value="0" /><Setter Property="TextTrimming" Value="None" /></Style>
                        </TextBlock.Styles>
                    </TextBlock>
                    <Button Classes="headerAction ghost" Padding="0" FontSize="10.5" HorizontalAlignment="Left"
                            Content="{Binding SynopsisToggleLabel}" Command="{Binding ToggleSynopsisCommand}" IsVisible="{Binding HasSynopsis}" />
                    <Button Classes="headerAction ghost" Padding="0" FontSize="10.5" HorizontalAlignment="Left"
                            Content="＋ Add a description" Command="{Binding OpenPropertiesCommand}" IsVisible="{Binding !HasSynopsis}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ===== Row 1: progress ===== -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="28,0,28,12" ColumnSpacing="14"
              IsVisible="{Binding HasContinueTarget}">
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <ProgressBar Minimum="0" Maximum="1" Value="{Binding ProgressFraction}" Height="8" />
                <TextBlock Text="{Binding ProgressLabel}" FontSize="10.5" Foreground="{DynamicResource PbTextFaintBrush}" Margin="0,5,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Classes="headerAction primary" VerticalAlignment="Center"
                    Content="{Binding ContinueLabel}" Command="{Binding ContinueCommand}" />
        </Grid>

        <!-- ===== Row 2: action row (recessed management) ===== -->
        <StackPanel Grid.Row="2" Margin="28,0,28,10" Spacing="10" IsVisible="{Binding !IsEmptyList}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="headerAction primary" Command="{Binding ToggleAddIssuesCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Path Classes="pbIcon" Width="11" Height="11" Data="{StaticResource PbIconPlus}" Stroke="{DynamicResource PbBadgeTextBrush}" />
                        <TextBlock Text="Add issues" />
                    </StackPanel>
                </Button>
                <Button Classes="headerAction secondary" Content="⋯ Manage">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Import .CBL…" Command="{Binding ImportCblCommand}" />
                            <MenuItem Header="Import .CSV…" Command="{Binding ImportCsvCommand}" />
                            <MenuItem Header="Export">
                                <MenuItem Header="As .CBL…" Command="{Binding ExportCblCommand}" />
                                <MenuItem Header="As plain text…" Command="{Binding ExportAsTextCommand}" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Link story event…" Command="{Binding ToggleLinkStoryEventCommand}" />
                            <MenuItem Header="Build from a story arc…" Command="{Binding ToggleArcSearchCommand}" />
                            <MenuItem Header="Refresh from source" Command="{Binding RefreshArcListCommand}" IsVisible="{Binding IsArcLinked}" />
                            <Separator />
                            <MenuItem Header="Edit details…" Command="{Binding OpenPropertiesCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button Classes="headerAction ghost" Command="{Binding CopyAsTextCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Path Classes="pbIcon" Width="11" Height="11" Data="{StaticResource PbIconCopy}" />
                        <TextBlock Text="Copy" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Add-issues inline search -->
            <Border Classes="issueRow" Background="{DynamicResource PbSurface2Brush}" IsVisible="{Binding IsAddIssuesOpen}" Padding="12">
                <StackPanel Spacing="8">
                    <TextBox Classes="searchBox" Watermark="Search your library by series or number…" Text="{Binding SearchQuery}" />
                    <ItemsControl ItemsSource="{Binding SearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:IssueSearchResult">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayLabel}" FontSize="12.5"
                                               Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Classes="headerAction ghost"
                                            Command="{Binding $parent[ItemsControl].((vm:ReadingScreenViewModel)DataContext).AddIssueCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Path Classes="pbIcon" Width="10" Height="10" Data="{StaticResource PbIconPlus}" />
                                            <TextBlock Text="{Binding $parent[ItemsControl].((vm:ReadingScreenViewModel)DataContext).AddResultButtonLabel}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Relink banner -->
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsLinking}">
                <TextBlock Grid.Column="0" Text="{Binding LinkingBannerText}" FontSize="12" FontStyle="Italic"
                           Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="headerAction ghost" Content="Cancel" Command="{Binding CancelLinkCommand}" />
            </Grid>

            <!-- Link story event panel -->
            <Border Classes="issueRow" Background="{DynamicResource PbSurface2Brush}" IsVisible="{Binding IsLinkingStoryEvent}" Padding="12">
                <StackPanel Spacing="8">
                    <TextBox Classes="searchBox" Watermark="Search for a story event…" Text="{Binding StoryEventSearchQuery}" />
                    <ItemsControl ItemsSource="{Binding StoryEventSearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:StoryEventSearchResult">
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6" Margin="0,2"
                                        Background="Transparent" BorderThickness="0" FontSize="12.5" Foreground="{DynamicResource PbTextMutedBrush}"
                                        Command="{Binding $parent[ItemsControl].((vm:ReadingScreenViewModel)DataContext).LinkStoryEventCommand}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding Name}" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Build from arc panel -->
            <Border Classes="issueRow" Background="{DynamicResource PbSurface2Brush}" IsVisible="{Binding IsArcSearchOpen}" Padding="12">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <ComboBox Grid.Column="0" ItemsSource="{Binding ArcSourceOptions}" SelectedItem="{Binding SelectedArcSource}" Width="220" Margin="0,0,10,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:ArcSourceOption"><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBox Grid.Column="1" Text="{Binding ArcSearchQuery}" Watermark="Story arc or event name…" Classes="searchBox" />
                        <Button Grid.Column="2" Classes="headerAction primary" Content="Search" Margin="10,0,0,0" Command="{Binding SearchArcCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding ArcSearchStatus}" FontSize="12" Foreground="{DynamicResource PbTextFaintBrush}"
                               IsVisible="{Binding ArcSearchStatus, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                    <ItemsControl ItemsSource="{Binding ArcSearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ArcSearchResultRow">
                                <Border Classes="issueRow" Background="{DynamicResource PbSurface3Brush}" Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                                            <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{DynamicResource PbTextFaintBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="headerAction primary" Content="Use This Arc"
                                                Command="{Binding $parent[ItemsControl].((vm:ReadingScreenViewModel)DataContext).UseArcCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource PbAccentSoftBrush}" CornerRadius="5" Padding="10,7" IsVisible="{Binding HasStatusMessage}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Classes="pbIcon" Width="13" Height="13" Data="{StaticResource PbIconInfo}" Stroke="{DynamicResource PbTextBrush}" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource PbTextBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- spacer between action row and list -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,4"
                IsVisible="{Binding !IsEmptyList}" />

        <!-- ===== Row 4: the list (hero) OR empty state ===== -->
        <ScrollViewer Grid.Row="4">
            <StackPanel>

                <!-- empty list -->
                <Border Margin="28,20,28,40" Padding="24" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource PbRadius}" IsVisible="{Binding IsEmptyList}">
                    <StackPanel HorizontalAlignment="Center" Spacing="12">
                        <TextBlock Text="Add issues to get started" FontSize="13" Foreground="{DynamicResource PbTextMutedBrush}" HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <Button Classes="headerAction primary" Content="＋ Add issues" Command="{Binding ToggleAddIssuesCommand}" />
                            <Button Classes="headerAction secondary" Content="Import .CBL" Command="{Binding ImportCblCommand}" />
                            <Button Classes="headerAction secondary" Content="Import .CSV" Command="{Binding ImportCsvCommand}" />
                            <Button Classes="headerAction secondary" Content="Build from a story arc" Command="{Binding ToggleArcSearchCommand}" />
                        </StackPanel>
                        <Border Classes="issueRow" Background="{DynamicResource PbSurface2Brush}" IsVisible="{Binding IsAddIssuesOpen}" Padding="12" Width="420">
                            <StackPanel Spacing="8">
                                <TextBox Classes="searchBox" Watermark="Search your library…" Text="{Binding SearchQuery}" />
                                <ItemsControl ItemsSource="{Binding SearchResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:IssueSearchResult">
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                <TextBlock Grid.Column="0" Text="{Binding DisplayLabel}" FontSize="12.5"
                                                           Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Classes="headerAction ghost" Content="Add"
                                                        Command="{Binding $parent[ItemsControl].((vm:ReadingScreenViewModel)DataContext).AddIssueCommand}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource PbSurface2Brush}" CornerRadius="6" Padding="12" IsVisible="{Binding IsArcSearchOpen}" Width="480">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <ComboBox Grid.Column="0" ItemsSource="{Binding ArcSourceOptions}" SelectedItem="{Binding SelectedArcSource}" Width="180" Margin="0,0,8,0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:ArcSourceOption"><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBox Grid.Column="1" Text="{Binding ArcSearchQuery}" Watermark="Arc or event name…" Classes="searchBox" />
                                    <Button Grid.Column="2" Classes="headerAction primary" Content="Search" Margin="8,0,0,0" Command="{Binding SearchArcCommand}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding ArcSearchResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ArcSearchResultRow">
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Classes="headerAction primary" Content="Use"
                                                        Command="{Binding $parent[ItemsControl].((vm:ReadingScreenViewModel)DataContext).UseArcCommand}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- no reading lists at all -->
                <TextBlock Text="No reading lists yet — create one from the sidebar to get started." FontSize="13"
                           Foreground="{DynamicResource PbTextFaintBrush}" Margin="28,20,28,40" TextWrapping="Wrap"
                           IsVisible="{Binding HasNoReadingLists}" />

                <ItemsControl ItemsSource="{Binding Groups}" Margin="16,4,16,40" IsVisible="{Binding !IsEmptyList}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ReadingListGroupViewModel">
                            <StackPanel Margin="0,0,0,18">
                                <TextBlock Text="{Binding Label}" Classes="pbTextCaption" Margin="8,4,0,8"
                                           IsVisible="{Binding HasLabel}" />
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ReadingListItemRowViewModel">
                                            <Border Classes="itemRow" Classes.next="{Binding IsNextUp}" Classes.read="{Binding IsRead}">
                                                <StackPanel Spacing="3">
                                                    <Grid ColumnDefinitions="18,26,46,*,Auto,Auto,Auto" ColumnSpacing="0">
                                                        <TextBlock Grid.Column="0" Classes="rowManage" Text="⠿" FontSize="12" VerticalAlignment="Center"
                                                                   HorizontalAlignment="Center" Foreground="{DynamicResource PbTextFaintBrush}" ToolTip.Tip="Drag to reorder" />

                                                        <TextBlock Grid.Column="1" Classes="pbTextHeading posNum" Text="{Binding Position}"
                                                                   FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" />

                                                        <Panel Grid.Column="2" Width="42" Height="63" Margin="0,0,12,0">
                                                            <Border CornerRadius="3" ClipToBounds="True" Background="{DynamicResource PbSurface3Brush}"
                                                                    IsVisible="{Binding !IsMissing}">
                                                                <Image Source="{Binding CoverIssueId, Converter={x:Static views:CoverImageConverter.Instance}}" Stretch="UniformToFill" />
                                                            </Border>
                                                            <Border CornerRadius="3" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1"
                                                                    Background="{DynamicResource PbSurface2Brush}" IsVisible="{Binding IsMissing}" />
                                                        </Panel>

                                                        <Button Grid.Column="3" Classes="rowOpenTarget" Command="{Binding OpenCommand}"
                                                                IsEnabled="{Binding IsOwned}" ToolTip.Tip="Read">
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding TitleLine}" FontSize="13.5" Foreground="{DynamicResource PbTextBrush}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding SeriesLine}" FontSize="11" Margin="0,1,0,0"
                                                                           Foreground="{DynamicResource PbTextFaintBrush}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Button>

                                                        <!-- role: chip at rest (when set), compact picker on hover -->
                                                        <Panel Grid.Column="4" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="40">
                                                            <Border Classes="pbChip" Padding="8,3" HorizontalAlignment="Left"
                                                                    IsVisible="{Binding HasRole}">
                                                                <TextBlock Text="{Binding RoleChipLabel}" FontSize="10" Foreground="{DynamicResource PbTextMutedBrush}" />
                                                            </Border>
                                                            <ComboBox Classes="rowManage" ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding SelectedRoleOption}"
                                                                      FontSize="10.5" MinWidth="104" PlaceholderText="Role" HorizontalAlignment="Left"
                                                                      Background="{DynamicResource PbSurface3Brush}">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:EventMembershipRoleOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </Panel>

                                                        <!-- state indicator -->
                                                        <Panel Grid.Column="5" VerticalAlignment="Center" Margin="10,0,0,0">
                                                            <Path Classes="pbIcon" Width="14" Height="14" Data="{StaticResource PbIconCheck}"
                                                                  Stroke="{DynamicResource PbSuccessBrush}" IsVisible="{Binding IsRead}" />
                                                            <Button Classes="headerAction primary" Padding="10,5" FontSize="10.5"
                                                                    Command="{Binding OpenCommand}" IsVisible="{Binding IsNextUp}">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <Path Classes="pbIcon" Width="9" Height="9" Data="{StaticResource PbIconPlay}" Stroke="{DynamicResource PbBadgeTextBrush}" />
                                                                    <TextBlock Text="Read" />
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Classes="headerAction ghost" Content="Find &amp; link" Padding="8,3" FontSize="10.5"
                                                                    Command="{Binding LinkCommand}" IsVisible="{Binding IsMissing}" />
                                                        </Panel>

                                                        <!-- hover: one ⋯ menu -->
                                                        <Button Grid.Column="6" Classes="rowManage headerAction ghost" Padding="7,2" Margin="8,0,0,0"
                                                                VerticalAlignment="Center" ToolTip.Tip="More">
                                                            <Path Classes="pbIcon" Width="13" Height="13" Data="{StaticResource PbIconMoreVertical}" />
                                                            <Button.Flyout>
                                                                <MenuFlyout>
                                                                    <MenuItem Header="Mark as read" Command="{Binding ToggleReadCommand}" IsVisible="{Binding !IsRead}" />
                                                                    <MenuItem Header="Mark as unread" Command="{Binding ToggleReadCommand}" IsVisible="{Binding IsRead}" />
                                                                    <MenuItem Header="Add a note" Command="{Binding BeginNoteCommand}" />
                                                                    <Separator />
                                                                    <MenuItem Header="Move up" Command="{Binding MoveUpCommand}" />
                                                                    <MenuItem Header="Move down" Command="{Binding MoveDownCommand}" />
                                                                    <Separator />
                                                                    <MenuItem Header="Remove from list" Command="{Binding RemoveCommand}" />
                                                                </MenuFlyout>
                                                            </Button.Flyout>
                                                        </Button>
                                                    </Grid>

                                                    <TextBlock Text="{Binding Notes}" FontSize="11" FontStyle="Italic" Margin="90,0,0,0"
                                                               Foreground="{DynamicResource PbTextFaintBrush}" TextWrapping="Wrap"
                                                               IsVisible="{Binding Notes, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                                                    <TextBox Text="{Binding Notes}" Watermark="Add a note…" FontSize="11" Margin="90,2,0,0"
                                                             Background="{DynamicResource PbSurface2Brush}" Padding="6,3"
                                                             IsVisible="{Binding NoteEditing}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
