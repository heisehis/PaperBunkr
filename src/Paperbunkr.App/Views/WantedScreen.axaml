<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:tabs="using:Paperbunkr.App.Views.WantedTabs"
             xmlns:controls="using:Paperbunkr.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Paperbunkr.App.Views.WantedScreen"
             x:DataType="vm:WantedScreenViewModel"
             controls:ContextMenuHost.Provider="{Binding}">

    <!-- The Wanted screen (docs/superpowers/specs/2026-09-21-wanted-screen-redesign-design.md): a thin shell - title, three tabs, Search now - around the Queue, Series and
         Releases views in Views/WantedTabs. Shared chrome only: Button.tab from Styles, Pb* tokens, no hardcoded colors. Transient results are toasts; nothing lingers here. -->
    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0" Background="{DynamicResource PbChromeBrush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,0,0,1" Padding="24,10,24,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Classes="pbTextHeading" Text="Wanted" VerticalAlignment="Center" Margin="0,0,24,10" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                    <Button Classes="tab" Classes.active="{Binding IsQueueTab}" Command="{Binding GoQueueCommand}"
                            AutomationProperties.AutomationId="WantedTabQueue">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Queue" VerticalAlignment="Center" />
                            <TextBlock Classes="tabCount" Text="{Binding QueueCount}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tab" Classes.active="{Binding IsSeriesTab}" Command="{Binding GoSeriesCommand}"
                            AutomationProperties.AutomationId="WantedTabSeries">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Series" VerticalAlignment="Center" />
                            <TextBlock Classes="tabCount" Text="{Binding SeriesRows.Count}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tab" Classes.active="{Binding IsReleasesTab}" Command="{Binding GoReleasesCommand}"
                            AutomationProperties.AutomationId="WantedTabReleases">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Releases" VerticalAlignment="Center" />
                            <TextBlock Classes="tabCount" Text="{Binding ReleaseCount}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button Grid.Column="2" Classes="headerAction primary" Command="{Binding SearchNowCommand}" VerticalAlignment="Center" Margin="0,0,0,10"
                        AutomationProperties.AutomationId="WantedSearchNowButton">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <fi:SymbolIcon Symbol="Search" FontSize="{StaticResource PbIconSizeXs}" />
                        <TextBlock Text="Search now" IsVisible="{Binding !IsSearching}" />
                        <TextBlock Text="Searching…" IsVisible="{Binding IsSearching}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- One scroll region per tab (each view owns its own) -->
        <Panel Grid.Row="1">
            <tabs:QueueView IsVisible="{Binding IsQueueTab}" />
            <tabs:SeriesView IsVisible="{Binding IsSeriesTab}" />
            <tabs:ReleasesView IsVisible="{Binding IsReleasesTab}" />
        </Panel>
    </Grid>
</UserControl>
