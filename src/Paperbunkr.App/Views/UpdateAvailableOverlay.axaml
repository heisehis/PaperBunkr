<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="360"
             x:Class="Paperbunkr.App.Views.UpdateAvailableOverlay"
             x:DataType="vm:UpdateAvailableOverlayViewModel">

    <Border Width="440" Classes="floatingPanel">
        <StackPanel Margin="24,22" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <fi:SymbolIcon Symbol="ArrowDownload" FontSize="20" Foreground="{DynamicResource PbAccentTextBrush}" />
                <TextBlock Text="{Binding VersionText, StringFormat='Paperbunkr {0} is available'}"
                           FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PbTextBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <Border Classes="groupBox" Margin="0,10,0,0" MaxHeight="200">
                <ScrollViewer>
                    <TextBlock Text="{Binding ChangelogBody}" Margin="14,10" FontSize="12.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource PbTextFaintBrush}" />
                </ScrollViewer>
            </Border>

            <CheckBox Content="Don't check for updates on startup" IsChecked="{Binding DontCheckOnStartup}" Margin="0,10,0,0" />

            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Classes="headerAction ghost" Content="Not now" Command="{Binding NotNowCommand}"
                        AutomationProperties.AutomationId="UpdateAvailableNotNow" />
                <Button Classes="headerAction primary" Command="{Binding DownloadCommand}"
                        AutomationProperties.AutomationId="UpdateAvailableDownload">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <fi:SymbolIcon Symbol="ArrowDownload" Foreground="{DynamicResource PbBadgeTextBrush}" />
                        <TextBlock Text="Download" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
