<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Paperbunkr.App.App"
             xmlns:local="using:Paperbunkr.App"
             xmlns:anim="using:Avalonia.Animation"
             xmlns:sty="using:FluentAvalonia.Styling"
             xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             RequestedThemeVariant="Dark">
             <!-- Dark here is only the design-time/pre-startup fallback (XAML previewer, the brief
                  window before ThemeService.ApplyPersistedSettings runs) - NOT a fixed identity
                  anymore. docs/superpowers/specs/2026-09-16-theme-system-design.md replaced the
                  single-dark-identity approach this comment used to describe (see
                  docs/wireframe_prototype_prompt.md for that history): ThemeService.ApplyTheme now
                  sets this live from each theme's own Light/Dark `mode`, overriding this value on
                  every real startup well before the main window shows. -->

    <Application.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <!-- DataGrid's own control theme (docs/superpowers/specs/2026-09-24-scraper-review-tables-
                 and-batch-summary-design.md §1). NOT Avalonia.Controls.DataGrid's own bundled
                 Themes/Fluent.xaml - that one targets Avalonia's CORE <FluentTheme/>, and
                 FluentAvalonia's own docs are explicit that running FluentAvaloniaTheme alongside core
                 FluentTheme is unsupported (see FluentAvaloniaTheme's own comment below); a live
                 community report (github.com/amwx/FluentAvalonia issue #30) confirms mixing them for
                 DataGrid specifically causes unresolved-resource/binding-exception failures.
                 FluentAvaloniaUI ships its own DataGrid styling instead - confirmed two ways, not just
                 trusted from a search result: (1) directly inspecting this exact package version's DLL
                 for its embedded avares:// resource manifest (FluentAvalonia.dll v3.1.0 contains
                 Styling/ControlThemes/BasicControls/DataGrid/{DataGridStyles,DataGridCellStyles,
                 DataGridColumnHeaderStyles,DataGridRowStyles,DataGridRowHeaderStyles,
                 DataGridRowGroupHeaderStyles}.axaml); (2) AVLN2000 itself, when an initial
                 <StyleInclude> attempt (the wrong host element) reported this resource's real type as
                 Avalonia.Controls.ResourceDictionary, confirming ResourceInclude/MergedDictionaries
                 (here) rather than Styles is the correct XAML host - and a follow-up AVLN3000/"Dots
                 aren't allowed in type names" pair once actually pinning down the right structural
                 placement relative to this file's own pre-existing bare resource entries below. Column
                 bindings inside a DataGrid are always reflection bindings, even in this otherwise
                 compiled-bindings app (confirmed Avalonia limitation, isolated to the DataGrid views
                 that use it). NOT verified on screen - flag if the tables render unstyled. -->
            <ResourceInclude Source="avares://FluentAvalonia/Styling/ControlThemes/BasicControls/DataGrid/DataGridStyles.axaml" />
            <ResourceInclude Source="avares://Paperbunkr.App/Styles/AppTokens.axaml" />
        </ResourceDictionary.MergedDictionaries>

      </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <!-- FluentAvaloniaTheme replaces Avalonia's built-in <FluentTheme> (running both is
             explicitly unsupported - amwx.github.io/FluentAvaloniaDocs/pages/FATheme). It ships the
             same stock Fluent control templates plus the extra WinUI controls (NavigationView,
             Frame, TabView, InfoBar, etc.).
             Accent: FluentAvalonia's stock-control accent system (TextBox focus borders,
             CheckBox/ToggleSwitch checked states, ScrollBar hover, selection highlights) reads the
             SystemAccentColor* resources, NOT the Pb* tokens - those only cover elements this app
             custom-styles itself. CustomAccentColor seeds SystemAccentColor + its 6 tonal variants
             from our amber. PbAccentColor is a plain XAML value here (StaticResource), so this
             captures the *default* skin's accent; a live skin switch updates it via
             ThemeService.ApplyAccentColor (FluentAvaloniaTheme.CustomAccentColor, set in code). -->
        <sty:FluentAvaloniaTheme CustomAccentColor="{StaticResource PbAccentColor}"
                                 PreferSystemTheme="False"
                                 PreferUserAccentColor="False" />

        <!-- AvaloniaEdit's control theme (syntax-highlighting text editor) - Fluent variant to
             match FluentAvaloniaTheme above. -->
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

        <!-- DialogHost.Avalonia overlay-dialog control styles. -->
        <dialogHost:DialogHostStyles />

        <!-- Design language foundation (docs/superpowers/specs/2026-08-24-design-language-
             foundation-design.md) - type scale + component primitives. Kept last so the app's own
             styling wins over the theme packages above. -->
        <StyleInclude Source="avares://Paperbunkr.App/Styles/Typography.axaml" />
        <StyleInclude Source="avares://Paperbunkr.App/Styles/Primitives.axaml" />
        <StyleInclude Source="avares://Paperbunkr.App/Styles/FormControls.axaml" />
        <StyleInclude Source="avares://Paperbunkr.App/Styles/Icons.axaml" />
        <StyleInclude Source="avares://Paperbunkr.App/Styles/Marks.axaml" />
        <StyleInclude Source="avares://Paperbunkr.App/Styles/Overlays.axaml" />
        <StyleInclude Source="avares://Paperbunkr.App/Styles/FirstLook.axaml" />
        <StyleInclude Source="avares://Paperbunkr.App/Styles/Indicators.axaml" />
        <StyleInclude Source="avares://Paperbunkr.App/Styles/Badges.axaml" />
        <StyleInclude Source="avares://Paperbunkr.App/Styles/DetailChrome.axaml" />
        <StyleInclude Source="avares://Paperbunkr.App/Styles/ScreenChrome.axaml" />
        <StyleInclude Source="avares://Paperbunkr.App/Styles/Menu.axaml" />
        <StyleInclude Source="avares://Paperbunkr.App/Styles/ReaderChrome.axaml" />

        <!-- Preferences > Appearance > Font override (docs/superpowers/specs/
             2026-08-07-preferences-skin-system-design.md §3) - a genuine global override via
             DynamicResource, not just the title bar. PbFontFamily is absent by default (no
             override); ThemeService.ApplyFont sets/removes it live. -->
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource PbFontFamily}" />
        </Style>
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="{DynamicResource PbFontFamily}" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontFamily" Value="{DynamicResource PbFontFamily}" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="FontFamily" Value="{DynamicResource PbFontFamily}" />
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="FontFamily" Value="{DynamicResource PbFontFamily}" />
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="FontFamily" Value="{DynamicResource PbFontFamily}" />
        </Style>

    </Application.Styles>
</Application>