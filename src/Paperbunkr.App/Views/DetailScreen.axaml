<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:views="using:Paperbunkr.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
             x:Class="Paperbunkr.App.Views.DetailScreen"
             x:DataType="vm:DetailScreenViewModel"
             x:Name="Screen">

    <!--
        Series Detail (comic), rebuilt on the shared DetailHero / DetailBand / DetailTabs controls
        for UI rework Phase 5 (docs/superpowers/specs/2026-08-28-detail-screens-streaming-redesign-
        design.md). The tab strip is not sticky - Avalonia has no native sticky positioning and the
        design's Risks section allows a non-sticky fallback.
    -->
    <UserControl.Styles>
        <Style Selector="ComboBox.contentTypePicker">
            <Setter Property="Background" Value="{DynamicResource PbAccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="9,1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PbAccentTextBrush}" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="0,0,0,50">
            <Button Classes="backLink" Command="{Binding GoBackCommand}" Content="← Back to Library" Margin="28,20,28,12" />

            <views:DetailHero DataContext="{Binding}" />

            <views:DetailBand DataContext="{Binding Band}">
                <views:DetailBand.LeadingContent>
                    <ComboBox Classes="contentTypePicker"
                              ItemsSource="{Binding #Screen.((vm:DetailScreenViewModel)DataContext).ContentTypeOptions}"
                              SelectedItem="{Binding #Screen.((vm:DetailScreenViewModel)DataContext).SelectedContentType}"
                              ToolTip.Tip="Content Type" />
                </views:DetailBand.LeadingContent>
            </views:DetailBand>

            <views:DetailTabs DataContext="{Binding Tabs}" Margin="28,0,28,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
