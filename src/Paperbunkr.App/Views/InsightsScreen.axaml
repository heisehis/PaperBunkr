<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:stats="using:Paperbunkr.App.Views.Stats"
             xmlns:meta="using:Paperbunkr.Data.Metadata"
             xmlns:sp="using:ScottPlot.Avalonia"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:views="using:Paperbunkr.App.Views"
             xmlns:plugins="using:Paperbunkr.App.Plugins"
             xmlns:controls="using:Paperbunkr.App.Controls"
             xmlns:insights="using:Paperbunkr.App.Views.Insights"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="900"
             x:Class="Paperbunkr.App.Views.InsightsScreen"
             x:DataType="vm:InsightsScreenViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.sectionLabel">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style Selector="Border.attnCard">
            <Setter Property="Width" Value="272" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="TextBlock.cardHeading">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PbAccentBrush}" />
        </Style>
        <Style Selector="TextBlock.bigNumber">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
        </Style>
        <Style Selector="TextBlock.sub">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.hlTitle">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <!-- A hero tile whose whole face is a Button: the Button fills the card (the card has no padding of its own), so the keyboard focus ring is drawn on the card's edge instead of inside
             its padding. -->
        <Style Selector="Border.heroTile.faceButton">
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Border.heroTile.faceButton > Button.attnRow">
            <Setter Property="Padding" Value="14,18" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadius}" />
        </Style>
        <Style Selector="Button.attnRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="TextBlock.panelTitle">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="Button.filterChip">
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <Style Selector="Button.filterRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <!-- Today (docs/superpowers/specs/2026-10-20-insights-today-redesign-design.md): the spotlight banner, its wash over the blurred cover, and a shelf item. -->
        <Style Selector="Border.todaySpotlight">
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusLg}" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Background" Value="{DynamicResource PbSurface1Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="164" />
            <Setter Property="MaxHeight" Value="260" />
        </Style>
        <!-- Goal tint: a soft wash at the top of a goal tile, by state - ongoing (accent), completed (success), missed (danger). -->
        <Style Selector="Border.goalTile">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0.0" Color="{DynamicResource PbAccentSoftColor}" />
                    <GradientStop Offset="1.0" Color="{DynamicResource PbSurface1Color}" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Border.goalTile.done">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0.0" Color="{DynamicResource PbSuccessSoftColor}" />
                    <GradientStop Offset="1.0" Color="{DynamicResource PbSurface1Color}" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Border.goalTile.missed">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0.0" Color="{DynamicResource PbDangerSoftColor}" />
                    <GradientStop Offset="1.0" Color="{DynamicResource PbSurface1Color}" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Border.todayWash">
            <Setter Property="Background" Value="{DynamicResource PbSurface1Brush}" />
            <Setter Property="Opacity" Value="0.78" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Button.shelfItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </UserControl.Styles>

    <!-- Cover-shelf items for the Today tiles: a 76x110 cover with its title and a short detail underneath. -->
    <UserControl.Resources>
        <DataTemplate x:Key="ShelfSeries" x:DataType="vm:AttentionRow">
            <Button Classes="attnRow shelfItem" ToolTip.Tip="{Binding Subtitle}"
                    Command="{Binding $parent[ItemsControl].((vm:InsightsScreenViewModel)DataContext).OpenSeriesCommand}" CommandParameter="{Binding SeriesId}">
                <StackPanel Width="84" Spacing="4">
                    <views:CoverThumb Width="76" Height="110" HorizontalAlignment="Left" CoverKey="{Binding CoverKey}" />
                    <TextBlock Text="{Binding Title}" Classes="hlTitle" TextWrapping="Wrap" MaxLines="2" />
                    <TextBlock Text="{Binding ShortSubtitle}" Classes="sub" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="ShelfResume" x:DataType="vm:AttentionRow">
            <Button Classes="attnRow shelfItem" ToolTip.Tip="{Binding Subtitle}"
                    Command="{Binding $parent[ItemsControl].((vm:InsightsScreenViewModel)DataContext).OpenContinueCommand}" CommandParameter="{Binding}">
                <StackPanel Width="84" Spacing="4">
                    <views:CoverThumb Width="76" Height="110" HorizontalAlignment="Left" CoverKey="{Binding CoverKey}" />
                    <TextBlock Text="{Binding Title}" Classes="hlTitle" TextWrapping="Wrap" MaxLines="2" />
                    <TextBlock Text="{Binding ShortSubtitle}" Classes="sub" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="ShelfRecommendation" x:DataType="vm:InsightsRecommendationCard">
            <Button Classes="attnRow shelfItem" ToolTip.Tip="{Binding Explanation}"
                    Command="{Binding $parent[ItemsControl].((vm:InsightsScreenViewModel)DataContext).OpenSeriesCommand}" CommandParameter="{Binding Card.SeriesId}">
                <StackPanel Width="84" Spacing="4">
                    <views:CoverThumb Width="76" Height="110" HorizontalAlignment="Left" CoverKey="{Binding Card.CoverKey}" />
                    <TextBlock Text="{Binding Card.Name}" Classes="hlTitle" TextWrapping="Wrap" MaxLines="2" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <!-- One horizontal bar row (label, bar, value) shared by the rhythm-free Trends cards: stall points, storage by type / publisher. -->
    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:BarRowView">
            <Grid ColumnDefinitions="90,*,64" ColumnSpacing="10" Margin="0,2">
                <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="sub" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1" Height="6" Minimum="0" Maximum="1" Value="{Binding Fraction}"
                             Foreground="{DynamicResource PbAccentBrush}" Background="{DynamicResource PbSurface3Brush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding ValueText}" Classes="sub" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Fixed header -->
        <TextBlock Classes="pbTextHeading" Grid.Row="0" Text="Insights"
                   Margin="24,20,24,10" />

        <!-- Tab strip + (Stats-only) range selector -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="24,0,24,14">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="20">
                <Button Classes="tab" Classes.active="{Binding IsTodayTabSelected}" Content="Today" Command="{Binding SelectTodayTabCommand}" />
                <Button Classes="tab" Classes.active="{Binding IsTrendsTabSelected}" Content="Trends" Command="{Binding SelectTrendsTabCommand}" />
                <Button Classes="tab" Classes.active="{Binding IsHistoryTabSelected}" Content="History" Command="{Binding SelectHistoryTabCommand}" />
                <Button Classes="tab" Classes.active="{Binding IsRecapTabSelected}" Content="Recap" Command="{Binding SelectRecapTabCommand}"
                        IsVisible="{Binding IsRecapAvailable}" />
            </StackPanel>
            <ItemsControl Grid.Column="1" ItemsSource="{Binding Stats.RangeOptions}" VerticalAlignment="Center" IsVisible="{Binding IsTrendsTabSelected}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RangeOption">
                        <Button Classes="filterChip" Content="{Binding Label}"
                                Classes.active="{Binding IsActive}"
                                Command="{Binding $parent[ItemsControl].((vm:InsightsScreenViewModel)DataContext).Stats.SetRangeCommand}"
                                CommandParameter="{Binding Value}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl Grid.Column="1" ItemsSource="{Binding Recap.YearOptions}" VerticalAlignment="Center" IsVisible="{Binding IsRecapTabSelected}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:YearOption">
                        <Button Classes="filterChip" Content="{Binding Label}"
                                Classes.active="{Binding IsActive}"
                                Command="{Binding $parent[ItemsControl].((vm:InsightsScreenViewModel)DataContext).Recap.SetSelectedYearCommand}"
                                CommandParameter="{Binding Value}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Today tab -->
        <ScrollViewer Grid.Row="2" IsVisible="{Binding IsTodayTabSelected}" controls:Replace.On="{Binding IsTodayTabSelected}">
            <StackPanel Margin="24,8,24,28" Spacing="20">

                <!-- Today's top row (docs/superpowers/specs/2026-10-20-insights-today-redesign-design.md): a spotlight on what you are continuing
                     (or, only when there is nothing to continue, the top recommendation) beside the hero goal. Each part disappears when it has
                     nothing to show; the whole row collapses via HeroRowEmpty only when all of them do. -->
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Button Grid.Column="1" Classes="attnRow" Command="{Binding AddGoalCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <fi:SymbolIcon Symbol="Add" FontSize="{StaticResource PbIconSizeXs}" />
                                <TextBlock Text="Add goal" Classes="sub" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Classes="card" IsVisible="{Binding HeroRowEmpty}">
                        <TextBlock Text="Nothing to highlight yet — add a reading goal, or start something from the Library." Classes="sub" />
                    </Border>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding !HeroRowEmpty}">
                        <Border Grid.Column="0" Classes="todaySpotlight" IsVisible="{Binding HasSpotlight}">
                            <Panel>
                                <!-- The backdrop is as tall as the content, not its own natural size (a UniformToFill cover as wide as the banner is far taller). -->
                                <views:CoverThumb CoverKey="{Binding SpotlightCoverKey}" Opacity="0.55" Effect="blur(32)" IsHitTestVisible="False"
                                                  VerticalAlignment="Top" Height="{Binding #SpotlightContent.Bounds.Height}" />
                                <Border Classes="todayWash" />
                                <Border x:Name="SpotlightContent" Padding="20">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
                                    <views:CoverThumb Grid.Column="0" Width="84" Height="124" CoverKey="{Binding SpotlightCoverKey}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Classes="cardHeading" Text="{Binding SpotlightHeading}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="pbTextHeading" FontSize="36" LineHeight="42" Text="{Binding SpotlightTitle}" TextWrapping="Wrap" MaxLines="2"
                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SpotlightTitle}" />
                                        <TextBlock Classes="sub" Text="{Binding SpotlightSubtitle}" TextTrimming="CharacterEllipsis" />
                                        <Button Classes="primary" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding OpenSpotlightCommand}"
                                                AutomationProperties.AutomationId="InsightsSpotlightButton">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <fi:SymbolIcon Symbol="Play" IconVariant="Filled" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbBadgeTextBrush}"
                                                               IsVisible="{Binding SpotlightIsContinue}" />
                                                <TextBlock Text="{Binding SpotlightActionLabel}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                </Border>
                            </Panel>
                        </Border>
                        <Border Grid.Column="0" Classes="card" IsVisible="{Binding !HasSpotlight}" VerticalAlignment="Center">
                            <TextBlock Text="Nothing to continue — start something from the Library." Classes="sub" />
                        </Border>

                        <Border Grid.Column="1" Classes="heroTile inert goalTile" Classes.missed="{Binding Goals.HeroGoal.IsMissed}" Classes.done="{Binding Goals.HeroGoal.IsCompleted}"
                                Width="280" IsVisible="{Binding Goals.HasGoals}">
                            <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Classes="cardHeading" Text="YOUR GOAL" HorizontalAlignment="Center" />
                                <stats:GoalRing HorizontalAlignment="Center" Percent="{Binding Goals.HeroGoal.Percent}"
                                                Outcome="{Binding Goals.HeroGoal.Outcome}" IsBehind="{Binding Goals.HeroGoal.IsBehind}" />
                                <TextBlock HorizontalAlignment="Center" FontFamily="Consolas,monospace" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PbTextBrush}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0:N0} / {1:N0}">
                                            <Binding Path="Goals.HeroGoal.CurrentValue" />
                                            <Binding Path="Goals.HeroGoal.Target" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Classes="hlTitle" Text="{Binding Goals.HeroGoal.Title}" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="sub" Text="{Binding Goals.HeroGoal.StatusText}" TextAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Goals beyond the hero pick (docs/superpowers/specs/2026-09-23-insights-redesign-
                     design.md) - same card/ring/delete template slice 4 originally shipped on Overview,
                     just scoped to whatever isn't already the hero tile above. -->
                <StackPanel IsVisible="{Binding Goals.HasSecondaryGoals}">
                    <TextBlock Classes="sectionLabel" Text="OTHER GOALS" />
                    <ItemsControl ItemsSource="{Binding Goals.SecondaryCards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GoalCardViewModel">
                                <Border Classes="card attnCard goalTile" Classes.missed="{Binding IsMissed}" Classes.done="{Binding IsCompleted}">
                                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <stats:GoalRing Grid.Column="0" Percent="{Binding Percent}" Outcome="{Binding Outcome}" IsBehind="{Binding IsBehind}" />
                                            <Button AutomationProperties.Name="Delete goal" Grid.Column="1" Classes="iconButton sm" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Command="{Binding $parent[ItemsControl].((vm:InsightsScreenViewModel)DataContext).Goals.DeleteGoalCommand}"
                                                    CommandParameter="{Binding}">
                                                <fi:SymbolIcon Symbol="Delete" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbTextMutedBrush}" />
                                            </Button>
                                        </Grid>
                                        <TextBlock Classes="hlTitle" Text="{Binding Title}" TextAlignment="Center" />
                                        <TextBlock Classes="sub" Text="{Binding StatusText}" TextAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Completed and Missed goals (docs/superpowers/specs/2026-10-04-insights-goal-outcomes-and-chart-colour-design.md):
                     kept as history, collapsed behind a header unless there is nothing active to show instead. Renew
                     opens the goal editor pre-filled; Delete is the same confirmed path as on an active card. -->
                <StackPanel IsVisible="{Binding Goals.HasPastGoals}">
                    <Button Classes="attnRow" Command="{Binding Goals.TogglePastGoalsCommand}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="sectionLabel" Text="PAST GOALS" Margin="0" VerticalAlignment="Center" />
                            <TextBlock Classes="sub" Text="{Binding Goals.PastCards.Count, StringFormat='({0})'}" VerticalAlignment="Center" />
                            <fi:SymbolIcon Symbol="ChevronDown" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbTextMutedBrush}"
                                           IsVisible="{Binding !Goals.PastGoalsOpen}" />
                            <fi:SymbolIcon Symbol="ChevronUp" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbTextMutedBrush}"
                                           IsVisible="{Binding Goals.PastGoalsOpen}" />
                        </StackPanel>
                    </Button>
                    <ItemsControl ItemsSource="{Binding Goals.PastCards}" IsVisible="{Binding Goals.PastGoalsOpen}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GoalCardViewModel">
                                <Border Classes="card attnCard goalTile" Classes.missed="{Binding IsMissed}" Classes.done="{Binding IsCompleted}">
                                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <stats:GoalRing Grid.Column="0" Percent="{Binding Percent}" Outcome="{Binding Outcome}" IsBehind="{Binding IsBehind}" />
                                            <Button AutomationProperties.Name="Delete goal" Grid.Column="1" Classes="iconButton sm" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Command="{Binding $parent[ItemsControl].((vm:InsightsScreenViewModel)DataContext).Goals.DeleteGoalCommand}"
                                                    CommandParameter="{Binding}">
                                                <fi:SymbolIcon Symbol="Delete" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbTextMutedBrush}" />
                                            </Button>
                                        </Grid>
                                        <TextBlock Classes="hlTitle" Text="{Binding Title}" TextAlignment="Center" />
                                        <TextBlock Classes="sub" Text="{Binding StatusText}" TextAlignment="Center" />
                                        <Button Classes="attnRow" HorizontalAlignment="Center"
                                                Command="{Binding $parent[ItemsControl].((vm:InsightsScreenViewModel)DataContext).Goals.RenewGoalCommand}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <fi:SymbolIcon Symbol="ArrowClockwise" FontSize="{StaticResource PbIconSizeXs}" />
                                                <TextBlock Text="Renew" Classes="sub" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Shelf tiles (docs/superpowers/specs/2026-10-20-insights-today-redesign-design.md §4): equal-width columns that follow the window,
                     a hidden tile freeing its slot. Each tile is a cover shelf - one row of covers, the ones that do not fit are hidden by the wall. -->
                <controls:ResponsiveColumnsPanel MinColumnWidth="340" MaxColumns="3" Gap="12">
                    <Border Classes="card" IsVisible="{Binding ReadingSectionEmpty}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <fi:SymbolIcon Symbol="CheckmarkCircle" Foreground="{DynamicResource PbSuccessBrush}" />
                            <TextBlock Text="Nothing else needs attention — check Continuing above, or start anything from the Library." Classes="sub" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Classes="card" IsVisible="{Binding !AlmostDoneEmpty}">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="cardHeading" Text="ALMOST DONE" />
                                <TextBlock Classes="sub" Text="{Binding AlmostDoneCount, StringFormat='· {0}'}" />
                            </StackPanel>
                            <TextBlock Classes="sub" Text="A couple of issues from finishing." />
                            <controls:CollapsibleTagWall CollapsedRows="1" ItemsSource="{Binding AlmostDoneRows}" ItemTemplate="{StaticResource ShelfSeries}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="card" IsVisible="{Binding !DiveInEmpty}">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="cardHeading" Text="DIVE IN" />
                                <TextBlock Classes="sub" Text="{Binding DiveInCount, StringFormat='· {0}'}" />
                            </StackPanel>
                            <TextBlock Classes="sub" Text="Full runs you own and haven't started." />
                            <controls:CollapsibleTagWall CollapsedRows="1" ItemsSource="{Binding DiveInRows}" ItemTemplate="{StaticResource ShelfSeries}" />
                        </StackPanel>
                    </Border>

                    <!-- Every recommendation, the top pick included: the old "More because you finished" list folded in. -->
                    <Border Classes="card" IsVisible="{Binding HasRecommendations}">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="cardHeading" Text="{Binding RecommendationsSeedName, StringFormat='BECAUSE YOU FINISHED {0}'}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="sub" Text="More from the same collection." />
                            <controls:CollapsibleTagWall CollapsedRows="1" ItemsSource="{Binding Recommendations}" ItemTemplate="{StaticResource ShelfRecommendation}" />
                        </StackPanel>
                    </Border>

                    <!-- Drop-off watch (docs/superpowers/specs/2026-10-06-smart-features-design.md §4.3): series now one issue short of where
                         you usually stop. A nudge; the tile is absent until there is a pattern and something near it. -->
                    <Border Classes="card" IsVisible="{Binding HasDropOff}" AutomationProperties.AutomationId="InsightsDropOffCard">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="cardHeading" Text="DROP-OFF WATCH" />
                            <TextBlock Classes="sub" Text="{Binding DropOffHeadline}" TextWrapping="Wrap" />
                            <controls:CollapsibleTagWall CollapsedRows="1" ItemsSource="{Binding DropOffRows}" ItemTemplate="{StaticResource ShelfResume}" />
                        </StackPanel>
                    </Border>
                </controls:ResponsiveColumnsPanel>

                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="panelTitle" Text="Collection health" Margin="0" />
                            <TextBlock Grid.Column="1" Classes="bigNumber" FontSize="18" Text="{Binding GapCount}" IsVisible="{Binding !GapEmpty}" />
                        </Grid>
                        <TextBlock Classes="sub" Text="{Binding GapLine}" />
                        <ItemsControl ItemsSource="{Binding GapRows}" IsVisible="{Binding !GapEmpty}" Margin="0,4,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><controls:ResponsiveColumnsPanel MinColumnWidth="260" MaxColumns="4" Gap="12" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:GapRow">
                                    <Button Classes="attnRow"
                                            Command="{Binding $parent[ItemsControl].((vm:InsightsScreenViewModel)DataContext).OpenSeriesCommand}"
                                            CommandParameter="{Binding SeriesId}">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <views:CoverThumb Grid.Column="0" Width="28" Height="40" CoverKey="{Binding CoverKey}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" Classes="hlTitle" />
                                                <TextBlock Text="{Binding Missing}" Classes="sub" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Native plugins' cards (Plugin API 4.5, docs/superpowers/specs/2026-10-28-plugin-api-4-5-pitch-completion-design.md §E):
                     the host draws the card and its title; the plugin supplies only the content. -->
                <ItemsControl ItemsSource="{Binding PluginWidgets}" IsVisible="{Binding HasPluginWidgets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="16" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="plugins:PluginView">
                            <Border Classes="card">
                                <StackPanel Spacing="12">
                                    <TextBlock Classes="pbTextTitle" Text="{Binding PluginName}" />
                                    <ContentControl Content="{Binding View}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- Trends tab -->
        <ScrollViewer Grid.Row="2" IsVisible="{Binding IsTrendsTabSelected}" controls:Replace.On="{Binding IsTrendsTabSelected}">
            <StackPanel Margin="24,8,24,28" Spacing="16">

                <!-- Trends group pill sub-nav (docs/superpowers/specs/2026-09-23-insights-redesign-
                     design.md) - a pure display-side partition of the cards below into three groups,
                     no resolver/data change. -->
                <ItemsControl ItemsSource="{Binding Stats.TrendsGroupOptions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TrendsGroupOption">
                            <Button Classes="filterChip" Content="{Binding Label}" Classes.active="{Binding IsActive}"
                                    Command="{Binding $parent[ItemsControl].((vm:InsightsScreenViewModel)DataContext).Stats.SetTrendsGroupCommand}"
                                    CommandParameter="{Binding Value}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel IsVisible="{Binding Stats.IsActivityGroupSelected}">
                    <TextBlock Classes="sectionLabel" Text="HIGHLIGHTS" />
                    <UniformGrid Columns="3" Rows="2">
                        <Border Classes="card" Margin="0,0,10,10">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto"><TextBlock Grid.Column="0" Classes="panelTitle" Text="Highest rated" Margin="0" /><TextBlock Grid.Column="1" Classes="bigNumber" Text="{Binding Stats.Snapshot.Highlights.HighestRated.Detail}" /></Grid>
                                <TextBlock Classes="hlTitle" Text="{Binding Stats.Snapshot.Highlights.HighestRated.DisplayTitle, FallbackValue='Not enough data yet'}" />
                            </StackPanel>
                        </Border>
                        <Border Classes="card" Margin="0,0,10,10">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto"><TextBlock Grid.Column="0" Classes="panelTitle" Text="Most reread" Margin="0" /><TextBlock Grid.Column="1" Classes="bigNumber" Text="{Binding Stats.Snapshot.Highlights.MostReread.Detail}" /></Grid>
                                <TextBlock Classes="hlTitle" Text="{Binding Stats.Snapshot.Highlights.MostReread.DisplayTitle, FallbackValue='—'}" />
                            </StackPanel>
                        </Border>
                        <Border Classes="card" Margin="0,0,0,10">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto"><TextBlock Grid.Column="0" Classes="panelTitle" Text="Longest journey" Margin="0" /><TextBlock Grid.Column="1" Classes="bigNumber" Text="{Binding Stats.Snapshot.Highlights.LongestJourney.Detail}" /></Grid>
                                <TextBlock Classes="hlTitle" Text="{Binding Stats.Snapshot.Highlights.LongestJourney.DisplayTitle, FallbackValue='—'}" />
                            </StackPanel>
                        </Border>
                        <Border Classes="card" Margin="0,0,10,0">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto"><TextBlock Grid.Column="0" Classes="panelTitle" Text="Fastest completion" Margin="0" /><TextBlock Grid.Column="1" Classes="bigNumber" Text="{Binding Stats.Snapshot.Highlights.FastestCompletion.Detail}" /></Grid>
                                <TextBlock Classes="hlTitle" Text="{Binding Stats.Snapshot.Highlights.FastestCompletion.DisplayTitle, FallbackValue='—'}" />
                            </StackPanel>
                        </Border>
                        <Border Classes="card" Margin="0,0,10,0">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto"><TextBlock Grid.Column="0" Classes="panelTitle" Text="Plan to read" Margin="0" /><TextBlock Grid.Column="1" Classes="bigNumber" Text="{Binding Stats.Snapshot.Highlights.PlanToReadCount}" /></Grid>
                                <TextBlock Classes="sub" Text="series" />
                            </StackPanel>
                        </Border>
                        <Border Classes="card">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto"><TextBlock Grid.Column="0" Classes="panelTitle" Text="Zero progress" Margin="0" /><TextBlock Grid.Column="1" Classes="bigNumber" Text="{Binding Stats.Snapshot.Highlights.ZeroProgressCount}" /></Grid>
                                <TextBlock Classes="sub" Text="added, never started" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>

                <StackPanel IsVisible="{Binding Stats.IsActivityGroupSelected}">
                    <TextBlock Classes="sectionLabel" Text="READING ACTIVITY" />
                    <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="10">
                        <Border Grid.Column="0" Classes="card"><StackPanel Spacing="6"><TextBlock Classes="panelTitle" Text="Read all time" /><TextBlock Classes="bigNumber" Text="{Binding Stats.Snapshot.Lifetime.ItemsRead, FallbackValue=0}" /><TextBlock Classes="sub"><TextBlock.Text><MultiBinding StringFormat="{}{0} pages · {1} series"><Binding Path="Stats.Snapshot.Lifetime.PagesRead" FallbackValue="0" /><Binding Path="Stats.Snapshot.Lifetime.SeriesRead" FallbackValue="0" /></MultiBinding></TextBlock.Text></TextBlock></StackPanel></Border>
                        <Border Grid.Column="1" Classes="card"><StackPanel Spacing="6"><TextBlock Classes="panelTitle" Text="Day streak" /><TextBlock Classes="bigNumber" Text="{Binding Stats.Snapshot.ReadingDayStreak.Current, FallbackValue=0}" /><TextBlock Classes="sub" Text="{Binding Stats.Snapshot.ReadingDayStreak.Longest, StringFormat='best {0}', FallbackValue=''}" /></StackPanel></Border>
                        <Border Grid.Column="2" Classes="card"><StackPanel Spacing="6"><TextBlock Classes="panelTitle" Text="Finish streak" /><TextBlock Classes="bigNumber" Text="{Binding Stats.Snapshot.FinishStreak.Current, FallbackValue=0}" /><TextBlock Classes="sub" Text="{Binding Stats.Snapshot.FinishStreak.Longest, StringFormat='best {0}', FallbackValue=''}" /></StackPanel></Border>
                        <Border Grid.Column="3" Classes="card">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="panelTitle" Text="Finished · range" />
                                <TextBlock Classes="bigNumber" Text="{Binding Stats.Snapshot.FinishedInRange.Items, FallbackValue=0}" />
                                <TextBlock Classes="sub" Text="{Binding Stats.Snapshot.FinishedInRange.Pages, StringFormat='{}{0} pages', FallbackValue=''}" />
                                <StackPanel Orientation="Horizontal" Spacing="3" IsVisible="{Binding Stats.FinishedTrend, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                                    <fi:SymbolIcon Symbol="ArrowUp" FontSize="{StaticResource PbIconSizeXs}" IsVisible="{Binding Stats.FinishedTrend.IsUp}" Foreground="{Binding Stats.FinishedTrend.IsGood, Converter={x:Static views:TrendBrushConverter.Instance}}" />
                                    <fi:SymbolIcon Symbol="ArrowDown" FontSize="{StaticResource PbIconSizeXs}" IsVisible="{Binding !Stats.FinishedTrend.IsUp}" Foreground="{Binding Stats.FinishedTrend.IsGood, Converter={x:Static views:TrendBrushConverter.Instance}}" />
                                    <TextBlock Classes="sub" Text="{Binding Stats.FinishedTrend.Text}" />
                                </StackPanel>
                                <stats:TrendSparkline Height="20" Data="{Binding Stats.FinishedTrend.Sparkline}" IsVisible="{Binding Stats.FinishedTrend, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Classes="card">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="panelTitle" Text="Avg to finish" />
                                <TextBlock Classes="bigNumber" Text="{Binding Stats.Snapshot.ReadingActivity.AvgDaysToComplete, StringFormat='{}{0:0.#}d', FallbackValue='—'}" />
                                <TextBlock Classes="sub" Text="days, real sessions only" />
                                <StackPanel Orientation="Horizontal" Spacing="3" IsVisible="{Binding Stats.AvgToFinishTrend, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                                    <fi:SymbolIcon Symbol="ArrowUp" FontSize="{StaticResource PbIconSizeXs}" IsVisible="{Binding Stats.AvgToFinishTrend.IsUp}" Foreground="{Binding Stats.AvgToFinishTrend.IsGood, Converter={x:Static views:TrendBrushConverter.Instance}}" />
                                    <fi:SymbolIcon Symbol="ArrowDown" FontSize="{StaticResource PbIconSizeXs}" IsVisible="{Binding !Stats.AvgToFinishTrend.IsUp}" Foreground="{Binding Stats.AvgToFinishTrend.IsGood, Converter={x:Static views:TrendBrushConverter.Instance}}" />
                                    <TextBlock Classes="sub" Text="{Binding Stats.AvgToFinishTrend.Text}" />
                                </StackPanel>
                                <stats:TrendSparkline Height="20" Data="{Binding Stats.AvgToFinishTrend.Sparkline}" IsVisible="{Binding Stats.AvgToFinishTrend, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="5" Classes="card">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="panelTitle" Text="Pace" />
                                <TextBlock Classes="bigNumber" Text="{Binding Stats.Snapshot.ReadingActivity.AvgIssuesPerDay, StringFormat='{}{0:0.00}', FallbackValue='—'}" />
                                <TextBlock Classes="sub" Text="issues/day, this range" />
                                <StackPanel Orientation="Horizontal" Spacing="3" IsVisible="{Binding Stats.PaceTrend, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                                    <fi:SymbolIcon Symbol="ArrowUp" FontSize="{StaticResource PbIconSizeXs}" IsVisible="{Binding Stats.PaceTrend.IsUp}" Foreground="{Binding Stats.PaceTrend.IsGood, Converter={x:Static views:TrendBrushConverter.Instance}}" />
                                    <fi:SymbolIcon Symbol="ArrowDown" FontSize="{StaticResource PbIconSizeXs}" IsVisible="{Binding !Stats.PaceTrend.IsUp}" Foreground="{Binding Stats.PaceTrend.IsGood, Converter={x:Static views:TrendBrushConverter.Instance}}" />
                                    <TextBlock Classes="sub" Text="{Binding Stats.PaceTrend.Text}" />
                                </StackPanel>
                                <stats:TrendSparkline Height="20" Data="{Binding Stats.PaceTrend.Sparkline}" IsVisible="{Binding Stats.PaceTrend, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <Border Classes="card" IsVisible="{Binding Stats.IsActivityGroupSelected}">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="panelTitle" Text="Activity heatmap" />
                        <Panel Height="110">
                            <stats:ActivityHeatmap Data="{Binding Stats.Snapshot.Heatmap}" IsVisible="{Binding Stats.HasHeatmapData}" />
                            <TextBlock Text="Not enough history yet — check back after a few reading sessions."
                                       Classes="sub" VerticalAlignment="Center" HorizontalAlignment="Center"
                                       IsVisible="{Binding !Stats.HasHeatmapData}" />
                        </Panel>
                    </StackPanel>
                </Border>

                <!-- Reading rhythm (docs/superpowers/specs/2026-10-12-insights-pitch-completion-design.md §1) -->
                <Border Classes="card" IsVisible="{Binding Stats.IsActivityGroupSelected}">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="panelTitle" Text="Reading rhythm" />
                        <StackPanel Spacing="8" IsVisible="{Binding Stats.HasRhythmChart}">
                            <stats:RhythmHeatmap Data="{Binding Stats.Rhythm}" HorizontalAlignment="Left" />
                            <TextBlock Classes="sub" Text="{Binding Stats.RhythmPeakText}" />
                            <TextBlock Classes="sub" FontWeight="SemiBold" Text="Session length" IsVisible="{Binding Stats.HasSessionLengths}" />
                            <ItemsControl ItemsSource="{Binding Stats.Rhythm.LengthBuckets}" IsVisible="{Binding Stats.HasSessionLengths}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="meta:SessionLengthBucket">
                                        <Grid ColumnDefinitions="64,*,40" Margin="0,2">
                                            <TextBlock Grid.Column="0" Classes="sub" Text="{Binding Label}" VerticalAlignment="Center" />
                                            <ProgressBar Grid.Column="1" Height="6" Minimum="0" Value="{Binding Count}"
                                                         Maximum="{Binding $parent[ItemsControl].((vm:InsightsScreenViewModel)DataContext).Stats.RhythmLengthMax}"
                                                         Foreground="{DynamicResource PbAccentBrush}" Background="{DynamicResource PbSurface3Brush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Classes="sub" Text="{Binding Count}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="sub" Text="{Binding Stats.RhythmTypicalText}" />
                            <TextBlock Classes="sub" Text="{Binding Stats.RhythmCoverageText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Text="Not enough reading history yet — check back after a few reading sessions."
                                   Classes="sub" IsVisible="{Binding Stats.RhythmIsEmpty}" />
                    </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding Stats.IsActivityGroupSelected}">
                    <Border Grid.Column="0" Classes="card">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Classes="panelTitle" Text="Library growth" Margin="0,0,10,0" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" IsVisible="{Binding Stats.HasGrowthData}">
                                    <ItemsControl ItemsSource="{Binding Stats.GrowthMeasureOptions}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:GrowthMeasureOption">
                                                <Button Classes="filterChip" Content="{Binding Label}" Classes.active="{Binding IsActive}"
                                                        Command="{Binding $parent[ItemsControl].((vm:InsightsScreenViewModel)DataContext).Stats.SetGrowthMeasureCommand}"
                                                        CommandParameter="{Binding Value}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                            <!-- Stack-by (Reading state/Media type/Content rating) removed 2026-09-24 -
                                 cramming 3-6 overlaid lines plus a big wrapping legend into one small
                                 card was the real problem the user pushed back on twice (a genuine
                                 ScottPlot legend-panel leak made it worse, fixed separately, but the
                                 chart was still the wrong shape for this data). Composition breakdowns
                                 now live in their own donut/bar cards below (Reading state, Media type,
                                 Content rating all have one) instead of being squeezed in here too -
                                 this chart is just the overall growth trend now, single line, no legend. -->
                            <Panel Height="160">
                                <sp:AvaPlot x:Name="GrowthChart" IsVisible="{Binding Stats.HasGrowthData}" />
                                <TextBlock Text="Nothing added yet." Classes="sub" VerticalAlignment="Center" HorizontalAlignment="Center"
                                           IsVisible="{Binding !Stats.HasGrowthData}" />
                            </Panel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="card">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="panelTitle" Text="Reading pace" />
                            <Panel Height="140">
                                <sp:AvaPlot x:Name="PaceChart" IsVisible="{Binding Stats.HasPaceData}" />
                                <TextBlock Text="Not enough history yet." Classes="sub" VerticalAlignment="Center" HorizontalAlignment="Center"
                                           IsVisible="{Binding !Stats.HasPaceData}" />
                            </Panel>
                            <TextBlock Classes="sub" Text="issues finished per period" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Classes="card" IsVisible="{Binding Stats.IsActivityGroupSelected}">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="panelTitle" Text="Backlog burn-down" />
                        <Panel Height="140">
                            <sp:AvaPlot x:Name="BurnDownChart" IsVisible="{Binding Stats.HasBurnDownData}" />
                            <TextBlock Text="Not enough history yet - check back in a few days." Classes="sub"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding !Stats.HasBurnDownData}" />
                        </Panel>
                        <TextBlock Classes="sub" Text="{Binding Stats.BurnDownStatusText}" IsVisible="{Binding Stats.HasBurnDownData}" />
                    </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding Stats.IsCompositionGroupSelected}">
                    <Border Grid.Column="0" Classes="card">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="panelTitle" Text="Reading state" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <stats:CategoryDonut x:Name="ReadingStateDonut" Grid.Column="0" Width="100" Height="100" Kind="ReadingState"
                                                     Slices="{Binding Stats.Snapshot.Breakdown.ByReadingStatus}" />
                                <stats:DonutLegend Grid.Column="1" VerticalAlignment="Center" Kind="ReadingState"
                                                   Slices="{Binding Stats.Snapshot.Breakdown.ByReadingStatus}"
                                                   HoveredIndex="{Binding #ReadingStateDonut.HoveredIndex, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="card">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="panelTitle" Text="Media type" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <stats:CategoryDonut x:Name="MediaTypeDonut" Grid.Column="0" Width="100" Height="100"
                                                     Slices="{Binding Stats.Snapshot.Breakdown.ByMediaType}" />
                                <stats:DonutLegend Grid.Column="1" VerticalAlignment="Center"
                                                   Slices="{Binding Stats.Snapshot.Breakdown.ByMediaType}"
                                                   HoveredIndex="{Binding #MediaTypeDonut.HoveredIndex, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding Stats.IsCompositionGroupSelected}">
                    <Border Grid.Column="0" Classes="card">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="panelTitle" Text="Score distribution" />
                            <Panel Height="140">
                                <sp:AvaPlot x:Name="RatingsChart" IsVisible="{Binding Stats.HasRatings}" />
                                <TextBlock Text="No ratings yet." Classes="sub" VerticalAlignment="Center" HorizontalAlignment="Center"
                                           IsVisible="{Binding !Stats.HasRatings}" />
                            </Panel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="card">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="panelTitle" Text="Content rating" />
                            <!-- Donut added 2026-09-24 to match Reading state/Media type's own
                                 treatment above - same Slices shape (IReadOnlyList&lt;CompositionSlice&gt;)
                                 already feeds the bar list below, no new binding path needed. -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <!-- The bars are the legend: same palette layout as the donut, so each bar wears its slice's colour
                                     (all-ages green -> teen blue -> mature amber -> adults red; Unknown neutral). 10 slices so every
                                     rating stays its own row rather than folding into "Other". -->
                                <stats:CategoryDonut x:Name="ContentRatingDonut" Grid.Column="0" Width="100" Height="100" Kind="ContentRating" MaxSlices="10"
                                                     Slices="{Binding Stats.Snapshot.ContentRating}" />
                                <stats:DonutLegend Grid.Column="1" VerticalAlignment="Center" Kind="ContentRating" MaxSlices="10" ShowBars="True"
                                                   Slices="{Binding Stats.Snapshot.ContentRating}"
                                                   HoveredIndex="{Binding #ContentRatingDonut.HoveredIndex, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Classes="card" IsVisible="{Binding Stats.IsCompositionGroupSelected}">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="panelTitle" Text="Publication year" />
                        <Panel Height="140">
                            <sp:AvaPlot x:Name="PublicationYearChart" IsVisible="{Binding Stats.HasPublicationYearData}" />
                            <TextBlock Text="No publication years recorded yet." Classes="sub" VerticalAlignment="Center" HorizontalAlignment="Center"
                                       IsVisible="{Binding !Stats.HasPublicationYearData}" />
                        </Panel>
                    </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding Stats.IsTopListsGroupSelected}">
                    <Border Grid.Column="0" Classes="card">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="panelTitle" Text="Top genres" />
                            <ItemsControl ItemsSource="{Binding Stats.Snapshot.Composition.ByGenre}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="meta:CompositionSlice">
                                        <Button Classes="filterRow"
                                                Command="{Binding $parent[ItemsControl].((vm:InsightsScreenViewModel)DataContext).Stats.OpenLibraryFilterCommand}"
                                                CommandParameter="{Binding Label}">
                                            <Grid ColumnDefinitions="96,*,Auto" Margin="0,2">
                                                <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="sub" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <ProgressBar Grid.Column="1" Minimum="0" Maximum="{Binding $parent[ItemsControl].((vm:InsightsScreenViewModel)DataContext).Stats.TopGenresMax}"
                                                             Value="{Binding Count}" Height="8" Margin="6,0" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Count}" Classes="sub" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="card">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="panelTitle" Text="Top tags" />
                            <ItemsControl ItemsSource="{Binding Stats.Snapshot.Composition.ByTags}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="meta:CompositionSlice">
                                        <Button Classes="filterRow"
                                                Command="{Binding $parent[ItemsControl].((vm:InsightsScreenViewModel)DataContext).Stats.OpenLibraryFilterCommand}"
                                                CommandParameter="{Binding Label}">
                                            <Grid ColumnDefinitions="96,*,Auto" Margin="0,2">
                                                <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="sub" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <ProgressBar Grid.Column="1" Minimum="0" Maximum="{Binding $parent[ItemsControl].((vm:InsightsScreenViewModel)DataContext).Stats.TopTagsMax}"
                                                             Value="{Binding Count}" Height="8" Margin="6,0" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Count}" Classes="sub" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Where you stop (design §2) -->
                <Border Classes="card" IsVisible="{Binding Stats.IsCompositionGroupSelected}">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Classes="panelTitle" Text="Where you stop" Margin="0,0,0,2" />
                                <TextBlock Classes="sub" Text="{Binding Stats.DropOffSummary}" IsVisible="{Binding Stats.HasDropOff}" />
                            </StackPanel>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Stats.DropOffDimensionOptions}" VerticalAlignment="Top">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DropOffDimensionOption">
                                        <Button Classes="filterChip" Content="{Binding Label}" Classes.active="{Binding IsActive}"
                                                Command="{Binding $parent[ItemsControl].((vm:InsightsScreenViewModel)DataContext).Stats.SetDropOffDimensionCommand}"
                                                CommandParameter="{Binding Value}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        <StackPanel Spacing="8" IsVisible="{Binding Stats.HasDropOff}">
                            <ItemsControl ItemsSource="{Binding Stats.DropOffRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DropOffRowView">
                                        <Button Classes="filterRow" IsEnabled="{Binding CanFilter}"
                                                Command="{Binding $parent[ItemsControl].((vm:InsightsScreenViewModel)DataContext).Stats.OpenLibraryFilterCommand}"
                                                CommandParameter="{Binding Label}">
                                            <Grid ColumnDefinitions="150,*,Auto" ColumnSpacing="10" Margin="0,2">
                                                <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="sub" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <ProgressBar Grid.Column="1" Height="6" Minimum="0" Maximum="1" Value="{Binding StoppedFraction}"
                                                             Foreground="{DynamicResource PbDangerBrush}" Background="{DynamicResource PbSuccessBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Text}" Classes="sub" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="sub" FontWeight="SemiBold" Text="Where they stalled (issues read before stopping)" />
                            <ItemsControl ItemsSource="{Binding Stats.DropOffStallBars}" />
                            <TextBlock Classes="sub" Text="Red is the share you stopped, green the share you finished. All time; groups with fewer than 5 decided series are folded into Other." TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Classes="sub" Text="Not enough finished or stopped series yet." IsVisible="{Binding !Stats.HasDropOff}" />
                    </StackPanel>
                </Border>

                <!-- Storage (design §4) -->
                <Border Classes="card" IsVisible="{Binding Stats.IsCompositionGroupSelected}">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="panelTitle" Text="Storage" Margin="0,0,0,2" />
                        <StackPanel Spacing="10" IsVisible="{Binding Stats.HasStorage}">
                            <StackPanel>
                                <TextBlock FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PbTextBrush}" Text="{Binding Stats.StorageTotalText}" />
                                <TextBlock Classes="sub" Text="{Binding Stats.StorageSubText}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Classes="sub" FontWeight="SemiBold" Text="By file type" />
                                    <ItemsControl ItemsSource="{Binding Stats.StorageTypeRows}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Classes="sub" FontWeight="SemiBold" Text="By publisher" />
                                    <ItemsControl ItemsSource="{Binding Stats.StoragePublisherRows}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Spacing="4">
                                <TextBlock Classes="sub" FontWeight="SemiBold" Text="Largest files" />
                                <ItemsControl ItemsSource="{Binding Stats.StorageLargestRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LargeFileRowView">
                                            <Button Classes="filterRow"
                                                    Command="{Binding $parent[ItemsControl].((vm:InsightsScreenViewModel)DataContext).Stats.OpenLargeFileCommand}"
                                                    CommandParameter="{Binding}">
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                    <TextBlock Grid.Column="0" Text="{Binding Title}" Classes="sub" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Text}" Classes="sub" VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Stats.HasReclaimable}">
                                <TextBlock Grid.Column="0" Classes="sub" Text="{Binding Stats.ReclaimableText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="filterChip" Content="Review duplicates" Margin="12,0,0,0"
                                        IsVisible="{Binding Stats.CanReviewDuplicates}" Command="{Binding Stats.ReviewDuplicatesCommand}" />
                            </Grid>
                        </StackPanel>
                        <TextBlock Classes="sub" Text="No file sizes yet — scan or refresh your library so Paperbunkr can measure your files."
                                   TextWrapping="Wrap" IsVisible="{Binding !Stats.HasStorage}" />
                    </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" IsVisible="{Binding Stats.IsTopListsGroupSelected}">
                    <Border Grid.Column="0" Classes="card">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="panelTitle" Text="Top publishers" />
                            <ItemsControl ItemsSource="{Binding Stats.Snapshot.Composition.ByPublisher}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="meta:CompositionSlice">
                                        <Button Classes="filterRow"
                                                Command="{Binding $parent[ItemsControl].((vm:InsightsScreenViewModel)DataContext).Stats.OpenLibraryFilterCommand}"
                                                CommandParameter="{Binding Label}">
                                            <!-- Publisher logo in a fixed-width slot so the names stay aligned whether or not a publisher has
                                                 one. Only a real logo is shown: with none the mark would fall back to plain text, which just
                                                 repeats the label beside it (same rule as the Continuity list). -->
                                            <Grid ColumnDefinitions="40,*,Auto" Margin="0,2">
                                                <controls:BrandMark Grid.Column="0" Family="Publisher" Value="{Binding Label}" MarkSize="16" MaxMarkWidth="34"
                                                                    ShowText="False" EnsureContrast="True" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <controls:BrandMark.IsVisible>
                                                        <MultiBinding Converter="{x:Static conv:BoolConverters.Or}">
                                                            <Binding Path="IsImage" RelativeSource="{RelativeSource Self}" />
                                                            <Binding Path="IsRaster" RelativeSource="{RelativeSource Self}" />
                                                        </MultiBinding>
                                                    </controls:BrandMark.IsVisible>
                                                </controls:BrandMark>
                                                <TextBlock Grid.Column="1" Text="{Binding Label}" Classes="sub" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Count}" Classes="sub" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="card">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="panelTitle" Text="Top authors" />
                            <ItemsControl ItemsSource="{Binding Stats.Snapshot.TopAuthors}" IsVisible="{Binding Stats.HasTopAuthors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="meta:CompositionSlice">
                                        <Button Classes="filterRow"
                                                Command="{Binding $parent[ItemsControl].((vm:InsightsScreenViewModel)DataContext).Stats.OpenLibraryFilterCommand}"
                                                CommandParameter="{Binding Label}">
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="sub" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Count}" Classes="sub" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No credited writers yet." Classes="sub" IsVisible="{Binding !Stats.HasTopAuthors}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="card">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="panelTitle" Text="Top artists" />
                            <ItemsControl ItemsSource="{Binding Stats.Snapshot.TopArtists}" IsVisible="{Binding Stats.HasTopArtists}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="meta:CompositionSlice">
                                        <Button Classes="filterRow"
                                                Command="{Binding $parent[ItemsControl].((vm:InsightsScreenViewModel)DataContext).Stats.OpenLibraryFilterCommand}"
                                                CommandParameter="{Binding Label}">
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="sub" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Count}" Classes="sub" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No credited artists yet." Classes="sub" IsVisible="{Binding !Stats.HasTopArtists}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- You love these (design §3) -->
                <Border Classes="card" IsVisible="{Binding Stats.IsTopListsGroupSelected}">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Classes="panelTitle" Text="You love these" Margin="0,0,0,2" />
                                <TextBlock Classes="sub" Text="Ranked by your average rating × how much of their work you've read. Comics and manga, all time." TextWrapping="Wrap" />
                            </StackPanel>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Stats.AffinityDimensionOptions}" VerticalAlignment="Top">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AffinityDimensionOption">
                                        <Button Classes="filterChip" Content="{Binding Label}" Classes.active="{Binding IsActive}"
                                                Command="{Binding $parent[ItemsControl].((vm:InsightsScreenViewModel)DataContext).Stats.SetAffinityDimensionCommand}"
                                                CommandParameter="{Binding Value}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Stats.AffinityRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AffinityRowView">
                                    <Button Classes="filterRow"
                                            Command="{Binding $parent[ItemsControl].((vm:InsightsScreenViewModel)DataContext).Stats.OpenLibraryFilterCommand}"
                                            CommandParameter="{Binding Name}">
                                        <Grid ColumnDefinitions="180,*,Auto" ColumnSpacing="10" Margin="0,2">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" Classes="sub" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <ProgressBar Grid.Column="1" Height="6" Minimum="0" Maximum="1" Value="{Binding Fraction}"
                                                         Foreground="{DynamicResource PbAccentBrush}" Background="{DynamicResource PbSurface3Brush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Text}" Classes="sub" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="sub" TextWrapping="Wrap" IsVisible="{Binding Stats.AffinityRowsEmpty}"
                                   Text="Nothing to rank yet. A creator or publisher needs at least 3 series and 3 rated issues." />
                    </StackPanel>
                </Border>

                <!-- You vs Community (docs/superpowers/specs/2026-10-26-you-vs-community-and-chapter-alignment-design.md Part 2) -->
                <Border Classes="card" IsVisible="{Binding Stats.IsTopListsGroupSelected}">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Classes="panelTitle" Text="You vs Community" Margin="0,0,0,2" />
                                <TextBlock Classes="sub" Text="Your rating of each series against the community's, both out of 100. Above the line you rate it higher than they do." TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="ghost" VerticalAlignment="Top" Command="{Binding Stats.FetchCommunityRatingsCommand}" AutomationProperties.AutomationId="FetchCommunityRatingsButton">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <fi:SymbolIcon Symbol="ArrowSync" FontSize="{StaticResource PbIconSizeXs}" />
                                    <TextBlock Text="{Binding Stats.FetchCommunityLabel}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <sp:AvaPlot x:Name="CommunityChart" Height="300" IsVisible="{Binding Stats.HasCommunityChart}" />
                        <TextBlock Classes="sub" TextWrapping="Wrap" IsVisible="{Binding Stats.CommunityIsEmpty}" Text="{Binding Stats.CommunityEmptyText}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="24" IsVisible="{Binding Stats.HasCommunityChart}">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Classes="sub" Text="YOU RATE HIGHER" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding Stats.CommunityHigherRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CommunityDisagreementRow">
                                            <Button Classes="filterRow" Command="{Binding $parent[ItemsControl].((vm:InsightsScreenViewModel)DataContext).Stats.OpenCommunitySeriesCommand}" CommandParameter="{Binding}">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,2">
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Classes="sub" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Text}" Classes="sub" VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Classes="sub" Text="YOU RATE LOWER" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding Stats.CommunityLowerRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CommunityDisagreementRow">
                                            <Button Classes="filterRow" Command="{Binding $parent[ItemsControl].((vm:InsightsScreenViewModel)DataContext).Stats.OpenCommunitySeriesCommand}" CommandParameter="{Binding}">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,2">
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Classes="sub" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Text}" Classes="sub" VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                        <TextBlock Classes="sub" TextWrapping="Wrap" Text="{Binding Stats.CommunityCoverageText}" />
                    </StackPanel>
                </Border>

                <TextBlock Classes="sub" Text="Pages for reflowed EPUBs are estimated at ~1,800 characters per page. Highlights and pace reflect real reading sessions logged since 2026-09-05; earlier history was backfilled from a single timestamp per item and is excluded from journey-length records." />
            </StackPanel>
        </ScrollViewer>

        <!-- Recap tab (docs/superpowers/specs/2026-09-23-insights-year-in-review-recap-design.md, layout
             revised 2026-09-24 per on-screen feedback - the original one-slide-at-a-time card on an
             otherwise-empty full-width screen wasted almost the whole tab. All 9 stats now show at once
             in a single grid instead of paging through them; Items Finished keeps a headline-sized spot
             (row-span 2, wide column) the way it did as slide 1/poster tile 0. -->
        <!-- History tab (docs/superpowers/specs/2026-09-29-insights-reading-history-design.md §4). Not inside a
             ScrollViewer: its ListBox scrolls itself, and nesting would defeat virtualization. The Panel carries
             IsVisible so that binding still resolves against this screen, not the History DataContext. -->
        <Panel Grid.Row="2" IsVisible="{Binding IsHistoryTabSelected}" controls:Replace.On="{Binding IsHistoryTabSelected}" Margin="24,0,24,12">
            <insights:InsightsHistoryView DataContext="{Binding History}" />
        </Panel>

        <ScrollViewer Grid.Row="2" IsVisible="{Binding IsRecapTabSelected}" controls:Replace.On="{Binding IsRecapTabSelected}">
            <StackPanel Margin="24,8,24,28" Spacing="16">

                <Grid ColumnDefinitions="1.4*,*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12" MaxWidth="900">
                    <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Classes="card">
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <TextBlock Classes="cardHeading" Text="{Binding Recap.ItemsFinishedTile.Label}" />
                            <TextBlock FontSize="44" FontWeight="Black" Foreground="{DynamicResource PbTextBrush}"
                                       Text="{Binding Recap.ItemsFinishedTile.Value}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Grid.Row="0" Classes="card">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="cardHeading" Text="{Binding Recap.TopSeriesTile.Label}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <views:CoverThumb Width="28" Height="40" CoverKey="{Binding Recap.TopSeriesTile.CoverKey}"
                                                   IsVisible="{Binding Recap.TopSeriesTile.CoverKey, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                                <TextBlock Classes="hlTitle" Text="{Binding Recap.TopSeriesTile.Value}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Grid.Row="0" Classes="card">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="cardHeading" Text="{Binding Recap.HighestRatedTile.Label}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <views:CoverThumb Width="28" Height="40" CoverKey="{Binding Recap.HighestRatedTile.CoverKey}"
                                                   IsVisible="{Binding Recap.HighestRatedTile.CoverKey, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                                <TextBlock Classes="hlTitle" Text="{Binding Recap.HighestRatedTile.Value}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Grid.Row="1" Classes="card">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="cardHeading" Text="{Binding Recap.PagesReadTile.Label}" />
                            <TextBlock Classes="bigNumber" Text="{Binding Recap.PagesReadTile.Value}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Grid.Row="1" Classes="card">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="cardHeading" Text="{Binding Recap.LongestStreakTile.Label}" />
                            <TextBlock Classes="bigNumber" Text="{Binding Recap.LongestStreakTile.Value}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="0" Grid.Row="2" Classes="card">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="cardHeading" Text="{Binding Recap.MostRereadTile.Label}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <views:CoverThumb Width="28" Height="40" CoverKey="{Binding Recap.MostRereadTile.CoverKey}"
                                                   IsVisible="{Binding Recap.MostRereadTile.CoverKey, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                                <TextBlock Classes="hlTitle" Text="{Binding Recap.MostRereadTile.Value}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Grid.Row="2" Classes="card">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="cardHeading" Text="{Binding Recap.TopWriterTile.Label}" />
                            <TextBlock Classes="hlTitle" Text="{Binding Recap.TopWriterTile.Value}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Grid.Row="2" Classes="card">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="cardHeading" Text="{Binding Recap.TopArtistTile.Label}" />
                            <TextBlock Classes="hlTitle" Text="{Binding Recap.TopArtistTile.Value}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="0" Grid.Row="3" Classes="card">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="cardHeading" Text="{Binding Recap.BusiestDayTile.Label}" />
                            <TextBlock Classes="hlTitle" Text="{Binding Recap.BusiestDayTile.Value}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Button Classes="filterChip" HorizontalAlignment="Left" Click="OnExportPosterClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <fi:SymbolIcon Symbol="ArrowExport" FontSize="{StaticResource PbIconSizeXs}" />
                        <TextBlock Text="Export" />
                    </StackPanel>
                </Button>

                <!-- Always present, invisible - RenderTargetBitmap needs a real attached control to render
                     (see this file's code-behind), so RecapPosterView is added here only for the duration
                     of an export and removed immediately after. -->
                <Panel x:Name="PosterExportHost" Opacity="0" IsHitTestVisible="False" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
