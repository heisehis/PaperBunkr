<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Paperbunkr.App.ViewModels"
        xmlns:local="using:Paperbunkr.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="512" d:DesignHeight="372"
        x:Class="Paperbunkr.App.Views.SplashWindow"
        x:DataType="vm:SplashViewModel"
        Title="Paperbunkr"
        Width="512" Height="372"
        CanResize="False"
        WindowDecorations="None"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <!--
        The startup splash (docs/superpowers/specs/2026-10-22-splash-theme-redesign-design.md). It shows before the database is ready, so the
        constructor picks a SplashPalette from splash-theme.json (the theme this launch will open with, Auto mode included) and writes it into
        this window's own Resources under the usual Pb* keys. Everything below is token-coloured, so a light theme gets a light splash.

        The window is transparent and 16 px larger than the 480x340 card on every side, so the card can have rounded corners and a shadow.

        The entrance + breathing motion is driven from code-behind (Animation.RunAsync from Opened), not XAML style animations - see the
        code-behind's summary for why.
    -->
    <Border x:Name="Card" Margin="16"
            Background="{DynamicResource PbSurface1Brush}"
            BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1"
            CornerRadius="{DynamicResource PbRadiusLg}"
            BoxShadow="{DynamicResource PbElevationShadow}"
            ClipToBounds="True">
        <Grid RowDefinitions="*,Auto,Auto">
            <!-- Ambient drifting dots (docs/superpowers/specs/2026-09-21-cosmetics-pitch-design.md #6), behind everything else. -->
            <local:AmbientDotsOverlay x:Name="AmbientDots" Grid.RowSpan="3" />

            <!-- Lockup: emblem with its glow, then the name and tagline. -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24,0,0">
                <Panel Width="152" Height="152">
                    <Border x:Name="GlowBorder" Opacity="0.35">
                        <Border.Background>
                            <RadialGradientBrush GradientOrigin="50%,50%" Center="50%,50%" RadiusX="50%" RadiusY="50%">
                                <GradientStop Color="Transparent" Offset="0" />
                                <GradientStop Color="Transparent" Offset="0.72" />
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    <Image x:Name="LogoImage" Width="104" Height="104" Opacity="0" AutomationProperties.Name="Paperbunkr"
                           RenderTransformOrigin="50%,50%"
                           Source="avares://Paperbunkr.App/Assets/paperbunkr-logo-splash.png" />
                </Panel>
                <StackPanel VerticalAlignment="Center" Spacing="4">
                    <TextBlock Classes="pbTextHero" Text="Paperbunkr" />
                    <TextBlock Classes="pbTextMeta" Text="Your comics. Your machine" />
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="16,0,16,12">
                <TextBlock Grid.Column="0" Classes="pbTextMeta" Text="{Binding StatusMessage}" AutomationProperties.LiveSetting="Polite"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="pbTextCaption" Text="{Binding VersionText}"
                           Margin="12,0,0,0" VerticalAlignment="Center" />
            </Grid>

            <ProgressBar x:Name="LoadingBar" Grid.Row="2" Height="3" MinHeight="0" CornerRadius="0"
                         Minimum="0" Maximum="1" Value="{Binding Progress}"
                         Background="{DynamicResource PbBorderBrush}" ShowProgressText="False">
                <!-- The Value transition is added in code (Replace role, PbMotionEase): the motion resources may not be loaded yet. -->
                <ProgressBar.Foreground>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Color="Transparent" Offset="0" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </LinearGradientBrush>
                </ProgressBar.Foreground>
            </ProgressBar>
        </Grid>
    </Border>
</Window>
