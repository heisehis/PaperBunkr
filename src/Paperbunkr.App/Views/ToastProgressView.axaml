<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="280"
             x:Class="Paperbunkr.App.Views.ToastProgressView"
             x:DataType="vm:ToastProgressViewModel">

    <StackPanel Spacing="6" Width="260">
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                   Foreground="{DynamicResource PbTextBrush}" />
        <TextBlock Foreground="{DynamicResource PbTextFaintBrush}" FontSize="12">
            <Run Text="{Binding Done}" /><Run Text=" / " /><Run Text="{Binding Total}" /><Run Text=" comics" />
        </TextBlock>
        <ProgressBar Minimum="0" Maximum="1" Value="{Binding Fraction}" Height="4" CornerRadius="2" />
    </StackPanel>
</UserControl>
