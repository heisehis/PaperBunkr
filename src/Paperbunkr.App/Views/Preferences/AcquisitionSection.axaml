<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:controls="using:Paperbunkr.App.Controls"
             xmlns:pref="using:Paperbunkr.App.Views.Preferences"
             xmlns:beh="using:Paperbunkr.App.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="680" d:DesignHeight="720"
             x:Class="Paperbunkr.App.Views.Preferences.AcquisitionSection"
             x:DataType="vm:AcquisitionSettingsViewModel">

    <!-- Preferences -> Acquisition (docs/superpowers/specs/2026-09-19-comic-acquisition-daemon-design.md 7). Same section
         shell as Automation: one ScrollViewer, SettingsRow rows, Pb* tokens only (no hardcoded colors). Groups: Prowlarr, ComicVine,
         Searching, qBittorrent, Import, Automatic downloads. One view model, one Save; the status line repeats beside each action. -->
    <ScrollViewer>
        <StackPanel Margin="28,20,28,40" Spacing="20">
            <TextBlock Classes="pbTextHeading" Text="Acquisition" />

            <TextBlock Text="Find missing and upcoming comics through your own Prowlarr and download them with your own qBittorrent. You approve each release unless you turn on automatic downloads. Paperbunkr ships with no indexers — you bring your own."
                       FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" />

            <pref:SettingsRow Icon="Search" Title="Look for comics automatically"
                               Description="While Paperbunkr is open, check your wanted issues on the interval below. Every check shows in the Activity Center. Off by default.">
                <pref:SettingsRow.SettingsContent>
                    <ToggleSwitch IsChecked="{Binding Enabled}" OnContent="{x:Null}" OffContent="{x:Null}"
                                  AutomationProperties.Name="Look for comics automatically"
                                  AutomationProperties.AutomationId="AcquisitionEnabledToggle" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>

            <StackPanel Tag="acquisition.connections">
                <TextBlock Classes="settingsGroupCaption" Text="CONNECTIONS" />
                <pref:SettingsRow Icon="Link" Title="Prowlarr, qBittorrent and ComicVine"
                                   Description="Their addresses, keys and passwords are all managed under Connections, with everything else you connect to.">
                    <pref:SettingsRow.SettingsContent>
                        <Button Classes="headerAction ghost" Content="Open Connections" Command="{Binding OpenConnectionsCommand}"
                                AutomationProperties.AutomationId="AcquisitionOpenConnectionsButton" />
                    </pref:SettingsRow.SettingsContent>
                </pref:SettingsRow>
                <TextBlock Text="{Binding ConnectionsSummary}" FontSize="11.5" Foreground="{DynamicResource PbTextMutedBrush}" TextWrapping="Wrap"
                           MaxWidth="640" HorizontalAlignment="Left" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>

            <StackPanel Tag="acquisition.search">
                <TextBlock Classes="settingsGroupCaption" Text="SEARCHING" />

                <pref:SettingsRow Icon="Clock" Title="Check every (minutes)"
                                   Description="How often wanted issues are searched again. At least 15. If Prowlarr can't be reached, Paperbunkr waits longer between tries.">
                    <pref:SettingsRow.SettingsContent>
                        <TextBox Text="{Binding PollIntervalMinutes}" Width="120" beh:TextSpinner.Enabled="True" beh:TextSpinner.ClampTyped="True" beh:TextSpinner.Minimum="15" beh:TextSpinner.Maximum="1440"
                                       AutomationProperties.Name="Check interval in minutes" />
                    </pref:SettingsRow.SettingsContent>
                </pref:SettingsRow>

                <pref:SettingsRow Icon="ArrowDownload" Title="Smallest release (MB)"
                                   Description="Ignore anything smaller than this. 0 means no minimum.">
                    <pref:SettingsRow.SettingsContent>
                        <TextBox Text="{Binding MinSizeMb}" Width="120" beh:TextSpinner.Enabled="True" beh:TextSpinner.ClampTyped="True" beh:TextSpinner.Minimum="0" beh:TextSpinner.Maximum="100000"
                                       AutomationProperties.Name="Smallest release in megabytes" />
                    </pref:SettingsRow.SettingsContent>
                </pref:SettingsRow>

                <pref:SettingsRow Icon="ArrowDownload" Title="Largest single issue (MB)"
                                   Description="Ignore single issues larger than this. Multi-issue packs are exempt but are never picked automatically. 0 means no limit.">
                    <pref:SettingsRow.SettingsContent>
                        <TextBox Text="{Binding MaxSizeMb}" Width="120" beh:TextSpinner.Enabled="True" beh:TextSpinner.ClampTyped="True" beh:TextSpinner.Minimum="0" beh:TextSpinner.Maximum="100000"
                                       AutomationProperties.Name="Largest single issue in megabytes" />
                    </pref:SettingsRow.SettingsContent>
                </pref:SettingsRow>

                <pref:SettingsRow Icon="Book" Title="Prefer CBZ"
                                   Description="Rank .cbz slightly above .cbr. Paperbunkr reads both.">
                    <pref:SettingsRow.SettingsContent>
                        <ToggleSwitch IsChecked="{Binding PreferCbz}" OnContent="{x:Null}" OffContent="{x:Null}"
                                      AutomationProperties.Name="Prefer CBZ" />
                    </pref:SettingsRow.SettingsContent>
                </pref:SettingsRow>

                <StackPanel Spacing="4" Margin="0,4,0,10">
                    <TextBlock Text="Preferred release groups" FontSize="12" Foreground="{DynamicResource PbTextBrush}" />
                    <TextBox Text="{Binding PreferredReleaseGroups}" Watermark="Comma-separated, e.g. Zone-Empire, Minutemen" Width="520" MaxWidth="520" HorizontalAlignment="Left"
                             AutomationProperties.Name="Preferred release groups" />
                </StackPanel>

                <StackPanel Spacing="4" Margin="0,0,0,10">
                    <TextBlock Text="Ignored words" FontSize="12" Foreground="{DynamicResource PbTextBrush}" />
                    <TextBox Text="{Binding IgnoredWords}" Watermark="Comma-separated; a release whose title has any of them is skipped" Width="520" MaxWidth="520" HorizontalAlignment="Left"
                             AutomationProperties.Name="Ignored words" />
                </StackPanel>

            </StackPanel>

            <!-- QBITTORRENT (slice 2) -->
            <!-- IMPORT (slice 3) -->
            <StackPanel Tag="acquisition.import" Spacing="10">
                <TextBlock Classes="settingsGroupCaption" Text="IMPORT" />
                <TextBlock Text="Finished downloads are copied (your seeding copy is never touched), repacked to .cbz if needed, tagged, named from the template and added to your library."
                           FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" />

                <StackPanel Spacing="4">
                    <TextBlock Text="Destination library folder" FontSize="12" Foreground="{DynamicResource PbTextBrush}" />
                    <controls:SuggestBox Text="{Binding DestinationFolderPath}" Suggestions="{Binding DestinationChoices}" Width="520" HorizontalAlignment="Left"
                                         AutomationProperties.Name="Destination library folder" AutomationProperties.AutomationId="AcquisitionDestination" />
                    <TextBlock Text="Pick one of your library folders. Imports stay pending until one is chosen."
                               FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Naming template" FontSize="12" Foreground="{DynamicResource PbTextBrush}" />
                    <TextBox Text="{Binding RenameTemplate}" Width="520" HorizontalAlignment="Left" AutomationProperties.Name="Naming template"
                             AutomationProperties.AutomationId="AcquisitionTemplate" />
                    <TextBlock Text="{Binding RenameTemplatePreview}" FontSize="11.5" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                               Foreground="{DynamicResource PbTextMutedBrush}" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock FontSize="11.5" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" Foreground="{DynamicResource PbTextFaintBrush}"
                               Text="Tokens go inside braces and angle brackets, like {&lt;series&gt;}. Any text next to a token inside the same braces goes with it and disappears when the value is empty: {(&lt;volumeyear&gt;)}. A digit after a name zero-pads it: {&lt;number3&gt;} gives 007. Common tokens: series, title, volume, volumeyear, number, year, month#, Day, publisher, format, filename. / or \ starts a folder."/>
                    <TextBlock IsVisible="{Binding HasTemplateUpgradeNotice}" Text="{Binding TemplateUpgradeNotice}" FontSize="11.5" TextWrapping="Wrap" MaxWidth="560"
                               HorizontalAlignment="Left" Foreground="{DynamicResource PbDangerBrush}" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>

                <pref:SettingsRow Icon="Document" Title="Write ComicInfo.xml"
                                   Description="Tag imported comics with ComicVine's data for the issue. An archive that already has usable tags is left as it is.">
                    <pref:SettingsRow.SettingsContent>
                        <ToggleSwitch IsChecked="{Binding WriteComicInfo}" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.Name="Write ComicInfo.xml" />
                    </pref:SettingsRow.SettingsContent>
                </pref:SettingsRow>

                <pref:SettingsRow Icon="Tag" Title="Add ComicVine details to downloads"
                                   Description="After an issue is imported, fetch its credits, summary, characters and dates from ComicVine by the issue you asked for, and write them into the file. If it can't be done it is retried, and anything left over appears under Wanted → Needs attention. Needs your ComicVine key (Preferences → Connections).">
                    <pref:SettingsRow.SettingsContent>
                        <ToggleSwitch IsChecked="{Binding ScrapeOnImport}" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.Name="Add ComicVine details to downloaded issues" />
                    </pref:SettingsRow.SettingsContent>
                </pref:SettingsRow>

                <pref:SettingsRow Icon="Delete" Title="Remove the download after importing"
                                   Description="Off keeps the original in qBittorrent so it keeps seeding. On removes the torrent and its files once everything was imported (this ends seeding).">
                    <pref:SettingsRow.SettingsContent>
                        <ToggleSwitch IsChecked="{Binding MoveOriginalOnImport}" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.Name="Remove the download after importing" />
                    </pref:SettingsRow.SettingsContent>
                </pref:SettingsRow>
            </StackPanel>

            <!-- AUTO-GRAB (slice 4) -->
            <StackPanel Tag="acquisition.autograb">
                <TextBlock Classes="settingsGroupCaption" Text="AUTOMATIC DOWNLOADS" />
                <pref:SettingsRow Icon="Play" Title="Download the best match automatically"
                                   Description="Off by default: you approve each release. When on, the best single issue that clears the score below is sent to qBittorrent without asking. Packs are never taken automatically.">
                    <pref:SettingsRow.SettingsContent>
                        <ToggleSwitch IsChecked="{Binding AutoGrab}" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.Name="Download the best match automatically"
                                      AutomationProperties.AutomationId="AcquisitionAutoGrab" />
                    </pref:SettingsRow.SettingsContent>
                </pref:SettingsRow>
                <pref:SettingsRow Icon="Settings" Title="Minimum score"
                                   Description="A release must score at least this to be taken automatically (seeders up to 100, +25 for .cbz, +100 for a preferred group).">
                    <pref:SettingsRow.SettingsContent>
                        <TextBox Text="{Binding AutoGrabMinScore}" Width="120" beh:TextSpinner.Enabled="True" beh:TextSpinner.ClampTyped="True" beh:TextSpinner.Minimum="0" beh:TextSpinner.Maximum="500" AutomationProperties.Name="Minimum score for automatic downloads" />
                    </pref:SettingsRow.SettingsContent>
                </pref:SettingsRow>
            </StackPanel>

            <StackPanel Spacing="8">
                <Button Classes="headerAction primary" Command="{Binding SaveCommand}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <fi:SymbolIcon Symbol="Save" FontSize="{StaticResource PbIconSizeXs}" />
                        <TextBlock Text="Save" />
                    </StackPanel>
                </Button>
                <TextBlock Text="Changes apply when you press Save." FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" />
                <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasErrorStatus}" FontSize="12" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left"
                           Foreground="{DynamicResource PbDangerBrush}" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasInfoStatus}" FontSize="12" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left"
                           Foreground="{DynamicResource PbSuccessBrush}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
