<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:views="using:Paperbunkr.App.Views"
             xmlns:models="using:Paperbunkr.App.Models"
             xmlns:entities="using:Paperbunkr.Data.Entities"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Paperbunkr.App.Views.ReaderScreen"
             x:DataType="vm:ReaderScreenViewModel">

    <UserControl.Resources>
        <SolidColorBrush x:Key="ReaderBgBrush" Color="#0B0C0F" />
        <SolidColorBrush x:Key="ReaderChromeBrush" Color="#15171C" />
        <SolidColorBrush x:Key="ReaderRailBrush" Color="#101216" />
        <SolidColorBrush x:Key="ReaderBorderBrush" Color="#24272E" />
        <SolidColorBrush x:Key="ReaderTextBrush" Color="#E7E2D6" />
        <SolidColorBrush x:Key="ReaderTextMutedBrush" Color="#8B8779" />
        <SolidColorBrush x:Key="ReaderTrackBrush" Color="#2A2D34" />
        <!-- Fullscreen overlay panels (§7) - semi-transparent so they read as a HUD floating over the page, not another opaque chrome bar. -->
        <SolidColorBrush x:Key="ReaderOverlayBrush" Color="#CC15171C" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.thumb">
            <Setter Property="Width" Value="80" />
            <Setter Property="Height" Value="112" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.thumb.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
        </Style>

        <!-- Fullscreen scrubber overlay's thumbnails (§7) - same shape as Border.thumb, smaller and horizontally-margined for a thin bottom strip instead of a tall side rail. -->
        <Style Selector="Border.scrubberThumb">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="72" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.scrubberThumb.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
        </Style>

        <Style Selector="Button.toolPill">
            <Setter Property="Background" Value="#1E2127" />
            <Setter Property="BorderBrush" Value="#33373F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource ReaderTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.toolPill.active">
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbAccentTextBrush}" />
        </Style>
        <Style Selector="Button.toolIcon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource ReaderTextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.flyoutRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Background="{StaticResource ReaderBgBrush}" PointerMoved="OnReaderPointerMoved">

        <!-- ============ Top toolbar ============ -->
        <Border Grid.Row="0" Background="{StaticResource ReaderChromeBrush}" BorderBrush="{StaticResource ReaderBorderBrush}"
                BorderThickness="0,0,0,1" Padding="18,10" IsVisible="{Binding !IsFullscreen}">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                <Button Grid.Column="0" Command="{Binding GoBackCommand}" Background="Transparent" BorderThickness="0"
                        Padding="0" Cursor="Hand" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{Binding BreadcrumbSeries, StringFormat='← {0}'}" FontSize="12"
                                   Foreground="{StaticResource ReaderTextMutedBrush}" />
                        <TextBlock Text="{Binding IssueTitle}" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource ReaderTextBrush}" />
                    </StackPanel>
                </Button>

                <!-- Reading-mode picker: 4 options (docs/superpowers/specs/2026-08-10-reader-polish-continuous-scroll-chrome-overlays-design.md §4 - continuous mode needs a real way in, not just the binary LTR/RTL toggle) -->
                <Button Grid.Column="1" Content="{Binding ReadingModeLabel}"
                        Background="#1E2127" BorderBrush="#33373F" Cursor="Hand"
                        BorderThickness="1" Foreground="{StaticResource ReaderTextBrush}" FontSize="12" FontWeight="SemiBold"
                        Padding="10,6" CornerRadius="6" Margin="0,0,8,0">
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Width="170">
                                <Button Classes="flyoutRow" Content="Left to Right" Command="{Binding SetReadingModeCommand}" CommandParameter="{x:Static entities:ReadingMode.LeftToRight}" />
                                <Button Classes="flyoutRow" Content="Right to Left" Command="{Binding SetReadingModeCommand}" CommandParameter="{x:Static entities:ReadingMode.RightToLeft}" />
                                <Button Classes="flyoutRow" Content="Vertical (Continuous)" Command="{Binding SetReadingModeCommand}" CommandParameter="{x:Static entities:ReadingMode.VerticalContinuous}" />
                                <Button Classes="flyoutRow" Content="Horizontal (Continuous)" Command="{Binding SetReadingModeCommand}" CommandParameter="{x:Static entities:ReadingMode.HorizontalContinuous}" />
                                <Button Classes="flyoutRow" Content="Horizontal RTL (Continuous)" Command="{Binding SetReadingModeCommand}" CommandParameter="{x:Static entities:ReadingMode.HorizontalContinuousRightToLeft}" />
                                <Button Classes="flyoutRow" Content="Webtoon" Command="{Binding SetReadingModeCommand}" CommandParameter="{x:Static entities:ReadingMode.Webtoon}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- Fit-mode picker (docs/superpowers/specs/2026-08-10-reader-polish-core-viewing-controls-design.md §5) - hidden in continuous mode, which has no fit-mode concept (spec §5). -->
                <Button Grid.Column="2" Classes="toolPill" Content="{Binding FitMode}" Margin="0,0,8,0" ToolTip.Tip="Fit mode"
                        IsVisible="{Binding !IsContinuousMode}">
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Width="150">
                                <Button Classes="flyoutRow" Content="Original" Command="{Binding SetFitModeCommand}" CommandParameter="{x:Static entities:ImageFitMode.Original}" />
                                <Button Classes="flyoutRow" Content="Fit All" Command="{Binding SetFitModeCommand}" CommandParameter="{x:Static entities:ImageFitMode.Fit}" />
                                <Button Classes="flyoutRow" Content="Fit Width" Command="{Binding SetFitModeCommand}" CommandParameter="{x:Static entities:ImageFitMode.FitWidth}" />
                                <Button Classes="flyoutRow" Content="Fit Height" Command="{Binding SetFitModeCommand}" CommandParameter="{x:Static entities:ImageFitMode.FitHeight}" />
                                <Button Classes="flyoutRow" Content="Best Fit" Command="{Binding SetFitModeCommand}" CommandParameter="{x:Static entities:ImageFitMode.BestFit}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- Zoom control: -/percentage(preset flyout)/+, plus a direct slider (continuous mode's explicit ask, spec §5 - free zoom needs a non-gestural control too) -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" Margin="0,0,8,0">
                    <Button Classes="toolIcon" Content="−" Command="{Binding ZoomOutCommand}" ToolTip.Tip="Zoom out" />
                    <Button Classes="toolPill" Content="{Binding ZoomLevel, StringFormat={}{0:P0}}" Padding="8,6" ToolTip.Tip="Zoom presets">
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <StackPanel Width="100">
                                    <Button Classes="flyoutRow" Content="100%" Command="{Binding SetZoom100Command}" />
                                    <Button Classes="flyoutRow" Content="125%" Command="{Binding SetZoom125Command}" />
                                    <Button Classes="flyoutRow" Content="150%" Command="{Binding SetZoom150Command}" />
                                    <Button Classes="flyoutRow" Content="200%" Command="{Binding SetZoom200Command}" />
                                    <Button Classes="flyoutRow" Content="400%" Command="{Binding SetZoom400Command}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Classes="toolIcon" Content="+" Command="{Binding ZoomInCommand}" ToolTip.Tip="Zoom in" />
                    <Slider IsVisible="{Binding IsContinuousMode}" Width="100" Minimum="0.5" Maximum="4" Value="{Binding ZoomLevel}"
                            VerticalAlignment="Center" Margin="4,0,0,0" ToolTip.Tip="Zoom" />
                </StackPanel>

                <Button Grid.Column="4" Classes="toolIcon" Content="⟳" Command="{Binding RotateClockwiseCommand}" Margin="0,0,4,0" ToolTip.Tip="Rotate 90°" />

                <Button Grid.Column="5" Classes="toolPill" Classes.active="{Binding AutoRotate}" Content="Auto-rotate"
                        Command="{Binding ToggleAutoRotateCommand}" Margin="0,0,16,0" ToolTip.Tip="Auto-rotate landscape pages" />

                <TextBlock Grid.Column="6" Text="{Binding PageLabel}" FontFamily="Consolas,monospace" FontSize="12"
                           Foreground="{StaticResource ReaderTextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />

                <!-- Live image adjustment (docs/superpowers/specs/2026-08-10-reader-polish-continuous-scroll-chrome-overlays-design.md §9) - a flyout panel extending the existing toolbar, same pattern as fit-mode/zoom above rather than a new full-screen panel. -->
                <Button Grid.Column="7" Classes="toolPill" Content="Adjust" Margin="0,0,8,0" ToolTip.Tip="Brightness / contrast / saturation / gamma">
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Width="220" Spacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Brightness, StringFormat='Brightness: {0:F0}'}" FontSize="12"
                                               Foreground="{StaticResource ReaderTextBrush}" />
                                    <Slider Minimum="-100" Maximum="100" Value="{Binding Brightness}" />
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Contrast, StringFormat='Contrast: {0:F0}'}" FontSize="12"
                                               Foreground="{StaticResource ReaderTextBrush}" />
                                    <Slider Minimum="-100" Maximum="100" Value="{Binding Contrast}" />
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Saturation, StringFormat='Saturation: {0:F0}'}" FontSize="12"
                                               Foreground="{StaticResource ReaderTextBrush}" />
                                    <Slider Minimum="-100" Maximum="100" Value="{Binding Saturation}" />
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Gamma, StringFormat='Gamma: {0:F0}'}" FontSize="12"
                                               Foreground="{StaticResource ReaderTextBrush}" />
                                    <Slider Minimum="-100" Maximum="100" Value="{Binding Gamma}" />
                                </StackPanel>
                                <Button Classes="flyoutRow" Content="Reset to defaults" Command="{Binding ResetAdjustmentCommand}"
                                        HorizontalContentAlignment="Center" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- Fullscreen toggle (docs/superpowers/specs/2026-08-10-reader-polish-continuous-scroll-chrome-overlays-design.md §7) - F/F11 also work regardless of this button, this is purely for discoverability. -->
                <Button Grid.Column="8" Classes="toolIcon" Content="⛶" Command="{Binding ToggleFullscreenCommand}"
                        ToolTip.Tip="Fullscreen (F)" />
            </Grid>
        </Border>

        <!-- ============ Body: thumbnail rail + page ============ -->
        <Grid x:Name="ReaderBodyGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Index 0's Width collapsed to 0 in fullscreen by ReaderScreen.axaml.cs - a fixed-pixel column doesn't shrink from the rail Border's own IsVisible alone. -->
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource ReaderRailBrush}" BorderBrush="{StaticResource ReaderBorderBrush}"
                    BorderThickness="0,0,1,0" IsVisible="{Binding !IsFullscreen}">
                <ScrollViewer Padding="8,10">
                    <ItemsControl x:Name="ThumbnailsItemsControl" ItemsSource="{Binding Thumbnails}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ReaderThumbnailSample">
                                <Border Classes="thumb" Classes.selected="{Binding IsSelected}" Background="{Binding CoverBrush}"
                                        Cursor="Hand" PointerPressed="OnThumbnailPointerPressed">
                                    <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Background (docs/superpowers/specs/2026-08-10-reader-polish-continuous-scroll-chrome-overlays-design.md §10) - Auto keeps today's fixed dark background (ReaderScreenViewModel.DefaultCanvasBackgroundBrush), Color overrides it with the user's chosen AppSettings.BackgroundColor. -->
            <Grid Grid.Column="1" Background="{Binding CanvasBackgroundBrush}">
                <views:PageCanvas x:Name="PageCanvasControl"
                                  Page="{Binding CurrentPage}"
                                  LeftCommand="{Binding GoLeftCommand}"
                                  RightCommand="{Binding GoRightCommand}"
                                  HighQualityDisplay="{Binding HighQualityPageDisplay}"
                                  LeftKey="{Binding PageTurnLeftKey}"
                                  RightKey="{Binding PageTurnRightKey}"
                                  ZoomLevel="{Binding ZoomLevel}"
                                  PanOffsetX="{Binding PanOffsetX}"
                                  PanOffsetY="{Binding PanOffsetY}"
                                  FitMode="{Binding FitMode}"
                                  FitOnlyIfOversized="True"
                                  ManualRotationDegrees="{Binding ManualRotationDegrees}"
                                  AutoRotate="{Binding AutoRotate}"
                                  WheelPanStep="{Binding MouseWheelSpeed}"
                                  ReadingMode="{Binding EffectiveReadingMode}"
                                  Decoder="{Binding Decoder}"
                                  PageCount="{Binding PageCount}"
                                  ScrollOffset="{Binding ScrollOffset}"
                                  CurrentContinuousPageIndex="{Binding CurrentContinuousPageIndex}"
                                  FullscreenToggleCommand="{Binding ToggleFullscreenCommand}"
                                  Brightness="{Binding Brightness}"
                                  Contrast="{Binding Contrast}"
                                  Saturation="{Binding Saturation}"
                                  Gamma="{Binding Gamma}"
                                  PageMarginMultiplier="{Binding PageMarginMultiplier}"
                                  IsVisible="{Binding !HasError}" />

                <Border IsVisible="{Binding HasError}" Width="400" CornerRadius="8"
                        Background="{StaticResource ReaderChromeBrush}" BorderBrush="{StaticResource ReaderBorderBrush}"
                        BorderThickness="1" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ErrorMessage}" FontSize="13" Foreground="{StaticResource ReaderTextMutedBrush}"
                               TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
                </Border>

                <!-- ============ Fullscreen overlays (§7) - status text + scrubber, replace the collapsed toolbar/rail/bottom-bar while fullscreen, auto-hiding on cursor idle ============ -->
                <Border IsVisible="{Binding ShowFullscreenOverlays}" VerticalAlignment="Top" HorizontalAlignment="Center"
                        Margin="0,20,0,0" Background="{StaticResource ReaderOverlayBrush}" CornerRadius="8" Padding="14,7">
                    <TextBlock Text="{Binding PageLabel}" FontFamily="Consolas,monospace" FontSize="13"
                               Foreground="{StaticResource ReaderTextBrush}" />
                </Border>

                <Border IsVisible="{Binding ShowFullscreenOverlays}" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                        Margin="40,0,40,20" Background="{StaticResource ReaderOverlayBrush}" CornerRadius="8" Padding="10">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ScrubberItemsControl" ItemsSource="{Binding Thumbnails}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ReaderThumbnailSample">
                                    <Border Classes="scrubberThumb" Classes.selected="{Binding IsSelected}" Background="{Binding CoverBrush}"
                                            Cursor="Hand" PointerPressed="OnThumbnailPointerPressed">
                                        <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- ============ Bottom scrubber ============ -->
        <Border Grid.Row="2" Background="{StaticResource ReaderChromeBrush}" BorderBrush="{StaticResource ReaderBorderBrush}"
                BorderThickness="0,1,0,0" Padding="22,12" IsVisible="{Binding !IsFullscreen}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Command="{Binding GoLeftCommand}" Background="Transparent"
                        BorderThickness="0" Padding="0" Cursor="Hand"
                        VerticalAlignment="Center" Margin="0,0,14,0" ToolTip.Tip="Previous page">
                    <Border Classes="icon" Width="14" Height="14" Background="{StaticResource ReaderTextBrush}">
                        <Border.OpacityMask>
                            <ImageBrush Source="/Assets/Icons/Skip_Back.png" Stretch="Uniform" />
                        </Border.OpacityMask>
                    </Border>
                </Button>
                <ProgressBar Grid.Column="1" Height="4" CornerRadius="2" Minimum="0" Maximum="1"
                             Value="{Binding ProgressFraction}" Background="{StaticResource ReaderTrackBrush}"
                             Foreground="{DynamicResource PbAccentBrush}" VerticalAlignment="Center" />
                <Button Grid.Column="2" Command="{Binding GoRightCommand}" Background="Transparent"
                        BorderThickness="0" Padding="0" Cursor="Hand"
                        VerticalAlignment="Center" Margin="14,0,0,0" ToolTip.Tip="Next page">
                    <Border Classes="icon" Width="14" Height="14" Background="{StaticResource ReaderTextBrush}">
                        <Border.OpacityMask>
                            <ImageBrush Source="/Assets/Icons/Skip_Forward.png" Stretch="Uniform" />
                        </Border.OpacityMask>
                    </Border>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
