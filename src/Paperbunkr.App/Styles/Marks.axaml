<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Paperbunkr.App.Controls"
        xmlns:fi="using:FluentIcons.Avalonia">
    <!--
        BrandMark (docs/superpowers/specs/2026-08-28-brand-metadata-iconography-design.md §1) - the
        one control every brand / metadata mark surface uses. Code-only TemplatedControl
        (Controls/BrandMark.cs); this implicit ControlTheme is its template, same pattern as SplitText
        in Styles/Typography.axaml. The control resolves everything and exposes ready-to-bind outputs
        (ImageSource / Glyph / Label / ChipBackground + Is* flags) - the template just switches on them.
    -->
    <!-- Publisher logo laid straight on a cover tile (Library grids), no badge pill behind it: bigger
         so it reads, and a soft shadow instead of a backdrop so a tinted / plain-text mark still
         reads on a light cover (raster logos carry their own contrast plate already). -->
    <Style Selector="controls|BrandMark.coverLogo">
        <Setter Property="MarkSize" Value="22" />
        <Setter Property="MaxMarkWidth" Value="54" />
        <Setter Property="EnsureContrast" Value="True" />
        <Setter Property="Margin" Value="7" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Foreground" Value="{DynamicResource PbBadgeTextBrush}" />
        <Setter Property="Effect">
            <DropShadowEffect OffsetX="0" OffsetY="1" BlurRadius="3" Color="Black" Opacity="0.9" />
        </Setter>
    </Style>

    <Styles.Resources>
        <ControlTheme x:Key="{x:Type controls:BrandMark}" TargetType="controls:BrandMark">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">

                        <!-- Bitmap is already aspect-correct (SvgMarkRenderer fits longest side to
                             2*MarkSize); Height drives display, wide wordmarks stay wide. -->
                        <Image Source="{TemplateBinding ImageSource}"
                               Height="{TemplateBinding MarkHeight}" Stretch="Uniform"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapInterpolationMode="HighQuality"
                               IsVisible="{TemplateBinding IsBareImage}" />

                        <!-- CE publisher raster (PNG/JPG): drawn as-is on a contrast plate picked from
                             its own pixels (PlateBrush null = opaque image, no plate). Small squircle
                             radius, not an oval (feedback: no oval pills). -->
                        <Border IsVisible="{TemplateBinding IsPlatedImage}" VerticalAlignment="Center"
                                CornerRadius="4" Padding="1.5" ClipToBounds="True"
                                Background="{TemplateBinding PlateBrush}">
                            <Image Source="{TemplateBinding ImageSource}"
                                   Height="{TemplateBinding MarkHeight}" Stretch="Uniform"
                                   RenderOptions.BitmapInterpolationMode="HighQuality" />
                        </Border>

                        <fi:SymbolIcon Symbol="{TemplateBinding Glyph}"
                                       FontSize="{TemplateBinding MarkSize}"
                                       Foreground="{Binding GlyphBrush, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue={DynamicResource PbTextMutedBrush}}"
                                       VerticalAlignment="Center"
                                       IsVisible="{TemplateBinding IsGlyph}" />

                        <Border IsVisible="{TemplateBinding IsChip}" VerticalAlignment="Center"
                                CornerRadius="3" Padding="5,1"
                                Background="{Binding ChipBackground, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue={DynamicResource PbSurface3Brush}}"
                                BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1">
                            <TextBlock Text="{TemplateBinding Label}" FontSize="9.5" FontWeight="Bold"
                                       Foreground="{DynamicResource PbTextBrush}" />
                        </Border>

                        <TextBlock Text="{TemplateBinding Label}" VerticalAlignment="Center"
                                   FontSize="11.5" Foreground="{DynamicResource PbTextMutedBrush}"
                                   IsVisible="{TemplateBinding ShowLabel}" />

                        <TextBlock Text="{TemplateBinding Label}" VerticalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}"
                                   IsVisible="{TemplateBinding IsPlainText}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>
</Styles>
