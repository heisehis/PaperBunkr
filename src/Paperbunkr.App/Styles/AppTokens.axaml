<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:motion="using:Paperbunkr.App.Theming.Motion">
    <!-- The app's design tokens, moved out of App.axaml (which merges this file) so headless tests can load the real tokens without
         instantiating the App and its FluentAvaloniaTheme. ThemeService still writes live values into Application.Resources itself,
         which wins over this merged dictionary, exactly as before. -->
    <!-- Design tokens from the Claude Design "Paperbunkr App" wireframe (project 43c40b25).
         These are the app's own visual identity, distinct from the installable .crpck skin
         system in docs/onboarding.md §13 - skins theme content chrome, not this shell. -->
    <!-- Darkened per direct user feedback during Phase 3 brainstorming ("really dark, if not
         black") - these must stay value-twins of PbSurface1Color/PbSurface2Color below (the
         invariant Phase 1 set up between the legacy Bg/Chrome names and the elevation scale). -->
    <Color x:Key="PbBgColor">#0A0B0D</Color>
    <Color x:Key="PbChromeColor">#131519</Color>
    <Color x:Key="PbBorderColor">#2A2E37</Color>
    <Color x:Key="PbTextColor">#ECE7DB</Color>
    <Color x:Key="PbTextMutedColor">#B3ADA0</Color>
    <Color x:Key="PbTextFaintColor">#77726A</Color>
    <Color x:Key="PbAccentColor">#C9803F</Color>
    <Color x:Key="PbAccentTextColor">#E0995A</Color>
    <Color x:Key="PbAccentSoftColor">#29C9803F</Color>
    <Color x:Key="PbBadgeColor">#D7AC4C</Color>
    <Color x:Key="PbBadgeTextColor">#241505</Color>
    <Color x:Key="PbSuccessColor">#5FA889</Color>
    <!-- Categorical chart colors (docs/superpowers/specs/2026-09-08-stats-v2-mangabaka-design.md
         §8) - live-updated by ThemeService.ApplySkinResources like the accent/badge/success colors
         above; these static values are only the pre-first-ApplyPersistedSettings fallback. -->
    <Color x:Key="PbChartBlueColor">#5B8DBE</Color>
    <Color x:Key="PbChartVioletColor">#9B7EBD</Color>
    <!-- Failure/error accent (Activity Center failed-job chips + error alerts, docs/superpowers/
         specs/2026-09-03-activity-center-design.md). Matches the muted red already used inline
         for the discard-confirm primary button in MainWindow. -->
    <Color x:Key="PbDangerColor">#D96C6C</Color>

    <!-- Icon-chip tints for Library Health's stat tiles (docs/superpowers/specs/2026-09-07-
         library-health-redesign-design.md §2) - ~18% alpha of the existing badge/danger/success
         colors above, matching PbAccentSoftColor's own ~16% alpha convention. The amber chip
         reuses PbAccentSoftBrush directly rather than adding a 4th. -->
    <Color x:Key="PbBadgeSoftColor">#2ED7AC4C</Color>
    <Color x:Key="PbDangerSoftColor">#2ED96C6C</Color>
    <Color x:Key="PbSuccessSoftColor">#2E5FA889</Color>

    <SolidColorBrush x:Key="PbBgBrush" Color="{StaticResource PbBgColor}" />
    <SolidColorBrush x:Key="PbChromeBrush" Color="{StaticResource PbChromeColor}" />
    <SolidColorBrush x:Key="PbBorderBrush" Color="{StaticResource PbBorderColor}" />
    <SolidColorBrush x:Key="PbTextBrush" Color="{StaticResource PbTextColor}" />
    <SolidColorBrush x:Key="PbTextMutedBrush" Color="{StaticResource PbTextMutedColor}" />
    <SolidColorBrush x:Key="PbTextFaintBrush" Color="{StaticResource PbTextFaintColor}" />
    <SolidColorBrush x:Key="PbAccentBrush" Color="{StaticResource PbAccentColor}" />
    <SolidColorBrush x:Key="PbAccentTextBrush" Color="{StaticResource PbAccentTextColor}" />
    <SolidColorBrush x:Key="PbAccentSoftBrush" Color="{StaticResource PbAccentSoftColor}" />
    <SolidColorBrush x:Key="PbBadgeBrush" Color="{StaticResource PbBadgeColor}" />
    <SolidColorBrush x:Key="PbBadgeTextBrush" Color="{StaticResource PbBadgeTextColor}" />
    <SolidColorBrush x:Key="PbSuccessBrush" Color="{StaticResource PbSuccessColor}" />
    <SolidColorBrush x:Key="PbChartBlueBrush" Color="{StaticResource PbChartBlueColor}" />
    <SolidColorBrush x:Key="PbChartVioletBrush" Color="{StaticResource PbChartVioletColor}" />
    <SolidColorBrush x:Key="PbDangerBrush" Color="{StaticResource PbDangerColor}" />
    <SolidColorBrush x:Key="PbBadgeSoftBrush" Color="{StaticResource PbBadgeSoftColor}" />
    <SolidColorBrush x:Key="PbDangerSoftBrush" Color="{StaticResource PbDangerSoftColor}" />
    <SolidColorBrush x:Key="PbSuccessSoftBrush" Color="{StaticResource PbSuccessSoftColor}" />

    <!-- Elevation scale + glow/hero-gradient tokens (docs/superpowers/specs/2026-08-24-design-
         language-foundation-design.md). WCAG AA contrast checked by hand against these exact
         values: PbText on PbSurface1 ~13.6:1, PbTextMuted on PbSurface2 ~8:1, PbAccentText on
         PbSurface2 ~6.9:1 - all clear of the 4.5:1 body-text minimum. -->
    <Color x:Key="PbSurface0Color">#000000</Color>
    <Color x:Key="PbSurface1Color">#0A0B0D</Color>
    <Color x:Key="PbSurface2Color">#131519</Color>
    <Color x:Key="PbSurface3Color">#1B1E24</Color>
    <Color x:Key="PbGlowColor">#66E0995A</Color>
    <Color x:Key="PbHeroGradientStartColor">#00000000</Color>
    <Color x:Key="PbHeroGradientEndColor">#FF000000</Color>
    <!-- Home pitch (docs/superpowers/specs/2026-09-28-home-cosmetics-design.md). PbHeroScrimColor: the muted Home hero scrim,
         rewritten per theme mode by ThemeService (dark value here). The sky and season colours are deliberately
         theme-independent - a morning sky is the same colour on every light skin - but live here as named resources so a skin
         or a later theme.json field can override them. -->
    <Color x:Key="PbHeroScrimColor">#59000000</Color>
    <!-- The shade over a Home spotlight sliver: darker than the hero scrim, and dark in every theme because it sits on cover art. -->
    <Color x:Key="PbCoverShadeColor">#8C000000</Color>
    <!-- Brush form, for the Books cover card's progress track and badge glyphs (books redesign §2): the same fixed shade on every theme. -->
    <SolidColorBrush x:Key="PbCoverShadeBrush" Color="{StaticResource PbCoverShadeColor}" />
    <!-- Book reader highlight colours (books redesign §5.1): one place for the popup swatches, the Notes lists and the page's own highlight CSS
         (which takes them at 55% alpha so text stays readable). Fixed on every theme, like the highlighter pens they stand for. -->
    <Color x:Key="PbHighlightYellowColor">#FFD54F</Color>
    <Color x:Key="PbHighlightGreenColor">#81C784</Color>
    <Color x:Key="PbHighlightBlueColor">#64B5F6</Color>
    <Color x:Key="PbHighlightPinkColor">#F06292</Color>
    <SolidColorBrush x:Key="PbHighlightYellowBrush" Color="{StaticResource PbHighlightYellowColor}" />
    <SolidColorBrush x:Key="PbHighlightGreenBrush" Color="{StaticResource PbHighlightGreenColor}" />
    <SolidColorBrush x:Key="PbHighlightBlueBrush" Color="{StaticResource PbHighlightBlueColor}" />
    <SolidColorBrush x:Key="PbHighlightPinkBrush" Color="{StaticResource PbHighlightPinkColor}" />
    <!-- The dim behind the book reader's panels; lighter than a dialog scrim so the page stays legible behind a floating panel. -->
    <Color x:Key="PbReaderScrimColor">#66000000</Color>
    <SolidColorBrush x:Key="PbReaderScrimBrush" Color="{StaticResource PbReaderScrimColor}" />

    <!-- Books CoverWash (books redesign §2): how far the wash pulls a cover's colour toward the accent, 0 (the cover's own colour) to 1 (accent only). -->
    <x:Double x:Key="PbCoverWashAccentMix">0</x:Double>
    <Color x:Key="PbSkyMorningTopColor">#BFE0FF</Color>
    <Color x:Key="PbSkyMorningBottomColor">#FFE7C9</Color>
    <Color x:Key="PbSkyAfternoonTopColor">#8FC3F2</Color>
    <Color x:Key="PbSkyAfternoonBottomColor">#E3F1FF</Color>
    <Color x:Key="PbSkyEveningTopColor">#FFB38A</Color>
    <Color x:Key="PbSkyEveningBottomColor">#F7D9E6</Color>
    <Color x:Key="PbSkyNightTopColor">#4A5B8F</Color>
    <Color x:Key="PbSkyNightBottomColor">#C9CFE6</Color>
    <Color x:Key="PbSkyNightTextColor">#FFFFFF</Color>
    <Color x:Key="PbSkyNightMutedTextColor">#E6E9F5</Color>
    <SolidColorBrush x:Key="PbSkyNightTextBrush" Color="{StaticResource PbSkyNightTextColor}" />
    <Color x:Key="PbSeasonFreeComicBookDayColor">#E0B341</Color>
    <Color x:Key="PbSeasonHalloweenColor">#F28C28</Color>
    <Color x:Key="PbSeasonWinterHolidaysColor">#7FC8F8</Color>
    <Color x:Key="PbSeasonNewYearColor">#C9A8FF</Color>

    <!-- Comic-age colours for the Continuity screen's Timeline (docs/superpowers/specs/2026-09-28-continuity-screen-redesign-
         design.md, "Colour tokens"): each era's header tint, left edge, node and progress. ThemeService rewrites all fifteen from
         the active skin (a light or a dark default set, Modern following the accent, optional theme.json overrides); these are the
         dark set, the pre-first-apply fallback. Soft = ~18% alpha, matching the other *Soft tokens. -->
    <Color x:Key="PbEraPlatinumColor">#9AA5B1</Color>
    <Color x:Key="PbEraGoldenColor">#D4A437</Color>
    <Color x:Key="PbEraSilverColor">#B8C0CC</Color>
    <Color x:Key="PbEraBronzeColor">#C07A45</Color>
    <Color x:Key="PbEraModernColor">#C9803F</Color>
    <Color x:Key="PbEraPlatinumSoftColor">#2E9AA5B1</Color>
    <Color x:Key="PbEraGoldenSoftColor">#2ED4A437</Color>
    <Color x:Key="PbEraSilverSoftColor">#2EB8C0CC</Color>
    <Color x:Key="PbEraBronzeSoftColor">#2EC07A45</Color>
    <Color x:Key="PbEraModernSoftColor">#2EC9803F</Color>
    <SolidColorBrush x:Key="PbEraPlatinumBrush" Color="{StaticResource PbEraPlatinumColor}" />
    <SolidColorBrush x:Key="PbEraGoldenBrush" Color="{StaticResource PbEraGoldenColor}" />
    <SolidColorBrush x:Key="PbEraSilverBrush" Color="{StaticResource PbEraSilverColor}" />
    <SolidColorBrush x:Key="PbEraBronzeBrush" Color="{StaticResource PbEraBronzeColor}" />
    <SolidColorBrush x:Key="PbEraModernBrush" Color="{StaticResource PbEraModernColor}" />
    <SolidColorBrush x:Key="PbEraPlatinumSoftBrush" Color="{StaticResource PbEraPlatinumSoftColor}" />
    <SolidColorBrush x:Key="PbEraGoldenSoftBrush" Color="{StaticResource PbEraGoldenSoftColor}" />
    <SolidColorBrush x:Key="PbEraSilverSoftBrush" Color="{StaticResource PbEraSilverSoftColor}" />
    <SolidColorBrush x:Key="PbEraBronzeSoftBrush" Color="{StaticResource PbEraBronzeSoftColor}" />
    <SolidColorBrush x:Key="PbEraModernSoftBrush" Color="{StaticResource PbEraModernSoftColor}" />

    <SolidColorBrush x:Key="PbSurface0Brush" Color="{StaticResource PbSurface0Color}" />
    <SolidColorBrush x:Key="PbSurface1Brush" Color="{StaticResource PbSurface1Color}" />
    <SolidColorBrush x:Key="PbSurface2Brush" Color="{StaticResource PbSurface2Color}" />
    <SolidColorBrush x:Key="PbSurface3Brush" Color="{StaticResource PbSurface3Color}" />
    <SolidColorBrush x:Key="PbGlowBrush" Color="{StaticResource PbGlowColor}" />

    <x:Double x:Key="PbSpacingUnit">4</x:Double>

    <!-- Type scale, named steps (docs/superpowers/specs/2026-08-24-design-language-foundation-
         design.md's Typography section only documented Hero/Heading/Body/Caption as TextBlock
         style classes bundling FontFamily+color - PbFontSizeBody/PbFontSizeCaption expose just
         their sizes as plain doubles so a surface that needs Body/Caption's size with a
         different Foreground (e.g. DetailBand's muted synopsis) can reference the size alone.
         Micro/Overline/Meta/Control formalize four denser sizes that had drifted into the
         codebase as unnamed magic numbers (Detail band chips/labels, tab counter, hero action
         buttons) - added 2026-08-30 via the avalonia-pro-max/review-checklist audit, values
         kept identical to the prior literals so this is a zero-visual-diff rename, not a
         redesign. -->
    <!-- 2026-10-19 UI polish foundation (docs/superpowers/specs/2026-10-19-ui-polish-foundation-design.md §1): one whole-pixel scale,
         10 · 11 · 12 · 13 · 15 · 18 · 22. Control and Overline stay as keys but now equal Body and Micro; every literal FontSize in
         XAML is pinned to this scale by XamlConsistencyLintTests. -->
    <x:Double x:Key="PbFontSizeMicro">10</x:Double>
    <x:Double x:Key="PbFontSizeOverline">10</x:Double>
    <x:Double x:Key="PbFontSizeCaption">11</x:Double>
    <x:Double x:Key="PbFontSizeMeta">12</x:Double>
    <x:Double x:Key="PbFontSizeBody">13</x:Double>
    <x:Double x:Key="PbFontSizeControl">13</x:Double>
    <x:Double x:Key="PbFontSizeSection">15</x:Double>
    <x:Double x:Key="PbFontSizeTitle">18</x:Double>

    <!-- Icon-size scale (docs/superpowers/specs/2026-09-04-detail-screen-icons-and-glyphs-
         design.md §1) - based on the avalonia-pro-max/icons-imagery steps, then bumped one
         stop up (2026-09-04, user direction: glyphs read too small). fi:SymbolIcon is sized
         by FontSize; reference a token, never a literal. Plain x:Double, not skinned by
         ThemeService (same as PbFontSize* above). Every glyph in the app scales from here. -->
    <x:Double x:Key="PbIconSizeXs">14</x:Double>
    <x:Double x:Key="PbIconSizeSm">16</x:Double>
    <x:Double x:Key="PbIconSizeMd">18</x:Double>
    <x:Double x:Key="PbIconSizeLg">24</x:Double>
    <x:Double x:Key="PbIconSizeXl">40</x:Double>

    <!-- Genuinely CornerRadius-typed, not x:Double - a Style Setter's DynamicResource
         resolution does NOT run the CornerRadius TypeConverter the way a plain XAML attribute
         does (confirmed the hard way: System.InvalidCastException, "Unable to cast object of
         type 'System.Double' to type 'Avalonia.CornerRadius'", thrown from
         Avalonia.PropertyStore.EffectiveValue`1.GetValue during Style application). ThemeService
         must assign real CornerRadius values here too, not doubles - see its ApplySkinResources. -->
    <CornerRadius x:Key="PbRadius">7</CornerRadius>
    <CornerRadius x:Key="PbRadiusSm">5</CornerRadius>
    <CornerRadius x:Key="PbRadiusLg">14</CornerRadius>
    <!-- Chips are squircles, not ovals: a radius well under half a chip's height keeps the corners round without collapsing the ends into a pill. -->
    <CornerRadius x:Key="PbRadiusChip">9</CornerRadius>
    <!-- Form fields are underlined (foundation design §4): rounded top corners over a flat bottom line. Per-corner, so it can't be derived
         from the theme's single radiusSm and is not theme-written. -->
    <CornerRadius x:Key="PbFieldRadius">4,4,0,0</CornerRadius>

    <!-- Shared control sizes (docs/superpowers/specs/2026-10-19-ui-polish-shared-controls-design.md, Q7 "compact"): every button, segmented
         switch and menu row is 28 tall, 22 with .sm. PbControlBorderBrush outlines segmented groups and filter chips - faint, following the
         live theme through its colour. -->
    <x:Double x:Key="PbControlHeight">28</x:Double>
    <x:Double x:Key="PbControlHeightSm">22</x:Double>
    <SolidColorBrush x:Key="PbControlBorderBrush" Color="{DynamicResource PbTextFaintColor}" />

    <!-- Density tokens (docs/superpowers/specs/2026-09-21-cosmetics-pitch-2-design.md #17) - these are the Comfortable values; ThemeService
         overwrites them at startup and live from Preferences > Appearance > Density. Consumers use DynamicResource. -->
    <Thickness x:Key="PbListRowPadding">10</Thickness>
    <Thickness x:Key="PbDetailsRowPadding">0,3</Thickness>
    <Thickness x:Key="PbSidebarItemPadding">8,7</Thickness>

    <!-- Motion v2 (docs/superpowers/specs/2026-10-20-motion-system-v2-foundation-overlays-design.md §3). Every animation belongs to one
         role (Acknowledge / Hover / Reveal / Replace / Travel / Ambient). ThemeService.WriteMotionTokens overwrites these durations from
         MotionPolicy.Resolve on start and on every Motion / quality change; the values here are the Full defaults. Opacity runs on a
         *Fade token and RenderTransform on the matching *Move token: Reduced keeps the fade short and zeroes the move, so a surface
         simply fades with no travel. Use the role tokens in new XAML. -->
    <x:TimeSpan x:Key="PbMotionAcknowledge">0:0:0.09</x:TimeSpan>
    <x:TimeSpan x:Key="PbMotionAcknowledgeMove">0:0:0.09</x:TimeSpan>
    <x:TimeSpan x:Key="PbMotionHoverFade">0:0:0.12</x:TimeSpan>
    <x:TimeSpan x:Key="PbMotionHoverMove">0:0:0.16</x:TimeSpan>
    <x:TimeSpan x:Key="PbMotionRevealFade">0:0:0.18</x:TimeSpan>
    <x:TimeSpan x:Key="PbMotionRevealMove">0:0:0.18</x:TimeSpan>
    <x:TimeSpan x:Key="PbMotionRevealExit">0:0:0.12</x:TimeSpan>
    <x:TimeSpan x:Key="PbMotionReplace">0:0:0.16</x:TimeSpan>
    <x:TimeSpan x:Key="PbMotionTravelFade">0:0:0.22</x:TimeSpan>
    <x:TimeSpan x:Key="PbMotionTravelMove">0:0:0.22</x:TimeSpan>
    <x:TimeSpan x:Key="PbMotionFlight">0:0:0.28</x:TimeSpan>
    <x:TimeSpan x:Key="PbMotionAmbient">0:0:0.36</x:TimeSpan>

    <!-- Curves (§3.2). PbMotionEase: everything that enters (strong decelerate). PbMotionExitEase: everything that leaves (accelerate).
         PbMotionMoveEase: a change between two on-screen states (press, flight, ambient). PbMotionSpring: a damped spring that
         overshoots ~3 % once and settles - hover lift and panel arrival only. Overshooting easings (BackEase, ElasticEase, BounceEase)
         are banned by lint. -->
    <SplineEasing x:Key="PbMotionEase" X1="0.05" Y1="0.7" X2="0.1" Y2="1" />
    <SplineEasing x:Key="PbMotionExitEase" X1="0.3" Y1="0" X2="0.8" Y2="0.15" />
    <SplineEasing x:Key="PbMotionMoveEase" X1="0.2" Y1="0" X2="0" Y2="1" />
    <motion:DampedSpringEasing x:Key="PbMotionSpring" />

    <!-- Legacy keys, kept as aliases of their role equivalents so existing transitions follow v2 timing and policy: Fast = Hover fade,
         Standard = Reveal fade, Large = Flight, Slow = Ambient. Lint counts their uses and the count may only go down. -->
    <x:TimeSpan x:Key="PbMotionFast">0:0:0.12</x:TimeSpan>
    <x:TimeSpan x:Key="PbMotionStandard">0:0:0.18</x:TimeSpan>
    <x:TimeSpan x:Key="PbMotionLarge">0:0:0.28</x:TimeSpan>
    <x:TimeSpan x:Key="PbMotionSlow">0:0:0.36</x:TimeSpan>

    <!-- Screen transitions are Controls/RouteHost (Motion v2 navigation, docs/superpowers/specs/2026-10-20-motion-system-v2-navigation-
         design.md); the old PbScreenSlide / PbDrillTransition page transitions are gone. -->

    <!-- Bundled fonts (design doc's Typography section). PbDisplayFontFamily (Bebas Neue) is
         for hero/heading text only, referenced directly via StaticResource in Styles/Typography.axaml
         - it never goes through the Preferences font-override mechanism. PbDefaultFontFamily
         (Source Serif 4) is NOT referenced here as PbFontFamily's value - ThemeService.
         ApplyFontResource sets that live (it's what "no override" now resolves to; see that
         file's DefaultFontFamily field for why it's set in code, not XAML). -->
    <FontFamily x:Key="PbDisplayFontFamily">avares://Paperbunkr.App/Assets/Fonts/#Bebas Neue</FontFamily>

    <!-- Book titles across the Books section (docs/superpowers/specs/2026-10-27-books-section-redesign-design.md §1). Fixed like
         PbDisplayFontFamily: ThemeService's body-font override (PbFontFamily) never touches it, so a book title stays serif
         whatever font the user reads the UI in. Used through the TextBlock.bookTitle modifier class in Styles/Typography.axaml. -->
    <FontFamily x:Key="PbBookTitleFontFamily">avares://Paperbunkr.App/Assets/Fonts/#Source Serif 4, Georgia, serif</FontFamily>

    <!-- Theme typography roles (docs/superpowers/specs/2026-10-12-theme-system-v2-gap-analysis-and-plan.md, phase 3). ThemeService writes
         live values for all of these from the active theme; what is here is only the look before the first apply (and in headless tests
         that never apply a theme), and equals the built-in default. -->
    <FontFamily x:Key="PbHeadingFontFamily">avares://Paperbunkr.App/Assets/Fonts/#Bebas Neue</FontFamily>
    <FontFamily x:Key="PbMonoFontFamily">Cascadia Code, Consolas, Courier New, monospace</FontFamily>
    <x:Double x:Key="PbFontSizeHero">42</x:Double>
    <x:Double x:Key="PbFontSizeHeading">22</x:Double>
    <FontWeight x:Key="PbDisplayFontWeight">Normal</FontWeight>
    <FontWeight x:Key="PbHeadingFontWeight">Normal</FontWeight>

    <!-- Component roles (phase 3): same rule as above. Each equals the token the control was bound to before roles existed. -->
    <SolidColorBrush x:Key="PbButtonPrimaryBackground" Color="{StaticResource PbAccentColor}" />
    <SolidColorBrush x:Key="PbButtonPrimaryForeground" Color="{StaticResource PbBadgeTextColor}" />
    <SolidColorBrush x:Key="PbButtonPrimaryBorder" Color="{StaticResource PbAccentColor}" />
    <SolidColorBrush x:Key="PbButtonPrimaryBackgroundHover" Color="{StaticResource PbAccentTextColor}" />
    <CornerRadius x:Key="PbButtonPrimaryRadius">5</CornerRadius>
    <SolidColorBrush x:Key="PbButtonSecondaryBackground" Color="{StaticResource PbChromeColor}" />
    <SolidColorBrush x:Key="PbButtonSecondaryForeground" Color="{StaticResource PbTextColor}" />
    <!-- Outlines of secondary/ghost buttons and chips use the faint text colour (2026-10-19 shared controls Q4): PbBorder is ~1.35:1 against
         the surface in every theme, so outlined controls read as plain text (most visibly in Matrix); faint is 3.1-3.8:1. -->
    <SolidColorBrush x:Key="PbButtonSecondaryBorder" Color="{StaticResource PbTextFaintColor}" />
    <SolidColorBrush x:Key="PbButtonSecondaryBackgroundHover" Color="{StaticResource PbSurface3Color}" />
    <CornerRadius x:Key="PbButtonSecondaryRadius">5</CornerRadius>
    <SolidColorBrush x:Key="PbButtonGhostBackground" Color="Transparent" />
    <SolidColorBrush x:Key="PbButtonGhostForeground" Color="{StaticResource PbTextMutedColor}" />
    <SolidColorBrush x:Key="PbButtonGhostBorder" Color="{StaticResource PbTextFaintColor}" />
    <SolidColorBrush x:Key="PbButtonGhostBorderHover" Color="{StaticResource PbAccentColor}" />
    <CornerRadius x:Key="PbButtonGhostRadius">5</CornerRadius>
    <SolidColorBrush x:Key="PbChipBackground" Color="{StaticResource PbChromeColor}" />
    <SolidColorBrush x:Key="PbChipBorder" Color="{StaticResource PbTextFaintColor}" />
    <SolidColorBrush x:Key="PbChipBorderHover" Color="{StaticResource PbBadgeColor}" />
    <CornerRadius x:Key="PbChipRadius">9</CornerRadius>
    <SolidColorBrush x:Key="PbPanelFloatingBackground" Color="{StaticResource PbSurface3Color}" />
    <SolidColorBrush x:Key="PbPanelFloatingBorder" Color="{StaticResource PbBorderColor}" />
    <CornerRadius x:Key="PbPanelFloatingRadius">14</CornerRadius>
</ResourceDictionary>
