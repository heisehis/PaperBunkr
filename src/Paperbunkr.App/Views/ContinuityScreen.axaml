<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Paperbunkr.App.Controls"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:models="using:Paperbunkr.App.Models"
             xmlns:views="using:Paperbunkr.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="760"
             x:Class="Paperbunkr.App.Views.ContinuityScreen"
             x:Name="Screen"
             x:DataType="vm:ContinuityScreenViewModel">

    <!-- The Continuity screen (docs/superpowers/specs/2026-09-28-continuity-screen-redesign-design.md): the open page's hero with the
         Overview | Map | Timeline switch on top, then the body - the page's Overview, its Timeline, or the Event Map - with
         Suggestions & checks and the compare overlay over everything when open. -->
    <UserControl.Styles>
        <StyleInclude Source="avares://Paperbunkr.App/Styles/ContinuityChrome.axaml" />
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- Nothing yet -->
        <StackPanel Grid.RowSpan="2" Margin="28,40" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsVisible="{Binding ShowEmptyPrompt}">
            <controls:EmptyIllustration Kind="Timeline" HorizontalAlignment="Center" />
            <TextBlock Text="Create a continuity or an event to get started" FontSize="13"
                       Foreground="{DynamicResource PbTextMutedBrush}" HorizontalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Button Classes="headerAction primary" Content="＋ New continuity"
                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenNewEventDialogCommand}" CommandParameter="Continuity" />
                <Button Classes="headerAction secondary" Content="＋ New event"
                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenNewEventDialogCommand}" CommandParameter="Event" />
            </StackPanel>
        </StackPanel>

        <!-- Hero + switch -->
        <Panel Grid.Row="0" IsVisible="{Binding HasPage}">
            <views:ContinuityHero DataContext="{Binding ContinuityPage}" IsVisible="{Binding #Screen.((vm:ContinuityScreenViewModel)DataContext).IsContinuitySelected}" />
            <views:EventHero DataContext="{Binding EventPage}" IsVisible="{Binding #Screen.((vm:ContinuityScreenViewModel)DataContext).IsEventSelected}" />
            <Border Background="{DynamicResource PbSurface2Brush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="3" Margin="28,20" HorizontalAlignment="Right" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Classes="segToggle" Classes.on="{Binding IsOverviewView}" Content="Overview"
                            Command="{Binding SetDetailViewCommand}" CommandParameter="{x:Static models:EventsDetailView.Primary}" />
                    <Button Classes="segToggle" Classes.on="{Binding IsMapView}" Content="Map" AutomationProperties.Name="Map view"
                            Command="{Binding SetDetailViewCommand}" CommandParameter="{x:Static models:EventsDetailView.Map}" />
                    <Button Classes="segToggle" Classes.on="{Binding IsTimelineView}" Content="Timeline"
                            Command="{Binding SetDetailViewCommand}" CommandParameter="{x:Static models:EventsDetailView.Timeline}" />
                </StackPanel>
            </Border>
        </Panel>

        <!-- Body: Overview -->
        <ScrollViewer Grid.Row="1" x:Name="OverviewScroller" IsVisible="{Binding ShowOverview}" HorizontalScrollBarVisibility="Disabled">
            <Panel Margin="0,0,0,40">
                <views:ContinuityOverviewView DataContext="{Binding ContinuityPage}"
                                              IsVisible="{Binding #Screen.((vm:ContinuityScreenViewModel)DataContext).IsContinuitySelected}" />
                <views:EventOverviewView DataContext="{Binding EventPage}"
                                         IsVisible="{Binding #Screen.((vm:ContinuityScreenViewModel)DataContext).IsEventSelected}" />
            </Panel>
        </ScrollViewer>

        <!-- Body: Timeline -->
        <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowTimeline}" HorizontalScrollBarVisibility="Disabled">
            <views:ContinuityTimelineView DataContext="{Binding Timeline}" Margin="0,0,0,40" />
        </ScrollViewer>

        <!-- Body: the Event Map, beside (not inside) a ScrollViewer - it needs its own two-axis viewport -->
        <views:EventMapView Grid.Row="1" DataContext="{Binding ActiveMap}"
                            IsVisible="{Binding #Screen.((vm:ContinuityScreenViewModel)DataContext).ShowEventMap}" />

        <!-- Suggestions & checks -->
        <ScrollViewer Grid.RowSpan="2" IsVisible="{Binding IsSuggestionsOpen}" HorizontalScrollBarVisibility="Disabled">
            <views:SuggestionsChecksView DataContext="{Binding Suggestions}" />
        </ScrollViewer>

        <!-- Compare & merge -->
        <views:ContinuityCompareOverlay Grid.RowSpan="2" DataContext="{Binding ContinuityPage}" />
    </Grid>
</UserControl>
