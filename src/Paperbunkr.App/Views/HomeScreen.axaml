<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:views="using:Paperbunkr.App.Views"
             xmlns:controls="using:Paperbunkr.App.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:home="using:Paperbunkr.App.Views.Home"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="900"
             x:Class="Paperbunkr.App.Views.HomeScreen"
             x:Name="Root"
             x:DataType="vm:HomeScreenViewModel">

    <!--
        App launch screen (docs/superpowers/specs/2026-08-28-home-screen-redesign-design.md, reworked by the 2026-09-28 Home pitch:
        docs/superpowers/specs/2026-09-28-home-cosmetics-design.md + 2026-09-28-home-improvements-design.md). A masthead - time-of-day
        greeting, search, and either the blurred cover wall (dark themes, drifting with scroll) or the time-of-day sky (light
        themes) - then the user's ordered, hideable sections. Each section's template is its own file under Views/Home/, picked by
        key in HomeScreen.axaml.cs; all data/pick logic lives in HomeScreenViewModel / HomeFeedResolver.

        Theme layouts (docs/superpowers/specs/2026-10-12-theme-system-v2-gap-analysis-and-plan.md, phase 4): the masthead and the section list are
        their own controls (Views/Home/HomeMasthead, HomeSections) so a theme's layout can place them. What is written below is the built-in
        layout; ThemeLayoutHost shows it unless the active theme ships a valid "Home" layout and theme layouts are switched on, and falls
        back to it if that layout is refused or fails. Keyboard shortcuts are registered on this control, so they work in any layout.
    -->

    <UserControl.Styles>
        <StyleInclude Source="avares://Paperbunkr.App/Views/Home/HomeStyles.axaml" />
    </UserControl.Styles>

    <controls:ThemeLayoutHost x:Name="LayoutHost" Screen="Home">
        <ScrollViewer x:Name="PageScroller">
            <Panel>
                <!-- The one atmosphere for the whole upper page: the open spotlight pick's blurred cover, full width, from the very top
                     (behind the greeting) down past the spotlight, fading to nothing so the theme's own background takes over. It used to
                     be an image inside the spotlight band, which made it a dark rounded box behind the carousel. It scrolls with the page
                     and has no fill of its own. -->
                <controls:AtmosphereBackdrop x:Name="Atmosphere" Classes="homeAtmosphere" Classes.light="{Binding IsLightTheme}"
                                             VerticalAlignment="Top" Height="760"
                                             Source="{Binding CurrentSpotlight.BackdropImage}" />

                <StackPanel Margin="0,0,0,48">
                    <home:HomeMasthead />

                    <home:HomeSections HorizontalAlignment="Center" MaxWidth="1180" Margin="24,20,24,0" />
                </StackPanel>
            </Panel>
        </ScrollViewer>
    </controls:ThemeLayoutHost>
</UserControl>
