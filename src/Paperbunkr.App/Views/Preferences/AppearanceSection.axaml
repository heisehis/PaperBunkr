<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:controls="using:Paperbunkr.App.Controls"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:models="using:Paperbunkr.App.Models"
             xmlns:pref="using:Paperbunkr.App.Views.Preferences"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="720"
             x:Class="Paperbunkr.App.Views.Preferences.AppearanceSection"
             x:DataType="vm:PreferencesScreenViewModel">

    <UserControl.Styles>
        <!-- Appearance redesign (docs/superpowers/specs/2026-09-07-appearance-redesign-design.md) -
             the active skin's mini-mockup card gets an accent border ring; the app's own current
             accent (not the previewed skin's own accent), so the selection affordance always reads
             consistently regardless of which skin's colors a given card is displaying. -->
        <Style Selector="Border.skinActive">
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="28,20,28,40" Spacing="20">
            <TextBlock Classes="pbTextHeading" Text="Appearance" />

        <!-- Skins - grid of mini UI-mockup preview cards, real theme.json colors per skin
             (docs/superpowers/specs/2026-09-07-appearance-redesign-design.md). Install Skin folded
             in here (header actions) rather than its own separate group. -->
        <StackPanel Tag="appearance.skin" Spacing="10">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" Classes="settingsGroupCaption" Text="SKINS" VerticalAlignment="Center" Margin="0" />
                <Button Grid.Column="1" Classes="headerAction ghost" Content="Install…" Margin="0,0,8,0"
                        Command="{Binding BrowseForSkinCommand}" AutomationProperties.AutomationId="InstallSkinButton" />
                <Button Grid.Column="2" Classes="headerAction ghost" Command="{Binding OpenSkinsFolderCommand}"
                        AutomationProperties.Name="Open Skins Folder" ToolTip.Tip="Open Skins Folder"
                        AutomationProperties.AutomationId="OpenSkinsFolderButton">
                    <fi:SymbolIcon Symbol="FolderOpen" FontSize="{StaticResource PbIconSizeXs}" />
                </Button>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding HasInstallSkinError}">
                <fi:SymbolIcon Symbol="Warning" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbDangerBrush}" />
                <TextBlock Text="{Binding InstallSkinError}" Foreground="{DynamicResource PbDangerBrush}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>

            <ItemsControl x:Name="SkinsList" ItemsSource="{Binding Skins}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:SkinSummary">
                        <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,10,10" Cursor="Hand"
                                Command="{Binding #SkinsList.((vm:PreferencesScreenViewModel)DataContext).SelectSkinCommand}"
                                CommandParameter="{Binding}">
                            <StackPanel Width="140">
                                <Grid>
                                    <Border Classes.skinActive="{Binding IsActive}" CornerRadius="{StaticResource PbRadiusSm}"
                                            Background="{Binding BackgroundBrush}" Width="140" Height="90" ClipToBounds="True">
                                        <StackPanel>
                                            <Border Height="18" Background="{Binding ChromeBrush}">
                                                <Ellipse Width="6" Height="6" Fill="{Binding AccentBrush}" HorizontalAlignment="Left" Margin="8,0,0,0" />
                                            </Border>
                                            <Grid ColumnDefinitions="10,*" Margin="8">
                                                <Border Grid.Column="0" Background="{Binding SurfaceBrush}" CornerRadius="2" Height="56" />
                                                <StackPanel Grid.Column="1" Margin="8,4,0,0" Spacing="6">
                                                    <Border Height="4" Width="70" Background="{Binding TextMutedBrush}" CornerRadius="2" HorizontalAlignment="Left" />
                                                    <Border Height="4" Width="90" Background="{Binding TextMutedBrush}" CornerRadius="2" HorizontalAlignment="Left" />
                                                    <Border Height="4" Width="50" Background="{Binding TextMutedBrush}" CornerRadius="2" HorizontalAlignment="Left" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <Border Width="16" Height="16" CornerRadius="8" Background="{DynamicResource PbSuccessBrush}"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0"
                                            IsVisible="{Binding IsActive}">
                                        <fi:SymbolIcon Symbol="Checkmark" FontSize="{StaticResource PbIconSizeXs}" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding Name}" FontSize="12" Margin="2,6,0,0"
                                           Foreground="{DynamicResource PbTextBrush}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Tag="appearance.font">
            <TextBlock Classes="settingsGroupCaption" Text="FONT" />
            <pref:SettingsRow Icon="TextFont" Title="Font family">
                <pref:SettingsRow.SettingsContent>
                    <controls:SuggestBox IsStrict="True" Text="{Binding SelectedFontFamily}" Suggestions="{Binding FontFamilies}" Width="280" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
            <TextBlock Text="The quick brown fox jumps over the lazy dog" FontFamily="{Binding SelectedFontFamily}"
                       FontSize="14" Foreground="{DynamicResource PbTextMutedBrush}" Margin="0,8,0,0" />
        </StackPanel>

        <!-- Interface - Motion/Navigation/Developer consolidated from 3 single-row groups into one
             (docs/superpowers/specs/2026-09-07-appearance-redesign-design.md §4/Goal 6). Developer's
             row keeps its own IsDebugBuild visibility rather than the whole group needing it. -->
        <StackPanel Tag="appearance.interface">
            <TextBlock Classes="settingsGroupCaption" Text="INTERFACE" />
            <pref:SettingsRow Icon="Pulse" Title="Reduce motion"
                               Description="Shortens UI transitions to effectively instant.">
                <pref:SettingsRow.SettingsContent>
                    <ToggleSwitch IsChecked="{Binding ReducedMotion}" OnContent="{x:Null}" OffContent="{x:Null}" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
            <pref:SettingsRow Icon="Navigation" Title="Expand nav rail on hover"
                               Description="When off, the rail only expands while pinned open.">
                <pref:SettingsRow.SettingsContent>
                    <ToggleSwitch IsChecked="{Binding NavRailHoverExpandEnabled}" OnContent="{x:Null}" OffContent="{x:Null}" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
            <pref:SettingsRow Icon="Code" Title="Open the internal component/style showcase" IsVisible="{Binding IsDebugBuild}">
                <pref:SettingsRow.SettingsContent>
                    <Button Content="Open Design Showcase" Command="{Binding OpenDesignShowcaseCommand}" />
                </pref:SettingsRow.SettingsContent>
            </pref:SettingsRow>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</UserControl>
