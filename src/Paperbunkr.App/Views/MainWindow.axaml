<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
        xmlns:vm="using:Paperbunkr.App.ViewModels"
        xmlns:views="using:Paperbunkr.App.Views"
        xmlns:models="using:Paperbunkr.App.Models"
        xmlns:controls="using:Paperbunkr.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
        x:Class="Paperbunkr.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/paperbunkr.ico"
        Title="Paperbunkr"
        Width="1200" Height="760"
        Background="{DynamicResource PbBgBrush}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <!-- Rail nav button: 44x44, rounded, active state = accent-soft fill + accent text
             (docs/superpowers/specs/2026-08-24-navigation-shell-motion-system-design.md - rail
             restyled with Phase 1's surface/accent tokens; the glow-ring hover/focus treatment
             stays scoped to PosterTile/FloatingPanel, not applied here). -->
        <!-- Width is intentionally NOT set here (was a fixed 44) - Button.rail now stretches to
             fill whatever width Border.navRail currently has (64 collapsed, 200 expanded), with a
             fixed left Padding so the icon sits at the same visual offset in both states and only
             the label (which appears after it) gets more room when expanded. -->
        <Style Selector="Button.rail">
            <Setter Property="Height" Value="44" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Padding" Value="12,0,0,0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextFaintBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.rail:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PbAccentSoftBrush}" />
        </Style>
        <Style Selector="Button.rail.active">
            <Setter Property="Background" Value="{DynamicResource PbAccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbAccentTextBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- Rail nav icon: fi:SymbolIcon inherits the button's own Foreground, so the existing
             Button.rail / Button.rail.active Foreground Setters recolor the icon for free. Only
             the glyph size needs setting here. -->
        <Style Selector="Button.rail fi|SymbolIcon">
            <Setter Property="FontSize" Value="20" />
        </Style>

        <!-- Rail expand/collapse (docs/superpowers/specs/2026-08-24-navigation-shell-motion-system-
             design.md) - width transition uses the same PbMotionFast/PbMotionEase tokens as every
             Phase 1 primitive. Label fades in once there's room for it. -->
        <Style Selector="Border.navRail">
            <Setter Property="Width" Value="64" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Width" Duration="{DynamicResource PbMotionFast}" Easing="{StaticResource PbMotionEase}" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.navRail.expanded">
            <Setter Property="Width" Value="200" />
        </Style>
        <Style Selector="TextBlock.railLabel">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Sidebar nav row -->
        <Style Selector="Button.sideItemButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.sideItemButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PbAccentSoftBrush}" />
        </Style>
        <Style Selector="Button.sideItemButton.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PbAccentSoftBrush}" />
        </Style>
        <!-- Real bug found 2026-09-03: unlike Button.card (LibraryScreen.axaml's own :focus-within
             glow ring), sideItemButton had no focus-visible style at all - keyboard focus genuinely
             moves between rows (confirmed via an isolated FlaUI test reading translated Bounds from
             OnSidebarKeyDown's own diagnostic log), but with only :pointerover/.active (a
             ViewModel-bound selection state, not focus) styled, arrow-key navigation looked
             completely inert since nothing ever rendered differently. -->
        <Style Selector="Button.sideItemButton:focus-within /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.sideItemButton.active TextBlock.sideItemLabel">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
        </Style>

        <Style Selector="TextBlock.sideHeading">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextFaintBrush}" />
        </Style>

        <Style Selector="TextBlock.count">
            <Setter Property="FontFamily" Value="Consolas,monospace" />
            <Setter Property="FontSize" Value="10.5" />
        </Style>

        <Style Selector="Border.countBadge">
            <Setter Property="Background" Value="#30353F" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Discard-confirm banner buttons, styled to match IssuePropertiesScreen's headerAction ghost/primary pair -->
        <Style Selector="Button.discardConfirm">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.discardConfirm.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
        </Style>
        <Style Selector="Button.discardConfirm.primary">
            <Setter Property="Background" Value="#D96C6C" />
            <Setter Property="BorderBrush" Value="#D96C6C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#241505" />
        </Style>
    </Window.Styles>

    <Grid>
    <DockPanel LastChildFill="True">

        <!-- ============ Rail nav (64px) ============ -->
        <!-- Hidden on every reading screen (comic Reader / BookReader / PdfReader) via
             MainViewModel.IsInReader - reading is a full-bleed mode and each reader carries its own
             back/close chrome plus the app-wide Escape / browser-back / swipe-back gestures. This
             also covers the comic Reader's fullscreen toggle (docs/superpowers/specs/2026-08-10-
             reader-polish-continuous-scroll-chrome-overlays-design.md §7), which sets only
             Window.WindowState and has no reach into this rail (a sibling of the reader
             ContentControl, not inside its visual tree) - IsInReader is already true throughout. -->
        <!-- Collapsed 64px / expanded 200px (docs/superpowers/specs/2026-08-24-navigation-shell-
             motion-system-design.md) - hover expands as a temporary overlay (see PointerEntered/
             PointerExited below), pinning (ToggleNavRailPinCommand) makes it permanent/reflowing.
             Every button's own position/size when collapsed is unchanged from before this phase -
             HomeRailButton/PreferencesRailButton stay directly clickable without hovering first,
             since existing UI automation tests click them in the default collapsed state. -->
        <!-- ToolTip.ServiceEnabled (inherited attached property) set once here disables tooltips
             for every button inside while expanded - the label already showing the same text made
             the floating tooltip bubble redundant, found via direct user testing. -->
        <Border Classes="navRail" Classes.expanded="{Binding IsNavRailExpanded}"
                DockPanel.Dock="Left" Background="{DynamicResource PbChromeBrush}"
                BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,0,1,0"
                IsVisible="{Binding !IsInReader}"
                ToolTip.ServiceEnabled="{Binding !IsNavRailExpanded}"
                PointerEntered="RailPointerEntered" PointerExited="RailPointerExited">
            <Grid RowDefinitions="Auto,*,Auto" Margin="0,14,0,10">

                <StackPanel Grid.Row="0" Margin="10,0" Spacing="2">
                    <Border Width="26" Height="26" CornerRadius="6" BorderThickness="1.5"
                            BorderBrush="{DynamicResource PbAccentBrush}" Margin="0,0,0,12" HorizontalAlignment="Center" />

                    <Button Classes="rail" Classes.active="{Binding IsHome}"
                            Command="{Binding GoHomeCommand}" ToolTip.Tip="Home"
                            AutomationProperties.AutomationId="HomeRailButton">
                        <StackPanel Orientation="Horizontal">
                            <fi:SymbolIcon Symbol="Home" />
                            <TextBlock Classes="railLabel" Text="Home" IsVisible="{Binding IsNavRailExpanded}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="rail" Classes.active="{Binding IsLibrary}"
                            Command="{Binding GoLibraryCommand}" ToolTip.Tip="Library"
                            AutomationProperties.AutomationId="LibraryRailButton">
                        <StackPanel Orientation="Horizontal">
                            <fi:SymbolIcon Symbol="Book" />
                            <TextBlock Classes="railLabel" Text="Library" IsVisible="{Binding IsNavRailExpanded}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="rail" Classes.active="{Binding IsBooks}"
                            Command="{Binding GoBooksCommand}" ToolTip.Tip="Books"
                            AutomationProperties.AutomationId="BooksRailButton">
                        <StackPanel Orientation="Horizontal">
                            <fi:SymbolIcon Symbol="Book" />
                            <TextBlock Classes="railLabel" Text="Books" IsVisible="{Binding IsNavRailExpanded}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SmartListsRailButton" Classes="rail" Classes.active="{Binding IsSmart}"
                            Command="{Binding GoSmartCommand}" ToolTip.Tip="Smart Lists">
                        <StackPanel Orientation="Horizontal">
                            <fi:SymbolIcon Symbol="Filter" />
                            <TextBlock Classes="railLabel" Text="Smart Lists" IsVisible="{Binding IsNavRailExpanded}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ReadingListsRailButton" Classes="rail" Classes.active="{Binding IsReading}"
                            Command="{Binding GoReadingCommand}" ToolTip.Tip="Reading Lists">
                        <StackPanel Orientation="Horizontal">
                            <fi:SymbolIcon Symbol="Bookmark" />
                            <TextBlock Classes="railLabel" Text="Reading Lists" IsVisible="{Binding IsNavRailExpanded}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="rail" Classes.active="{Binding IsEvents}"
                            Command="{Binding GoEventsCommand}" ToolTip.Tip="Continuity"
                            AutomationProperties.AutomationId="EventsRailButton">
                        <StackPanel Orientation="Horizontal">
                            <fi:SymbolIcon Symbol="Star" />
                            <TextBlock Classes="railLabel" Text="Continuity" IsVisible="{Binding IsNavRailExpanded}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="10,0" Spacing="2">
                    <!-- Undo/Redo buttons removed from the rail 2026-09-05 (user request - the rail
                         was getting cluttered) - metadata-edit Undo/Redo (docs/ce-feature-inventory.md
                         §A) is still reachable app-wide via Ctrl+Z/Ctrl+Y (MainWindow.axaml.cs's
                         OnMainWindowKeyDown), UndoCommand/RedoCommand themselves are unchanged. The
                         separator that used to sit between them and Preferences went too - nothing
                         left to separate. -->
                    <Button Classes="rail" Classes.active="{Binding IsPreferences}"
                            Command="{Binding GoPreferencesCommand}" ToolTip.Tip="Preferences"
                            AutomationProperties.AutomationId="PreferencesRailButton">
                        <StackPanel Orientation="Horizontal">
                            <fi:SymbolIcon Symbol="Settings" />
                            <TextBlock Classes="railLabel" Text="Preferences" IsVisible="{Binding IsNavRailExpanded}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="rail" Classes.active="{Binding NavRailPinned}"
                            Command="{Binding ToggleNavRailPinCommand}"
                            ToolTip.Tip="Pin nav rail open" IsVisible="{Binding IsNavRailExpanded}">
                        <StackPanel Orientation="Horizontal">
                            <fi:SymbolIcon Symbol="Pin" />
                            <TextBlock Classes="railLabel" Text="Pin" IsVisible="{Binding !NavRailPinned}" />
                            <TextBlock Classes="railLabel" Text="Unpin" IsVisible="{Binding NavRailPinned}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Contextual sidebar (236px) ============ -->
        <Border DockPanel.Dock="Left" Width="236" Background="{DynamicResource PbChromeBrush}"
                BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,0,1,0"
                IsVisible="{Binding ShowContextualSidebar}"
                KeyDown="OnSidebarKeyDown">
            <ScrollViewer Padding="12,18">
                <StackPanel Spacing="2">

                    <!-- Library sidebar content -->
                    <StackPanel IsVisible="{Binding IsLibrary}" Spacing="2">
                        <TextBlock Text="Library" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource PbTextBrush}" Margin="8,0,8,14" />

                        <Button Classes="sideItemButton" Classes.active="{Binding Library.IsAllSeriesActive}"
                                Command="{Binding Library.SelectAllSeriesCommand}"
                                AutomationProperties.AutomationId="LibrarySidebarAllSeries"
                                AutomationProperties.HelpText="{Binding Library.IsAllSeriesActive}">
                            <Grid ColumnDefinitions="8,*,Auto">
                                <Border Grid.Column="0" Width="8" Height="8" CornerRadius="2"
                                        Background="{DynamicResource PbAccentTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="sideItemLabel" Text="All Series" Margin="9,0,0,0" FontSize="13"
                                           Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Classes="count" Text="{Binding Library.AllSeriesCount}"
                                           Foreground="{DynamicResource PbTextFaintBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <!-- Collections (docs/superpowers/specs/2026-08-27-collections-design.md, step 6) -
                             row treatment mirrors ecRow/rlRow/smRow above. -->
                        <StackPanel Spacing="1">
                            <StackPanel.Styles>
                                <Style Selector="Border.colRow"><Setter Property="BorderBrush" Value="Transparent" /></Style>
                                <Style Selector="Border.colRow.active">
                                    <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
                                    <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
                                </Style>
                                <Style Selector="Border.colRow Button.colHover"><Setter Property="Opacity" Value="0" /><Setter Property="IsHitTestVisible" Value="False" /></Style>
                                <Style Selector="Border.colRow:pointerover Button.colHover"><Setter Property="Opacity" Value="1" /><Setter Property="IsHitTestVisible" Value="True" /></Style>
                            </StackPanel.Styles>

                            <Grid ColumnDefinitions="*,Auto" Margin="8,12,6,6">
                                <TextBlock Grid.Column="0" Classes="sideHeading" Text="COLLECTIONS" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Width="24" Height="24" Padding="0" CornerRadius="6"
                                        Background="{DynamicResource PbSurface2Brush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1"
                                        Command="{Binding Library.BeginCreateCollectionCommand}" ToolTip.Tip="New collection"
                                        IsVisible="{Binding !Library.IsCreatingCollection}">
                                    <fi:SymbolIcon Symbol="Add" FontSize="{StaticResource PbIconSizeXs}" />
                                </Button>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="8,0,6,8" IsVisible="{Binding Library.IsCreatingCollection}">
                                <TextBox Grid.Column="0" Text="{Binding Library.NewCollectionName}" Watermark="Collection name" FontSize="12.5"
                                         AutomationProperties.AutomationId="NewCollectionNameBox">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding Library.CommitCreateCollectionCommand}" />
                                        <KeyBinding Gesture="Escape" Command="{Binding Library.CancelCreateCollectionCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <Button Grid.Column="1" Classes="headerAction ghost" Padding="6" Command="{Binding Library.CommitCreateCollectionCommand}">
                                    <fi:SymbolIcon Symbol="Checkmark" FontSize="{StaticResource PbIconSizeXs}" />
                                </Button>
                                <Button Grid.Column="2" Classes="headerAction ghost" Padding="6" Command="{Binding Library.CancelCreateCollectionCommand}">
                                    <fi:SymbolIcon Symbol="Dismiss" FontSize="{StaticResource PbIconSizeXs}" />
                                </Button>
                            </Grid>

                            <TextBlock Text="No collections yet." FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}"
                                       Margin="8,0,8,4" IsVisible="{Binding !Library.HasCollections}" />
                            <ItemsControl x:Name="LibraryCollections" ItemsSource="{Binding Library.Collections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:CollectionSummary">
                                        <Border Classes="colRow" Classes.active="{Binding IsActive}" CornerRadius="6" BorderThickness="3,0,0,0" Margin="0,1">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                <Panel Grid.Column="0" Width="14" Height="8" Margin="9,0,0,0" VerticalAlignment="Center">
                                                    <Ellipse Width="8" Height="8" HorizontalAlignment="Left"
                                                             Fill="{Binding AccentColor, Converter={x:Static views:AccentColorToBrushConverter.Instance}}" />
                                                    <fi:SymbolIcon Symbol="Wand" FontSize="{StaticResource PbIconSizeXs}" HorizontalAlignment="Right"
                                                                   Foreground="{DynamicResource PbTextFaintBrush}"
                                                                   IsVisible="{Binding IsSmart}" ToolTip.Tip="Has a rule-based membership slot" />
                                                </Panel>
                                                <Button Grid.Column="1" Classes="sideItemButton" Padding="8,7"
                                                        Command="{Binding #LibraryCollections.((vm:MainViewModel)DataContext).Library.SelectCollectionCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0" Classes="sideItemLabel" Text="{Binding Name}" FontSize="13"
                                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"
                                                                   Foreground="{DynamicResource PbTextMutedBrush}" />
                                                        <TextBlock Grid.Column="1" Classes="count" Text="{Binding Count}" Foreground="{DynamicResource PbTextFaintBrush}" />
                                                    </Grid>
                                                </Button>
                                                <Button Grid.Column="2" Classes="headerAction ghost colHover" Padding="6" Margin="2,0,0,0" VerticalAlignment="Center"
                                                        ToolTip.Tip="More">
                                                    <fi:SymbolIcon Symbol="MoreVertical" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbTextFaintBrush}" />
                                                    <Button.Flyout>
                                                        <MenuFlyout>
                                                            <MenuItem Header="Edit…"
                                                                      Command="{Binding #LibraryCollections.((vm:MainViewModel)DataContext).Library.OpenCollectionPropertiesCommand}"
                                                                      CommandParameter="{Binding}" />
                                                            <MenuItem Header="Move up"
                                                                      Command="{Binding #LibraryCollections.((vm:MainViewModel)DataContext).Library.MoveCollectionUpCommand}"
                                                                      CommandParameter="{Binding}" />
                                                            <MenuItem Header="Move down"
                                                                      Command="{Binding #LibraryCollections.((vm:MainViewModel)DataContext).Library.MoveCollectionDownCommand}"
                                                                      CommandParameter="{Binding}" />
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                                <Button Grid.Column="3" Classes="headerAction ghost colHover" Padding="6" Margin="2,0,4,0" VerticalAlignment="Center"
                                                        Command="{Binding DeleteConfirm.TriggerCommand}" ToolTip.Tip="{Binding DeleteConfirm.Label}">
                                                    <Panel>
                                                        <fi:SymbolIcon Symbol="Delete" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbTextFaintBrush}" IsVisible="{Binding !DeleteConfirm.IsArmed}" />
                                                        <fi:SymbolIcon Symbol="Delete" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbBadgeBrush}" IsVisible="{Binding DeleteConfirm.IsArmed}" />
                                                    </Panel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource PbBorderBrush}" Margin="0,12" />

                        <TextBlock Classes="sideHeading" Text="CONTENT TYPE" Margin="8,0,8,6" />

                        <ItemsControl x:Name="LibraryContentTypes" ItemsSource="{Binding Library.ContentTypes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ContentTypeSummary">
                                    <Button Classes="sideItemButton" Classes.active="{Binding IsActive}"
                                            Command="{Binding #LibraryContentTypes.((vm:MainViewModel)DataContext).Library.SelectContentTypeCommand}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.AutomationId="{Binding ContentType, StringFormat='LibraryContentTypeOption_{0}'}"
                                            AutomationProperties.HelpText="{Binding IsActive}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Classes="sideItemLabel" Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource PbTextMutedBrush}" />
                                            <TextBlock Grid.Column="1" Classes="count" Text="{Binding Count}" Foreground="{DynamicResource PbTextFaintBrush}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Smart Lists sidebar (docs/superpowers/specs/2026-08-29-smartlists-screen-
                         layout-redesign-design.md), wired to real SmartList data. Row treatment
                         mirrors ecRow/rlRow above. -->
                    <StackPanel IsVisible="{Binding IsSmart}" Spacing="1">
                        <StackPanel.Styles>
                            <Style Selector="Border.smRow"><Setter Property="BorderBrush" Value="Transparent" /></Style>
                            <Style Selector="Border.smRow.active">
                                <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
                                <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
                            </Style>
                            <Style Selector="Border.smRow Button.smDelete"><Setter Property="Opacity" Value="0" /><Setter Property="IsHitTestVisible" Value="False" /></Style>
                            <Style Selector="Border.smRow:pointerover Button.smDelete"><Setter Property="Opacity" Value="1" /><Setter Property="IsHitTestVisible" Value="True" /></Style>
                        </StackPanel.Styles>

                        <Grid ColumnDefinitions="*,Auto" Margin="8,0,6,14">
                            <TextBlock Grid.Column="0" Text="Smart Lists" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Width="24" Height="24" Padding="0" CornerRadius="6"
                                    Background="{DynamicResource PbSurface2Brush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1"
                                    Command="{Binding Smart.CreateNewCommand}" ToolTip.Tip="New Smart List">
                                <fi:SymbolIcon Symbol="Add" FontSize="{StaticResource PbIconSizeXs}" />
                            </Button>
                        </Grid>

                        <ItemsControl x:Name="BuiltInSmartLists" ItemsSource="{Binding Smart.BuiltInLists}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:SmartListSummary">
                                    <Border Classes="smRow" Classes.active="{Binding IsActive}" CornerRadius="6" BorderThickness="3,0,0,0" Margin="0,1">
                                        <Button Classes="sideItemButton" Padding="11,7"
                                                Command="{Binding #BuiltInSmartLists.((vm:MainViewModel)DataContext).Smart.SelectListCommand}"
                                                CommandParameter="{Binding}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Classes="sideItemLabel" Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource PbTextMutedBrush}" />
                                                <Border Grid.Column="1" Classes="countBadge"><TextBlock Classes="count" Text="{Binding MatchCount}" Foreground="{DynamicResource PbTextFaintBrush}" /></Border>
                                            </Grid>
                                        </Button>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Classes="sideHeading" Text="CUSTOM" Margin="8,12,8,6" />

                        <ItemsControl x:Name="CustomSmartLists" ItemsSource="{Binding Smart.CustomLists}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:SmartListSummary">
                                    <Border Classes="smRow" Classes.active="{Binding IsActive}" CornerRadius="6" BorderThickness="3,0,0,0" Margin="0,1">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Button Grid.Column="0" Classes="sideItemButton" Padding="11,7"
                                                    Command="{Binding #CustomSmartLists.((vm:MainViewModel)DataContext).Smart.SelectListCommand}"
                                                    CommandParameter="{Binding}">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Classes="sideItemLabel" Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource PbTextMutedBrush}" />
                                                    <Border Grid.Column="1" Classes="countBadge"><TextBlock Classes="count" Text="{Binding MatchCount}" Foreground="{DynamicResource PbTextFaintBrush}" /></Border>
                                                </Grid>
                                            </Button>
                                            <Button Grid.Column="1" Classes="headerAction ghost smDelete" Padding="6" Margin="2,0,4,0" VerticalAlignment="Center"
                                                    Command="{Binding DeleteConfirm.TriggerCommand}" ToolTip.Tip="{Binding DeleteConfirm.Label}">
                                                <Panel>
                                                    <fi:SymbolIcon Symbol="Delete" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbTextFaintBrush}" IsVisible="{Binding !DeleteConfirm.IsArmed}" />
                                                    <fi:SymbolIcon Symbol="Delete" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbBadgeBrush}" IsVisible="{Binding DeleteConfirm.IsArmed}" />
                                                </Panel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Classes="sideItemButton" Command="{Binding Smart.ToggleMaintenanceCommand}"
                                Padding="8,7" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <fi:SymbolIcon Symbol="ArrowDown" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbTextMutedBrush}" IsVisible="{Binding Smart.IsMaintenanceExpanded}" />
                                <fi:SymbolIcon Symbol="ChevronRight" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbTextMutedBrush}" IsVisible="{Binding !Smart.IsMaintenanceExpanded}" />
                                <TextBlock Text="Maintenance" FontSize="13" Foreground="{DynamicResource PbTextMutedBrush}" />
                            </StackPanel>
                        </Button>
                        <StackPanel Margin="14,0,0,0" Spacing="0" IsVisible="{Binding Smart.IsMaintenanceExpanded}">
                            <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1,0,0,0" Padding="10,0,0,0">
                                <ItemsControl x:Name="MaintenanceSmartLists" ItemsSource="{Binding Smart.MaintenanceLists}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:SmartListSummary">
                                            <Border Classes="smRow" Classes.active="{Binding IsActive}" CornerRadius="6" BorderThickness="3,0,0,0" Margin="0,1">
                                                <Button Classes="sideItemButton" Padding="11,7"
                                                        Command="{Binding #MaintenanceSmartLists.((vm:MainViewModel)DataContext).Smart.SelectListCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0" Classes="sideItemLabel" Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource PbTextMutedBrush}" />
                                                        <TextBlock Grid.Column="1" Classes="count" Text="{Binding MatchCount}" Foreground="{DynamicResource PbTextFaintBrush}" />
                                                    </Grid>
                                                </Button>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>

                        <!-- Series/Novel smart lists (docs/superpowers/specs/2026-08-30-smart-
                             collections-design.md) - always user-created, no built-in/maintenance
                             split, so each kind is just a flat heading + list like CUSTOM above. -->
                        <Grid ColumnDefinitions="*,Auto" Margin="8,12,6,6">
                            <TextBlock Grid.Column="0" Classes="sideHeading" Text="SERIES" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Width="20" Height="20" Padding="0" CornerRadius="5"
                                    Background="{DynamicResource PbSurface2Brush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1"
                                    Command="{Binding Smart.CreateNewSeriesListCommand}" ToolTip.Tip="New Series Smart List">
                                <fi:SymbolIcon Symbol="Add" FontSize="{StaticResource PbIconSizeXs}" />
                            </Button>
                        </Grid>
                        <ItemsControl x:Name="SeriesSmartLists" ItemsSource="{Binding Smart.SeriesLists}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:SmartListSummary">
                                    <Border Classes="smRow" Classes.active="{Binding IsActive}" CornerRadius="6" BorderThickness="3,0,0,0" Margin="0,1">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Button Grid.Column="0" Classes="sideItemButton" Padding="11,7"
                                                    Command="{Binding #SeriesSmartLists.((vm:MainViewModel)DataContext).Smart.SelectListCommand}"
                                                    CommandParameter="{Binding}">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Classes="sideItemLabel" Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource PbTextMutedBrush}" />
                                                    <Border Grid.Column="1" Classes="countBadge"><TextBlock Classes="count" Text="{Binding MatchCount}" Foreground="{DynamicResource PbTextFaintBrush}" /></Border>
                                                </Grid>
                                            </Button>
                                            <Button Grid.Column="1" Classes="headerAction ghost smDelete" Padding="6" Margin="2,0,4,0" VerticalAlignment="Center"
                                                    Command="{Binding DeleteConfirm.TriggerCommand}" ToolTip.Tip="{Binding DeleteConfirm.Label}">
                                                <Panel>
                                                    <fi:SymbolIcon Symbol="Delete" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbTextFaintBrush}" IsVisible="{Binding !DeleteConfirm.IsArmed}" />
                                                    <fi:SymbolIcon Symbol="Delete" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbBadgeBrush}" IsVisible="{Binding DeleteConfirm.IsArmed}" />
                                                </Panel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid ColumnDefinitions="*,Auto" Margin="8,12,6,6">
                            <TextBlock Grid.Column="0" Classes="sideHeading" Text="NOVELS" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Width="20" Height="20" Padding="0" CornerRadius="5"
                                    Background="{DynamicResource PbSurface2Brush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1"
                                    Command="{Binding Smart.CreateNewNovelListCommand}" ToolTip.Tip="New Novel Smart List">
                                <fi:SymbolIcon Symbol="Add" FontSize="{StaticResource PbIconSizeXs}" />
                            </Button>
                        </Grid>
                        <ItemsControl x:Name="NovelSmartLists" ItemsSource="{Binding Smart.NovelLists}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:SmartListSummary">
                                    <Border Classes="smRow" Classes.active="{Binding IsActive}" CornerRadius="6" BorderThickness="3,0,0,0" Margin="0,1">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Button Grid.Column="0" Classes="sideItemButton" Padding="11,7"
                                                    Command="{Binding #NovelSmartLists.((vm:MainViewModel)DataContext).Smart.SelectListCommand}"
                                                    CommandParameter="{Binding}">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Classes="sideItemLabel" Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource PbTextMutedBrush}" />
                                                    <Border Grid.Column="1" Classes="countBadge"><TextBlock Classes="count" Text="{Binding MatchCount}" Foreground="{DynamicResource PbTextFaintBrush}" /></Border>
                                                </Grid>
                                            </Button>
                                            <Button Grid.Column="1" Classes="headerAction ghost smDelete" Padding="6" Margin="2,0,4,0" VerticalAlignment="Center"
                                                    Command="{Binding DeleteConfirm.TriggerCommand}" ToolTip.Tip="{Binding DeleteConfirm.Label}">
                                                <Panel>
                                                    <fi:SymbolIcon Symbol="Delete" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbTextFaintBrush}" IsVisible="{Binding !DeleteConfirm.IsArmed}" />
                                                    <fi:SymbolIcon Symbol="Delete" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbBadgeBrush}" IsVisible="{Binding DeleteConfirm.IsArmed}" />
                                                </Panel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Reading Lists sidebar (docs/superpowers/specs/2026-08-28-reading-lists-screen-redesign-design.md → v2) -->
                    <StackPanel IsVisible="{Binding IsReading}" Spacing="1">
                        <StackPanel.Styles>
                            <Style Selector="Border.rlRow">
                                <Setter Property="BorderBrush" Value="Transparent" />
                            </Style>
                            <Style Selector="Border.rlRow.active">
                                <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
                                <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
                            </Style>
                            <Style Selector="Border.rlRow Button.rlDelete">
                                <Setter Property="Opacity" Value="0" />
                                <Setter Property="IsHitTestVisible" Value="False" />
                            </Style>
                            <Style Selector="Border.rlRow:pointerover Button.rlDelete">
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="IsHitTestVisible" Value="True" />
                            </Style>
                        </StackPanel.Styles>

                        <Grid ColumnDefinitions="*,Auto" Margin="8,0,6,14">
                            <TextBlock Grid.Column="0" Text="Reading Lists" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Width="24" Height="24" Padding="0" CornerRadius="6"
                                    Background="{DynamicResource PbSurface2Brush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1"
                                    Command="{Binding OpenNewReadingListDialogCommand}" ToolTip.Tip="New reading list"
                                    AutomationProperties.AutomationId="NewReadingListButton">
                                <fi:SymbolIcon Symbol="Add" FontSize="{StaticResource PbIconSizeXs}" />
                            </Button>
                        </Grid>

                        <Border IsVisible="{Binding Reading.HasActiveTagFilter}" Background="{DynamicResource PbAccentSoftBrush}"
                                CornerRadius="999" Padding="10,4" Margin="8,0,8,10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding Reading.ActiveTagFilter, StringFormat='Tag: {0}'}"
                                           FontSize="11.5" Foreground="{DynamicResource PbAccentTextBrush}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="✕" Padding="0" Width="16" Height="16" FontSize="9.5" CornerRadius="8"
                                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PbAccentTextBrush}"
                                        Command="{Binding Reading.ClearTagFilterCommand}" ToolTip.Tip="Clear tag filter" />
                            </Grid>
                        </Border>

                        <ItemsControl x:Name="ReadingLists" ItemsSource="{Binding Reading.Lists}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ReadingListSummary">
                                    <Border Classes="rlRow" Classes.active="{Binding IsActive}" CornerRadius="6" Margin="0,1"
                                            BorderThickness="3,0,0,0" Padding="0">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Button Grid.Column="0" Classes="sideItemButton" Padding="11,8"
                                                    Command="{Binding #ReadingLists.((vm:MainViewModel)DataContext).Reading.SelectListCommand}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Spacing="6">
                                                    <TextBlock Classes="sideItemLabel" Text="{Binding Name}" FontSize="12.5"
                                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"
                                                               Foreground="{DynamicResource PbTextMutedBrush}" />
                                                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding ProgressFraction}" Height="3" />
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="1" Classes="headerAction ghost rlDelete" Padding="6" Margin="2,0,4,0"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DeleteConfirm.TriggerCommand}" ToolTip.Tip="{Binding DeleteConfirm.Label}">
                                                <Panel>
                                                    <fi:SymbolIcon Symbol="Delete" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbTextFaintBrush}" IsVisible="{Binding !DeleteConfirm.IsArmed}" />
                                                    <fi:SymbolIcon Symbol="Delete" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbBadgeBrush}" IsVisible="{Binding DeleteConfirm.IsArmed}" />
                                                </Panel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Events & Continuity sidebar (docs/superpowers/specs/2026-08-28-events-continuity-screen-redesign-design.md) -->
                    <StackPanel IsVisible="{Binding IsEvents}" Spacing="1"
                                controls:ContextMenuHost.Provider="{Binding}">
                        <StackPanel.Styles>
                            <Style Selector="Border.ecRow"><Setter Property="BorderBrush" Value="Transparent" /></Style>
                            <Style Selector="Border.ecRow.active">
                                <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
                                <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
                            </Style>
                            <Style Selector="Border.ecRow Button.ecDelete"><Setter Property="Opacity" Value="0" /><Setter Property="IsHitTestVisible" Value="False" /></Style>
                            <Style Selector="Border.ecRow:pointerover Button.ecDelete"><Setter Property="Opacity" Value="1" /><Setter Property="IsHitTestVisible" Value="True" /></Style>
                        </StackPanel.Styles>

                        <Grid ColumnDefinitions="*,Auto" Margin="8,0,6,12">
                            <TextBlock Grid.Column="0" Text="Events &amp; Continuity" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Width="24" Height="24" Padding="0" CornerRadius="6"
                                    Background="{DynamicResource PbSurface2Brush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1" ToolTip.Tip="New...">
                                <fi:SymbolIcon Symbol="Add" FontSize="{StaticResource PbIconSizeXs}" />
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="New event" Command="{Binding OpenNewEventDialogCommand}" CommandParameter="Event" />
                                        <MenuItem Header="New continuity" Command="{Binding OpenNewEventDialogCommand}" CommandParameter="Continuity" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>

                        <TextBlock Text="Events" FontSize="9" Foreground="{DynamicResource PbTextFaintBrush}" Margin="8,4" />
                        <ItemsControl x:Name="StoryEvents" ItemsSource="{Binding Events.Events}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:StoryEventSummary">
                                    <Border Classes="ecRow" Classes.active="{Binding IsActive}" CornerRadius="6" BorderThickness="3,0,0,0" Margin="0,1">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Button Grid.Column="0" Classes="sideItemButton" Padding="11,7"
                                                    Command="{Binding #StoryEvents.((vm:MainViewModel)DataContext).Events.SelectEventCommand}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource PbTextMutedBrush}"
                                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                            </Button>
                                            <Button Grid.Column="1" Classes="headerAction ghost ecDelete" Padding="6" Margin="2,0,4,0" VerticalAlignment="Center"
                                                    Command="{Binding DeleteConfirm.TriggerCommand}" ToolTip.Tip="{Binding DeleteConfirm.Label}">
                                                <Panel>
                                                    <fi:SymbolIcon Symbol="Delete" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbTextFaintBrush}" IsVisible="{Binding !DeleteConfirm.IsArmed}" />
                                                    <fi:SymbolIcon Symbol="Delete" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbBadgeBrush}" IsVisible="{Binding DeleteConfirm.IsArmed}" />
                                                </Panel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No events yet" FontSize="10.5" Foreground="{DynamicResource PbTextFaintBrush}" Margin="11,4"
                                   IsVisible="{Binding Events.HasNoEvents}" />

                        <TextBlock Text="Continuities" FontSize="9" Foreground="{DynamicResource PbTextFaintBrush}" Margin="8,12,8,4" />
                        <ItemsControl x:Name="ContinuityList" ItemsSource="{Binding Events.Continuities}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ContinuitySummary">
                                    <Border Classes="ecRow" Classes.active="{Binding IsActive}" CornerRadius="6" BorderThickness="3,0,0,0" Margin="0,1">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Button Grid.Column="0" Classes="sideItemButton" Padding="11,7"
                                                    Command="{Binding #ContinuityList.((vm:MainViewModel)DataContext).Events.SelectContinuityCommand}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource PbTextMutedBrush}"
                                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                            </Button>
                                            <Button Grid.Column="1" Classes="headerAction ghost ecDelete" Padding="6" Margin="2,0,4,0" VerticalAlignment="Center"
                                                    Command="{Binding DeleteConfirm.TriggerCommand}" ToolTip.Tip="{Binding DeleteConfirm.Label}">
                                                <Panel>
                                                    <fi:SymbolIcon Symbol="Delete" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbTextFaintBrush}" IsVisible="{Binding !DeleteConfirm.IsArmed}" />
                                                    <fi:SymbolIcon Symbol="Delete" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbBadgeBrush}" IsVisible="{Binding DeleteConfirm.IsArmed}" />
                                                </Panel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No continuities yet" FontSize="10.5" Foreground="{DynamicResource PbTextFaintBrush}" Margin="11,4"
                                   IsVisible="{Binding Events.HasNoContinuities}" />
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ============ Status bar (docs/superpowers/specs/2026-09-03-activity-center-design.md) ============ -->
        <!-- Docked before the LastChildFill main-content Grid so it claims the window's bottom edge.
             Hidden on every reading screen (MainViewModel.IsInReader), same as the nav rail above. -->
        <views:StatusBar DockPanel.Dock="Bottom" IsVisible="{Binding !IsInReader}" />

        <!-- ============ Main content ============ -->
        <Grid>
            <!-- docs/superpowers/specs/2026-08-30-app-shell-navigation-history-design.md - real
                 layout row for the breadcrumb bar (Auto-height, collapses to 0 when IsVisible=False
                 since Avalonia skips Measure/Arrange for invisible elements), not a same-cell
                 overlay. A same-cell overlay (the first cut of this) visually covered each drill-
                 down screen's own top-of-content controls - e.g. DetailScreen.axaml's "← Back to
                 Library" button - with the breadcrumb bar's opaque background, found via on-screen
                 user testing. Row 1 (everything else) gets pushed down by the breadcrumb's real
                 height instead. -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- The 7 rail-ordered lateral screens (docs/superpowers/specs/2026-08-24-navigation-
                 shell-motion-system-design.md) share one TransitioningContentControl - direction
                 comes from MainViewModel.IsTransitionReversed (computed from rail-order comparison
                 in OnCurrentScreenChanging), content from ActiveScreenContent. The drill-down
                 screens (BookReader/PdfReader/Detail/BookDetail/MangaDetail/Reader) get their own
                 sibling TransitioningContentControl just below (docs/superpowers/specs/2026-09-04-
                 navigation-transition-system-design.md) - kept as a second control rather than
                 unifying the two groups (fork B1 over B2 in that design doc) so this working lateral
                 system stays untouched. -->
            <TransitioningContentControl Grid.Row="1" IsVisible="{Binding IsLateralScreen}"
                                          Content="{Binding ActiveScreenContent}"
                                          IsTransitionReversed="{Binding IsTransitionReversed}"
                                          PageTransition="{StaticResource PbScreenSlide}">
                <TransitioningContentControl.DataTemplates>
                    <DataTemplate DataType="vm:HomeScreenViewModel">
                        <views:HomeScreen />
                    </DataTemplate>
                    <DataTemplate DataType="vm:LibraryScreenViewModel">
                        <views:LibraryScreen />
                    </DataTemplate>
                    <DataTemplate DataType="vm:BooksScreenViewModel">
                        <views:BooksScreen />
                    </DataTemplate>
                    <DataTemplate DataType="vm:SmartScreenViewModel">
                        <views:SmartScreen />
                    </DataTemplate>
                    <DataTemplate DataType="vm:ReadingScreenViewModel">
                        <views:ReadingScreen />
                    </DataTemplate>
                    <DataTemplate DataType="vm:EventsScreenViewModel">
                        <views:EventsScreen />
                    </DataTemplate>
                    <DataTemplate DataType="vm:PreferencesScreenViewModel">
                        <views:PreferencesScreen />
                    </DataTemplate>
                </TransitioningContentControl.DataTemplates>
            </TransitioningContentControl>

            <!-- The 6 drill-down screens (docs/superpowers/specs/2026-09-04-navigation-transition-
                 system-design.md) - previously six always-instantiated ContentControls each toggled
                 by its own IsVisible, an instant cut. Now one TransitioningContentControl bound to
                 ActiveDrillDownContent; push/pop direction from IsDrillTransitionReversed. Each
                 screen's own ViewModel instance is unchanged (MainViewModel still owns Detail/
                 MangaDetail/Reader/BookReader/PdfReader/BookDetail permanently) - only which one this
                 control's Content points at changes, same as the lateral group above. The cover-art
                 shared-element flight (Library <-> Detail hero <-> Reader first page) plays on
                 TransitionOverlay above both this and the lateral control, driven by
                 NavigationTransitionCoordinator, not by anything declared here. -->
            <TransitioningContentControl Grid.Row="1" IsVisible="{Binding !IsLateralScreen}"
                                          Content="{Binding ActiveDrillDownContent}"
                                          IsTransitionReversed="{Binding IsDrillTransitionReversed}"
                                          PageTransition="{StaticResource PbDrillTransition}">
                <TransitioningContentControl.DataTemplates>
                    <DataTemplate DataType="vm:BookReaderScreenViewModel">
                        <views:BookReaderScreen />
                    </DataTemplate>
                    <DataTemplate DataType="vm:PdfPageReaderScreenViewModel">
                        <views:PdfPageReaderScreen />
                    </DataTemplate>
                    <DataTemplate DataType="vm:DetailScreenViewModel">
                        <views:DetailScreen />
                    </DataTemplate>
                    <DataTemplate DataType="vm:BookDetailScreenViewModel">
                        <views:BookDetailScreen />
                    </DataTemplate>
                    <DataTemplate DataType="vm:MangaDetailScreenViewModel">
                        <views:MangaDetailScreen />
                    </DataTemplate>
                    <DataTemplate DataType="vm:ReaderScreenViewModel">
                        <views:ReaderScreen />
                    </DataTemplate>
                </TransitioningContentControl.DataTemplates>
            </TransitioningContentControl>

            <!-- docs/superpowers/specs/2026-08-30-app-shell-navigation-history-design.md - Row 0,
                 real layout space above whichever drill-down ContentControl (Row 1) is visible; only
                 ever shown on the six drill-down screens, never the seven lateral rail ones. -->
            <views:Breadcrumb Grid.Row="0" IsVisible="{Binding ShowBreadcrumb}" />
        </Grid>

    </DockPanel>

    <!-- ============ Shared-element transition overlay (docs/superpowers/specs/2026-09-04-
         navigation-transition-system-design.md) ============ -->
    <!-- Above every screen + the breadcrumb, below the modal overlays (Activity drawer/Migration/
         properties popups below) so a flying cover never renders over an actual modal. A Canvas
         specifically (not a generic Panel) - SharedElementTransitionService positions its clone via
         Canvas.Left/Top plus a RenderTransform delta on top. Never touched directly in markup beyond
         this declaration; NavigationTransitionCoordinator drives it entirely through
         ISharedElementTransitionService, registered in MainWindow.axaml.cs. -->
    <Canvas x:Name="TransitionOverlay" IsHitTestVisible="False" ClipToBounds="False" />

    <!-- ============ Activity Center drawer (docs/superpowers/specs/2026-09-03-activity-center-design.md) ============ -->
    <!-- Tier 2. Overlay sibling of the DockPanel, non-blocking (no scrim) - the app stays usable
         behind it. IsVisible gates hit-testing when closed; the slide-up is the DrawerRoot.open
         pseudo-class inside the view. -->
    <views:ActivityDrawerView DataContext="{Binding ActivityCenter}"
                              IsVisible="{Binding IsDrawerOpen}"
                              VerticalAlignment="Bottom" />

    <!-- ============ Migration overlay (docs/superpowers/specs/2026-08-06-migration-ux-design.md §B) ============ -->
    <Border IsVisible="{Binding IsMigrationOverlayOpen}" Background="#B0000000">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <views:MigrationOverlay DataContext="{Binding Migration}" />
            <Button Classes="rail" Width="28" Height="28"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-14,0"
                    Background="{DynamicResource PbChromeBrush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1"
                    Command="{Binding CloseMigrationOverlayCommand}" ToolTip.Tip="Close"
                    AutomationProperties.AutomationId="MigrationOverlayCloseButton">
                <fi:SymbolIcon Symbol="DismissCircle" FontSize="{StaticResource PbIconSizeSm}" />
            </Button>
        </Grid>
    </Border>

    <!-- ============ Reading List properties overlay (docs/superpowers/specs/2026-08-23-reading-
         list-tags-design.md) - same backdrop-popup pattern as the Migration overlay above, not a
         screen swap ============ -->
    <Border IsVisible="{Binding IsReadingListPropertiesOverlayOpen}" Background="#B0000000">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <views:ReadingListPropertiesOverlay DataContext="{Binding ReadingListProperties}" />
            <Button Classes="rail" Width="28" Height="28"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-14,0"
                    Background="{DynamicResource PbChromeBrush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1"
                    Command="{Binding CloseReadingListPropertiesOverlayCommand}" ToolTip.Tip="Close"
                    AutomationProperties.AutomationId="ReadingListPropertiesOverlayCloseButton">
                <fi:SymbolIcon Symbol="DismissCircle" FontSize="{StaticResource PbIconSizeSm}" />
            </Button>
        </Grid>
    </Border>

    <!-- ============ Collection properties overlay (docs/superpowers/specs/2026-08-27-collections-
         design.md, step 8) - same backdrop-popup pattern as the Reading List overlay above ============ -->
    <Border IsVisible="{Binding IsCollectionPropertiesOverlayOpen}" Background="#B0000000">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <views:CollectionPropertiesOverlay DataContext="{Binding CollectionProperties}" />
            <Button Classes="rail" Width="28" Height="28"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-14,0"
                    Background="{DynamicResource PbChromeBrush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1"
                    Command="{Binding CloseCollectionPropertiesOverlayCommand}" ToolTip.Tip="Close"
                    AutomationProperties.AutomationId="CollectionPropertiesOverlayCloseButton">
                <fi:SymbolIcon Symbol="DismissCircle" FontSize="{StaticResource PbIconSizeSm}" />
            </Button>
        </Grid>
    </Border>

    <!-- ============ New Reading List dialog (docs/superpowers/specs/2026-08-28-reading-lists-
         screen-redesign-design.md → v2) - the sidebar "＋" opens this ============ -->
    <Border IsVisible="{Binding IsNewReadingListDialogOpen}" Background="#B0000000">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <views:NewReadingListOverlay DataContext="{Binding NewReadingList}" />
            <Button Classes="rail" Width="28" Height="28"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-14,0"
                    Background="{DynamicResource PbChromeBrush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1"
                    Command="{Binding CloseNewReadingListDialogCommand}" ToolTip.Tip="Close"
                    AutomationProperties.AutomationId="NewReadingListOverlayCloseButton">
                <fi:SymbolIcon Symbol="DismissCircle" FontSize="{StaticResource PbIconSizeSm}" />
            </Button>
        </Grid>
    </Border>

    <!-- ============ Name-this-workspace dialog (docs/superpowers/specs/2026-09-03-library-saved-
         workspaces-design.md) - shared by the Library and Books workspace switchers ============ -->
    <Border IsVisible="{Binding IsWorkspaceNameOverlayOpen}" Background="#B0000000">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <views:WorkspaceNameOverlay DataContext="{Binding WorkspaceName}" />
            <Button Classes="rail" Width="28" Height="28"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-14,0"
                    Background="{DynamicResource PbChromeBrush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1"
                    Command="{Binding CloseWorkspaceNameOverlayCommand}" ToolTip.Tip="Close"
                    AutomationProperties.AutomationId="WorkspaceNameOverlayCloseButton">
                <fi:SymbolIcon Symbol="DismissCircle" FontSize="{StaticResource PbIconSizeSm}" />
            </Button>
        </Grid>
    </Border>

    <!-- ============ Quick Open command palette (docs/superpowers/specs/2026-09-03-quick-open-
         command-palette-design.md) - Ctrl+P from any shell screen ============ -->
    <Border IsVisible="{Binding IsQuickOpenOverlayOpen}" Background="#B0000000">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Stretch">
            <views:QuickOpenOverlay DataContext="{Binding QuickOpen}" />
        </Grid>
    </Border>

    <!-- ============ New Event / New Continuity dialog (docs/superpowers/specs/2026-08-28-events-
         continuity-screen-redesign-design.md) ============ -->
    <Border IsVisible="{Binding IsNewEventDialogOpen}" Background="#B0000000">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <views:NewEventOrContinuityOverlay DataContext="{Binding NewEventOrContinuity}" />
            <Button Classes="rail" Width="28" Height="28"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-14,0"
                    Background="{DynamicResource PbChromeBrush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1"
                    Command="{Binding CloseNewEventDialogCommand}" ToolTip.Tip="Close">
                <fi:SymbolIcon Symbol="DismissCircle" FontSize="{StaticResource PbIconSizeSm}" />
            </Button>
        </Grid>
    </Border>

    <!-- ============ Book Properties editor overlay (docs/superpowers/specs/2026-08-27-book-
         properties-editor-design.md) - same backdrop-popup pattern as Reading List Properties above ============ -->
    <Border IsVisible="{Binding IsBookPropertiesOverlayOpen}" Background="#B0000000">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <views:BookPropertiesOverlay DataContext="{Binding BookProperties}" />
            <Button Classes="rail" Width="28" Height="28"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-14,0"
                    Background="{DynamicResource PbChromeBrush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1"
                    Command="{Binding CloseBookPropertiesOverlayCommand}" ToolTip.Tip="Close"
                    AutomationProperties.AutomationId="BookPropertiesOverlayCloseButton">
                <fi:SymbolIcon Symbol="DismissCircle" FontSize="{StaticResource PbIconSizeSm}" />
            </Button>
        </Grid>
    </Border>

    <!-- ============ Bulk book properties overlay (docs/superpowers/specs/2026-08-27-books-bulk-
         series-editing-design.md, component b) ============ -->
    <Border IsVisible="{Binding IsBulkBookPropertiesOverlayOpen}" Background="#B0000000">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <views:BulkBookPropertiesOverlay DataContext="{Binding BulkBookProperties}" />
            <Button Classes="rail" Width="28" Height="28"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-14,0"
                    Background="{DynamicResource PbChromeBrush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1"
                    Command="{Binding CloseBulkBookPropertiesOverlayCommand}" ToolTip.Tip="Close"
                    AutomationProperties.AutomationId="BulkBookPropertiesOverlayCloseButton">
                <fi:SymbolIcon Symbol="DismissCircle" FontSize="{StaticResource PbIconSizeSm}" />
            </Button>
        </Grid>
    </Border>

    <!-- ============ BookSeries properties overlay (docs/superpowers/specs/2026-08-27-books-bulk-
         series-editing-design.md, component c) ============ -->
    <Border IsVisible="{Binding IsBookSeriesPropertiesOverlayOpen}" Background="#B0000000">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <views:BookSeriesPropertiesOverlay DataContext="{Binding BookSeriesProperties}" />
            <Button Classes="rail" Width="28" Height="28"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-14,0"
                    Background="{DynamicResource PbChromeBrush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1"
                    Command="{Binding CloseBookSeriesPropertiesOverlayCommand}" ToolTip.Tip="Close"
                    AutomationProperties.AutomationId="BookSeriesPropertiesOverlayCloseButton">
                <fi:SymbolIcon Symbol="DismissCircle" FontSize="{StaticResource PbIconSizeSm}" />
            </Button>
        </Grid>
    </Border>

    <!-- ============ Quick Rate overlay (docs/ce-feature-inventory.md §A "Quick Rating + free-text
         Review in one popup") - same backdrop-popup pattern as Reading List Properties above ============ -->
    <Border IsVisible="{Binding IsQuickRateOverlayOpen}" Background="#B0000000">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <views:QuickRateOverlay DataContext="{Binding QuickRate}" />
            <Button Classes="rail" Width="28" Height="28"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-14,0"
                    Background="{DynamicResource PbChromeBrush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1"
                    Command="{Binding CloseQuickRateOverlayCommand}" ToolTip.Tip="Close"
                    AutomationProperties.AutomationId="QuickRateOverlayCloseButton">
                <fi:SymbolIcon Symbol="DismissCircle" FontSize="{StaticResource PbIconSizeSm}" />
            </Button>
        </Grid>
    </Border>

    <!-- ============ Design Showcase overlay (docs/superpowers/specs/2026-08-24-design-language-
         foundation-design.md, debug-only) - same backdrop-popup pattern as Quick Rate above ============ -->
    <Border IsVisible="{Binding IsDesignShowcaseOverlayOpen}" Background="#B0000000">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <views:DesignShowcaseOverlay DataContext="{Binding DesignShowcase}" />
            <Button Classes="rail" Width="28" Height="28"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-14,0"
                    Background="{DynamicResource PbChromeBrush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1"
                    Command="{Binding CloseDesignShowcaseOverlayCommand}" ToolTip.Tip="Close"
                    AutomationProperties.AutomationId="DesignShowcaseOverlayCloseButton">
                <fi:SymbolIcon Symbol="DismissCircle" FontSize="{StaticResource PbIconSizeSm}" />
            </Button>
        </Grid>
    </Border>

    <!-- ============ Issue Properties overlay (docs/superpowers/specs/2026-08-23-issue-editor-
         borderless-overlay-design.md) - same backdrop-popup pattern as Migration/Reading List
         Properties above, replacing the old full-screen CurrentScreen swap ============ -->
    <Border IsVisible="{Binding IsIssuePropertiesOverlayOpen}" Background="#B0000000">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <views:IssuePropertiesScreen DataContext="{Binding IssueProperties}" />
            <Button Classes="rail" Width="28" Height="28"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-14,0"
                    Background="{DynamicResource PbChromeBrush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1"
                    Command="{Binding CloseIssuePropertiesOverlayCommand}" ToolTip.Tip="Close"
                    AutomationProperties.AutomationId="IssuePropertiesOverlayCloseButton">
                <fi:SymbolIcon Symbol="DismissCircle" FontSize="{StaticResource PbIconSizeSm}" />
            </Button>
        </Grid>
    </Border>

    <!-- ============ Bulk Issue Editing overlay (docs/superpowers/specs/2026-08-23-issue-editor-
         borderless-overlay-design.md) ============ -->
    <Border IsVisible="{Binding IsBulkIssuePropertiesOverlayOpen}" Background="#B0000000">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <views:BulkIssuePropertiesScreen DataContext="{Binding BulkIssueProperties}" />
            <Button Classes="rail" Width="28" Height="28"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-14,0"
                    Background="{DynamicResource PbChromeBrush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1"
                    Command="{Binding CloseBulkIssuePropertiesOverlayCommand}" ToolTip.Tip="Close"
                    AutomationProperties.AutomationId="BulkIssuePropertiesOverlayCloseButton">
                <fi:SymbolIcon Symbol="DismissCircle" FontSize="{StaticResource PbIconSizeSm}" />
            </Button>
        </Grid>
    </Border>

    <!-- ============ Bulk Series Editing overlay (docs/superpowers/specs/2026-08-24-library-
         multiselect-slice3-design.md) ============ -->
    <Border IsVisible="{Binding IsBulkSeriesPropertiesOverlayOpen}" Background="#B0000000">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <views:BulkSeriesPropertiesScreen DataContext="{Binding BulkSeriesProperties}" />
            <Button Classes="rail" Width="28" Height="28"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-14,0"
                    Background="{DynamicResource PbChromeBrush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1"
                    Command="{Binding CloseBulkSeriesPropertiesOverlayCommand}" ToolTip.Tip="Close"
                    AutomationProperties.AutomationId="BulkSeriesPropertiesOverlayCloseButton">
                <fi:SymbolIcon Symbol="DismissCircle" FontSize="{StaticResource PbIconSizeSm}" />
            </Button>
        </Grid>
    </Border>

    <!-- ============ Unsaved-changes discard confirm (P6 follow-up, docs/alpha-todo.md) - guards
         the rail nav against silently abandoning an in-progress Issue Properties/Bulk Editing edit,
         see MainViewModel.TryLeaveCurrentEditor ============ -->
    <Border IsVisible="{Binding IsDiscardConfirmOpen}" Background="#B0000000">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="360"
                Background="{DynamicResource PbChromeBrush}" BorderBrush="{DynamicResource PbBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="20">
            <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <fi:SymbolIcon Symbol="Warning" FontSize="{StaticResource PbIconSizeLg}" Foreground="#D96C6C" />
                    <TextBlock Text="Unsaved changes" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="You have unsaved edits on this screen. Leaving now will discard them."
                           FontSize="12.5" Foreground="{DynamicResource PbTextMutedBrush}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Classes="discardConfirm ghost" Content="Keep Editing" Command="{Binding CancelDiscardCommand}" />
                    <Button Classes="discardConfirm primary" Content="Discard" Command="{Binding ConfirmDiscardCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>

    <!-- ============ First-run welcome overlay (docs/superpowers/specs/2026-08-31-first-run-
         onboarding-design.md) - same backdrop-popup pattern as the Migration overlay above, opened
         from App.axaml.cs in place of the old CE-only auto-migration launch ============ -->
    <Border IsVisible="{Binding IsWelcomeOverlayOpen}" Background="#B0000000">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <views:WelcomeOverlay DataContext="{Binding Welcome}" />
            <Button Classes="rail" Width="28" Height="28"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-14,0"
                    Background="{DynamicResource PbChromeBrush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1"
                    Command="{Binding Welcome.SkipCommand}" ToolTip.Tip="Close"
                    AutomationProperties.AutomationId="WelcomeOverlayCloseButton">
                <fi:SymbolIcon Symbol="DismissCircle" FontSize="{StaticResource PbIconSizeSm}" />
            </Button>
        </Grid>
    </Border>

    <!-- ============ Auto-update: update-available prompt (docs/superpowers/specs/
         2026-09-01-auto-update-and-changelog-design.md) - same backdrop-popup pattern as Welcome
         above ============ -->
    <Border IsVisible="{Binding IsUpdateAvailableOverlayOpen}" Background="#B0000000">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <views:UpdateAvailableOverlay DataContext="{Binding Update}" />
            <Button Classes="rail" Width="28" Height="28"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-14,0"
                    Background="{DynamicResource PbChromeBrush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1"
                    Command="{Binding Update.NotNowCommand}" ToolTip.Tip="Close"
                    AutomationProperties.AutomationId="UpdateAvailableOverlayCloseButton">
                <fi:SymbolIcon Symbol="DismissCircle" FontSize="{StaticResource PbIconSizeSm}" />
            </Button>
        </Grid>
    </Border>

    <!-- ============ Post-welcome tour offer (docs/superpowers/specs/2026-08-31-first-run-
         onboarding-design.md) - same small centered card pattern as the discard-confirm block above,
         shown once regardless of which welcome-screen path (including Skip) was taken ============ -->
    <Border IsVisible="{Binding IsTourOfferOpen}" Background="#B0000000">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="360"
                Background="{DynamicResource PbChromeBrush}" BorderBrush="{DynamicResource PbBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="20">
            <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <fi:SymbolIcon Symbol="Sparkle" FontSize="{StaticResource PbIconSizeLg}" Foreground="{DynamicResource PbAccentTextBrush}" />
                    <TextBlock Text="Want a quick tour?" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="A short walkthrough of what's where - Library, Smart Lists, Reading Lists, and more."
                           FontSize="12.5" Foreground="{DynamicResource PbTextMutedBrush}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Classes="discardConfirm ghost" Content="No thanks" Command="{Binding DeclineTourCommand}"
                            AutomationProperties.AutomationId="TourOfferDecline" />
                    <Button Classes="discardConfirm primary" Content="Take the tour" Command="{Binding TakeTourCommand}"
                            AutomationProperties.AutomationId="TourOfferAccept" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>

    <!-- ============ Live spotlight tour (docs/superpowers/specs/2026-08-31-first-run-onboarding-
         design.md) - topmost of everything, including the rail/sidebar/content area, since it needs
         to highlight controls in those. Unlike every overlay above, it is NOT wrapped in the shared
         Border/#B0000000 backdrop - it draws its own scrim internally so it can punch a cutout in
         it, which the shared full-opacity backdrop can't do. ============ -->
    <Panel IsVisible="{Binding IsWelcomeTourOverlayOpen}">
        <views:WelcomeTourOverlay DataContext="{Binding WelcomeTour}" />
    </Panel>
    </Grid>
</Window>
