<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:controls="using:Paperbunkr.App.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:pref="using:Paperbunkr.App.Views.Preferences"
             xmlns:scraper="using:Paperbunkr.App.Scraper"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="680" d:DesignHeight="720"
             x:Class="Paperbunkr.App.Views.Preferences.OrganizeScrapeSection"
             x:DataType="vm:OrganizeScrapeSettingsViewModel">

    <!-- Preferences -> Organize & Scrape (docs/superpowers/specs/2026-09-20-cluster-library-manager-into-core-design.md 8), split into three
         tabs (docs/superpowers/specs/2026-09-26-preferences-reader-organize-tabs-design.md): Scrape / Filters & names / Organize. Title and
         tab strip stay put; each tab's panel scrolls on its own. Save is one action for the whole ScrapeSettings row, pinned below the panel
         on the two tabs that hold those settings (the Organize tab's profiles manage themselves). Pb* tokens only. No secrets here: the
         ComicVine key is under Connections. Copy says "the source" where a setting applies to whichever provider a scrape runs on. -->
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="28,20,0,0">
        <TextBlock Grid.Row="0" Classes="pbTextHeading" Text="Organize &amp; Scrape" Margin="0,0,0,14" />
        <pref:SettingsTabStrip Grid.Row="1" Tabs="{Binding Tabs}" AutomationProperties.Name="Organize and Scrape tabs" />

        <Panel Grid.Row="2">

            <!-- SCRAPE -->
            <ScrollViewer IsVisible="{Binding Tabs.SelectedKey, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=scrape}">
                <StackPanel Margin="0,16,28,24" Spacing="20">
                    <TextBlock Text="Right-click comics or a series and choose Scrape to match them and fill in their details. These options control how a scrape behaves."
                               FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" />

                    <StackPanel Tag="organizeScrape.source">
                        <TextBlock Classes="settingsGroupCaption" Text="SOURCE" />
                        <pref:SettingsRow Icon="Link" Title="Scrape from"
                                           Description="Where scrapes look comics up. Metron is an alternative to ComicVine; its login is managed under Connections. You can switch a single scrape inside the match dialog, and scheduled scrapes always use this one.">
                            <pref:SettingsRow.SettingsContent>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="Metron login not set" VerticalAlignment="Center" FontSize="12" IsVisible="{Binding !HasMetronLogin}" Foreground="{DynamicResource PbTextMutedBrush}" />
                                    <controls:SuggestBox IsStrict="True" Width="140" Text="{Binding DefaultProviderText}" Suggestions="{x:Static vm:OrganizeScrapeSettingsViewModel.ProviderNames}"
                                                         AutomationProperties.Name="Scrape from" AutomationProperties.AutomationId="ScrapeDefaultProvider" />
                                </StackPanel>
                            </pref:SettingsRow.SettingsContent>
                        </pref:SettingsRow>
                        <pref:SettingsRow Icon="Link" Title="ComicVine API key"
                                           Description="Scraping from ComicVine needs your key. It is managed under Connections, with every other key.">
                            <pref:SettingsRow.SettingsContent>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="Connected" VerticalAlignment="Center" FontSize="12" IsVisible="{Binding HasComicVineKey}" Foreground="{DynamicResource PbSuccessBrush}" />
                                    <TextBlock Text="Not set" VerticalAlignment="Center" FontSize="12" IsVisible="{Binding !HasComicVineKey}" Foreground="{DynamicResource PbTextMutedBrush}" />
                                    <Button Classes="headerAction ghost" Content="Open Connections" Command="{Binding OpenConnectionsCommand}"
                                            AutomationProperties.AutomationId="ScrapeOpenConnectionsButton" />
                                </StackPanel>
                            </pref:SettingsRow.SettingsContent>
                        </pref:SettingsRow>
                    </StackPanel>

                    <StackPanel Tag="organizeScrape.matching">
                        <TextBlock Classes="settingsGroupCaption" Text="MATCHING" />

                        <pref:SettingsRow Icon="Checkmark" Title="Choose the best match automatically"
                                           Description="Apply the top-scored series without showing the review dialog. Off means you confirm each series. Scheduled scrapes never ask, so they skip anything that isn't clear-cut unless this is on.">
                            <pref:SettingsRow.SettingsContent>
                                <ToggleSwitch IsChecked="{Binding AutoChooseTopMatch}" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.Name="Choose the best match automatically" />
                            </pref:SettingsRow.SettingsContent>
                        </pref:SettingsRow>

                        <pref:SettingsRow Icon="Search" Title="Confirm the issue too"
                                           Description="After the series is chosen, show which issue was matched so you can correct it. Off applies whatever the issue number matches.">
                            <pref:SettingsRow.SettingsContent>
                                <ToggleSwitch IsChecked="{Binding ConfirmIssueMatch}" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.Name="Confirm the matched issue" />
                            </pref:SettingsRow.SettingsContent>
                        </pref:SettingsRow>

                        <pref:SettingsRow Icon="Filter" Title="Results considered per comic"
                                           Description="How many results are scored for each comic. Blank means all.">
                            <pref:SettingsRow.SettingsContent>
                                <TextBox Text="{Binding MaxSearchResults}" Width="120" AutomationProperties.Name="Maximum search results" />
                            </pref:SettingsRow.SettingsContent>
                        </pref:SettingsRow>

                        <pref:SettingsRow Icon="Image" Title="Show the series art"
                                           Description="Always show the series/volume cover in the match dialog. Off falls back to that specific issue's own cover instead.">
                            <pref:SettingsRow.SettingsContent>
                                <ToggleSwitch IsChecked="{Binding ForceSeriesArt}" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.Name="Show the series art" />
                            </pref:SettingsRow.SettingsContent>
                        </pref:SettingsRow>

                        <pref:SettingsRow Icon="Image" Title="Show cover thumbnails"
                                           Description="Show cover images in the match and issue dialogs. Off scrapes faster on a slow connection.">
                            <pref:SettingsRow.SettingsContent>
                                <ToggleSwitch IsChecked="{Binding ShowCovers}" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.Name="Show cover thumbnails" />
                            </pref:SettingsRow.SettingsContent>
                        </pref:SettingsRow>

                        <pref:SettingsRow Icon="Clock" Title="Delay between comics (ms)"
                                           Description="A pause before each comic after the first in a batch, separate from the source's own per-request rate limit.">
                            <pref:SettingsRow.SettingsContent>
                                <TextBox Text="{Binding ScrapeDelayMs}" Width="120" AutomationProperties.Name="Delay between comics in milliseconds" />
                            </pref:SettingsRow.SettingsContent>
                        </pref:SettingsRow>
                    </StackPanel>

                    <StackPanel Tag="organizeScrape.writing">
                        <TextBlock Classes="settingsGroupCaption" Text="WRITING" />

                        <pref:SettingsRow Icon="Edit" Title="Overwrite existing values"
                                           Description="Replace a field that already has a value with the source's. Off only fills in what is empty.">
                            <pref:SettingsRow.SettingsContent>
                                <ToggleSwitch IsChecked="{Binding OverwriteExisting}" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.Name="Overwrite existing values" />
                            </pref:SettingsRow.SettingsContent>
                        </pref:SettingsRow>

                        <pref:SettingsRow Icon="Delete" Title="Never blank a field"
                                           Description="Don't replace an existing value with an empty one when the source has nothing for that field.">
                            <pref:SettingsRow.SettingsContent>
                                <ToggleSwitch IsChecked="{Binding IgnoreBlankValues}" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.Name="Never blank a field" />
                            </pref:SettingsRow.SettingsContent>
                        </pref:SettingsRow>

                        <pref:SettingsRow Icon="Edit" Title="Resolve imprints to their parent publisher"
                                           Description="Recognized imprints (Vertigo, Marvel Max, ...) write their parent publisher to Publisher and the imprint name to Imprint. Off writes the source's raw publisher straight to Publisher instead.">
                            <pref:SettingsRow.SettingsContent>
                                <ToggleSwitch IsChecked="{Binding ConvertImprints}" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.Name="Resolve imprints to their parent publisher" />
                            </pref:SettingsRow.SettingsContent>
                        </pref:SettingsRow>

                        <StackPanel Spacing="8" Margin="0,8,0,0">
                            <TextBlock Text="Fields to fill in" FontSize="12" Foreground="{DynamicResource PbTextBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="headerAction ghost" Content="All" Command="{Binding EnableAllFieldsCommand}" />
                                <Button Classes="headerAction ghost" Content="None" Command="{Binding DisableAllFieldsCommand}" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding FieldToggles}" MaxWidth="640" HorizontalAlignment="Left">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ScrapeFieldToggle">
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsEnabled}" Width="200" Margin="0,0,8,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- FILTERS & NAMES -->
            <ScrollViewer IsVisible="{Binding Tabs.SelectedKey, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=filters}">
                <StackPanel Margin="0,16,28,24" Spacing="20">

                    <StackPanel Tag="organizeScrape.filters" Spacing="10">
                        <TextBlock Classes="settingsGroupCaption" Text="IGNORE RULES" />
                        <TextBlock Text="Drop unlikely results before they are scored (CE's advanced scraper settings). These apply to whichever source a scrape runs on."
                                   FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" />

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Ignore volumes before year" FontSize="12" Foreground="{DynamicResource PbTextBrush}" />
                                <TextBox Text="{Binding IgnoreBeforeYear}" Width="150" AutomationProperties.Name="Ignore volumes before year" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Ignore volumes after year" FontSize="12" Foreground="{DynamicResource PbTextBrush}" />
                                <TextBox Text="{Binding IgnoreAfterYear}" Width="150" AutomationProperties.Name="Ignore volumes after year" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Never ignore at this many issues" FontSize="12" Foreground="{DynamicResource PbTextBrush}" />
                                <TextBox Text="{Binding NeverIgnoreThreshold}" Width="150" AutomationProperties.Name="Never ignore volumes with at least this many issues" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Ignored publishers (one per line)" FontSize="12" Foreground="{DynamicResource PbTextBrush}" />
                            <TextBox Text="{Binding IgnoredPublishers}" AcceptsReturn="True" Height="80" Width="520" HorizontalAlignment="Left" AutomationProperties.Name="Ignored publishers" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Words to leave out of searches (one per line)" FontSize="12" Foreground="{DynamicResource PbTextBrush}" />
                            <TextBox Text="{Binding IgnoredSearchTerms}" AcceptsReturn="True" Height="80" Width="520" HorizontalAlignment="Left" AutomationProperties.Name="Ignored search words" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Tag="organizeScrape.names" Spacing="10">
                        <TextBlock Classes="settingsGroupCaption" Text="NAME MAPPING" />
                        <TextBlock Text="Rewrite publisher names as they are written. Imprint mapping runs first, then aliases."
                                   FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="Imprint to parent publisher (Imprint --> Publisher, one per line)" FontSize="12" Foreground="{DynamicResource PbTextBrush}" />
                            <TextBox Text="{Binding ImprintOverrides}" AcceptsReturn="True" Height="80" Width="520" HorizontalAlignment="Left" AutomationProperties.Name="Imprint overrides" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Publisher aliases (Publisher --> Alias, one per line)" FontSize="12" Foreground="{DynamicResource PbTextBrush}" />
                            <TextBox Text="{Binding PublisherAliases}" AcceptsReturn="True" Height="80" Width="520" HorizontalAlignment="Left" AutomationProperties.Name="Publisher aliases" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ORGANIZE -->
            <ScrollViewer IsVisible="{Binding Tabs.SelectedKey, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=organize}">
                <StackPanel Margin="0,16,28,40" Spacing="20">
                    <StackPanel Tag="organizeScrape.profiles" Spacing="10" IsVisible="{Binding Profiles, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Classes="settingsGroupCaption" Text="ORGANIZER PROFILES" />
                        <TextBlock Text="Right-click comics or a series and choose Organize to move or copy files into folders named by a profile's templates. Every move can be undone."
                                   FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" />
                        <scraper:ProfileManagerView DataContext="{Binding Profiles}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Panel>

        <!-- Save footer: the whole ScrapeSettings row in one write; hidden on the Organize tab. Edits survive tab switches (one view model). -->
        <Border Grid.Row="3" IsVisible="{Binding IsSaveFooterVisible}" Margin="0,0,28,0" Padding="0,10,0,14"
                BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Classes="headerAction primary" Command="{Binding SaveCommand}" VerticalAlignment="Center" AutomationProperties.AutomationId="ScrapeSaveButton">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <fi:SymbolIcon Symbol="Save" FontSize="{StaticResource PbIconSizeXs}" />
                        <TextBlock Text="Save" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasErrorStatus}" FontSize="12" TextWrapping="Wrap" MaxWidth="520" VerticalAlignment="Center"
                           Foreground="{DynamicResource PbDangerBrush}" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasInfoStatus}" FontSize="12" TextWrapping="Wrap" MaxWidth="520" VerticalAlignment="Center"
                           Foreground="{DynamicResource PbSuccessBrush}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
