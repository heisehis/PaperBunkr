<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:views="using:Paperbunkr.App.Views"
             xmlns:controls="using:Paperbunkr.App.Controls"
             xmlns:models="using:Paperbunkr.App.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="Paperbunkr.App.Views.SmartScreen"
             x:DataType="vm:SmartScreenViewModel">

    <UserControl.Styles>

        <!-- conditionPicker: rule-builder SuggestBox. Brush/radius setters ride the ControlTheme's
             TemplateBindings to PART_TextBox; the inner padding needs the /template/ selector. -->
        <Style Selector="controls|SuggestBox.conditionPicker">
            <Setter Property="Background" Value="{DynamicResource PbChromeBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusSm}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinWidth" Value="120" />
        </Style>
        <Style Selector="controls|SuggestBox.conditionPicker /template/ TextBox#PART_TextBox">
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <!-- Surface, border and shape come from the shared underlined-field style (2026-10-19 UI polish foundation §4). -->
        <Style Selector="TextBox.conditionValue">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinWidth" Value="120" />
        </Style>

        <!-- NOT / Aa toggles on a condition row -->
        <Style Selector="ToggleButton.conditionFlag">
            <Setter Property="Background" Value="{DynamicResource PbChromeBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusSm}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
        </Style>
        <Style Selector="ToggleButton.conditionFlag:checked">
            <Setter Property="Background" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbBadgeTextBrush}" />
        </Style>

        <!-- And/Or toggle at the top of a group card -->


        <!-- Matches Button.card in LibraryScreen.axaml - transparent hit-target wrapper. -->
        <Style Selector="Button.resultCard">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Matches Border.issueTile in DetailTabs.axaml exactly (docs/superpowers/specs/
             2026-08-09-smart-lists-results-view-design.md) - same visual, no selection state since
             results here are read-only/click-to-navigate. -->
        <Style Selector="Border.resultTile">
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusSm}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="Height" Value="168" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <!-- Recursive group card: the nested ItemsControl below references this same key, so an
             arbitrarily deep AND/OR tree renders (docs/superpowers/specs/2026-08-28-smartlist-
             engine-v2-design.md §2). A single non-nested group renders as a flat pill list,
             exactly like the pre-v2 UI. -->
        <DataTemplate x:Key="GroupCardTemplate" x:DataType="vm:SmartListGroupViewModel">
            <Border Classes="card" Margin="0,0,0,10">
                <StackPanel Spacing="10">

                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0" Classes="segItem" Command="{Binding ToggleModeCommand}"
                                Content="{Binding ModeLabel}" IsEnabled="{Binding !IsReadOnly}"
                                ToolTip.Tip="Switch between matching ALL and ANY of the rows below" />
                        <TextBlock Grid.Column="1" Text="{Binding MatchSummary}" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        <Button AutomationProperties.Name="Remove this group" Grid.Column="2" Classes="iconButton" Command="{Binding RemoveCommand}"
                                IsVisible="{Binding CanRemove}" ToolTip.Tip="Remove this group"><fi:SymbolIcon Symbol="Dismiss" FontSize="{StaticResource PbIconSizeXs}" /></Button>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Conditions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SmartListConditionViewModel">
                                <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <!-- Fixed field/operator widths and the remove button in its own column, so every row's controls and ✕
                                         line up (they followed each row's own text widths, 2026-10-20 UI polish). -->
                                    <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <ToggleButton Classes="conditionFlag" Content="NOT" IsChecked="{Binding Not}"
                                                      ToolTip.Tip="Negate this condition"
                                                      IsEnabled="{Binding !$parent[UserControl].((vm:SmartScreenViewModel)DataContext).IsReadOnly}" />

                                        <controls:SuggestBox Classes="conditionPicker" IsStrict="True" Width="160" Suggestions="{Binding FieldNames}"
                                                  Text="{Binding SelectedFieldText}"
                                                  IsEnabled="{Binding !$parent[UserControl].((vm:SmartScreenViewModel)DataContext).IsReadOnly}" />

                                        <controls:SuggestBox Classes="conditionPicker" IsStrict="True" Width="140" Watermark="search in"
                                                  Suggestions="{Binding SearchModeNames}" Text="{Binding SelectedSearchModeText}"
                                                  IsVisible="{Binding IsAllPropertiesField}"
                                                  IsEnabled="{Binding !$parent[UserControl].((vm:SmartScreenViewModel)DataContext).IsReadOnly}" />

                                        <TextBox Classes="conditionValue" Width="150" PlaceholderText="value name"
                                                 Text="{Binding CustomValueName}" IsVisible="{Binding IsCustomValueField}"
                                                 IsReadOnly="{Binding $parent[UserControl].((vm:SmartScreenViewModel)DataContext).IsReadOnly}" />

                                        <controls:SuggestBox Classes="conditionPicker" IsStrict="True" Width="150" Watermark="virtual tag"
                                                  Suggestions="{Binding VirtualTagNames}" Text="{Binding SelectedVirtualTagText}"
                                                  IsVisible="{Binding IsVirtualTagField}"
                                                  IsEnabled="{Binding !$parent[UserControl].((vm:SmartScreenViewModel)DataContext).IsReadOnly}" />

                                        <controls:SuggestBox Classes="conditionPicker" IsStrict="True" Width="150" Suggestions="{Binding OperatorNames}"
                                                  Text="{Binding SelectedOperatorText}" IsVisible="{Binding ShowOperator}"
                                                  IsEnabled="{Binding !$parent[UserControl].((vm:SmartScreenViewModel)DataContext).IsReadOnly}" />

                                        <ToggleButton Classes="conditionFlag" Content="Aa" IsChecked="{Binding IgnoreCase}"
                                                      IsVisible="{Binding ShowCaseToggle}"
                                                      ToolTip.Tip="Ignore case (on) / match case exactly (off)"
                                                      IsEnabled="{Binding !$parent[UserControl].((vm:SmartScreenViewModel)DataContext).IsReadOnly}" />

                                        <TextBox Classes="conditionValue" Text="{Binding Value}" PlaceholderText="{Binding ValueWatermark}" IsVisible="{Binding !IsDuplicateField}"
                                                  IsReadOnly="{Binding $parent[UserControl].((vm:SmartScreenViewModel)DataContext).IsReadOnly}" />

                                        <TextBlock Text="and" FontSize="13" Foreground="{DynamicResource PbTextMutedBrush}"
                                                   VerticalAlignment="Center" IsVisible="{Binding ShowValue2}" />
                                        <TextBox Classes="conditionValue" Width="90" Text="{Binding Value2}" PlaceholderText="{Binding Value2Watermark}" IsVisible="{Binding ShowValue2}"
                                                  IsReadOnly="{Binding $parent[UserControl].((vm:SmartScreenViewModel)DataContext).IsReadOnly}" />
                                    </StackPanel>

                                        <Button Grid.Column="1" AutomationProperties.Name="Remove condition" Classes="iconButton" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Command="{Binding RemoveCommand}" ToolTip.Tip="Remove condition"
                                                IsVisible="{Binding !$parent[UserControl].((vm:SmartScreenViewModel)DataContext).IsReadOnly}">
                                            <fi:SymbolIcon Symbol="SubtractCircle" FontSize="{StaticResource PbIconSizeSm}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Nested group cards (recursive: same template key). -->
                    <ItemsControl ItemsSource="{Binding ChildGroups}" Margin="16,0,0,0"
                                  ItemTemplate="{StaticResource GroupCardTemplate}" />

                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0"
                                IsVisible="{Binding !IsReadOnly}">
                        <Button Classes="ghost" Command="{Binding AddConditionCommand}"
                                Foreground="{DynamicResource PbAccentTextBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Grid Width="10" Height="10" VerticalAlignment="Center">
                                    <Rectangle Width="10" Height="1.6" Fill="{DynamicResource PbAccentTextBrush}" VerticalAlignment="Center" />
                                    <Rectangle Width="1.6" Height="10" Fill="{DynamicResource PbAccentTextBrush}" HorizontalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="Add condition" />
                            </StackPanel>
                        </Button>
                        <Button Classes="ghost" Command="{Binding AddGroupCommand}"
                                Foreground="{DynamicResource PbTextMutedBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Grid Width="10" Height="10" VerticalAlignment="Center">
                                    <Rectangle Width="10" Height="1.6" Fill="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                                    <Rectangle Width="1.6" Height="10" Fill="{DynamicResource PbTextMutedBrush}" HorizontalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="Add group" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Row 0: pinned top band - title/subtitle + Duplicate/Save. -->
        <StackPanel Grid.Row="0">
            <Grid ColumnDefinitions="*,Auto" Margin="24,20,24,16">
                <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                    <TextBlock Classes="pbTextHeading" Text="{Binding ListName}" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="{DynamicResource PbTextMutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                    <Button Classes="ghost" Command="{Binding DuplicateCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <fi:SymbolIcon Symbol="Copy" FontSize="{StaticResource PbIconSizeXs}" />
                            <TextBlock Text="Duplicate" />
                        </StackPanel>
                    </Button>
                    <Button Classes="primary" Command="{Binding SaveCommand}" IsVisible="{Binding !IsReadOnly}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <fi:SymbolIcon Symbol="Save" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbBadgeTextBrush}" />
                            <TextBlock Text="Save" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,0,0,1" />
        </StackPanel>

        <!-- Row 1: pinned stat row - stays visible while row 2 scrolls. -->
        <StackPanel Grid.Row="1">
            <Border Background="{DynamicResource PbChromeBrush}" BorderBrush="{DynamicResource PbBorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource PbRadiusChip}" Padding="12,6" HorizontalAlignment="Left" Margin="24,16,24,16">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource PbSuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}">
                        <Run Text="Currently matches " />
                        <Run Text="{Binding MatchCountLabel}" FontFamily="Consolas,monospace" FontWeight="Bold" Foreground="{DynamicResource PbTextBrush}" />
                        <Run Text=" issues" />
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,0,0,1" />
        </StackPanel>

        <!-- Row 2: scrolling content - condition builder, Cancel/Apply, results. -->
        <ScrollViewer Grid.Row="2">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left" Margin="24,24,24,40">

                <ContentControl Content="{Binding RootGroup}" ContentTemplate="{StaticResource GroupCardTemplate}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="9" Margin="0,20,0,0" IsVisible="{Binding !IsReadOnly}">
                    <Button Classes="ghost" Command="{Binding CancelCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <fi:SymbolIcon Symbol="DismissCircle" FontSize="{StaticResource PbIconSizeXs}" />
                            <TextBlock Text="Cancel" />
                        </StackPanel>
                    </Button>
                    <Button Classes="primary" Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <fi:SymbolIcon Symbol="Save" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbBadgeTextBrush}" />
                            <TextBlock Text="Apply" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,32,0,0" IsVisible="{Binding !HasResults}">
                    <fi:SymbolIcon Symbol="Search" FontSize="{StaticResource PbIconSizeSm}" />
                    <TextBlock Text="{Binding NoResultsMessage}" FontSize="13"
                               Foreground="{DynamicResource PbTextMutedBrush}" />
                </StackPanel>

                <ItemsControl x:Name="ResultsList" ItemsSource="{Binding Results}" Margin="0,32,0,0"
                              controls:EntranceAnimation.Enabled="{Binding PlayEntranceAnimation}"
                              IsVisible="{Binding HasIssueResults}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:VirtualizingWrapPanel ItemWidth="120" ItemHeight="168" ItemSpacing="16" LineSpacing="16" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:IssueCardSample">
                            <Button Classes="resultCard" Width="120"
                                    Command="{Binding #ResultsList.((vm:SmartScreenViewModel)DataContext).SelectResultCommand}"
                                    CommandParameter="{Binding}" KeyDown="OnResultCardKeyDown">
                                <Border Classes="resultTile" Background="{Binding CoverBrush}">
                                    <Grid>
                                        <Image views:AsyncCoverImage.SourceId="{Binding CoverKey}" Stretch="UniformToFill" />
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Black" Foreground="#FFFFF8EC"
                                                   VerticalAlignment="Bottom" Margin="8" />
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Series/Novel result grids (docs/superpowers/specs/2026-08-30-smart-collections-
                     design.md) - only one of the three results grids is ever populated at a time,
                     matching whichever target kind the active list is. -->
                <ItemsControl x:Name="SeriesResultsList" ItemsSource="{Binding SeriesResults}" Margin="0,32,0,0"
                              controls:EntranceAnimation.Enabled="{Binding PlayEntranceAnimation}"
                              IsVisible="{Binding HasSeriesResults}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:VirtualizingWrapPanel ItemWidth="120" ItemHeight="168" ItemSpacing="16" LineSpacing="16" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:SeriesCardSample">
                            <Button Classes="resultCard" Width="120"
                                    Command="{Binding #SeriesResultsList.((vm:SmartScreenViewModel)DataContext).SelectSeriesResultCommand}"
                                    CommandParameter="{Binding}" KeyDown="OnResultCardKeyDown">
                                <Border Classes="resultTile" Background="{Binding CoverBrush}">
                                    <Grid>
                                        <Image views:AsyncCoverImage.SourceId="{Binding CoverKey}" Stretch="UniformToFill" />
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Black" Foreground="#FFFFF8EC"
                                                   VerticalAlignment="Bottom" Margin="8" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl x:Name="NovelResultsList" ItemsSource="{Binding NovelResults}" Margin="0,32,0,0"
                              controls:EntranceAnimation.Enabled="{Binding PlayEntranceAnimation}"
                              IsVisible="{Binding HasNovelResults}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:VirtualizingWrapPanel ItemWidth="120" ItemHeight="168" ItemSpacing="16" LineSpacing="16" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:BookCardSample">
                            <Button Classes="resultCard" Width="120"
                                    Command="{Binding #NovelResultsList.((vm:SmartScreenViewModel)DataContext).SelectNovelResultCommand}"
                                    CommandParameter="{Binding}" KeyDown="OnResultCardKeyDown">
                                <Border Classes="resultTile" Background="{Binding CoverBrush}">
                                    <Grid>
                                        <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Black" Foreground="#FFFFF8EC"
                                                   VerticalAlignment="Bottom" Margin="8" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

        </StackPanel>
        </ScrollViewer>

        <!-- ============ Grouped Review overlay (docs/superpowers/specs/2026-09-05-plugin-grouped-
             review-and-scan-alerts-design.md §3) - a CreateBookList plugin command returning
             grouped data opens this instead of the flat Results grid above. Same backdrop/
             floatingPanel pattern as LibraryScreen's Add-issue overlay. ============ -->
        <Border Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding IsGroupedReviewOpen}" Background="#B0000000"
                PointerPressed="OnGroupedReviewBackdropPressed" />
        <Border x:Name="GroupedReviewPanel" Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding IsGroupedReviewOpen}" Classes="floatingPanel"
                Width="620" MaxHeight="720" Padding="0" KeyboardNavigation.TabNavigation="Cycle" KeyDown="OnGroupedReviewKeyDown">
            <DockPanel LastChildFill="True">
                <Grid DockPanel.Dock="Top" Margin="24,20,24,12" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="Review duplicates" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PbTextBrush}" />
                    <Button Grid.Column="1" Classes="ghost" Content="Close" Command="{Binding CloseGroupedReviewCommand}" />
                </Grid>
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,0,0,1" />

                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,1,0,0" Padding="24,14">
                    <Button Classes="primary" HorizontalAlignment="Right" Content="{Binding ResolveAllLabel}"
                            Command="{Binding ResolveAllCommand}" IsEnabled="{Binding HasGroupedReviewDeletions}" />
                </Border>

                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding GroupedReviewRows}" Margin="24,4,24,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PluginGroupRowViewModel">
                                <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource PbRadius}" Padding="14" Margin="0,0,0,10">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PbTextBrush}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="Skip" VerticalAlignment="Center" Foreground="{DynamicResource PbTextBrush}" />
                                                <ToggleSwitch IsChecked="{Binding IsSkipped}" OnContent="{x:Null}" OffContent="{x:Null}" />
                                            </StackPanel>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Books}" IsEnabled="{Binding !IsSkipped}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="10" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:IssueCardSample">
                                                    <Button Width="88" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                                            Command="{Binding $parent[ItemsControl].((vm:PluginGroupRowViewModel)DataContext).SelectKeepCommand}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel Spacing="4">
                                                            <Border CornerRadius="{DynamicResource PbRadiusSm}" Height="120" Background="{Binding CoverBrush}" ClipToBounds="True">
                                                                <Grid>
                                                                    <Image views:AsyncCoverImage.SourceId="{Binding CoverKey}" Stretch="UniformToFill" />
                                                                    <Border IsVisible="{Binding IsSelected}" BorderBrush="{DynamicResource PbAccentBrush}" BorderThickness="3" CornerRadius="{DynamicResource PbRadiusSm}" />
                                                                    <Border IsVisible="{Binding IsSelected}" Classes="pbChip" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4"
                                                                            Background="{DynamicResource PbAccentBrush}">
                                                                        <TextBlock Text="Keep" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PbAccentTextBrush}" />
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                            <TextBlock Text="{Binding Title}" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource PbTextMutedBrush}" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- "New Smart List" gallery (docs/superpowers/specs/2026-10-06-smart-features-design.md §3.2) -->
        <views:SmartTemplateGallery Grid.Row="0" Grid.RowSpan="3" DataContext="{Binding Gallery}" />
    </Grid>
</UserControl>
