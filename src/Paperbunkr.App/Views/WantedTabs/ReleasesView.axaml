<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:controls="using:Paperbunkr.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Paperbunkr.App.Views.WantedTabs.ReleasesView"
             x:Name="Root"
             x:DataType="vm:WantedScreenViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.wantedCaption">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextFaintBrush}" />
        </Style>
        <Style Selector="Button.calDay">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.calDay.out">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="Button.calDay.inWeek">
            <Setter Property="Background" Value="{DynamicResource PbSurface3Brush}" />
        </Style>
        <Style Selector="Button.calDay.today">
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
        </Style>
        <Style Selector="Button.pbChip.active">
            <Setter Property="Background" Value="{DynamicResource PbSurface3Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
        </Style>
    </UserControl.Styles>

    <!-- The Releases tab: the weekly pull list as a cover shelf, one week per page, with a month calendar to jump to any date
         (docs/superpowers/specs/2026-09-21-wanted-screen-redesign-design.md 2). -->
    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Week navigator and filters -->
        <Grid Grid.Row="0" RowDefinitions="Auto,Auto" Margin="24,16,24,8" MaxWidth="1100" HorizontalAlignment="Stretch">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                <Button Classes="headerAction ghost" Command="{Binding PreviousWeekCommand}" AutomationProperties.Name="Previous week">
                    <fi:SymbolIcon Symbol="ChevronLeft" FontSize="{StaticResource PbIconSizeSm}" />
                </Button>
                <Button x:Name="DateButton" Classes="headerAction ghost" Command="{Binding ToggleCalendarCommand}" MinWidth="170"
                        AutomationProperties.Name="Pick a date" AutomationProperties.AutomationId="WantedReleasesDate">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <fi:SymbolIcon Symbol="Calendar" FontSize="{StaticResource PbIconSizeXs}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ReleaseWeekLabel}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ReleaseWeekCaption}" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" VerticalAlignment="Center"
                                   IsVisible="{Binding ReleaseWeekCaption, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </Button>
                <Button Classes="headerAction ghost" Command="{Binding NextWeekCommand}" AutomationProperties.Name="Next week">
                    <fi:SymbolIcon Symbol="ChevronRight" FontSize="{StaticResource PbIconSizeSm}" />
                </Button>
                <Button Classes="headerAction ghost" Content="Today" Command="{Binding ThisWeekCommand}" IsEnabled="{Binding !IsViewingThisWeek}"
                        AutomationProperties.Name="Back to this week" />
                <TextBlock Text="{Binding ReleaseCount, StringFormat='{}{0} in view'}" FontSize="12" Foreground="{DynamicResource PbTextFaintBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="18" Margin="0,10,0,0">
                <controls:SuggestBox Grid.Column="0" IsStrict="True" Width="200" Text="{Binding ReleasePublisherText}" Suggestions="{Binding ReleasePublisherNames}"
                                     AutomationProperties.Name="Publisher" AutomationProperties.AutomationId="WantedReleasesPublisher" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Followed only" FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                    <ToggleSwitch IsChecked="{Binding ReleasesFollowedOnly}" OnContent="{x:Null}" OffContent="{x:Null}"
                                  AutomationProperties.Name="Show releases of followed series only" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Show hidden" FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                    <ToggleSwitch IsChecked="{Binding ReleasesShowHidden}" OnContent="{x:Null}" OffContent="{x:Null}"
                                  AutomationProperties.Name="Also show hidden releases" />
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{Binding ReleaseFreshnessText}" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <!-- Month calendar: dots mark days with releases (red) and days with releases from followed series (green) -->
            <Popup Grid.Row="0" IsOpen="{Binding IsCalendarOpen, Mode=TwoWay}" PlacementTarget="{Binding #DateButton}" Placement="BottomEdgeAlignedLeft" IsLightDismissEnabled="True">
                <Border Background="{DynamicResource PbSurface3Brush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,6,0,0">
                    <StackPanel Spacing="8" Width="252">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Button Grid.Column="0" Classes="headerAction ghost" Command="{Binding PreviousMonthCommand}" AutomationProperties.Name="Previous month">
                                <fi:SymbolIcon Symbol="ChevronLeft" FontSize="{StaticResource PbIconSizeXs}" />
                            </Button>
                            <TextBlock Grid.Column="1" Text="{Binding CalendarTitle}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource PbTextBrush}" AutomationProperties.LiveSetting="Polite" />
                            <Button Grid.Column="2" Classes="headerAction ghost" Command="{Binding NextMonthCommand}" AutomationProperties.Name="Next month">
                                <fi:SymbolIcon Symbol="ChevronRight" FontSize="{StaticResource PbIconSizeXs}" />
                            </Button>
                        </Grid>
                        <UniformGrid Columns="7">
                            <TextBlock Text="M" HorizontalAlignment="Center" FontSize="10.5" Foreground="{DynamicResource PbTextFaintBrush}" />
                            <TextBlock Text="T" HorizontalAlignment="Center" FontSize="10.5" Foreground="{DynamicResource PbTextFaintBrush}" />
                            <TextBlock Text="W" HorizontalAlignment="Center" FontSize="10.5" Foreground="{DynamicResource PbTextFaintBrush}" />
                            <TextBlock Text="T" HorizontalAlignment="Center" FontSize="10.5" Foreground="{DynamicResource PbTextFaintBrush}" />
                            <TextBlock Text="F" HorizontalAlignment="Center" FontSize="10.5" Foreground="{DynamicResource PbTextFaintBrush}" />
                            <TextBlock Text="S" HorizontalAlignment="Center" FontSize="10.5" Foreground="{DynamicResource PbTextFaintBrush}" />
                            <TextBlock Text="S" HorizontalAlignment="Center" FontSize="10.5" Foreground="{DynamicResource PbTextFaintBrush}" />
                        </UniformGrid>
                        <ItemsControl ItemsSource="{Binding CalendarDays}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CalendarDayViewModel">
                                    <Button Classes="calDay" Classes.out="{Binding !InMonth}" Classes.inWeek="{Binding IsInWeek}" Classes.today="{Binding IsToday}"
                                            AutomationProperties.Name="{Binding AutomationName}"
                                            Command="{Binding $parent[ItemsControl].((vm:WantedScreenViewModel)DataContext).PickDateCommand}" CommandParameter="{Binding}">
                                        <Grid>
                                            <TextBlock Text="{Binding DayText}" FontSize="12" Foreground="{DynamicResource PbTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2">
                                                <Ellipse Width="4" Height="4" Fill="{DynamicResource PbDangerBrush}" IsVisible="{Binding HasReleases}" />
                                                <Ellipse Width="4" Height="4" Fill="{DynamicResource PbSuccessBrush}" IsVisible="{Binding HasFollowed}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Red: releases. Green: from a series you follow." FontSize="10.5" Foreground="{DynamicResource PbTextFaintBrush}" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" IsVisible="{Binding IsReleasesLoading}" Height="3" VerticalAlignment="Top" Margin="24,0,24,0"
                     AutomationProperties.Name="Loading this week's releases" />

        <Panel Grid.Row="2">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsVisible="{Binding !HasNoReleases}">
                <ItemsControl ItemsSource="{Binding ReleaseDays}" Margin="24,4,24,32" MaxWidth="1100" HorizontalAlignment="Stretch">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ReleaseDayViewModel">
                            <StackPanel Spacing="8" Margin="0,8,0,6">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Classes="wantedCaption" Text="{Binding Title}" />
                                    <TextBlock Text="{Binding CountText}" FontSize="11" Foreground="{DynamicResource PbTextFaintBrush}" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ReleaseRowViewModel">
                                            <StackPanel Width="124" Spacing="4" Margin="0,0,14,14">
                                                <Panel>
                                                    <Border Width="124" Height="186" CornerRadius="{StaticResource PbRadiusSm}" ClipToBounds="True" Background="{DynamicResource PbSurface2Brush}">
                                                        <Image Source="{Binding Cover.Image}" Stretch="UniformToFill" />
                                                    </Border>
                                                    <Border Classes="pbChip" Padding="7,1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5" IsVisible="{Binding HasStatus}"
                                                            Background="{DynamicResource PbChromeBrush}">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="10.5" Foreground="{DynamicResource PbAccentBrush}" />
                                                    </Border>
                                                </Panel>
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PbTextBrush}" TextWrapping="Wrap" MaxHeight="34"
                                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource PbTextFaintBrush}" TextTrimming="CharacterEllipsis"
                                                           IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,2,0,0">
                                                    <Button Grid.Column="0" Classes="headerAction primary" Content="Request" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="4,6"
                                                            IsVisible="{Binding PrimaryIsRequest}"
                                                            AutomationProperties.Name="{Binding Title, StringFormat='Request {0}'}"
                                                            Command="{Binding #Root.((vm:WantedScreenViewModel)DataContext).RequestReleaseCommand}" CommandParameter="{Binding}" />
                                                    <Button Grid.Column="0" Classes="headerAction ghost" Content="Follow" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="4,6"
                                                            IsVisible="{Binding PrimaryIsFollow}"
                                                            AutomationProperties.Name="{Binding Title, StringFormat='Follow the series of {0}'}"
                                                            Command="{Binding #Root.((vm:WantedScreenViewModel)DataContext).FollowReleaseSeriesCommand}" CommandParameter="{Binding}" />
                                                    <Button Grid.Column="0" Classes="headerAction ghost" Content="Restore" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="4,6"
                                                            IsVisible="{Binding IsHidden}"
                                                            AutomationProperties.Name="{Binding Title, StringFormat='Restore {0} to the release list'}"
                                                            Command="{Binding #Root.((vm:WantedScreenViewModel)DataContext).RestoreReleaseCommand}" CommandParameter="{Binding}" />
                                                    <Button Grid.Column="1" Classes="headerAction ghost" Click="OnMoreClick" Padding="8,6"
                                                            AutomationProperties.Name="{Binding Title, StringFormat='More actions for {0}'}">
                                                        <fi:SymbolIcon Symbol="MoreHorizontal" FontSize="{StaticResource PbIconSizeSm}" />
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel IsVisible="{Binding HasNoReleases}" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" MaxWidth="440">
                <fi:SymbolIcon Symbol="Calendar" FontSize="{StaticResource PbIconSizeXl}" Foreground="{DynamicResource PbTextFaintBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="No releases to show" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PbTextBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding ReleasesEmptyText}" FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
        </Panel>
    </Grid>
</UserControl>
