<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="700"
             xmlns:controls="using:Paperbunkr.App.Controls"
             x:Class="Paperbunkr.App.Views.BookPropertiesOverlay"
             x:DataType="vm:BookPropertiesScreenViewModel">

    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.groupHeader">
            <Setter Property="Background" Value="{DynamicResource PbChromeBrush}" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style Selector="StackPanel.field">
            <Setter Property="Width" Value="248" />
            <Setter Property="Margin" Value="0,0,16,16" />
        </Style>
    </UserControl.Styles>

    <controls:DialogCard Title="{Binding HeaderLabel}" Size="Medium">
        <StackPanel>

            <WrapPanel>
                <StackPanel Classes="field">
                    <TextBlock Classes="fieldLabel" Text="TITLE" />
                    <TextBox Text="{Binding Title}" AutomationProperties.AutomationId="BookPropertiesTitle" />
                </StackPanel>
                <StackPanel Classes="field">
                    <TextBlock Classes="fieldLabel" Text="AUTHOR" />
                    <TextBox Text="{Binding Author}" />
                </StackPanel>
                <StackPanel Classes="field">
                    <TextBlock Classes="fieldLabel" Text="PUBLISHED" />
                    <DatePicker SelectedDate="{Binding PublishedDate}" HorizontalAlignment="Stretch" />
                </StackPanel>
            </WrapPanel>

            <Border Classes="card" Padding="0" Margin="0,0,0,16">
                <StackPanel>
                    <Border Classes="groupHeader">
                        <TextBlock Text="Summary" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                    </Border>
                    <StackPanel Margin="14">
                        <TextBox Text="{Binding Summary}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="0" Margin="0,0,0,16">
                <StackPanel>
                    <Border Classes="groupHeader">
                        <TextBlock Text="Series" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                    </Border>
                    <StackPanel Margin="14">
                        <TextBlock Classes="fieldLabel" Text="SERIES NAME" />
                        <TextBox Text="{Binding SeriesName}" PlaceholderText="Leave blank for a standalone book"
                                 Margin="0,0,0,12" AutomationProperties.AutomationId="BookPropertiesSeriesName" />
                        <WrapPanel>
                            <StackPanel Classes="field">
                                <TextBlock Classes="fieldLabel" Text="SERIES AUTHOR" />
                                <TextBox Text="{Binding SeriesAuthor}" IsEnabled="{Binding HasSeriesName}" />
                            </StackPanel>
                            <StackPanel Classes="field">
                                <TextBlock Classes="fieldLabel" Text="SERIES SORT NAME" />
                                <TextBox Text="{Binding SeriesSortName}" IsEnabled="{Binding HasSeriesName}" />
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Classes="fieldLabel" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Text="Series author and sort name apply to every book in this series." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="0">
                <StackPanel>
                    <Border Classes="groupHeader">
                        <TextBlock Text="Cover" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                    </Border>
                    <Grid ColumnDefinitions="90,*" Margin="14">
                        <Border Grid.Column="0" Width="70" Height="100" CornerRadius="{DynamicResource PbRadiusSm}" ClipToBounds="True"
                                Background="{DynamicResource PbChromeBrush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1">
                            <Image Source="{Binding CoverPreview}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Top" Orientation="Horizontal" Spacing="8">
                            <Button Classes="ghost" Content="Change Cover…" Command="{Binding ChangeCoverCommand}" />
                            <Button Classes="ghost" Content="Reset" Command="{Binding ResetCoverCommand}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
        <controls:DialogCard.Footer>
            <StackPanel>
                <Button Classes="ghost" Content="Cancel" Command="{Binding CancelCommand}" />
                <Button Classes="primary" Content="Save" Command="{Binding SaveCommand}"
                        AutomationProperties.AutomationId="BookPropertiesSave" />
            </StackPanel>
        </controls:DialogCard.Footer>
    </controls:DialogCard>
</UserControl>
