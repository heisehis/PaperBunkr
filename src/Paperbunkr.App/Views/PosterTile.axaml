<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="140" d:DesignHeight="210"
             x:Class="Paperbunkr.App.Views.PosterTile"
             x:Name="ThisControl">

    <!--
        PosterTile primitive (docs/superpowers/specs/2026-08-24-design-language-foundation-design.md),
        restyled "cover-forward" for the Home redesign (2026-08-28-home-screen-redesign-design.md
        §4): no surface panel or border, the art fills the card with a soft drop shadow, a gold pill
        badge over the art, the progress bar floats inset near the bottom, serif title + a muted
        second line below. Root is a Border (Classes="posterTile", Focusable="True"), not a Button -
        see PosterTile.axaml.cs for why. All internal bindings go through #ThisControl (the
        UserControl's own x:Name), since this control's DataContext is whatever the consumer sets it
        to, not this control's own StyledProperties.
    -->
    <Border x:Name="Root" Classes="posterTile" Focusable="True" AutomationProperties.AutomationId="PosterTileCard">
        <Grid RowDefinitions="*,Auto" Width="140">
            <Border Grid.Row="0" Classes="posterCover" Height="196" ClipToBounds="True" CornerRadius="{DynamicResource PbRadiusSm}">
                <Grid>
                    <Image Source="{Binding #ThisControl.CoverSource}" Stretch="UniformToFill" />

                    <Border Classes="posterScrim" />

                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="7" Padding="7,2"
                            CornerRadius="999" Background="{DynamicResource PbBadgeBrush}"
                            IsVisible="{Binding #ThisControl.BadgeText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding #ThisControl.BadgeText}" FontSize="9.5" FontWeight="Bold"
                                   Foreground="{DynamicResource PbBadgeTextBrush}" />
                    </Border>

                    <Border VerticalAlignment="Bottom" Margin="7,0,7,7" Height="3" CornerRadius="999"
                            ClipToBounds="True" Background="#59000000"
                            IsVisible="{Binding #ThisControl.ShowProgress}">
                        <ProgressBar Minimum="0" Maximum="1" Height="3"
                                     Value="{Binding #ThisControl.ProgressFraction}"
                                     Background="Transparent" Foreground="{DynamicResource PbAccentTextBrush}" />
                    </Border>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="0,9,0,0" Spacing="1">
                <TextBlock Text="{Binding #ThisControl.TitleText}" FontWeight="SemiBold" FontSize="12"
                           Foreground="{DynamicResource PbTextBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding #ThisControl.MetaText}" FontSize="10" Foreground="{DynamicResource PbTextFaintBrush}"
                           TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding #ThisControl.MetaText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
