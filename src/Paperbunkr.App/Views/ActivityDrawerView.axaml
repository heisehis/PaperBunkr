<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:controls="using:Paperbunkr.App.Controls"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:views="using:Paperbunkr.App.Views"
             xmlns:models="using:Paperbunkr.App.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="360"
             x:Class="Paperbunkr.App.Views.ActivityDrawerView"
             x:DataType="vm:ActivityCenterViewModel">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Paperbunkr.App/Views/ActivityTemplates.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.activityIconBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusSm}" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.activityIconBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
        </Style>
        <Style Selector="Button.activityLink">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="{DynamicResource PbFontSizeOverline}" />
            <Setter Property="Foreground" Value="{DynamicResource PbAccentTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <!-- Reveal motion (docs/superpowers/specs/2026-10-20-motion-system-v2-foundation-overlays-design.md §5.2). The host's
             controls:Reveal.IsOpen (MainWindow.axaml) owns visibility and puts .open / .closing on this view; the drawer rises 20 px with
             the damped spring (panel arrival) and fades on the Reveal tokens, and leaves faster on the exit token and curve. -->
        <Style Selector="Border#DrawerRoot">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource PbMotionRevealMove}" Easing="{StaticResource PbMotionSpring}" />
                    <DoubleTransition Property="Opacity" Duration="{DynamicResource PbMotionRevealFade}" Easing="{StaticResource PbMotionEase}" />
                </Transitions>
            </Setter>
            <Setter Property="RenderTransform" Value="translateY(20px)" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="UserControl.open Border#DrawerRoot">
            <Setter Property="RenderTransform" Value="none" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="UserControl.closing Border#DrawerRoot">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource PbMotionRevealExit}" Easing="{StaticResource PbMotionExitEase}" />
                    <DoubleTransition Property="Opacity" Duration="{DynamicResource PbMotionRevealExit}" Easing="{StaticResource PbMotionExitEase}" />
                </Transitions>
            </Setter>
        </Style>
    </UserControl.Styles>

    <Border x:Name="DrawerRoot"
            VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
            Height="360" Background="{DynamicResource PbSurface2Brush}"
            BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,1,0,0"
            CornerRadius="10,10,0,0" BoxShadow="0 -6 24 0 #66000000">
        <Grid RowDefinitions="Auto,Auto,*">

            <!-- Tab strip -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="8,8,8,0">
                <Button Grid.Column="0" Classes="tab" Classes.active="{Binding IsActiveTab}"
                        Command="{Binding ShowActiveTabCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Active" />
                        <Border CornerRadius="{StaticResource PbRadiusChip}" Background="{DynamicResource PbSurface3Brush}" Padding="4,0"
                                IsVisible="{Binding HasRunningJobs}">
                            <TextBlock Text="{Binding RunningCount}" FontSize="10" Foreground="{DynamicResource PbAccentTextBrush}" />
                        </Border>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Classes="tab" Classes.active="{Binding IsHistory}"
                        Command="{Binding ShowHistoryTabCommand}" Content="History" />
                <Button Grid.Column="2" Classes="tab" Classes.active="{Binding IsScheduled}"
                        Command="{Binding ShowScheduledTabCommand}" Content="Scheduled" />

                <Button Grid.Column="4" Classes="activityLink" Content="Stop all" Margin="0,0,12,0"
                        Command="{Binding StopAllCommand}" IsVisible="{Binding HasRunningJobs}" />
                <Button Grid.Column="5" Classes="activityIconBtn" Command="{Binding CloseCommand}"
                        AutomationProperties.Name="Close activity center" ToolTip.Tip="Close">
                    <fi:SymbolIcon Symbol="ChevronDown" FontSize="{StaticResource PbIconSizeSm}" />
                </Button>
            </Grid>

            <Border Grid.Row="1" Height="1" Background="{DynamicResource PbBorderBrush}" />

            <!-- Active tab -->
            <ScrollViewer Grid.Row="2" Padding="12" IsVisible="{Binding IsActiveTab}">
                <StackPanel Spacing="2">
                    <StackPanel IsVisible="{Binding HasTrackerRetries}" Margin="0,4,0,8">
                        <TextBlock Text="TRACKER PUSH RETRIES" FontSize="{DynamicResource PbFontSizeMicro}" FontWeight="Bold"
                                   Foreground="{DynamicResource PbTextMutedBrush}" Margin="2,4,0,4" />
                        <ItemsControl ItemsSource="{Binding TrackerRetries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TrackerRetryRow">
                                    <Border Background="{DynamicResource PbSurface3Brush}" CornerRadius="{DynamicResource PbRadiusSm}" Padding="10,8" Margin="0,2">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding SeriesName}" FontSize="{DynamicResource PbFontSizeControl}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PbTextBrush}" />
                                                <TextBlock Text="{Binding TrackerName}" FontSize="{DynamicResource PbFontSizeOverline}"
                                                           Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Grid.RowSpan="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button Classes="activityLink" Content="Retry now" Command="{Binding RetryCommand}" />
                                                <Button Classes="activityLink" Content="Dismiss" Command="{Binding DismissCommand}" IsVisible="{Binding IsExhausted}" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Text="{Binding Chapter}" FontSize="{DynamicResource PbFontSizeOverline}"
                                                       Foreground="{DynamicResource PbTextBrush}" />
                                            <TextBlock Grid.Row="2" Text="{Binding State}" FontSize="{DynamicResource PbFontSizeOverline}"
                                                       Foreground="{DynamicResource PbTextMutedBrush}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding Error}" FontSize="{DynamicResource PbFontSizeOverline}"
                                                       Foreground="{DynamicResource PbTextMutedBrush}" TextWrapping="Wrap" IsVisible="{Binding IsExhausted}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <!-- Flat list of jobs + section headings (ActivityJobGrouping) - flat so each job row's commands still bind to this
                         view model through the one ItemsControl. -->
                    <ItemsControl ItemsSource="{Binding RunningJobsGrouped}">
                        <ItemsControl.DataTemplates>
                            <DataTemplate DataType="models:ActivityGroupHeader">
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ActivityGroupHeaderTemplate}" />
                            </DataTemplate>
                            <DataTemplate DataType="models:ActivityJob">
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ActivityJobRowTemplate}" />
                            </DataTemplate>
                        </ItemsControl.DataTemplates>
                    </ItemsControl>

                    <StackPanel IsVisible="{Binding UpkeepJob.UpkeepActive, FallbackValue=False}" Margin="0,4,0,0">
                        <TextBlock Text="BACKGROUND UPKEEP" FontSize="{DynamicResource PbFontSizeMicro}" FontWeight="Bold"
                                   Foreground="{DynamicResource PbTextMutedBrush}" Margin="2,4,0,4" />
                        <Border Background="{DynamicResource PbSurface3Brush}" CornerRadius="{DynamicResource PbRadiusSm}" Padding="8,8">
                            <TextBlock Text="{Binding UpkeepJob.Detail}" FontSize="{DynamicResource PbFontSizeOverline}"
                                       Foreground="{DynamicResource PbTextMutedBrush}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding HasAlerts}" Margin="0,4,0,0">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,4">
                            <TextBlock Grid.Column="0" Text="ALERTS" FontSize="{DynamicResource PbFontSizeMicro}" FontWeight="Bold"
                                       Foreground="{DynamicResource PbTextMutedBrush}" Margin="2,0,0,0" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="activityLink" Content="Dismiss all" Command="{Binding DismissAllAlertsCommand}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Alerts}" ItemTemplate="{StaticResource ActivityAlertRowTemplate}" />
                    </StackPanel>

                    <TextBlock Text="No jobs running." FontSize="{DynamicResource PbFontSizeControl}"
                               Foreground="{DynamicResource PbTextMutedBrush}" Margin="2,24" HorizontalAlignment="Center"
                               IsVisible="{Binding !HasRunningJobs}" />
                </StackPanel>
            </ScrollViewer>

            <!-- History tab -->
            <Grid Grid.Row="2" RowDefinitions="Auto,*,Auto" IsVisible="{Binding IsHistory}">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" Margin="12,10" ColumnSpacing="8">
                    <TextBox Grid.Column="0" Classes="searchBox" Text="{Binding HistorySearch}" PlaceholderText="Search history…"
                             FontSize="{DynamicResource PbFontSizeControl}" />
                    <controls:SuggestBox Grid.Column="1" IsStrict="True" MinWidth="130"
                                         Text="{Binding HistoryKindText}" Suggestions="{Binding HistoryKindNames}" />
                    <controls:SuggestBox Grid.Column="2" IsStrict="True" MinWidth="120"
                                         Text="{Binding HistoryAgeText}" Suggestions="{Binding HistoryAgeNames}" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Failures only" FontSize="{DynamicResource PbFontSizeControl}" VerticalAlignment="Center" Foreground="{DynamicResource PbTextBrush}" />
                        <ToggleSwitch IsChecked="{Binding HistoryFailuresOnly}" OnContent="{x:Null}" OffContent="{x:Null}" />
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding HistoryRows}" ItemTemplate="{StaticResource ActivityHistoryRowTemplate}" />
                        <TextBlock Text="No matching history." FontSize="{DynamicResource PbFontSizeControl}"
                                   Foreground="{DynamicResource PbTextMutedBrush}" Margin="14,24" HorizontalAlignment="Center"
                                   IsVisible="{Binding HistoryIsEmpty}" />
                    </StackPanel>
                </ScrollViewer>

                <Button Grid.Row="2" Classes="activityLink" Content="Load more" Margin="14,8"
                        HorizontalAlignment="Center" Command="{Binding LoadMoreHistoryCommand}"
                        IsVisible="{Binding HistoryHasMore}" />
            </Grid>

            <!-- Scheduled tab (read-only "up next"; config lives in Preferences → Automation) -->
            <Grid Grid.Row="2" RowDefinitions="*,Auto" IsVisible="{Binding IsScheduled}">
                <ScrollViewer Grid.Row="0" Padding="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="UP NEXT" FontSize="{DynamicResource PbFontSizeMicro}" FontWeight="Bold"
                                   Foreground="{DynamicResource PbTextMutedBrush}" Margin="2,2,0,6" />
                        <ItemsControl ItemsSource="{Binding UpcomingTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:UpcomingTaskRow">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="{DynamicResource PbFontSizeControl}"
                                                   Foreground="{DynamicResource PbTextBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding NextRunLabel}" FontSize="{DynamicResource PbFontSizeOverline}"
                                                   Foreground="{DynamicResource PbTextMutedBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No tasks are enabled." FontSize="{DynamicResource PbFontSizeControl}"
                                   Foreground="{DynamicResource PbTextMutedBrush}" Margin="2,20" HorizontalAlignment="Center"
                                   IsVisible="{Binding !HasUpcoming}" />
                    </StackPanel>
                </ScrollViewer>
                <Button Grid.Row="1" Classes="activityLink" Content="Manage in Preferences →" Margin="14,8"
                        HorizontalAlignment="Center" Command="{Binding ManageScheduledTasksCommand}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
