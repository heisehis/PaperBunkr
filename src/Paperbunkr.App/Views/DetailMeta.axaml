<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="100"
             x:Class="Paperbunkr.App.Views.DetailMeta"
             x:DataType="vm:DetailMetaViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.metaLabel">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextFaintBrush}" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <!-- Clickable credit-name chips (docs/superpowers/specs/2026-08-23-weighted-categorized-
             tags-design.md's click-to-search, extended past Genre/Tags per direct user follow-up) -
             a flat, borderless Button rather than the outlined tagPill treatment, closer to the
             original flowing-text look these fields had (comma-separated names) while still being
             a real click target. -->
        <Style Selector="Button.creditName">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.creditName:pointerover TextBlock.metaValue">
            <Setter Property="TextDecorations" Value="Underline" />
        </Style>
        <Style Selector="TextBlock.metaValue">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <DataTemplate x:Key="CreditPillTemplate" x:DataType="vm:TagPillViewModel">
            <Button Classes="creditName" Command="{Binding SearchCommand}">
                <TextBlock Classes="metaValue" Text="{Binding Value}" />
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*" Margin="0,20">
        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,28,14">
            <TextBlock Classes="metaLabel" Text="WRITER" />
            <ItemsControl ItemsSource="{Binding Writer}" ItemTemplate="{StaticResource CreditPillTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,14">
            <TextBlock Classes="metaLabel" Text="ARTIST" />
            <ItemsControl ItemsSource="{Binding Artist}" ItemTemplate="{StaticResource CreditPillTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,28,14">
            <TextBlock Classes="metaLabel" Text="COVER ARTIST" />
            <ItemsControl ItemsSource="{Binding CoverArtist}" ItemTemplate="{StaticResource CreditPillTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,14">
            <TextBlock Classes="metaLabel" Text="COLORIST" />
            <ItemsControl ItemsSource="{Binding Colorist}" ItemTemplate="{StaticResource CreditPillTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,28,0">
            <TextBlock Classes="metaLabel" Text="LETTERER" />
            <ItemsControl ItemsSource="{Binding Letterer}" ItemTemplate="{StaticResource CreditPillTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>
