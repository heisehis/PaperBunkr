<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:models="using:Paperbunkr.App.Models"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="400"
             x:Class="Paperbunkr.App.Views.DetailTabs"
             x:DataType="vm:DetailTabsViewModel">

    <UserControl.Styles>
        <Style Selector="Button.tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0,0,0,12" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextFaintBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.tab.active">
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
        </Style>
        <Style Selector="TextBlock.tabCount">
            <Setter Property="FontFamily" Value="Consolas,monospace" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextFaintBrush}" />
            <Setter Property="Background" Value="{DynamicResource PbChromeBrush}" />
            <Setter Property="Padding" Value="6,1" />
        </Style>

        <Style Selector="Border.issueTile">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="Height" Value="168" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.issueTile.selected">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
        </Style>
        <!-- P5 (docs/alpha-roadmap.md) - visible keyboard-focus indicator. Border has no built-in
             FluentTheme focus adorner the way Button does, so this is explicit. :focus-visible
             (not :focus) so a plain pointer click doesn't flash the ring too - matches how the
             rest of the app never shows a focus ring on mouse interaction. -->
        <Style Selector="Border.issueTile:focus-visible">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
        </Style>
    </UserControl.Styles>

    <StackPanel>
        <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,0,0,1" Margin="0,24,0,0" IsVisible="{Binding ShowTabStrip}">
            <StackPanel Orientation="Horizontal" Spacing="22">
                <Button Classes="tab" Classes.active="{Binding IsIssuesTab}" Command="{Binding GoIssuesCommand}" IsVisible="{Binding ShowIssuesTab}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="Issues" />
                        <TextBlock Classes="tabCount" Text="{Binding Issues.Count}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="tab" Classes.active="{Binding IsRelatedTab}" Command="{Binding GoRelatedCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="Related" />
                        <TextBlock Classes="tabCount" Text="{Binding Related.Count}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="tab" Classes.active="{Binding IsDetailsTab}" Command="{Binding GoDetailsCommand}" Content="Details" />
                <Button Classes="tab" Classes.active="{Binding IsActivityTab}" Command="{Binding GoActivityCommand}" Content="Activity" />
            </StackPanel>
        </Border>

        <!-- Issues tab -->
        <ItemsControl x:Name="IssuesList" IsVisible="{Binding IsIssuesTab}" ItemsSource="{Binding Issues}" Margin="0,20,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:IssueCardSample">
                    <Border Classes="issueTile" Classes.selected="{Binding IsSelected}" Width="120" Margin="0,0,16,16"
                            Background="{Binding CoverBrush}" Focusable="True"
                            PointerPressed="OnIssueTilePointerPressed" KeyDown="OnIssueTileKeyDown">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Edit Properties"
                                          Command="{Binding #IssuesList.((vm:DetailTabsViewModel)DataContext).EditIssuePropertiesCommand}"
                                          CommandParameter="{Binding}">
                                    <MenuItem.Icon>
                                        <Border Classes="icon" Width="13" Height="13">
                                            <Border.OpacityMask>
                                                <ImageBrush Source="/Assets/Icons/Edit_Pencil.png" Stretch="Uniform" />
                                            </Border.OpacityMask>
                                        </Border>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Show in Explorer"
                                          Command="{Binding #IssuesList.((vm:DetailTabsViewModel)DataContext).RevealIssueCommand}"
                                          CommandParameter="{Binding}"
                                          IsEnabled="{Binding HasFile}" />
                                <Separator />
                                <MenuItem Header="Mark as Read"
                                          Command="{Binding #IssuesList.((vm:DetailTabsViewModel)DataContext).MarkIssueReadCommand}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="Mark as Unread"
                                          Command="{Binding #IssuesList.((vm:DetailTabsViewModel)DataContext).MarkIssueUnreadCommand}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="Quick Rate…"
                                          Command="{Binding #IssuesList.((vm:DetailTabsViewModel)DataContext).QuickRateCommand}"
                                          CommandParameter="{Binding}" />
                                <Separator />
                                <MenuItem Header="Set Cover…"
                                          Command="{Binding #IssuesList.((vm:DetailTabsViewModel)DataContext).ChangeIssueCoverCommand}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="Reset Cover"
                                          Command="{Binding #IssuesList.((vm:DetailTabsViewModel)DataContext).ResetIssueCoverCommand}"
                                          CommandParameter="{Binding}" />
                            </ContextMenu>
                        </Border.ContextMenu>
                        <Grid>
                            <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Black" Foreground="#FFFFF8EC"
                                       VerticalAlignment="Bottom" Margin="9" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Related tab (docs/superpowers/specs/2026-08-17-metadata-model-phase3-media-relations-
             design.md) - real MediaRelation data, added/removed from this tab directly since no
             Series Properties editor exists elsewhere in this app. -->
        <StackPanel IsVisible="{Binding IsRelatedTab}" Spacing="4" Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="+ Add Related Series"
                        Command="{Binding ToggleAddRelationCommand}" Padding="10,5" FontSize="12" CornerRadius="5"
                        Background="{DynamicResource PbAccentBrush}" Foreground="{DynamicResource PbBadgeTextBrush}" BorderThickness="0" />
            </StackPanel>

            <Border IsVisible="{Binding IsAddingRelation}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="12" Margin="0,10,0,0">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Relationship:" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource PbTextMutedBrush}" />
                        <ComboBox ItemsSource="{Binding RelationTypeOptions}" SelectedItem="{Binding SelectedRelationTypeOption}"
                                  MinWidth="160" FontSize="12">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:RelationTypeOption">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <TextBox Text="{Binding RelationSearchQuery}" Watermark="Search for a series…" FontSize="12" />
                    <ItemsControl ItemsSource="{Binding RelationSearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:SeriesSearchResult">
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6" Margin="0,2"
                                        Background="Transparent" BorderThickness="0" FontSize="12.5"
                                        Foreground="{DynamicResource PbTextMutedBrush}"
                                        Command="{Binding $parent[ItemsControl].((vm:DetailTabsViewModel)DataContext).AddRelationCommand}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding Name}" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock IsVisible="{Binding !HasRelated}" Text="No related series yet." FontSize="12.5"
                       Foreground="{DynamicResource PbTextFaintBrush}" Margin="0,10,0,0" />
            <ScrollViewer HorizontalScrollBarVisibility="Auto" Margin="0,10,0,0">
                <ItemsControl ItemsSource="{Binding Related}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="16" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:RelatedSeriesSample">
                            <StackPanel Width="126">
                                <Border CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource PbBorderBrush}"
                                        Height="189" Background="{Binding CoverBrush}">
                                    <Grid>
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Black" Foreground="#FFFFF8EC"
                                                   VerticalAlignment="Bottom" Margin="8" TextWrapping="Wrap" />
                                        <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                                Width="20" Height="20" Padding="0" FontSize="11" CornerRadius="10"
                                                Background="#88000000" Foreground="White" BorderThickness="0"
                                                Command="{Binding $parent[ItemsControl].((vm:DetailTabsViewModel)DataContext).RemoveRelationCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="Remove this relation" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PbTextMutedBrush}" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding Note}" FontSize="10.5" Foreground="{DynamicResource PbTextFaintBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Continuity membership (docs/superpowers/specs/2026-08-17-metadata-model-phase4a-
                 continuity-design.md) - additive section, doesn't touch the carousel above. -->
            <StackPanel Margin="0,24,0,0" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Continuities" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                    <Button Content="+ Add to Continuity"
                            Command="{Binding ToggleAddContinuityCommand}" Padding="10,5" FontSize="12" CornerRadius="5"
                            Background="{DynamicResource PbAccentBrush}" Foreground="{DynamicResource PbBadgeTextBrush}" BorderThickness="0" />
                </StackPanel>

                <Border IsVisible="{Binding IsAddingContinuity}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBox Text="{Binding ContinuitySearchQuery}" Watermark="Search or create a continuity…" FontSize="12" />
                        <ItemsControl ItemsSource="{Binding ContinuitySearchResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ContinuitySearchResult">
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6" Margin="0,2"
                                            Background="Transparent" BorderThickness="0" FontSize="12.5"
                                            Foreground="{DynamicResource PbTextMutedBrush}"
                                            Command="{Binding $parent[ItemsControl].((vm:DetailTabsViewModel)DataContext).AddContinuityCommand}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding Name}" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding ContinuityChips}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ContinuityChip">
                            <Border Background="{DynamicResource PbSurfaceAltBrush}" CornerRadius="12" Padding="10,4" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding Name}" FontSize="11.5" Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                                    <Button Content="✕" Padding="0" Width="16" Height="16" FontSize="9.5" CornerRadius="8"
                                            Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PbTextFaintBrush}"
                                            Command="{Binding $parent[ItemsControl].((vm:DetailTabsViewModel)DataContext).RemoveContinuityCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="Remove from this continuity" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock IsVisible="{Binding HasSameContinuity}" Text="Same Continuity" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource PbTextMutedBrush}" Margin="0,10,0,0" />
                <ScrollViewer IsVisible="{Binding HasSameContinuity}" HorizontalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SameContinuity}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="16" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:RelatedGroupSeriesSample">
                                <StackPanel Width="126">
                                    <Border CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource PbBorderBrush}"
                                            Height="189" Background="{Binding CoverBrush}">
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Black" Foreground="#FFFFF8EC"
                                                   VerticalAlignment="Bottom" Margin="8" TextWrapping="Wrap" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PbTextMutedBrush}" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding Note}" FontSize="10.5" Foreground="{DynamicResource PbTextFaintBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Same Event (docs/superpowers/specs/2026-08-17-metadata-model-phase4b-story-
                     events-design.md) - read-only derived section, no creation UI here. -->
                <TextBlock IsVisible="{Binding HasSameEvent}" Text="Same Event" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource PbTextMutedBrush}" Margin="0,10,0,0" />
                <ScrollViewer IsVisible="{Binding HasSameEvent}" HorizontalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SameEvent}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="16" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:RelatedGroupSeriesSample">
                                <StackPanel Width="126">
                                    <Border CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource PbBorderBrush}"
                                            Height="189" Background="{Binding CoverBrush}">
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Black" Foreground="#FFFFF8EC"
                                                   VerticalAlignment="Bottom" Margin="8" TextWrapping="Wrap" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PbTextMutedBrush}" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding Note}" FontSize="10.5" Foreground="{DynamicResource PbTextFaintBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </StackPanel>

        <!-- Details tab -->
        <Grid IsVisible="{Binding IsDetailsTab}" ColumnDefinitions="*,*" Margin="0,20,0,0">
            <StackPanel Grid.Column="0" Margin="0,0,28,0">
                <TextBlock Text="PUBLISHER" FontSize="10.5" Foreground="{DynamicResource PbTextFaintBrush}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding Publisher}" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="READING MODE" FontSize="10.5" Foreground="{DynamicResource PbTextFaintBrush}" Margin="0,0,0,4" />
                <Button Command="{Binding ToggleReadingModeCommand}" Content="{Binding ReadingModeLabel}"
                        Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                        HorizontalAlignment="Left" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
            </StackPanel>
        </Grid>

        <!-- External metadata (docs/superpowers/specs/2026-08-19-metadata-model-anilist-search-and-
             link-design.md) - completes the search/match UI Phase 5b's own spec deferred. Same
             search-flyout idiom as the Related tab's "+ Add Related Series" above, but async
             (network) rather than a local DB query, hence the loading/error states. -->
        <StackPanel IsVisible="{Binding IsDetailsTab}" Margin="0,24,0,0" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="External Metadata" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                <Button Content="+ Link External Metadata"
                        Command="{Binding ToggleSearchMetadataCommand}" Padding="10,5" FontSize="12" CornerRadius="5"
                        Background="{DynamicResource PbAccentBrush}" Foreground="{DynamicResource PbBadgeTextBrush}" BorderThickness="0" />
            </StackPanel>

            <Border IsVisible="{Binding IsSearchingMetadata}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="12">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox ItemsSource="{x:Static vm:DetailTabsViewModel.MetadataProviderOptions}"
                                  SelectedItem="{Binding SelectedMetadataProvider}" Width="130" FontSize="12" />
                        <TextBox Text="{Binding MetadataSearchQuery}" Watermark="Search…" FontSize="12" Width="220" />
                        <Button Content="Search" Command="{Binding SearchMetadataCommand}" Padding="10,5" FontSize="12" CornerRadius="5" />
                    </StackPanel>
                    <TextBlock IsVisible="{Binding IsMetadataSearchInProgress}" Text="Searching…" FontSize="12"
                               Foreground="{DynamicResource PbTextFaintBrush}" />
                    <TextBlock IsVisible="{Binding MetadataSearchError, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                               Text="{Binding MetadataSearchError}" FontSize="12" Foreground="{DynamicResource PbTextFaintBrush}" />
                    <ItemsControl ItemsSource="{Binding MetadataSearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:AniListMatchSample">
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3">
                                    <Border Grid.Column="0" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center"
                                            Classes.auto="{Binding TierClass, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=auto}"
                                            Classes.review="{Binding TierClass, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=review}"
                                            Classes.reject="{Binding TierClass, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=reject}">
                                        <Border.Styles>
                                            <Style Selector="Border.auto"><Setter Property="Background" Value="#2E7D32" /></Style>
                                            <Style Selector="Border.review"><Setter Property="Background" Value="#8A6D1D" /></Style>
                                            <Style Selector="Border.reject"><Setter Property="Background" Value="{DynamicResource PbSurfaceAltBrush}" /></Style>
                                        </Border.Styles>
                                        <TextBlock Text="{Binding TierLabel}" FontSize="10" Foreground="White" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" Foreground="{DynamicResource PbTextMutedBrush}" />
                                        <TextBlock Text="{Binding ConfidencePercent, StringFormat='{}{0}% match'}" FontSize="10.5"
                                                   Foreground="{DynamicResource PbTextFaintBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Link" Padding="10,4" FontSize="11.5" CornerRadius="5"
                                            Background="{DynamicResource PbAccentBrush}" Foreground="{DynamicResource PbBadgeTextBrush}" BorderThickness="0"
                                            Command="{Binding $parent[ItemsControl].((vm:DetailTabsViewModel)DataContext).LinkMetadataCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock IsVisible="{Binding !HasExternalLinks}" Text="Not linked to any external metadata source yet." FontSize="12.5"
                       Foreground="{DynamicResource PbTextFaintBrush}" />
            <ItemsControl ItemsSource="{Binding ExternalLinks}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ExternalLinkSample">
                        <Border Background="{DynamicResource PbSurfaceAltBrush}" CornerRadius="12" Padding="10,4" Margin="0,0,6,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding ProviderLabel}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                                <Button Content="✕" Padding="0" Width="16" Height="16" FontSize="9.5" CornerRadius="8"
                                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PbTextFaintBrush}"
                                        Command="{Binding $parent[ItemsControl].((vm:DetailTabsViewModel)DataContext).UnlinkMetadataCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="Remove this link" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Trackers (docs/superpowers/specs/2026-08-23-tracker-write-back-sync-design.md) -
             deliberately separate from External Metadata above: linking here writes to the user's
             real account on the chosen service, not just this app's own database. -->
        <StackPanel IsVisible="{Binding IsDetailsTab}" Margin="0,24,0,0" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Trackers" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                <Button Content="+ Link for Tracking"
                        Command="{Binding ToggleLinkTrackerCommand}" Padding="10,5" FontSize="12" CornerRadius="5"
                        Background="{DynamicResource PbAccentBrush}" Foreground="{DynamicResource PbBadgeTextBrush}" BorderThickness="0" />
                <Button Content="Sync to Trackers" IsVisible="{Binding HasTrackerLinks}"
                        Command="{Binding SyncToTrackersCommand}" Padding="10,5" FontSize="12" CornerRadius="5"
                        Background="{DynamicResource PbSurfaceAltBrush}" Foreground="{DynamicResource PbTextMutedBrush}" BorderThickness="0" />
            </StackPanel>

            <Border IsVisible="{Binding IsLinkingTracker}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="12">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox ItemsSource="{x:Static vm:DetailTabsViewModel.TrackerServiceOptions}"
                                  SelectedItem="{Binding SelectedTrackerService}" Width="140" FontSize="12" />
                        <TextBox Text="{Binding TrackerSearchQuery}" Watermark="Search title…" FontSize="12" Width="220" />
                        <Button Content="Search" Command="{Binding SearchTrackerCommand}" Padding="10,5" FontSize="12" CornerRadius="5" />
                    </StackPanel>
                    <TextBlock IsVisible="{Binding IsTrackerSearchInProgress}" Text="Searching…" FontSize="12"
                               Foreground="{DynamicResource PbTextFaintBrush}" />
                    <TextBlock IsVisible="{Binding TrackerSearchError, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                               Text="{Binding TrackerSearchError}" FontSize="12" Foreground="{DynamicResource PbTextFaintBrush}" />
                    <ItemsControl ItemsSource="{Binding TrackerSearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:TrackerMatchSample">
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3">
                                    <Border Grid.Column="0" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center"
                                            Classes.auto="{Binding TierClass, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=auto}"
                                            Classes.review="{Binding TierClass, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=review}"
                                            Classes.reject="{Binding TierClass, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=reject}">
                                        <Border.Styles>
                                            <Style Selector="Border.auto"><Setter Property="Background" Value="#2E7D32" /></Style>
                                            <Style Selector="Border.review"><Setter Property="Background" Value="#8A6D1D" /></Style>
                                            <Style Selector="Border.reject"><Setter Property="Background" Value="{DynamicResource PbSurfaceAltBrush}" /></Style>
                                        </Border.Styles>
                                        <TextBlock Text="{Binding TierLabel}" FontSize="10" Foreground="White" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" Foreground="{DynamicResource PbTextMutedBrush}" />
                                        <TextBlock Text="{Binding ConfidencePercent, StringFormat='{}{0}% match'}" FontSize="10.5"
                                                   Foreground="{DynamicResource PbTextFaintBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="{Binding LinkConfirm.Label}" Padding="10,4" FontSize="11.5" CornerRadius="5"
                                            Background="{DynamicResource PbAccentBrush}" Foreground="{DynamicResource PbBadgeTextBrush}" BorderThickness="0"
                                            Command="{Binding LinkConfirm.TriggerCommand}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock IsVisible="{Binding TrackerSyncStatus, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                       Text="{Binding TrackerSyncStatus}" FontSize="12" Foreground="{DynamicResource PbTextFaintBrush}" />

            <TextBlock IsVisible="{Binding !HasTrackerLinks}" Text="Not linked to any tracker yet." FontSize="12.5"
                       Foreground="{DynamicResource PbTextFaintBrush}" />
            <ItemsControl ItemsSource="{Binding TrackerLinks}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:TrackerLinkSample">
                        <Border Background="{DynamicResource PbSurfaceAltBrush}" CornerRadius="12" Padding="10,4" Margin="0,0,6,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Service}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                                <Button Content="✕" Padding="0" Width="16" Height="16" FontSize="9.5" CornerRadius="8"
                                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PbTextFaintBrush}"
                                        Command="{Binding $parent[ItemsControl].((vm:DetailTabsViewModel)DataContext).UnlinkTrackerCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="Remove this tracker link" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Activity tab - no activity-log schema/feature exists yet, so this is left as a real
             empty state rather than faked per-series log entries. -->
        <StackPanel IsVisible="{Binding IsActivityTab}" Margin="0,20,0,0" Spacing="4">
            <TextBlock Text="No recent activity." FontSize="12.5" Foreground="{DynamicResource PbTextFaintBrush}" />
        </StackPanel>
    </StackPanel>
</UserControl>
