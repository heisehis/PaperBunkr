<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:entities="using:Paperbunkr.Data.Entities"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:sys="using:System"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="320"
             x:Class="Paperbunkr.App.Views.DetailBand"
             x:DataType="vm:DetailBandViewModel"
             x:Name="u">

    <!--
        Always-visible band beneath the hero (docs/superpowers/specs/2026-08-28-detail-screens-
        streaming-redesign-design.md). Inline meta row (host screen injects its content-type
        picker via LeadingContent), clamped synopsis, then the tamed metadata groups. Renders
        nothing but the inline row + synopsis when Groups is empty (book "lite" mode).
    -->
    <UserControl.Styles>
        <!-- Squircle chips (PbRadius, matching the Library toolbar's own squircled chips - commit
             07a93af), with a smooth amber-glow reaction on hover: the app's established
             "reactive" idiom (design-language-foundation-design.md - glow ring, no scale-lift). -->
        <Style Selector="Border.bandChip">
            <Setter Property="Background" Value="{DynamicResource PbChromeBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadius}" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style Selector="Button.bandChip">
            <Setter Property="Background" Value="{DynamicResource PbChromeBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadius}" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="{DynamicResource PbMotionFast}" Easing="{StaticResource PbMotionEase}" />
                    <BrushTransition Property="BorderBrush" Duration="{DynamicResource PbMotionFast}" Easing="{StaticResource PbMotionEase}" />
                    <BrushTransition Property="Foreground" Duration="{DynamicResource PbMotionFast}" Easing="{StaticResource PbMotionEase}" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.bandChip:pointerover">
            <Setter Property="Background" Value="{DynamicResource PbAccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbAccentTextBrush}" />
        </Style>
        <Style Selector="Button.bandChip:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
        </Style>

        <!-- Weight-class visuals (docs/superpowers/specs/2026-08-23-weighted-categorized-tags-
             design.md) - Core/Defining read as "this defines the series", Recurrent full-strength,
             Incidental de-emphasised. Unset keeps the plain look. -->
        <Style Selector="Button.bandChip.core">
            <Setter Property="Background" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbBadgeTextBrush}" />
        </Style>
        <Style Selector="Button.bandChip.core:pointerover">
            <Setter Property="Background" Value="{DynamicResource PbAccentTextBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbBadgeTextBrush}" />
        </Style>
        <Style Selector="Button.bandChip.core Ellipse">
            <Setter Property="Fill" Value="{DynamicResource PbBadgeTextBrush}" />
        </Style>
        <Style Selector="Button.bandChip.defining">
            <Setter Property="Background" Value="{DynamicResource PbAccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbAccentTextBrush}" />
        </Style>
        <Style Selector="Button.bandChip.recurrent">
            <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbTextFaintBrush}" />
        </Style>
        <Style Selector="Button.bandChip.incidental">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <!-- Non-interactive Border chips (Virtual Tags) still get the glow-ring on hover. -->
        <Style Selector="Border.bandChip">
            <Setter Property="Transitions">
                <Transitions>
                    <BoxShadowsTransition Property="BoxShadow" Duration="{DynamicResource PbMotionFast}" Easing="{StaticResource PbMotionEase}" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.bandChip:pointerover">
            <Setter Property="BoxShadow" Value="{StaticResource PbGlowRing}" />
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource PbSurface2Brush}" BorderBrush="{DynamicResource PbBadgeBrush}"
            BorderThickness="2,0,0,0" Padding="26,14,26,4">
        <StackPanel Spacing="10">

            <!-- Inline meta row -->
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ContentControl Content="{Binding #u.LeadingContent}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusText}" IsVisible="{Binding HasStatus}" FontSize="11.5"
                           FontWeight="SemiBold" Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                <TextBlock Text="·" Foreground="{DynamicResource PbTextFaintBrush}" IsVisible="{Binding HasPublisher}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding PublisherText}" IsVisible="{Binding HasPublisher}" FontSize="11.5"
                           Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                <TextBlock Text="·" Foreground="{DynamicResource PbTextFaintBrush}" IsVisible="{Binding HasYear}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding YearText}" IsVisible="{Binding HasYear}" FontSize="11.5"
                           Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Synopsis -->
            <StackPanel IsVisible="{Binding Summary, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding Summary}" FontSize="13" Foreground="{DynamicResource PbTextMutedBrush}"
                           TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding !IsSynopsisExpanded}" />
                <TextBlock Text="{Binding Summary}" FontSize="13" Foreground="{DynamicResource PbTextMutedBrush}"
                           TextWrapping="Wrap" IsVisible="{Binding IsSynopsisExpanded}" />
                <Button Classes="detailGroupMore" Content="{Binding SynopsisToggleLabel}"
                        Command="{Binding ToggleSynopsisCommand}" Margin="0,3,0,0" HorizontalAlignment="Left" />
            </StackPanel>

            <!-- Metadata groups -->
            <ItemsControl ItemsSource="{Binding Groups}" IsVisible="{Binding HasGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DetailBandGroupViewModel">
                        <StackPanel Margin="0,0,0,6">
                            <!-- header -->
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,5">
                                <TextBlock Classes="detailGroupLabel" Text="{Binding Label}" VerticalAlignment="Center" />
                                <Button Classes="detailGroupMore" Content="{Binding MoreLabel}"
                                        Command="{Binding ToggleExpandCommand}" IsVisible="{Binding HasOverflow}" VerticalAlignment="Center" />
                                <Button Classes="detailGroupMore" Content="{Binding RevealHint}"
                                        Command="{Binding ToggleHiddenCommand}" IsVisible="{Binding HasHidden}"
                                        Foreground="{DynamicResource PbTextFaintBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- credits group -->
                            <StackPanel IsVisible="{Binding IsCreditsGroup}" Orientation="Horizontal">
                                <ItemsControl ItemsSource="{Binding Writers}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TagPillViewModel">
                                            <Button Classes="creditName" Command="{Binding SearchCommand}" Background="Transparent" BorderThickness="0" Padding="0,0,6,0" Cursor="Hand">
                                                <TextBlock Text="{Binding Value}" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="  •  art by  " FontSize="12" Foreground="{DynamicResource PbTextFaintBrush}"
                                           VerticalAlignment="Center" IsVisible="{Binding HasArtists}" />
                                <ItemsControl ItemsSource="{Binding Artists}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TagPillViewModel">
                                            <Button Classes="creditName" Command="{Binding SearchCommand}" Background="Transparent" BorderThickness="0" Padding="0,0,6,0" Cursor="Hand">
                                                <TextBlock Text="{Binding Value}" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Classes="detailGroupMore" Content="full credits ›" Command="{Binding FullCreditsCommand}"
                                        Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- regular group -->
                            <ItemsControl ItemsSource="{Binding Chips}" IsVisible="{Binding !IsCreditsGroup}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TagPillViewModel">
                                        <Button Classes="bandChip" Command="{Binding SearchCommand}" ToolTip.Tip="{Binding Category}"
                                                Classes.core="{Binding WeightClass, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=core}"
                                                Classes.defining="{Binding WeightClass, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=defining}"
                                                Classes.recurrent="{Binding WeightClass, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=recurrent}"
                                                Classes.incidental="{Binding WeightClass, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=incidental}">
                                            <Button.ContextMenu>
                                                <ContextMenu IsVisible="{Binding CanReweight}">
                                                    <MenuItem Header="Incidental" Command="{Binding SetWeightCommand}" CommandParameter="{x:Static entities:IssueTagWeight.Incidental}" />
                                                    <MenuItem Header="Recurrent" Command="{Binding SetWeightCommand}" CommandParameter="{x:Static entities:IssueTagWeight.Recurrent}" />
                                                    <MenuItem Header="Defining" Command="{Binding SetWeightCommand}" CommandParameter="{x:Static entities:IssueTagWeight.Defining}" />
                                                    <MenuItem Header="Core" Command="{Binding SetWeightCommand}" CommandParameter="{x:Static entities:IssueTagWeight.Core}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Ellipse Width="5" Height="5" VerticalAlignment="Center" IsVisible="{Binding IsWeighted}"
                                                         Fill="{DynamicResource PbAccentBrush}" />
                                                <TextBlock Text="{Binding Value}" FontWeight="{Binding TextWeight}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Virtual Tags -->
            <StackPanel IsVisible="{Binding HasVirtualTags}" Margin="0,0,0,6">
                <TextBlock Classes="detailGroupLabel" Text="Virtual Tags" Margin="0,0,0,5" />
                <ItemsControl ItemsSource="{Binding VirtualTags}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="sys:String">
                            <Border Classes="bandChip" Background="#24D7AC4C" BorderBrush="{DynamicResource PbBadgeBrush}">
                                <TextBlock Text="{Binding}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource PbBadgeBrush}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
