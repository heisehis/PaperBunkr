<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:views="using:Paperbunkr.App.Views"
             xmlns:models="using:Paperbunkr.App.Models"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="900"
             x:Class="Paperbunkr.App.Views.MangaDetailScreen"
             x:DataType="vm:MangaDetailScreenViewModel"
             x:Name="Screen">

    <!--
        Manga/Manhua/Manhwa detail, rebuilt on the shared DetailHero / DetailBand / DetailTabs
        controls for UI rework Phase 5 (docs/superpowers/specs/2026-08-28-detail-screens-streaming-
        redesign-design.md). Distinct from the comic screen by its Chapters tab: a release feed with
        volume section headers, scanlation groups, relative dates, and NEW badges - no cover tiles
        (manga chapters have no variant covers). A tracker-progress ring + native-title line are a
        deferred follow-up (needs provider-payload parsing).
    -->
    <UserControl.Styles>
        <Style Selector="ComboBox.contentTypePicker">
            <Setter Property="Background" Value="{DynamicResource PbAccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadius}" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PbAccentTextBrush}" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style Selector="Button.chapterFilterPill">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadius}" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="{DynamicResource PbMotionFast}" Easing="{StaticResource PbMotionEase}" />
                    <BrushTransition Property="BorderBrush" Duration="{DynamicResource PbMotionFast}" Easing="{StaticResource PbMotionEase}" />
                    <BrushTransition Property="Foreground" Duration="{DynamicResource PbMotionFast}" Easing="{StaticResource PbMotionEase}" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.chapterFilterPill:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbAccentTextBrush}" />
        </Style>
        <Style Selector="Button.chapterFilterPill.active">
            <Setter Property="Background" Value="{DynamicResource PbAccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbAccentBrush}" />
        </Style>

        <Style Selector="TextBlock.volumeHeader">
            <Setter Property="FontFamily" Value="{StaticResource PbDisplayFontFamily}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="LetterSpacing" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextFaintBrush}" />
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>

        <Style Selector="Button.chapterRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="8,9" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.chapterRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource PbSurface3Brush}" />
        </Style>
        <Style Selector="Button.chapterRow.read">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="TextBlock.chapterNumber">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
        </Style>
        <Style Selector="TextBlock.chapterTitle">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.chapterMeta">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextFaintBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.newBadge">
            <Setter Property="Background" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ProgressBar.chapterProgress">
            <Setter Property="Height" Value="3" />
            <Setter Property="Foreground" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="0" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="0,0,0,50">
            <Button Classes="backLink" Command="{Binding GoBackCommand}" Content="← Back to Library" Margin="28,20,28,12" />

            <views:DetailHero DataContext="{Binding}" />

            <views:DetailBand DataContext="{Binding Band}">
                <views:DetailBand.LeadingContent>
                    <ComboBox Classes="contentTypePicker"
                              ItemsSource="{Binding #Screen.((vm:MangaDetailScreenViewModel)DataContext).ContentTypeOptions}"
                              SelectedItem="{Binding #Screen.((vm:MangaDetailScreenViewModel)DataContext).SelectedContentType}"
                              ToolTip.Tip="Content Type" />
                </views:DetailBand.LeadingContent>
            </views:DetailBand>

            <StackPanel Margin="28,0,28,0">
                <!-- Unified tab strip -->
                <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,0,0,1" Margin="0,18,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="22">
                        <Button Classes="tab" Classes.active="{Binding IsChaptersTab}" Command="{Binding GoChaptersTabCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Text="Chapters" />
                                <TextBlock Classes="tabCount" Text="{Binding Chapters.Count}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="tab" Classes.active="{Binding IsRelatedTabActive}" Command="{Binding GoRelatedTabCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Text="Related" />
                                <TextBlock Classes="tabCount" Text="{Binding Tabs.Related.Count}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="tab" Classes.active="{Binding IsDetailsTabActive}" Command="{Binding GoDetailsTabCommand}" Content="Details" />
                        <Button Classes="tab" Classes.active="{Binding IsActivityTabActive}" Command="{Binding GoActivityTabCommand}" Content="Activity" />
                    </StackPanel>
                </Border>

                <!-- Chapters tab: release feed -->
                <StackPanel IsVisible="{Binding IsChaptersTab}" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                        <Button Classes="chapterFilterPill" Classes.active="{Binding ChapterFilter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static models:ChapterListFilter.All}}"
                                Content="All" Command="{Binding SetChapterFilterCommand}" CommandParameter="{x:Static models:ChapterListFilter.All}" />
                        <Button Classes="chapterFilterPill" Classes.active="{Binding ChapterFilter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static models:ChapterListFilter.Unread}}"
                                Content="Unread" Command="{Binding SetChapterFilterCommand}" CommandParameter="{x:Static models:ChapterListFilter.Unread}" />
                        <Button Classes="chapterFilterPill" Classes.active="{Binding ChapterFilter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static models:ChapterListFilter.Bookmarked}}"
                                Content="Bookmarked" Command="{Binding SetChapterFilterCommand}" CommandParameter="{x:Static models:ChapterListFilter.Bookmarked}" />
                        <Button Classes="chapterFilterPill" Classes.active="{Binding ChapterFilter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static models:ChapterListFilter.Missing}}"
                                Content="Missing" Command="{Binding SetChapterFilterCommand}" CommandParameter="{x:Static models:ChapterListFilter.Missing}" />
                        <Border Width="1" Background="{DynamicResource PbBorderBrush}" Margin="6,2" />
                        <Button Classes="chapterFilterPill" Classes.active="{Binding ChapterSortField, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static models:ChapterSortField.Number}}"
                                Content="By Number" Command="{Binding SetChapterSortFieldCommand}" CommandParameter="{x:Static models:ChapterSortField.Number}" />
                        <Button Classes="chapterFilterPill" Classes.active="{Binding ChapterSortField, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static models:ChapterSortField.Date}}"
                                Content="By Date" Command="{Binding SetChapterSortFieldCommand}" CommandParameter="{x:Static models:ChapterSortField.Date}" />
                        <Button Classes="chapterFilterPill" Command="{Binding ToggleChapterSortDirectionCommand}"
                                Content="{Binding ChapterSortDirectionGlyph}" ToolTip.Tip="Toggle sort direction" />
                    </StackPanel>

                    <TextBlock IsVisible="{Binding !HasChapters}" Text="No chapters match this filter." FontSize="12.5"
                               Foreground="{DynamicResource PbTextFaintBrush}" Margin="0,10,0,0" />

                    <ItemsControl x:Name="ChapterGroupsList" ItemsSource="{Binding ChapterGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ChapterVolumeGroup">
                                <StackPanel>
                                    <TextBlock Classes="volumeHeader" Text="{Binding VolumeLabel}" />
                                    <ItemsControl ItemsSource="{Binding Chapters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:ChapterRowSample">
                                                <Button Classes="chapterRow" Classes.read="{Binding IsRead}"
                                                        Command="{Binding #ChapterGroupsList.((vm:MangaDetailScreenViewModel)DataContext).OpenChapterCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Edit Properties" Command="{Binding #ChapterGroupsList.((vm:MangaDetailScreenViewModel)DataContext).EditChapterPropertiesCommand}" CommandParameter="{Binding}" />
                                                            <MenuItem Header="Show in Explorer" Command="{Binding #ChapterGroupsList.((vm:MangaDetailScreenViewModel)DataContext).RevealChapterCommand}" CommandParameter="{Binding}" />
                                                            <Separator />
                                                            <MenuItem Header="Mark as Read" Command="{Binding #ChapterGroupsList.((vm:MangaDetailScreenViewModel)DataContext).MarkChapterReadCommand}" CommandParameter="{Binding}" />
                                                            <MenuItem Header="Mark as Unread" Command="{Binding #ChapterGroupsList.((vm:MangaDetailScreenViewModel)DataContext).MarkChapterUnreadCommand}" CommandParameter="{Binding}" />
                                                            <Separator />
                                                            <MenuItem Header="Set Cover…" Command="{Binding #ChapterGroupsList.((vm:MangaDetailScreenViewModel)DataContext).ChangeChapterCoverCommand}" CommandParameter="{Binding}" />
                                                            <MenuItem Header="Reset Cover" Command="{Binding #ChapterGroupsList.((vm:MangaDetailScreenViewModel)DataContext).ResetChapterCoverCommand}" CommandParameter="{Binding}" />
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                    <Grid>
                                                        <Grid ColumnDefinitions="60,*,Auto,Auto,Auto,110" VerticalAlignment="Center">
                                                            <TextBlock Grid.Column="0" Classes="chapterNumber" Text="{Binding DisplayNumber}" />
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" Margin="8,0">
                                                                <TextBlock Classes="chapterTitle" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                <Border Classes="newBadge" IsVisible="{Binding IsNew}">
                                                                    <TextBlock Text="NEW" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource PbBadgeTextBrush}" />
                                                                </Border>
                                                            </StackPanel>
                                                            <fi:SymbolIcon Grid.Column="2" Symbol="Bookmark" FontSize="12" Margin="0,0,8,0" IsVisible="{Binding HasBookmark}" />
                                                            <fi:SymbolIcon Grid.Column="3" Symbol="Warning" FontSize="12" Margin="0,0,8,0" IsVisible="{Binding IsMissing}"
                                                                    Foreground="{DynamicResource PbBadgeBrush}" />
                                                            <TextBlock Grid.Column="4" Classes="chapterMeta" Text="{Binding ScanInformation}" Margin="0,0,10,0" IsVisible="{Binding HasScanInformation}" />
                                                            <TextBlock Grid.Column="5" Classes="chapterMeta" Text="{Binding Date, StringFormat='{}{0:MMM d, yyyy}'}" HorizontalAlignment="Right" />
                                                        </Grid>
                                                        <ProgressBar Classes="chapterProgress" Value="{Binding ReadPercentage}" Minimum="0" Maximum="100" IsVisible="{Binding IsInProgress}" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Related / Details / Activity - the shared DetailTabs content -->
                <Border IsVisible="{Binding !IsChaptersTab}">
                    <views:DetailTabs DataContext="{Binding Tabs}" />
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
