<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:controls="using:Paperbunkr.App.Controls"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:models="using:Paperbunkr.App.Models"
             xmlns:services="using:Paperbunkr.App.Services"
             xmlns:cs="using:Paperbunkr.App.Services.ContinuityScreen"
             xmlns:eventmap="using:Paperbunkr.App.Services.EventMap"
             xmlns:views="using:Paperbunkr.App.Views"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="900"
             x:Class="Paperbunkr.App.Views.ContinuityOverviewView"
             x:Name="Overview"
             x:DataType="vm:ContinuityPageViewModel">

    <!-- A continuity's Overview (docs/superpowers/specs/2026-09-28-continuity-screen-redesign-design.md, "Continuity page"):
         Add series (when open), Needs attention, Series as runs (Automatic) or a draggable wall (Custom), then Events in order. -->
    <UserControl.Styles>
        <StyleInclude Source="avares://Paperbunkr.App/Styles/ContinuityChrome.axaml" />
    </UserControl.Styles>

    <UserControl.Resources>
        <!-- The hover buttons' dark #B0000000 scrim and white glyphs are deliberate: they always sit on arbitrary cover art,
             the same exemption DetailHero documents (and OverlayShell's own scrim uses). -->
        <!-- One poster: a member series (progress ring, name, years; hover: note, remove; the multi-select tick) or a dimmed
             placeholder for a continuation you don't own, which opens comics.org. -->
        <DataTemplate x:Key="PosterTemplate" x:DataType="models:ContinuityPosterItem">
            <StackPanel Orientation="Horizontal">
                <fi:SymbolIcon Symbol="ArrowRight" FontSize="{StaticResource PbIconSizeSm}" Foreground="{DynamicResource PbAccentBrush}"
                               VerticalAlignment="Top" Margin="0,64,10,0" IsVisible="{Binding ArrowBefore}" />
                <StackPanel Width="96" Margin="0,0,12,14">
                    <Panel Classes="posterCell">
                        <Button Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" IsVisible="{Binding IsSeries}"
                                AutomationProperties.Name="{Binding AutomationName}"
                                Command="{Binding $parent[views:ContinuityOverviewView].((vm:ContinuityPageViewModel)DataContext).OpenSeriesCommand}"
                                CommandParameter="{Binding Card}">
                            <Button.KeyBindings>
                                <KeyBinding Gesture="Ctrl+Left" Command="{Binding $parent[views:ContinuityOverviewView].((vm:ContinuityPageViewModel)DataContext).MoveSeriesEarlierCommand}"
                                            CommandParameter="{Binding Card}" />
                                <KeyBinding Gesture="Ctrl+Right" Command="{Binding $parent[views:ContinuityOverviewView].((vm:ContinuityPageViewModel)DataContext).MoveSeriesLaterCommand}"
                                            CommandParameter="{Binding Card}" />
                            </Button.KeyBindings>
                            <Panel>
                                <Border Height="144" CornerRadius="{DynamicResource PbRadiusSm}" ClipToBounds="True" Background="{Binding CoverBrush}">
                                    <Image views:AsyncCoverImage.SourceId="{Binding Card.CoverKey}" Stretch="UniformToFill" />
                                </Border>
                                <views:TileCosmeticsOverlay DataContext="{Binding Card}" />
                            </Panel>
                        </Button>
                        <Button Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" IsVisible="{Binding IsPlaceholder}"
                                AutomationProperties.Name="{Binding AutomationName}" ToolTip.Tip="Not in your library - open it on comics.org (Grand Comics Database™)"
                                Command="{x:Static services:ExternalLinks.OpenWebCommand}" CommandParameter="{Binding Url}">
                            <Border Height="144" CornerRadius="{DynamicResource PbRadiusSm}" BorderThickness="1" BorderBrush="{DynamicResource PbBorderBrush}"
                                    Background="{DynamicResource PbSurface2Brush}" Opacity="0.6">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                                    <fi:SymbolIcon Symbol="Globe" FontSize="{StaticResource PbIconSizeLg}" Foreground="{DynamicResource PbTextFaintBrush}"
                                                   HorizontalAlignment="Center" />
                                    <TextBlock Text="Not in your library" FontSize="10" TextWrapping="Wrap" TextAlignment="Center" Width="80"
                                               Foreground="{DynamicResource PbTextMutedBrush}" />
                                </StackPanel>
                            </Border>
                        </Button>
                        <CheckBox Classes="posterHover posterPick" IsVisible="{Binding IsSeries}"
                                  Classes.pinned="{Binding $parent[views:ContinuityOverviewView].((vm:ContinuityPageViewModel)DataContext).AnyMembersSelected}"
                                  IsChecked="{Binding Card.IsSelected, Mode=OneWay}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4"
                                  MinWidth="0" Padding="0" AutomationProperties.Name="Select this series"
                                  Command="{Binding $parent[views:ContinuityOverviewView].((vm:ContinuityPageViewModel)DataContext).ToggleMemberSelectionCommand}"
                                  CommandParameter="{Binding Card}" />
                        <Button Classes="iconButton posterHover" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                ToolTip.Tip="Remove from continuity" AutomationProperties.Name="Remove from continuity"
                                IsVisible="{Binding IsSeries}"
                                Command="{Binding $parent[views:ContinuityOverviewView].((vm:ContinuityPageViewModel)DataContext).RemoveSeriesCommand}"
                                CommandParameter="{Binding Card}">
                            <fi:SymbolIcon Symbol="Dismiss" FontSize="{StaticResource PbIconSizeXs}" Foreground="White" />
                        </Button>
                        <Button Classes="iconButton posterHover" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4"
                                ToolTip.Tip="Edit note" AutomationProperties.Name="Edit note"
                                IsVisible="{Binding IsSeries}"
                                Command="{Binding $parent[views:ContinuityOverviewView].((vm:ContinuityPageViewModel)DataContext).BeginEditNoteCommand}"
                                CommandParameter="{Binding Card}">
                            <fi:SymbolIcon Symbol="Edit" FontSize="{StaticResource PbIconSizeXs}" Foreground="White" />
                        </Button>
                    </Panel>
                    <TextBlock Text="{Binding Name}" FontSize="10" Foreground="{DynamicResource PbTextBrush}" TextTrimming="CharacterEllipsis"
                               Margin="0,4,0,0" ToolTip.Tip="{Binding Name}" />
                    <TextBlock Text="{Binding Years}" Classes="csFaint" FontSize="10" IsVisible="{Binding HasYears}" />
                    <TextBlock Text="{Binding Card.MembershipNote}" FontSize="10" Foreground="{DynamicResource PbTextMutedBrush}"
                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                               ToolTip.Tip="{Binding Card.MembershipNote}"
                               IsVisible="{Binding Card.HasMembershipNote, FallbackValue=False}" />
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,4,0,0" IsVisible="{Binding Card.IsEditingNote, FallbackValue=False}">
                        <TextBox Text="{Binding Card.MembershipNote}" FontSize="10" Width="66" MinHeight="0" Padding="4,2" PlaceholderText="note" />
                        <Button Classes="iconButton" ToolTip.Tip="Save note" AutomationProperties.Name="Save note"
                                Command="{Binding $parent[views:ContinuityOverviewView].((vm:ContinuityPageViewModel)DataContext).SetNoteCommand}"
                                CommandParameter="{Binding Card}">
                            <fi:SymbolIcon Symbol="Checkmark" FontSize="{StaticResource PbIconSizeXs}" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Margin="24,16,24,0" Spacing="18">

        <!-- Browse the selected continuity's Metron universe independently of library-wide Suggestions & checks. -->
        <Border Background="{DynamicResource PbSurface2Brush}" CornerRadius="{DynamicResource PbRadiusSm}" Padding="12"
                IsVisible="{Binding IsMetronSeriesBrowserOpen}">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <StackPanel>
                        <TextBlock Text="Find continuity series on Metron" Classes="csSection" />
                        <TextBlock Text="Browse every series Metron lists in this universe. Library matches are linked by exact Metron series ID; title similarity alone is never used." Classes="csFaint" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="ghost" Content="Refresh" Command="{Binding RefreshMetronUniverseSeriesCommand}"
                            IsEnabled="{Binding !IsLoadingMetronSeries}" />
                    <Button Grid.Column="2" Classes="ghost" Content="Close" Command="{Binding ToggleMetronSeriesBrowserCommand}" />
                </Grid>
                <TextBlock Text="Metron universe" Classes="csFaint" />
                <TextBlock Text="{Binding MetronUniverseLabel}" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding MetronSeriesBrowserMessage}" Classes="csFaint" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{Binding SelectedMetronSeriesCount, StringFormat='{}{0} selected'}" Classes="csFaint" VerticalAlignment="Center" />
                        <Button Classes="ghost" Content="Select all found" Command="{Binding SelectAllExactMetronSeriesCommand}" />
                        <Button Classes="ghost" Content="Clear" Command="{Binding ClearMetronSeriesSelectionCommand}" />
                        <Button Classes="primary" Content="Apply selected" Command="{Binding ApplySelectedMetronSeriesCommand}" IsEnabled="{Binding HasSelectedMetronSeries}" />
                    </StackPanel>
                </Grid>
                <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding MetronUniverseSeries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MetronContinuitySeriesRowViewModel">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,4" ColumnSpacing="8">
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanAdd}" VerticalAlignment="Center"
                                              AutomationProperties.Name="Select Metron series found in library" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource PbTextBrush}" />
                                        <TextBlock Text="{Binding Details}" Classes="csFaint" FontSize="10" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding LibraryStatus}" Classes="csFaint" VerticalAlignment="Center" />
                                    <Button Grid.Column="3" Classes="secondary" Content="Add"
                                            IsVisible="{Binding CanAdd}" AutomationProperties.Name="Add exact Metron series match to this continuity"
                                            Command="{Binding $parent[ItemsControl].((vm:ContinuityPageViewModel)DataContext).AddMetronSeriesCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Add series -->
        <Border Background="{DynamicResource PbSurface2Brush}" CornerRadius="{DynamicResource PbRadiusSm}" Padding="12"
                IsVisible="{Binding IsAddingSeries}">
            <StackPanel Spacing="8">
                <TextBox Classes="searchBox" PlaceholderText="Search series by name…" Text="{Binding SeriesSearchQuery}">
                    <TextBox.InnerLeftContent>
                        <fi:SymbolIcon Symbol="Search" FontSize="{StaticResource PbIconSizeSm}" Margin="8,0,2,0" />
                    </TextBox.InnerLeftContent>
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SearchSeriesCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <Border Background="{DynamicResource PbSurface3Brush}" CornerRadius="{DynamicResource PbRadiusSm}" Padding="8,6" IsVisible="{Binding AnySeriesSelected}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding SeriesSelectionSummary}" FontSize="12" Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                        <Button Classes="primary sm" Content="Add selected" Command="{Binding AddSelectedSeriesCommand}" />
                        <Button Classes="ghost sm" Content="Clear" Command="{Binding ClearSeriesSelectionCommand}" />
                    </StackPanel>
                </Border>
                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding SeriesSearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:SeriesSearchResult">
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2,6,2" ColumnSpacing="8">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=OneWay}" VerticalAlignment="Center" MinWidth="0" Padding="0"
                                              AutomationProperties.Name="{Binding Name}"
                                              Command="{Binding $parent[views:ContinuityOverviewView].((vm:ContinuityPageViewModel)DataContext).ToggleSeriesSelectionCommand}"
                                              CommandParameter="{Binding}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource PbTextMutedBrush}" />
                                        <!-- "Also in: X, Y" - the series already belongs to other continuities (smart features §7.1). -->
                                        <TextBlock Text="{Binding OtherContinuities}" IsVisible="{Binding HasOtherContinuities}" FontSize="11"
                                                   Foreground="{DynamicResource PbTextMutedBrush}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding OtherContinuities}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Classes="ghost" Content="Add"
                                            Command="{Binding $parent[views:ContinuityOverviewView].((vm:ContinuityPageViewModel)DataContext).AddSeriesCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Needs attention -->
        <Border Classes="attention" IsVisible="{Binding HasAttention}">
            <WrapPanel>
                <TextBlock Text="Needs attention" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PbTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button Classes="attentionItem" Content="{Binding DuplicatesAttention.Text}" Command="{Binding OpenDuplicatesCommand}"
                        IsVisible="{Binding DuplicatesAttention, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                <Button Classes="attentionItem" Content="{Binding ConnectionsAttention.Text}"
                        IsVisible="{Binding ConnectionsAttention, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                    <Button.Flyout>
                        <!-- Fixed width, no sideways scroll: Fluent's flyout caps its content near 456px, so anything wider
                             was clipped (the Accept / Dismiss buttons fell off the right edge). Virtualized - a big continuity
                             can have well over a hundred to review. -->
                        <Flyout Placement="BottomEdgeAlignedLeft">
                            <StackPanel Width="400" Spacing="6">
                                <TextBlock Text="{Binding ConnectionsAttention.Text}" Classes="csSection" />
                                <TextBlock Text="Accept creates exactly the link described; Dismiss stops it being suggested again." Classes="csFaint" TextWrapping="Wrap" />
                                <ScrollViewer MaxHeight="380" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Connections}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="cs:OverviewConnection">
                                                <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding Headline}" FontSize="12" Foreground="{DynamicResource PbTextBrush}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Reason}" FontSize="10" Foreground="{DynamicResource PbTextMutedBrush}" TextWrapping="Wrap" />
                                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" Margin="0,2,0,0">
                                                            <Button Classes="secondary" Content="Accept"
                                                                    AutomationProperties.Name="{Binding Headline, StringFormat='Accept: {0}'}"
                                                                    Command="{Binding $parent[ItemsControl].((vm:ContinuityPageViewModel)DataContext).AcceptConnectionCommand}"
                                                                    CommandParameter="{Binding}" />
                                                            <Button Classes="ghost" Content="Dismiss"
                                                                    AutomationProperties.Name="{Binding Headline, StringFormat='Dismiss: {0}'}"
                                                                    Command="{Binding $parent[ItemsControl].((vm:ContinuityPageViewModel)DataContext).DismissConnectionCommand}"
                                                                    CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button Classes="attentionItem" Content="{Binding OutsideAttention.Text}"
                        IsVisible="{Binding OutsideAttention, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                            <StackPanel Width="400" Spacing="6">
                                <TextBlock Text="{Binding OutsideAttention.Text}" Classes="csSection" TextWrapping="Wrap" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Text="{Binding SelectedOutsideSeriesCount, StringFormat='{}{0} selected'}" Classes="csFaint" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <Button Classes="ghost" Content="Select all" Command="{Binding SelectAllOutsideSeriesCommand}" />
                                        <Button Classes="ghost" Content="Clear" Command="{Binding ClearOutsideSeriesSelectionCommand}" />
                                        <Button Classes="primary" Content="Add selected" Command="{Binding AddSelectedOutsideSeriesCommand}" IsEnabled="{Binding HasSelectedOutsideSeries}" />
                                    </StackPanel>
                                </Grid>
                                <ScrollViewer MaxHeight="380" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding OutsideSeries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:OutsideSeriesRowViewModel">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,4" ColumnSpacing="8">
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"
                                                              AutomationProperties.Name="{Binding Name, StringFormat='Select {0}'}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource PbTextBrush}"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding IssueCount, StringFormat='{}{0} in its events'}" Classes="csFaint"
                                                               VerticalAlignment="Center" />
                                                    <Button Grid.Column="3" Classes="secondary" Content="Add"
                                                            AutomationProperties.Name="{Binding Name, StringFormat='Add {0} to this continuity'}"
                                                            Command="{Binding $parent[ItemsControl].((vm:ContinuityPageViewModel)DataContext).AddOutsideSeriesCommand}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </WrapPanel>
        </Border>

        <!-- Series -->
        <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="csSection" Text="{Binding SeriesHeader}" />
                <Button Grid.Column="1" Classes="ghost" AutomationProperties.Name="Series order">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{Binding OrderLabel}" />
                        <fi:SymbolIcon Symbol="ChevronDown" FontSize="{StaticResource PbIconSizeXs}" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Automatic (runs by start year)" Command="{Binding UseAutomaticOrderCommand}" />
                            <MenuItem Header="Custom (drag to arrange)" Command="{Binding UseCustomOrderCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <StackPanel Spacing="10" HorizontalAlignment="Center" IsVisible="{Binding HasNoMembers}">
                <controls:EmptyIllustration Kind="Timeline" HorizontalAlignment="Center" />
                <TextBlock Text="No series yet — Add series to get started." FontSize="13" HorizontalAlignment="Center"
                           Foreground="{DynamicResource PbTextMutedBrush}" />
                <Button Classes="secondary" HorizontalAlignment="Center" Command="{Binding ToggleAddSeriesCommand}"><StackPanel Orientation="Horizontal" Spacing="6"><fi:SymbolIcon Symbol="Add" FontSize="{StaticResource PbIconSizeXs}" /><TextBlock Text="Add series" VerticalAlignment="Center" /></StackPanel></Button>
            </StackPanel>

            <Border Background="{DynamicResource PbSurface2Brush}" CornerRadius="{DynamicResource PbRadiusSm}" Padding="8,6" IsVisible="{Binding AnyMembersSelected}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding MemberSelectionSummary}" FontSize="12" Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                    <Button Classes="ghost sm" Content="Remove from continuity" Command="{Binding RemoveSelectedSeriesCommand}" />
                    <Button Classes="ghost sm" Content="Clear" Command="{Binding ClearMemberSelectionCommand}" />
                </StackPanel>
            </Border>

            <!-- Automatic: runs, then Standalone -->
            <StackPanel Spacing="14" IsVisible="{Binding IsAutomaticOrder}">
                <ItemsControl ItemsSource="{Binding Runs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ContinuityRunRow">
                            <StackPanel Spacing="6" Margin="0,0,0,6">
                                <TextBlock Text="{Binding Label}" Classes="csFaint" FontSize="11" />
                                <ItemsControl ItemsSource="{Binding Posters}" ItemTemplate="{StaticResource PosterTemplate}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Spacing="6" IsVisible="{Binding HasStandalone}">
                    <TextBlock Text="Standalone" Classes="csFaint" FontSize="11" IsVisible="{Binding HasRuns}" />
                    <!-- Virtualized (a big continuity has hundreds of standalone series); posters are a fixed size, so the uniform
                         wrap panel the Library grids use fits. -->
                    <ItemsControl ItemsSource="{Binding StandalonePosters}" ItemTemplate="{StaticResource PosterTemplate}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:VirtualizingWrapPanel ItemWidth="108" ItemHeight="222" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

            <!-- Custom: the stored order, dragged (Ctrl+←/→ on a focused poster does the same) -->
            <StackPanel Spacing="6" IsVisible="{Binding IsCustomOrder}">
                <TextBlock Text="Drag posters to arrange them. This order sets the map's lanes and the reading-list export." Classes="csFaint" />
                <ItemsControl x:Name="CustomWall" ItemsSource="{Binding CustomPosters}" ItemTemplate="{StaticResource PosterTemplate}"
                              DragDrop.AllowDrop="True">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:VirtualizingWrapPanel ItemWidth="108" ItemHeight="222" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </StackPanel>

        <!-- Events in order -->
        <StackPanel Spacing="4" IsVisible="{Binding HasEvents}">
            <TextBlock Classes="csSection" Text="{Binding EventsHeader}" Margin="0,0,0,6" />
            <ItemsControl ItemsSource="{Binding EventsInOrder}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="cs:OverviewEventRow">
                        <StackPanel>
                            <Border Classes="itemRow">
                                <Grid ColumnDefinitions="90,*,170,Auto,Auto" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0" Text="{Binding Years}" Classes="csFaint" FontSize="11" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Classes="ghost" HorizontalAlignment="Left"
                                            AutomationProperties.Name="{Binding Name, StringFormat='Open {0}'}"
                                            Command="{Binding $parent[views:ContinuityOverviewView].((vm:ContinuityPageViewModel)DataContext).OpenEventCommand}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PbTextBrush}"
                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                    </Button>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Text="{Binding CountLabel}" Classes="csFaint" />
                                        <ProgressBar Classes="thin" Value="{Binding ReadFraction}" />
                                    </StackPanel>
                                    <Button Grid.Column="3" Classes="ghost"
                                            AutomationProperties.Name="{Binding Name, StringFormat='Open map for {0}'}"
                                            Command="{Binding $parent[views:ContinuityOverviewView].((vm:ContinuityPageViewModel)DataContext).OpenEventMapCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <fi:SymbolIcon Symbol="Map" FontSize="{StaticResource PbIconSizeXs}" />
                                            <TextBlock Text="Map" FontSize="11" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="4" Classes="ghost"
                                            Command="{Binding $parent[views:ContinuityOverviewView].((vm:ContinuityPageViewModel)DataContext).ToggleEventDetailsCommand}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding DetailsToggleLabel}">
                                        <TextBlock Text="Details" FontSize="11" />
                                    </Button>
                                </Grid>
                            </Border>
                            <Border IsVisible="{Binding IsExpanded}" Margin="100,4,0,8" Padding="12" Classes="itemRow">
                                <Grid ColumnDefinitions="120,*" ColumnSpacing="14">
                                    <Image Grid.Column="0" Width="120" Height="160" Stretch="UniformToFill" IsVisible="{Binding CoverPath, Converter={x:Static conv:ObjectConverters.IsNotNull}}" views:RemoteThumbnailImage.LocalPath="{Binding CoverPath}" />
                                    <Image Grid.Column="0" Width="120" Height="160" Stretch="UniformToFill" IsVisible="{Binding ShowRemoteCover}" views:RemoteThumbnailImage.SourceUrl="{Binding CoverImageUrl}" />
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" IsVisible="{Binding Description, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                                        <StackPanel Spacing="4" IsVisible="{Binding HasTags}">
                                            <TextBlock Text="TAGS" FontSize="10" Foreground="{DynamicResource PbTextMutedBrush}" />
                                            <ItemsControl ItemsSource="{Binding Tags}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="eventmap:ContinuityEventTagData"><Border Padding="8,4" Margin="0,0,4,4" CornerRadius="{DynamicResource PbRadius}" Background="{DynamicResource PbSurfaceBrush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1"><TextBlock Text="{Binding DisplayValue}" FontSize="10" ToolTip.Tip="{Binding Category}" /></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                        </StackPanel>
                                        <StackPanel Spacing="4" IsVisible="{Binding HasRelatedEvents}">
                                            <TextBlock Text="RELATED EVENTS" FontSize="10" Foreground="{DynamicResource PbTextMutedBrush}" />
                                            <ItemsControl ItemsSource="{Binding RelatedEvents}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="eventmap:ContinuityRelatedEventData"><Button Classes="ghost" HorizontalAlignment="Left" Command="{Binding $parent[views:ContinuityOverviewView].((vm:ContinuityPageViewModel)DataContext).OpenRelatedEventCommand}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat='Open related event {0}'}"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{Binding Relation}" Classes="csFaint"/><TextBlock Text="{Binding Name}" /></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding LinkBelow}" FontSize="10" Foreground="{DynamicResource PbAccentTextBrush}"
                                       Margin="100,0,0,2" IsVisible="{Binding HasLink}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>
