<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fi="using:FluentIcons.Avalonia">
    <!--
        App-wide icon defaults (docs/superpowers/specs/2026-08-28-fluenticons-migration-design.md).
        Every icon in the app is a FluentIcons.Avalonia <fi:SymbolIcon Symbol="..."/> - the
        canonical action -> Symbol table is Assets/Icons/icon-mapping.md.

        Colour is deliberately NOT set here: SymbolIcon inherits Foreground from its parent
        (Button / TextBlock), so an icon beside a label matches that label automatically. Set
        Foreground inline only where an icon needs a colour different from its surrounding text.
        Call sites override FontSize where a spot needs a bigger or smaller glyph.
    -->
    <Style Selector="fi|SymbolIcon">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="IconVariant" Value="Regular" />
    </Style>
</Styles>
