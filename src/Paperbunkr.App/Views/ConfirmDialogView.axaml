<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="420"
             xmlns:controls="using:Paperbunkr.App.Controls"
             x:Class="Paperbunkr.App.Views.ConfirmDialogView"
             x:DataType="vm:ConfirmDialogViewModel">

    <UserControl.Styles>
        <!-- Same shape as MainWindow.axaml's discardConfirm button styles - this is the app's
             other existing confirm/cancel pattern; kept local to this view since ConfirmDialogView
             is hosted inside a shared OverlayShell, not inside MainWindow's own Window.Styles scope. -->
        <Style Selector="Button.confirmDialog">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusSm}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Styles>

    <controls:DialogCard Title="{Binding Title}" Size="Small">
        <StackPanel Spacing="12">
            <!-- A Grid, not a horizontal StackPanel: a StackPanel gives the message unlimited width, so it never wrapped. -->
            <Grid ColumnDefinitions="Auto,*">
                <fi:SymbolIcon Symbol="Warning" FontSize="{StaticResource PbIconSizeLg}" Foreground="{DynamicResource PbDangerBrush}"
                               VerticalAlignment="Top" Margin="0,0,8,0" IsVisible="{Binding IsDestructive}" />
                <TextBlock Grid.Column="1" Classes="pbTextBody" Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource PbTextMutedBrush}" />
            </Grid>
            <ScrollViewer MaxHeight="140" IsVisible="{Binding HasItems}">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Classes="pbTextMeta" Text="{Binding}" TextTrimming="CharacterEllipsis" Margin="0,1" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
        <controls:DialogCard.Footer>
            <StackPanel>
                <Button Classes="confirmDialog ghost" Content="{Binding SecondaryLabel}"
                        Command="{Binding SecondaryCommand}" IsVisible="{Binding HasSecondary}" />
                <Button Classes="confirmDialog primary" Classes.destructive="{Binding IsDestructive}"
                        Content="{Binding PrimaryLabel}" Command="{Binding PrimaryCommand}" />
            </StackPanel>
        </controls:DialogCard.Footer>
    </controls:DialogCard>
</UserControl>
