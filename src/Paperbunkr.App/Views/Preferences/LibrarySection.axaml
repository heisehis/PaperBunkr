<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:beh="using:Paperbunkr.App.Behaviors"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:models="using:Paperbunkr.App.Models"
             xmlns:pref="using:Paperbunkr.App.Views.Preferences"
             xmlns:controls="using:Paperbunkr.App.Controls"
             xmlns:views="using:Paperbunkr.App.Views"
             xmlns:svc="using:Paperbunkr.App.Services"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="900"
             x:Class="Paperbunkr.App.Views.Preferences.LibrarySection"
             x:DataType="vm:PreferencesScreenViewModel">

    <UserControl.Styles>
        <!-- Folder management redesign (docs/superpowers/specs/2026-09-07-library-folder-
             management-redesign-design.md) - Folders/Maintenance segmented tab buttons. No
             segmented-control primitive exists elsewhere in the app yet, so this is a small local
             pair of style classes rather than a new shared control. -->
        <Style Selector="Button.segTab">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextFaintBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.segTab.active">
            <Setter Property="Background" Value="{DynamicResource PbSurface3Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Virtual Tags editor redesign (docs/superpowers/specs/2026-09-07-virtual-tags-editor-
             redesign-design.md) - row selection/dimmed-state styling. -->
        <Style Selector="Border.skinRow.vtSelected">
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource PbAccentSoftBrush}" />
        </Style>
        <Style Selector="Border.vtChip">
            <Setter Property="Background" Value="{DynamicResource PbAccentSoftBrush}" />
        </Style>
        <Style Selector="Border.vtChip fi|SymbolIcon">
            <Setter Property="Foreground" Value="{DynamicResource PbAccentTextBrush}" />
        </Style>
        <Style Selector="Border.vtChip.dimmed">
            <Setter Property="Background" Value="{DynamicResource PbSurface3Brush}" />
        </Style>
        <Style Selector="Border.vtChip.dimmed fi|SymbolIcon">
            <Setter Property="Foreground" Value="{DynamicResource PbTextFaintBrush}" />
        </Style>
        <Style Selector="TextBlock.vtName.dimmed">
            <Setter Property="Foreground" Value="{DynamicResource PbTextFaintBrush}" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <DataTemplate x:Key="MissingFileRowTemplate" x:DataType="vm:MissingFileRowViewModel">
            <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <!-- Severity chip (docs/superpowers/specs/2026-09-21-cosmetics-pitch-design.md #5): dot + icon +
                             the text label, so colour is never the only signal. Warning = amber (PbBadge*, same family
                             as the "Currently missing" tile), Error = red (PbDanger*). PbRadiusChip, never an oval. -->
                        <Border IsVisible="{Binding IsWarning}" CornerRadius="{StaticResource PbRadiusChip}" Padding="7,2"
                                Background="{DynamicResource PbBadgeSoftBrush}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource PbBadgeBrush}" VerticalAlignment="Center" />
                                <fi:SymbolIcon Symbol="Warning" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbBadgeBrush}" />
                                <TextBlock Text="{Binding SeverityLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PbBadgeBrush}" />
                            </StackPanel>
                        </Border>
                        <Border IsVisible="{Binding IsError}" CornerRadius="{StaticResource PbRadiusChip}" Padding="7,2"
                                Background="{DynamicResource PbDangerSoftBrush}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource PbDangerBrush}" VerticalAlignment="Center" />
                                <fi:SymbolIcon Symbol="ErrorCircle" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbDangerBrush}" />
                                <TextBlock Text="{Binding SeverityLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PbDangerBrush}" />
                            </StackPanel>
                        </Border>
                        <!-- Dismissed (docs/superpowers/specs/2026-09-28-library-health-dismissed-rows-design.md): neutral outline
                             chip in place of the severity chip - the row is parked, not a live problem. -->
                        <Border IsVisible="{Binding IsDismissed}" CornerRadius="{StaticResource PbRadiusChip}" Padding="7,2"
                                BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource PbTextFaintBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Dismissed" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PbTextFaintBrush}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding DisplayLabel}" FontSize="13" Foreground="{DynamicResource PbTextMutedBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <Button Classes="headerAction ghost" Command="{Binding RestoreCommand}" IsVisible="{Binding IsDismissed}"
                                ToolTip.Tip="Put this back in the list above">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <fi:SymbolIcon Symbol="ArrowUndo" FontSize="{StaticResource PbIconSizeXs}" />
                                <TextBlock Text="Restore" />
                            </StackPanel>
                        </Button>
                        <Button Classes="headerAction ghost" Command="{Binding RelinkCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <fi:SymbolIcon Symbol="Link" FontSize="{StaticResource PbIconSizeXs}" />
                                <TextBlock Text="Relink" />
                            </StackPanel>
                        </Button>
                        <Button Classes="headerAction ghost" Command="{Binding DismissCommand}" IsVisible="{Binding !IsDismissed}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <fi:SymbolIcon Symbol="Dismiss" FontSize="{StaticResource PbIconSizeXs}" />
                                <TextBlock Text="Dismiss" />
                            </StackPanel>
                        </Button>
                        <Button Classes="headerAction ghost" Foreground="{DynamicResource PbDangerBrush}" Command="{Binding DeleteConfirm.TriggerCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <fi:SymbolIcon Symbol="Delete" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbDangerBrush}" />
                                <TextBlock Text="{Binding DeleteConfirm.Label}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Reported pages (docs/superpowers/specs/2026-09-21-comic-reader-page-intelligence-design.md 4) - a page the
             reader flagged as bad. Same row shape as MissingFileRowTemplate: warning chip (the reason) + label + actions. -->
        <DataTemplate x:Key="PageReportRowTemplate" x:DataType="vm:PageReportRowViewModel">
            <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border CornerRadius="{StaticResource PbRadiusChip}" Padding="7,2"
                                Background="{DynamicResource PbBadgeSoftBrush}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource PbBadgeBrush}" VerticalAlignment="Center" />
                                <fi:SymbolIcon Symbol="Flag" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbBadgeBrush}" />
                                <TextBlock Text="{Binding ReasonLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PbBadgeBrush}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding DisplayLabel}" FontSize="13" Foreground="{DynamicResource PbTextMutedBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <Button Classes="headerAction ghost" Command="{Binding OpenCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <fi:SymbolIcon Symbol="Open" FontSize="{StaticResource PbIconSizeXs}" />
                                <TextBlock Text="Open in reader" />
                            </StackPanel>
                        </Button>
                        <Button Classes="headerAction ghost" Command="{Binding TagDeletedCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <fi:SymbolIcon Symbol="Delete" FontSize="{StaticResource PbIconSizeXs}" />
                                <TextBlock Text="Tag as Deleted" />
                            </StackPanel>
                        </Button>
                        <Button Classes="headerAction ghost" Command="{Binding DismissCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <fi:SymbolIcon Symbol="Dismiss" FontSize="{StaticResource PbIconSizeXs}" />
                                <TextBlock Text="Dismiss" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RemovedLibraryEntryRowTemplate" x:DataType="vm:RemovedLibraryEntryRowViewModel">
            <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DisplayLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PbTextBrush}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding FilePath}" FontSize="11" Foreground="{DynamicResource PbTextFaintBrush}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding RemovedWhenLabel, StringFormat='Removed {0}'}" FontSize="11" Foreground="{DynamicResource PbTextFaintBrush}" />
                    <Button Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Classes="headerAction ghost" Command="{Binding RestoreCommand}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <fi:SymbolIcon Symbol="ArrowUndo" FontSize="{StaticResource PbIconSizeXs}" />
                            <TextBlock Text="Restore" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Find Similar Series (docs/superpowers/specs/2026-09-17-series-name-matching-and-empty-
             row-cleanup-design.md) - reuses vm:SeriesConflictRowViewModel; a local template since
             MigrationOverlay.axaml's own ConflictRowTemplate is scoped to that file. -->
        <DataTemplate x:Key="SimilarSeriesRowTemplate" x:DataType="vm:SeriesConflictRowViewModel">
            <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding IncomingName}" FontWeight="SemiBold" Foreground="{DynamicResource PbTextBrush}" FontSize="13" />
                        <TextBlock Text="↔" Foreground="{DynamicResource PbTextFaintBrush}" />
                        <TextBlock Text="{Binding MatchedName}" FontWeight="SemiBold" Foreground="{DynamicResource PbTextBrush}" FontSize="13" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Punctuation-variant match" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" Margin="0,3,0,0" />
                    <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center" IsVisible="{Binding !IsResolved}">
                        <Button Classes="headerAction ghost" Content="Merge" Command="{Binding MergeCommand}" />
                        <Button Classes="headerAction ghost" Content="Keep Separate" Command="{Binding KeepSeparateCommand}" />
                    </StackPanel>
                    <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Text="{Binding ResolutionLabel}"
                               Foreground="{DynamicResource PbAccentTextBrush}" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center" IsVisible="{Binding IsResolved}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Empty Rows: empty series (docs/superpowers/specs/2026-09-17-series-name-matching-and-
             empty-row-cleanup-design.md) - Remove/Dismiss only, no Relink for a series with nothing
             to relink to. -->
        <DataTemplate x:Key="EmptySeriesRowTemplate" x:DataType="vm:EmptySeriesRowViewModel">
            <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <!-- Dismissed (docs/superpowers/specs/2026-09-28-library-health-dismissed-rows-design.md): neutral outline
                             chip in place of the severity chip - the row is parked, not a live problem. -->
                        <Border IsVisible="{Binding IsDismissed}" CornerRadius="{StaticResource PbRadiusChip}" Padding="7,2"
                                BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource PbTextFaintBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Dismissed" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PbTextFaintBrush}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding DisplayLabel}" FontSize="13" Foreground="{DynamicResource PbTextMutedBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <Button Classes="headerAction ghost" Command="{Binding RestoreCommand}" IsVisible="{Binding IsDismissed}"
                                ToolTip.Tip="Put this back in the list above">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <fi:SymbolIcon Symbol="ArrowUndo" FontSize="{StaticResource PbIconSizeXs}" />
                                <TextBlock Text="Restore" />
                            </StackPanel>
                        </Button>
                        <Button Classes="headerAction ghost" Command="{Binding DismissCommand}" IsVisible="{Binding !IsDismissed}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <fi:SymbolIcon Symbol="Dismiss" FontSize="{StaticResource PbIconSizeXs}" />
                                <TextBlock Text="Dismiss" />
                            </StackPanel>
                        </Button>
                        <Button Classes="headerAction ghost" Foreground="{DynamicResource PbDangerBrush}" Command="{Binding DeleteConfirm.TriggerCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <fi:SymbolIcon Symbol="Delete" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbDangerBrush}" />
                                <TextBlock Text="{Binding DeleteConfirm.Label}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ===== Review queues (docs/superpowers/specs/2026-09-25-needs-review-into-library-health-design.md) =====
             Moved here from MigrationOverlay.axaml's old "Needs Review" tab. Buttons use the same headerAction
             classes as every other Library Health row instead of the overlay's rowAction/pillAction. ===== -->

        <!-- Series Conflicts: a stored SeriesConflict row (Merge / Keep Separate). -->
        <DataTemplate x:Key="SeriesConflictRowTemplate" x:DataType="vm:SeriesConflictRowViewModel">
            <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding IncomingName}" FontWeight="SemiBold" Foreground="{DynamicResource PbTextBrush}" FontSize="13" />
                        <TextBlock Text="↔" Foreground="{DynamicResource PbTextFaintBrush}" />
                        <TextBlock Text="{Binding MatchedName}" FontWeight="SemiBold" Foreground="{DynamicResource PbTextBrush}" FontSize="13" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding SimilarityLabel}" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" Margin="0,3,0,0" />
                    <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center" IsVisible="{Binding !IsResolved}">
                        <Button Classes="headerAction primary" Content="Merge" Command="{Binding MergeCommand}" />
                        <Button Classes="headerAction ghost" Content="Keep Separate" Command="{Binding KeepSeparateCommand}" />
                    </StackPanel>
                    <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Text="{Binding ResolutionLabel}"
                               Foreground="{DynamicResource PbAccentTextBrush}" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center" IsVisible="{Binding IsResolved}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Content Type: a series whose content type is still Unknown - opens its Detail screen. -->
        <DataTemplate x:Key="ContentTypeReviewRowTemplate" x:DataType="models:SeriesReviewItem">
            <Button Classes="sideItemButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Command="{Binding $parent[ItemsControl].((vm:PreferencesScreenViewModel)DataContext).NeedsReview.OpenSeriesDetailCommand}"
                    CommandParameter="{Binding}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding SeriesName}" FontSize="13" Foreground="{DynamicResource PbTextMutedBrush}" />
                    <TextBlock Grid.Column="1" Text="Unknown" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" />
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="DuplicateGroupRowTemplate" x:DataType="vm:DuplicateGroupRowViewModel">
            <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding GroupLabel}" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button Classes="headerAction ghost" Content="Compare" Command="{Binding CompareCommand}" IsVisible="{Binding CanCompare}"
                                    ToolTip.Tip="Look at the copies side by side, page by page, to pick the better scan." />
                            <Button Classes="headerAction ghost" Content="Dismiss" Command="{Binding DismissCommand}" />
                            <Button Classes="headerAction ghost" Content="Remove extras, keep files" Command="{Binding ResolveKeepFilesCommand}"
                                    IsVisible="{Binding CanResolveKeepFiles}"
                                    ToolTip.Tip="Removes the entries you did not pick from the library. Every file stays where it is and is not re-imported." />
                            <Button Classes="headerAction ghost" Foreground="{DynamicResource PbDangerBrush}" Content="Resolve (delete extra files)" Command="{Binding ResolveCommand}" />
                        </StackPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Candidates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DuplicateCandidateViewModel">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,4,0,0">
                                    <RadioButton Grid.Column="0" GroupName="{Binding GroupKey}" IsChecked="{Binding IsKeep}" VerticalAlignment="Center"
                                                 AutomationProperties.Name="{Binding FileName, StringFormat='Keep {0}'}" />
                                    <Border Grid.Column="1" Width="28" Height="38" Margin="6,0" CornerRadius="3" ClipToBounds="True"
                                            Background="{DynamicResource PbSurface3Brush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1">
                                        <Image views:AsyncCoverImage.SourceId="{Binding IssueId}" Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding FileName}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource PbTextBrush}" IsVisible="{Binding IsKeep}" />
                                    <TextBlock Grid.Column="2" Text="{Binding FileName}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource PbTextMutedBrush}" IsVisible="{Binding !IsKeep}" />
                                    <TextBlock Grid.Column="3" Text="{Binding SizeLabel}" FontSize="11.5" Foreground="{DynamicResource PbTextMutedBrush}"
                                               VerticalAlignment="Center" Margin="10,0,0,0" />
                                    <TextBlock Grid.Column="4" Text="{Binding DateLabel}" FontSize="11" Foreground="{DynamicResource PbTextFaintBrush}"
                                               VerticalAlignment="Center" Margin="10,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MetadataProposalRowTemplate" x:DataType="vm:MetadataProposalRowViewModel">
            <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding IssueLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PbTextBrush}" FontSize="13" />
                        <TextBlock Text="·" Foreground="{DynamicResource PbTextFaintBrush}" />
                        <TextBlock Text="{Binding FieldLabel}" FontSize="13" Foreground="{DynamicResource PbTextMutedBrush}" />
                        <TextBlock Text="(already applied)" FontSize="11" FontStyle="Italic" Foreground="{DynamicResource PbTextFaintBrush}"
                                   IsVisible="{Binding IsAlreadyAccepted}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="6" Margin="0,3,0,0">
                        <TextBlock Text="{Binding CurrentValue}" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" />
                        <TextBlock Text="→" Foreground="{DynamicResource PbTextFaintBrush}" />
                        <TextBlock Text="{Binding ProposedValue}" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" />
                        <TextBlock Text="{Binding SourceLabel}" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" Margin="6,0,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center" IsVisible="{Binding !IsResolved}">
                        <Button Classes="headerAction primary" Content="Accept" Command="{Binding AcceptCommand}" />
                        <Button Classes="headerAction ghost" Content="Reject" Command="{Binding RejectCommand}" />
                    </StackPanel>
                    <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Text="{Binding ResolutionLabel}"
                               Foreground="{DynamicResource PbAccentTextBrush}" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center" IsVisible="{Binding IsResolved}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Metadata Proposal buckets (Pending and Applied share this): one per field + source (docs/superpowers/specs/2026-09-26-library-health-subtabs-design.md).
             Rows are only loaded when the bucket is expanded and are shown in a VirtualList - Accept All / Reject All cover the whole bucket. -->
        <DataTemplate x:Key="ProposalGroupTemplate" x:DataType="vm:ProposalGroupViewModel">
            <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Button Grid.Column="0" Classes="sideItemButton" Command="{Binding ToggleExpandedCommand}"
                                HorizontalContentAlignment="Stretch" Padding="0">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <fi:SymbolIcon Symbol="ChevronUp" IsVisible="{Binding IsExpanded}" FontSize="{StaticResource PbIconSizeXs}" />
                                <fi:SymbolIcon Symbol="ChevronDown" IsVisible="{Binding !IsExpanded}" FontSize="{StaticResource PbIconSizeXs}" />
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CountLabel}" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button Classes="headerAction primary" Content="{Binding AcceptAllConfirm.Label}" Command="{Binding AcceptAllConfirm.TriggerCommand}" IsVisible="{Binding IsPending}" />
                            <Button Classes="headerAction ghost" Content="Accept All" Command="{Binding AcceptAllCommand}" IsVisible="{Binding !IsPending}" />
                            <Button Classes="headerAction ghost" Foreground="{DynamicResource PbDangerBrush}"
                                    Content="{Binding RejectAllConfirm.Label}" Command="{Binding RejectAllConfirm.TriggerCommand}" />
                        </StackPanel>
                    </Grid>
                    <controls:VirtualList ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource MetadataProposalRowTemplate}" IsVisible="{Binding IsExpanded}" />
                    <TextBlock Text="{Binding HiddenRowsLabel}" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" TextWrapping="Wrap"
                               IsVisible="{Binding HasHiddenRows}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Advertisement pages (docs/superpowers/specs/2026-09-21-comic-reader-page-intelligence-design.md 5) - one group
             per matched ad: its thumbnail, the match count, Accept all / Reject all, and the single pages under a toggle. -->
        <DataTemplate x:Key="AdPageGroupRowTemplate" x:DataType="vm:AdPageGroupRowViewModel">
            <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0" Width="60" Height="84" CornerRadius="3" ClipToBounds="True" Margin="0,0,12,0"
                                Background="{DynamicResource PbSurface3Brush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1">
                            <Grid>
                                <fi:SymbolIcon Symbol="Image" FontSize="{StaticResource PbIconSizeSm}" Foreground="{DynamicResource PbTextFaintBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" AutomationProperties.Name="The matched advertisement" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CountLabel}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                            <TextBlock Text="{Binding SourceLabel, StringFormat='Ad from {0}'}" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Classes="headerAction ghost" Content="Reject all" Command="{Binding RejectAllCommand}" />
                            <Button Classes="headerAction primary" Content="Accept all" Command="{Binding AcceptAllCommand}" />
                        </StackPanel>
                    </Grid>
                    <Button Classes="headerAction ghost" HorizontalAlignment="Left" Command="{Binding ToggleExpandedCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <fi:SymbolIcon Symbol="ChevronDown" FontSize="{StaticResource PbIconSizeXs}" IsVisible="{Binding !IsExpanded}" />
                            <fi:SymbolIcon Symbol="ChevronUp" FontSize="{StaticResource PbIconSizeXs}" IsVisible="{Binding IsExpanded}" />
                            <TextBlock Text="Review pages one by one" />
                        </StackPanel>
                    </Button>
                    <ItemsControl ItemsSource="{Binding Pages}" IsVisible="{Binding IsExpanded}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AdPageProposalRowViewModel">
                                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,0">
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource PbTextMutedBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding MatchLabel}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"
                                               Foreground="{DynamicResource PbTextFaintBrush}" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                        <Button Classes="headerAction ghost" Content="Reject" Command="{Binding RejectCommand}" />
                                        <Button Classes="headerAction ghost" Content="Accept" Command="{Binding AcceptCommand}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Margin="28,20,28,40" Spacing="20">
            <TextBlock Classes="pbTextHeading" Text="Library" />

            <!-- Library Health (docs/superpowers/specs/2026-09-26-library-health-subtabs-design.md): Overview / Review / Files sub-tabs.
                 Every section is a one-line header that opens its list; lists are VirtualLists (only the rows in view are built) and a
                 hidden tab or closed section is never measured, so it builds nothing. -->
            <Border Classes="groupBox" Tag="library.health">
                <StackPanel>
                    <Border Classes="groupHeader">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Library Health" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                                <TextBlock Text="Keep your library clean: missing files, duplicates, conflicts and things to review" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <!-- Needs-review count (docs/superpowers/specs/2026-09-25-needs-review-into-library-health-design.md):
                                 the sum of every review queue below. PbRadiusChip squircle, never an oval; text label so colour is not the only signal. -->
                            <Border Grid.Column="1" IsVisible="{Binding NeedsReview.HasPendingItems}" VerticalAlignment="Center"
                                    CornerRadius="{StaticResource PbRadiusChip}" Padding="8,3" Background="{DynamicResource PbAccentSoftBrush}"
                                    AutomationProperties.AutomationId="LibraryHealthNeedsReviewChip">
                                <TextBlock Text="{Binding NeedsReview.PendingCountLabel, StringFormat='Needs review · {0}'}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PbAccentTextBrush}" />
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="14,10,14,0">
                        <Button Classes="segTab" Classes.active="{Binding IsLibraryHealthOverviewTab}" Content="Overview"
                                Command="{Binding ShowLibraryHealthOverviewTabCommand}" AutomationProperties.AutomationId="LibraryHealthTabOverview" />
                        <Button Classes="segTab" Classes.active="{Binding IsLibraryHealthReviewTab}"
                                Command="{Binding ShowLibraryHealthReviewTabCommand}" AutomationProperties.AutomationId="LibraryHealthTabReview">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Review" />
                                <Border CornerRadius="{StaticResource PbRadiusChip}" Padding="6,1" Background="{DynamicResource PbAccentSoftBrush}" IsVisible="{Binding NeedsReview.HasPendingItems}">
                                    <TextBlock Text="{Binding NeedsReview.PendingCountLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource PbAccentTextBrush}" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Classes="segTab" Classes.active="{Binding IsLibraryHealthFilesTab}"
                                Command="{Binding ShowLibraryHealthFilesTabCommand}" AutomationProperties.AutomationId="LibraryHealthTabFiles">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Files" />
                                <Border CornerRadius="{StaticResource PbRadiusChip}" Padding="6,1" Background="{DynamicResource PbBadgeSoftBrush}" IsVisible="{Binding HasMissingFileItems}">
                                    <TextBlock Text="{Binding MissingFileItems.Count}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource PbBadgeBrush}" />
                                </Border>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Overview -->
                    <StackPanel Margin="14" Spacing="12">
                        <Grid ColumnDefinitions="*,*,*,*">
                            <Border Grid.Column="0" Background="{DynamicResource PbSurface2Brush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,6,0">
                                <StackPanel Spacing="8">
                                    <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource PbAccentSoftBrush}" HorizontalAlignment="Left">
                                        <fi:SymbolIcon Symbol="List" FontSize="{StaticResource PbIconSizeSm}" Foreground="{DynamicResource PbAccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding LibraryHealthChecked}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PbTextBrush}" />
                                    <TextBlock Text="Issues checked" FontSize="10.5" Foreground="{DynamicResource PbTextMutedBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{DynamicResource PbSurface2Brush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="6,0,6,0">
                                <StackPanel Spacing="8">
                                    <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource PbBadgeSoftBrush}" HorizontalAlignment="Left">
                                        <fi:SymbolIcon Symbol="Warning" FontSize="{StaticResource PbIconSizeSm}" Foreground="{DynamicResource PbBadgeBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding LibraryHealthMissingNow}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PbTextBrush}" />
                                    <TextBlock Text="Currently missing" FontSize="10.5" Foreground="{DynamicResource PbTextMutedBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{DynamicResource PbSurface2Brush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="6,0,6,0">
                                <StackPanel Spacing="8">
                                    <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource PbDangerSoftBrush}" HorizontalAlignment="Left">
                                        <fi:SymbolIcon Symbol="Warning" FontSize="{StaticResource PbIconSizeSm}" Foreground="{DynamicResource PbDangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding LibraryHealthConfirmedMissing}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PbDangerBrush}" />
                                    <TextBlock Text="Confirmed missing" FontSize="10.5" Foreground="{DynamicResource PbTextMutedBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Background="{DynamicResource PbSurface2Brush}" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="6,0,0,0">
                                <StackPanel Spacing="8">
                                    <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource PbSuccessSoftBrush}" HorizontalAlignment="Left">
                                        <fi:SymbolIcon Symbol="Clock" FontSize="{StaticResource PbIconSizeSm}" Foreground="{DynamicResource PbSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding LibraryHealthLastVerifiedLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PbTextBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="Last verified" FontSize="10.5" Foreground="{DynamicResource PbTextMutedBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Classes="headerAction primary" Command="{Binding VerifyLibraryHealthNowCommand}" IsEnabled="{Binding !IsVerifyingLibraryHealth}"
                                    AutomationProperties.AutomationId="LibraryHealthVerifyNowButton">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <fi:SymbolIcon Symbol="ArrowClockwise" Foreground="{DynamicResource PbBadgeTextBrush}" />
                                    <TextBlock Text="Verify Now" />
                                </StackPanel>
                            </Button>
                            <Button Classes="headerAction ghost" Foreground="{DynamicResource PbDangerBrush}" BorderBrush="{DynamicResource PbDangerSoftBrush}"
                                    Command="{Binding OpenBulkRemoveConfirmCommand}" IsEnabled="{Binding HasConfirmedMissingItems}"
                                    AutomationProperties.AutomationId="LibraryHealthRemoveAllConfirmedButton">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <fi:SymbolIcon Symbol="Delete" Foreground="{DynamicResource PbDangerBrush}" />
                                    <TextBlock Text="Remove All Confirmed Missing" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <controls:BusyIndicator Job="{Binding CurrentLibraryHealthJob}" IsVisible="{Binding IsVerifyingLibraryHealth}" />

                        <pref:SettingsRow Icon="Warning" Title="Confirm missing after this many checks"
                                           Description="How many consecutive Verify passes a file must be missing for before it's eligible for Remove All Confirmed Missing or unattended auto-remove during Scan.">
                            <pref:SettingsRow.SettingsContent>
                                <TextBox Text="{Binding LibraryHealthConfirmedMissingThreshold}" beh:TextSpinner.Enabled="True" beh:TextSpinner.ClampTyped="True" beh:TextSpinner.Minimum="1" beh:TextSpinner.Maximum="5" Width="120"
                                               AutomationProperties.AutomationId="LibraryHealthConfirmedMissingThresholdInput" />
                            </pref:SettingsRow.SettingsContent>
                        </pref:SettingsRow>
                    

                        <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Needs attention" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource PbTextBrush}" Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !NeedsReview.HasPendingItems}">
                                    <fi:SymbolIcon Symbol="Checkmark" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbSuccessBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Nothing needs a decision right now" FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                        <Button Classes="sideItemButton" HorizontalContentAlignment="Stretch" Padding="0,6" IsVisible="{Binding NeedsReview.HasDuplicateFileItems}"
                                Command="{Binding ReviewLibraryHealthSectionCommand}" CommandParameter="{Binding LibraryHealthSections.Duplicates}"
                                AutomationProperties.AutomationId="LibraryHealthAttentionDuplicates">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBlock Grid.Column="0" Text="Duplicate Files" FontSize="12.5" Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" CornerRadius="{StaticResource PbRadiusChip}" Padding="8,2" Margin="0,0,10,0" Background="{DynamicResource PbAccentSoftBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding NeedsReview.DuplicateCountLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PbAccentTextBrush}" />
                                </Border>
                                <TextBlock Grid.Column="2" Text="Review →" FontSize="11.5" Foreground="{DynamicResource PbAccentTextBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button Classes="sideItemButton" HorizontalContentAlignment="Stretch" Padding="0,6" IsVisible="{Binding NeedsReview.HasSeriesConflictItems}"
                                Command="{Binding ReviewLibraryHealthSectionCommand}" CommandParameter="{Binding LibraryHealthSections.SeriesConflicts}"
                                AutomationProperties.AutomationId="LibraryHealthAttentionSeriesConflicts">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBlock Grid.Column="0" Text="Series Conflicts" FontSize="12.5" Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" CornerRadius="{StaticResource PbRadiusChip}" Padding="8,2" Margin="0,0,10,0" Background="{DynamicResource PbAccentSoftBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding NeedsReview.ConflictCountLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PbAccentTextBrush}" />
                                </Border>
                                <TextBlock Grid.Column="2" Text="Review →" FontSize="11.5" Foreground="{DynamicResource PbAccentTextBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button Classes="sideItemButton" HorizontalContentAlignment="Stretch" Padding="0,6" IsVisible="{Binding NeedsReview.HasContentTypeItems}"
                                Command="{Binding ReviewLibraryHealthSectionCommand}" CommandParameter="{Binding LibraryHealthSections.ContentType}"
                                AutomationProperties.AutomationId="LibraryHealthAttentionContentType">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBlock Grid.Column="0" Text="Content Type" FontSize="12.5" Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" CornerRadius="{StaticResource PbRadiusChip}" Padding="8,2" Margin="0,0,10,0" Background="{DynamicResource PbAccentSoftBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding NeedsReview.ContentTypeCountLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PbAccentTextBrush}" />
                                </Border>
                                <TextBlock Grid.Column="2" Text="Review →" FontSize="11.5" Foreground="{DynamicResource PbAccentTextBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button Classes="sideItemButton" HorizontalContentAlignment="Stretch" Padding="0,6" IsVisible="{Binding NeedsReview.HasPendingProposalItems}"
                                Command="{Binding ReviewLibraryHealthSectionCommand}" CommandParameter="{Binding LibraryHealthSections.Proposals}"
                                AutomationProperties.AutomationId="LibraryHealthAttentionProposals">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBlock Grid.Column="0" Text="Metadata Proposals" FontSize="12.5" Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" CornerRadius="{StaticResource PbRadiusChip}" Padding="8,2" Margin="0,0,10,0" Background="{DynamicResource PbAccentSoftBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding NeedsReview.PendingProposalCountLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PbAccentTextBrush}" />
                                </Border>
                                <TextBlock Grid.Column="2" Text="Review →" FontSize="11.5" Foreground="{DynamicResource PbAccentTextBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button Classes="sideItemButton" HorizontalContentAlignment="Stretch" Padding="0,6" IsVisible="{Binding NeedsReview.HasAdPageItems}"
                                Command="{Binding ReviewLibraryHealthSectionCommand}" CommandParameter="{Binding LibraryHealthSections.AdPages}"
                                AutomationProperties.AutomationId="LibraryHealthAttentionAdPages">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBlock Grid.Column="0" Text="Advertisement Pages" FontSize="12.5" Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" CornerRadius="{StaticResource PbRadiusChip}" Padding="8,2" Margin="0,0,10,0" Background="{DynamicResource PbAccentSoftBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding NeedsReview.AdPageCountLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PbAccentTextBrush}" />
                                </Border>
                                <TextBlock Grid.Column="2" Text="Review →" FontSize="11.5" Foreground="{DynamicResource PbAccentTextBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button Classes="sideItemButton" HorizontalContentAlignment="Stretch" Padding="0,6" IsVisible="{Binding HasPageReportItems}"
                                Command="{Binding ReviewLibraryHealthSectionCommand}" CommandParameter="{Binding LibraryHealthSections.ReportedPages}"
                                AutomationProperties.AutomationId="LibraryHealthAttentionReportedPages">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBlock Grid.Column="0" Text="Reported pages" FontSize="12.5" Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" CornerRadius="{StaticResource PbRadiusChip}" Padding="8,2" Margin="0,0,10,0" Background="{DynamicResource PbAccentSoftBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PageReportItems.Count}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PbAccentTextBrush}" />
                                </Border>
                                <TextBlock Grid.Column="2" Text="Review →" FontSize="11.5" Foreground="{DynamicResource PbAccentTextBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Review: queues that need a decision -->
                    <StackPanel Margin="14,10,14,14" IsVisible="{Binding IsLibraryHealthReviewTab}">
                        <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,4" Tag="library.healthDuplicates">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Button Grid.Column="0" Classes="sideItemButton" HorizontalContentAlignment="Stretch" Padding="0"
                                            Command="{Binding LibraryHealthSections.Duplicates.ToggleCommand}" IsHitTestVisible="{Binding NeedsReview.HasDuplicateFileItems}"
                                            AutomationProperties.AutomationId="LibraryHealthToggleDuplicates">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <fi:SymbolIcon Symbol="Checkmark" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbSuccessBrush}" VerticalAlignment="Center">
                                <fi:SymbolIcon.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="!NeedsReview.HasDuplicateFileItems" /><Binding Path="!NeedsReview.AreCountsLoading" /></MultiBinding></fi:SymbolIcon.IsVisible>
                            </fi:SymbolIcon>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsVisible="{Binding NeedsReview.HasDuplicateFileItems}">
                                                <fi:SymbolIcon Symbol="ChevronUp" IsVisible="{Binding LibraryHealthSections.Duplicates.IsOpen}" FontSize="{StaticResource PbIconSizeXs}" />
                                                <fi:SymbolIcon Symbol="ChevronDown" IsVisible="{Binding !LibraryHealthSections.Duplicates.IsOpen}" FontSize="{StaticResource PbIconSizeXs}" />
                                            </StackPanel>
                                            <TextBlock Text="Duplicate Files" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding NeedsReview.DuplicateCountLabel, StringFormat='· {0}'}" FontSize="11.5" Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" IsVisible="{Binding NeedsReview.HasDuplicateFileItems}" />
                                            <TextBlock Text="· No duplicates" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" VerticalAlignment="Center">
                                <TextBlock.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="!NeedsReview.HasDuplicateFileItems" /><Binding Path="!NeedsReview.AreCountsLoading" /></MultiBinding></TextBlock.IsVisible>
                            </TextBlock>
                                            <TextBlock Text="…" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" VerticalAlignment="Center" IsVisible="{Binding NeedsReview.AreCountsLoading}" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding NeedsReview.HasDuplicateFileItems}">
                                        <Button Classes="headerAction ghost" Content="Dismiss All" Command="{Binding NeedsReview.DismissAllDuplicateGroupsCommand}" AutomationProperties.AutomationId="LibraryHealthDismissAllDuplicatesButton" />
                                        <Button Classes="headerAction ghost" Content="Keep Largest in All" Command="{Binding NeedsReview.KeepLargestInAllGroupsCommand}" Foreground="{DynamicResource PbDangerBrush}" AutomationProperties.AutomationId="LibraryHealthKeepLargestButton" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Spacing="8" IsVisible="{Binding LibraryHealthSections.Duplicates.IsOpen}">
                                    <Button Classes="headerAction ghost" Content="Merge entries that share one file" Command="{Binding NeedsReview.MergeSamePathEntriesCommand}" HorizontalAlignment="Left" ToolTip.Tip="Folds library entries that point at the very same file into one. No files are touched - run this first." AutomationProperties.AutomationId="LibraryHealthMergeSamePathButton" />
                                    <TextBlock Text="{Binding NeedsReview.DuplicateStatusMessage}" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource PbTextMutedBrush}" IsVisible="{Binding NeedsReview.HasDuplicateStatusMessage}" />
                                    <controls:VirtualList ItemsSource="{Binding NeedsReview.DuplicateGroupItems}" ItemTemplate="{StaticResource DuplicateGroupRowTemplate}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,4" Tag="library.healthSeriesConflicts">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Button Grid.Column="0" Classes="sideItemButton" HorizontalContentAlignment="Stretch" Padding="0"
                                            Command="{Binding LibraryHealthSections.SeriesConflicts.ToggleCommand}" IsHitTestVisible="{Binding NeedsReview.HasSeriesConflictItems}"
                                            AutomationProperties.AutomationId="LibraryHealthToggleSeriesConflicts">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <fi:SymbolIcon Symbol="Checkmark" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbSuccessBrush}" VerticalAlignment="Center">
                                <fi:SymbolIcon.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="!NeedsReview.HasSeriesConflictItems" /><Binding Path="!NeedsReview.AreCountsLoading" /></MultiBinding></fi:SymbolIcon.IsVisible>
                            </fi:SymbolIcon>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsVisible="{Binding NeedsReview.HasSeriesConflictItems}">
                                                <fi:SymbolIcon Symbol="ChevronUp" IsVisible="{Binding LibraryHealthSections.SeriesConflicts.IsOpen}" FontSize="{StaticResource PbIconSizeXs}" />
                                                <fi:SymbolIcon Symbol="ChevronDown" IsVisible="{Binding !LibraryHealthSections.SeriesConflicts.IsOpen}" FontSize="{StaticResource PbIconSizeXs}" />
                                            </StackPanel>
                                            <TextBlock Text="Series Conflicts" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding NeedsReview.ConflictCountLabel, StringFormat='· {0}'}" FontSize="11.5" Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" IsVisible="{Binding NeedsReview.HasSeriesConflictItems}" />
                                            <TextBlock Text="· No conflicts" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" VerticalAlignment="Center">
                                <TextBlock.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="!NeedsReview.HasSeriesConflictItems" /><Binding Path="!NeedsReview.AreCountsLoading" /></MultiBinding></TextBlock.IsVisible>
                            </TextBlock>
                                            <TextBlock Text="…" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" VerticalAlignment="Center" IsVisible="{Binding NeedsReview.AreCountsLoading}" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding NeedsReview.HasSeriesConflictItems}">
                                        <Button Classes="headerAction ghost" Content="Keep All Separate" Command="{Binding NeedsReview.KeepAllSeparateCommand}" AutomationProperties.AutomationId="LibraryHealthKeepAllSeparateButton" />
                                        <Button Classes="headerAction ghost" Content="Merge All Above 90%" Command="{Binding NeedsReview.MergeAllAboveNinetyCommand}" AutomationProperties.AutomationId="LibraryHealthMergeAllAboveNinetyButton" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Spacing="8" IsVisible="{Binding LibraryHealthSections.SeriesConflicts.IsOpen}">
                                    <controls:VirtualList ItemsSource="{Binding NeedsReview.SeriesConflicts}" ItemTemplate="{StaticResource SeriesConflictRowTemplate}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,4" Tag="library.healthContentType">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Button Grid.Column="0" Classes="sideItemButton" HorizontalContentAlignment="Stretch" Padding="0"
                                            Command="{Binding LibraryHealthSections.ContentType.ToggleCommand}" IsHitTestVisible="{Binding NeedsReview.HasContentTypeItems}"
                                            AutomationProperties.AutomationId="LibraryHealthToggleContentType">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <fi:SymbolIcon Symbol="Checkmark" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbSuccessBrush}" VerticalAlignment="Center">
                                <fi:SymbolIcon.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="!NeedsReview.HasContentTypeItems" /><Binding Path="!NeedsReview.AreCountsLoading" /></MultiBinding></fi:SymbolIcon.IsVisible>
                            </fi:SymbolIcon>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsVisible="{Binding NeedsReview.HasContentTypeItems}">
                                                <fi:SymbolIcon Symbol="ChevronUp" IsVisible="{Binding LibraryHealthSections.ContentType.IsOpen}" FontSize="{StaticResource PbIconSizeXs}" />
                                                <fi:SymbolIcon Symbol="ChevronDown" IsVisible="{Binding !LibraryHealthSections.ContentType.IsOpen}" FontSize="{StaticResource PbIconSizeXs}" />
                                            </StackPanel>
                                            <TextBlock Text="Content Type" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding NeedsReview.ContentTypeCountLabel, StringFormat='· {0}'}" FontSize="11.5" Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" IsVisible="{Binding NeedsReview.HasContentTypeItems}" />
                                            <TextBlock Text="· Nothing unknown" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" VerticalAlignment="Center">
                                <TextBlock.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="!NeedsReview.HasContentTypeItems" /><Binding Path="!NeedsReview.AreCountsLoading" /></MultiBinding></TextBlock.IsVisible>
                            </TextBlock>
                                            <TextBlock Text="…" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" VerticalAlignment="Center" IsVisible="{Binding NeedsReview.AreCountsLoading}" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding NeedsReview.HasContentTypeItems}">
                                        
                                    </StackPanel>
                                </Grid>
                                <StackPanel Spacing="8" IsVisible="{Binding LibraryHealthSections.ContentType.IsOpen}">
                                    <TextBlock Text="Series whose content type (comic, manga, …) couldn't be worked out. Open one to set it." FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" TextWrapping="Wrap" />
                                    <controls:VirtualList ItemsSource="{Binding NeedsReview.ContentTypeItems}" ItemTemplate="{StaticResource ContentTypeReviewRowTemplate}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,4" Tag="library.healthProposals">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Button Grid.Column="0" Classes="sideItemButton" HorizontalContentAlignment="Stretch" Padding="0"
                                            Command="{Binding LibraryHealthSections.Proposals.ToggleCommand}" IsHitTestVisible="{Binding NeedsReview.HasAnyProposalItems}"
                                            AutomationProperties.AutomationId="LibraryHealthToggleProposals">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <fi:SymbolIcon Symbol="Checkmark" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbSuccessBrush}" VerticalAlignment="Center">
                                <fi:SymbolIcon.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="!NeedsReview.HasAnyProposalItems" /><Binding Path="!NeedsReview.AreCountsLoading" /></MultiBinding></fi:SymbolIcon.IsVisible>
                            </fi:SymbolIcon>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsVisible="{Binding NeedsReview.HasAnyProposalItems}">
                                                <fi:SymbolIcon Symbol="ChevronUp" IsVisible="{Binding LibraryHealthSections.Proposals.IsOpen}" FontSize="{StaticResource PbIconSizeXs}" />
                                                <fi:SymbolIcon Symbol="ChevronDown" IsVisible="{Binding !LibraryHealthSections.Proposals.IsOpen}" FontSize="{StaticResource PbIconSizeXs}" />
                                            </StackPanel>
                                            <TextBlock Text="Metadata Proposals" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding NeedsReview.ProposalSummaryLabel, StringFormat='· {0}'}" FontSize="11.5" Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" IsVisible="{Binding NeedsReview.HasAnyProposalItems}" />
                                            <TextBlock Text="· Nothing to review" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" VerticalAlignment="Center">
                                <TextBlock.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="!NeedsReview.HasAnyProposalItems" /><Binding Path="!NeedsReview.AreCountsLoading" /></MultiBinding></TextBlock.IsVisible>
                            </TextBlock>
                                            <TextBlock Text="…" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" VerticalAlignment="Center" IsVisible="{Binding NeedsReview.AreCountsLoading}" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding NeedsReview.HasAnyProposalItems}">
                                        
                                    </StackPanel>
                                </Grid>
                                <StackPanel Spacing="8" IsVisible="{Binding LibraryHealthSections.Proposals.IsOpen}">
                                    <StackPanel Spacing="8" IsVisible="{Binding NeedsReview.HasPendingProposalItems}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding NeedsReview.PendingProposalCountLabel, StringFormat='Pending · {0}'}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                <Button Classes="headerAction primary" Content="{Binding NeedsReview.AcceptAllProposalsConfirm.Label}" Command="{Binding NeedsReview.AcceptAllProposalsConfirm.TriggerCommand}" AutomationProperties.AutomationId="LibraryHealthAcceptAllProposalsButton" />
                                                <Button Classes="headerAction ghost" Content="{Binding NeedsReview.RejectAllProposalsConfirm.Label}" Command="{Binding NeedsReview.RejectAllProposalsConfirm.TriggerCommand}" AutomationProperties.AutomationId="LibraryHealthRejectAllProposalsButton" />
                                            </StackPanel>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding NeedsReview.PendingProposalGroups}" ItemTemplate="{StaticResource ProposalGroupTemplate}" />
                                    </StackPanel>
                                    <StackPanel Spacing="8" IsVisible="{Binding NeedsReview.HasAppliedProposalItems}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Button Grid.Column="0" Classes="sideItemButton" Command="{Binding NeedsReview.ToggleAppliedProposalsExpandedCommand}"
                                                    HorizontalContentAlignment="Stretch" Padding="0" AutomationProperties.AutomationId="LibraryHealthAppliedProposalsToggle">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <fi:SymbolIcon Symbol="ChevronUp" IsVisible="{Binding NeedsReview.IsAppliedProposalsExpanded}" FontSize="{StaticResource PbIconSizeXs}" />
                                                    <fi:SymbolIcon Symbol="ChevronDown" IsVisible="{Binding !NeedsReview.IsAppliedProposalsExpanded}" FontSize="{StaticResource PbIconSizeXs}" />
                                                    <TextBlock FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center"
                                                               Text="{Binding NeedsReview.AppliedProposalCountLabel, StringFormat='Applied automatically · {0}'}" />
                                                </StackPanel>
                                            </Button>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                <Button Classes="headerAction ghost" Content="Accept All" Command="{Binding NeedsReview.AcceptAllAppliedCommand}"
                                                        ToolTip.Tip="Keep every applied proposal and clear them from this list" AutomationProperties.AutomationId="LibraryHealthAcceptAllAppliedButton" />
                                                <Button Classes="headerAction ghost" Foreground="{DynamicResource PbDangerBrush}"
                                                        Content="{Binding NeedsReview.RejectAllAppliedConfirm.Label}" Command="{Binding NeedsReview.RejectAllAppliedConfirm.TriggerCommand}"
                                                        ToolTip.Tip="Discard every applied proposal, restoring the earlier value where one was written" AutomationProperties.AutomationId="LibraryHealthRejectAllAppliedButton" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="Filled in automatically from filenames and linked providers. Accept keeps them and clears them from this list; Reject discards them."
                                                   FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" TextWrapping="Wrap" IsVisible="{Binding NeedsReview.IsAppliedProposalsExpanded}" />
                                        <ItemsControl ItemsSource="{Binding NeedsReview.AppliedProposalGroups}" ItemTemplate="{StaticResource ProposalGroupTemplate}"
                                                      IsVisible="{Binding NeedsReview.IsAppliedProposalsExpanded}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,4" Tag="library.healthAdPages">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Button Grid.Column="0" Classes="sideItemButton" HorizontalContentAlignment="Stretch" Padding="0"
                                            Command="{Binding LibraryHealthSections.AdPages.ToggleCommand}" IsHitTestVisible="{Binding NeedsReview.HasAdPageItems}"
                                            AutomationProperties.AutomationId="LibraryHealthToggleAdPages">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <fi:SymbolIcon Symbol="Checkmark" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbSuccessBrush}" VerticalAlignment="Center">
                                <fi:SymbolIcon.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="!NeedsReview.HasAdPageItems" /><Binding Path="!NeedsReview.AreCountsLoading" /></MultiBinding></fi:SymbolIcon.IsVisible>
                            </fi:SymbolIcon>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsVisible="{Binding NeedsReview.HasAdPageItems}">
                                                <fi:SymbolIcon Symbol="ChevronUp" IsVisible="{Binding LibraryHealthSections.AdPages.IsOpen}" FontSize="{StaticResource PbIconSizeXs}" />
                                                <fi:SymbolIcon Symbol="ChevronDown" IsVisible="{Binding !LibraryHealthSections.AdPages.IsOpen}" FontSize="{StaticResource PbIconSizeXs}" />
                                            </StackPanel>
                                            <TextBlock Text="Advertisement Pages" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding NeedsReview.AdPageCountLabel, StringFormat='· {0}'}" FontSize="11.5" Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" IsVisible="{Binding NeedsReview.HasAdPageItems}" />
                                            <TextBlock Text="· None found" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" VerticalAlignment="Center">
                                <TextBlock.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="!NeedsReview.HasAdPageItems" /><Binding Path="!NeedsReview.AreCountsLoading" /></MultiBinding></TextBlock.IsVisible>
                            </TextBlock>
                                            <TextBlock Text="…" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" VerticalAlignment="Center" IsVisible="{Binding NeedsReview.AreCountsLoading}" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding NeedsReview.HasAdPageItems}">
                                        <Button Classes="headerAction primary" Content="{Binding NeedsReview.AcceptAllAdPagesConfirm.Label}" Command="{Binding NeedsReview.AcceptAllAdPagesConfirm.TriggerCommand}" AutomationProperties.AutomationId="LibraryHealthAcceptAllAdPagesButton" />
                                        <Button Classes="headerAction ghost" Content="{Binding NeedsReview.RejectAllAdPagesConfirm.Label}" Command="{Binding NeedsReview.RejectAllAdPagesConfirm.TriggerCommand}" AutomationProperties.AutomationId="LibraryHealthRejectAllAdPagesButton" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Spacing="8" IsVisible="{Binding LibraryHealthSections.AdPages.IsOpen}">
                                    <TextBlock Text="Pages that look like ads you tagged earlier. Nothing changes until you accept." FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" TextWrapping="Wrap" />
                                    <controls:VirtualList ItemsSource="{Binding NeedsReview.AdPageGroupItems}" ItemTemplate="{StaticResource AdPageGroupRowTemplate}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,4" Tag="library.healthReportedPages">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Button Grid.Column="0" Classes="sideItemButton" HorizontalContentAlignment="Stretch" Padding="0"
                                            Command="{Binding LibraryHealthSections.ReportedPages.ToggleCommand}" IsHitTestVisible="{Binding HasPageReportItems}"
                                            AutomationProperties.AutomationId="LibraryHealthToggleReportedPages">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <fi:SymbolIcon Symbol="Checkmark" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbSuccessBrush}" VerticalAlignment="Center" IsVisible="{Binding !HasPageReportItems}" />
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsVisible="{Binding HasPageReportItems}">
                                                <fi:SymbolIcon Symbol="ChevronUp" IsVisible="{Binding LibraryHealthSections.ReportedPages.IsOpen}" FontSize="{StaticResource PbIconSizeXs}" />
                                                <fi:SymbolIcon Symbol="ChevronDown" IsVisible="{Binding !LibraryHealthSections.ReportedPages.IsOpen}" FontSize="{StaticResource PbIconSizeXs}" />
                                            </StackPanel>
                                            <TextBlock Text="Reported pages" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding PageReportItems.Count, StringFormat='· {0}'}" FontSize="11.5" Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" IsVisible="{Binding HasPageReportItems}" />
                                            <TextBlock Text="· Nothing reported" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" VerticalAlignment="Center" IsVisible="{Binding !HasPageReportItems}" />
                                            
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasPageReportItems}">
                                        
                                    </StackPanel>
                                </Grid>
                                <StackPanel Spacing="8" IsVisible="{Binding LibraryHealthSections.ReportedPages.IsOpen}">
                                    <controls:VirtualList ItemsSource="{Binding PageReportItems}" ItemTemplate="{StaticResource PageReportRowTemplate}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,4" Tag="library.healthSimilarSeries">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Button Grid.Column="0" Classes="sideItemButton" HorizontalContentAlignment="Stretch" Padding="0"
                                            Command="{Binding LibraryHealthSections.SimilarSeries.ToggleCommand}" IsHitTestVisible="{Binding HasSimilarSeriesCandidates}"
                                            AutomationProperties.AutomationId="LibraryHealthToggleSimilarSeries">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <fi:SymbolIcon Symbol="Checkmark" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbSuccessBrush}" VerticalAlignment="Center" IsVisible="{Binding !HasSimilarSeriesCandidates}" />
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsVisible="{Binding HasSimilarSeriesCandidates}">
                                                <fi:SymbolIcon Symbol="ChevronUp" IsVisible="{Binding LibraryHealthSections.SimilarSeries.IsOpen}" FontSize="{StaticResource PbIconSizeXs}" />
                                                <fi:SymbolIcon Symbol="ChevronDown" IsVisible="{Binding !LibraryHealthSections.SimilarSeries.IsOpen}" FontSize="{StaticResource PbIconSizeXs}" />
                                            </StackPanel>
                                            <TextBlock Text="Find Similar Series" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding SimilarSeriesCandidates.Count, StringFormat='· {0}'}" FontSize="11.5" Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" IsVisible="{Binding HasSimilarSeriesCandidates}" />
                                            <TextBlock Text="· Not scanned yet" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" VerticalAlignment="Center" IsVisible="{Binding !HasSimilarSeriesCandidates}" />
                                            
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasSimilarSeriesCandidates}">
                                        <Button Classes="headerAction ghost" Command="{Binding FindSimilarSeriesCommand}" AutomationProperties.AutomationId="FindSimilarSeriesButton">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <fi:SymbolIcon Symbol="Search" FontSize="{StaticResource PbIconSizeXs}" />
                                                <TextBlock Text="Scan for Similar Names" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Spacing="8" IsVisible="{Binding LibraryHealthSections.SimilarSeries.IsOpen}">
                                    <TextBlock Text="Checks for series that only differ by punctuation (e.g. &quot;X: Y&quot; vs &quot;X - Y&quot;) - review and merge only the ones that are genuinely the same series." FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" TextWrapping="Wrap" />
                                    <controls:VirtualList ItemsSource="{Binding SimilarSeriesCandidates}" ItemTemplate="{StaticResource SimilarSeriesRowTemplate}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Publisher logos (docs/superpowers/specs/2026-10-04-publisher-icons-user-folder-and-gaps-design.md): which publishers have no logo, which issues
                             have no publisher, a fill from the rest of the series, and the folder your own logos go in. On demand, like Find Similar Series. -->
                        <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,4" Tag="library.healthPublishers">
                            <StackPanel Spacing="8" DataContext="{Binding PublisherGaps}" x:DataType="vm:PublisherGapsViewModel">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Button Grid.Column="0" Classes="sideItemButton" HorizontalContentAlignment="Stretch" Padding="0"
                                            Command="{Binding $parent[UserControl].((vm:PreferencesScreenViewModel)DataContext).LibraryHealthSections.Publishers.ToggleCommand}"
                                            AutomationProperties.AutomationId="LibraryHealthTogglePublishers">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <fi:SymbolIcon Symbol="Image" FontSize="{StaticResource PbIconSizeXs}" VerticalAlignment="Center" />
                                            <TextBlock Text="Publisher logos" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding HeaderDetail}" FontSize="11.5" Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Classes="headerAction ghost" Command="{Binding ScanCommand}" AutomationProperties.AutomationId="ScanPublisherLogosButton">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <fi:SymbolIcon Symbol="Search" FontSize="{StaticResource PbIconSizeXs}" />
                                            <TextBlock Text="Scan" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <StackPanel Spacing="10" IsVisible="{Binding $parent[UserControl].((vm:PreferencesScreenViewModel)DataContext).LibraryHealthSections.Publishers.IsOpen}">
                                    <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                               FontSize="11.5" Foreground="{DynamicResource PbSuccessBrush}" TextWrapping="Wrap" />

                                    <StackPanel Spacing="4" IsVisible="{Binding HasWithoutLogo}">
                                        <TextBlock Text="Publishers with no logo" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource PbTextBrush}" />
                                        <TextBlock Text="These show a letter chip or plain text. Add a PNG or JPG named after the publisher to your icon folder below."
                                                   FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" TextWrapping="Wrap" />
                                        <ScrollViewer MaxHeight="180">
                                            <ItemsControl ItemsSource="{Binding WithoutLogo}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="svc:PublisherWithoutLogo">
                                                        <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource PbTextBrush}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Issues, StringFormat='{}{0:N0} issues'}" FontSize="11.5" Foreground="{DynamicResource PbTextMutedBrush}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>

                                    <StackPanel Spacing="4" IsVisible="{Binding HasNoPublisher}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding IssuesWithoutPublisher, StringFormat='{}{0:N0} issues have no publisher'}" FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Classes="headerAction secondary" Command="{Binding FillFromSiblingsCommand}" IsVisible="{Binding HasFillable}"
                                                    AutomationProperties.AutomationId="FillMissingPublishersButton">
                                                <TextBlock Text="{Binding FillLabel}" />
                                            </Button>
                                        </Grid>
                                        <TextBlock Text="Where the rest of a series names a publisher, the blanks can take it. Series with no publisher anywhere (most web-comic and manhwa scans carry none in their files) are listed so you can set one in the bulk editor."
                                                   FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" TextWrapping="Wrap" />
                                        <ScrollViewer MaxHeight="180">
                                            <ItemsControl ItemsSource="{Binding SeriesMissing}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="svc:SeriesMissingPublisher">
                                                        <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                            <TextBlock Grid.Column="0" Text="{Binding SeriesName}" FontSize="12" Foreground="{DynamicResource PbTextBrush}" TextTrimming="CharacterEllipsis" />
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Text="{Binding Suggested, StringFormat='→ {0}'}" FontSize="11.5" Foreground="{DynamicResource PbSuccessBrush}"
                                                                           IsVisible="{Binding Suggested, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                                <TextBlock Text="{Binding IssuesMissing, StringFormat='{}{0:N0} issues'}" FontSize="11.5" Foreground="{DynamicResource PbTextMutedBrush}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Your own logos" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource PbTextBrush}" />
                                        <TextBlock Text="Drop PNG or JPG files here, named after the publisher (Penguin Group.png). Yours are used before the built-in ones. Years work as in the built-in pack: Marvel(1990-2004).png."
                                                   FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding UserIconsFolder}" FontSize="11.5" Foreground="{DynamicResource PbTextMutedBrush}" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Classes="headerAction ghost" Command="{Binding OpenIconsFolderCommand}" AutomationProperties.AutomationId="OpenPublisherIconsFolderButton">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <fi:SymbolIcon Symbol="FolderOpen" FontSize="{StaticResource PbIconSizeXs}" />
                                                    <TextBlock Text="Open folder" />
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="headerAction ghost" Command="{Binding ReloadIconsCommand}" AutomationProperties.AutomationId="ReloadPublisherIconsButton">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <fi:SymbolIcon Symbol="ArrowSync" FontSize="{StaticResource PbIconSizeXs}" />
                                                    <TextBlock Text="Reload icons" />
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Text="{Binding UserIconsSummary}" FontSize="11.5" Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Files: file and row hygiene -->
                    <StackPanel Margin="14,10,14,14" IsVisible="{Binding IsLibraryHealthFilesTab}">
                        <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,4" Tag="library.healthMissing">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Button Grid.Column="0" Classes="sideItemButton" HorizontalContentAlignment="Stretch" Padding="0"
                                            Command="{Binding LibraryHealthSections.Missing.ToggleCommand}" IsHitTestVisible="{Binding CanExpandMissingFiles}"
                                            AutomationProperties.AutomationId="LibraryHealthToggleMissing">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <fi:SymbolIcon Symbol="Checkmark" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbSuccessBrush}" VerticalAlignment="Center" IsVisible="{Binding !CanExpandMissingFiles}" />
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsVisible="{Binding CanExpandMissingFiles}">
                                                <fi:SymbolIcon Symbol="ChevronUp" IsVisible="{Binding LibraryHealthSections.Missing.IsOpen}" FontSize="{StaticResource PbIconSizeXs}" />
                                                <fi:SymbolIcon Symbol="ChevronDown" IsVisible="{Binding !LibraryHealthSections.Missing.IsOpen}" FontSize="{StaticResource PbIconSizeXs}" />
                                            </StackPanel>
                                            <TextBlock Text="Missing Files" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding MissingFileItems.Count, StringFormat='· {0}'}" FontSize="11.5" Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" IsVisible="{Binding HasMissingFileItems}" />
                                            <TextBlock Text="· No missing files" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" VerticalAlignment="Center" IsVisible="{Binding !HasMissingFileItems}" />
                                            <TextBlock Text="{Binding DismissedMissingFileItems.Count, StringFormat='· {0} dismissed'}" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" VerticalAlignment="Center" IsVisible="{Binding HasDismissedMissingFileItems}" />
                                            
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasMissingFileItems}">
                                        <Button Classes="headerAction ghost" Content="Dismiss All" Command="{Binding BulkDismissMissingFilesCommand}" AutomationProperties.AutomationId="LibraryHealthDismissAllButton" />
                                        <Button Classes="headerAction ghost" Content="Relink All from Folder…" Command="{Binding BulkRelinkMissingFilesCommand}" AutomationProperties.AutomationId="LibraryHealthRelinkAllButton" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Spacing="8" IsVisible="{Binding LibraryHealthSections.Missing.IsOpen}">
                                    <controls:VirtualList ItemsSource="{Binding MissingFileItems}" ItemTemplate="{StaticResource MissingFileRowTemplate}" />
                                    <!-- Dismissed sub-group (docs/superpowers/specs/2026-09-28-library-health-dismissed-rows-design.md) -->
                                    <StackPanel Spacing="8" IsVisible="{Binding HasDismissedMissingFileItems}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Button Grid.Column="0" Classes="sideItemButton" HorizontalContentAlignment="Stretch" Padding="0"
                                                    Command="{Binding LibraryHealthSections.MissingDismissed.ToggleCommand}"
                                                    AutomationProperties.AutomationId="LibraryHealthToggleMissingDismissed">
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <fi:SymbolIcon Symbol="ChevronUp" IsVisible="{Binding LibraryHealthSections.MissingDismissed.IsOpen}" FontSize="{StaticResource PbIconSizeXs}" />
                                                        <fi:SymbolIcon Symbol="ChevronDown" IsVisible="{Binding !LibraryHealthSections.MissingDismissed.IsOpen}" FontSize="{StaticResource PbIconSizeXs}" />
                                                    </StackPanel>
                                                    <TextBlock Text="Dismissed" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding DismissedMissingFileItems.Count, StringFormat='· {0}'}" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="1" Classes="headerAction ghost" Content="Restore All" Command="{Binding RestoreAllDismissedMissingFilesCommand}"
                                                    AutomationProperties.AutomationId="LibraryHealthRestoreAllMissingButton" />
                                        </Grid>
                                        <controls:VirtualList ItemsSource="{Binding DismissedMissingFileItems}" ItemTemplate="{StaticResource MissingFileRowTemplate}"
                                                              IsVisible="{Binding LibraryHealthSections.MissingDismissed.IsOpen}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,4" Tag="library.healthEmptyRows">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Button Grid.Column="0" Classes="sideItemButton" HorizontalContentAlignment="Stretch" Padding="0"
                                            Command="{Binding LibraryHealthSections.EmptyRows.ToggleCommand}" IsHitTestVisible="{Binding CanExpandEmptyRows}"
                                            AutomationProperties.AutomationId="LibraryHealthToggleEmptyRows">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <fi:SymbolIcon Symbol="Checkmark" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbSuccessBrush}" VerticalAlignment="Center" IsVisible="{Binding !CanExpandEmptyRows}" />
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsVisible="{Binding CanExpandEmptyRows}">
                                                <fi:SymbolIcon Symbol="ChevronUp" IsVisible="{Binding LibraryHealthSections.EmptyRows.IsOpen}" FontSize="{StaticResource PbIconSizeXs}" />
                                                <fi:SymbolIcon Symbol="ChevronDown" IsVisible="{Binding !LibraryHealthSections.EmptyRows.IsOpen}" FontSize="{StaticResource PbIconSizeXs}" />
                                            </StackPanel>
                                            <TextBlock Text="Empty Rows" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding EmptyRowCount, StringFormat='· {0}'}" FontSize="11.5" Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" IsVisible="{Binding HasEmptyRowItems}" />
                                            <TextBlock Text="· Nothing empty" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" VerticalAlignment="Center" IsVisible="{Binding !HasEmptyRowItems}" />
                                            <TextBlock Text="{Binding DismissedEmptyRowCount, StringFormat='· {0} dismissed'}" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" VerticalAlignment="Center" IsVisible="{Binding HasDismissedEmptyRowItems}" />
                                            
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasEmptyRowItems}">
                                        
                                    </StackPanel>
                                </Grid>
                                <StackPanel Spacing="8" IsVisible="{Binding LibraryHealthSections.EmptyRows.IsOpen}">
                                    <controls:VirtualList ItemsSource="{Binding EmptySeriesItems}" ItemTemplate="{StaticResource EmptySeriesRowTemplate}" />
                                    <controls:VirtualList ItemsSource="{Binding EmptyIssueItems}" ItemTemplate="{StaticResource MissingFileRowTemplate}" />
                                    <StackPanel Spacing="8" IsVisible="{Binding HasDismissedEmptyRowItems}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Button Grid.Column="0" Classes="sideItemButton" HorizontalContentAlignment="Stretch" Padding="0"
                                                    Command="{Binding LibraryHealthSections.EmptyRowsDismissed.ToggleCommand}"
                                                    AutomationProperties.AutomationId="LibraryHealthToggleEmptyRowsDismissed">
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <fi:SymbolIcon Symbol="ChevronUp" IsVisible="{Binding LibraryHealthSections.EmptyRowsDismissed.IsOpen}" FontSize="{StaticResource PbIconSizeXs}" />
                                                        <fi:SymbolIcon Symbol="ChevronDown" IsVisible="{Binding !LibraryHealthSections.EmptyRowsDismissed.IsOpen}" FontSize="{StaticResource PbIconSizeXs}" />
                                                    </StackPanel>
                                                    <TextBlock Text="Dismissed" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding DismissedEmptyRowCount, StringFormat='· {0}'}" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="1" Classes="headerAction ghost" Content="Restore All" Command="{Binding RestoreAllDismissedEmptyRowsCommand}"
                                                    AutomationProperties.AutomationId="LibraryHealthRestoreAllEmptyRowsButton" />
                                        </Grid>
                                        <StackPanel Spacing="8" IsVisible="{Binding LibraryHealthSections.EmptyRowsDismissed.IsOpen}">
                                            <controls:VirtualList ItemsSource="{Binding DismissedEmptySeriesItems}" ItemTemplate="{StaticResource EmptySeriesRowTemplate}" />
                                            <controls:VirtualList ItemsSource="{Binding DismissedEmptyIssueItems}" ItemTemplate="{StaticResource MissingFileRowTemplate}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,4" Tag="library.healthRecentlyRemoved">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Button Grid.Column="0" Classes="sideItemButton" HorizontalContentAlignment="Stretch" Padding="0"
                                            Command="{Binding LibraryHealthSections.RecentlyRemoved.ToggleCommand}" IsHitTestVisible="{Binding HasRecentlyRemovedItems}"
                                            AutomationProperties.AutomationId="LibraryHealthToggleRecentlyRemoved">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <fi:SymbolIcon Symbol="Checkmark" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbSuccessBrush}" VerticalAlignment="Center" IsVisible="{Binding !HasRecentlyRemovedItems}" />
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsVisible="{Binding HasRecentlyRemovedItems}">
                                                <fi:SymbolIcon Symbol="ChevronUp" IsVisible="{Binding LibraryHealthSections.RecentlyRemoved.IsOpen}" FontSize="{StaticResource PbIconSizeXs}" />
                                                <fi:SymbolIcon Symbol="ChevronDown" IsVisible="{Binding !LibraryHealthSections.RecentlyRemoved.IsOpen}" FontSize="{StaticResource PbIconSizeXs}" />
                                            </StackPanel>
                                            <TextBlock Text="Recently Removed" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding RecentlyRemovedItems.Count, StringFormat='· {0}'}" FontSize="11.5" Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" IsVisible="{Binding HasRecentlyRemovedItems}" />
                                            <TextBlock Text="· All clear" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" VerticalAlignment="Center" IsVisible="{Binding !HasRecentlyRemovedItems}" />
                                            
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasRecentlyRemovedItems}">
                                        
                                    </StackPanel>
                                </Grid>
                                <StackPanel Spacing="8" IsVisible="{Binding LibraryHealthSections.RecentlyRemoved.IsOpen}">
                                    <TextBlock Text="Removals made from Library Health, kept for 30 days." FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" TextWrapping="Wrap" />
                                    <controls:VirtualList ItemsSource="{Binding RecentlyRemovedItems}" ItemTemplate="{StaticResource RemovedLibraryEntryRowTemplate}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- Scanning: missing-file handling (docs/superpowers/specs/2026-09-06-scan-missing-file-handling-design.md) -->
            <Border Classes="groupBox" Tag="library.scanning">
                <StackPanel>
                    <Border Classes="groupHeader">
                        <StackPanel>
                            <TextBlock Text="Scanning" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                            <TextBlock Text="What Scan Now does about missing and manually-removed files" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="14" Spacing="4">
                        <pref:SettingsRow Icon="Delete" Title="Automatically remove confirmed-missing files during Scan"
                                           Description="After a Scan Now, runs Library Health's Verify and removes anything that's confirmed missing (two checks in a row), skipping the confirmation dialog.">
                            <pref:SettingsRow.SettingsContent>
                                <ToggleSwitch IsChecked="{Binding AutoRemoveMissingOnScan}" OnContent="{x:Null}" OffContent="{x:Null}"
                                              AutomationProperties.AutomationId="AutoRemoveMissingOnScanCheckBox" />
                            </pref:SettingsRow.SettingsContent>
                        </pref:SettingsRow>
                        <pref:SettingsRow Icon="Dismiss" Title="Don't re-add files that were manually removed"
                                           Description="Files you remove from the library (from anywhere in the app) are remembered and skipped on future scans, so they won't silently come back.">
                            <pref:SettingsRow.SettingsContent>
                                <ToggleSwitch IsChecked="{Binding DontReimportRemovedFiles}" OnContent="{x:Null}" OffContent="{x:Null}"
                                              AutomationProperties.AutomationId="DontReimportRemovedFilesCheckBox" />
                            </pref:SettingsRow.SettingsContent>
                        </pref:SettingsRow>
                        <Button Classes="headerAction ghost" Content="{Binding ClearRemovedFilesListConfirm.Label}"
                                Command="{Binding ClearRemovedFilesListConfirm.TriggerCommand}"
                                ToolTip.Tip="Forgets every manually-removed file, so they can be re-added by a future scan"
                                HorizontalAlignment="Left" Margin="0,6,0,0"
                                AutomationProperties.AutomationId="ClearRemovedFilesListButton" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Comic Library Folders (manages WatchedFolders; docs/superpowers/specs/2026-09-07-
                 library-folder-management-redesign-design.md) -->
            <Border Classes="groupBox" Tag="library.comicFolders">
                <StackPanel>
                    <Border Classes="groupHeader">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Comic Library Folders" FontWeight="Bold" FontSize="13"
                                       Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                <Button Classes="segTab" Classes.active="{Binding !IsComicFoldersMaintenanceTabActive}"
                                        Content="Folders" Command="{Binding ShowComicFoldersFoldersTabCommand}" />
                                <Button Classes="segTab" Classes.active="{Binding IsComicFoldersMaintenanceTabActive}"
                                        Content="Maintenance" Command="{Binding ShowComicFoldersMaintenanceTabCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Margin="14" Spacing="10" IsVisible="{Binding !IsComicFoldersMaintenanceTabActive}">
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !HasWatchedFolders}">
                            <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource PbSuccessSoftBrush}">
                                <fi:SymbolIcon Symbol="Folder" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbSuccessBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="No folders yet — add one to start building your library" FontSize="12.5"
                                       Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <ItemsControl x:Name="WatchedFoldersList" ItemsSource="{Binding WatchedFolders}" IsVisible="{Binding HasWatchedFolders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:WatchedFolderSummary">
                                    <Border Classes="skinRow">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10" Margin="14,10">
                                            <Border Grid.Column="0" Width="26" Height="26" CornerRadius="7" Background="{DynamicResource PbAccentSoftBrush}">
                                                <fi:SymbolIcon Symbol="Folder" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbAccentTextBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Path}" FontSize="13" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                                            <ToggleSwitch Grid.Column="2" IsChecked="{Binding Watch}"
                                                          Command="{Binding #WatchedFoldersList.((vm:PreferencesScreenViewModel)DataContext).ToggleWatchCommand}"
                                                          CommandParameter="{Binding}"
                                                          OnContent="{x:Null}" OffContent="{x:Null}"
                                                          ToolTip.Tip="Watch for changes"
                                                          AutomationProperties.AutomationId="WatchedFolderWatchCheckBox" />
                                            <Button Grid.Column="3" Classes="headerAction ghost" Width="30" Height="30" Padding="0"
                                                    Command="{Binding #WatchedFoldersList.((vm:PreferencesScreenViewModel)DataContext).OpenFolderCommand}"
                                                    CommandParameter="{Binding}" ToolTip.Tip="Open in file explorer">
                                                <fi:SymbolIcon Symbol="FolderOpen" FontSize="{StaticResource PbIconSizeXs}" />
                                            </Button>
                                            <Button Grid.Column="4" Classes="headerAction ghost" Width="30" Height="30" Padding="0"
                                                    Command="{Binding #WatchedFoldersList.((vm:PreferencesScreenViewModel)DataContext).RemoveFolderCommand}"
                                                    CommandParameter="{Binding}" ToolTip.Tip="Remove from library">
                                                <fi:SymbolIcon Symbol="Delete" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbDangerBrush}" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Classes="headerAction primary" Command="{Binding AddFolderCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <fi:SymbolIcon Symbol="FolderAdd" Foreground="{DynamicResource PbBadgeTextBrush}" />
                                    <TextBlock Text="Add Folder…" />
                                </StackPanel>
                            </Button>
                            <Button Classes="headerAction ghost" Command="{Binding ScanNowCommand}"
                                    IsEnabled="{Binding !IsAnyComicFolderOperationRunning}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <fi:SymbolIcon Symbol="FolderSearch" />
                                    <TextBlock Text="Scan Now" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Margin="14" Spacing="10" IsVisible="{Binding IsComicFoldersMaintenanceTabActive}">
                        <WrapPanel Orientation="Horizontal">
                            <Button Classes="headerAction ghost" Margin="0,0,10,10" Command="{Binding GenerateCoversCommand}"
                                    IsEnabled="{Binding !IsAnyComicFolderOperationRunning}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <fi:SymbolIcon Symbol="Book" />
                                    <TextBlock Text="Generate Covers" />
                                </StackPanel>
                            </Button>
                            <Button Classes="headerAction ghost" Margin="0,0,10,10" Command="{Binding SyncMetadataCommand}"
                                    IsEnabled="{Binding !IsAnyComicFolderOperationRunning}"
                                    ToolTip.Tip="Re-reads embedded ComicInfo.xml for issues already in the library and fills in any blank fields">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <fi:SymbolIcon Symbol="ArrowClockwise" />
                                    <TextBlock Text="Sync Metadata" />
                                </StackPanel>
                            </Button>
                            <Button Classes="headerAction ghost" Margin="0,0,10,10" Command="{Binding RepairMissingCoversCommand}"
                                    IsEnabled="{Binding !IsAnyComicFolderOperationRunning}"
                                    ToolTip.Tip="Regenerates only the covers that are currently blank, for comics and books whose file is available - the quick fix when covers have gone missing">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <fi:SymbolIcon Symbol="ArrowSync" />
                                    <TextBlock Text="Repair Missing Covers" />
                                </StackPanel>
                            </Button>
                            <Button Classes="headerAction ghost" Margin="0,0,10,10" Command="{Binding VerifyCoversCommand}"
                                    IsEnabled="{Binding !IsAnyComicFolderOperationRunning}"
                                    ToolTip.Tip="Re-derives comic and book covers whose file has changed since the thumbnail was made - catches an updated archive without re-decoding the whole library">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <fi:SymbolIcon Symbol="CheckmarkCircle" />
                                    <TextBlock Text="Verify &amp; Repair Covers" />
                                </StackPanel>
                            </Button>
                            <Button Classes="headerAction ghost" Margin="0,0,10,10" Content="{Binding ClearComicCoverCacheConfirm.Label}"
                                    Command="{Binding ClearComicCoverCacheConfirm.TriggerCommand}"
                                    IsEnabled="{Binding !IsAnyComicFolderOperationRunning}"
                                    ToolTip.Tip="Deletes every cached comic cover and rebuilds from your files"
                                    AutomationProperties.AutomationId="PreferencesClearComicCoverCache" />
                        </WrapPanel>
                        <controls:BusyIndicator Job="{Binding CurrentComicFolderJob}"
                                                 IsVisible="{Binding IsAnyComicFolderOperationRunning}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Book Folders (novels: EPUB/PDF; docs/superpowers/specs/2026-09-07-library-folder-
                 management-redesign-design.md) -->
            <Border Classes="groupBox" Tag="library.bookFolders">
                <StackPanel>
                    <Border Classes="groupHeader">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Book Folders" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                                <TextBlock Text="EPUB and PDF novels" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top">
                                <Button Classes="segTab" Classes.active="{Binding !IsBookFoldersMaintenanceTabActive}"
                                        Content="Folders" Command="{Binding ShowBookFoldersFoldersTabCommand}" />
                                <Button Classes="segTab" Classes.active="{Binding IsBookFoldersMaintenanceTabActive}"
                                        Content="Maintenance" Command="{Binding ShowBookFoldersMaintenanceTabCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Margin="14" Spacing="10" IsVisible="{Binding !IsBookFoldersMaintenanceTabActive}">
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !HasBookFolders}">
                            <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource PbSuccessSoftBrush}">
                                <fi:SymbolIcon Symbol="Folder" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbSuccessBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="No folders yet — add one to start your book collection" FontSize="12.5"
                                       Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <ItemsControl x:Name="BookFoldersList" ItemsSource="{Binding BookFolders}" IsVisible="{Binding HasBookFolders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:BookFolderSummary">
                                    <Border Classes="skinRow">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" Margin="14,10">
                                            <Border Grid.Column="0" Width="26" Height="26" CornerRadius="7" Background="{DynamicResource PbSuccessSoftBrush}">
                                                <fi:SymbolIcon Symbol="Folder" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbSuccessBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Path}" FontSize="13" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                                            <Button Grid.Column="2" Classes="headerAction ghost" Width="30" Height="30" Padding="0"
                                                    Command="{Binding #BookFoldersList.((vm:PreferencesScreenViewModel)DataContext).OpenBookFolderCommand}"
                                                    CommandParameter="{Binding}" ToolTip.Tip="Open in file explorer"
                                                    AutomationProperties.AutomationId="PreferencesBookFolderOpen">
                                                <fi:SymbolIcon Symbol="FolderOpen" FontSize="{StaticResource PbIconSizeXs}" />
                                            </Button>
                                            <Button Grid.Column="3" Classes="headerAction ghost" Width="30" Height="30" Padding="0"
                                                    Command="{Binding #BookFoldersList.((vm:PreferencesScreenViewModel)DataContext).RemoveBookFolderCommand}"
                                                    CommandParameter="{Binding}" ToolTip.Tip="Remove from library"
                                                    AutomationProperties.AutomationId="PreferencesBookFolderRemove">
                                                <fi:SymbolIcon Symbol="Delete" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbDangerBrush}" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Classes="headerAction primary" Command="{Binding AddBookFolderCommand}"
                                    AutomationProperties.AutomationId="PreferencesAddBookFolder">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <fi:SymbolIcon Symbol="FolderAdd" Foreground="{DynamicResource PbBadgeTextBrush}" />
                                    <TextBlock Text="Add Folder…" />
                                </StackPanel>
                            </Button>
                            <Button Classes="headerAction ghost" Command="{Binding ScanBooksNowCommand}"
                                    IsEnabled="{Binding !IsAnyBookFolderOperationRunning}"
                                    AutomationProperties.AutomationId="PreferencesScanBooksNow">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <fi:SymbolIcon Symbol="FolderSearch" />
                                    <TextBlock Text="Scan Now" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Margin="14" Spacing="10" IsVisible="{Binding IsBookFoldersMaintenanceTabActive}">
                        <WrapPanel Orientation="Horizontal">
                            <Button Classes="headerAction ghost" Margin="0,0,10,10" Content="{Binding ClearBookCoverCacheConfirm.Label}"
                                    Command="{Binding ClearBookCoverCacheConfirm.TriggerCommand}"
                                    IsEnabled="{Binding !IsAnyBookFolderOperationRunning}"
                                    ToolTip.Tip="Deletes every cached book cover and rebuilds from your files"
                                    AutomationProperties.AutomationId="PreferencesClearBookCoverCache" />
                        </WrapPanel>
                        <controls:BusyIndicator Job="{Binding CurrentBookFolderJob}"
                                                 IsVisible="{Binding IsAnyBookFolderOperationRunning}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Migration -->
            <Border Classes="groupBox" Tag="library.migration">
                <StackPanel>
                    <Border Classes="groupHeader">
                        <TextBlock Text="Migrate from ComicRack CE" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                    </Border>
                    <StackPanel Margin="14" Spacing="10">
                        <TextBlock Text="Import your existing ComicRack Community Edition library - series, issues, and metadata."
                                   FontSize="12" Foreground="{DynamicResource PbTextFaintBrush}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Classes="headerAction primary" Command="{Binding OpenMigrationCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <fi:SymbolIcon Symbol="CloudArrowUp" Foreground="{DynamicResource PbBadgeTextBrush}" />
                                    <TextBlock Text="Migrate…" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Virtual Tags (docs/superpowers/specs/2026-09-07-virtual-tags-editor-redesign-design.md) -->
            <Border Classes="groupBox" Tag="library.virtualTags">
                <StackPanel>
                    <Border Classes="groupHeader">
                        <TextBlock Text="Virtual Tags" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PbTextBrush}" />
                    </Border>

                    <StackPanel Margin="14,14,14,0" Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !HasVirtualTags}">
                            <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource PbSuccessSoftBrush}">
                                <fi:SymbolIcon Symbol="Checkmark" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbSuccessBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="No virtual tags yet" FontSize="12.5" Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <ItemsControl x:Name="VirtualTagsList" ItemsSource="{Binding VirtualTags}" IsVisible="{Binding HasVirtualTags}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:VirtualTagSummary">
                                <Border Classes="skinRow" Classes.vtSelected="{Binding IsSelected}">
                                    <Button Classes="sideItemButton"
                                            Command="{Binding #VirtualTagsList.((vm:PreferencesScreenViewModel)DataContext).SelectVirtualTagCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Border Classes="vtChip" Classes.dimmed="{Binding !IsEnabled}" Width="24" Height="24" CornerRadius="7">
                                                <fi:SymbolIcon Symbol="Tag" FontSize="{StaticResource PbIconSizeXs}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Classes="vtName" Classes.dimmed="{Binding !IsEnabled}" Text="{Binding Name}" FontSize="13"
                                                       Foreground="{DynamicResource PbTextBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Margin="14" Spacing="10">
                        <Button Classes="headerAction primary" Command="{Binding AddVirtualTagCommand}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <fi:SymbolIcon Symbol="Add" Foreground="{DynamicResource PbBadgeTextBrush}" />
                                <TextBlock Text="Add Virtual Tag" />
                            </StackPanel>
                        </Button>

                        <StackPanel IsVisible="{Binding HasSelectedVirtualTag}" Spacing="10" Margin="0,10,0,0">
                            <Border BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,4" />
                            <TextBlock Text="Name" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" />
                            <TextBox Text="{Binding VirtualTagName}" Width="320" HorizontalAlignment="Left" />

                            <TextBlock Text="Caption Format (e.g. {Series} #{Number})" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" />
                            <TextBox Text="{Binding VirtualTagCaptionFormat}" Width="320" HorizontalAlignment="Left" />

                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource PbSuccessBrush}"
                                            IsVisible="{Binding VirtualTagIsEnabled}" />
                                    <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource PbTextFaintBrush}"
                                            IsVisible="{Binding !VirtualTagIsEnabled}" />
                                    <TextBlock Text="Enabled" Foreground="{DynamicResource PbTextBrush}" FontSize="13" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding VirtualTagIsEnabled}" OnContent="{x:Null}" OffContent="{x:Null}" />
                            </Grid>

                            <TextBlock Text="Preview" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}" />
                            <Border Background="{DynamicResource PbBadgeSoftBrush}" BorderBrush="{DynamicResource PbBadgeBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="10,6" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <fi:SymbolIcon Symbol="Eye" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbBadgeBrush}" />
                                    <TextBlock Text="{Binding VirtualTagPreview}" FontFamily="Consolas,monospace" FontSize="13"
                                               Foreground="{DynamicResource PbBadgeBrush}" />
                                </StackPanel>
                            </Border>

                            <Button Classes="headerAction ghost" Foreground="{DynamicResource PbDangerBrush}" BorderBrush="{DynamicResource PbDangerSoftBrush}"
                                    Command="{Binding DeleteVirtualTagCommand}" HorizontalAlignment="Left" Margin="0,6,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <fi:SymbolIcon Symbol="Delete" FontSize="{StaticResource PbIconSizeXs}" Foreground="{DynamicResource PbDangerBrush}" />
                                    <TextBlock Text="Delete Tag" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
