<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:views="using:Paperbunkr.App.Views"
             xmlns:models="using:Paperbunkr.App.Models"
             xmlns:entities="using:Paperbunkr.Data.Entities"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:controls="using:Paperbunkr.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Paperbunkr.App.Views.ReaderScreen"
             x:DataType="vm:ReaderScreenViewModel"
             controls:ContextMenuHost.Provider="{Binding}">

    <!--
    Reader chrome (docs/superpowers/specs/2026-08-25-reader-chrome-design.md) - 4 independent
    floating "corner clusters" (Navigate/View/Page-turn/Actions) over a full-bleed canvas, plus a
    right-anchored drawer for everything else, replacing the old always-docked top-toolbar/bottom-bar
    plus a *separate* fullscreen-only overlay pair. Works the same in both windowed and fullscreen.
    The persistent thumbnail rail is the one exception - it shows in both states too, which retired
    the old fullscreen-only horizontal "scrubber" filmstrip entirely (same thumbnails, same
    click-to-jump, no reason for two separate strips once both states share one chrome system).

    Per-cluster hover reveal (2026-09-16, direct user request - "more reactive... only when I hover
    above each item"): each of the 4 clusters shows independently while the pointer is over its own
    corner hotspot (IsNavigateClusterVisible/etc. on ReaderScreenViewModel), not all together on any
    movement anywhere - that ambient-reveal-everything behavior (ReaderScreenViewModel.ShowChrome
    used to flip true on every PointerMoved over this whole Grid) has been removed. ShowChrome still
    exists as an explicit "show everything" override for touch/keyboard (ToggleChromeCommand), which
    can't hover at all - see that property's own doc comment.
    -->

    <UserControl.Styles>
        <!-- Thumbnail rail tiles - Pb* tokens in place of the old hardcoded ReaderXxxBrush set. -->
        <Style Selector="Border.thumb">
            <Setter Property="Width" Value="80" />
            <Setter Property="Height" Value="112" />
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusSm}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <!-- Selection ring thickened (docs/superpowers/specs/2026-09-14-reader-chrome-redesign-
             design.md §6) - same PbAccentBrush, just needs more contrast once the rail sidebar itself
             is translucent rather than opaque. -->
        <Style Selector="Border.thumb.selected">
            <Setter Property="BorderThickness" Value="3" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
        </Style>

        <!-- Chrome cluster small controls - Pb*-token equivalents of the old toolPill/toolIcon/flyoutRow. -->
        <Style Selector="Button.clusterPill">
            <Setter Property="Background" Value="{DynamicResource PbSurface3Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusSm}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.clusterPill.active">
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbAccentTextBrush}" />
        </Style>
        <Style Selector="Button.clusterIcon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.drawerRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <!-- Per-page progress dots (Page-turn cluster) - small enough that many pages still fit,
             active dot grows/brightens same idiom as Phase 3's Home hero spotlight dots. -->
        <!-- Width bound, not literal (docs/superpowers/specs/2026-09-14-reader-chrome-redesign-
             design.md §4 follow-up, on-screen feedback) - shrinks with page count so a long TPB's
             dot strip never exceeds its target width/needs a scrollbar. Relative-binding trick since
             each dot's own DataContext is its ReaderThumbnailSample, not the ViewModel - same pattern
             this DataTemplate's Command already uses. -->
        <Style Selector="Button.pageDot">
            <Setter Property="Width" Value="{Binding $parent[UserControl].((vm:ReaderScreenViewModel)DataContext).DotStripItemWidth}" />
            <Setter Property="Height" Value="5" />
            <Setter Property="CornerRadius" Value="{StaticResource PbRadiusChip}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,8" />
            <Setter Property="Background" Value="{DynamicResource PbSurface3Brush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <!-- Dock-style hover magnify (on-screen feedback: "the macOS dock... can we add that to
                 the progress bar") - RenderTransform set from code-behind's OnPageDotsPointerMoved,
                 not a Style trigger (needs live distance-from-pointer math per dot, not a fixed
                 pseudo-class state). RenderTransformOrigin bottom-center so dots grow upward off the
                 strip's baseline, same direction real Dock icons grow.
                 Deliberately NO Transition on RenderTransform (tried, made it worse - "it's not
                 smooth at all"): a CSS-style transition re-targets its own ease from wherever it
                 currently sits every single PointerMoved tick, so it perpetually chases a moving
                 target instead of tracking the cursor. The real Dock has no separate transition layer
                 either - continuous per-frame position updates from real mouse movement (~60Hz+) ARE
                 the smoothness, directly, with nothing layered on top. -->
            <Setter Property="RenderTransformOrigin" Value="0.5,1" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Width" Duration="{DynamicResource PbMotionFast}" Easing="{StaticResource PbMotionEase}" />
                    <BrushTransition Property="Background" Duration="{DynamicResource PbMotionFast}" Easing="{StaticResource PbMotionEase}" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.pageDot:pointerover">
            <Setter Property="Background" Value="{DynamicResource PbTextFaintBrush}" />
        </Style>
        <Style Selector="Button.pageDot.active">
            <Setter Property="Width" Value="{Binding $parent[UserControl].((vm:ReaderScreenViewModel)DataContext).DotStripActiveItemWidth}" />
            <Setter Property="Background" Value="{DynamicResource PbAccentBrush}" />
        </Style>

        <Style Selector="Button.drawerRow.active">
            <Setter Property="Background" Value="{DynamicResource PbAccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbAccentTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- fi:SymbolIcon inherits each button's Foreground, so the existing
             Button.clusterIcon/clusterPill/drawerRow .active Foreground Setters recolour the
             icon on activation for free - no per-icon selector needed. -->

        <!-- Corner clusters - floatingPanel (Primitives.axaml) gives translucent surface + border +
             elevation shadow + an Opacity DoubleTransition on PbMotionFast/PbMotionEase already;
             .hidden layers the idle-fade on top without fighting that transition (IsVisible would
             collapse instantly with no fade, so this uses Opacity + IsHitTestVisible instead). The
             actual Opacity=0/IsHitTestVisible=False setters for .hidden are declared further below,
             AFTER the frosted-glass restyle rule that also targets these elements - see that rule's
             own comment for why order (not a class-count "more specific selector") is what actually
             decides which one wins in Avalonia. -->
        <Style Selector="Border.chromeCluster">
            <Setter Property="Padding" Value="8" />
        </Style>

        <!-- Thumbnail rail auto-hide (docs/superpowers/specs/2026-08-25-reader-chrome-design.md
             follow-up) - pure hover UI state, kept in code-behind rather than the ViewModel since
             nothing outside this view cares about it. Collapsed by default; a thin edge trigger strip
             and the rail itself both keep it expanded while the pointer is over either. -->
        <Style Selector="Border.railOverlay">
            <Setter Property="Opacity" Value="0.92" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="{DynamicResource PbMotionFast}" Easing="{StaticResource PbMotionEase}" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.railOverlay.hidden">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <!-- Actions cluster's bookmark-toggle glow pulse (docs/superpowers/specs/2026-08-25-reader-
             chrome-design.md) - not a hover/focus state like PosterTile's PbGlowRing usage, so this
             is driven by the transient BookmarkJustToggled flag instead of a pseudo-class. -->
        <Style Selector="Border.bookmarkGlow">
            <Setter Property="Transitions">
                <Transitions>
                    <BoxShadowsTransition Property="BoxShadow" Duration="{DynamicResource PbMotionFast}" Easing="{StaticResource PbMotionEase}" />
                </Transitions>
            </Setter>
        </Style>
        <!-- PbGlowPulseRing, not PbGlowRing: the pulse is feedback, not a hover affordance, so the
             user's glow tier (docs/superpowers/specs/2026-09-21-cosmetics-pitch-design.md #3, even Off)
             must not disable it. -->
        <Style Selector="Border.bookmarkGlow.pulsing">
            <Setter Property="BoxShadow" Value="{DynamicResource PbGlowPulseRing}" />
        </Style>

        <Style Selector="TextBlock.drawerSectionHeader">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextFaintBrush}" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>

        <!-- Reading-mode/fit-mode flyout content (docs/superpowers/specs/2026-09-14-reader-chrome-
             redesign-design.md §2/§3) - "turning them into button pills when open": the trigger
             Button + Flyout stay, only the flyout's own content changes from a vertical drawerRow
             list to a wrapping grid of individually-rounded pills. Not the DetailTabs/Metadata-editors
             segItem shape (one bordered strip with dividers, built for a single non-wrapping row) -
             7 reading-mode options with labels as long as "Horizontal Long Strip (RTL)" need to wrap
             across lines, which that joined-strip shape doesn't support. -->
        <Style Selector="Button.pillOption">
            <Setter Property="Background" Value="{DynamicResource PbSurface2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadiusSm}" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource PbTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.pillOption.active">
            <Setter Property="Background" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PbBadgeTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Translucent restyle (docs/superpowers/specs/2026-09-14-reader-chrome-redesign-design.md
             §1/§6) - "frosted glass", not a literal blur: this codebase has no live blur-behind for
             dynamic content (see the redesign plan's own header note re: BackdropBlurRenderer.cs only
             pre-blurring static bitmaps). Reduced-opacity floatingPanel override, more specific than
             Primitives.axaml's own Border.floatingPanel so it wins without touching that shared file -
             other floatingPanel consumers (e.g. Detail screens) are untouched. Alpha is a visual-tuning
             call, verify on-screen over varied page art in both skins per the design doc's own testing
             note. -->
        <Style Selector="Border.floatingPanel.chromeCluster, Border.floatingPanel.readerDrawer">
            <Setter Property="Opacity" Value="0.92" />
        </Style>

        <!-- Idle-fade override for the chrome clusters, deliberately declared AFTER the frosted-
             glass rule above - both this and that rule are class-selector ("conditional") matches
             on the same element, which in Avalonia always resolve to the exact same BindingPriority
             tier (StyleTrigger) regardless of how many classes either selector lists - confirmed via
             Avalonia's own docs: "Two selectors with any conditional activation will have equal
             priority regardless of the number of activators present... Avalonia doesn't have CSS's
             concept of Specificity." With BindingPriority and visual-tree locality tied, the ONLY
             remaining tiebreaker is Styles-collection order: the LAST declared Setter wins. A first
             attempt at fixing this (2026-09-16) tried to win by adding a class to make the selector
             "more specific" (Border.floatingPanel.chromeCluster.hidden, positioned BEFORE this rule,
             same as the original Border.chromeCluster.hidden was) - that had zero effect, since
             Avalonia doesn't weigh class count at all; only moving the rule to a later position
             actually works. This is why the reader chrome never visibly faded from the day the
             frosted-glass restyle shipped (2026-09-14) until this fix, regardless of ShowChrome's
             real value or the auto-hide-toggle setting added earlier the same session as this fix -
             neither of those was ever the problem. -->
        <Style Selector="Border.chromeCluster.hidden">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </UserControl.Styles>

    <Grid Background="{DynamicResource PbSurface1Brush}" PointerMoved="OnReaderPointerMoved" SizeChanged="OnReaderSizeChanged">

        <!-- Perf overlay - top-left, above everything, click-through -->
        <Border ZIndex="1000" IsHitTestVisible="False" IsVisible="{Binding PerfOverlayVisible}"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                Background="#CC000000" CornerRadius="4" Padding="8,5">
            <TextBlock Text="{Binding PerfOverlayText}" Foreground="#E6FFFFFF"
                       FontFamily="Consolas,monospace" FontSize="11" />
        </Border>

        <!-- ============ Canvas + floating chrome ============ -->
        <Grid Background="{Binding CanvasBackgroundBrush}">

            <!-- Thumbnail rail: opt-in, opened via the Page-turn cluster's rail-toggle button
                 (docs/superpowers/specs/2026-09-14-reader-chrome-redesign-design.md §6) - no longer a
                 hover-trigger sidebar; the dot-strip scrubber already covers the quick-scrub case. -->
            <Border x:Name="RailOverlay" Classes="railOverlay" Classes.hidden="{Binding !IsRailOpen}"
                    Width="96" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                    Background="{DynamicResource PbSurface2Brush}" BorderBrush="{DynamicResource PbBorderBrush}"
                    BorderThickness="0,0,1,0" BoxShadow="4 0 16 0 #66000000">
                <ScrollViewer Padding="8,10">
                    <ItemsControl x:Name="ThumbnailsItemsControl" ItemsSource="{Binding Thumbnails}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ReaderThumbnailSample">
                                <Border Classes="thumb" Classes.selected="{Binding IsSelected}" Background="{Binding CoverBrush}"
                                        Cursor="Hand" PointerPressed="OnThumbnailPointerPressed">
                                    <Grid>
                                        <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                                        <!-- Bookmark ribbon (docs/superpowers/specs/2026-08-18-metadata-model-ui-gaps-status-and-bookmarks-design.md) - CE draws the same kind of marker on its own thumbnail rail. -->
                                        <Polygon IsVisible="{Binding IsBookmarked}" Fill="{DynamicResource PbBadgeBrush}" Stretch="Fill"
                                                 Points="0,0 10,0 10,14 5,9 0,14" Width="10" Height="14"
                                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,3,0" />
                                        <!-- Page type badge (docs/ce-feature-inventory.md §A) - a fixed semantic blue, deliberately
                                             not a Pb* token: this is a small per-item marker distinct from the bookmark ribbon's
                                             badge color, not part of the app's core surface/text/accent identity. -->
                                        <Border IsVisible="{Binding HasPageTypeBadge}" Background="#3A6EA5" CornerRadius="3"
                                                Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="3,0,0,2">
                                            <TextBlock Text="{Binding PageTypeBadgeText}" FontSize="9.5" FontWeight="Bold"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <!-- Rotation indicator (docs/ce-feature-inventory.md §A). -->
                                        <fi:SymbolIcon Symbol="ArrowRotateClockwise" FontSize="{StaticResource PbIconSizeXs}" Foreground="White" IsVisible="{Binding IsRotated}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,2" />
                                        <!-- Manual spread-position indicator (docs/superpowers/specs/2026-09-10-reader-backlog-
                                             batch-b-design.md Item 2) - bottom-center so it doesn't collide with the type badge
                                             (bottom-left) or rotation indicator (bottom-right). -->
                                        <fi:SymbolIcon Symbol="CaretLeft" FontSize="{StaticResource PbIconSizeXs}" Foreground="White" IsVisible="{Binding IsNearHint}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2"
                                                       ToolTip.Tip="Near side (leading)" AutomationProperties.Name="Leading page" />
                                        <fi:SymbolIcon Symbol="CaretRight" FontSize="{StaticResource PbIconSizeXs}" Foreground="White" IsVisible="{Binding IsFarHint}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2"
                                                       ToolTip.Tip="Far side (trailing)" AutomationProperties.Name="Trailing page" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Shared-element cover flight participant (docs/superpowers/specs/2026-09-04-
                 navigation-transition-system-design.md) - keyed on the loaded issue, imaged by
                 whatever page is currently on screen (the first page, right after
                 NavigateToReaderCore/LoadIssue runs, before the coordinator's poll checks). No fit-
                 rect math hookup - PageCanvas's own Bounds is the destination rect, the design doc's
                 pre-approved fallback since precise zoom/fit-mode geometry isn't cheaply available
                 from a custom-drawn Control. -->
            <views:PageCanvas x:Name="PageCanvasControl"
                              controls:SharedElement.Key="{Binding SharedElementKey}"
                              controls:SharedElement.ImageSource="{Binding CurrentPage}"
                              Page="{Binding CurrentPage}"
                              SecondaryPage="{Binding CurrentPageSecondary}"
                              LeftCommand="{Binding GoLeftCommand}"
                              RightCommand="{Binding GoRightCommand}"
                              HighQualityDisplay="{Binding HighQualityPageDisplay}"
                              ShowPageShadow="{Binding ShowPageShadow}"
                              LeftKey="{Binding PageTurnLeftKey}"
                              RightKey="{Binding PageTurnRightKey}"
                              PanLeftGesture="{Binding PanLeftKey}"
                              PanRightGesture="{Binding PanRightKey}"
                              PanUpGesture="{Binding PanUpKey}"
                              PanDownGesture="{Binding PanDownKey}"
                              ScrollLeftGesture="{Binding ScrollLeftKey}"
                              ScrollRightGesture="{Binding ScrollRightKey}"
                              ScrollUpGesture="{Binding ScrollUpKey}"
                              ScrollDownGesture="{Binding ScrollDownKey}"
                              ScrollPageUpGesture="{Binding ScrollPageUpKey}"
                              ScrollPageDownGesture="{Binding ScrollPageDownKey}"
                              ScrollToStartGesture="{Binding ScrollToStartKey}"
                              ScrollToEndGesture="{Binding ScrollToEndKey}"
                              ToggleAutoScrollGesture="{Binding ToggleAutoScrollKey}"
                              ToggleAutoScrollCommand="{Binding ToggleAutoScrollCommand}"
                              ChapterBoundaryOverscrollCommand="{Binding ChapterBoundaryOverscrollCommand}"
                              FullscreenToggleGesture="{Binding ToggleFullscreenKey}"
                              ToggleChromeCommand="{Binding ToggleChromeCommand}"
                              RotateClockwiseGesture="{Binding RotateClockwiseKey}"
                              RotateClockwiseCommand="{Binding RotateClockwiseCommand}"
                              RotateCounterClockwiseGesture="{Binding RotateCounterClockwiseKey}"
                              RotateCounterClockwiseCommand="{Binding RotateCounterClockwiseCommand}"
                              PreviousBookmarkGesture="{Binding PreviousBookmarkKey}"
                              PreviousBookmarkCommand="{Binding PreviousBookmarkCommand}"
                              NextBookmarkGesture="{Binding NextBookmarkKey}"
                              NextBookmarkCommand="{Binding NextBookmarkCommand}"
                              ZoomInGesture="{Binding ZoomInKey}"
                              ZoomInCommand="{Binding ZoomInCommand}"
                              ZoomOutGesture="{Binding ZoomOutKey}"
                              ZoomOutCommand="{Binding ZoomOutCommand}"
                              FitOriginalGesture="{Binding FitOriginalKey}"
                              FitAllGesture="{Binding FitAllKey}"
                              FitWidthGesture="{Binding FitWidthKey}"
                              FitHeightGesture="{Binding FitHeightKey}"
                              FitBestGesture="{Binding FitBestKey}"
                              SetFitModeCommand="{Binding SetFitModeCommand}"
                              ZoomLevel="{Binding ZoomLevel}"
                              PanOffsetX="{Binding PanOffsetX}"
                              PanOffsetY="{Binding PanOffsetY}"
                              FitMode="{Binding FitMode}"
                              FitOnlyIfOversized="True"
                              ManualRotationDegrees="{Binding ManualRotationDegrees}"
                              PageRotationOverrideDegrees="{Binding PageRotationOverrideDegrees}"
                              AutoRotate="{Binding AutoRotate}"
                              WheelPanStep="{Binding MouseWheelSpeed}"
                              PageTransitionStyle="{Binding PageTransitionStyle}"
                              PageTransitionDurationMs="{Binding PageTransitionDurationMs}"
                              ReadingMode="{Binding EffectiveReadingMode}"
                              Decoder="{Binding Decoder}"
                              PageCount="{Binding PageCount}"
                              ScrollOffset="{Binding ScrollOffset}"
                              CurrentContinuousPageIndex="{Binding CurrentContinuousPageIndex}"
                              FullscreenToggleCommand="{Binding ToggleFullscreenCommand}"
                              Brightness="{Binding Brightness}"
                              Contrast="{Binding Contrast}"
                              Saturation="{Binding Saturation}"
                              Gamma="{Binding Gamma}"
                              PageMarginMultiplier="{Binding PageMarginMultiplier}"
                              IsVisible="{Binding !HasError}" />

            <Border IsVisible="{Binding HasError}" Width="400" CornerRadius="{DynamicResource PbRadiusLg}"
                    Background="{DynamicResource PbSurface2Brush}" BorderBrush="{DynamicResource PbBorderBrush}"
                    BorderThickness="1" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding ErrorMessage}" FontSize="13" Foreground="{DynamicResource PbTextMutedBrush}"
                           TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
            </Border>

            <!-- ============ Chapter transition overlay (docs/superpowers/specs/2026-08-23-reader-
                 chapter-transition-design.md) - fixed sibling overlay over PageCanvas, restyled with
                 Pb* tokens/PbMotionFast/PbMotionEase in place of the old hardcoded local brushes and
                 duration; structurally unchanged otherwise, per this phase's own scope. ============ -->
            <Border IsVisible="{Binding ChapterTransitionState, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static models:ChapterTransitionState.Loading}}"
                    Width="200" Height="200" CornerRadius="{DynamicResource PbRadiusLg}" Background="{DynamicResource PbSurface2Brush}"
                    BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Transitions>
                    <Transitions><DoubleTransition Property="Opacity" Duration="{DynamicResource PbMotionFast}" Easing="{StaticResource PbMotionEase}" /></Transitions>
                </Border.Transitions>
                <TextBlock Text="Loading…" FontSize="13" Foreground="{DynamicResource PbTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <Border IsVisible="{Binding ChapterTransitionState, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static models:ChapterTransitionState.Card}}"
                    Width="240" CornerRadius="{DynamicResource PbRadiusLg}" Background="{DynamicResource PbSurface2Brush}"
                    BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1" Padding="18"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Transitions>
                    <Transitions><DoubleTransition Property="Opacity" Duration="{DynamicResource PbMotionFast}" Easing="{StaticResource PbMotionEase}" /></Transitions>
                </Border.Transitions>
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <Border Width="120" Height="168" CornerRadius="{DynamicResource PbRadiusSm}" ClipToBounds="True" HorizontalAlignment="Center"
                            BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="1">
                        <Image Source="{Binding ChapterTransitionCoverImage}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding ChapterTransitionFromLabel, StringFormat='Previous: {0}'}" FontSize="11.5"
                                   Foreground="{DynamicResource PbTextMutedBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding ChapterTransitionToLabel, StringFormat='Current: {0}'}" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource PbTextBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ Navigate cluster (top-left) ============ -->
            <!-- Visibility driven purely by position math in OnReaderPointerMoved (code-behind), not
                 per-element PointerEntered/Exited - see that handler's own doc comment for why two
                 separate Enter/Exit-based attempts (2026-09-16) both failed to ever hide the cluster
                 again once shown. -->
            <Border Classes="floatingPanel chromeCluster" Classes.hidden="{Binding !IsNavigateClusterVisible}"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Command="{Binding GoBackCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding BreadcrumbSeries, StringFormat='← {0}'}" FontSize="12"
                                       Foreground="{DynamicResource PbTextMutedBrush}" />
                            <TextBlock Text="{Binding IssueTitle}" FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource PbTextBrush}" />
                        </StackPanel>
                    </Button>
                    <Border Width="1" Height="14" Background="{DynamicResource PbBorderBrush}" />
                    <TextBlock Text="{Binding PageLabel}" FontFamily="Consolas,monospace" FontSize="12"
                               Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" />
                    <!-- Split-page part navigation (docs/superpowers/specs/2026-09-05-reader-polish-
                         backlog-finish-design.md §1) - only shown once the current page/spread is
                         zoomed past the viewport and split into more than one part. -->
                    <TextBlock Text="{Binding #PageCanvasControl.PartLabel}" FontFamily="Consolas,monospace" FontSize="12"
                               Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center"
                               IsVisible="{Binding #PageCanvasControl.PartLabel, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>

            <!-- ============ Actions cluster (top-right) ============ -->
            <Border Classes="floatingPanel chromeCluster" Classes.hidden="{Binding !IsActionsClusterVisible}"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <!-- Clock + battery (docs/superpowers/specs/2026-09-05-reader-polish-backlog-
                         finish-design.md §2) - CE-parity port of NavigationOverlay's timeLabel/
                         batteryStatus, rides this cluster's existing idle-fade/capsule chrome. -->
                    <TextBlock Text="{Binding CurrentTimeLabel}" FontFamily="Consolas,monospace" FontSize="12"
                               Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding BatteryStatusLabel}" FontFamily="Consolas,monospace" FontSize="12"
                               Foreground="{DynamicResource PbTextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"
                               IsVisible="{Binding BatteryStatusLabel, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                    <Border Classes="bookmarkGlow" Classes.pulsing="{Binding BookmarkJustToggled}" CornerRadius="{DynamicResource PbRadiusSm}">
                        <Button Classes="clusterIcon" Classes.active="{Binding IsCurrentPageBookmarked}"
                                Command="{Binding ToggleBookmarkCommand}" ToolTip.Tip="Toggle bookmark">
                            <fi:SymbolIcon Symbol="Bookmark" />
                        </Button>
                    </Border>
                    <Button Classes="clusterIcon" Classes.active="{Binding IsDrawerOpen}"
                            Command="{Binding ToggleDrawerCommand}" ToolTip.Tip="More tools">
                        <fi:SymbolIcon Symbol="MoreVertical" />
                    </Button>
                    <Button Classes="clusterIcon" Classes.active="{Binding IsFullscreen}"
                            Command="{Binding ToggleFullscreenCommand}" ToolTip.Tip="Fullscreen (F)">
                        <fi:SymbolIcon Symbol="FullScreenMaximize" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- ============ View cluster (bottom-left) - fit/zoom collapse into the drawer's Page
                 section below ~720px window width (IsViewClusterCollapsed, set from code-behind's
                 SizeChanged handler). ============ -->
            <Border Classes="floatingPanel chromeCluster" Classes.hidden="{Binding !IsViewClusterVisible}"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Classes="clusterPill">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <fi:SymbolIcon FontSize="{StaticResource PbIconSizeXs}"
                                  Symbol="{Binding EffectiveReadingMode, Converter={x:Static views:ReadingModeIconConverter.Instance}}" />
                            <TextBlock Text="{Binding ReadingModeLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="Top">
                                <!-- Per-pill glyphs (on-screen feedback) - same 3-arrow vocabulary
                                     ReadingModeIconConverter already gives the trigger button's own
                                     icon, just literal per pill since each one's mode is fixed at
                                     authoring time (no converter needed for a static mapping). -->
                                <WrapPanel Width="230" Orientation="Horizontal">
                                    <Button Classes="pillOption" Classes.active="{Binding EffectiveReadingMode, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:ReadingMode.LeftToRight}}" Command="{Binding SetReadingModeCommand}" CommandParameter="{x:Static entities:ReadingMode.LeftToRight}">
                                        <StackPanel Orientation="Horizontal" Spacing="5"><fi:SymbolIcon Symbol="ArrowRight" FontSize="{StaticResource PbIconSizeXs}" /><TextBlock Text="Left to Right" VerticalAlignment="Center" /></StackPanel>
                                    </Button>
                                    <Button Classes="pillOption" Classes.active="{Binding EffectiveReadingMode, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:ReadingMode.RightToLeft}}" Command="{Binding SetReadingModeCommand}" CommandParameter="{x:Static entities:ReadingMode.RightToLeft}">
                                        <StackPanel Orientation="Horizontal" Spacing="5"><fi:SymbolIcon Symbol="ArrowLeft" FontSize="{StaticResource PbIconSizeXs}" /><TextBlock Text="Right to Left" VerticalAlignment="Center" /></StackPanel>
                                    </Button>
                                    <Button Classes="pillOption" Classes.active="{Binding EffectiveReadingMode, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:ReadingMode.TopToBottom}}" Command="{Binding SetReadingModeCommand}" CommandParameter="{x:Static entities:ReadingMode.TopToBottom}">
                                        <StackPanel Orientation="Horizontal" Spacing="5"><fi:SymbolIcon Symbol="ArrowDown" FontSize="{StaticResource PbIconSizeXs}" /><TextBlock Text="Top to Bottom" VerticalAlignment="Center" /></StackPanel>
                                    </Button>
                                    <Button Classes="pillOption" Classes.active="{Binding EffectiveReadingMode, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:ReadingMode.VerticalContinuous}}" Command="{Binding SetReadingModeCommand}" CommandParameter="{x:Static entities:ReadingMode.VerticalContinuous}">
                                        <StackPanel Orientation="Horizontal" Spacing="5"><fi:SymbolIcon Symbol="ArrowDown" FontSize="{StaticResource PbIconSizeXs}" /><TextBlock Text="Longstrip (gapped)" VerticalAlignment="Center" /></StackPanel>
                                    </Button>
                                    <Button Classes="pillOption" Classes.active="{Binding EffectiveReadingMode, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:ReadingMode.HorizontalContinuous}}" Command="{Binding SetReadingModeCommand}" CommandParameter="{x:Static entities:ReadingMode.HorizontalContinuous}">
                                        <StackPanel Orientation="Horizontal" Spacing="5"><fi:SymbolIcon Symbol="ArrowRight" FontSize="{StaticResource PbIconSizeXs}" /><TextBlock Text="Horizontal Long Strip" VerticalAlignment="Center" /></StackPanel>
                                    </Button>
                                    <Button Classes="pillOption" Classes.active="{Binding EffectiveReadingMode, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:ReadingMode.HorizontalContinuousRightToLeft}}" Command="{Binding SetReadingModeCommand}" CommandParameter="{x:Static entities:ReadingMode.HorizontalContinuousRightToLeft}">
                                        <StackPanel Orientation="Horizontal" Spacing="5"><fi:SymbolIcon Symbol="ArrowLeft" FontSize="{StaticResource PbIconSizeXs}" /><TextBlock Text="Horizontal Long Strip (RTL)" VerticalAlignment="Center" /></StackPanel>
                                    </Button>
                                    <Button Classes="pillOption" Classes.active="{Binding EffectiveReadingMode, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:ReadingMode.Webtoon}}" Command="{Binding SetReadingModeCommand}" CommandParameter="{x:Static entities:ReadingMode.Webtoon}">
                                        <StackPanel Orientation="Horizontal" Spacing="5"><fi:SymbolIcon Symbol="ArrowDown" FontSize="{StaticResource PbIconSizeXs}" /><TextBlock Text="Long Strip" VerticalAlignment="Center" /></StackPanel>
                                    </Button>
                                </WrapPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !IsViewClusterCollapsed}">
                        <Button Classes="clusterPill" ToolTip.Tip="Fit mode"
                                IsVisible="{Binding !IsContinuousMode}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <fi:SymbolIcon Symbol="AutoFit" FontSize="{StaticResource PbIconSizeXs}" />
                                <TextBlock Text="{Binding FitModeLabel}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="Top">
                                    <WrapPanel Width="170" Orientation="Horizontal">
                                        <Button Classes="pillOption" Classes.active="{Binding FitMode, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:ImageFitMode.Original}}" Command="{Binding SetFitModeCommand}" CommandParameter="{x:Static entities:ImageFitMode.Original}">
                                            <StackPanel Orientation="Horizontal" Spacing="5"><fi:SymbolIcon Symbol="Image" FontSize="{StaticResource PbIconSizeXs}" /><TextBlock Text="Original" VerticalAlignment="Center" /></StackPanel>
                                        </Button>
                                        <Button Classes="pillOption" Classes.active="{Binding FitMode, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:ImageFitMode.Fit}}" Command="{Binding SetFitModeCommand}" CommandParameter="{x:Static entities:ImageFitMode.Fit}">
                                            <StackPanel Orientation="Horizontal" Spacing="5"><fi:SymbolIcon Symbol="AutoFit" FontSize="{StaticResource PbIconSizeXs}" /><TextBlock Text="Fit Page" VerticalAlignment="Center" /></StackPanel>
                                        </Button>
                                        <Button Classes="pillOption" Classes.active="{Binding FitMode, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:ImageFitMode.FitWidth}}" Command="{Binding SetFitModeCommand}" CommandParameter="{x:Static entities:ImageFitMode.FitWidth}">
                                            <StackPanel Orientation="Horizontal" Spacing="5"><fi:SymbolIcon Symbol="ArrowAutofitWidth" FontSize="{StaticResource PbIconSizeXs}" /><TextBlock Text="Fit Width" VerticalAlignment="Center" /></StackPanel>
                                        </Button>
                                        <Button Classes="pillOption" Classes.active="{Binding FitMode, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:ImageFitMode.FitHeight}}" Command="{Binding SetFitModeCommand}" CommandParameter="{x:Static entities:ImageFitMode.FitHeight}">
                                            <StackPanel Orientation="Horizontal" Spacing="5"><fi:SymbolIcon Symbol="ArrowAutofitHeight" FontSize="{StaticResource PbIconSizeXs}" /><TextBlock Text="Fit Height" VerticalAlignment="Center" /></StackPanel>
                                        </Button>
                                        <Button Classes="pillOption" Classes.active="{Binding FitMode, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:ImageFitMode.BestFit}}" Command="{Binding SetFitModeCommand}" CommandParameter="{x:Static entities:ImageFitMode.BestFit}">
                                            <StackPanel Orientation="Horizontal" Spacing="5"><fi:SymbolIcon Symbol="Star" FontSize="{StaticResource PbIconSizeXs}" /><TextBlock Text="Best Fit" VerticalAlignment="Center" /></StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <!-- Unified zoom pill (docs/superpowers/specs/2026-09-14-reader-chrome-
                             redesign-design.md §4) - one control tree for paged and continuous mode
                             alike, replacing the old stepper+pill+flyout plus a continuous-mode-only
                             inline Slider. ZoomLevel's own setter already clamps per-mode (0.5-4.0
                             continuous, 1.0-MaxZoom paged) - this Slider's Minimum/Maximum is a fixed
                             superset, not new per-mode bindable surface. -->
                        <Button Classes="clusterPill" Padding="8,6" ToolTip.Tip="Zoom">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <fi:SymbolIcon Symbol="Search" FontSize="{StaticResource PbIconSizeXs}" />
                                <TextBlock Text="{Binding ZoomLevel, StringFormat={}{0:P0}}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="Top">
                                    <StackPanel Width="140" Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <Button Classes="clusterIcon" Command="{Binding ZoomOutCommand}" ToolTip.Tip="{Binding ZoomOutHint}">
                                                <fi:SymbolIcon Symbol="Subtract" />
                                            </Button>
                                            <Slider Width="80" Minimum="0.5" Maximum="4" Value="{Binding ZoomLevel}" VerticalAlignment="Center" />
                                            <Button Classes="clusterIcon" Command="{Binding ZoomInCommand}" ToolTip.Tip="{Binding ZoomInHint}">
                                                <fi:SymbolIcon Symbol="Add" />
                                            </Button>
                                        </StackPanel>
                                        <Button Classes="drawerRow" Content="100%" Command="{Binding SetZoom100Command}" />
                                        <Button Classes="drawerRow" Content="125%" Command="{Binding SetZoom125Command}" />
                                        <Button Classes="drawerRow" Content="150%" Command="{Binding SetZoom150Command}" />
                                        <Button Classes="drawerRow" Content="200%" Command="{Binding SetZoom200Command}" />
                                        <Button Classes="drawerRow" Content="400%" Command="{Binding SetZoom400Command}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ Page-turn cluster (bottom-center) ============ -->
            <Border Classes="floatingPanel chromeCluster" Classes.hidden="{Binding !IsPageTurnClusterVisible}"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16" MinWidth="260">
                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                    <!-- Rail toggle (docs/superpowers/specs/2026-09-14-reader-chrome-redesign-design.md
                         §6) - paired here with the dot-strip it complements, not the Actions cluster's
                         session-level actions. Paged mode only (on-screen feedback) - continuous/long-
                         strip modes scroll through pages directly, no rail concept there. -->
                    <Button Grid.Column="0" Classes="clusterIcon" Classes.active="{Binding IsRailOpen}"
                            Command="{Binding ToggleRailCommand}" Margin="0,0,6,0" ToolTip.Tip="Page thumbnails"
                            IsVisible="{Binding !IsContinuousMode}">
                        <fi:SymbolIcon Symbol="Grid" FontSize="{StaticResource PbIconSizeSm}" />
                    </Button>
                    <Button Grid.Column="1" Classes="clusterIcon" Command="{Binding PreviousChapterCommand}" ToolTip.Tip="Previous chapter">
                        <fi:SymbolIcon Symbol="ChevronDoubleLeft" />
                    </Button>
                    <Button Grid.Column="2" Classes="clusterIcon" Command="{Binding GoLeftCommand}" Margin="0,0,10,0"
                            ToolTip.Tip="{Binding PageTurnLeftHint}">
                        <fi:SymbolIcon Symbol="Previous" FontSize="{StaticResource PbIconSizeSm}" />
                    </Button>
                    <!-- Per-page dot strip, replacing a plain ProgressBar (docs/superpowers/specs/
                         2026-08-25-reader-chrome-design.md follow-up) - one dot per Thumbnails entry,
                         reusing the exact same SelectThumbnailCommand the rail's own click-to-jump
                         already uses, not a new navigation path. Each dot's tooltip is that page's
                         real cover thumbnail - a hover-scrub preview, same data the rail shows. -->
                    <!-- No scrollbar (on-screen feedback: a 135-page TPB blew the whole cluster out
                         edge-to-edge; a horizontal scrollbar was rejected as the fix). DotStripItemWidth/
                         DotStripSpacing below shrink together so the strip's content never exceeds
                         DotStripTargetWidth (280px) in the first place - MaxWidth is a safety net, not
                         the actual mechanism, and Disabled is correct because scrolling should never
                         actually be needed. -->
                    <ScrollViewer Grid.Column="3" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                                  VerticalAlignment="Center" MinWidth="100" MaxWidth="300">
                        <!-- PointerMoved/PointerExited wired in code-behind via AddHandler(...,
                             handledEventsToo: true), not the plain XAML attribute - matching this
                             constructor's own established fix for the same class of bug
                             (Ctrl+Shift+P's KeyDown handler) - a child pageDot Button hovering can
                             mark the routed event handled before it bubbles here. -->
                        <ItemsControl x:Name="PageDotsItemsControl" ItemsSource="{Binding Thumbnails}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="{Binding DotStripSpacing}" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ReaderThumbnailSample">
                                    <!-- ToolTip.Placement="Top" (on-screen feedback: "pop up on top
                                         [of] the progress bar", not beside the cursor - Avalonia's
                                         default unset Placement is Pointer-relative, which is why it
                                         was trailing the mouse instead of anchoring above the dot). -->
                                    <Button Classes="pageDot" Classes.active="{Binding IsSelected}"
                                            Command="{Binding $parent[UserControl].((vm:ReaderScreenViewModel)DataContext).SelectThumbnailCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Placement="Top" ToolTip.VerticalOffset="6">
                                        <ToolTip.Tip>
                                            <Border Width="90" Height="126" CornerRadius="{DynamicResource PbRadiusSm}" ClipToBounds="True"
                                                    Background="{DynamicResource PbSurface3Brush}">
                                                <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                                            </Border>
                                        </ToolTip.Tip>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Grid.Column="4" Classes="clusterIcon" Command="{Binding GoRightCommand}" Margin="10,0,0,0"
                            ToolTip.Tip="{Binding PageTurnRightHint}">
                        <fi:SymbolIcon Symbol="Next" FontSize="{StaticResource PbIconSizeSm}" />
                    </Button>
                    <Button Grid.Column="5" Classes="clusterIcon" Command="{Binding NextChapterCommand}" ToolTip.Tip="Next chapter">
                        <fi:SymbolIcon Symbol="ChevronDoubleRight" />
                    </Button>
                </Grid>
            </Border>

            <!-- ============ Drawer - Page/Adjust/Transition/Bookmarks, does not idle-fade ============ -->
            <Border Classes="floatingPanel readerDrawer" IsVisible="{Binding IsDrawerOpen}"
                    HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="16" Width="230" Padding="14">
                <!-- Header is a fixed row outside the ScrollViewer (real bug found via on-screen check:
                     the close button used to live inside the scrollable content, where the vertical
                     scrollbar's own track rendered right on top of it). Only the sections below scroll. -->
                <!-- Rearranged 2026-09-14 (docs/superpowers/specs/2026-09-14-reader-chrome-redesign-
                     design.md §5) - a third fixed row pins BOOKMARKS below the scroll region, same
                     "header doesn't scroll" fix this file's own comment already documents, now applied
                     to a second edge too. -->
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <TextBlock Grid.Column="0" Text="Reader Tools" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PbTextBrush}" />
                        <Button Grid.Column="1" Classes="clusterIcon" Padding="4"
                                Command="{Binding ToggleDrawerCommand}" ToolTip.Tip="Close">
                            <fi:SymbolIcon Symbol="Dismiss" FontSize="{StaticResource PbIconSizeXs}" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1">
                    <StackPanel Margin="0,0,10,0">
                        <!-- Fit/zoom fold in here once the View cluster has collapsed (below ~720px window width). -->
                        <StackPanel IsVisible="{Binding IsViewClusterCollapsed}">
                            <TextBlock Classes="drawerSectionHeader" Text="VIEW" />
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4" IsVisible="{Binding !IsContinuousMode}">
                                <TextBlock Grid.Column="0" Text="Fit mode" FontSize="12.5" VerticalAlignment="Center" Foreground="{DynamicResource PbTextBrush}" />
                                <Button Grid.Column="1" Classes="clusterPill" Padding="8,4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <fi:SymbolIcon Symbol="AutoFit" FontSize="{StaticResource PbIconSizeXs}" />
                                        <TextBlock Text="{Binding FitModeLabel}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button.Flyout>
                                        <Flyout Placement="Left">
                                            <WrapPanel Width="170" Orientation="Horizontal">
                                                <Button Classes="pillOption" Content="Original" Classes.active="{Binding FitMode, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:ImageFitMode.Original}}" Command="{Binding SetFitModeCommand}" CommandParameter="{x:Static entities:ImageFitMode.Original}" />
                                                <Button Classes="pillOption" Content="Fit Page" Classes.active="{Binding FitMode, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:ImageFitMode.Fit}}" Command="{Binding SetFitModeCommand}" CommandParameter="{x:Static entities:ImageFitMode.Fit}" />
                                                <Button Classes="pillOption" Content="Fit Width" Classes.active="{Binding FitMode, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:ImageFitMode.FitWidth}}" Command="{Binding SetFitModeCommand}" CommandParameter="{x:Static entities:ImageFitMode.FitWidth}" />
                                                <Button Classes="pillOption" Content="Fit Height" Classes.active="{Binding FitMode, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:ImageFitMode.FitHeight}}" Command="{Binding SetFitModeCommand}" CommandParameter="{x:Static entities:ImageFitMode.FitHeight}" />
                                                <Button Classes="pillOption" Content="Best Fit" Classes.active="{Binding FitMode, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static entities:ImageFitMode.BestFit}}" Command="{Binding SetFitModeCommand}" CommandParameter="{x:Static entities:ImageFitMode.BestFit}" />
                                            </WrapPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                            <!-- Zoom pill (docs/superpowers/specs/2026-09-14-reader-chrome-redesign-
                                 design.md §4) - same unified control as the primary View cluster, not
                                 a bare stepper - this fold-in location previously had no popover at all. -->
                            <Button Classes="clusterPill" Padding="8,4" Margin="0,0,0,4" ToolTip.Tip="Zoom">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <fi:SymbolIcon Symbol="Search" FontSize="{StaticResource PbIconSizeXs}" />
                                    <TextBlock Text="{Binding ZoomLevel, StringFormat={}{0:P0}}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout Placement="Left">
                                        <StackPanel Width="140" Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                                <Button Classes="clusterIcon" Command="{Binding ZoomOutCommand}">
                                                    <fi:SymbolIcon Symbol="Subtract" />
                                                </Button>
                                                <Slider Width="80" Minimum="0.5" Maximum="4" Value="{Binding ZoomLevel}" VerticalAlignment="Center" />
                                                <Button Classes="clusterIcon" Command="{Binding ZoomInCommand}">
                                                    <fi:SymbolIcon Symbol="Add" />
                                                </Button>
                                            </StackPanel>
                                            <Button Classes="drawerRow" Content="100%" Command="{Binding SetZoom100Command}" />
                                            <Button Classes="drawerRow" Content="125%" Command="{Binding SetZoom125Command}" />
                                            <Button Classes="drawerRow" Content="150%" Command="{Binding SetZoom150Command}" />
                                            <Button Classes="drawerRow" Content="200%" Command="{Binding SetZoom200Command}" />
                                            <Button Classes="drawerRow" Content="400%" Command="{Binding SetZoom400Command}" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>

                        <TextBlock Classes="drawerSectionHeader" Text="PAGE" />
                        <!-- 2x2 icon-toggle grid (docs/superpowers/specs/2026-09-14-reader-chrome-
                             redesign-design.md §5) - denser than the old icon-button-pair + 2 separate
                             drawerRow toggles. Double-page cell keeps its existing paged-mode-only
                             visibility; UniformGrid still reserves its cell when hidden, which is fine
                             here (Auto-rotate simply sits alone in that row in continuous mode). -->
                        <UniformGrid Columns="2" Rows="2" Margin="0,0,0,6">
                            <Button Classes="drawerRow" Command="{Binding RotateClockwiseCommand}" ToolTip.Tip="{Binding RotateClockwiseHint}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <fi:SymbolIcon Symbol="ArrowRotateClockwise" FontSize="{StaticResource PbIconSizeXs}" />
                                    <TextBlock Text="Rotate CW" VerticalAlignment="Center" FontSize="11.5" />
                                </StackPanel>
                            </Button>
                            <Button Classes="drawerRow" Command="{Binding RotateCounterClockwiseCommand}" ToolTip.Tip="{Binding RotateCounterClockwiseHint}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <fi:SymbolIcon Symbol="ArrowRotateCounterclockwise" FontSize="{StaticResource PbIconSizeXs}" />
                                    <TextBlock Text="Rotate CCW" VerticalAlignment="Center" FontSize="11.5" />
                                </StackPanel>
                            </Button>
                            <Button Classes="drawerRow" Classes.active="{Binding AutoRotate}" Command="{Binding ToggleAutoRotateCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <fi:SymbolIcon Symbol="ArrowRotateClockwise" FontSize="{StaticResource PbIconSizeXs}" />
                                    <TextBlock Text="Auto-rotate" VerticalAlignment="Center" FontSize="11.5" />
                                </StackPanel>
                            </Button>
                            <Button Classes="drawerRow" Classes.active="{Binding IsDoublePageMode}"
                                    Command="{Binding ToggleDoublePageModeCommand}" IsVisible="{Binding !IsContinuousMode}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <fi:SymbolIcon Symbol="BookOpen" FontSize="{StaticResource PbIconSizeXs}" />
                                    <TextBlock Text="Double-page" VerticalAlignment="Center" FontSize="11.5" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                        <StackPanel IsVisible="{Binding IsContinuousMode}">
                            <Button Classes="drawerRow" Classes.active="{Binding IsAutoScrolling}"
                                    Command="{Binding ToggleAutoScrollCommand}" ToolTip.Tip="{Binding AutoScrollHint}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <fi:SymbolIcon Symbol="Play" />
                                    <TextBlock Text="Auto-scroll" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <StackPanel Margin="12,4,12,0" Spacing="2" IsVisible="{Binding IsAutoScrolling}">
                                <TextBlock Text="{Binding AutoScrollSpeed, StringFormat='Speed: {0:F0} px/s'}" FontSize="11.5" Foreground="{DynamicResource PbTextMutedBrush}" />
                                <Slider Minimum="20" Maximum="300" Value="{Binding AutoScrollSpeed}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Collapsed by default (docs/superpowers/specs/2026-09-14-reader-chrome-
                             redesign-design.md §5) - used less often than PAGE/BOOKMARKS, not worth
                             permanent vertical space. Header itself is the toggle. -->
                        <Button Classes="drawerRow" Command="{Binding ToggleAdjustSectionCommand}" Padding="0" Margin="0,14,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <fi:SymbolIcon Symbol="ChevronDown" FontSize="{StaticResource PbIconSizeXs}" IsVisible="{Binding IsAdjustSectionExpanded}" />
                                <fi:SymbolIcon Symbol="ChevronRight" FontSize="{StaticResource PbIconSizeXs}" IsVisible="{Binding !IsAdjustSectionExpanded}" />
                                <TextBlock Text="ADJUST" Classes="drawerSectionHeader" Margin="0" />
                            </StackPanel>
                        </Button>
                        <StackPanel Spacing="8" IsVisible="{Binding IsAdjustSectionExpanded}" Margin="0,6,0,0">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Brightness, StringFormat='Brightness: {0:F0}'}" FontSize="11.5" Foreground="{DynamicResource PbTextMutedBrush}" />
                                <Slider Minimum="-100" Maximum="100" Value="{Binding Brightness}" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Contrast, StringFormat='Contrast: {0:F0}'}" FontSize="11.5" Foreground="{DynamicResource PbTextMutedBrush}" />
                                <Slider Minimum="-100" Maximum="100" Value="{Binding Contrast}" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Saturation, StringFormat='Saturation: {0:F0}'}" FontSize="11.5" Foreground="{DynamicResource PbTextMutedBrush}" />
                                <Slider Minimum="-100" Maximum="100" Value="{Binding Saturation}" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Gamma, StringFormat='Gamma: {0:F0}'}" FontSize="11.5" Foreground="{DynamicResource PbTextMutedBrush}" />
                                <Slider Minimum="-100" Maximum="100" Value="{Binding Gamma}" />
                            </StackPanel>
                            <Button Classes="drawerRow" Content="Reset to defaults" Command="{Binding ResetAdjustmentCommand}"
                                    HorizontalContentAlignment="Center" />
                        </StackPanel>

                        <!-- Collapsed to one row (docs/superpowers/specs/2026-09-14-reader-chrome-
                             redesign-design.md §5) - one control doesn't need a full section header. -->
                        <Grid ColumnDefinitions="Auto,*" Margin="0,14,0,6">
                            <TextBlock Grid.Column="0" Text="Transition" FontSize="12.5" VerticalAlignment="Center" Foreground="{DynamicResource PbTextBrush}" />
                            <Button Grid.Column="1" Classes="drawerRow" Content="{Binding PageTransitionStyle}"
                                    HorizontalContentAlignment="Right" Padding="0">
                                <Button.Flyout>
                                    <Flyout Placement="Left">
                                        <StackPanel Width="140">
                                            <Button Classes="drawerRow" Content="None" Command="{Binding SetPageTransitionStyleCommand}" CommandParameter="{x:Static entities:PageTransitionStyle.None}" />
                                            <Button Classes="drawerRow" Content="Slide" Command="{Binding SetPageTransitionStyleCommand}" CommandParameter="{x:Static entities:PageTransitionStyle.Slide}" />
                                            <Button Classes="drawerRow" Content="Crossfade" Command="{Binding SetPageTransitionStyleCommand}" CommandParameter="{x:Static entities:PageTransitionStyle.Crossfade}" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </StackPanel>
                    </ScrollViewer>

                    <!-- Pinned footer (docs/superpowers/specs/2026-09-14-reader-chrome-redesign-
                         design.md §5) - BOOKMARKS is the section read most often mid-session, so it
                         stays visible while PAGE/ADJUST/TRANSITION scroll away above. -->
                    <Border Grid.Row="2" BorderBrush="{DynamicResource PbBorderBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,10,0">
                    <StackPanel>
                        <TextBlock Classes="drawerSectionHeader" Text="BOOKMARKS" Margin="0" />
                        <ItemsControl ItemsSource="{Binding Bookmarks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:IssueBookmarkSummary">
                                    <!-- Both row states live in one template, one Panel cell, only one ever
                                         IsVisible - keeps this bookmark's row in its correct list position
                                         while renaming instead of a second stacked ItemsControl. -->
                                    <Panel Margin="0,2">
                                        <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding !IsEditing}">
                                            <Button Grid.Column="0" Classes="drawerRow"
                                                    Command="{Binding $parent[UserControl].((vm:ReaderScreenViewModel)DataContext).GoToBookmarkCommand}"
                                                    CommandParameter="{Binding}" Content="{Binding Label}" HorizontalContentAlignment="Left" />
                                            <Button Grid.Column="1" Classes="clusterIcon"
                                                    Command="{Binding $parent[UserControl].((vm:ReaderScreenViewModel)DataContext).BeginRenameBookmarkCommand}"
                                                    CommandParameter="{Binding}" ToolTip.Tip="Rename bookmark">
                                                <fi:SymbolIcon Symbol="Edit" FontSize="{StaticResource PbIconSizeXs}" />
                                            </Button>
                                            <Button Grid.Column="2" Classes="clusterIcon"
                                                    Command="{Binding $parent[UserControl].((vm:ReaderScreenViewModel)DataContext).DeleteBookmarkCommand}"
                                                    CommandParameter="{Binding}" ToolTip.Tip="Remove bookmark">
                                                <fi:SymbolIcon Symbol="Delete" FontSize="{StaticResource PbIconSizeXs}" />
                                            </Button>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsEditing}">
                                            <TextBox Grid.Column="0" Text="{Binding EditText}" FontSize="12.5" />
                                            <Button Grid.Column="1" Classes="clusterIcon" Margin="4,0,0,0"
                                                    Command="{Binding $parent[UserControl].((vm:ReaderScreenViewModel)DataContext).CommitRenameBookmarkCommand}"
                                                    CommandParameter="{Binding}" ToolTip.Tip="Save name">
                                                <fi:SymbolIcon Symbol="Checkmark" FontSize="{StaticResource PbIconSizeXs}" />
                                            </Button>
                                        </Grid>
                                    </Panel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No bookmarks yet" FontSize="11.5" Foreground="{DynamicResource PbTextFaintBrush}"
                                   IsVisible="{Binding !Bookmarks.Count}" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0" IsVisible="{Binding Bookmarks.Count}">
                            <Button Classes="drawerRow" Command="{Binding PreviousBookmarkCommand}" ToolTip.Tip="{Binding PreviousBookmarkHint}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <fi:SymbolIcon Symbol="ChevronLeft" FontSize="{StaticResource PbIconSizeXs}" />
                                    <TextBlock Text="Prev" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="drawerRow" Command="{Binding NextBookmarkCommand}" ToolTip.Tip="{Binding NextBookmarkHint}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Next" VerticalAlignment="Center" />
                                    <fi:SymbolIcon Symbol="ChevronRight" FontSize="{StaticResource PbIconSizeXs}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
