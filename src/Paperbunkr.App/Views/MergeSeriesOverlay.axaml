<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:vm="using:Paperbunkr.App.ViewModels"
             xmlns:views="using:Paperbunkr.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="420"
             xmlns:controls="using:Paperbunkr.App.Controls"
             x:Class="Paperbunkr.App.Views.MergeSeriesOverlay"
             x:DataType="vm:MergeSeriesScreenViewModel">

    <!-- Merge series (docs/superpowers/specs/2026-09-29-library-bulk-actions-design.md §3): pick the series that stays; the warning counts the
         duplicate rows the merge would remove before anything happens. -->
    <UserControl.Styles>
        <Style Selector="Border.candidateRow">
            <Setter Property="BorderBrush" Value="{DynamicResource PbBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource PbRadius}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="Border.candidateRow.target">
            <Setter Property="BorderBrush" Value="{DynamicResource PbAccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource PbAccentSoftBrush}" />
        </Style>
    </UserControl.Styles>

    <!-- The candidate list has its own scroller, so the dialog body doesn't scroll as well. -->
    <controls:DialogCard Title="{Binding Title}" Subtitle="Choose the series to keep. The issues of the other series move into it."
                         Size="Small" IsBodyScrollable="False" CloseCommand="{Binding CancelCommand}">
        <StackPanel Spacing="12">
        <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Candidates}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MergeSeriesCandidate">
                        <Border Classes="candidateRow" Classes.target="{Binding IsTarget}">
                            <RadioButton GroupName="MergeTarget" IsChecked="{Binding IsTarget}" Padding="10,8"
                                         HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Name}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="28" Height="40" CornerRadius="{DynamicResource PbRadiusSm}" Background="{Binding CoverBrush}" ClipToBounds="True">
                                        <Image views:AsyncCoverImage.SourceId="{Binding CoverKey}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PbTextBrush}" />
                                        <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource PbTextMutedBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </RadioButton>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Background="{DynamicResource PbAccentSoftBrush}" BorderBrush="{DynamicResource PbAccentBrush}" BorderThickness="1"
                CornerRadius="{DynamicResource PbRadius}" Padding="10,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <fi:SymbolIcon Symbol="Warning" FontSize="16" Foreground="{DynamicResource PbAccentTextBrush}" VerticalAlignment="Top" />
                <TextBlock Text="{Binding DuplicateWarning}" IsVisible="{Binding HasDuplicates}" FontSize="12" TextWrapping="Wrap" MaxWidth="330"
                           Foreground="{DynamicResource PbTextBrush}" />
                <TextBlock Text="{Binding NoDuplicateNote}" IsVisible="{Binding !HasDuplicates}" FontSize="12" TextWrapping="Wrap" MaxWidth="330"
                           Foreground="{DynamicResource PbTextBrush}" />
            </StackPanel>
        </Border>
        </StackPanel>
        <controls:DialogCard.Footer>
            <StackPanel>
                <Button Classes="ghost" Content="Cancel" Command="{Binding CancelCommand}" />
                <Button Classes="primary" Content="{Binding MergeLabel}" Command="{Binding MergeCommand}"
                        AutomationProperties.AutomationId="MergeSeriesConfirm" />
            </StackPanel>
        </controls:DialogCard.Footer>
    </controls:DialogCard>
</UserControl>
